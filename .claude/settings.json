{
  "env": {
    "MCP_LOG_MAX_OUTPUT_BYTES": "2048"
  },
  "permissions": {
    "allow": [
      "mcp__msw-maker-mcp__maker_refresh_workspace",
      "mcp__msw-maker-mcp__maker_logs",
      "mcp__msw-maker-mcp__maker_clear_logs",
      "mcp__msw-mcp__mlua_document_retriever",
      "mcp__msw-mcp__mlua_api_retriever",
      "WebFetch(domain:api.github.com)",
      "Bash(node -e *)",
      "Bash(node scripts/*)",
      "Bash(node scratch/*)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git stash *)",
      "Bash(git ls-remote *)",
      "Bash(git rev-list *)",
      "Bash(npm ls *)",
      "Bash(npm view *)",
      "Bash(mswai --version)",
      "Bash(mswai update *)",
      "Edit(/.claude/skills/msw-project/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \".claude/hooks-project/skill-read-guard.cjs\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node \".claude/hooks/structured-file-guard/structured-file-guard.cjs\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node \".claude/hooks-project/readonly-path-guard.cjs\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \".claude/hooks/structured-file-guard/structured-file-guard.cjs\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \".claude/hooks-project/readonly-path-guard.cjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \".claude/hooks/mlua-lsp/mlua-diagnose-post-tool-use.cjs\"",
            "timeout": 120
          }
        ]
      },
      {
        "matcher": "Read|Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node \".claude/hooks/skill-log/skill-log.cjs\"",
            "timeout": 5,
            "async": true
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \".claude/hooks/mcp-log/mcp-log.cjs\"",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \".claude/hooks-project/mlua-session-start.cjs\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node \".claude/hooks/update-check/update-check.cjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \".claude/hooks-project/skill-router-lite.cjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \".claude/hooks/skill-log/skill-log.cjs\"",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \".claude/hooks/mlua-lsp/mlua-session-end.cjs\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}

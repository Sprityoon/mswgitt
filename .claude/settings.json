  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \".claude/hooks-project/skill-read-guard.cjs\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node \".claude/hooks/structured-file-guard/structured-file-guard.cjs\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node \".claude/hooks-project/readonly-path-guard.cjs\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \".claude/hooks/structured-file-guard/structured-file-guard.cjs\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \".claude/hooks-project/readonly-path-guard.cjs\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",

@Logic
script TestModeConfig extends Logic

	-- =========================================================================
	-- [테스트 모드 설정 (TestModeConfig)]
	-- =========================================================================
	-- 테스트 모드를 켜거나 끄려면 아래 EnableTestMode 프로퍼티 값을 변경하세요.
	--   true  : 메인 메뉴에 "테스트 모드" 배지가 뜨고, 슬롯 1~5는 테스트 전용 슬롯이다. 캐릭터를 고르면 TargetMap 으로 스폰
	--   false : 일반 플레이 모드 (실제 슬롯 1~5)
	-- =========================================================================

	-- [스위치] 테스트 모드 활성화 여부
	property boolean EnableTestMode = false

	-- [목표 맵] 진입할 맵 식별자 (대소문자 무관)
	--   - "town"           : 마을 광장 (기본 좌표 10, -2)
	--   - "home"           : 유저 개인 영지 (Home_<UserId>, 기본 좌표 -3, 0)
	--   - "hunt01"         : 사냥터 1구역 (field_earth 기반)
	--   - "hunt02"         : 사냥터 2구역
	--   - "hunt03"         : 사냥터 3구역 (체인 종점)
	--   - "template_field" : 사냥터 1구역 ("hunt01"로 자동 매핑)
	--   - 기타 맵 이름     : 명시한 맵 엔티티 이름 그대로 사용
	-- ⚠️ 상시 공유 보스 아레나(hunt04)는 철거됐다. 보스전은 F5(레이드 대기실)로 들어간다 —
	--    대기실·보스방은 요청 시 생성되는 인스턴스라 TargetMap 으로 직접 지정할 수 없다.
	property string TargetMap = "template_field"

	-- [포탈 전체 해금] 테스트 모드일 때 모든 웨이포인트(사냥터 워프 목록·체인 포탈)와 보스 대기실을 열린 것으로 본다.
	--   PlayerController:IsWaypointUnlocked 한 곳에서만 우회한다 — 세이브의 해금 기록(UnlockedWaypointsJson)은 건드리지 않는다.
	--   보스방 입장 레벨(BossContentsDataSet.RequiredLevel·난이도 EntryLevel)은 그대로다 — F7 레벨업으로 맞출 것.
	property boolean UnlockAllPortals = true

	-- [테스트 전용 슬롯] 테스트 모드의 메인 메뉴 슬롯 1~5 = 저장 슬롯 (TestStorageSlotOffset + 1~5), 기본 101~105.
	--   저장 키 SaveData_s101 · Quest_s101 · Achievement_s101 … 로 실제 슬롯과 분리된다 — F7·F8로 올린 상태가 일반 플레이에 남지 않는다(pitfalls 규칙 63).
	--   변환은 PersistenceManager.ToStorageSlot 한 곳. 테스트 캐릭터는 닉네임 전역 등록을 하지 않는다.
	property integer TestStorageSlotOffset = 100

	-- [커스텀 좌표 사용 여부]
	--   false: 각 맵별 안전/기본 스폰 위치 사용
	--   true : 아래 CustomPosX, CustomPosY 좌표로 강제 스폰
	property boolean UseCustomPos = false
	property number CustomPosX = 0.0
	property number CustomPosY = 0.0

	-- =========================================================================
	-- [디버그 핫키]  ※ EnableTestMode 가 true 일 때만 동작한다.
	-- =========================================================================
	--   F5 : 보스 레이드 대기실 입장 — TestRaidBossId 의 공유 대기실로 바로 워프 (활성화 검사 우회)
	--        (보스방은 대기실 입구의 붉은 게이트에서 F → 난이도 선택 창)
	--   F6 : 좌하단 키 목록 HUD 표시/숨김 토글
	--   F7 : 레벨업 — GrantLevelCount 만큼 (경험치를 채워 실제 레벨업 경로를 그대로 태운다)
	--   F8 : 스킬 포인트(SP) 즉시 주입 — GrantSPAmount 만큼
	--   F9 : 리소스 프리뷰 툴 토글      (UIPreviewToolController)
	--   F10 : 날씨 순환 — WeatherDataSet 행 순서대로 (맑음 → 비 → 안개 → …), TestWeatherHoldSeconds 동안 유지
	--   F11 : 낮/밤 전환 — 월드 시간을 한밤중(TestNightTime) 또는 한낮(TestDayTime)으로 옮긴다
	--   F12 : 진행 중 퀘스트를 보고 직전까지 채운다 — 조건 진행도 + 지참·제출 물건 지급. NPC 보고(대사·보상·전직)는 직접 한다
	--   Shift+F12 : 진행 중 퀘스트를 NPC 없이 즉시 완료 (정식 PlayerQuest.CompleteQuests 경로 — 보상·전직·다음 퀘스트 자동 수락 그대로)
	--        ※ 수락 전 퀘스트는 대상이 아니다(NPC에게 먼저 수락). 레벨·직업 자격이 안 되면 건너뛴다 — F7 로 레벨을 맞출 것
	--   F2/F3/F4 : 랭킹 샘플 UI        (RankingBasic/Sample/RankingSampleUILogic)
	-- ⚠ F9 와 F2~F4 는 원래 게이트가 없어 출시본에서도 열렸다. 각 스크립트에 EnableTestMode
	--   가드를 넣어 막았으므로, 키를 추가/제거하면 아래 도움말 문구도 같이 고칠 것.
	-- 프로덕션 스크립트를 건드리지 않도록 치트 코드는 전부 이 DevTools 파일 안에만 둔다.
	property boolean EnableDebugHotkeys = true
	-- 진입 후 이 시간(초)이 지나면 키 목록 HUD 를 켠다. HUD 엔티티 준비 전에 켜면 놓친다.
	property number HelpDelaySeconds = 2.0
	-- 1회 입력당 지급할 SP.
	property integer GrantSPAmount = 10
	-- 1회 입력당 상한(서버측 하드 캡). 클라가 보낸 값이 이보다 크면 잘라낸다.
	property integer MaxGrantPerPress = 100
	-- 1회 입력당 올릴 레벨 수.
	property integer GrantLevelCount = 1
	-- F5 테스트 대기실 입장에 쓸 보스 (BossContentsDataSet.BossId). 난이도는 게이트 창에서 고른다.
	property string TestRaidBossId = "slime_king"
	-- 레벨 지급 상한(서버측 하드 캡). 실수로 큰 값이 와도 한 번에 이 이상은 안 오른다.
	property integer MaxLevelPerPress = 20
	-- F10 으로 고른 날씨를 유지할 시간(초). 끝나면 WeatherManager 가 평소처럼 다시 추첨한다.
	property number TestWeatherHoldSeconds = 600
	-- F11 이 옮겨 갈 하루 내 시각(0~599초). 325~575초가 한밤중(비네트 최대) 구간.
	property number TestNightTime = 400
	property number TestDayTime = 100
	-- F10 이 잡아 둔 재추첨 타이머
	property any testWeatherTimerId = nil

	-- KeyDownEvent 핸들러. property any 로 잡아두지 않으면 GC 되어 조용히 안 먹는다.
	property any debugKeyHandler = nil

	-- [HUD 바인딩] ui/HUDGroup.ui 의 TestKeyHud 오버레이. UIBuilder 가 UUID 를 주입한다.
	-- .ui 에서 enable=false 로 저장돼 있어(규칙 30) 테스트 모드일 때만 켜진다.
	property Entity debugHudPanel = "9d794d51-4043-44da-9ed1-1191020dcca9"
	property TextGUIRendererComponent debugHudText = "a3882d86-311a-4f3e-87f3-4b2f37a76770"

	method void OnBeginPlay()
		-- @Logic 은 서버/클라 양쪽에서 실행된다. 입력은 클라에서만 듣는다.
		if not self:IsClient() then return end
		if self.EnableTestMode ~= true then return end
		if self.EnableDebugHotkeys ~= true then return end
		self.debugKeyHandler = _InputService:ConnectEvent(KeyDownEvent, self.HandleDebugKeyDown)
		log("[TESTMODE] debug hotkeys armed — " .. self:BuildDebugKeyHelpLine())

		-- 진입 직후엔 HUD 엔티티가 아직 준비 전일 수 있어 잠깐 뒤에 켠다.
		-- 이후로는 상시 표시하고, F6 으로 접었다 펼 수 있다.
		local delay = self.HelpDelaySeconds
		if delay < 0 then delay = 0 end
		_TimerService:SetTimerOnce(function()
			self:SetDebugKeyHudVisible(true)
		end, delay)
	end

	@ExecSpace("ClientOnly")
	method string BuildDebugKeyHelp()
		-- HUD 본문에 들어갈 키 목록. 수치는 프로퍼티에서 읽어 안내와 실제가 어긋나지 않게 한다.
		return "F5            보스 레이드 대기실 (" .. self.TestRaidBossId .. ")\n"
			.. "F6            키 목록 표시/숨김\n"
			.. "F7            레벨업 +" .. tostring(self.GrantLevelCount) .. "\n"
			.. "F8            SP +" .. tostring(self.GrantSPAmount) .. "\n"
			.. "F9            리소스 프리뷰\n"
			.. "F10 / F11     날씨 순환 · 낮/밤 전환\n"
			.. "F12           퀘스트 보고 준비 (Shift: 즉시 완료)\n"
			.. "F2 / F3 / F4  랭킹 샘플"
	end

	@ExecSpace("ClientOnly")
	method string BuildDebugKeyHelpLine()
		-- 로그 한 줄용 요약(개행 없는 형태).
		return "F5 레이드 대기실 · F6 목록 · F7 레벨업 +" .. tostring(self.GrantLevelCount)
			.. " · F8 SP +" .. tostring(self.GrantSPAmount)
			.. " · F9 리소스 프리뷰 · F10 날씨 순환 · F11 낮/밤 · F12 퀘스트 보고 준비(Shift 즉시 완료) · F2/F3/F4 랭킹 샘플"
	end

	@ExecSpace("ClientOnly")
	method void RefreshDebugKeyHud()
		-- HUD 오버레이 본문을 현재 프로퍼티 값으로 다시 채운다.
		if not isvalid(self.debugHudText) then return end
		self.debugHudText.Text = self:BuildDebugKeyHelp()
	end

	@ExecSpace("ClientOnly")
	method void SetDebugKeyHudVisible(boolean show)
		-- 오버레이 표시/숨김. Visible 이 아니라 Enable 을 쓴다(ui-hierarchy §5).
		if not isvalid(self.debugHudPanel) then return end
		if show then
			self:RefreshDebugKeyHud()
		end
		self.debugHudPanel.Enable = show
	end

	@ExecSpace("ClientOnly")
	method void ShowDebugKeyHelp()
		-- F6 토글. 테스트 모드가 아니면 절대 켜지지 않는다.
		if self.EnableTestMode ~= true then return end
		if self.EnableDebugHotkeys ~= true then return end
		if not isvalid(self.debugHudPanel) then
			log_warning("[TESTMODE] TestKeyHud 엔티티 바인딩이 비어 있다 — ui/HUDGroup.ui 확인 필요")
			return
		end
		self:SetDebugKeyHudVisible(self.debugHudPanel.Enable ~= true)
	end

	method void OnEndPlay()
		-- OnBeginPlay 에서 연결한 것은 반드시 여기서 해제한다(엔진이 자동 해제하지 않는다).
		if self.debugKeyHandler ~= nil then
			_InputService:DisconnectEvent(KeyDownEvent, self.debugKeyHandler)
			self.debugKeyHandler = nil
		end
	end

	@ExecSpace("ClientOnly")
	method void HandleDebugKeyDown(KeyDownEvent event)
		-- 디버그 핫키 라우팅. 실제 지급/검증은 전부 서버가 한다.
		if self.EnableTestMode ~= true then return end
		if self.EnableDebugHotkeys ~= true then return end
		if event.key == KeyboardKey.F6 then
			self:ShowDebugKeyHelp()
		elseif event.key == KeyboardKey.F7 then
			self:RequestGrantLevel(self.GrantLevelCount)
		elseif event.key == KeyboardKey.F8 then
			self:RequestGrantSkillPoints(self.GrantSPAmount)
		elseif event.key == KeyboardKey.F5 then
			self:RequestEnterTestRaid()
		elseif event.key == KeyboardKey.F10 then
			self:RequestCycleWeather()
		elseif event.key == KeyboardKey.F11 then
			self:RequestToggleNight()
		elseif event.key == KeyboardKey.F12 then
			-- Shift 를 같이 누르면 즉시 완료. _InputService 에는 IsKeyDown 이 없다(규칙 35) — IsKeyPressed.
			local instant = _InputService:IsKeyPressed(KeyboardKey.LeftShift) or _InputService:IsKeyPressed(KeyboardKey.RightShift)
			self:RequestSkipQuests(instant)
		end
	end

	@ExecSpace("Server")
	method void RequestSkipQuests(boolean instant)
		-- 테스트 모드 전용 퀘스트 넘기기 요청. 본체는 ServerOnly 메서드에 둔다(RPC 본문 사용자 타입 주석 금지 — 규칙 53).
		if self.EnableTestMode ~= true then return end
		if self.EnableDebugHotkeys ~= true then return end
		local userEntity = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(userEntity) then return end
		self:SkipQuestsFor(userEntity, instant)
	end

	@ExecSpace("ServerOnly")
	method void SkipQuestsFor(Entity userEntity, boolean instant)
		-- 진행 중 퀘스트를 보고 직전까지 채운다. 지참(Have) 조건·제출 물건(ConsumeItems)은 실제로 아이템을 지급해 채우고
		-- (인벤 변동이 보유량 재평가를 태운다), 나머지 조건은 진행도를 목표치로 맞춘다. 직접 대입 대신 정식 완료 경로를 쓰므로
		-- instant 일 때도 보상·전직·다음 퀘스트 자동 수락이 실제와 같다.
		-- 한계: State 조건(예: 스킬 배우기)은 다음 인벤 변동 때 실제 상태로 재평가돼 0 으로 돌아갈 수 있다 → 그때는 Shift+F12.
		if _QuestDataSetLogic == nil then return end
		local pq = userEntity:GetComponent("script.PlayerQuest")
		local inv = userEntity:GetComponent("script.PlayerInventory")
		local pc = userEntity:GetComponent("script.PlayerController")
		if not isvalid(pq) or not isvalid(inv) then return end
		local userId = userEntity.PlayerComponent.UserId

		-- 완료 처리 중 진행 목록이 바뀌므로 먼저 복사한다.
		local ids = {}
		for id, on in pairs(pq.ProgressingIdTable) do
			if on == true then ids[#ids + 1] = id end
		end
		table.sort(ids)
		if #ids == 0 then
			if isvalid(pc) then pc:ShowMineFeedback("[TEST] 진행 중인 퀘스트가 없습니다 (NPC에게 먼저 수락)", userId) end
			return
		end

		local readyIds = {}
		local blocked = 0
		for _, id in ipairs(ids) do
			local data = _QuestDataSetLogic:GetData(id)
			local userData = pq.UserDataTable[id]
			if data == nil or userData == nil then continue end
			if not data:IsPlayerEligible(userEntity, true) then
				blocked = blocked + 1
				log("[TESTMODE] quest skip blocked id=" .. tostring(id) .. " reason=" .. data:GetEligibilityBlockText(userEntity, true))
				continue
			end
			-- 1) 지참 조건: 그 아이템을 목표 수량까지 지급한다(진행도는 보유량에서 다시 계산된다).
			local conds = data.ConditionDatas or {}
			for i = 1, #conds do
				local cond = conds[i]
				if cond ~= nil and cond.CountMode == "Have" then
					local acd = cond.ConditionData
					local okT, target = pcall(function() return acd.Target end)
					local itemName = (okT and target ~= nil) and tostring(target) or ""
					local missing = cond.Value - inv:GetItemCount(itemName)
					if itemName ~= "" and missing > 0 then inv:AddItem(itemName, missing) end
				end
			end
			-- 2) 보고 때 넘길 물건: 모자란 만큼 지급한다.
			local consume = data.ConsumeItems or {}
			for i = 1, #consume do
				local itemName = consume[i][1]
				local need = consume[i][2]
				if itemName ~= nil and itemName ~= "" and need ~= nil then
					local missing = need - inv:GetItemCount(itemName)
					if missing > 0 then inv:AddItem(itemName, missing) end
				end
			end
			-- 3) 나머지 조건(처치·채집 횟수·배우기 등): 진행도를 목표치로 맞춘다.
			for i = 1, #conds do
				local cond = conds[i]
				if cond ~= nil and cond.CountMode ~= "Have" then
					userData.Values[i] = cond.Value
				end
			end
			readyIds[#readyIds + 1] = id
		end

		if #readyIds > 0 then
			local idValuesTable = {}
			for _, id in ipairs(readyIds) do
				idValuesTable[id] = pq.UserDataTable[id].Values
			end
			pq:MarkSaveDirty()
			pq:SyncValuesChanged(idValuesTable, userId)
		end

		local message = ""
		if instant then
			pq:CompleteQuests(readyIds)
			message = "[TEST] 퀘스트 즉시 완료 " .. tostring(#readyIds) .. "건"
		else
			-- 보고 NPC 가 없는 퀘스트(온보딩)는 평소처럼 조건 충족 즉시 완료된다.
			pq:TryCompleteReadyQuests()
			message = "[TEST] 퀘스트 보고 준비 " .. tostring(#readyIds) .. "건 — NPC에게 보고하세요"
		end
		if blocked > 0 then message = message .. " (자격 미달 " .. tostring(blocked) .. "건: F7 레벨업)" end
		if isvalid(pc) then pc:ShowMineFeedback(message, userId) end
		log("[TESTMODE] quest skip instant=" .. tostring(instant) .. " ready=" .. tostring(#readyIds) .. " blocked=" .. tostring(blocked) .. " user=" .. tostring(userId))
	end

	@ExecSpace("ClientOnly")
	method void RequestEnterTestRaid()
		-- 사냥터를 걸어서 도달하지 않고도 보스 대기실을 열어 보기 위한 테스트 진입점.
		-- 정식 경로는 hunt03 의 대기실 포탈(최초 활성화) 또는 보스 컨텐츠 창(재방문)이다.
		-- 난이도는 여기서 고르지 않는다 — 대기실 붉은 게이트에서 F 를 누르면 선택 창이 뜬다.
		local lp = _UserService.LocalPlayer
		if not isvalid(lp) then return end
		log("[TESTMODE] raid lobby request boss=" .. self.TestRaidBossId)
		local bossId = self.TestRaidBossId
		local request = function()
			self:ServerEnterTestLobby(bossId, lp)
		end
		local pcComp = lp:GetComponent("script.PlayerController")
		if isvalid(pcComp) then
			---@type PlayerController
			local c = pcComp
			c:ClientWarpWithCover(request)
		else
			request()
		end
	end

	@ExecSpace("Server")
	method void ServerEnterTestLobby(string bossId, Entity requester)
		-- 테스트 모드 전용: 활성화(직접 도달) 검사를 건너뛰고 대기실로 보낸다.
		-- 우회는 여기 한 곳에만 둔다 — 정식 경로(BossRaidLogic:RequestEnterLobby)의 게이트는 그대로다.
		if self.EnableTestMode ~= true then return end
		if _BossRaidLogic == nil then
			log_warning("[TESTMODE] BossRaidLogic missing")
			return
		end
		if not isvalid(requester) then return end
		_BossRaidLogic:EnterLobby(requester, bossId, true)
	end

	@ExecSpace("Server")
	method void RequestCycleWeather()
		-- 테스트 모드 전용: WeatherDataSet 의 다음 행 날씨로 즉시 바꾼다(추첨 우회).
		-- 적용은 WeatherManager 의 정식 경로(ApplyWeatherFromRow)를 그대로 태워 @Sync 값이 실제와 같다.
		if self.EnableTestMode ~= true then return end
		if self.EnableDebugHotkeys ~= true then return end
		if _WeatherManager == nil then
			log_warning("[TESTMODE] WeatherManager missing")
			return
		end
		local ds = _DataService:GetTable("WeatherDataSet")
		if ds == nil then return end
		local rows = ds:GetAllRow()
		if rows == nil or #rows == 0 then return end
		local nextIndex = 1
		for i, row in ipairs(rows) do
			if tostring(row:GetItem("WeatherId")) == tostring(_WeatherManager.CurrentWeatherId) then
				nextIndex = (i % #rows) + 1
				break
			end
		end
		-- 정식 추첨 타이머가 곧바로 덮어쓰지 않게 멈추고, 유지 시간이 끝나면 다시 추첨시킨다.
		if _WeatherManager.durationTimerId ~= nil then
			_TimerService:ClearTimer(_WeatherManager.durationTimerId)
			_WeatherManager.durationTimerId = nil
		end
		if self.testWeatherTimerId ~= nil then
			_TimerService:ClearTimer(self.testWeatherTimerId)
			self.testWeatherTimerId = nil
		end
		_WeatherManager:ApplyWeatherFromRow(rows[nextIndex])
		local hold = self.TestWeatherHoldSeconds
		if hold < 1 then hold = 1 end
		self.testWeatherTimerId = _TimerService:SetTimerOnce(function()
			self.testWeatherTimerId = nil
			_WeatherManager:RollWeather()
		end, hold)
		log("[TESTMODE] weather -> " .. tostring(_WeatherManager.CurrentWeatherId) .. " (hold " .. tostring(hold) .. "s)")
	end

	@ExecSpace("Server")
	method void RequestToggleNight()
		-- 테스트 모드 전용: 월드 시간을 한밤중 ↔ 한낮으로 옮기고 즉시 클라에 동기화한다.
		-- 월드 시간은 모든 유저가 공유하고 30초마다 저장되므로 테스트 월드에서만 쓸 것.
		if self.EnableTestMode ~= true then return end
		if self.EnableDebugHotkeys ~= true then return end
		if _PersistenceManager == nil then return end
		local pm = _PersistenceManager
		local inDay = pm:GetServerAccumulatedTime() % 600
		local target = self.TestNightTime
		if pm:IsNight() then target = self.TestDayTime end
		local delta = target - inDay
		if delta < 0 then delta = delta + 600 end
		pm.AccumulatedTime = pm.AccumulatedTime + delta
		pm:SyncTimeBroadcast()
		log("[TESTMODE] time " .. string.format("%.0f", inDay) .. " -> " .. tostring(target) .. " (night=" .. tostring(pm:IsNight()) .. ")")
	end

	@ExecSpace("Server")
	method void RequestGrantLevel(integer count)
		-- 테스트 모드 전용 레벨업.
		-- 레벨/스탯을 직접 대입하지 않고 PlayerController:AddXP 로 **실제 레벨업 경로**를 태운다
		-- (MaxXP 증가, MaxStamina, GatheringSpeed, SP 지급, 저장 dirty 표시가 전부 그 안에 있다).
		-- 직접 대입하면 테스트가 실제 동작과 달라져 검증 가치가 없어진다.
		if self.EnableTestMode ~= true then return end
		if self.EnableDebugHotkeys ~= true then return end

		local userEntity = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(userEntity) then return end
		local pcComp = userEntity:GetComponent("script.PlayerController")
		if not isvalid(pcComp) then return end
		---@type PlayerController
		local pc = pcComp

		local n = count
		if n == nil or n <= 0 then n = 1 end
		local cap = self.MaxLevelPerPress
		if cap > 0 and n > cap then n = cap end

		local beforeLevel = pc.Level
		for i = 1, n do
			-- 다음 레벨까지 부족한 만큼만 채운다. MaxXP 는 레벨마다 커지므로 매 회 다시 읽는다.
			local need = pc.MaxXP - pc.XP
			if need < 1 then need = 1 end
			pc:AddXP(need)
		end
		log("[TESTMODE] Level " .. beforeLevel .. " -> " .. pc.Level .. " (+" .. n .. ") user=" .. senderUserId)
	end

	@ExecSpace("Server")
	method void RequestGrantSkillPoints(integer amount)
		-- 테스트 모드 전용 SP 주입.
		-- senderUserId 는 서버가 채우는 값이라 클라가 위조할 수 없다(msw-scripting §6).
		-- 테스트 모드가 꺼져 있으면 요청 자체를 무시한다 — 출시본에서 치트가 되지 않도록.
		if self.EnableTestMode ~= true then return end
		if self.EnableDebugHotkeys ~= true then return end

		local userEntity = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(userEntity) then return end
		local pcComp = userEntity:GetComponent("script.PlayerController")
		if not isvalid(pcComp) then return end
		---@type PlayerController
		local pc = pcComp

		local n = amount
		if n == nil or n <= 0 then n = self.GrantSPAmount end
		local cap = self.MaxGrantPerPress
		if cap > 0 and n > cap then n = cap end

		pc.SP = pc.SP + n
		-- 레벨업 SP 지급과 동일하게 dirty 표시해 저장에 반영한다.
		if _PersistenceManager ~= nil then
			_PersistenceManager:MarkPlayerDirty(senderUserId)
		end
		pc:ShowMineFeedback("[TEST] SP +" .. n .. "  (총 " .. pc.SP .. ")", senderUserId)
		log("[TESTMODE] SP +" .. n .. " -> " .. pc.SP .. " user=" .. senderUserId)
	end

	@ExecSpace("ServerOnly")
	method string GetResolvedTargetMap(string userId)
		-- "home" 등 별칭을 실제 월드 내 맵 엔티티 이름으로 변환합니다.
		local raw = string.lower(tostring(self.TargetMap or "town"))
		raw = string.match(raw, "^%s*(.-)%s*$") or ""
		if raw == "home" or raw == "map01" or raw == "estate" then
			return "Home_" .. tostring(userId or "")
		elseif raw == "town" or raw == "plaza" then
			return "town"
		elseif raw == "template_field" or raw == "field" or raw == "hunt" or raw == "hunt01" then
			return "hunt01"
		elseif raw == "hunt02" then
			return "hunt02"
		elseif raw == "hunt03" then
			return "hunt03"
		elseif raw == "template_boss" or raw == "boss" or raw == "hunt04" then
			-- 보스 아레나 철거. 인스턴스는 TargetMap 으로 못 가므로 체인 종점으로 보낸다(F5 로 레이드 입장).
			log_warning("[TESTMODE] boss arena was removed — falling back to hunt03. Use F5 for the raid lobby.")
			return "hunt03"
		end
		-- 그 외 직접 입력된 맵 이름
		return self.TargetMap
	end

	@ExecSpace("ServerOnly")
	method Vector2 GetResolvedSpawnPosition(string mapName)
		-- 커스텀 좌표가 켜져 있으면 커스텀 좌표 반환
		if self.UseCustomPos == true then
			return Vector2(self.CustomPosX, self.CustomPosY)
		end

		-- 맵별 기본 안전 스폰 좌표
		if string.sub(mapName, 1, 5) == "Home_" then
			return Vector2(-3.0, 0.0)
		elseif mapName == "town" then
			return Vector2(10.0, -2.0)
		end

		-- 사냥터는 워프 목록과 같은 도착점(PortalDestinationDataSet.ArriveX/Y)을 쓴다 — 맵 재설계 시 CSV만 고치면 된다.
		local ds = _DataService:GetTable("PortalDestinationDataSet")
		if ds ~= nil then
			for i = 1, ds:GetRowCount() do
				if ds:GetCell(i, "MapName") == mapName then
					local ax = tonumber(ds:GetCell(i, "ArriveX")) or 0
					local ay = tonumber(ds:GetCell(i, "ArriveY")) or 0
					return Vector2(ax, ay)
				end
			end
		end

		return Vector2(0.0, 0.0)
	end

end

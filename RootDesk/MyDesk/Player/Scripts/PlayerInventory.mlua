@Component
script PlayerInventory extends Component

	@Sync
	property string InventoryDataJson = "{}"

	@Sync
	property string EquippedTool = ""

	-- 장비 슬롯(주무기·방어구) → 인벤토리 아이템 키 JSON. 슬롯 id 는 item_dataset.EquipSlot 값
	-- (weapon / helmet / armor / gloves / shoes / shield). 장착해도 인벤토리에서 빠지지 않는 "참조" 방식이라
	-- 아이템을 잃으면(버림·판매·소모) 그 슬롯은 자동으로 빈 것으로 취급된다 — 복제·유실 경로가 없다.
	-- EquippedTool(손에 든 도구)과는 별개다: 손에 든 도구는 채집·기본 공격·던지기용, 장비는 스킬·방어력용.
	@Sync
	property string GearJson = "{}"

	-- 대장간 강화·주문 부여 (docs/design/equipment-enhancement-and-enchant-plan.md). 평탄 맵 { 아이템 키 → "단계|스탯,값,등급,파츠|..." }.
	-- 도구(고유 키)는 개체별, 장비(이름 키로 중첩)는 종류별로 저장된다. 중첩 테이블 인코딩을 피하려고 값은 문자열이다(LEA-3001).
	@Sync
	property string EnhanceJson = "{}"
	-- 강화 단계가 비율로 올려 주는 item_dataset 수치 열
	property string EnhanceStatColumns = "Attack|MagicAttack|SkillAttack|Defense"
	-- 연구 레벨 = 1 + floor(완료한 연구 수 / ResearchCountPerLevel), 최대 5
	property integer ResearchCountPerLevel = 2

	@Sync
	property string QuickSlotsJson = "[\"\", \"\", \"\", \"\", \"\", \"\", \"\", \"\", \"\", \"\"]"

	@Sync
	property integer SelectedQuickSlotIndex = 1

	@Sync
	property integer Coin = 0

	-- T25: 레시피 해금 키 목록 JSON 배열. 구세이브 폴백 "[]".
	@Sync
	property string UnlockedRecipesJson = "[]"

	-- T7: 진행 중 연구 (플레이어 단위, 오프라인 경과 환산).
	@Sync
	property string ActiveResearchId = ""

	@Sync
	property string ResearchStartTime = "0"

	-- T20: 일일 의뢰 (서버 day index + 당일 완료 RequestId 목록 JSON).
	@Sync
	property string DailyRequestDay = "0"

	@Sync
	property string DailyCompletedRequestsJson = "[]"

	-- T22: 도감 통계. 평탄 JSON 2개 — MSW JSONEncode는 중첩 테이블 불가(LEA-3001)라 분리.
	-- DexItemsJson: { itemName -> 누적 획득 수 }, DexMonstersJson: { monsterId -> 처치 수 }. 발견 = 카운트 > 0.
	@Sync
	property string DexItemsJson = "{}"
	@Sync
	property string DexMonstersJson = "{}"

	-- T23: 활성 펫 PetId (세션+영속). 빈 문자열 = 없음.
	@Sync
	property string ActivePetId = ""

	-- 보유 동물 명부(가축·펫 개체) JSON 배열 — 서버 전용, 슬롯 세이브 `creatures` 필드. 형식·규칙은 CreatureRoster.mlua.
	-- 우리 안 가축·가방 속 가축 아이템·이름 붙은 호루라기가 모두 이 명부의 id 를 가리킨다. 한도도 이걸로 센다.
	property string CreaturesJson = "[]"

	property table Items = {}

	property number _researchTickAccum = 0.0

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- Initializes the server-side inventory state for this player.
		self.Items = {}
		self.InventoryDataJson = "{}"
		self.EquippedTool = ""
		self.QuickSlotsJson = "[\"\", \"\", \"\", \"\", \"\", \"\", \"\", \"\", \"\", \"\"]"
		self.SelectedQuickSlotIndex = 1
		self.Coin = 0
		self.UnlockedRecipesJson = "[]"
		self.ActiveResearchId = ""
		self.ResearchStartTime = "0"
		self.DailyRequestDay = "0"
		self.DailyCompletedRequestsJson = "[]"
		self.DexItemsJson = "{}"
		self.DexMonstersJson = "{}"
		self.ActivePetId = ""
		self.CreaturesJson = "[]"
		self.EnhanceJson = "{}"
		self._researchTickAccum = 0.0
		log("PlayerInventory initialized on server for player: " .. self.Entity.Name)
	end

	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
		-- T7: 연구 타이머 완료 검사 (1초 간격).
		if self.ActiveResearchId == nil or self.ActiveResearchId == "" then return end
		self._researchTickAccum = self._researchTickAccum + delta
		if self._researchTickAccum < 1.0 then return end
		self._researchTickAccum = 0.0
		self:TryCompleteActiveResearch()
	end

	-- ── T20 Daily request board ──────────────────────────────────────────────

	method integer GetServerDayIndex()
		-- UTC day number — same seed for all players (전 서버 공통 의뢰).
		return math.floor(os.time() / 86400)
	end

	method void EnsureDailyRequestState()
		-- Day change → clear completed list (client + server safe).
		local today = tostring(self:GetServerDayIndex())
		if self.DailyRequestDay ~= today then
			self.DailyRequestDay = today
			self.DailyCompletedRequestsJson = "[]"
		end
	end

	method table GetTodaysRequestIds()
		-- Deterministic weighted pick of 3 RequestIds from RequestPoolDataSet (day seed).
		self:EnsureDailyRequestState()
		local ds = _DataService:GetTable("RequestPoolDataSet")
		if ds == nil then return {} end
		local pool = {}
		local n = ds:GetRowCount()
		for i = 1, n do
			local id = ds:GetCell(i, "RequestId") or ""
			if id ~= "" then
				local w = math.floor(tonumber(ds:GetCell(i, "Weight")) or 100)
				if w < 1 then w = 1 end
				table.insert(pool, { id = id, weight = w })
			end
		end
		if #pool == 0 then return {} end

		local day = self:GetServerDayIndex()
		local seed = (day * 1103515245 + 12345) % 2147483648
		local function nextRand()
			seed = (seed * 1103515245 + 12345) % 2147483648
			return seed / 2147483648.0
		end

		local picked = {}
		local remaining = {}
		for _, e in ipairs(pool) do table.insert(remaining, e) end
		local count = 3
		if count > #remaining then count = #remaining end
		for _ = 1, count do
			local totalW = 0
			for _, e in ipairs(remaining) do totalW = totalW + e.weight end
			local roll = nextRand() * totalW
			local acc = 0
			local idx = 1
			for j, e in ipairs(remaining) do
				acc = acc + e.weight
				if roll <= acc then
					idx = j
					break
				end
			end
			table.insert(picked, remaining[idx].id)
			table.remove(remaining, idx)
		end
		return picked
	end

	method boolean IsDailyRequestCompleted(string requestId)
		self:EnsureDailyRequestState()
		if requestId == nil or requestId == "" then return false end
		local list = self:SafeDecodeJson(self.DailyCompletedRequestsJson, {})
		for _, id in ipairs(list) do
			if id == requestId then return true end
		end
		return false
	end

	@ExecSpace("Server")
	method void ServerRequestDeliver(string requestId)
		-- 납품 RPC: day 검증 · 당일 1회 · 보유량 · 차감 · 보상 · 완료 기록.
		local userId = senderUserId
		if userId == nil or userId == "" then return end
		if self.Entity.PlayerComponent == nil or self.Entity.PlayerComponent.UserId ~= userId then
			return
		end
		if requestId == nil or requestId == "" then return end

		self:EnsureDailyRequestState()

		-- Must be one of today's 3
		local todayIds = self:GetTodaysRequestIds()
		local isToday = false
		for _, id in ipairs(todayIds) do
			if id == requestId then isToday = true break end
		end
		if not isToday then
			local pc = self.Entity:GetComponent("script.PlayerController")
			if isvalid(pc) then pc:ShowMineFeedback("오늘의 의뢰가 아닙니다.") end
			return
		end
		if self:IsDailyRequestCompleted(requestId) then
			local pc = self.Entity:GetComponent("script.PlayerController")
			if isvalid(pc) then pc:ShowMineFeedback("이미 납품한 의뢰입니다.") end
			return
		end

		local ds = _DataService:GetTable("RequestPoolDataSet")
		if ds == nil then return end
		local row = ds:FindRow("RequestId", requestId)
		if row == nil then return end
		local function cell(col, def)
			local ok, v = pcall(function() return row:GetItem(col) end)
			if ok and v ~= nil and v ~= "" then return v end
			return def
		end
		local reqItem = tostring(cell("RequiredItem", ""))
		local reqCnt = math.floor(tonumber(cell("RequiredCount", "1")) or 1)
		local rewItem = tostring(cell("RewardItem", "Coin"))
		local rewCnt = math.floor(tonumber(cell("RewardCount", "1")) or 1)
		if reqItem == "" or reqCnt < 1 then return end

		if not self:HasItem(reqItem, reqCnt) then
			local pc = self.Entity:GetComponent("script.PlayerController")
			if isvalid(pc) then
				pc:ShowMineFeedback("재료가 부족합니다: " .. self:GetItemDisplayName(reqItem) .. " x" .. tostring(reqCnt))
			end
			return
		end
		if not self:RemoveItem(reqItem, reqCnt) then
			local pc = self.Entity:GetComponent("script.PlayerController")
			if isvalid(pc) then pc:ShowMineFeedback("재료 차감에 실패했습니다.") end
			return
		end

		if rewItem ~= "" and rewCnt > 0 then
			self:AddItem(rewItem, rewCnt)
		end

		local list = self:SafeDecodeJson(self.DailyCompletedRequestsJson, {})
		table.insert(list, requestId)
		self.DailyCompletedRequestsJson = self:SafeEncodeJson(list, "[]")
		if _PersistenceManager then
			_PersistenceManager:MarkPlayerDirty(userId)
		end

		local pc = self.Entity:GetComponent("script.PlayerController")
		if isvalid(pc) then
			pc:ShowMineFeedback("의뢰 완료! " .. self:GetItemDisplayName(rewItem) .. " x" .. tostring(rewCnt))
		end
		log("[REQUEST] deliver " .. requestId .. " by " .. tostring(userId)
			.. " day=" .. tostring(self.DailyRequestDay))
	end

	method boolean HasRecipeUnlock(string unlockId)
		-- UnlockId 보유 여부. 공란 키는 항상 true.
		if unlockId == nil or unlockId == "" then return true end
		local list = self:SafeDecodeJson(self.UnlockedRecipesJson, {})
		for _, k in ipairs(list) do
			if k == unlockId then return true end
		end
		return false
	end

	@ExecSpace("ServerOnly")
	method boolean GrantRecipeUnlock(string unlockId)
		-- 멱등 해금 지급. 신규일 때만 저장·MarkDirty·클라 토스트.
		if unlockId == nil or unlockId == "" then return false end
		if self:HasRecipeUnlock(unlockId) then return false end
		local list = self:SafeDecodeJson(self.UnlockedRecipesJson, {})
		table.insert(list, unlockId)
		self.UnlockedRecipesJson = self:SafeEncodeJson(list, "[]")
		if self.Entity.PlayerComponent then
			_PersistenceManager:MarkPlayerDirty(self.Entity.PlayerComponent.UserId)
		end
		local displayName = unlockId
		local ds = _DataService:GetTable("RecipeDataSet")
		if ds ~= nil then
			local rowCount = ds:GetRowCount()
			for i = 1, rowCount do
				if ds:GetCell(i, "UnlockId") == unlockId then
					displayName = ds:GetCell(i, "RecipeName") or unlockId
					break
				end
			end
		end
		local userId = self.Entity.PlayerComponent and self.Entity.PlayerComponent.UserId or 0
		self:ClientOnRecipeUnlocked(displayName, userId)
		log("[UNLOCK] granted " .. unlockId .. " -> " .. displayName)
		return true
	end

	@ExecSpace("Client")
	method void ClientOnRecipeUnlocked(string recipeDisplayName)
		-- 해금 토스트/피드백.
		local pc = self.Entity:GetComponent("script.PlayerController")
		if isvalid(pc) then
			pc:ShowMineFeedback("새 제작법을 익혔다: " .. tostring(recipeDisplayName))
		end
	end

	@ExecSpace("ServerOnly")
	method void MigrateLegacyRecipeUnlocks()
		-- 잠금 도입 1회: 이미 보유한 산출물 레시피는 자동 해금.
		local ds = _DataService:GetTable("RecipeDataSet")
		if ds == nil then return end
		local rowCount = ds:GetRowCount()
		for i = 1, rowCount do
			local unlockId = ds:GetCell(i, "UnlockId") or ""
			if unlockId ~= "" then
				local recipeName = ds:GetCell(i, "RecipeName") or ""
				if recipeName ~= "" and self:GetItemCount(recipeName) > 0 then
					self:GrantRecipeUnlock(unlockId)
				end
			end
		end
	end

	@ExecSpace("ServerOnly")
	method integer ConsolidateCurrencyItems()
		-- IsCurrency 미기입 등으로 Items 스택에 쌓인 통화를 Coin 프로퍼티로 흡수.
		-- 몬스터 드롭→인벤 스택 / 상점 inv.Coin 분기 불일치 복구용.
		if self.Items == nil then return 0 end
		local moved = 0
		local toRemove = {}
		for k, v in pairs(self.Items) do
			local name = tostring(k)
			local count = 0
			if type(v) == "table" then
				name = tostring(v.name or k)
				count = math.floor(tonumber(v.count) or 0)
			else
				count = math.floor(tonumber(v) or 0)
			end
			if count > 0 and self:IsCurrencyItem(name) then
				moved = moved + count
				table.insert(toRemove, k)
			end
		end
		if moved <= 0 then return 0 end
		for _, k in ipairs(toRemove) do
			self.Items[k] = nil
		end
		self.Coin = (self.Coin or 0) + moved
		self.InventoryDataJson = self:SafeEncodeJson(self.Items, "{}")
		log("[CURRENCY] consolidated " .. tostring(moved)
			.. " stack coin(s) into Coin property. Total=" .. tostring(self.Coin))
		if _PersistenceManager and self.Entity.PlayerComponent then
			_PersistenceManager:MarkPlayerDirty(self.Entity.PlayerComponent.UserId)
		end
		return moved
	end

	@ExecSpace("ServerOnly")
	method any GetResearchRow(string researchId)
		-- ResearchDataSet FindRow by ResearchId.
		if researchId == nil or researchId == "" then return nil end
		local ds = _DataService:GetTable("ResearchDataSet")
		if ds == nil then return nil end
		return ds:FindRow("ResearchId", researchId)
	end

	@ExecSpace("ServerOnly")
	method boolean TryCompleteActiveResearch()
		-- 경과 시간이 Duration 이상이면 GrantRecipeUnlock 후 진행 상태 클리어.
		if self.ActiveResearchId == nil or self.ActiveResearchId == "" then return false end
		local row = self:GetResearchRow(self.ActiveResearchId)
		if row == nil then
			log_warning("[RESEARCH] unknown ActiveResearchId=" .. tostring(self.ActiveResearchId) .. " — clearing")
			self.ActiveResearchId = ""
			self.ResearchStartTime = "0"
			return false
		end
		local duration = math.floor(tonumber(row:GetItem("Duration")) or 0)
		local startT = tonumber(self.ResearchStartTime) or 0
		local elapsed = os.time() - startT
		if elapsed < duration then return false end

		local unlockId = row:GetItem("UnlockRecipeId") or ""
		local displayName = row:GetItem("DisplayName") or unlockId
		self.ActiveResearchId = ""
		self.ResearchStartTime = "0"
		if unlockId ~= "" then
			self:GrantRecipeUnlock(unlockId)
		end
		if self.Entity.PlayerComponent then
			_PersistenceManager:MarkPlayerDirty(self.Entity.PlayerComponent.UserId)
		end
		local userId = self.Entity.PlayerComponent and self.Entity.PlayerComponent.UserId or 0
		self:ClientOnResearchComplete(displayName, userId)
		log("[RESEARCH] completed " .. tostring(displayName) .. " unlock=" .. tostring(unlockId))
		return true
	end

	@ExecSpace("Client")
	method void ClientOnResearchComplete(string researchDisplayName)
		local pc = self.Entity:GetComponent("script.PlayerController")
		if isvalid(pc) then
			pc:ShowMineFeedback("연구 완료: " .. tostring(researchDisplayName))
		end
	end

	@ExecSpace("Server")
	method void ServerRequestUseItem(string itemName)
		-- T9/T16: Category=consumable 사용. UseUnlockId → GrantRecipeUnlock 후 1 소모.
		-- (T16 UseBuffId 등은 동일 진입점에서 확장 — 전용 해금 경로 재구현 금지.)
		local userId = senderUserId
		if userId == nil or userId == "" then return end
		local playerComp = self.Entity.PlayerComponent
		if playerComp == nil or userId ~= playerComp.UserId then return end
		if itemName == nil or itemName == "" then return end

		local baseName = self:GetBaseItemName(itemName)
		local ds = _DataService:GetTable("item_dataset")
		if ds == nil then return end
		local row = ds:FindRow("Name", baseName)
		if row == nil then return end
		local category = row:GetItem("Category") or ""
		if category ~= "consumable" then
			local pc = self.Entity:GetComponent("script.PlayerController")
			if isvalid(pc) then pc:ShowMineFeedback("사용할 수 없는 아이템입니다.") end
			return
		end
		if self:GetItemCount(baseName) < 1 then
			local pc = self.Entity:GetComponent("script.PlayerController")
			if isvalid(pc) then pc:ShowMineFeedback("아이템이 없습니다.") end
			return
		end

		-- 재분배 소모품: 데이터 효과 키로만 분기. 잘못된 데이터·미투자 상태에서는 소모하지 않는다.
		local okReset, rawReset = pcall(function() return row:GetItem("UseReset") end)
		local resetKind = ""
		if okReset and rawReset ~= nil then resetKind = tostring(rawReset) end
		if resetKind ~= "" then
			if resetKind ~= "AP" and resetKind ~= "JobSP" then return end
			local pcReset = self.Entity:GetComponent("script.PlayerController")
			if not isvalid(pcReset) then return end
			local plan = pcReset:BuildProgressReset(resetKind)
			if plan == nil then
				pcReset:ShowMineFeedback("초기화할 투자 포인트가 없거나 데이터를 확인할 수 없습니다.")
				return
			end
			if not self:RemoveItem(baseName, 1) then return end
			pcReset:ApplyProgressReset(plan)
			pcReset:ShowMineFeedback("초기화 완료: AP " .. tostring(plan.ap) .. " / SP " .. tostring(plan.sp) .. " 환급")
			return
		end

		local useUnlockId = ""
		local okU, vU = pcall(function() return row:GetItem("UseUnlockId") end)
		if okU and vU ~= nil then useUnlockId = vU end

		if useUnlockId ~= nil and useUnlockId ~= "" then
			if self:HasRecipeUnlock(useUnlockId) then
				local pc = self.Entity:GetComponent("script.PlayerController")
				if isvalid(pc) then pc:ShowMineFeedback("이미 익힌 제작법입니다.") end
				return
			end
			if not self:RemoveItem(baseName, 1) then return end
			self:GrantRecipeUnlock(useUnlockId)
			log("[USE] scroll " .. baseName .. " -> unlock " .. useUnlockId)
			return
		end

		-- T16: UseBuffId → PlayerBuffs.ApplyBuff (소모는 적용 성공 후에만)
		local useBuffId = ""
		local okB, vB = pcall(function() return row:GetItem("UseBuffId") end)
		if okB and vB ~= nil then useBuffId = tostring(vB) end
		if useBuffId ~= nil and useBuffId ~= "" then
			local trimmed = string.match(useBuffId, "^%s*(.-)%s*$")
			if trimmed ~= nil then useBuffId = trimmed end
		end
		if useBuffId ~= nil and useBuffId ~= "" then
			local buffs = self.Entity:GetComponent("script.PlayerBuffs")
			if not isvalid(buffs) then
				buffs = self.Entity:GetComponent("PlayerBuffs")
			end
			if not isvalid(buffs) then
				-- DefaultPlayer 미부착/리프레시 누락 폴백
				self.Entity:AddComponent("script.PlayerBuffs")
				buffs = self.Entity:GetComponent("script.PlayerBuffs")
				if not isvalid(buffs) then
					self.Entity:AddComponent("PlayerBuffs")
					buffs = self.Entity:GetComponent("PlayerBuffs")
				end
			end
			if not isvalid(buffs) then
				log_error("[USE] PlayerBuffs missing after AddComponent")
				local pc = self.Entity:GetComponent("script.PlayerController")
				if isvalid(pc) then pc:ShowMineFeedback("버프 시스템을 불러오지 못했습니다.") end
				return
			end
			if not buffs:ApplyBuff(useBuffId) then
				local pc = self.Entity:GetComponent("script.PlayerController")
				if isvalid(pc) then pc:ShowMineFeedback("버프를 적용할 수 없습니다: " .. useBuffId) end
				log_warning("[USE] ApplyBuff failed id=" .. useBuffId)
				return
			end
			if not self:RemoveItem(baseName, 1) then
				log_warning("[USE] buff applied but RemoveItem failed for " .. baseName)
			end
			local pcOk = self.Entity:GetComponent("script.PlayerController")
			if isvalid(pcOk) then
				local dsB = _DataService:GetTable("BuffDataSet")
				local dn = useBuffId
				if dsB ~= nil then
					local br = dsB:FindRow("BuffId", useBuffId)
					if br ~= nil then dn = br:GetItem("DisplayName") or useBuffId end
				end
				pcOk:ShowMineFeedback("버프 적용: " .. tostring(dn))
			end
			log("[USE] buff item " .. baseName .. " -> " .. useBuffId)
			return
		end

		-- 이름 변경권(UseRename = creature): 바라보는 내 가축·펫의 이름을 바꾼다. 소모는 새 이름이 확정될 때(CreatureRoster).
		local okRn, vRn = pcall(function() return row:GetItem("UseRename") end)
		if okRn and vRn ~= nil and tostring(vRn) == "creature" then
			if _CreatureRoster ~= nil then
				_CreatureRoster:OnUseRenameTicket(self.Entity, itemName)
			end
			return
		end

		-- T19: UseAnimalId → 우리 근처 가축 소환 (영지 전용, 티켓 1 소모)
		local useAnimalId = ""
		local okA, vA = pcall(function() return row:GetItem("UseAnimalId") end)
		if okA and vA ~= nil then useAnimalId = tostring(vA) end
		if useAnimalId ~= nil and useAnimalId ~= "" then
			local trimmedA = string.match(useAnimalId, "^%s*(.-)%s*$")
			if trimmedA ~= nil then useAnimalId = trimmedA end
		end
		if useAnimalId ~= nil and useAnimalId ~= "" then
			-- 입주권 = 이름짓기 후 우리에 들임 / 이름 붙은 가축 아이템 = 상태 그대로 다시 들임 (CreatureRoster).
			if _CreatureRoster ~= nil then
				_CreatureRoster:OnUseAnimalItem(self.Entity, itemName, baseName, useAnimalId)
			end
			return
		end

		-- T23: UsePetId → 펫 소환(기존 펫 교체). 아이템 비소모.
		local usePetId = ""
		local okPet, vPet = pcall(function() return row:GetItem("UsePetId") end)
		if okPet and vPet ~= nil then usePetId = tostring(vPet) end
		if usePetId ~= nil and usePetId ~= "" then
			local trimmedP = string.match(usePetId, "^%s*(.-)%s*$")
			if trimmedP ~= nil then usePetId = trimmedP end
		end
		if usePetId ~= nil and usePetId ~= "" then
			-- 빈 호루라기 = 이름짓기 후 들임 / 이름 붙은 호루라기 = 영지에 두기 ↔ 데려오기 (CreatureRoster).
			if _CreatureRoster ~= nil then
				_CreatureRoster:OnUsePetItem(self.Entity, itemName, baseName, usePetId)
			end
			return
		end

		-- 2026-09-30: DeathEffect 아이템(쓰러짐 관련). instant_revive 는 쓰러져 있을 때 그 자리 부활,
		-- protect_inventory 는 사용하는 물건이 아니라 쓰러질 때 자동으로 1개 소모된다.
		local deathEffect = ""
		local okDE, vDE = pcall(function() return row:GetItem("DeathEffect") end)
		if okDE and vDE ~= nil then deathEffect = tostring(vDE) end
		if deathEffect == "instant_revive" then
			-- ⚠ RPC 본문이라 `---@type` 사용자 타입 주석 금지(규칙 53) — 동적 호출.
			local pcR = self.Entity:GetComponent("script.PlayerController")
			if isvalid(pcR) then
				pcR:TryInstantRevive()
			end
			return
		elseif deathEffect == "protect_inventory" then
			local pcP = self.Entity:GetComponent("script.PlayerController")
			if isvalid(pcP) then pcP:ShowMineFeedback("가지고 있으면 쓰러질 때 자동으로 1개 사용돼 인벤토리를 지켜 줘요.") end
			return
		end

		local pc2 = self.Entity:GetComponent("script.PlayerController")
		if isvalid(pc2) then pc2:ShowMineFeedback("아직 사용할 수 없습니다.") end
	end

	method string GetDeathEffectItemName(string effect)
		-- item_dataset.DeathEffect 가 effect 인 아이템의 Name(인벤토리 키). 없으면 "".
		-- 서버(쓰러짐 처리)·클라(쓰러짐 패널 보유 수) 양쪽에서 쓴다 — 이름을 코드에 박지 않는다(규칙 1).
		if effect == nil or effect == "" then return "" end
		if self._T.deathEffectNames == nil then
			local map = {}
			local ds = _DataService:GetTable("item_dataset")
			if ds ~= nil then
				for i = 1, ds:GetRowCount() do
					local okE, e = pcall(function() return ds:GetCell(i, "DeathEffect") end)
					if okE and e ~= nil and tostring(e) ~= "" and map[tostring(e)] == nil then
						map[tostring(e)] = tostring(ds:GetCell(i, "Name") or "")
					end
				end
			end
			self._T.deathEffectNames = map
		end
		return self._T.deathEffectNames[effect] or ""
	end

	-- ── 보유 동물(가축·펫) — 흐름은 CreatureRoster, 여기는 인벤토리 칸·RPC 창구만 ──────────────────

	@ExecSpace("Server")
	method void ServerSubmitCreatureName(string itemKey, string creatureName)
		-- 이름짓기 팝업의 [확인]. 서버가 조건을 전부 다시 검사한 뒤 들이거나 거절한다(CreatureRoster.OnNameSubmitted).
		local playerComp = self.Entity.PlayerComponent
		if playerComp == nil or senderUserId ~= playerComp.UserId then return end
		if _CreatureRoster ~= nil then
			_CreatureRoster:OnNameSubmitted(self.Entity, itemKey or "", creatureName or "")
		end
	end

	@ExecSpace("Client")
	method void ClientOpenNamePrompt(string kind, string speciesName, string itemKey, string suggested, string errorText)
		-- 서버 → 이 플레이어 클라: 이름짓기 팝업 열기 (ui/NamingGroup.ui · UINamingLogic).
		if _UINamingLogic ~= nil then
			_UINamingLogic:Open(kind, speciesName, itemKey, suggested, errorText)
		end
	end

	method boolean IsCreatureItemKey(string itemKey)
		-- 명부 개체를 가리키는 이름 붙은 칸인가 (가방 속 가축 / 이름 붙은 호루라기).
		if itemKey == nil or itemKey == "" then return false end
		local items = self.Items
		if self:IsClient() then
			items = self:SafeDecodeJson(self.InventoryDataJson, {})
		end
		local entry = items[itemKey]
		return type(entry) == "table" and entry.creatureId ~= nil and entry.creatureId ~= ""
	end

	method string GetItemLabel(string itemKey)
		-- 칸에 보일 이름: 이름 붙은 칸이면 그 이름, 아니면 item_dataset 표시명. 서버·클라 공용.
		if itemKey == nil or itemKey == "" then return "" end
		local items = self.Items
		if self:IsClient() then
			items = self:SafeDecodeJson(self.InventoryDataJson, {})
		end
		local entry = items[itemKey]
		if type(entry) == "table" and entry.label ~= nil and tostring(entry.label) ~= "" then
			return tostring(entry.label)
		end
		return self:GetItemDisplayName(self:GetBaseItemName(itemKey))
	end

	@ExecSpace("ServerOnly")
	method string AddCreatureItem(string baseName, string creatureId, string creatureLabel)
		-- 명부 개체 하나를 가리키는 이름 붙은 칸을 만든다. 키 = "<기본 이름>#<개체 id>".
		-- '#' 구분자는 구세이브 고유키 패턴(_숫자_숫자)과 겹치지 않아 키 병합(Fold)·이름 추정에 걸리지 않는다.
		if baseName == nil or baseName == "" or creatureId == nil or creatureId == "" then return "" end
		local key = baseName .. "#" .. creatureId
		self.Items[key] = { name = baseName, count = 1, durability = 100, creatureId = creatureId, label = creatureLabel or "" }
		self.InventoryDataJson = self:SafeEncodeJson(self.Items, "{}")
		self:NotifyQuestInventoryChanged()
		if _PersistenceManager and self.Entity.PlayerComponent then
			_PersistenceManager:MarkPlayerDirty(self.Entity.PlayerComponent.UserId)
		end
		log("[CREATURE] item added " .. key .. " label=" .. tostring(creatureLabel))
		return key
	end

	@ExecSpace("ServerOnly")
	method string FindCreatureItemKey(string creatureId)
		-- 개체 id 를 가리키는 칸 키 (없으면 "").
		if creatureId == nil or creatureId == "" then return "" end
		for k, v in pairs(self.Items) do
			if type(v) == "table" and v.creatureId == creatureId then return k end
		end
		return ""
	end

	@ExecSpace("ServerOnly")
	method void SetCreatureItemLabel(string itemKey, string creatureLabel)
		-- 이름 붙은 칸의 표시 이름을 바꾼다(명부 이름과 맞추기).
		local entry = self.Items[itemKey]
		if type(entry) ~= "table" then return end
		if entry.label == creatureLabel then return end
		entry.label = creatureLabel
		self.InventoryDataJson = self:SafeEncodeJson(self.Items, "{}")
	end


	@ExecSpace("Server")
	method void ServerRequestStartResearch(string researchId)
		-- 연구소 연구 시작: 재료 차감 → ActiveResearch 설정. 완료는 타이머/로드 시 TryComplete.
		local userId = senderUserId
		if userId == nil or userId == "" then return end
		local playerComp = self.Entity.PlayerComponent
		if playerComp == nil or userId ~= playerComp.UserId then return end

		if researchId == nil or researchId == "" then return end

		-- 오프라인 경과로 이미 끝난 연구가 있으면 먼저 정산
		self:TryCompleteActiveResearch()

		-- 연구 두루마리 제출 (ResearchDataSet.ScrollItem): 재료·시간 없이 그 연구를 바로 마친다.
		-- 두루마리는 사용 아이템이 아니라 제출용 재료다 — 연구소를 거쳐야만 제작법이 열린다(2026-10-06 제작자 결정).
		-- 다른 연구가 진행 중이어도 제출할 수 있고, 같은 연구가 진행 중이면 그 연구를 끝낸다.
		local scrollRow = self:GetResearchRow(researchId)
		if scrollRow ~= nil then
			local okS, vS = pcall(function() return scrollRow:GetItem("ScrollItem") end)
			local scrollItem = ""
			if okS and vS ~= nil then scrollItem = tostring(vS) end
			local scrollUnlock = scrollRow:GetItem("UnlockRecipeId") or ""
			if scrollItem ~= "" and self:GetItemCount(scrollItem) > 0
				and (scrollUnlock == "" or not self:HasRecipeUnlock(scrollUnlock)) then
				if not self:RemoveItem(scrollItem, 1) then return end
				if self.ActiveResearchId == researchId then
					self.ActiveResearchId = ""
					self.ResearchStartTime = "0"
				end
				if scrollUnlock ~= "" then self:GrantRecipeUnlock(scrollUnlock) end
				_PersistenceManager:MarkPlayerDirty(userId)
				local scrollName = scrollRow:GetItem("DisplayName") or researchId
				self:ClientOnResearchComplete(tostring(scrollName) .. " (두루마리 제출)", playerComp.UserId)
				log("[RESEARCH] scroll submit " .. scrollItem .. " -> " .. researchId .. " by " .. tostring(userId))
				return
			end
		end

		if self.ActiveResearchId ~= nil and self.ActiveResearchId ~= "" then
			local pc = self.Entity:GetComponent("script.PlayerController")
			if isvalid(pc) then pc:ShowMineFeedback("이미 연구가 진행 중입니다.") end
			return
		end

		local row = self:GetResearchRow(researchId)
		if row == nil then
			local pc = self.Entity:GetComponent("script.PlayerController")
			if isvalid(pc) then pc:ShowMineFeedback("알 수 없는 연구입니다.") end
			return
		end

		local unlockId = row:GetItem("UnlockRecipeId") or ""
		if unlockId ~= "" and self:HasRecipeUnlock(unlockId) then
			local pc = self.Entity:GetComponent("script.PlayerController")
			if isvalid(pc) then pc:ShowMineFeedback("이미 해금된 연구입니다.") end
			return
		end

		local inputItem = row:GetItem("InputItem") or ""
		local inputCount = math.floor(tonumber(row:GetItem("InputCount")) or 0)
		if inputItem == "" or inputCount <= 0 then
			log_error("[RESEARCH] invalid input for " .. researchId)
			return
		end
		if self:GetItemCount(inputItem) < inputCount then
			local pc = self.Entity:GetComponent("script.PlayerController")
			if isvalid(pc) then
				pc:ShowMineFeedback("재료가 부족합니다: " .. self:GetItemDisplayName(inputItem) .. " x" .. tostring(inputCount))
			end
			return
		end
		if not self:RemoveItem(inputItem, inputCount) then
			local pc = self.Entity:GetComponent("script.PlayerController")
			if isvalid(pc) then pc:ShowMineFeedback("재료 차감에 실패했습니다.") end
			return
		end

		self.ActiveResearchId = researchId
		self.ResearchStartTime = tostring(os.time())
		_PersistenceManager:MarkPlayerDirty(userId)

		local displayName = row:GetItem("DisplayName") or researchId
		local pc2 = self.Entity:GetComponent("script.PlayerController")
		if isvalid(pc2) then
			pc2:ShowMineFeedback("연구를 시작했습니다: " .. tostring(displayName))
		end
		log("[RESEARCH] started " .. researchId .. " by " .. tostring(userId))

		-- Duration 0 즉시 완료 지원
		self:TryCompleteActiveResearch()
	end

	@ExecSpace("ServerOnly")
	method string AddItem(string itemName, integer count)
		-- Adds count items and pushes the synced JSON snapshot to clients.
		if count <= 0 then return "" end
		
		if self:IsCurrencyItem(itemName) then
			self.Coin = self.Coin + count
			log("Inventory updated: added currency item. Total: " .. self.Coin)
			self:ClientShowPickupMessage(itemName, count, self.Coin)
			if _PersistenceManager and self.Entity.PlayerComponent then
				_PersistenceManager:MarkPlayerDirty(self.Entity.PlayerComponent.UserId)
			end
			return itemName
		end
		
		local addedKey = itemName
		if self:IsUniqueKeyedItem(itemName) then
			local keys = {}
			for i = 1, count do
				local uniqueId = tostring(math.floor(_UtilLogic.ServerElapsedSeconds * 1000)) .. "_" .. tostring(math.random(100000, 999999))
				local uniqueKey = itemName .. "_" .. uniqueId
				self.Items[uniqueKey] = { name = itemName, count = 1, durability = 100 }
				table.insert(keys, uniqueKey)
			end
			self.InventoryDataJson = self:SafeEncodeJson(self.Items, "{}")
			
			log("Inventory updated: added " .. count .. " unique " .. itemName .. "(s).")
			self:ClientShowPickupMessage(itemName, count, self:GetItemCount(itemName))
			addedKey = keys[1] or itemName
		else
			local current = self.Items[itemName] or 0
			if type(current) == "table" then
				current = current.count or 1
			end
			self.Items[itemName] = current + count
			self:FoldStackableToolKeys(itemName)
			self.InventoryDataJson = self:SafeEncodeJson(self.Items, "{}")
			
			log("Inventory updated: added " .. count .. " " .. itemName .. ". Total: " .. tostring(self.Items[itemName]))
			self:ClientShowPickupMessage(itemName, count, self:GetItemCount(itemName))
			addedKey = itemName
		end

		-- T22: 도감 누적 획득 기록 (통화는 위에서 early-return되어 제외됨).
		self:RecordItemAcquired(itemName, count)

		self:NotifyQuestInventoryChanged()

		if _PersistenceManager and self.Entity.PlayerComponent then
			_PersistenceManager:MarkPlayerDirty(self.Entity.PlayerComponent.UserId)
		end
		return addedKey
	end

	@ExecSpace("ServerOnly")
	method void NotifyQuestInventoryChanged()
		-- 보유량 기준(CountMode=Have) 퀘스트 조건을 현재 인벤토리로 재평가한다.
		-- AddItem / RemoveItem 성공 경로 전부가 여기를 통과해야 표시와 제출 가능 여부가 어긋나지 않는다.
		local pq = self.Entity:GetComponent("script.PlayerQuest")
		if not isvalid(pq) then
			return
		end
		---@type PlayerQuest
		local playerQuest = pq
		playerQuest:RefreshHeldConditions()
	end

	@ExecSpace("ServerOnly")
	method void RecordItemAcquired(string itemName, integer count)
		-- T22: 도감 아이템 누적 획득 수 갱신. AddItem(통화 제외 퍼널)에서 호출 —
		-- 픽업/제작/상점/의뢰 보상 등 모든 획득 경로가 AddItem을 통과하므로 여기 1곳으로 커버.
		-- T43: 0→1 전이 시 DexRewardDataSet 기반 코인+XP 1회 지급(멱등 — 카운터가 수령 기록).
		if itemName == nil or itemName == "" or count <= 0 then return end
		local items = self:DecodeFlatJson(self.DexItemsJson)
		local prev = math.floor(tonumber(items[itemName]) or 0)
		items[itemName] = prev + count
		self.DexItemsJson = self:SafeEncodeJson(items, "{}")
		if prev == 0 then
			local rarity = ""
			local ds = _DataService:GetTable("item_dataset")
			if ds ~= nil then
				local row = ds:FindRow("Name", itemName)
				if row ~= nil then
					local okR, r = pcall(function() return row:GetItem("Rarity") end)
					if okR and r ~= nil then rarity = tostring(r) end
				end
			end
			self:GrantDexDiscoveryReward("item", rarity, itemName)
		end
	end

	@ExecSpace("ServerOnly")
	method void RecordMonsterKill(string monsterId)
		-- T22: 도감 몬스터 처치 수 갱신. Monster.Dead가 막타 플레이어에게 호출.
		-- T43: 0→1 전이 시 몬스터 기본 보상 1회 지급.
		if monsterId == nil or monsterId == "" then return end
		local monsters = self:DecodeFlatJson(self.DexMonstersJson)
		local prev = math.floor(tonumber(monsters[monsterId]) or 0)
		monsters[monsterId] = prev + 1
		self.DexMonstersJson = self:SafeEncodeJson(monsters, "{}")
		if prev == 0 then
			local disp = monsterId
			local mds = _DataService:GetTable("MonsterCoinDropDataSet")
			if mds ~= nil then
				local mrow = mds:FindRow("MonsterId", monsterId)
				if mrow ~= nil then
					local okD, d = pcall(function() return mrow:GetItem("DisplayName") end)
					if okD and d ~= nil and tostring(d) ~= "" then disp = tostring(d) end
				end
			end
			self:GrantDexDiscoveryReward("monster", "", disp)
		end
		if _PersistenceManager and self.Entity.PlayerComponent then
			_PersistenceManager:MarkPlayerDirty(self.Entity.PlayerComponent.UserId)
		end
	end

	@ExecSpace("ServerOnly")
	method void GrantDexDiscoveryReward(string kind, string rarity, string displayName)
		-- T43: DexRewardDataSet에서 Kind(+Rarity) 매칭 → 코인/XP 지급 + 토스트.
		-- 보상은 코인·XP 한정(아이템 보상은 AddItem 재귀 위험 — 스펙 ③).
		local coin = 0
		local xp = 0
		local ds = _DataService:GetTable("DexRewardDataSet")
		if ds ~= nil then
			local n = ds:GetRowCount()
			local fallbackCoin = 0
			local fallbackXp = 0
			local matched = false
			for i = 1, n do
				local k = ds:GetCell(i, "Kind") or ""
				if k == kind then
					local r = ds:GetCell(i, "Rarity") or ""
					local c = math.floor(tonumber(ds:GetCell(i, "RewardCoin")) or 0)
					local x = math.floor(tonumber(ds:GetCell(i, "RewardXp")) or 0)
					if r == "" then
						fallbackCoin = c
						fallbackXp = x
					end
					if rarity ~= "" and r == rarity then
						coin = c
						xp = x
						matched = true
						break
					end
				end
			end
			if not matched then
				coin = fallbackCoin
				xp = fallbackXp
			end
		end
		if coin <= 0 and xp <= 0 then
			log("[DEX] discovery no-reward kind=" .. tostring(kind) .. " rarity=" .. tostring(rarity)
				.. " name=" .. tostring(displayName))
			return
		end

		-- 통화 경로: Coin 프로퍼티 직접 가산(AddItem 경로는 픽업 토스트 중복). IsCurrency early-return과 동일 저장소.
		if coin > 0 then
			self.Coin = (self.Coin or 0) + coin
		end
		if xp > 0 then
			local pc = self.Entity:GetComponent("script.PlayerController")
			if isvalid(pc) then
				pc:AddXP(xp)
			end
		end

		local msg = "도감 등록: " .. tostring(displayName)
			.. " (+" .. tostring(coin) .. "코인 +" .. tostring(xp) .. " XP)"
		local pcFb = self.Entity:GetComponent("script.PlayerController")
		if isvalid(pcFb) then
			pcFb:ShowMineFeedback(msg)
		else
			self:ClientShowFeedback(msg)
		end
		log("[DEX] discovery reward kind=" .. tostring(kind) .. " rarity=" .. tostring(rarity)
			.. " name=" .. tostring(displayName) .. " coin=" .. tostring(coin) .. " xp=" .. tostring(xp)
			.. " bal=" .. tostring(self.Coin))
		if _PersistenceManager and self.Entity.PlayerComponent then
			_PersistenceManager:MarkPlayerDirty(self.Entity.PlayerComponent.UserId)
		end
	end

	method table DecodeFlatJson(string json)
		-- 평탄 JSON 문자열을 Lua 테이블로 디코드(실패 시 빈 테이블). 중첩 없음(LEA-3001 회피).
		local t = {}
		local ok, decoded = pcall(function() return _HttpService:JSONDecode(json) end)
		if ok and type(decoded) == "table" then t = decoded end
		return t
	end

	@ExecSpace("ServerOnly")
	method string AddToolInstanceWithDurability(string itemName, integer durability)
		-- MaxStack>1 기믹 도구는 내구도 인스턴스가 아니라 AddItem 중첩 경로를 탄다.
		if not self:IsUniqueKeyedItem(itemName) then
			return self:AddItem(itemName, 1)
		end
		local uniqueId = tostring(math.floor(_UtilLogic.ServerElapsedSeconds * 1000)) .. "_" .. tostring(math.random(100000, 999999))
		local uniqueKey = itemName .. "_" .. uniqueId
		self.Items[uniqueKey] = { name = itemName, count = 1, durability = durability }
		self.InventoryDataJson = self:SafeEncodeJson(self.Items, "{}")
		
		log("Inventory updated: added tool instance " .. uniqueKey .. " with durability " .. durability)
		self:ClientShowPickupMessage(itemName, 1, self:GetItemCount(itemName))
		
		if _PersistenceManager and self.Entity.PlayerComponent then
			_PersistenceManager:MarkPlayerDirty(self.Entity.PlayerComponent.UserId)
		end
		return uniqueKey
	end

	@ExecSpace("ServerOnly")
	method boolean RemoveItem(string itemName, integer count)
		-- Removes count items if owned; returns false when insufficient.
		if count <= 0 then return true end
		
		if self:IsCurrencyItem(itemName) then
			if self.Coin < count then return false end
			self.Coin = self.Coin - count
			self:NotifyQuestInventoryChanged()
			if _PersistenceManager and self.Entity.PlayerComponent then
				_PersistenceManager:MarkPlayerDirty(self.Entity.PlayerComponent.UserId)
			end
			return true
		end

		local entry = self.Items[itemName]
		if entry ~= nil then
			if type(entry) == "table" then
				self.Items[itemName] = nil
				if self.EquippedTool == itemName then
					self.EquippedTool = ""
					self:ApplyHeldToolCostume()
				end
				self.InventoryDataJson = self:SafeEncodeJson(self.Items, "{}")
				self:NotifyQuestInventoryChanged()
				if _PersistenceManager and self.Entity.PlayerComponent then
					_PersistenceManager:MarkPlayerDirty(self.Entity.PlayerComponent.UserId)
				end
				return true
			else
				if entry < count then return false end
				self.Items[itemName] = entry - count
				if self.Items[itemName] <= 0 then
					self.Items[itemName] = nil
					if self.EquippedTool == itemName then
						self.EquippedTool = ""
						self:ApplyHeldToolCostume()
					end
				end
				self.InventoryDataJson = self:SafeEncodeJson(self.Items, "{}")
				self:NotifyQuestInventoryChanged()
				if _PersistenceManager and self.Entity.PlayerComponent then
					_PersistenceManager:MarkPlayerDirty(self.Entity.PlayerComponent.UserId)
				end
				return true
			end
		end
		
		local totalCount = self:GetItemCount(itemName)
		if totalCount < count then return false end
		
		local removedCount = 0
		local keysToRemove = {}
		for k, v in pairs(self.Items) do
			-- 이름 기준 제거(입주권 소모·퀘스트 제출 등)는 이름 붙은 칸을 건드리지 않는다 — 그 칸은 키로만 지운다.
			if type(v) == "table" and v.name == itemName and (v.creatureId == nil or v.creatureId == "") then
				table.insert(keysToRemove, k)
				removedCount = removedCount + 1
				if removedCount >= count then
					break
				end
			end
		end
		-- 이름 붙은 칸만 남아 지울 수 있는 수가 모자라면 아무것도 지우지 않고 실패.
		if removedCount < count then return false end

		for _, k in ipairs(keysToRemove) do
			self.Items[k] = nil
			if self.EquippedTool == k then
				self.EquippedTool = ""
				self:ApplyHeldToolCostume()
			end
		end
		
		self.InventoryDataJson = self:SafeEncodeJson(self.Items, "{}")
		self:NotifyQuestInventoryChanged()
		if _PersistenceManager and self.Entity.PlayerComponent then
			_PersistenceManager:MarkPlayerDirty(self.Entity.PlayerComponent.UserId)
		end
		return true
	end

	@ExecSpace("Server")
	method void ServerRequestDiscard(string itemName, integer count, string mode)
		-- Discards up to `count` of itemName from the requester's inventory.
		-- mode == "drop": spawn the items on the ground (re-pickable after a short grace window);
		-- any other mode (e.g. "delete"): remove them permanently. Count is clamped to owned amount.
		local playerComp = self.Entity.PlayerComponent
		if playerComp == nil or senderUserId ~= playerComp.UserId then
			return
		end
		if itemName == nil or itemName == "" then return end
		-- 이름 붙은 동물(가방 속 가축·이름 붙은 호루라기)은 버릴 수 없다 (2026-10-10 제작자 결정).
		if self:IsCreatureItemKey(itemName) then
			local pcD = self.Entity:GetComponent("script.PlayerController")
			if isvalid(pcD) then pcD:ShowMineFeedback("이름을 지어 준 동물은 버릴 수 없습니다.") end
			return
		end

		local baseName = self:GetBaseItemName(itemName)
		local owned = 0
		local entry = self.Items[itemName]
		if entry ~= nil then
			if type(entry) == "table" then
				owned = entry.count or 1
			else
				owned = entry
			end
		else
			owned = self:GetItemCount(itemName)
		end
		if owned <= 0 then return end

		local dropCount = count
		if dropCount > owned then dropCount = owned end
		if dropCount <= 0 then return end

		if mode == "drop" then
			local map = self.Entity.CurrentMap
			if isvalid(map) and _TileDurabilityManager ~= nil then
				-- Resolve the lowercase item id from the inventory display name.
				local itemId = ""
				local ds = _DataService:GetTable("item_dataset")
				if ds ~= nil then
					local row = ds:FindRow("Name", baseName)
					if row ~= nil then
						itemId = row:GetItem("id")
					end
				end
				if itemId ~= "" then
					local pos = self.Entity.TransformComponent.WorldPosition
					local dropPos = Vector3(pos.x, pos.y, 0)
					-- 2s pickup grace so the player can step away before the magnet re-collects.
					_TileDurabilityManager:SpawnResourceDrop(map, dropPos, itemId, dropCount, dropCount, 2.0)
				else
					log_warning("ServerRequestDiscard: no item_dataset id for '" .. baseName .. "'; deleting instead of dropping.")
				end
			end
		end

		self:RemoveItem(itemName, dropCount)
		log("[DISCARD] Player " .. self.Entity.Name .. " discarded " .. dropCount .. " " .. itemName .. " (mode=" .. tostring(mode) .. ")")
	end

	@ExecSpace("ClientOnly")
	method void OnSyncProperty(string name, any value)
		-- Live-refreshes open popups whenever the inventory or equipped tool syncs.
		if name ~= "InventoryDataJson" and name ~= "EquippedTool" and name ~= "QuickSlotsJson" and name ~= "Coin" then return end
		
		-- Only react to the local player's own inventory
		local localPlayer = _UserService.LocalPlayer
		if not isvalid(localPlayer) or localPlayer ~= self.Entity then return end
		
		local shopPopup = _EntityService:GetEntityByPath("/ui/PopupGroup/ShopPopup")
		if isvalid(shopPopup) and shopPopup.Enable then
			local ctrl = shopPopup:GetComponent("script.UIShopController")
			if isvalid(ctrl) then
				ctrl:RefreshShop()
			end
		end
		
		local invPopup = _EntityService:GetEntityByPath("/ui/PopupGroup/InventoryPopup")
		if isvalid(invPopup) and invPopup.Enable then
			local ctrl = invPopup:GetComponent("script.UIInventoryController")
			if isvalid(ctrl) then
				local c = ctrl
				c:RefreshInventoryData()
			end
		end
		
		local craftPopup = _EntityService:GetEntityByPath("/ui/PopupGroup/CraftingPopup")
		if isvalid(craftPopup) and craftPopup.Enable then
			local ctrl = craftPopup:GetComponent("script.UICraftingController")
			if isvalid(ctrl) then
				local c = ctrl
				c:UpdateDetails()
			end
		end
		
		local charPopup = _EntityService:GetEntityByPath("/ui/PopupGroup/CharacterPopup")
		if isvalid(charPopup) and charPopup.Enable then
			local ctrl = charPopup:GetComponent("script.UICharacterController")
			if isvalid(ctrl) then
				local c = ctrl
				c:RefreshStats()
			end
		end
		
		local hudEntity = _EntityService:GetEntityByPath("/ui/HUDGroup")
		if isvalid(hudEntity) then
			local hudCtrl = hudEntity:GetComponent("script.UIHUDController")
			if isvalid(hudCtrl) then
				local hc = hudCtrl
				hc:UpdateHUD()
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void ClientShowPickupMessage(string itemName, integer count, integer total)
		-- Client-side pickup feedback log.
		log("Picked up " .. count .. " " .. itemName .. " (Total: " .. total .. ")")
	end

	method boolean HasItem(string itemName, integer requiredCount)
		-- Checks whether at least requiredCount of itemName is owned.
		if self:IsCurrencyItem(itemName) then
			return self.Coin >= requiredCount
		end
		return self:GetItemCount(itemName) >= requiredCount
	end

	method string GetBaseItemName(string itemKey)
		if itemKey == nil or itemKey == "" then return "" end
		local items = self.Items
		if self:IsClient() then
			items = self:SafeDecodeJson(self.InventoryDataJson, {})
		end
		local entry = items[itemKey]
		if type(entry) == "table" and entry.name ~= nil then
			return entry.name
		end
		local p1, p2 = string.find(itemKey, "_%d+_%d+$")
		if p1 then
			return string.sub(itemKey, 1, p1 - 1)
		end
		return itemKey
	end

	method string GetItemDisplayName(string itemName)
		-- 플레이어에게 보이는 한글 표시명. 인벤/레시피/상점 키는 Name 컬럼 그대로 둔다.
		if itemName == nil or itemName == "" then return "" end
		local ds = _DataService:GetTable("item_dataset")
		if ds == nil then return itemName end
		local row = ds:FindRow("Name", itemName)
		if row == nil then return itemName end
		local ok, v = pcall(function() return row:GetItem("DisplayName") end)
		if ok and v ~= nil and tostring(v) ~= "" then return tostring(v) end
		return itemName
	end

	method integer GetItemCount(string itemName)
		-- Returns the owned count; on the client it reads the synced JSON snapshot.
		if self:IsCurrencyItem(itemName) then
			return self.Coin
		end
		local count = 0
		local items = self.Items
		if self:IsClient() then
			items = self:SafeDecodeJson(self.InventoryDataJson, {})
		end
		
		for k, v in pairs(items) do
			if type(v) == "table" then
				if k == itemName or v.name == itemName then
					count = count + (v.count or 1)
				end
			else
				if k == itemName then
					count = count + v
				end
			end
		end
		return count
	end

	method boolean IsUniqueKeyedItem(string itemName)
		-- Category=tool 이면서 MaxStack<=1(공란 포함)이면 인스턴스별 고유 키. MaxStack>1이면 자원처럼 한 슬롯에 중첩.
		if itemName == nil or itemName == "" then return false end
		local ds = _DataService:GetTable("item_dataset")
		if ds == nil then return false end
		local row = ds:FindRow("Name", itemName)
		if row == nil then return false end
		if (row:GetItem("Category") or "") ~= "tool" then return false end
		local ok, raw = pcall(function() return row:GetItem("MaxStack") end)
		if ok and raw ~= nil and tostring(raw) ~= "" then
			local maxStack = tonumber(raw) or 1
			if maxStack > 1 then return false end
		end
		return true
	end

	method boolean HasAcquiredItem(string itemName)
		-- 현재 보유하거나 도감 누적 획득이 있으면 true (첫 제작 해금 게이트용).
		if itemName == nil or itemName == "" then return false end
		if self:GetItemCount(itemName) > 0 then return true end
		local items = self:DecodeFlatJson(self.DexItemsJson)
		local n = math.floor(tonumber(items[itemName]) or 0)
		return n > 0
	end

	@ExecSpace("ServerOnly")
	method void FoldStackableToolKeys(string itemName)
		-- 구세이브 고유키(Hand Axe_ts_rand)를 MaxStack>1 정수 스택으로 합친다.
		if itemName == nil or itemName == "" then return end
		if self:IsUniqueKeyedItem(itemName) then return end
		local extra = 0
		local keys = {}
		for k, v in pairs(self.Items) do
			-- 이름 붙은 칸(명부 개체 — 가방 속 가축·이름 붙은 호루라기)은 절대 합치지 않는다. 합치면 이름과 개체 연결이 사라진다.
			if k ~= itemName and type(v) == "table" and v.name == itemName and (v.creatureId == nil or v.creatureId == "") then
				extra = extra + (v.count or 1)
				table.insert(keys, k)
			end
		end
		if extra <= 0 then return end
		for _, k in ipairs(keys) do
			if self.EquippedTool == k then
				self.EquippedTool = itemName
			end
			self.Items[k] = nil
		end
		local slots = self:SafeDecodeJson(self.QuickSlotsJson, {})
		local slotChanged = false
		for i = 1, 10 do
			for _, k in ipairs(keys) do
				if slots[i] == k then
					slots[i] = itemName
					slotChanged = true
				end
			end
		end
		if slotChanged then
			self.QuickSlotsJson = self:SafeEncodeJson(slots, "[\"\", \"\", \"\", \"\", \"\", \"\", \"\", \"\", \"\", \"\"]")
		end
		local current = self.Items[itemName] or 0
		if type(current) == "table" then
			current = current.count or 1
		end
		self.Items[itemName] = current + extra
		log("[INV] Folded " .. tostring(extra) .. " unique keys into stack " .. itemName)
	end

	@ExecSpace("ServerOnly")
	method void FoldAllStackableToolKeys()
		-- 로드 직후: 중첩 가능한 도구 고유키를 한 슬롯으로 합친다.
		local names = {}
		for k, v in pairs(self.Items) do
			if type(v) == "table" and v.name ~= nil then
				names[v.name] = true
			end
		end
		for itemName, _ in pairs(names) do
			if not self:IsUniqueKeyedItem(itemName) then
				self:FoldStackableToolKeys(itemName)
			end
		end
		self.InventoryDataJson = self:SafeEncodeJson(self.Items, "{}")
	end

	@ExecSpace("ServerOnly")
	method void Equip(string itemName)
		-- Toggle off when re-equipping the same tool
		if self.EquippedTool == itemName or itemName == "" then
			self.EquippedTool = ""
			self:ApplyHeldToolCostume()
			log("[EQUIP] " .. self.Entity.Name .. " unequipped " .. itemName)
			self:ClientOnEquipChanged("")
			if _PersistenceManager and self.Entity.PlayerComponent then
				_PersistenceManager:MarkPlayerDirty(self.Entity.PlayerComponent.UserId)
			end
			return
		end
		
		local entry = self.Items[itemName]
		if entry == nil then
			log_warning("[EQUIP] " .. self.Entity.Name .. " does not own " .. itemName)
			return
		end
		
		-- Validate that the item is a tool via item_dataset (server-only dataset)
		local baseName = self:GetBaseItemName(itemName)
		local ds = _DataService:GetTable("item_dataset")
		if ds == nil then return end
		local row = ds:FindRow("Name", baseName)
		if row == nil or row:GetItem("Category") ~= "tool" then
			log_warning("[EQUIP] " .. baseName .. " is not an equippable tool.")
			return
		end
		
		self.EquippedTool = itemName
		self:ApplyHeldToolCostume()
		log("[EQUIP] " .. self.Entity.Name .. " equipped " .. itemName)
		self:ClientOnEquipChanged(itemName)
		if _PersistenceManager and self.Entity.PlayerComponent then
			_PersistenceManager:MarkPlayerDirty(self.Entity.PlayerComponent.UserId)
		end
	end

	@ExecSpace("ServerOnly")
	method void ApplyHeldToolCostume()
		-- Mirrors EquippedTool onto the avatar's weapon slot so the character visibly holds
		-- the tool. WeaponRUID/WeaponSlot come from item_dataset (data-driven); an empty
		-- WeaponRUID (non-tool or unequipped) clears both slots back to bare hands.
		-- WeaponSlot=twohand인 도구(양손 아바타 아이템)는 TwoHandedWeapon 슬롯에 장착해야
		-- swingT* 등 두손 액션에서 무기 파츠 프레임이 렌더된다 — 한손 슬롯에 장착하면
		-- 두손 모션 중 도구가 손에서 사라진다(과거 곡괭이 swingT1 미표시 버그의 원인).
		-- 양손 무기는 한손+보조 슬롯을 점유하므로(상호 배타) 반대쪽 슬롯은 항상 비운다.
		local costume = self.Entity.CostumeManagerComponent
		if not isvalid(costume) then return end

		local weaponRuid = ""
		local weaponSlot = ""
		local baseName = self:GetBaseItemName(self.EquippedTool)
		if baseName ~= "" then
			local ds = _DataService:GetTable("item_dataset")
			if ds ~= nil then
				local row = ds:FindRow("Name", baseName)
				if row ~= nil then
					weaponRuid = row:GetItem("WeaponRUID") or ""
					-- pcall 가드: 데이터셋이 아직 리프레시되지 않아 WeaponSlot 컬럼이 없어도
					-- 한손 폴백으로 동작 (MineState의 SwingAction 가드와 동일 패턴).
					local ok, v = pcall(function() return row:GetItem("WeaponSlot") end)
					if ok and v ~= nil then weaponSlot = v end
				end
			end
		end

		if weaponSlot == "twohand" then
			costume:SetEquip(MapleAvatarItemCategory.TwoHandedWeapon, weaponRuid)
			costume:SetEquip(MapleAvatarItemCategory.OneHandedWeapon, "")
		else
			costume:SetEquip(MapleAvatarItemCategory.OneHandedWeapon, weaponRuid)
			costume:SetEquip(MapleAvatarItemCategory.TwoHandedWeapon, "")
		end
	end

	@ExecSpace("Server")
	method void ServerRequestEquip(string itemName)
		-- Equips/unequips a tool after validating ownership and item category.
		local playerComp = self.Entity.PlayerComponent
		if playerComp == nil or senderUserId ~= playerComp.UserId then
			return
		end
		log("[EQUIP] ServerRequestEquip verified caller for: " .. itemName .. " by " .. self.Entity.Name)
		self:Equip(itemName)
	end

	@ExecSpace("ServerOnly")
	method table GetEquippedToolInfo()
		-- Returns { toolType, power, attack, magicAttack, skillAttack, toolTier }.
		local info = { toolType = "", power = 0, attack = 0, magicAttack = 0, skillAttack = 0, toolTier = 0 }
		if self.EquippedTool == "" then return info end
		
		local baseName = self:GetBaseItemName(self.EquippedTool)
		local ds = _DataService:GetTable("item_dataset")
		if ds == nil then return info end
		local row = ds:FindRow("Name", baseName)
		if row == nil then return info end
		
		info.toolType = row:GetItem("ToolType") or ""
		info.power = tonumber(row:GetItem("ToolPower")) or 0
		info.attack = 0
		info.magicAttack = 0
		info.skillAttack = 0
		info.toolTier = 0
		local function numCol(col)
			local ok, raw = pcall(function() return row:GetItem(col) end)
			if ok and raw ~= nil and tostring(raw) ~= "" then
				return tonumber(raw) or 0
			end
			return 0
		end
		info.attack = numCol("Attack")
		info.magicAttack = numCol("MagicAttack")
		info.skillAttack = numCol("SkillAttack")
		info.toolTier = numCol("ToolTier")
		-- 대장간 강화 단계의 채집력 보너스 (EquipmentEnhanceDataSet.AddToolPower, 손에 든 도구 개체 기준)
		info.power = info.power + self:GetEnhanceToolPower(self.EquippedTool)
		return info
	end

	---------------------------------------------------------------------------
	-- 장비 (주무기·방어구) — 서버/클라 공용 조회. 클라는 동기화된 JSON 스냅샷을 읽는다.
	---------------------------------------------------------------------------

	method table GetGearSlots()
		-- GearJson → { slot = itemKey }.
		local decoded = self:SafeDecodeJson(self.GearJson, {})
		if type(decoded) ~= "table" then return {} end
		return decoded
	end

	method boolean OwnsItemKey(string itemKey)
		-- 인벤토리에 그 키가 1개 이상 있는가 (도구 고유키·중첩 이름 둘 다).
		if itemKey == nil or itemKey == "" then return false end
		local items = self.Items
		if self:IsClient() then
			items = self:SafeDecodeJson(self.InventoryDataJson, {})
		end
		local entry = items[itemKey]
		if entry == nil then return false end
		if type(entry) == "table" then return (entry.count or 1) > 0 end
		return (tonumber(entry) or 0) > 0
	end

	method number GetItemNumber(string itemName, string colName)
		-- item_dataset 숫자 컬럼 (공란/없음 = 0).
		if itemName == nil or itemName == "" then return 0 end
		local ds = _DataService:GetTable("item_dataset")
		if ds == nil then return 0 end
		local row = ds:FindRow("Name", itemName)
		if row == nil then return 0 end
		local ok, raw = pcall(function() return row:GetItem(colName) end)
		if ok and raw ~= nil and tostring(raw) ~= "" then return tonumber(raw) or 0 end
		return 0
	end

	method string GetItemEquipSlot(string itemName)
		-- item_dataset.EquipSlot. 장비가 아니면 "".
		if itemName == nil or itemName == "" then return "" end
		local ds = _DataService:GetTable("item_dataset")
		if ds == nil then return "" end
		local row = ds:FindRow("Name", itemName)
		if row == nil then return "" end
		local ok, raw = pcall(function() return row:GetItem("EquipSlot") end)
		if ok and raw ~= nil then return tostring(raw) end
		return ""
	end

	method string GetOwnerJobId()
		-- 이 인벤토리 주인의 직업 id (미전직 = ""). PlayerController.JobId 는 @Sync 라 서버·클라 공용이다.
		local pc = self.Entity:GetComponent("script.PlayerController")
		if not isvalid(pc) then return "" end
		---@type PlayerController
		local ctrl = pc
		return ctrl.JobId or ""
	end

	method boolean IsItemAllowedForJob(string itemName, string jobId)
		-- item_dataset.EquipJobs("|"로 구분한 직업 id). 공란 = 전 직업. 정적 데이터라 아이템별로 캐시한다.
		if itemName == nil or itemName == "" then return true end
		local cache = self._T.EquipJobsCache
		if cache == nil then
			cache = {}
			self._T.EquipJobsCache = cache
		end
		local jobs = cache[itemName]
		if jobs == nil then
			jobs = self:GetItemText(itemName, "EquipJobs")
			cache[itemName] = jobs
		end
		if jobs == "" then return true end
		for _, j in ipairs(self:SplitPlain(jobs, "|")) do
			if j == jobId then return true end
		end
		return false
	end

	method boolean IsGearKeyAllowed(string itemKey)
		-- 그 아이템(키)을 지금 직업이 쓸 수 있는가. 장착 등록이 남아 있어도 직업이 안 맞으면 실효 장비에서 뺀다 (저장값은 건드리지 않는다).
		return self:IsItemAllowedForJob(self:GetBaseItemName(itemKey), self:GetOwnerJobId())
	end

	method string GetEquipJobsLabel(string itemName)
		-- 장착 가능 직업 표시("트래퍼·배틀스미스"). EquipJobs 가 공란이면 "".
		local jobs = self:GetItemText(itemName, "EquipJobs")
		if jobs == "" then return "" end
		local pc = self.Entity:GetComponent("script.PlayerController")
		local names = {}
		for _, j in ipairs(self:SplitPlain(jobs, "|")) do
			local label = j
			if isvalid(pc) then
				---@type PlayerController
				local ctrl = pc
				local n = ctrl:GetJobName(j)
				if n ~= "" then label = n end
			end
			names[#names + 1] = label
		end
		return table.concat(names, "·")
	end

	method string GetWeaponTypeLabel(string weaponType)
		-- WeaponType → 툴팁 한 줄. 근접(Melee)은 기본이라 적지 않는다. 신규 종류는 여기와 WeaponAttackDataSet 만 늘린다.
		if weaponType == "Wand" then return "마법봉 · 탭: 휘두르기 / 꾹: 충전 마법탄" end
		if weaponType == "Nature" then return "자연 무기 · 탭: 정령탄 / 꾹: 생명 펄스" end
		if weaponType == "Dagger" then return "단검 · 탭: 찌르기 (투척 숙련: 투척)" end
		return ""
	end

	method string FindBestWeaponKey()
		-- 주무기를 등록하지 않았을 때 쓰는 자동 주무기: 보유·착용 가능한 무기 중 (공격력 + 마법 공격력) 최고.
		local items = self.Items
		if self:IsClient() then
			items = self:SafeDecodeJson(self.InventoryDataJson, {})
		end
		local jobId = self:GetOwnerJobId()
		local bestKey = ""
		local bestScore = -1
		for key, entry in pairs(items) do
			local name = key
			if type(entry) == "table" and entry.name ~= nil then name = entry.name end
			if self:OwnsItemKey(key) and self:GetItemEquipSlot(name) == "weapon" and self:IsItemAllowedForJob(name, jobId) then
				local score = self:GetItemNumber(name, "Attack") + self:GetItemNumber(name, "MagicAttack")
				if score > bestScore or (score == bestScore and key < bestKey) then
					bestScore = score
					bestKey = key
				end
			end
		end
		return bestKey
	end

	method string GetGearKey(string slot)
		-- 그 슬롯에 실제로 적용되는 아이템 키. 등록했지만 잃은 아이템은 "" (주무기는 자동 선택으로 폴백).
		-- 직업 제한(EquipJobs)이 안 맞는 등록은 없는 것으로 본다 — 주무기면 자동 주무기로 돌아간다.
		local key = self:GetGearSlots()[slot]
		if key ~= nil and key ~= "" and self:OwnsItemKey(tostring(key)) and self:IsGearKeyAllowed(tostring(key)) then return tostring(key) end
		if slot == "weapon" then return self:FindBestWeaponKey() end
		return ""
	end

	method boolean IsWeaponAutoSelected()
		-- 주무기 칸이 "등록"이 아니라 자동 선택으로 채워졌는가 (캐릭터 창 표시용).
		local key = self:GetGearSlots()["weapon"]
		return key == nil or key == "" or not self:OwnsItemKey(tostring(key)) or not self:IsGearKeyAllowed(tostring(key))
	end

	method number GetGearStat(string colName)
		-- 모든 장비 슬롯의 item_dataset 수치 합 (Attack / MagicAttack / SkillAttack / Defense ...).
		local total = 0
		local scales = self:IsEnhanceStatColumn(colName)
		for _, slot in ipairs(self:GetGearSlotOrder()) do
			local key = self:GetGearKey(slot)
			if key ~= "" then
				local base = self:GetItemNumber(self:GetBaseItemName(key), colName)
				total = total + base
				-- 대장간 강화: 기본 수치 × 누적 StatPct (0보다 크면 최소 +1)
				if scales and base > 0 then
					local pct = self:GetEnhanceStatPct(key)
					if pct > 0 then total = total + math.max(1, math.floor(base * pct + 0.5)) end
				end
			end
		end
		return total
	end

	method table GetGearSlotOrder()
		-- 장비 슬롯 id 목록 (캐릭터 창 배치 순서와 같다).
		return { "weapon", "helmet", "armor", "gloves", "shoes", "shield" }
	end

	method string GetGearSlotLabel(string slot)
		-- 슬롯 id → 한글 표시명.
		if slot == "weapon" then return "주무기" end
		if slot == "helmet" then return "투구" end
		if slot == "armor" then return "갑옷" end
		if slot == "gloves" then return "장갑" end
		if slot == "shoes" then return "신발" end
		if slot == "shield" then return "방패" end
		return slot
	end

	---------------------------------------------------------------------------
	-- 대장간 강화 · 주문 부여 — 서버/클라 공용 조회 + 서버 요청.
	-- 데이터: EquipmentEnhanceDataSet(그룹×단계) · EnchantPartDataSet(파츠) · EnchantWeightDataSet(연구 레벨별 등급 가중치)
	-- 적용: 강화 = GetGearStat / GetEquippedToolInfo, 주문 = PlayerController.GetGearPerk.
	---------------------------------------------------------------------------

	method table SplitPlain(string text, string sep)
		-- 빈 필드를 보존하는 단순 분할("a||b" → {"a","","b"}).
		local out = {}
		if text == nil then return out end
		local start = 1
		while true do
			local i, _ = string.find(text, sep, start, true)   -- 반환값 2개(시작·끝)를 모두 받는다 (LWA-1111 회피)
			if i == nil then
				table.insert(out, string.sub(text, start))
				break
			end
			table.insert(out, string.sub(text, start, i - 1))
			start = i + #sep
		end
		return out
	end

	method string GetItemText(string itemName, string colName)
		-- item_dataset 문자열 열 (공란/없음 = "").
		if itemName == nil or itemName == "" then return "" end
		local ds = _DataService:GetTable("item_dataset")
		if ds == nil then return "" end
		local row = ds:FindRow("Name", itemName)
		if row == nil then return "" end
		local ok, raw = pcall(function() return row:GetItem(colName) end)
		if ok and raw ~= nil then return tostring(raw) end
		return ""
	end

	method boolean IsEnhanceStatColumn(string colName)
		for _, c in ipairs(self:SplitPlain(self.EnhanceStatColumns or "", "|")) do
			if c == colName then return true end
		end
		return false
	end

	method table GetEnhanceMap()
		-- EnhanceJson 디코드 캐시 (문자열이 같으면 재사용 — 스탯 조회가 잦다).
		local json = self.EnhanceJson or "{}"
		local cache = self._T.EnhanceCache
		if cache ~= nil and cache.json == json then return cache.map end
		local map = self:SafeDecodeJson(json, {})
		if type(map) ~= "table" then map = {} end
		self._T.EnhanceCache = { json = json, map = map }
		return map
	end

	method table GetEnhanceData(string itemKey)
		-- { lv = 강화 단계, slots = { [슬롯] = { stat, val, grade, part } } }. 기록 없으면 lv 0.
		local data = { lv = 0, slots = {} }
		if itemKey == nil or itemKey == "" then return data end
		local raw = self:GetEnhanceMap()[itemKey]
		if raw == nil or tostring(raw) == "" then return data end
		local parts = self:SplitPlain(tostring(raw), "|")
		data.lv = math.floor(tonumber(parts[1]) or 0)
		for i = 2, #parts do
			local s = parts[i]
			if s ~= nil and s ~= "" then
				local f = self:SplitPlain(s, ",")
				data.slots[i - 1] = { stat = f[1] or "", val = tonumber(f[2]) or 0, grade = f[3] or "", part = f[4] or "" }
			end
		end
		return data
	end

	@ExecSpace("ServerOnly")
	method void SetEnhanceData(string itemKey, table data)
		-- data → "단계|슬롯1|슬롯2|…" 로 저장하고 동기화한다.
		local map = self:SafeDecodeJson(self.EnhanceJson or "{}", {})
		if type(map) ~= "table" then map = {} end
		local maxSlot = 0
		for idx, _ in pairs(data.slots or {}) do
			if idx > maxSlot then maxSlot = idx end
		end
		local chunks = { tostring(math.floor(data.lv or 0)) }
		for i = 1, maxSlot do
			local s = data.slots[i]
			if s ~= nil and s.stat ~= nil and s.stat ~= "" then
				table.insert(chunks, string.format("%s,%s,%s,%s", s.stat, tostring(s.val), s.grade or "", s.part or ""))
			else
				table.insert(chunks, "")
			end
		end
		map[itemKey] = table.concat(chunks, "|")
		self.EnhanceJson = self:SafeEncodeJson(map, "{}")
	end

	method any GetEnhanceRow(string itemKey, integer level)
		-- 그 아이템의 강화 그룹 × 단계 행 (없으면 nil). (규칙 23: 반환 any)
		if level < 1 then return nil end
		local group = self:GetItemText(self:GetBaseItemName(itemKey), "EnhanceGroup")
		if group == "" then return nil end
		local ds = _DataService:GetTable("EquipmentEnhanceDataSet")
		if ds == nil then return nil end
		return ds:FindRow("EnhanceKey", group .. "_" .. tostring(level))
	end

	method number GetEnhanceStatPct(string itemKey)
		-- 현재 강화 단계의 누적 수치 증가율 (0 = 강화 없음).
		local lv = self:GetEnhanceData(itemKey).lv
		local row = self:GetEnhanceRow(itemKey, lv)
		if row == nil then return 0 end
		local ok, raw = pcall(function() return row:GetItem("StatPct") end)
		return (ok and tonumber(raw)) or 0
	end

	method integer GetEnhanceToolPower(string itemKey)
		-- 현재 강화 단계의 채집력 보너스(누적).
		if itemKey == nil or itemKey == "" then return 0 end
		local row = self:GetEnhanceRow(itemKey, self:GetEnhanceData(itemKey).lv)
		if row == nil then return 0 end
		local ok, raw = pcall(function() return row:GetItem("AddToolPower") end)
		return math.floor((ok and tonumber(raw)) or 0)
	end

	method integer GetEnchantSlotCount(string itemKey)
		return math.floor(tonumber(self:GetItemText(self:GetBaseItemName(itemKey), "EnchantSlots")) or 0)
	end

	method integer GetCompletedResearchCount()
		-- 연구소에서 끝낸 연구 수 (ResearchDataSet.UnlockRecipeId 해금 여부).
		local ds = _DataService:GetTable("ResearchDataSet")
		if ds == nil then return 0 end
		local n = 0
		for i = 1, ds:GetRowCount() do
			local unlockId = ds:GetCell(i, "UnlockRecipeId") or ""
			if unlockId ~= "" and self:HasRecipeUnlock(unlockId) then n = n + 1 end
		end
		return n
	end

	method integer GetResearchLevel()
		-- 연구 레벨 1~5 = 1 + floor(완료 연구 수 / ResearchCountPerLevel). ⚖️ 2026-09-26 제작자 결정.
		local per = math.max(1, self.ResearchCountPerLevel)
		return math.max(1, math.min(5, 1 + math.floor(self:GetCompletedResearchCount() / per)))
	end

	method number GetEnhanceSuccessRate(string itemKey, integer level)
		-- 강화 성공률(%) = 기본 SuccessRate + 연구 레벨 보정(레벨 2부터 +레벨%p), 최대 100.
		local row = self:GetEnhanceRow(itemKey, level)
		if row == nil then return 0 end
		local ok, raw = pcall(function() return row:GetItem("SuccessRate") end)
		local base = (ok and tonumber(raw)) or 0
		local lv = self:GetResearchLevel()
		local bonus = 0
		if base < 100 and lv >= 2 then bonus = lv end
		return math.min(100, base + bonus)
	end

	method string FormatEnchantValue(any partRow, number value)
		-- 파츠 수치 표시: Pct=true 면 %(소수 1자리까지), 아니면 정수.
		local pct = false
		if partRow ~= nil then
			local ok, raw = pcall(function() return partRow:GetItem("Pct") end)
			pct = ok and tostring(raw) == "true"
		end
		if pct then
			local v = value * 100
			if math.abs(v - math.floor(v + 0.5)) < 0.05 then return tostring(math.floor(v + 0.5)) .. "%" end
			return string.format("%.1f%%", v)
		end
		return tostring(math.floor(value + 0.5))
	end

	@ExecSpace("ServerOnly")
	method string RollEnchantGrade(integer researchLevel, number sWeightScale)
		-- 연구 레벨별 가중치로 D~S 등급을 뽑는다. 희귀 파츠는 S 가중치에 SWeightScale 을 곱한다.
		local ds = _DataService:GetTable("EnchantWeightDataSet")
		local row = ds ~= nil and ds:FindRow("ResearchLevel", tostring(researchLevel)) or nil
		local grades = { "D", "C", "B", "A", "S" }
		local weights = {}
		local total = 0
		for i, g in ipairs(grades) do
			local w = 0
			if row ~= nil then
				local ok, raw = pcall(function() return row:GetItem("Weight" .. g) end)
				w = (ok and tonumber(raw)) or 0
			elseif g == "D" then
				w = 1
			end
			if g == "S" then w = w * math.max(0, sWeightScale) end
			weights[i] = w
			total = total + w
		end
		if total <= 0 then return "D" end
		local r = math.random() * total
		local acc = 0
		for i, g in ipairs(grades) do
			acc = acc + weights[i]
			if r <= acc then return g end
		end
		return "D"
	end

	@ExecSpace("ServerOnly")
	method void NotifyAnvil(string msg)
		-- 결과 한 줄 피드백 (PlayerController 피드백 경로 재사용).
		local playerComp = self.Entity.PlayerComponent
		local pcComp = self.Entity:GetComponent("script.PlayerController")
		if playerComp ~= nil and isvalid(pcComp) then
			pcComp:ClientShowMineFeedback(msg, playerComp.UserId)
		end
	end

	@ExecSpace("Server")
	method void ServerRequestEnhance(string itemKey)
		-- 대장간 모루: 강화 1단계 시도. 비용(코인+재료)은 성패와 무관하게 소모, 실패해도 단계 유지·파괴 없음.
		local playerComp = self.Entity.PlayerComponent
		if playerComp == nil or senderUserId ~= playerComp.UserId then return end
		if not self:OwnsItemKey(itemKey) then return end
		local baseName = self:GetBaseItemName(itemKey)
		if self:GetItemText(baseName, "EnhanceGroup") == "" then
			self:NotifyAnvil("강화할 수 없는 물건입니다.")
			return
		end
		local data = self:GetEnhanceData(itemKey)
		local nextLv = data.lv + 1
		local row = self:GetEnhanceRow(itemKey, nextLv)
		if row == nil then
			self:NotifyAnvil("이미 최대 강화입니다.")
			return
		end
		local coin = math.floor(tonumber(row:GetItem("CostCoin")) or 0)
		local costItem = tostring(row:GetItem("CostItem") or "")
		local costCount = math.floor(tonumber(row:GetItem("CostItemCount")) or 0)
		if self.Coin < coin then
			self:NotifyAnvil("코인이 부족합니다. (필요 " .. tostring(coin) .. ")")
			return
		end
		if costItem ~= "" and costCount > 0 and self:GetItemCount(costItem) < costCount then
			self:NotifyAnvil(self:GetItemDisplayName(costItem) .. "이(가) 부족합니다. (필요 " .. tostring(costCount) .. ")")
			return
		end
		local rate = self:GetEnhanceSuccessRate(itemKey, nextLv)
		if coin > 0 and not self:RemoveItem("Coin", coin) then return end
		if costItem ~= "" and costCount > 0 and not self:RemoveItem(costItem, costCount) then return end
		local disp = self:GetItemDisplayName(baseName)
		local success = math.random() * 100 < rate
		if success then
			data.lv = nextLv
			self:SetEnhanceData(itemKey, data)
			self:NotifyAnvil("[강화 성공] " .. disp .. " +" .. tostring(nextLv))
		else
			self:NotifyAnvil("[강화 실패] " .. disp .. " +" .. tostring(data.lv) .. " 유지 — 재료만 소모됐습니다.")
		end
		if _PersistenceManager ~= nil then _PersistenceManager:MarkPlayerDirty(playerComp.UserId) end
		self:ClientOnGearChanged(playerComp.UserId)
		log(string.format("[ANVIL] enhance %s key=%s -> %s lv=%d rate=%.0f", playerComp.UserId, itemKey, success and "OK" or "FAIL", data.lv, rate))
	end

	@ExecSpace("Server")
	method void ServerRequestEnchant(string itemKey, string partName, integer slotIndex)
		-- 대장간 모루: 주문 부여. 파츠 1개 소모 → 연구 레벨 가중치로 등급(D~S) → 등급 범위 안 수치. 슬롯에 이미 있으면 덮어쓴다.
		local playerComp = self.Entity.PlayerComponent
		if playerComp == nil or senderUserId ~= playerComp.UserId then return end
		if not self:OwnsItemKey(itemKey) then return end
		if partName == nil or partName == "" or self:GetItemCount(partName) < 1 then return end
		local ds = _DataService:GetTable("EnchantPartDataSet")
		local partRow = ds ~= nil and ds:FindRow("PartId", partName) or nil
		if partRow == nil then return end
		local baseName = self:GetBaseItemName(itemKey)
		local equipSlot = self:GetItemEquipSlot(baseName)
		local target = tostring(partRow:GetItem("TargetSlot") or "")
		if target ~= "any" and target ~= equipSlot then
			self:NotifyAnvil("이 파츠는 " .. self:GetGearSlotLabel(target) .. "에만 새길 수 있습니다.")
			return
		end
		local slots = self:GetEnchantSlotCount(itemKey)
		if slots <= 0 then
			self:NotifyAnvil("주문을 새길 수 없는 장비입니다.")
			return
		end
		if slotIndex < 1 or slotIndex > slots then return end
		local researchLv = self:GetResearchLevel()
		local minLv = math.floor(tonumber(partRow:GetItem("MinResearchLv")) or 1)
		if researchLv < minLv then
			self:NotifyAnvil("연구 Lv." .. tostring(minLv) .. " 이상이어야 다룰 수 있는 파츠입니다. (현재 Lv." .. tostring(researchLv) .. ")")
			return
		end
		if not self:RemoveItem(partName, 1) then return end
		local grade = self:RollEnchantGrade(researchLv, tonumber(partRow:GetItem("SWeightScale")) or 1)
		local vMin = tonumber(partRow:GetItem("Val" .. grade .. "_Min")) or 0
		local vMax = tonumber(partRow:GetItem("Val" .. grade .. "_Max")) or vMin
		local value = vMin + (vMax - vMin) * math.random()
		if tostring(partRow:GetItem("Pct") or "") == "true" then
			value = math.floor(value * 1000 + 0.5) / 1000
		else
			value = math.floor(value + 0.5)
		end
		local data = self:GetEnhanceData(itemKey)
		data.slots[slotIndex] = { stat = tostring(partRow:GetItem("StatType") or ""), val = value, grade = grade, part = partName }
		self:SetEnhanceData(itemKey, data)
		local label = tostring(partRow:GetItem("StatLabel") or "")
		self:NotifyAnvil(string.format("[주문 부여 %s급] %s %s", grade, label, self:FormatEnchantValue(partRow, value)))
		if _PersistenceManager ~= nil then _PersistenceManager:MarkPlayerDirty(playerComp.UserId) end
		self:ClientOnGearChanged(playerComp.UserId)
		log(string.format("[ANVIL] enchant %s key=%s slot=%d part=%s grade=%s val=%s lvR=%d", playerComp.UserId, itemKey, slotIndex, partName, grade, tostring(value), researchLv))
	end

	@ExecSpace("ServerOnly")
	method void SanitizeEnhance()
		-- 로드 직후: 잃은 아이템의 강화 기록을 정리한다 (세이브 경로 무변경).
		local map = self:SafeDecodeJson(self.EnhanceJson or "{}", {})
		if type(map) ~= "table" then map = {} end
		local clean = {}
		for key, v in pairs(map) do
			if self:OwnsItemKey(tostring(key)) then clean[key] = v end
		end
		self.EnhanceJson = self:SafeEncodeJson(clean, "{}")
	end

	@ExecSpace("Server")
	method void ServerRequestEquipGear(string itemKey)
		-- 장비 장착(같은 아이템을 다시 요청하면 해제). 보유·슬롯·착용 레벨을 서버가 검증한다.
		local playerComp = self.Entity.PlayerComponent
		if playerComp == nil or senderUserId ~= playerComp.UserId then return end
		local pcComp = self.Entity:GetComponent("script.PlayerController")
		if not self:OwnsItemKey(itemKey) then return end
		local baseName = self:GetBaseItemName(itemKey)
		local slot = self:GetItemEquipSlot(baseName)
		if slot == "" then return end
		-- ⚠ 규칙 53: RPC 본문에 ---@type <사용자 스크립트> 주석 금지 (LEA-1118) — 동적 호출로 둔다.
		local need = math.floor(self:GetItemNumber(baseName, "EquipLevel"))
		if isvalid(pcComp) and need > 0 and pcComp.Level < need then
			pcComp:ClientShowMineFeedback("착용 레벨이 부족합니다. (Lv." .. tostring(need) .. " 필요)", playerComp.UserId)
			return
		end
		local slots = self:GetGearSlots()
		local label = self:GetGearSlotLabel(slot)
		local disp = self:GetItemDisplayName(baseName)
		local msg = ""
		if slots[slot] == itemKey then
			slots[slot] = nil
			msg = "[" .. label .. "] " .. disp .. " 해제"
		else
			-- 직업 제한(item_dataset.EquipJobs). 해제는 항상 허용한다.
			if not self:IsItemAllowedForJob(baseName, self:GetOwnerJobId()) then
				if isvalid(pcComp) then
					pcComp:ClientShowMineFeedback(disp .. "은(는) " .. self:GetEquipJobsLabel(baseName) .. " 전용입니다.", playerComp.UserId)
				end
				return
			end
			slots[slot] = itemKey
			msg = "[" .. label .. "] " .. disp .. " 장착"
		end
		self.GearJson = self:SafeEncodeJson(slots, "{}")
		if _PersistenceManager ~= nil then _PersistenceManager:MarkPlayerDirty(playerComp.UserId) end
		if isvalid(pcComp) then
			pcComp:ClientShowMineFeedback(msg, playerComp.UserId)
		end
		self:ClientOnGearChanged(playerComp.UserId)
		log("[GEAR] " .. playerComp.UserId .. " " .. msg .. " key=" .. itemKey)
	end

	@ExecSpace("Server")
	method void ServerRequestUnequipGear(string slot)
		-- 장비 슬롯 해제 (캐릭터 창의 칸 클릭).
		local playerComp = self.Entity.PlayerComponent
		if playerComp == nil or senderUserId ~= playerComp.UserId then return end
		local slots = self:GetGearSlots()
		if slots[slot] == nil or slots[slot] == "" then return end
		slots[slot] = nil
		self.GearJson = self:SafeEncodeJson(slots, "{}")
		if _PersistenceManager ~= nil then _PersistenceManager:MarkPlayerDirty(playerComp.UserId) end
		self:ClientOnGearChanged(playerComp.UserId)
		log("[GEAR] " .. playerComp.UserId .. " unequip slot=" .. slot)
	end

	@ExecSpace("ServerOnly")
	method void SanitizeGear()
		-- 로드 직후: 잃은 아이템·슬롯이 바뀐 아이템 등록을 정리한다 (세이브 경로 무변경).
		local slots = self:GetGearSlots()
		local clean = {}
		for slot, key in pairs(slots) do
			local k = tostring(key)
			if self:OwnsItemKey(k) and self:GetItemEquipSlot(self:GetBaseItemName(k)) == slot then
				clean[slot] = k
			end
		end
		self.GearJson = self:SafeEncodeJson(clean, "{}")
	end

	method string GetToolTypeLabel(string toolType)
		-- ToolType 컬럼 → 한글 표시. 신규 종류는 여기와 데이터만.
		if toolType == "axe" then return "도끼" end
		if toolType == "pickaxe" then return "곡괭이" end
		if toolType == "shovel" then return "삽" end
		if toolType == "hoe" then return "호미" end
		if toolType == "rod" then return "낚싯대" end
		if toolType == "water_spade" then return "물삽" end
		if toolType == "weapon" then return "무기" end
		return toolType or ""
	end

	method string FormatItemStatLines(string itemName)
		-- 툴팁용 짧은 스펙. 0인 전투 수치는 숨긴다. 던지기는 적지 않는다.
		if itemName == nil or itemName == "" then return "" end
		local ds = _DataService:GetTable("item_dataset")
		if ds == nil then return "" end
		local row = ds:FindRow("Name", itemName)
		if row == nil then return "" end
		local function numCol(col)
			local ok, raw = pcall(function() return row:GetItem(col) end)
			if ok and raw ~= nil and tostring(raw) ~= "" then
				return tonumber(raw) or 0
			end
			return 0
		end
		local lines = {}
		local toolType = ""
		local okT, rawT = pcall(function() return row:GetItem("ToolType") end)
		if okT and rawT ~= nil then toolType = tostring(rawT) end
		local power = numCol("ToolPower")
		local tier = numCol("ToolTier")
		if toolType ~= "" then
			local typeLabel = self:GetToolTypeLabel(toolType)
			local head = typeLabel
			if tier > 0 then
				head = "T" .. tostring(math.floor(tier)) .. " " .. typeLabel
			end
			if power > 0 then
				head = head .. " · 채집 +" .. tostring(math.floor(power))
			end
			lines[#lines + 1] = head
		end
		local attack = numCol("Attack")
		if attack > 0 then
			lines[#lines + 1] = "무기 공격력 " .. tostring(math.floor(attack))
		end
		local magicAtk = numCol("MagicAttack")
		if magicAtk > 0 then
			lines[#lines + 1] = "마법 공격력 " .. tostring(math.floor(magicAtk))
		end
		local skillAtk = numCol("SkillAttack")
		if skillAtk > 0 then
			lines[#lines + 1] = "스킬 공격력 +" .. tostring(math.floor(skillAtk))
		end
		-- 장비(방어구·주무기): 슬롯 · 방어력 · 착용 레벨
		local slot = self:GetItemEquipSlot(itemName)
		if slot ~= "" and slot ~= "weapon" then
			local head = self:GetGearSlotLabel(slot)
			local def = numCol("Defense")
			if def > 0 then head = head .. " · 방어력 +" .. tostring(math.floor(def)) end
			lines[#lines + 1] = head
		end
		local needLv = numCol("EquipLevel")
		if needLv > 0 then
			lines[#lines + 1] = "착용 Lv." .. tostring(math.floor(needLv))
		end
		-- 무기 평타 방식(WeaponType)과 직업 제한(EquipJobs)
		local weaponLabel = self:GetWeaponTypeLabel(self:GetItemText(itemName, "WeaponType"))
		if weaponLabel ~= "" then
			lines[#lines + 1] = weaponLabel
		end
		local jobLabel = self:GetEquipJobsLabel(itemName)
		if jobLabel ~= "" then
			lines[#lines + 1] = "전용: " .. jobLabel
		end
		-- 장비 고유 효과 설명 (PerkStat/PerkValue 는 PlayerController.GetGearPerk 가 적용한다)
		local okP, rawP = pcall(function() return row:GetItem("PerkDesc") end)
		if okP and rawP ~= nil and tostring(rawP) ~= "" then
			lines[#lines + 1] = tostring(rawP)
		end
		if #lines == 0 then return "" end
		return table.concat(lines, "\n")
	end

	@ExecSpace("Client")
	method void ClientOnEquipChanged(string itemName)
		-- Refreshes the inventory popup after an equip change.
		if itemName ~= "" then
			log("Equipped tool: " .. itemName)
		else
			log("Tool unequipped.")
		end
		local popup = _EntityService:GetEntityByPath("/ui/PopupGroup/InventoryPopup")
		if isvalid(popup) then
			local ctrl = popup:GetComponent("script.UIInventoryController")
			if isvalid(ctrl) then
				local c = ctrl
				c:RefreshInventoryData()
			end
		end
	end

	@ExecSpace("Client")
	method void ClientOnGearChanged()
		-- 장비 변경 후 인벤토리([장착] 표시)·캐릭터 창(슬롯·능력치)을 다시 그린다.
		-- GearJson 동기화가 이 RPC 보다 늦게 올 수 있어 한 박자 뒤에 한 번 더 그린다.
		local refresh = function()
			local inv = _EntityService:GetEntityByPath("/ui/PopupGroup/InventoryPopup")
			if isvalid(inv) then
				local c = inv:GetComponent("script.UIInventoryController")
				if isvalid(c) then c:RefreshInventoryData() end
			end
			local ch = _EntityService:GetEntityByPath("/ui/PopupGroup/CharacterPopup")
			if isvalid(ch) and ch.Enable then
				local cc = ch:GetComponent("script.UICharacterController")
				if isvalid(cc) then cc:RefreshStats() end
			end
		end
		refresh()
		_TimerService:SetTimerOnce(refresh, 0.2)
	end

	@ExecSpace("Server")
	method void ServerRequestCraft(string recipeName)
		-- Validates and executes a craft request using RecipeDataSet.
		local playerComp = self.Entity.PlayerComponent
		if playerComp == nil or senderUserId ~= playerComp.UserId then
			return
		end
		
		local ds = _DataService:GetTable("RecipeDataSet")
		if ds == nil then
			log_error("RecipeDataSet not found.")
			return
		end
		
		local row = ds:FindRow("RecipeName", recipeName)
		if row == nil then return end

		-- T25 해금 게이트: UnlockId 비공란 & 미보유 → 거부.
		local unlockId = row:GetItem("UnlockId") or ""
		if unlockId ~= "" and not self:HasRecipeUnlock(unlockId) then
			local pc = self.Entity:GetComponent("script.PlayerController")
			local hint = row:GetItem("UnlockHint") or "???"
			if isvalid(pc) then
				pc:ShowMineFeedback("아직 익히지 않은 제작법입니다. " .. tostring(hint))
			end
			self:ClientOnCraftCompleted(recipeName, false, playerComp.UserId)
			return
		end
		
		local ingredients = {}
		local ing1Name = row:GetItem("Ing1Name") or ""
		local ing1Count = tonumber(row:GetItem("Ing1Count")) or 0
		local ing2Name = row:GetItem("Ing2Name") or ""
		local ing2Count = tonumber(row:GetItem("Ing2Count")) or 0
		
		if ing1Name ~= "" and ing1Count > 0 then
			table.insert(ingredients, { itemName = ing1Name, required = ing1Count })
		end
		if ing2Name ~= "" and ing2Count > 0 then
			table.insert(ingredients, { itemName = ing2Name, required = ing2Count })
		end
		
		-- Validate materials
		local canCraft = true
		for _, ing in ipairs(ingredients) do
			if self:GetItemCount(ing.itemName) < ing.required then
				canCraft = false
				break
			end
		end
		
		if canCraft then
			for _, ing in ipairs(ingredients) do
				self:RemoveItem(ing.itemName, ing.required)
			end
			local craftedKey = self:AddItem(recipeName, 1)

			log("[CRAFT] Player " .. self.Entity.Name .. " crafted " .. recipeName)

			-- 업적/퀘스트 진행: 제작 액션 발행
			if _ActionSignals ~= nil then
				_ActionSignals:EmitToPlayer(self.Entity, _ActionEnum.Craft, recipeName, 1)
			end
			self:ClientOnCraftCompleted(recipeName, true, playerComp.UserId)
		
			-- Auto-Equip Logic
			local itemDs = _DataService:GetTable("item_dataset")
			if itemDs ~= nil then
				local itemRow = itemDs:FindRow("Name", recipeName)
				if itemRow ~= nil then
					local cat = itemRow:GetItem("Category")
					if cat == "tool" or cat == "furniture" then
						local slots = self:SafeDecodeJson(self.QuickSlotsJson, {})
						local alreadySlotted = false
						for i = 1, 10 do
							if slots[i] == craftedKey then
								alreadySlotted = true
								break
							end
						end
						if not alreadySlotted then
							local emptySlotIndex = -1
							for i = 1, 10 do
								if slots[i] == nil or slots[i] == "" then
									emptySlotIndex = i
									break
								end
							end
							if emptySlotIndex ~= -1 then
								self.SelectedQuickSlotIndex = emptySlotIndex
								slots[emptySlotIndex] = craftedKey
								self.QuickSlotsJson = self:SafeEncodeJson(slots, "[\"\", \"\", \"\", \"\", \"\", \"\", \"\", \"\", \"\", \"\"]")
								log("[QUICKSLOT] Auto-registered crafted item " .. craftedKey .. " to slot " .. emptySlotIndex)
								self:SyncEquippedToolToSelectedSlot()
							end
						end
					end
				end
			end
		else
			self:ClientOnCraftCompleted(recipeName, false, playerComp.UserId)
		end
	end

	@ExecSpace("Server")
	method void ServerRequestBuildCraft(string recipeName)
		-- 건축 테이블 제작 (BuildingManager.RecipeTableName = BuildRecipeDataSet).
		-- ServerRequestCraft 와 같은 흐름 + 건축 테이블 근접 검증 + OutputCount(바닥 2장 등).
		local playerComp = self.Entity.PlayerComponent
		if playerComp == nil or senderUserId ~= playerComp.UserId then
			return
		end
		local pc = self.Entity:GetComponent("script.PlayerController")
		if _BuildingManager == nil or not _BuildingManager:IsNearBuildingTable(self.Entity) then
			if isvalid(pc) then
				pc:ShowMineFeedback("건축 테이블 가까이에서만 만들 수 있습니다.")
			end
			self:ClientOnCraftCompleted(recipeName, false, playerComp.UserId)
			return
		end

		local ds = _DataService:GetTable(_BuildingManager.RecipeTableName)
		if ds == nil then
			log_error(_BuildingManager.RecipeTableName .. " not found.")
			self:ClientOnCraftCompleted(recipeName, false, playerComp.UserId)
			return
		end
		local row = ds:FindRow("RecipeName", recipeName)
		if row == nil then
			self:ClientOnCraftCompleted(recipeName, false, playerComp.UserId)
			return
		end

		local unlockId = row:GetItem("UnlockId") or ""
		if unlockId ~= "" and not self:HasRecipeUnlock(unlockId) then
			if isvalid(pc) then
				pc:ShowMineFeedback("아직 익히지 않은 제작법입니다. " .. tostring(row:GetItem("UnlockHint") or "???"))
			end
			self:ClientOnCraftCompleted(recipeName, false, playerComp.UserId)
			return
		end

		local ingredients = {}
		local ing1Name = row:GetItem("Ing1Name") or ""
		local ing1Count = tonumber(row:GetItem("Ing1Count")) or 0
		local ing2Name = row:GetItem("Ing2Name") or ""
		local ing2Count = tonumber(row:GetItem("Ing2Count")) or 0
		if ing1Name ~= "" and ing1Count > 0 then
			table.insert(ingredients, { itemName = ing1Name, required = ing1Count })
		end
		if ing2Name ~= "" and ing2Count > 0 then
			table.insert(ingredients, { itemName = ing2Name, required = ing2Count })
		end
		for _, ing in ipairs(ingredients) do
			if self:GetItemCount(ing.itemName) < ing.required then
				self:ClientOnCraftCompleted(recipeName, false, playerComp.UserId)
				return
			end
		end

		for _, ing in ipairs(ingredients) do
			self:RemoveItem(ing.itemName, ing.required)
		end
		local outputCount = math.max(1, math.floor(tonumber(row:GetItem("OutputCount")) or 1))
		local craftedKey = self:AddItem(recipeName, outputCount)
		log("[CRAFT][BUILD] Player " .. self.Entity.Name .. " crafted " .. recipeName .. " x" .. tostring(outputCount))

		if _ActionSignals ~= nil then
			_ActionSignals:EmitToPlayer(self.Entity, _ActionEnum.Craft, recipeName, outputCount)
		end
		self:ClientOnCraftCompleted(recipeName, true, playerComp.UserId)
		self:AutoSlotCraftedItem(craftedKey)
	end

	@ExecSpace("ServerOnly")
	method void AutoSlotCraftedItem(string craftedKey)
		-- 건축 제작물을 빈 퀵슬롯에 자동 등록하고 선택한다 (ServerRequestCraft 의 도구·가구 자동 장착과 같은 규칙).
		if craftedKey == nil or craftedKey == "" then return end
		local slots = self:SafeDecodeJson(self.QuickSlotsJson, {})
		for i = 1, 10 do
			if slots[i] == craftedKey then return end
		end
		for i = 1, 10 do
			if slots[i] == nil or slots[i] == "" then
				self.SelectedQuickSlotIndex = i
				slots[i] = craftedKey
				self.QuickSlotsJson = self:SafeEncodeJson(slots, "[\"\", \"\", \"\", \"\", \"\", \"\", \"\", \"\", \"\", \"\"]")
				log("[QUICKSLOT] Auto-registered crafted item " .. craftedKey .. " to slot " .. i)
				self:SyncEquippedToolToSelectedSlot()
				return
			end
		end
	end

	@ExecSpace("Client")
	method void ClientOnCraftCompleted(string recipeName, boolean success)
		-- description: Handles crafting result on client, displays private notice, and resets crafting status.
		local popup = _EntityService:GetEntityByPath("/ui/PopupGroup/CraftingPopup")
		local craftingCtrl = nil
		if isvalid(popup) then
			craftingCtrl = popup:GetComponent("script.UICraftingController")
			if isvalid(craftingCtrl) then
				craftingCtrl.isCrafting = false
			end
		end
		
		if success then
			log("Crafting successful for: " .. recipeName)
			_ScreenMessageLogic:PrivateMsg(string.format("[%s] 제작 및 획득 완료!", self:GetItemDisplayName(recipeName)))
			if isvalid(craftingCtrl) then
				craftingCtrl:UpdateDetails()
			end
		else
			log_warning("Crafting failed: Insufficient materials on server.")
			if isvalid(craftingCtrl) then
				craftingCtrl:UpdateDetails()
			end
		end
	end

	@ExecSpace("Server")
	method void ServerRegisterQuickSlot(integer slotIndex, string itemName)
		local playerComp = self.Entity.PlayerComponent
		if playerComp == nil or senderUserId ~= playerComp.UserId then
			return
		end
		
		if slotIndex < 1 or slotIndex > 10 then
			log_warning("Invalid quick slot index: " .. tostring(slotIndex))
			return
		end
		
		-- If itemName is not empty, check if player owns it
		if itemName ~= "" then
			local entry = self.Items[itemName]
			local owned = false
			if entry ~= nil then
				if type(entry) == "table" then
					owned = (entry.count or 1) > 0
				else
					owned = entry > 0
				end
			end
			if not owned then
				log_warning("Player " .. self.Entity.Name .. " does not own " .. itemName .. " to register in quick slot.")
				return
			end
		end
		
		local slots = self:SafeDecodeJson(self.QuickSlotsJson, {})
		if itemName ~= "" then
			for i = 1, 10 do
				if slots[i] == itemName then
					slots[i] = ""
				end
			end
		end
		slots[slotIndex] = itemName
		self.QuickSlotsJson = self:SafeEncodeJson(slots, "[\"\", \"\", \"\", \"\", \"\", \"\", \"\", \"\", \"\", \"\"]")
		
		log("[QUICKSLOT] Player " .. self.Entity.Name .. " registered slot " .. slotIndex .. " = " .. itemName)
		self:SyncEquippedToolToSelectedSlot()
		
		if _PersistenceManager and self.Entity.PlayerComponent then
			_PersistenceManager:MarkPlayerDirty(self.Entity.PlayerComponent.UserId)
		end
	end

	@ExecSpace("Server")
	method void ServerSwapQuickSlots(integer fromIndex, integer toIndex)
		local playerComp = self.Entity.PlayerComponent
		if playerComp == nil or senderUserId ~= playerComp.UserId then
			return
		end
		
		if fromIndex < 1 or fromIndex > 10 or toIndex < 1 or toIndex > 10 then
			log_warning("Invalid swap indices: from " .. tostring(fromIndex) .. " to " .. tostring(toIndex))
			return
		end
		
		local slots = self:SafeDecodeJson(self.QuickSlotsJson, {})
		local temp = slots[fromIndex] or ""
		slots[fromIndex] = slots[toIndex] or ""
		slots[toIndex] = temp
		
		self.QuickSlotsJson = self:SafeEncodeJson(slots, "[\"\", \"\", \"\", \"\", \"\", \"\", \"\", \"\", \"\", \"\"]")
		log("[QUICKSLOT] Player " .. self.Entity.Name .. " swapped slot " .. fromIndex .. " <-> " .. toIndex)
		self:SyncEquippedToolToSelectedSlot()
		
		if _PersistenceManager and self.Entity.PlayerComponent then
			_PersistenceManager:MarkPlayerDirty(self.Entity.PlayerComponent.UserId)
		end
	end

	@ExecSpace("ServerOnly")
	method void SyncEquippedToolToSelectedSlot()
		-- description: Automatically equips the tool registered in the currently selected quickslot.
		local slots = self:SafeDecodeJson(self.QuickSlotsJson, {})
		local itemName = slots[self.SelectedQuickSlotIndex] or ""
		
		if itemName ~= "" then
			local entry = self.Items[itemName]
			local hasItem = false
			if entry ~= nil then
				if type(entry) == "table" then
					hasItem = (entry.count or 1) > 0
				else
					hasItem = entry > 0
				end
			end
			
			if hasItem then
				local baseName = self:GetBaseItemName(itemName)
				local ds = _DataService:GetTable("item_dataset")
				if ds ~= nil then
					local row = ds:FindRow("Name", baseName)
					if row ~= nil and row:GetItem("Category") == "tool" then
						if self.EquippedTool ~= itemName then
							self:Equip(itemName)
						end
						return
					end
				end
			end
		end
		
		if self.EquippedTool ~= "" then
			self:Equip("")
		end
	end

	@ExecSpace("Server")
	method void ServerSelectQuickSlot(integer slotIndex)
		-- description: Updates the active selected quick slot and updates equipped tool.
		local playerComp = self.Entity.PlayerComponent
		if playerComp == nil or senderUserId ~= playerComp.UserId then
			return
		end
		
		if slotIndex < 1 or slotIndex > 10 then
			log_warning("Invalid quick slot index: " .. tostring(slotIndex))
			return
		end
		
		self.SelectedQuickSlotIndex = slotIndex
		log("[QUICKSLOT] Player " .. self.Entity.Name .. " selected slot " .. slotIndex)
		self:SyncEquippedToolToSelectedSlot()
		
		if _PersistenceManager and self.Entity.PlayerComponent then
			_PersistenceManager:MarkPlayerDirty(self.Entity.PlayerComponent.UserId)
		end
	end

	@ExecSpace("Server")
	method void ServerRequestPlace(string itemName, integer cellX, integer cellY)
		-- description: Handles server-side validation and execution of placing furniture or construction tiles.
		local cellPos = Vector2Int(cellX, cellY)
		local playerComp = self.Entity.PlayerComponent
		if playerComp == nil or senderUserId ~= playerComp.UserId then
			return
		end
		
		local currentMap = self.Entity.CurrentMap
		if not isvalid(currentMap) then return end
		local mapName = currentMap.Name

		-- Enforce map-specific placement permissions
		local pc = self.Entity:GetComponent("script.PlayerController")
		-- 영지 전용 설치물(item_dataset.HomeOnly=true — 침대 등)은 개인 영지(Home_*) 밖에서 거부한다.
		if string.sub(mapName, 1, 5) ~= "Home_" then
			local itemDs = _DataService:GetTable("item_dataset")
			local itemRow = nil
			if itemDs ~= nil then itemRow = itemDs:FindRow("Name", itemName) end
			if itemRow ~= nil and tostring(itemRow:GetItem("HomeOnly")) == "true" then
				if isvalid(pc) then
					pc:ShowMineFeedback("영지에서만 설치할 수 있습니다.")
				end
				return
			end
		end
		if mapName == "town" then
			if isvalid(pc) then
				pc:ShowMineFeedback("마을에서는 설치를 할 수 없습니다.")
			end
			return
		elseif string.sub(mapName, 1, 5) == "Home_" then
			local ownerId = string.sub(mapName, 6)
			local guestUserId = playerComp.UserId
			if _PersistenceManager and not _PersistenceManager:CheckGuestPermission(ownerId, guestUserId, "place") then
				if isvalid(pc) then
					pc:ShowMineFeedback("이 영지에서 배치할 수 있는 권한이 없습니다.")
				end
				return
			end
		end
		
		-- Validate item ownership
		if not self:HasItem(itemName, 1) then
			log_warning("Player " .. self.Entity.Name .. " does not own " .. itemName)
			return
		end

		-- 건축 부품·설계도(item_dataset.Category = "build"): 2×2 칸 단위 배치·검증은 BuildingManager 가 전담한다.
		-- 위의 영지 전용·마을 금지·손님 권한·소유 검사는 그대로 거친다. 셀 = 클라 GetAimUnit 칸의 원점 셀.
		local buildDs = _DataService:GetTable("item_dataset")
		local buildRow = nil
		if buildDs ~= nil then buildRow = buildDs:FindRow("Name", self:GetBaseItemName(itemName)) end
		if buildRow ~= nil and buildRow:GetItem("Category") == "build" then
			if _BuildingManager ~= nil then
				_BuildingManager:PlaceBuildItem(self.Entity, itemName, cellX, cellY)
			end
			return
		end

		local currentMap = self.Entity.CurrentMap
		if not isvalid(currentMap) then return end

		local tilemap = currentMap:GetFirstChildComponentByTypeName("RectTileMapComponent", true)
		if not isvalid(tilemap) then
			log_warning("No RectTileMapComponent found on map.")
			return
		end
		
		-- 점유 n×n (바닥 타일·씨앗 = 1, 가구 = item_dataset.FootprintSize, 공란 2). cellPos = 블록 원점(왼쪽 아래 칸).
		local footprint = 1
		if _ResourceSpawner ~= nil then footprint = _ResourceSpawner:GetPlaceFootprint(self:GetBaseItemName(itemName)) end

		-- 서버 위치와 서버 방향 기준으로 타겟 셀의 거리 및 전방 방향 검증
		-- 거리 = 플레이어에서 블록 사각형의 가장 가까운 점까지 (원점이나 중심으로 재면 4×4 우리는
		-- 원점 기준이면 왼쪽·아래, 중심 기준이면 위·오른쪽으로 놓을 때 "너무 멀다"로 조용히 거부된다 — 2026-10-10).
		-- 뒤쪽 판정은 블록 중심 기준.
		local playerPos = self.Entity.TransformComponent.WorldPosition
		if not isvalid(pc) then return end
		local targetCenterX = cellPos.x + footprint * 0.5
		local targetCenterY = cellPos.y + footprint * 0.5
		local dx = targetCenterX - playerPos.x
		local dy = targetCenterY - playerPos.y
		local nearX = math.max(cellPos.x, math.min(playerPos.x, cellPos.x + footprint))
		local nearY = math.max(cellPos.y, math.min(playerPos.y, cellPos.y + footprint))
		local ndx = nearX - playerPos.x
		local ndy = nearY - playerPos.y
		if ndx * ndx + ndy * ndy > 12.25 then
			log_warning("Rejected placement too far from player.")
			return
		end
		if pc.LastDirectionX ~= 0 and (dx * pc.LastDirectionX < -0.5) then
			log_warning("Rejected placement behind player X.")
			return
		end
		if pc.LastDirectionY ~= 0 and (dy * pc.LastDirectionY < -0.5) then
			log_warning("Rejected placement behind player Y.")
			return
		end
		
		-- Fetch item metadata from item_dataset
		local ds = _DataService:GetTable("item_dataset")
		if ds == nil then return end
		local row = ds:FindRow("Name", itemName)
		if row == nil then return end
		local category = row:GetItem("Category")
		if category ~= "furniture" then
			log_warning("Item is not a placeable type: " .. itemName)
			return
		end
		
		local placedTileName = row:GetItem("PlacedTileName") or ""
		local isTile = (placedTileName ~= "")
		
		-- Validate target base terrain (Layer 1 Soil 베이스 또는 Layer 2 잔디 커버가 밑에 있어야 설치 가능 — 맵 안 판정)
		local layer1 = currentMap:GetChildByName("RectTileMap")
		local layer2 = currentMap:GetChildByName("RectTileMap2")
		local hasBase = false
		if isvalid(layer1) and isvalid(layer1.RectTileMapComponent) then
			if layer1.RectTileMapComponent:GetTile(cellPos) ~= nil then hasBase = true end
		end
		if isvalid(layer2) and isvalid(layer2.RectTileMapComponent) then
			if layer2.RectTileMapComponent:GetTile(cellPos) ~= nil then hasBase = true end
		end
		if not hasBase then
			log_warning("Cannot place on empty space.")
			return
		end
		
		local resourceSpawner = _ResourceSpawner
		if resourceSpawner == nil then
			log_warning("ResourceSpawner not available.")
			return
		end

		-- 작물 씨앗 여부: CropDataSet.SeedItem FindRow 로만 판정 (이름 분기 금지).
		local cropRow = nil
		local cropDs = _DataService:GetTable("CropDataSet")
		if cropDs ~= nil then
			cropRow = cropDs:FindRow("SeedItem", itemName)
		end
		local isCropSeed = cropRow ~= nil

		-- 작물 파종: 호미로 일군 실제 Farm 타일이 있는 셀만 서버에서 허용.
		if isCropSeed then
			if not resourceSpawner:IsPlantableFarmCell(currentMap, cellPos.x, cellPos.y) then
				if isvalid(pc) then
					pc:ShowMineFeedback("호미로 일군 밭에만 작물을 심을 수 있습니다.")
				end
				return
			end
		end
		
		-- Validate grid footprint occupancy
		if isTile then
			local key = cellPos.x .. "_" .. cellPos.y
			if resourceSpawner:GetGridToEntity(currentMap.Name)[key] ~= nil then
				log_warning("Grid cell occupied: " .. key)
				return
			end
			-- 건축 칸(바닥 포함): 설치 바닥 타일은 같은 RectTileMap3 에 칠해져 건축 바닥을 덮어쓰므로 막는다.
			if _BuildingManager ~= nil and _BuildingManager:IsBuildCell(currentMap.Name, cellPos.x, cellPos.y) then
				if isvalid(pc) then
					pc:ShowMineFeedback("건축물이 있는 칸에는 놓을 수 없습니다.")
				end
				return
			end
		else
			-- Furniture / crop model lookup
			local modelId = nil
			if isCropSeed then
				local cropId = cropRow:GetItem("CropId") or ""
				modelId = _EntryService:GetModelIdByName("Crop_" .. string.gsub(cropId, " ", ""))
			else
				modelId = _EntryService:GetModelIdByName("Furniture_" .. string.gsub(itemName, " ", ""))
			end
			if modelId == nil or modelId == "" then
				log_error("Placed model not found for: " .. itemName)
				return
			end
			
			local xMin, xMax, yMin, yMax = cellPos.x, cellPos.x, cellPos.y, cellPos.y
			if not isCropSeed then
				xMax = cellPos.x + footprint - 1
				yMax = cellPos.y + footprint - 1
			end
			
			-- Check player collision overlap
			local players = _UserService:GetUsersByMapComponent(currentMap.MapComponent)
			if players then
				for _, user in pairs(players) do
					if isvalid(user) then
						local uPos = user.TransformComponent.WorldPosition
						local uCell = tilemap:ToCellPosition(uPos)
						if uCell.x >= xMin and uCell.x <= xMax and uCell.y >= yMin and uCell.y <= yMax then
							log_warning("Cannot place on a player.")
							return
						end
					end
				end
			end
			
			-- Check occupancy in GridToEntity
			for nx = xMin, xMax do
				for ny = yMin, yMax do
					local key = nx .. "_" .. ny
					if resourceSpawner:GetGridToEntity(currentMap.Name)[key] ~= nil then
						if isvalid(pc) then
							pc:ShowMineFeedback("이미 점유된 칸입니다.")
						end
						log_warning("Grid cell occupied: " .. key)
						return
					end
				end
			end
		end
		
		-- Deduct 1 item from inventory
		if not self:RemoveItem(itemName, 1) then
			log_warning("Failed to remove item: " .. itemName)
			return
		end
		local placementSucceeded = false
		
		if isTile then
			-- Paint tile on RectTileMap3 (Layer 3)
			local layer3 = currentMap:GetChildByName("RectTileMap3")
			if isvalid(layer3) and isvalid(layer3.RectTileMapComponent) then
				-- 맵마다 RectTileMap3 의 tileset 이 다르다(map01 = wall, 그 외 = tile1). 없는 이름이면 LEA-3005 로 중단되어
				-- 아이템만 사라지므로 pcall 로 감싸고 실패 시 아래 환불 경로를 탄다.
				local tileOk, tileErr = pcall(function()
					layer3.RectTileMapComponent:SetTile(placedTileName, cellPos.x, cellPos.y)
				end)
				if tileOk then
					log("[PLACE] Painted tile " .. placedTileName .. " at cell " .. tostring(cellPos))
					resourceSpawner:AddPlacedTile(currentMap.Name, placedTileName, cellPos.x, cellPos.y)
					placementSucceeded = true
				else
					log_warning("[PLACE] tile '" .. placedTileName .. "' not in this map's RectTileMap3 tileset; refunding " .. itemName .. " (" .. tostring(tileErr) .. ")")
				end
			else
				log_error("[PLACE] RectTileMap3 unavailable; refunding " .. itemName)
			end
		else
			-- Spawn furniture or crop entity
			local modelId = nil
			if isCropSeed then
				local cropId = cropRow:GetItem("CropId") or ""
				modelId = _EntryService:GetModelIdByName("Crop_" .. string.gsub(cropId, " ", ""))
			else
				modelId = _EntryService:GetModelIdByName("Furniture_" .. string.gsub(itemName, " ", ""))
			end
			local spawnPos = Vector3(cellPos.x + 0.5, cellPos.y + 0.5, 0)
			local spawnName = itemName
			if isCropSeed then
				local cropId = cropRow:GetItem("CropId") or itemName
				spawnName = "Crop_" .. string.gsub(cropId, " ", "")
			end
			local spawnedEntity = _SpawnService:SpawnByModelId(
				modelId,
				spawnName,
				spawnPos,
				currentMap
			)
			if isvalid(spawnedEntity) then
				local occ = spawnedEntity:GetComponent("script.ResourceOccupiedArea")
				if isvalid(occ) then
					local fxMin = math.floor(cellPos.x + (tonumber(occ.OffsetXMin) or 0))
					local fxMax = math.floor(cellPos.x + (tonumber(occ.OffsetXMax) or 0))
					local fyMin = math.floor(cellPos.y + (tonumber(occ.OffsetYMin) or 0))
					local fyMax = math.floor(cellPos.y + (tonumber(occ.OffsetYMax) or 0))
					local cx = (fxMin + fxMax + 1.0) * 0.5
					local cy = (fyMin + fyMax + 1.0) * 0.5
					spawnedEntity.TransformComponent.WorldPosition = Vector3(cx, cy, 0)
				end

				-- Check Walkable from dataset or component
				local isWalkable = false
				local itemDs = _DataService:GetTable("item_dataset")
				if itemDs ~= nil and itemName ~= nil then
					local row = itemDs:FindRow("Name", itemName)
					if row ~= nil then
						local okW, wVal = pcall(function() return row:GetItem("Walkable") end)
						if okW and (wVal == "true" or wVal == true) then
							isWalkable = true
						end
					end
				end
				local furnComp = spawnedEntity:GetComponent("script.PlaceableFurniture")
				if isvalid(furnComp) then
					if isWalkable or furnComp.IsWalkable then
						furnComp.IsWalkable = true
						furnComp.BlocksMovement = false
						isWalkable = true
					end
				end

				local sprite = spawnedEntity.SpriteRendererComponent
				if isvalid(sprite) then
					sprite.IgnoreMapLayerCheck = true
					sprite.SortingLayer = _RenderLayers.EntityLayer
					if isWalkable then
						sprite.OrderInLayer = _RenderLayers.MinEntityOrder or 2
					else
						sprite.OrderInLayer = _RenderLayers:ComputeYOrderWithSortOffset(spawnedEntity)
					end
				end
				if isCropSeed then
					-- 모델에 script.Crop이 등록돼 있어야 함. 미등록 시 서버 전용 AddComponent 폴백
					-- (클라 Multicast 금지 — 없으면 LEA-3004 MissingComponent Crop).
					local cropComp = spawnedEntity:GetComponent("script.Crop")
					if not isvalid(cropComp) then
						log_warning("[PLACE] model missing script.Crop; server AddComponent fallback. modelId="
							.. tostring(modelId) .. " — rebuild Crop_* model after Crop.mlua refresh")
						spawnedEntity:AddComponent("script.Crop")
						cropComp = spawnedEntity:GetComponent("script.Crop")
					end
					if not isvalid(cropComp) then
						spawnedEntity:AddComponent("Crop")
						cropComp = spawnedEntity:GetComponent("script.Crop")
						if not isvalid(cropComp) then
							cropComp = spawnedEntity:GetComponent("Crop")
						end
					end
					if isvalid(cropComp) then
						cropComp:InitializePlant(itemName, math.floor(os.time()))
						-- 파종 직후 스케일 즉시 적용 (1프레임 거대화 방지). InitializePlant가 비주얼도 갱신.
						local s = cropComp:GetStageScale(1)
						if s == nil or s <= 0 then s = 0.25 end
						local tr = spawnedEntity.TransformComponent
						if isvalid(tr) then
							tr.Scale = Vector3(s, s, 1)
						end
						log("[PLACE] Planted crop seed " .. itemName
							.. " at cell " .. tostring(cellPos)
							.. " plantedAt=" .. tostring(cropComp.PlantedAtUnix)
							.. " seedProp=" .. tostring(cropComp.SeedItem)
							.. " scale=" .. tostring(s))
					else
						log_error("[PLACE] Failed to attach Crop for " .. itemName
							.. " modelId=" .. tostring(modelId))
					end
				else
					log("[PLACE] Spawned furniture " .. itemName .. " at cell " .. tostring(cellPos))
				end

				-- NOTE: portals need no placement-time initialization. Furniture_Portal.model carries
				-- script.PortalGate itself, and portals placed on estate (Home_*) maps are universal:
				-- they always open the full destination list popup (see PlayerController:TryUsePortal),
				-- so TargetMapName/DestinationGroup are irrelevant here (C-1 design).

				resourceSpawner:AddPlacedFurniture(currentMap.Name, itemName, cellPos.x, cellPos.y, spawnedEntity)
				placementSucceeded = true
			else
				log_error("Failed to spawn placeable entity: " .. itemName)
			end
		end

		if not placementSucceeded then
			self:AddItem(itemName, 1)
			return
		end

		-- 업적/퀘스트 진행: 설치 액션 발행
		if _ActionSignals ~= nil then
			_ActionSignals:EmitToPlayer(self.Entity, _ActionEnum.Place, itemName, 1)
		end
	end

	@ExecSpace("Server")
	method void ServerRequestTerrainEdit(string itemName, integer cellX, integer cellY, integer dirX, integer dirY)
		-- digPath(삽)/digHole(괭이)/plantGrass(씨앗) 영지 지형 편집. 데이터 주도: item_dataset.TerrainEditAction.
		-- digPath axis는 시선(dir), side는 플레이어 셀 내 소수부(서버 계산, 재생 시 재계산 금지).
		local playerComp = self.Entity.PlayerComponent
		if playerComp == nil or senderUserId ~= playerComp.UserId then
			return
		end

		local currentMap = self.Entity.CurrentMap
		if not isvalid(currentMap) then return end
		local mapName = currentMap.Name
		local pc = self.Entity:GetComponent("script.PlayerController")

		-- 지형 편집은 개인 영지(Home_*)에서만 허용. 마을/사냥터에서는 거부.
		if string.sub(mapName, 1, 5) ~= "Home_" then
			if isvalid(pc) then pc:ShowMineFeedback("여기서는 지형을 편집할 수 없습니다.") end
			return
		end
		-- 손님 권한 검증 (설치 권한 재사용).
		local ownerId = string.sub(mapName, 6)
		if _PersistenceManager and not _PersistenceManager:CheckGuestPermission(ownerId, playerComp.UserId, "place") then
			if isvalid(pc) then pc:ShowMineFeedback("이 영지를 편집할 권한이 없습니다.") end
			return
		end

		-- 아이템 소유 확인 + 편집 동작 조회 (데이터 주도).
		if not self:HasItem(itemName, 1) then
			log_warning("Player " .. self.Entity.Name .. " does not own " .. itemName)
			return
		end
		local baseName = self:GetBaseItemName(itemName)
		local ds = _DataService:GetTable("item_dataset")
		if ds == nil then return end
		local row = ds:FindRow("Name", baseName)
		if row == nil then return end
		local action = ""
		-- 데이터셋 리프레시 전이라 컬럼이 없을 수 있어 pcall 폴백을 둔다. 컬럼이 실제로 없으면 LEA-3011 로그는 남는다.
		local ok, v = pcall(function() return row:GetItem("TerrainEditAction") end)
		if ok and v ~= nil then action = v end
		if action == "" then return end   -- 편집 도구/아이템이 아님

		-- 서버 위치와 서버 방향 기준으로 타겟 셀의 거리 및 전방 방향 검증
		local playerPos = self.Entity.TransformComponent.WorldPosition
		if not isvalid(pc) then return end
		dirX = pc.LastDirectionX
		dirY = pc.LastDirectionY

		local l1Ent = currentMap:GetChildByName("RectTileMap")
		local tilemap1 = (isvalid(l1Ent) and isvalid(l1Ent.RectTileMapComponent)) and l1Ent.RectTileMapComponent or nil
		local l2Ent = currentMap:GetChildByName("RectTileMap2")
		local tilemap2 = (isvalid(l2Ent) and isvalid(l2Ent.RectTileMapComponent)) and l2Ent.RectTileMapComponent or nil
		local l0Ent = currentMap:GetChildByName("RectTileMap0")
		local tilemap0 = (isvalid(l0Ent) and isvalid(l0Ent.RectTileMapComponent)) and l0Ent.RectTileMapComponent or nil
		local l3Ent = currentMap:GetChildByName("RectTileMap3")
		local tilemap3 = (isvalid(l3Ent) and isvalid(l3Ent.RectTileMapComponent)) and l3Ent.RectTileMapComponent or nil

		local playerCell = nil
		if tilemap1 ~= nil then
			playerCell = tilemap1:ToCellPosition(playerPos)
		else
			playerCell = Vector2Int(math.floor(playerPos.x), math.floor(playerPos.y))
		end

		local targetCenterX = cellX + 0.5
		local targetCenterY = cellY + 0.5
		local dx = targetCenterX - playerPos.x
		local dy = targetCenterY - playerPos.y
		local distSq = dx * dx + dy * dy
		if distSq > 12.25 then
			log_warning("Rejected terrain edit too far from player.")
			return
		end
		if dirX ~= 0 and (dx * dirX < -0.5) then
			log_warning("Rejected terrain edit behind player X.")
			return
		end
		if dirY ~= 0 and (dy * dirY < -0.5) then
			log_warning("Rejected terrain edit behind player Y.")
			return
		end

		local resourceSpawner = _ResourceSpawner
		if resourceSpawner == nil then return end

		-- digPath axis/side 결정 (저장 시 side 확정 — 재생 시 플레이어 위치 재계산 금지).
		-- ⚠️ 현재 axis/side는 **영속 델타에 기록만 되고 실제 적용에는 쓰이지 않는다**:
		--    ApplyTerrainEdit의 digPath 분기는 2×2 안쪽 모서리 4비트만 찍고 axis/side를 보지 않으며,
		--    유일한 소비처였던 클라 영향셀 미리보기는 제거됐다(2026-09-04). 구 세이브 호환을 위해
		--    기록 자체는 남겨둔다 — 제거하려면 ApplyTerrainEdit 시그니처와 델타 기록을 함께 정리할 것.
		local axis = ""
		local side = ""
		if action == "digPath" then
			local ax = resourceSpawner:DeriveDigPathAxisSide(dirX, dirY, playerPos.x, playerPos.y)
			axis = ax.axis
			side = ax.side
		end

		local realAction = action
		local editX = cellX
		local editY = cellY
		local editSize = 1

		-- 2×2 지형 편집(물삽·호미·삽·씨앗) 공통 블록 원점 — 조준 셀 포함 + 시선 방향으로 뻗음.
		-- 🔴 조준점(PlayerController:UpdateMineReticle)도 같은 함수를 쓴다(규칙 18).
		local block2 = resourceSpawner:GetAimBlockOrigin(cellX, cellY, dirX, dirY, 2)

		if action == "dig_water" then
			local origin = resourceSpawner:GetAimBlockOrigin(cellX, cellY, dirX, dirY, resourceSpawner.WaterDigSize)
			editX = origin.x
			editY = origin.y
			editSize = origin.size

			-- 3단계 물 순환 검사 — 모든 단계가 조준 레티클을 중심으로 **동심** 확장한다.
			--   1타: 2×2 [aim .. aim+1]   — 레티클(셀 모서리점)이 정확히 이 블록의 중심
			--   2타: 4×4 [aim-1 .. aim+2] — 1타 블록을 사방 1칸씩 감싼 동심 확장
			--   3타: 같은 4×4를 되메우기
			-- 🔴 2타를 3×3으로 잡으면 중심이 반 칸 어긋나 한쪽으로 치우쳐 파이고,
			--    아래 바깥 검사(4×4)를 영원히 채우지 못해 3타(되메우기)에 도달하지 못한다.
			if isvalid(tilemap1) then
				local allWaterInner = true
				for by = editY, editY + origin.size - 1 do
					for bx = editX, editX + origin.size - 1 do
						if not resourceSpawner:IsWaterCell(tilemap1, bx, by) then
							allWaterInner = false
							break
						end
					end
					if not allWaterInner then break end
				end

				if allWaterInner then
					local allWaterOuter = true
					for by = editY - 1, editY + origin.size do
						for bx = editX - 1, editX + origin.size do
							if not resourceSpawner:IsWaterCell(tilemap1, bx, by) then
								allWaterOuter = false
								break
							end
						end
						if not allWaterOuter then break end
					end

					-- 2타·3타 공통: 1타 블록을 사방 1칸씩 감싼 동심 블록으로 전환
					editX = editX - 1
					editY = editY - 1
					editSize = origin.size + 2
					if allWaterOuter then
						realAction = "fill_water_large"
					else
						realAction = "dig_water_large"
					end
				end
			end

			-- 발 밑 차단 (물 파기일 때만)
			if string.find(realAction, "dig_water") ~= nil and playerCell ~= nil then
				if playerCell.x >= editX and playerCell.x <= editX + editSize - 1
					and playerCell.y >= editY and playerCell.y <= editY + editSize - 1 then
					if isvalid(pc) then pc:ShowMineFeedback("발 밑 셀에는 물을 갤 수 없습니다.") end
					return
				end
			end

		elseif action == "fill_water" then
			local origin = resourceSpawner:GetAimBlockOrigin(cellX, cellY, dirX, dirY, resourceSpawner.WaterDigSize)
			editX = origin.x
			editY = origin.y
			editSize = origin.size

			-- 폭 1칸 자투리가 남지 않는 위치로 블록을 보정한다 (조준 칸은 반드시 포함).
			local fillOrigin = resourceSpawner:ResolveFillBlockOrigin(currentMap, tilemap1, "water", editX, editY, editSize)
			editX = fillOrigin.x
			editY = fillOrigin.y

		elseif action == "digPath" then
			-- 삽 2단계 통합:
			-- 1타: 잔디 -> 길/작은 구멍 (digPath)
			-- 2타: 이미 파인 곳 -> 2×2 넓은 흙 (digHole)
			-- 3타: 이미 2×2 전체가 넓은 흙 -> "이미 넓은 흙밭입니다."
			editSize = 2
			editX = block2.x
			editY = block2.y
			local curMask = resourceSpawner:GetCellMask(tilemap2, tilemap1, editX, editY)

			local allSoil = true
			for ny = editY, editY + 1 do
				for nx = editX, editX + 1 do
					local m = resourceSpawner:GetCellMask(tilemap2, tilemap1, nx, ny)
					if m ~= 15 then
						allSoil = false
						break
					end
				end
				if not allSoil then break end
			end

			if allSoil then
				if isvalid(pc) then pc:ShowMineFeedback("이미 넓은 흙밭입니다.") end
				return
			end

			-- 이미 파여 있는 곳(curMask ~= 0)이면 digHole(2×2 넓은 흙)로 승격!
			if curMask ~= 0 then
				realAction = "digHole"
			end

		elseif action == "digHole" or action == "till_field" then
			-- 호미 기능: 물삽과 동일한 2×2 조준점 전체 밭 일구기 및 복구 토글!
			editSize = 2
			editX = block2.x
			editY = block2.y

			local farmCount = 0
			local hasWater = false
			local hasGrass = false

			for by = editY, editY + editSize - 1 do
				for bx = editX, editX + editSize - 1 do
					local isFarm = resourceSpawner:IsFarmCell(currentMap, bx, by)
					if isFarm then
						farmCount = farmCount + 1
					else
						local curMask = resourceSpawner:GetCellMask(tilemap2, tilemap1, bx, by)
						-- 🔴 넓게 드러난 순수 흙(L2 홀, 마스크 15)에만 밭 일구기 허용 (FullGrass 0 및 잔디 프린지 1~14 전면 차단)
						if curMask ~= 15 then
							hasGrass = true
						end
					end
					if isvalid(tilemap1) and resourceSpawner:IsWaterCell(tilemap1, bx, by) then
						hasWater = true
					end
				end
			end

			-- 🔴 외부 12칸(이웃 테두리: x-1~x+2, y-1~y+2 중 2×2 내부 제외)에 밭이 연결되어 있는지 검사
			local hasNeighborFarm = false
			for ny = editY - 1, editY + editSize do
				for nx = editX - 1, editX + editSize do
					if not (nx >= editX and nx < editX + editSize and ny >= editY and ny < editY + editSize) then
						if resourceSpawner:IsFarmCell(currentMap, nx, ny) then
							hasNeighborFarm = true
							break
						end
					end
				end
				if hasNeighborFarm then break end
			end

			-- 🔴 밭 일구기/확장 vs 되메우기 스마트 분기 규칙:
			-- 1) 4칸 전체가 밭(farmCount == 4): 100% 되메우기 (untill_field)
			-- 2) 밭과 흙이 공존(farmCount 1~3):
			--    - 외부 12칸에 밭이 없음(not hasNeighborFarm): 고립된 잔여 밭 철거 -> untill_field
			--    - 외부 12칸에 밭이 연결되어 있음(hasNeighborFarm): 기존 밭 확장 -> till_field
			-- 3) 4칸 전체가 흙(farmCount == 0): 신규 밭 일구기 -> till_field
			if farmCount == 4 then
				realAction = "untill_field"
			elseif farmCount > 0 and not hasNeighborFarm then
				realAction = "untill_field"
			else
				if hasWater then
					if isvalid(pc) then pc:ShowMineFeedback("물 위에는 밭을 일굴 수 없습니다.") end
					return
				end

				if hasGrass then
					if isvalid(pc) then pc:ShowMineFeedback("먼저 삽으로 흙을 넓게 드러내야 합니다.") end
					return
				end

				realAction = "till_field"
			end

			-- 되메우기로 확정된 경우에만 블록 위치를 보정한다 (조준 칸은 반드시 포함).
			-- 밭 일구기(till_field)는 조준한 자리에 그대로 만들어야 하므로 보정하지 않는다.
			if realAction == "untill_field" then
				local fillOrigin = resourceSpawner:ResolveFillBlockOrigin(currentMap, tilemap1, "farm", editX, editY, editSize)
				editX = fillOrigin.x
				editY = fillOrigin.y
			end

		elseif action == "plantGrass" then
			-- 🔴 씨앗(잔디 심기)도 ApplyTerrainEdit에서는 2×2로 적용된다. editSize가 1로
			--    남아 있으면 점유·편집가능 검사가 1칸만 보고 나머지 3칸을 검사 없이 덮어쓴다.
			editSize = 2
			editX = block2.x
			editY = block2.y
		end

		-- 점유 검사 (editSize × editSize 영역)
		local occupied = false
		for nx = editX, editX + editSize - 1 do
			for ny = editY, editY + editSize - 1 do
				if resourceSpawner:IsGridOccupied(mapName, nx, ny) then
					occupied = true
					break
				end
			end
			if occupied then break end
		end
		if occupied then
			if isvalid(pc) then pc:ShowMineFeedback("자원이나 설치물이 있어 편집할 수 없습니다.") end
			return
		end

		-- 편집 가능 셀 검사
		for nx = editX, editX + editSize - 1 do
			for ny = editY, editY + editSize - 1 do
				if not resourceSpawner:IsTerrainCellEditable(currentMap, nx, ny) then
					if isvalid(pc) then pc:ShowMineFeedback("여기는 편집할 수 없습니다.") end
					return
				end
			end
		end

		-- 지형 편집 적용 (서브셀 마스크 + 영속 델타)
		local success = resourceSpawner:ApplyTerrainEdit(mapName, currentMap, realAction, editX, editY, axis, side, true)
		if not success then
			if isvalid(pc) then
				if string.find(realAction, "dig_water") ~= nil then
					pc:ShowMineFeedback("여기에 물을 갤 수 없습니다.")
				elseif string.find(realAction, "fill_water") ~= nil then
					pc:ShowMineFeedback("여기에 되메울 수 없습니다.")
				elseif realAction == "till_field" then
					pc:ShowMineFeedback("여기에 밭을 일굴 수 없습니다.")
				elseif realAction == "untill_field" then
					pc:ShowMineFeedback("여기의 밭을 되메울 수 없습니다.")
				elseif action == "digHole" or realAction == "digHole" then
					pc:ShowMineFeedback("이미 파여 있습니다.")
				elseif action == "digPath" then
					pc:ShowMineFeedback("이미 길이 나 있습니다.")
				elseif action == "plantGrass" then
					pc:ShowMineFeedback("여기엔 잔디를 심을 수 없습니다.")
				else
					pc:ShowMineFeedback("더 이상 편집할 수 없습니다.")
				end
			end
			return
		end

		-- 성공 피드백 안내
		if isvalid(pc) then
			if realAction == "till_field" then
				pc:ShowMineFeedback("밭을 일구었습니다.")
			elseif realAction == "untill_field" then
				pc:ShowMineFeedback("밭을 흙으로 되메웠습니다.")
			elseif realAction == "dig_water_large" then
				pc:ShowMineFeedback("넓은 물웅덩이로 확장했습니다.")
			elseif string.find(realAction, "fill_water") ~= nil then
				pc:ShowMineFeedback("물을 퍼내어 흙으로 메웠습니다.")
			elseif realAction == "digHole" and action == "digPath" then
				pc:ShowMineFeedback("넓은 흙밭을 일구었습니다.")
			end
		end

		-- plantGrass는 씨앗 1개 소비 (도구는 재사용).
		if action == "plantGrass" then
			self:RemoveItem(itemName, 1)
		end

		-- 편집 델타 영속화 트리거 (60초 주기/퇴장 시 플러시).
		if _PersistenceManager then
			_PersistenceManager:MarkPlayerDirty(playerComp.UserId)
		end
	end

	method string SafeEncodeJson(table tbl, string defaultVal)
		if tbl == nil or next(tbl) == nil then
			return defaultVal or "{}"
		end
		local ok, encoded = pcall(function() return _HttpService:JSONEncode(tbl) end)
		if ok and encoded and encoded ~= "" then
			return encoded
		end
		return defaultVal or "{}"
	end

	method table SafeDecodeJson(string jsonStr, table defaultVal)
		if jsonStr == nil or jsonStr == "" then
			return defaultVal or {}
		end
		local ok, decoded = pcall(function() return _HttpService:JSONDecode(jsonStr) end)
		if ok and decoded then
			return decoded
		end
		return defaultVal or {}
	end

	@ExecSpace("Server")
	method void ServerRequestBuyItem(string itemName)
		local playerComp = self.Entity.PlayerComponent
		if playerComp == nil or senderUserId ~= playerComp.UserId then
			return
		end

		-- 과거 IsCurrency 미기입으로 Items에 쌓인 코인을 Coin 프로퍼티로 흡수 후 잔액 검사
		self:ConsolidateCurrencyItems()
		
		local shopDs = _DataService:GetTable("ShopItemDataSet")
		if shopDs == nil then return end
		
		local row = shopDs:FindRow("Name", itemName)
		if row == nil then return end
		
		local buyPrice = tonumber(row:GetItem("BuyPrice")) or 0
		if buyPrice <= 0 then return end
		
		if self.Coin < buyPrice then
			self:ClientShowFeedback("코인이 부족합니다!")
			return
		end
		
		self:RemoveItem("Coin", buyPrice)
		self:AddItem(itemName, 1)
		self:ClientShowFeedback(itemName .. " 구매 완료!")
		
		log("[SHOP] Player " .. self.Entity.Name .. " bought " .. itemName .. " for " .. buyPrice .. " coins. Balance=" .. tostring(self.Coin))
	end

	@ExecSpace("Server")
	method void ServerRequestSellItem(string itemName)
		local playerComp = self.Entity.PlayerComponent
		if playerComp == nil or senderUserId ~= playerComp.UserId then
			return
		end

		self:ConsolidateCurrencyItems()
		
		local shopDs = _DataService:GetTable("ShopItemDataSet")
		if shopDs == nil then return end
		
		local row = shopDs:FindRow("Name", itemName)
		if row == nil then return end
		
		local sellPrice = tonumber(row:GetItem("SellPrice")) or 0
		if sellPrice <= 0 then return end
		
		if self:GetItemCount(itemName) < 1 then
			self:ClientShowFeedback("판매할 아이템이 부족합니다!")
			return
		end
		
		self:RemoveItem(itemName, 1)
		self:AddItem("Coin", sellPrice)
		self:ClientShowFeedback(itemName .. " 판매 완료!")
		
		log("[SHOP] Player " .. self.Entity.Name .. " sold " .. itemName .. " for " .. sellPrice .. " coins. Balance=" .. tostring(self.Coin))
	end

	@ExecSpace("Client")
	method void ClientShowFeedback(string message)
		_ScreenMessageLogic:PrivateMsg(message)
	end

	method boolean IsCurrencyItem(string itemName)
		if itemName == nil or itemName == "" then return false end
		if self._T.CurrencyCache == nil then
			self._T.CurrencyCache = {}
		end
		if self._T.CurrencyCache[itemName] ~= nil then
			return self._T.CurrencyCache[itemName]
		end
		
		local ds = _DataService:GetTable("item_dataset")
		if ds ~= nil then
			local row = ds:FindRow("Name", itemName)
			if row == nil then
				row = ds:FindRow("id", itemName)
			end
			if row ~= nil then
				local raw = row:GetItem("IsCurrency")
				local isCurr = raw == true
					or raw == "true" or raw == "TRUE" or raw == "True"
					or raw == "1" or raw == 1
				self._T.CurrencyCache[itemName] = isCurr
				return isCurr
			end
		end
		self._T.CurrencyCache[itemName] = false
		return false
	end

end

@Component
script Summon extends Component
	-- 와일드키퍼 소환수 (job-branch-redesign §7.4). PlayerController.ExecuteSummonSkill 이 Summon_Spirit 모델을 스폰한 뒤 붙이고 Setup 을 부른다.
	-- 주인을 따라다니다 근처 몬스터를 쫓아가 공격한다. 소환수에게 맞은 몬스터는 잠깐 소환수를 노린다(어그로 우회 — 보스는
	-- MonsterAI.BossForcedTargetScale 배로 짧게, 보스 패턴은 실제 플레이어를 노린다 · 2026-10-06).
	-- 수치·외형은 SummonDataSet 행, 피해 계열·배율은 시전 스킬 행(SkillDataSet)이 정한다. 판정·이동은 전부 서버에서 돈다.

	property Entity Owner = nil
	@Sync property number Hp = 0
	@Sync property number MaxHp = 1
	property string SkillId = ""
	property string SummonId = ""
	property number ExpireAt = 0
	property number AttackInterval = 1.2
	property number AttackRange = 1.6
	property number AttackRadius = 0
	property number DetectRange = 6
	property number LeashRange = 7
	property number FollowDistance = 1.8
	property number AggroSeconds = 2.5
	property number TauntRadius = 0
	property number TauntSeconds = 0
	property string StandRUID = ""
	property string MoveRUID = ""
	property string AttackRUID = ""
	property string AttackEffectRUID = ""
	property number AttackEffectScale = 1
	property number AttackAnimSeconds = 0.5
	property Color BaseTint = Color(1, 1, 1, 1)

	@ExecSpace("ServerOnly")
	method boolean Setup(Entity owner, string skillId, string summonId, number duration, number hpBase)
		-- 시전 직후 1회. SummonDataSet 행을 읽어 수치·외형을 정한다. 행이 없으면 false(호출부가 소환수를 지운다).
		local ds = _DataService:GetTable("SummonDataSet")
		local row = ds ~= nil and ds:FindRow("SummonId", summonId) or nil
		if row == nil or not isvalid(owner) then return false end
		local function num(col, fallback) return tonumber(row:GetItem(col)) or fallback end
		self.Owner = owner
		self.SkillId = skillId
		self.SummonId = summonId
		self.ExpireAt = _UtilLogic.ElapsedSeconds + duration
		self.MaxHp = math.max(1, math.floor(hpBase * num("HpRatio", 0.4)))
		self.Hp = self.MaxHp
		self.AttackInterval = math.max(0.3, num("AttackInterval", 1.2))
		self.AttackRange = num("AttackRange", 1.6)
		self.AttackRadius = num("AttackRadius", 0)
		self.DetectRange = num("DetectRange", 6)
		self.LeashRange = num("LeashRange", 7)
		self.AggroSeconds = num("AggroSeconds", 2.5)
		self.TauntRadius = num("TauntRadius", 0)
		self.TauntSeconds = num("TauntSeconds", 0)
		self.StandRUID = row:GetItem("StandRUID") or ""
		self.MoveRUID = row:GetItem("MoveRUID") or ""
		self.AttackRUID = row:GetItem("AttackRUID") or ""
		self.AttackEffectRUID = row:GetItem("AttackEffectRUID") or ""
		self.AttackEffectScale = num("AttackEffectScale", 1)
		self.AttackAnimSeconds = num("AttackAnimSeconds", 0.5)
		local tint = row:GetItem("Tint") or ""
		if tint ~= "" then
			local parts = {}
			for token in string.gmatch(tint, "[^|]+") do parts[#parts + 1] = tonumber(token) or 1 end
			self.BaseTint = Color(parts[1] or 1, parts[2] or 1, parts[3] or 1, parts[4] or 1)
		end
		local scale = num("Scale", 2)
		self.Entity.TransformComponent.Scale = Vector3(scale, scale, 1)
		local mc = self.Entity.MovementComponent
		if isvalid(mc) then mc.InputSpeed = num("MoveSpeed", 3.4) end
		local sprite = self.Entity.SpriteRendererComponent
		if isvalid(sprite) then sprite.Color = self.BaseTint end
		self._T.anim = ""
		self._T.nextAttack = _UtilLogic.ElapsedSeconds + 0.4
		self._T.nextScan = 0
		self._T.attackAnimUntil = 0
		self:SetAnim("stand")
		self._T.ready = true
		log("[SUMMON] setup " .. summonId .. " skill=" .. skillId .. " hp=" .. tostring(self.MaxHp) .. " life=" .. string.format("%.1f", duration))
		return true
	end

	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
		-- 수명·주인 상태 확인 → 표적 탐색(0.3초 간격) → 공격 / 추적 / 주인 따라가기.
		if self._T.ready ~= true then return end
		local now = _UtilLogic.ElapsedSeconds
		local owner = self.Owner
		if not isvalid(owner) or owner.CurrentMap ~= self.Entity.CurrentMap then self:Dismiss("owner left") return end
		local pc = owner:GetComponent("script.PlayerController")
		if not isvalid(pc) or pc.IsDead then self:Dismiss("owner down") return end
		if now >= self.ExpireAt then self:Dismiss("expired") return end

		local myPos = self:Pos2D()
		local ownerPos = owner.TransformComponent.WorldPosition:ToVector2()
		local ownerDist = Vector2.Distance(myPos, ownerPos)
		-- 주인에게서 너무 멀어지면(벽 너머·워프 지점) 곁으로 순간이동한다.
		if ownerDist > self.LeashRange * 1.6 then
			local body = self.Entity.KinematicbodyComponent
			if isvalid(body) then body:SetWorldPosition(Vector2(ownerPos.x + 0.8, ownerPos.y)) end
			self._T.target = nil
			return
		end

		if now >= (self._T.nextScan or 0) then
			self._T.nextScan = now + 0.3
			self._T.target = self:FindTarget(myPos, ownerPos)
		end
		local target = self._T.target
		if target ~= nil and (not isvalid(target) or self:IsMonsterDown(target)) then
			target = nil
			self._T.target = nil
		end

		if target ~= nil then
			local tp = self:TargetCenter(target)
			local reach = self.AttackRange + self:TargetRadius(target)
			local dist = Vector2.Distance(myPos, tp)
			self:Face(tp.x - myPos.x)
			if dist <= reach then
				self:StopMove()
				if now >= (self._T.nextAttack or 0) then
					self._T.nextAttack = now + self.AttackInterval
					self:Attack(target, pc)
				end
			else
				self:MoveToward(tp, delta)
			end
		elseif ownerDist > self.FollowDistance then
			self:Face(ownerPos.x - myPos.x)
			self:MoveToward(ownerPos, delta)
		else
			self:StopMove()
		end
		if now >= (self._T.attackAnimUntil or 0) then
			self:SetAnim(self._T.moving == true and "move" or "stand")
		end
	end

	@ExecSpace("ServerOnly")
	method Entity FindTarget(Vector2 myPos, Vector2 ownerPos)
		-- 감지 범위 안의 살아 있는 몬스터 중 가장 가까운 것. 주인에게서 LeashRange 밖이면 쫓지 않는다.
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return nil end
		local best = nil
		local bestSq = self.DetectRange * self.DetectRange
		local leashSq = self.LeashRange * self.LeashRange
		for _, m in ipairs(map:GetChildComponentsByTypeName("script.Monster", false)) do
			local e = m.Entity
			if isvalid(e) and not self:IsMonsterDown(e) then
				local p = e.TransformComponent.WorldPosition:ToVector2()
				local dx = p.x - myPos.x
				local dy = p.y - myPos.y
				local ox = p.x - ownerPos.x
				local oy = p.y - ownerPos.y
				local dSq = dx * dx + dy * dy
				if dSq <= bestSq and ox * ox + oy * oy <= leashSq then
					best = e
					bestSq = dSq
				end
			end
		end
		return best
	end

	@ExecSpace("ServerOnly")
	method boolean IsMonsterDown(Entity e)
		local m = e:GetComponent("script.Monster")
		if not isvalid(m) then return true end
		---@type Monster
		local monster = m
		return monster.IsDead or monster.Hp <= 0
	end

	@ExecSpace("ServerOnly")
	method void Attack(Entity target, any pc)
		-- 단일 대상(AttackRadius 0): 표적에게 한 대. 광역(AttackRadius > 0, 숲의 군주): 내 주변 원 전체.
		-- 피해는 주인의 시전 스킬 계열 공격력 × 스킬 배율 × (1 + SummonPowerPct). 소환수 공격에는 치명이 없다(PlayerController.GetCritChanceFor).
		---@type PlayerController
		local controller = pc
		local myPos = self.Entity.TransformComponent.WorldPosition
		local hits = 0
		if self.AttackRadius > 0 then
			hits = controller:DamageSkillArea(self.SkillId, myPos, self.AttackRadius * 2, controller:GetSummonPowerScale())
		else
			local combat = self.Owner:GetComponent("script.PlayerCombat")
			if isvalid(combat) then
				---@type PlayerCombat
				local c = combat
				local ds = _DataService:GetTable("SkillDataSet")
				local row = ds ~= nil and ds:FindRow("SkillId", self.SkillId) or nil
				local dmg = controller:ComputeSummonDamage(self.SkillId)
				c:DealSkillHit(target, dmg, self.SkillId, controller:SkillText(row, "HitEffectRUID"), controller:SkillNumber(row, "HitEffectScale", 1))
				hits = 1
			end
		end
		-- 어그로 우회: 맞은 몬스터(광역이면 공격 반경 안 전부)가 잠깐 나를 노린다. 도발형(TauntRadius)은 더 넓게·길게·높은 우선순위로.
		self:ForceTargetAround(myPos:ToVector2(), math.max(self.AttackRadius, 0), target, self.AggroSeconds, 1)
		if self.TauntRadius > 0 and self.TauntSeconds > 0 then
			self:ForceTargetAround(myPos:ToVector2(), self.TauntRadius, nil, self.TauntSeconds, 2)
		end
		if self.AttackRUID ~= "" then
			self:SetAnim("attack")
			self._T.attackAnimUntil = _UtilLogic.ElapsedSeconds + self.AttackAnimSeconds
		end
		if self.AttackEffectRUID ~= "" then
			controller:MulticastPlayEffectEx(self.AttackEffectRUID, myPos, self.Entity.SpriteRendererComponent.FlipX, self.AttackEffectScale)
		end
		log("[SUMMON] attack " .. self.SummonId .. " hits=" .. tostring(hits))
	end

	@ExecSpace("ServerOnly")
	method void ForceTargetAround(Vector2 center, number radius, Entity single, number seconds, integer priority)
		-- single 이 있으면 그 몬스터에게만, radius > 0 이면 원 안 몬스터 전부에게 강제 표적(나)을 건다. 보스는 MonsterAI 가 지속을 줄여 받는다.
		if seconds <= 0 then return end
		if isvalid(single) then
			local ai = single:GetComponent("script.MonsterAI")
			if isvalid(ai) then
				---@type MonsterAI
				local a = ai
				a:SetForcedTarget(self.Entity, seconds, priority)
			end
		end
		if radius <= 0 then return end
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return end
		local rSq = radius * radius
		for _, m in ipairs(map:GetChildComponentsByTypeName("script.MonsterAI", false)) do
			local e = m.Entity
			if isvalid(e) and e ~= single and not self:IsMonsterDown(e) then
				local p = e.TransformComponent.WorldPosition
				local dx = p.x - center.x
				local dy = p.y - center.y
				if dx * dx + dy * dy <= rSq then
					---@type MonsterAI
					local a = m
					a:SetForcedTarget(self.Entity, seconds, priority)
				end
			end
		end
	end

	@ExecSpace("ServerOnly")
	@EventSender("Self")
	handler HandleHitEvent(HitEvent event)
		-- 몬스터의 공격(MonsterMeleeAttack·MonsterProjectile 이 소환수를 표적으로 허용)을 받는다. HP 가 0 이 되면 사라진다.
		if self._T.ready ~= true or self.Hp <= 0 then return end
		self.Hp = math.max(0, self.Hp - event.TotalDamage)
		local sprite = self.Entity.SpriteRendererComponent
		if isvalid(sprite) then
			sprite.Color = Color(1, 0.45, 0.45, 1)
			_TimerService:SetTimerOnce(function()
				if isvalid(self.Entity) and isvalid(self.Entity.SpriteRendererComponent) then self.Entity.SpriteRendererComponent.Color = self.BaseTint end
			end, 0.1)
		end
		if self.Hp <= 0 then self:Dismiss("down") end
	end

	@ExecSpace("ServerOnly")
	method void Heal(integer amount)
		-- 회복 오라·생명 펄스가 소환수도 회복한다.
		if self._T.ready ~= true or self.Hp <= 0 or amount <= 0 then return end
		self.Hp = math.min(self.MaxHp, self.Hp + amount)
	end

	@ExecSpace("ServerOnly")
	method void Dismiss(string reason)
		-- 사라짐: 수명 종료·주인 이탈/쓰러짐·HP 0·상한 초과로 교체. 한 번만 처리한다.
		if self._T.dismissed == true then return end
		self._T.dismissed = true
		self._T.ready = false
		log("[SUMMON] dismiss " .. tostring(self.SummonId) .. " reason=" .. reason)
		self.Entity:Destroy()
	end

	@ExecSpace("ServerOnly")
	method void MoveToward(Vector2 targetPos, number delta)
		local mc = self.Entity.MovementComponent
		if not isvalid(mc) then return end
		local myPos = self:Pos2D()
		local dx = targetPos.x - myPos.x
		local dy = targetPos.y - myPos.y
		local len = math.sqrt(dx * dx + dy * dy)
		if len <= 0.0001 then self:StopMove() return end
		mc:MoveToDirection(Vector2(dx / len, dy / len), delta)
		self._T.moving = true
	end

	@ExecSpace("ServerOnly")
	method void StopMove()
		local mc = self.Entity.MovementComponent
		if isvalid(mc) then mc:Stop() end
		self._T.moving = false
	end

	@ExecSpace("ServerOnly")
	method void Face(number dx)
		-- 공식 몬스터 스프라이트는 왼쪽을 본다 — 오른쪽으로 갈 때 뒤집는다.
		if math.abs(dx) < 0.05 then return end
		local sprite = self.Entity.SpriteRendererComponent
		if isvalid(sprite) then sprite.FlipX = dx > 0 end
	end

	@ExecSpace("ServerOnly")
	method void SetAnim(string kind)
		-- stand / move / attack 클립 교체(같은 클립이면 그대로). RUID 가 비면 모델 기본 스프라이트를 유지한다.
		if self._T.anim == kind then return end
		local ruid = self.StandRUID
		if kind == "move" then ruid = self.MoveRUID end
		if kind == "attack" then ruid = self.AttackRUID end
		if ruid == nil or ruid == "" then return end
		self._T.anim = kind
		local sprite = self.Entity.SpriteRendererComponent
		if not isvalid(sprite) then return end
		sprite.SpriteRUID = ruid
		sprite.PlayRate = 1
		sprite.StartFrameIndex = 0
		sprite.EndFrameIndex = 2147483647
	end

	@ExecSpace("ServerOnly")
	method Vector2 Pos2D()
		local p = self.Entity.TransformComponent.WorldPosition
		return Vector2(p.x, p.y)
	end

	@ExecSpace("ServerOnly")
	method Vector2 TargetCenter(Entity e)
		-- 표적의 피격 콜라이더 중심(오프셋 × Scale — pitfalls 규칙 14). 큰 몬스터도 몸통 쪽으로 다가간다.
		local p = e.TransformComponent.WorldPosition
		local hit = e.HitComponent
		if not isvalid(hit) then return Vector2(p.x, p.y) end
		local s = e.TransformComponent.Scale
		return Vector2(p.x + hit.ColliderOffset.x * math.abs(s.x), p.y + hit.ColliderOffset.y * math.abs(s.y))
	end

	@ExecSpace("ServerOnly")
	method number TargetRadius(Entity e)
		-- 표적 콜라이더 반폭(가로·세로 중 작은 쪽). 사거리를 몸통 가장자리 기준으로 잰다.
		local hit = e.HitComponent
		if not isvalid(hit) then return 0.4 end
		local s = e.TransformComponent.Scale
		return math.min(hit.BoxSize.x * math.abs(s.x), hit.BoxSize.y * math.abs(s.y)) * 0.5
	end

end

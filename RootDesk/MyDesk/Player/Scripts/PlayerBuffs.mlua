@Component
script PlayerBuffs extends Component

	-- T16: 세션 한정 버프. 로그아웃 시 소멸(영속 없음). StackRule=refresh 기본.

	@Sync
	property string ActiveBuffsJson = "[]"

	property number _tickAccum = 0.0

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		self.ActiveBuffsJson = "[]"
		self._tickAccum = 0.0
	end

	method void OnUpdate(number delta)
		-- 서버: 0.5초마다 만료 정리. 클라: 다른 플레이어 아바타에 버프·디버프 틴트를 칠한다
		-- (내 캐릭터는 PlayerController 의 깜빡임 처리부가 알파와 함께 칠한다 — 아바타 색은 쓰는 곳을 하나로 둔다).
		if self:IsServer() then
			self._tickAccum = self._tickAccum + delta
			if self._tickAccum < 0.5 then return end
			self._tickAccum = 0.0
			self:ExpireBuffs()
			return
		end
		self:UpdateRemoteTint(delta)
	end

	@ExecSpace("ClientOnly")
	method void UpdateRemoteTint(number delta)
		-- 다른 플레이어만 처리한다. 값이 바뀔 때만 SetColor 를 부른다.
		local lp = _UserService.LocalPlayer
		if isvalid(lp) and lp == self.Entity then return end
		self._T.TintAccum = (self._T.TintAccum or 0) + delta
		if self._T.TintAccum < 0.2 then return end
		self._T.TintAccum = 0
		local avatar = self.Entity.AvatarRendererComponent
		if not isvalid(avatar) then return end
		local t = self:GetVisualTint()
		local key = string.format("%.2f|%.2f|%.2f", t.r, t.g, t.b)
		if key == self._T.TintKey then return end
		self._T.TintKey = key
		avatar:SetColor(t.r, t.g, t.b, 1.0)
	end

	method any GetBuffMeta(string buffId)
		-- BuffDataSet 의 표시용 열(Description·IsDebuff·Tint)을 버프마다 한 번만 읽어 둔다.
		if self._T.BuffMeta == nil then self._T.BuffMeta = {} end
		local cached = self._T.BuffMeta[buffId]
		if cached ~= nil then return cached end
		local meta = { description = "", isDebuff = false, tint = nil }
		local ds = _DataService:GetTable("BuffDataSet")
		local row = ds ~= nil and ds:FindRow("BuffId", buffId) or nil
		if row ~= nil then
			local okD, d = pcall(function() return row:GetItem("Description") end)
			if okD and d ~= nil then meta.description = tostring(d) end
			local okB, b = pcall(function() return row:GetItem("IsDebuff") end)
			meta.isDebuff = okB and tostring(b or "") == "true"
			local okT, t = pcall(function() return row:GetItem("Tint") end)
			if okT and t ~= nil and tostring(t) ~= "" then
				local parts = {}
				for s in string.gmatch(tostring(t), "[^|]+") do parts[#parts + 1] = tonumber(s) or 1 end
				if #parts >= 3 then meta.tint = Color(parts[1], parts[2], parts[3], 1) end
			end
		end
		self._T.BuffMeta[buffId] = meta
		return meta
	end

	method Color GetVisualTint()
		-- 아바타 틴트: 디버프 틴트가 버프 틴트보다 먼저다. 둘 다 없으면 흰색(원래 색).
		-- 내 캐릭터는 매 프레임 묻는다 — 버프 목록과 초가 그대로면 지난 결과를 쓴다.
		local now = os.time()
		local cacheKey = tostring(self.ActiveBuffsJson) .. "@" .. tostring(now)
		if self._T.TintCacheKey == cacheKey and self._T.TintCache ~= nil then return self._T.TintCache end
		local result = self:ComputeVisualTint(now)
		self._T.TintCacheKey = cacheKey
		self._T.TintCache = result
		return result
	end

	method Color ComputeVisualTint(integer now)
		-- GetVisualTint 본체(캐시 미스일 때만).
		local buffTint = nil
		for _, b in ipairs(self:DecodeBuffs()) do
			if (tonumber(b.expireAt) or 0) > now then
				local meta = self:GetBuffMeta(tostring(b.buffId))
				if meta.tint ~= nil then
					if meta.isDebuff then return meta.tint end
					if buffTint == nil then buffTint = meta.tint end
				end
			end
		end
		if buffTint ~= nil then return buffTint end
		return Color(1, 1, 1, 1)
	end

	method table DecodeBuffs()
		local ok, list = pcall(function() return _HttpService:JSONDecode(self.ActiveBuffsJson or "[]") end)
		if ok and type(list) == "table" then return list end
		return {}
	end

	method void EncodeBuffs(table list)
		local ok, enc = pcall(function() return _HttpService:JSONEncode(list) end)
		if ok and enc ~= nil then
			self.ActiveBuffsJson = enc
		else
			self.ActiveBuffsJson = "[]"
		end
	end

	@ExecSpace("ServerOnly")
	method boolean ApplyBuff(string buffId)
		-- BuffDataSet 행 조회 후 적용/갱신. 성공 시 true.
		return self:ApplyBuffFor(buffId, 0)
	end

	@ExecSpace("ServerOnly")
	method boolean ApplyBuffFor(string buffId, number durationSeconds)
		-- ApplyBuff 와 같되 지속시간(초)을 덮어쓴다. 0 이하면 BuffDataSet.Duration 을 쓴다.
		-- 스킬 자가 강화(SkillDataSet.BuffIds)가 스킬 행의 Duration·지속시간 보너스를 실어 보낸다.
		if buffId == nil or buffId == "" then return false end
		local ds = _DataService:GetTable("BuffDataSet")
		if ds == nil then return false end
		local row = ds:FindRow("BuffId", buffId)
		if row == nil then return false end

		local duration = math.floor(tonumber(row:GetItem("Duration")) or 0)
		if durationSeconds ~= nil and durationSeconds > 0 then
			duration = math.max(1, math.floor(durationSeconds + 0.5))
		end
		if duration <= 0 then return false end
		local stackRule = row:GetItem("StackRule") or "refresh"
		local now = os.time()
		local expireAt = now + duration

		local list = self:DecodeBuffs()
		local found = false
		for _, b in ipairs(list) do
			if b.buffId == buffId then
				if stackRule == "ignore" then
					return false
				end
				-- refresh
				b.expireAt = expireAt
				b.duration = duration
				b.statKey = row:GetItem("StatKey") or ""
				b.modifierType = row:GetItem("ModifierType") or "add"
				b.value = tonumber(row:GetItem("Value")) or 0
				b.displayName = row:GetItem("DisplayName") or buffId
				b.iconRuid = row:GetItem("IconRUID") or ""
				found = true
				break
			end
		end
		if not found then
			table.insert(list, {
				buffId = buffId,
				expireAt = expireAt,
				duration = duration,
				statKey = row:GetItem("StatKey") or "",
				modifierType = row:GetItem("ModifierType") or "add",
				value = tonumber(row:GetItem("Value")) or 0,
				displayName = row:GetItem("DisplayName") or buffId,
				iconRuid = row:GetItem("IconRUID") or "",
			})
		end
		self:EncodeBuffs(list)
		log("[BUFF] apply " .. buffId .. " expire=" .. tostring(expireAt))
		return true
	end

	@ExecSpace("ServerOnly")
	method boolean RemoveBuff(string buffId)
		-- 지속시간과 무관하게 즉시 해제(보스 눈더미 장판처럼 "밟는 동안만" 걸리는 버프용). 해제했으면 true.
		if buffId == nil or buffId == "" then return false end
		local list = self:DecodeBuffs()
		local kept = {}
		local removed = false
		for _, b in ipairs(list) do
			if b.buffId == buffId then
				removed = true
			else
				table.insert(kept, b)
			end
		end
		if removed then
			self:EncodeBuffs(kept)
			log("[BUFF] remove " .. buffId)
		end
		return removed
	end

	@ExecSpace("ServerOnly")
	method boolean RemoveBuffsByStat(string statKey)
		-- 그 StatKey 를 주는 버프를 모두 즉시 해제한다(1회성 강타 준비처럼 "쓰면 사라지는" 버프용). 해제했으면 true.
		if statKey == nil or statKey == "" then return false end
		local list = self:DecodeBuffs()
		local kept = {}
		local removed = false
		for _, b in ipairs(list) do
			if b.statKey == statKey then
				removed = true
			else
				table.insert(kept, b)
			end
		end
		if removed then
			self:EncodeBuffs(kept)
			log("[BUFF] remove stat=" .. statKey)
		end
		return removed
	end

	@ExecSpace("ServerOnly")
	method void ExpireBuffs()
		local list = self:DecodeBuffs()
		if #list == 0 then return end
		local now = os.time()
		local kept = {}
		local changed = false
		for _, b in ipairs(list) do
			if (tonumber(b.expireAt) or 0) > now then
				table.insert(kept, b)
			else
				changed = true
				log("[BUFF] expired " .. tostring(b.buffId))
			end
		end
		if changed then
			self:EncodeBuffs(kept)
		end
	end

	method number GetStatModifier(string statKey)
		-- 소비처 API: add 합 + mult 곱을 결합해 최종 배율/가산 반환 규칙
		-- 반환 = 최종 곱셈 인자(mult 누적) 와 add 합은 분리 필요 → 두 API
		-- 편의: 이 메서드는 "실효 배율"만 — add는 GetStatAdd.
		return self:GetStatMult(statKey)
	end

	method number GetStatMult(string statKey)
		if statKey == nil or statKey == "" then return 1.0 end
		local list = self:DecodeBuffs()
		local now = os.time()
		local mult = 1.0
		for _, b in ipairs(list) do
			if b.statKey == statKey and (tonumber(b.expireAt) or 0) > now then
				if b.modifierType == "mult" then
					mult = mult * (tonumber(b.value) or 1.0)
				end
			end
		end
		return mult
	end

	method number GetStatAdd(string statKey)
		if statKey == nil or statKey == "" then return 0.0 end
		local list = self:DecodeBuffs()
		local now = os.time()
		local add = 0.0
		for _, b in ipairs(list) do
			if b.statKey == statKey and (tonumber(b.expireAt) or 0) > now then
				if b.modifierType == "add" then
					add = add + (tonumber(b.value) or 0.0)
				end
			end
		end
		return add
	end

	method table GetActiveBuffsForUI()
		-- 클라 HUD용: 만료 전 버프 목록. duration 은 쿨타임식 남은 시간 오버레이의 분모(구 세이브·구 데이터는 remain 으로 대체).
		local list = self:DecodeBuffs()
		local now = os.time()
		local out = {}
		for _, b in ipairs(list) do
			local exp = tonumber(b.expireAt) or 0
			if exp > now then
				local meta = self:GetBuffMeta(tostring(b.buffId))
				local remain = exp - now
				local duration = tonumber(b.duration) or remain
				if duration < remain then duration = remain end
				table.insert(out, {
					buffId = b.buffId,
					displayName = b.displayName or b.buffId,
					iconRuid = b.iconRuid or "",
					remain = remain,
					expireAt = exp,
					duration = duration,
					description = meta.description,
					isDebuff = meta.isDebuff,
				})
			end
		end
		return out
	end

end

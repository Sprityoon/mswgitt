@Component
script PlayerCombat extends AttackComponent
	-- Player melee attack against monsters. Driven on demand from PlayerController's Ctrl
	-- (mine/attack) flow: when a monster occupies the aimed cell, attack instead of mining.

	property integer BaseDamage = 8
	@HideFromInspector property string PendingSkillId = ""
	@HideFromInspector property string PendingTargetId = ""
	property number AttackBoxSize = 3.2
	@HideFromInspector property integer PendingDamage = 8
	-- T66: 스킬 피격 이펙트 RUID — AttackFast 직전 설정, HandleHitEvent에서 소비
	@HideFromInspector property string PendingHitEffectRUID = ""
	-- 피격 이펙트 배율. SkillDataSet.HitEffectScale 을 실어 나른다.
	-- ⚠ 원본 클립 크기가 스킬마다 4배 가까이 차이나므로(56x37 ~ 219x187) 배율 없이는
	--   타격감이 스킬마다 들쭉날쭉해진다. 1.0 = 원본 픽셀 그대로(100px = 1 월드 유닛).
	@HideFromInspector property number PendingHitEffectScale = 1.0

	@ExecSpace("ServerOnly")
	method void DoAttackAt(Vector2 worldPos)
		-- Emits a melee box at worldPos; only monster hitboxes (HitBox group) take damage.
		-- 평타 = CharAtk + 장착 Attack. ToolPower는 채집 전용.
		local dmg = self.BaseDamage
		local pc = self.Entity:GetComponent("script.PlayerController")
		if isvalid(pc) then
			---@type PlayerController
			local controller = pc
			dmg = controller:GetCharacterAttack()
		end
		local inv = self.Entity:GetComponent("script.PlayerInventory")
		if isvalid(inv) then
			---@type PlayerInventory
			local pi = inv
			local toolInfo = pi:GetEquippedToolInfo()
			if toolInfo ~= nil then
				dmg = dmg + (tonumber(toolInfo.attack) or 0)
			end
		end
		
		self.PendingSkillId = ""
		self.PendingTargetId = ""
		self.PendingDamage = dmg
		-- 도구 평타는 스킬 HitEffect를 쓰지 않는다. 투사체 스킬이 Pending을 비행 중 남겨 두면 Ctrl 평타에 붙는다.
		self.PendingHitEffectRUID = ""
		self.PendingHitEffectScale = 1.0
		local shape = BoxShape(worldPos, Vector2(self.AttackBoxSize, self.AttackBoxSize), 0)
		self:AttackFast(shape, nil, CollisionGroups.HitBox)
		log("[DMG] melee=" .. tostring(dmg))
	end

	@ExecSpace("ServerOnly")
	method void DoAttackInFront(Vector2 playerPos, number dirX, number dirY)
		-- 플레이어가 바라보는 방향 전방 범위 전체를 타격
		local dmg = self.BaseDamage
		local pc = self.Entity:GetComponent("script.PlayerController")
		if isvalid(pc) then
			---@type PlayerController
			local controller = pc
			dmg = controller:GetCharacterAttack()
		end
		local inv = self.Entity:GetComponent("script.PlayerInventory")
		if isvalid(inv) then
			---@type PlayerInventory
			local pi = inv
			local toolInfo = pi:GetEquippedToolInfo()
			if toolInfo ~= nil then
				dmg = dmg + (tonumber(toolInfo.attack) or 0)
			end
		end
		
		self.PendingSkillId = ""
		self.PendingTargetId = ""
		self.PendingDamage = dmg
		self.PendingHitEffectRUID = ""
		self.PendingHitEffectScale = 1.0

		-- 바라보는 방향으로 전방 1.5 지점에 너비 3.4 x 2.8 영역 타격
		local centerX = playerPos.x + dirX * 1.5
		local centerY = playerPos.y + dirY * 1.5
		local sizeX = (math.abs(dirX) > 0.1) and 3.4 or 2.8
		local sizeY = (math.abs(dirY) > 0.1) and 3.4 or 2.8
		
		local shape = BoxShape(Vector2(centerX, centerY), Vector2(sizeX, sizeY), 0)
		self:AttackFast(shape, nil, CollisionGroups.HitBox)
		log("[DMG] melee (front)=" .. tostring(dmg) .. " at (" .. centerX .. "," .. centerY .. ")")
	end

	method integer CalcDamage(Entity attacker, Entity defender, string attackInfo)
		-- Damage dealt to the struck monster (PendingDamage = CharAtk + Attack, or skill core).
		local monster = defender:GetComponent("script.Monster")
		if isvalid(monster) then return monster:ResolveSkillDamage(self.PendingDamage, self.PendingSkillId, attacker) end
		return self.PendingDamage
	end

	method boolean IsAttackTarget(Entity defender, string attackInfo)
		-- Exact target filtering prevents nearby monsters from receiving each pellet twice.
		if not isvalid(defender) then return false end
		if self.PendingTargetId ~= "" and defender.Id ~= self.PendingTargetId then return false end
		local pc = self.Entity:GetComponent("script.PlayerController")
		if isvalid(pc) and not pc:IsCombatSkillMap() then return false end
		local monster = defender:GetComponent("script.Monster")
		if isvalid(monster) and (monster.IsDead or monster.Hp <= 0) then return false end
		if isvalid(defender:GetComponent("script.Monster")) == false then return false end
		return __base:IsAttackTarget(defender, attackInfo)
	end


	@ExecSpace("ServerOnly")
	method void DealSkillHit(Entity target, integer damage, string skillId, string hitRUID, number hitScale)
		if not isvalid(target) then return end
		local oldDamage = self.PendingDamage
		local oldSkill = self.PendingSkillId
		local oldTarget = self.PendingTargetId
		local oldFx = self.PendingHitEffectRUID
		local oldScale = self.PendingHitEffectScale
		self.PendingDamage = damage
		self.PendingSkillId = skillId
		self.PendingTargetId = target.Id
		self.PendingHitEffectRUID = hitRUID
		self.PendingHitEffectScale = hitScale
		local p = target.TransformComponent.WorldPosition
		self:AttackFast(BoxShape(p:ToVector2(), Vector2(1, 1), 0), nil, CollisionGroups.HitBox)
		self.PendingDamage = oldDamage
		self.PendingSkillId = oldSkill
		self.PendingTargetId = oldTarget
		self.PendingHitEffectRUID = oldFx
		self.PendingHitEffectScale = oldScale
	end

end

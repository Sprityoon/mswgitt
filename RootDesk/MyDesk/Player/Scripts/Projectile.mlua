@Component
script Projectile extends Component
	property Entity Owner = nil
	property Vector2 Direction = Vector2(1, 0)
	property integer Damage = 0
	property number Speed = 6
	property number LifeTime = 2
	property number ElapsedTime = 0
	property string HitEffectRUID = ""
	property number HitEffectScale = 1
	property string SkillId = ""
	property number HitSize = 1.6
	property number VisualSize = 2
	property integer PierceCount = 1
	property number SplashSize = 0
	property number SplashMultiplier = 0
	property boolean ImpactOnly = false
	property boolean Grow = false

	method void Initialize(Entity owner, Vector2 dir, integer dmg, number speed, string hitEffectRUID)
		self.Owner = owner
		self.Direction = dir:Magnitude() > 0.0001 and dir:Normalize() or Vector2(1, 0)
		self.Damage = dmg
		self.Speed = speed
		self.ElapsedTime = 0
		self.HitEffectRUID = hitEffectRUID
		self._T.HitTargets = {}
		self._T.HitCount = 0
	end

	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
		if not isvalid(self.Owner) or self.Owner.CurrentMap ~= self.Entity.CurrentMap then self.Entity:Destroy() return end
		local pc = self.Owner:GetComponent("script.PlayerController")
		if not isvalid(pc) or pc.IsDead then self.Entity:Destroy() return end
		local transform = self.Entity.TransformComponent
		local body = self.Entity.KinematicbodyComponent
		if not isvalid(transform) or not isvalid(body) then self.Entity:Destroy() return end
		if self._T.HitTargets == nil then return end
		local travel = math.max(0, math.min(delta, self.LifeTime - self.ElapsedTime))
		self.ElapsedTime = self.ElapsedTime + delta
		local grow = self.Grow and math.min(1, self.ElapsedTime / math.max(0.1, self.LifeTime * 0.5)) or 1
		local size = self.Grow and (1 + (self.VisualSize - 1) * grow) or self.VisualSize
		transform.Scale = Vector3(size, size, 1)
		local hitSize = self.Grow and size or self.HitSize
		local steps = math.max(1, math.ceil(travel * self.Speed / math.max(0.25, hitSize * 0.4)))
		local sim = _CollisionService:GetSimulator(self.Entity)
		if sim == nil then self.Entity:Destroy() return end
		for step = 1, steps do
			local pos = transform.WorldPosition
			local nextPos = Vector2(pos.x + self.Direction.x * self.Speed * travel / steps, pos.y + self.Direction.y * self.Speed * travel / steps)
			if pc:IsWallAt(nextPos) then self:FinishImpact() return end
			body:SetWorldPosition(nextPos)
			for _, hitBox in pairs(sim:OverlapAll({CollisionGroups.HitBox}, BoxShape(nextPos, Vector2(hitSize, hitSize), 0))) do
				local target = hitBox.Entity
				if isvalid(target) and not self._T.HitTargets[target.Id] then
					local monster = target:GetComponent("script.Monster")
					if isvalid(monster) and not monster.IsDead and monster.Hp > 0 then
						self._T.HitTargets[target.Id] = true
						if not self.ImpactOnly then self:TriggerAttackOnTarget(target) end
						self._T.HitCount = self._T.HitCount + 1
						if self._T.HitCount >= self.PierceCount then self:FinishImpact() return end
					end
				end
			end
		end
		if self.ElapsedTime >= self.LifeTime then self:FinishImpact() end
	end

	@ExecSpace("ServerOnly")
	method void TriggerAttackOnTarget(Entity target)
		if not isvalid(self.Owner) then return end
		local combat = self.Owner:GetComponent("script.PlayerCombat")
		if not isvalid(combat) then return end
		combat:DealSkillHit(target, self.Damage, self.SkillId, self.HitEffectRUID, self.HitEffectScale)
	end

	@ExecSpace("ServerOnly")
	method void FinishImpact()
		if self._T.Finished then return end
		self._T.Finished = true
		if isvalid(self.Owner) and self.Owner.CurrentMap == self.Entity.CurrentMap and self.SplashSize > 0 then
			local pc = self.Owner:GetComponent("script.PlayerController")
			if isvalid(pc) and not pc.IsDead then
				local pos = self.Entity.TransformComponent.WorldPosition
				pc:DamageSkillArea(self.SkillId, pos, self.SplashSize, self.SplashMultiplier)
				if self.HitEffectRUID ~= "" then pc:MulticastPlayEffectEx(self.HitEffectRUID, pos, false, self.SplashSize * 0.5) end
			end
		end
		self.Entity:Destroy()
	end
end

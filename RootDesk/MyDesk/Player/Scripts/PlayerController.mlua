	@ExecSpace("Client")
	method void ClientStartRaidReturnCountdown(number seconds)
		-- 보스 클리어 시 서버가 그 방에 있던 각 클라에 건다. HUD 상단에 "마을 귀환까지 n초" 를 띄운다.
		-- ⚠ RPC 본문에 `---@type` 사용자 타입 주석 금지 (함정 규칙 53 — LEA-1118).
		local hud = _EntityService:GetEntityByPath("/ui/HUDGroup")
		if not isvalid(hud) then return end
		local controller = hud:GetComponent("script.UIHUDController")
		if isvalid(controller) then
			controller:StartRaidCountdown(seconds)
		end
	end

	@ExecSpace("Client")
	method void ClientOpenRaidDifficulty(string bossId)
		-- 대기실 게이트에서 F 를 누르면 서버(BossRaidLogic:OpenDifficultySelect)가 이 클라만 지목해 부른다.
		-- 난이도 선택 창은 순수 클라 UI 이므로 서버는 열라고만 하고 값 판정에는 관여하지 않는다.
		local popup = _EntityService:GetEntityByPath("/ui/PopupGroup/RaidDifficultyPopup")
		if not isvalid(popup) then
			log_warning("[RAID-UI] RaidDifficultyPopup missing")
			return
		end
		-- ⚠ 여기에 `---@type UIRaidDifficultyController` 를 달면 LEA-1118 빌드 에러가 난다.
		--   RPC(@ExecSpace) 메서드 본문의 사용자 스크립트 타입 주석은 이 프로젝트에서 금지다 (T19/T57 선례).
		--   대신 동적 디스패치로 부른다 — 남는 LIA-1114 Info 는 무해한 크로스 스크립트 노이즈다.
		local controller = popup:GetComponent("script.UIRaidDifficultyController")
		if isvalid(controller) then
			controller:OpenFor(bossId)
		else
			log_warning("[RAID-UI] UIRaidDifficultyController missing")
		end
	end

	@ExecSpace("Client")
	method void ClientSetCurrentMapPermissions(boolean canMine, boolean canPlace, boolean canInteract)
		self.CanMineOnCurrentMap = canMine
		self.CanPlaceOnCurrentMap = canPlace
		self.CanInteractOnCurrentMap = canInteract
		log("Permissions synced: mine=" .. tostring(canMine) .. ", place=" .. tostring(canPlace) .. ", interact=" .. tostring(canInteract))
	end

	-- T36: 이전 프레임 ResolveOverlaps 후 위치 (터널링 시 진입 면 판정용)
	property number OverlapSafeX = 0
	property number OverlapSafeY = 0
	property boolean OverlapSafeInit = false
	-- T36 재작업: 후보 수집 질의 반경 (해소 AABB와 분리 — 트리거 크기 의존 제거)
	property number OverlapQueryRadius = 2.5

	-- @ExecSpace 미지정: 클라 ResolveOverlaps와 서버 ExecuteDashSkill→IsObstacle 양쪽에서 호출.
	-- T99: ObstacleQuery 래퍼 — 시그니처·의미 불변.
	method boolean IsBlockingOverlapEntity(Entity entity)
		-- 데이터 주도 필터 위임.
		return _ObstacleQuery:IsBlockingOverlapEntity(self.Entity, entity)
	end

	method boolean GetColliderAABB(Entity entity, table outBox)
		-- Trigger/PhysicsCollider AABB 위임 (T82 조준·T36 충돌 공용).
		return _ObstacleQuery:GetColliderAABB(entity, outBox)
	end

	method number CirclePenetration(Vector2 p, number radius, table box)
		-- 원-AABB 침투 깊이 위임.
		return _ObstacleQuery:CirclePenetration(p, radius, box)
	end

	method Vector2 ResolveCircleAABB(number cx, number cy, number radius, table box, number startX, number startY)
		-- 원-AABB MTV 위임 (ExecSpace 미지정 — 순수 산식, 서버 몬스터 탈출과 공유).
		return _ObstacleQuery:ResolveCircleAABB(cx, cy, radius, box, startX, startY)
	end

	@ExecSpace("ClientOnly")
	method void ResolveOverlaps(number delta)
		-- T36: 원(r=0.3) 대 AABB 전량 해소. T99: MTV 합산은 ObstacleQuery, 적용/SafePos는 여기 유지.
		if self.IsDead then return end

		local body = self.Entity.KinematicbodyComponent
		local currentPos = nil
		if isvalid(body) then
			currentPos = body:GetWorldGroundPosition()
		else
			local transform = self.Entity.TransformComponent
			if isvalid(transform) then
				currentPos = transform.WorldPosition:ToVector2()
			end
		end
		if not currentPos then return end

		if not self.OverlapSafeInit then
			self.OverlapSafeX = currentPos.x
			self.OverlapSafeY = currentPos.y
			self.OverlapSafeInit = true
		end
		local startX = self.OverlapSafeX
		local startY = self.OverlapSafeY

		local r = 0.3
		local push = _ObstacleQuery:ComputeOverlapPush(self.Entity, currentPos, r, self.OverlapQueryRadius, startX, startY)
		local hit = push.x ~= 0 or push.y ~= 0

		if hit then
			local targetX = currentPos.x + push.x
			local targetY = currentPos.y + push.y
			-- currentPos를 body:GetWorldGroundPosition()에서 읽었으므로 쓰기도 body:SetWorldPosition으로
			-- 대칭화한다. transform.WorldPosition에 직접 쓰면 (1) Kinematicbody가 물리 스텝에서 되돌리며
			-- 싸우고 (2) 점프 중 transform.y에 실린 시각 오프셋을 지면 좌표로 덮어써 수직 스냅/순간이동이
			-- 발생한다. 지면 좌표계로 읽고-쓰면 점프 시각 오프셋을 건드리지 않는다.
			local body2 = self.Entity.KinematicbodyComponent
			if isvalid(body2) then
				body2:SetWorldPosition(Vector2(targetX, targetY))
			else
				local transform = self.Entity.TransformComponent
				if isvalid(transform) then
					transform.WorldPosition = Vector3(targetX, targetY, transform.WorldPosition.z)
				end
			end
			self.OverlapSafeX = targetX
			self.OverlapSafeY = targetY
		else
			self.OverlapSafeX = currentPos.x
			self.OverlapSafeY = currentPos.y
		end
	end

	method table EnsureEquipSlots(any decoded)
		-- 항상 길이 4 슬롯 배열로 정규화 (빈 값 = 미장착).
		local slots = { "", "", "", "" }
		if type(decoded) == "table" then
			for i = 1, 4 do
				local v = decoded[i]
				if v ~= nil then slots[i] = tostring(v) end
			end
		end
		return slots
	end

	method table GetEquippedSlots()
		-- EquippedSkillsJson → 길이 4 슬롯 테이블.
		local ok, decoded = pcall(function() return _HttpService:JSONDecode(self.EquippedSkillsJson) end)
		if not ok then return self:EnsureEquipSlots(nil) end
		return self:EnsureEquipSlots(decoded)
	end

	@ExecSpace("ServerOnly")
	method void RefundOrphanSkills()
		-- 지금 직업이 쓸 수 없는 직업 스킬(SkillDataSet.JobId 가 다른 직업)의 레벨을 지우고 SP 를 돌려준다.
		-- 공용 스킬을 직업 전용으로 옮겼을 때(2026-10-06 슬래시 블러스트 → 맨주먹 파이터) 이미 배운 캐릭터의 SP 가 묶이지 않게 하기 위함.
		-- 직업이 비어 있으면 건드리지 않는다 — 로드 순서상 RecoverJobFromQuests 로 직업이 복구되기 전일 수 있다.
		if self.JobId == nil or self.JobId == "" then return end
		local ds = _DataService:GetTable("SkillDataSet")
		if ds == nil then return end
		local ok, levels = pcall(function() return _HttpService:JSONDecode(self.SkillLevelsJson) end)
		if not ok or type(levels) ~= "table" then return end
		local refund = 0
		local removed = {}
		for i = 1, ds:GetRowCount() do
			local row = ds:FindRow("SkillId", ds:GetCell(i, "SkillId"))
			local job = self:SkillText(row, "JobId")
			if job ~= "" and job ~= self.JobId and self:SkillText(row, "JobVariantOf") == "" then
				local id = self:SkillText(row, "SkillId")
				local level = math.max(0, math.floor(tonumber(levels[id]) or 0))
				if level > 0 then
					refund = refund + level * math.max(0, math.floor(self:SkillNumber(row, "SPCost", 1)))
					levels[id] = nil
					removed[#removed + 1] = id
				end
			end
		end
		if #removed == 0 then return end
		self.SkillLevelsJson = _HttpService:JSONEncode(levels)
		self.SP = self.SP + refund
		local player = self.Entity.PlayerComponent
		if player ~= nil and _PersistenceManager ~= nil then _PersistenceManager:MarkPlayerDirty(player.UserId) end
		log("[SKILL] refund orphan skills job=" .. tostring(self.JobId) .. " ids=" .. table.concat(removed, ",") .. " sp=" .. tostring(refund))
	end

	@ExecSpace("ServerOnly")
	method void SanitizeEquippedSkills()
		-- T45⑥: 로드 시 미해금·패시브·중복 장착 정리. 세이브 경로 무변경.
		-- 다른 직업 전용이 된 스킬은 먼저 환급한다(장착 정리가 그 결과를 보고 슬롯을 비운다).
		self:RefundOrphanSkills()
		local slots = self:GetEquippedSlots()
		local seen = {}
		local changed = false
		for i = 1, 4 do
			local sid = slots[i]
			if sid ~= nil and sid ~= "" then
				local level = self:GetSkillLevel(sid)
				local drop = false
				if level < 1 then
					drop = true
				else
					local ds = _DataService:GetTable("SkillDataSet")
					if ds ~= nil then
						local row = ds:FindRow("SkillId", sid)
						if row == nil or not self:IsSkillJobAllowed(row) or (row:GetItem("Type") or "") == "Passive" then
							drop = true
						end
					end
					if seen[sid] then drop = true end
				end
				if drop then
					slots[i] = ""
					changed = true
				else
					seen[sid] = true
				end
			end
		end
		if changed then
			self.EquippedSkillsJson = _HttpService:JSONEncode(slots)
			log("[SKILL] SanitizeEquippedSkills filtered unequipped/passive/dupes")
		else
			-- 기본 "[]" 등을 4슬롯 형태로 정규화
			local ok, raw = pcall(function() return _HttpService:JSONDecode(self.EquippedSkillsJson) end)
			if not ok or type(raw) ~= "table" or #raw ~= 4 then
				self.EquippedSkillsJson = _HttpService:JSONEncode(slots)
			end
		end
	end

	@ExecSpace("ServerOnly")
	method void TryAutoEquipOnUnlock(string skillId)
		-- T45④: 해금(0→1) 시 빈 슬롯이 있을 때만 자동 장착. 패시브 제외.
		if skillId == nil or skillId == "" then return end
		if self:GetSkillLevel(skillId) < 1 then return end
		local ds = _DataService:GetTable("SkillDataSet")
		if ds == nil then return end
		local row = ds:FindRow("SkillId", skillId)
		if row == nil then return end
		if not self:IsSkillJobAllowed(row) then return end
		if (row:GetItem("Type") or "") == "Passive" then return end

		local slots = self:GetEquippedSlots()
		for i = 1, 4 do
			if slots[i] == skillId then return end
		end
		for i = 1, 4 do
			if slots[i] == nil or slots[i] == "" then
				slots[i] = skillId
				self.EquippedSkillsJson = _HttpService:JSONEncode(slots)
				log("[SKILL] AutoEquip unlock " .. skillId .. " -> slot " .. tostring(i))
				return
			end
		end
		log("[SKILL] AutoEquip skipped (no empty slot) " .. skillId)
	end

	@ExecSpace("Server")
	method void ServerRequestEquipSkill(integer slotIndex, string skillId)
		-- T45②: 슬롯 장착/해제 RPC. skillId 빈 문자열=해제. 미해금·패시브 거부, 중복 시 스왑.
		local playerComp = self.Entity.PlayerComponent
		if playerComp == nil or senderUserId ~= playerComp.UserId then return end
		if slotIndex < 1 or slotIndex > 4 then return end

		local slots = self:GetEquippedSlots()
		local sid = skillId or ""

		if sid == "" then
			slots[slotIndex] = ""
			self.EquippedSkillsJson = _HttpService:JSONEncode(slots)
			if _PersistenceManager then
				_PersistenceManager:MarkPlayerDirty(playerComp.UserId)
			end
			log("[SKILL] Unequip slot " .. tostring(slotIndex))
			return
		end

		if self:GetSkillLevel(sid) < 1 then
			self:ClientShowMineFeedback("아직 해금하지 않은 스킬입니다.", playerComp.UserId)
			return
		end

		local ds = _DataService:GetTable("SkillDataSet")
		if ds == nil then return end
		local row = ds:FindRow("SkillId", sid)
		if row == nil then return end
		if not self:IsSkillJobAllowed(row) then return end
		if (row:GetItem("Type") or "") == "Passive" then
			self:ClientShowMineFeedback("패시브 스킬은 장착할 수 없습니다.", playerComp.UserId)
			return
		end

		-- 이미 다른 슬롯에 있으면 스왑 (그 슬롯 ↔ 대상 슬롯)
		local other = 0
		for i = 1, 4 do
			if i ~= slotIndex and slots[i] == sid then
				other = i
				break
			end
		end
		if other > 0 then
			local prev = slots[slotIndex]
			slots[slotIndex] = sid
			slots[other] = prev
		else
			slots[slotIndex] = sid
		end
		self.EquippedSkillsJson = _HttpService:JSONEncode(slots)
		if _PersistenceManager then
			_PersistenceManager:MarkPlayerDirty(playerComp.UserId)
		end
		local sname = row:GetItem("Name") or sid
		local keys = { "Q", "W", "E", "R" }
		self:ClientShowMineFeedback("[" .. (keys[slotIndex] or "?") .. "] " .. tostring(sname) .. " 장착", playerComp.UserId)
		log("[SKILL] Equip " .. sid .. " slot=" .. tostring(slotIndex))
	end

	@ExecSpace("ClientOnly")
	method void TryCastSlot(integer slotIndex)
		-- Resolve the skill bound to slotIndex, do a client-side cooldown/stamina precheck, then RPC.
		if self.IsDead then return end
		if self:IsChanneling() then
			log("[SKILL] channeling — cast ignored slot=" .. tostring(slotIndex))
			return
		end
		
		local skills = self:GetEquippedSlots()
		if slotIndex < 1 or slotIndex > 4 then return end
		
		local skillId = skills[slotIndex]
		if not skillId or skillId == "" then return end
		
		local ds = _DataService:GetTable("SkillDataSet")
		if not ds then return end
		local row = ds:FindRow("SkillId", skillId)
		if not row then return end
		if not self:IsSkillJobAllowed(row) then return end
		if self.Mana < self:SkillNumber(row, "ManaCost", 0) then
			self:ShowMineFeedback("MP가 부족합니다.")
			return
		end
		
		local level = self:GetSkillLevel(skillId)
		if level < 1 then
			log("[SKILL] Not unlocked: " .. skillId)
			return
		end
		
		local cd = self:GetEffectiveCooldown(skillId, level)
		local cost = tonumber(row:GetItem("StaminaCost")) or 0
		if (row:GetItem("Type") or "") == "Passive" then return end
		
		if not self.CooldownMap then self.CooldownMap = {} end
		local now = _UtilLogic.ElapsedSeconds
		local lastCast = self.CooldownMap[skillId] or -999.0
		if now - lastCast < cd then
			log("[SKILL] Client cooldown active for " .. skillId)
			return
		end
		if self.Stamina < cost then
			log("[SKILL] Client stamina low for " .. skillId)
			return
		end
		if not self:IsSkillEquipRequirementMet(row) then
			return
		end
		if not self:ConsumeSkillItemIfNeeded(row, false) then
			return
		end
		
		log("[SKILL] Requesting cast " .. skillId .. " (slot " .. slotIndex .. ") dir " .. self.LastDirectionX .. "," .. self.LastDirectionY)
		-- 스킬을 쓰면 충전 중이던 평타 충전은 버린다 (사전 검사를 모두 통과해 실제로 시전하는 경우에만).
		self:CancelCharge()
		self:ServerRequestCastSkill(skillId, self.LastDirectionX, self.LastDirectionY)
	end

	@ExecSpace("Server")
	method void ServerRequestCastSkill(string skillId, integer dirX, integer dirY)
		-- Authoritative validation: verify sender, cooldown, stamina; then branch by skill Type.
		local playerComp = self.Entity.PlayerComponent
		if playerComp == nil or senderUserId ~= playerComp.UserId then return end
		if self.IsDead or self.IsSleeping or self.FishingState ~= "None" then return end
		-- 회전 채널(SkillDataSet.Channel) 중에는 다른 스킬을 받지 않는다.
		if self:IsChanneling() then return end
		-- 방향은 서버 기준 4방향 값만 사용한다. 큰 클라이언트 벡터로 원거리 시전할 수 없게 한다.
		if math.abs(dirX) >= math.abs(dirY) and dirX ~= 0 then
			dirX = dirX > 0 and 1 or -1
			dirY = 0
		elseif dirY ~= 0 then
			dirX = 0
			dirY = dirY > 0 and 1 or -1
		else
			dirX = self.LastDirectionX
			dirY = self.LastDirectionY
		end
		
		local ds = _DataService:GetTable("SkillDataSet")
		if not ds then return end
		local row = ds:FindRow("SkillId", skillId)
		if not row then return end
		if not self:IsSkillJobAllowed(row) then return end
		local equipped = false
		for _, sid in ipairs(self:GetEquippedSlots()) do if sid == skillId then equipped = true end end
		if not equipped then return end
		
		local level = self:GetSkillLevel(skillId)
		if level < 1 then return end
		
		local cd = self:GetEffectiveCooldown(skillId, level)
		local cost = tonumber(row:GetItem("StaminaCost")) or 0
		-- 직업 변형(SkillDataSet.JobVariantOf): 레벨·쿨다운·비용·슬롯은 원본 스킬, 전투 데이터(타입·배율·상태이상·이펙트)는 변형 행.
		local castId = skillId
		local castRow = row
		local variantRow = self:GetJobVariantRow(skillId)
		if variantRow ~= nil then
			castId = self:SkillText(variantRow, "SkillId")
			castRow = variantRow
			log("[SKILL] job variant " .. skillId .. " -> " .. castId)
		end
		local damageMul = self:GetEffectiveDamageMultiplier(castId, level)
		local skillType = castRow:GetItem("Type")
		local effectRUID = castRow:GetItem("EffectRUID")
		if (skillType or "") == "Passive" then return end
		local supported = { Melee = true, Ultimate = true, Dash = true, Projectile = true, Trap = true, Field = true, Guard = true, HealAura = true, Buff = true, Summon = true }
		if not supported[skillType] then return end
		if skillType ~= "HealAura" and skillType ~= "Guard" and skillType ~= "Dash" and skillType ~= "Buff" and not self:IsCombatSkillMap() then return end
		if skillType == "Projectile" then
			local modelId = _EntryService:GetModelIdByName("Projectile_Fireball")
			if modelId == nil or modelId == "" then return end
		end
		local manaCost = self:SkillNumber(row, "ManaCost", 0)
		if self.Mana < manaCost then return end
		
		if not self.CooldownMap then self.CooldownMap = {} end
		local now = _UtilLogic.ElapsedSeconds
		local lastCast = self.CooldownMap[skillId] or -999.0
		if now - lastCast < cd then return end
		if self.Stamina < cost then return end
		if not self:IsSkillEquipRequirementMet(row) then return end
		-- 소모 아이템은 스태미나/쿨다운보다 먼저 검사·차감한다. 실패해도 자원이 깎이지 않게.
		if not self:ConsumeSkillItemIfNeeded(row, true) then return end
		
		self.Stamina = math.max(0, self.Stamina - cost)
		self.Mana = math.max(0, self.Mana - manaCost)
		self.CooldownMap[skillId] = now
		self:ClientSyncCooldown(skillId, now)

		-- 확정 치명 예약(NextCrit 버프 — 그림자 걸음): 피해 스킬을 시전하면 버프를 소모하고 이 시전의 타격 창 동안 모든 타격을 치명으로 만든다.
		-- 창 = 지연 착탄 + 장판 지속 / 투사체 비행 시간 + 0.5초. 이 시전이 버프를 주는 스킬이어도 버프는 아래 ApplySkillBuffs 에서 걸리므로 자기 자신에게는 쓰이지 않는다.
		-- 소환은 제외한다 — 소환수 공격에는 치명이 없고, 창이 소환 지속시간(수십 초)만큼 늘어나 버린다.
		if self:IsDamageSkillRow(castRow) and skillType ~= "Summon" then
			local buffsCrit = self.Entity:GetComponent("script.PlayerBuffs")
			if isvalid(buffsCrit) and buffsCrit:GetStatAdd("NextCrit") > 0 then
				buffsCrit:RemoveBuffsByStat("NextCrit")
				local window = self:SkillNumber(castRow, "ArmDelay", 0) + self:SkillNumber(castRow, "Duration", 0)
				if skillType == "Projectile" then window = self:SkillNumber(castRow, "ProjectileLife", 2) end
				self._T.ForcedCrit = { skillId = castId, untilAt = now + math.max(0.5, window) + 0.5 }
				log("[CRIT] forced crit reserved skill=" .. castId .. " window=" .. string.format("%.2f", math.max(0.5, window) + 0.5))
			end
		end

		-- T70: 시전 모션 (CastAction CSV — MineState ActionStateChangedEvent 미러). 공란=생략.
		local castAction = self:SkillText(castRow, "CastAction")
		if castAction ~= "" then
			self:MulticastPlayCastAction(castAction)
			log("[T70][CAST] skill=" .. castId .. " action=" .. castAction)
		end

		-- 채널 스킬(SkillDataSet.Channel): Duration 동안 다른 스킬·평타를 막는다. spin = 클라에서 회전 연출까지.
		local channel = self:SkillText(castRow, "Channel")
		local channelSeconds = self:SkillNumber(castRow, "Duration", 0)
		if channel ~= "" and channelSeconds > 0 then
			self._T.ChannelUntil = now + channelSeconds
			self:MulticastBeginChannel(channel, channelSeconds, castAction)
			log("[CHANNEL] " .. castId .. " mode=" .. channel .. " " .. tostring(channelSeconds) .. "s")
		end

		-- T66: 피격 이펙트 RUID를 AttackFast 경로가 소비할 수 있게 선설정
		local hitEffectRUID = self:SkillText(castRow, "HitEffectRUID")
		-- 피격 이펙트 배율(신규 컬럼). 공란이면 1.0 = 원본 크기.
		-- 시전 이펙트의 EffectScale 과는 별개다 — 원본 클립 크기가 스킬마다 크게 달라
		-- 하나의 배율로는 시전/피격 양쪽을 동시에 맞출 수 없다.
		local hitEffectScale = self:SkillNumber(castRow, "HitEffectScale", 1.0)
		local combatForHit = self.Entity:GetComponent("script.PlayerCombat")
		if isvalid(combatForHit) then
			---@type PlayerCombat
			local ch = combatForHit
			ch.PendingHitEffectRUID = hitEffectRUID or ""
			ch.PendingHitEffectScale = hitEffectScale
			ch.PendingSkillId = castId
		end

		-- 시전 순간의 위치 (돌진처럼 시전 중 위치가 바뀌는 스킬의 EffectAnchor=start 이펙트용).
		local castStartPos = self.Entity.TransformComponent.WorldPosition
		if skillType == "Melee" then
			-- 판정 상자: 앞쪽 길이 AreaSize × 좌우 폭 AreaWidth(공란 = AreaSize, 정사각), 중심은 시전자 앞 AreaReach.
			local meleeLength = self:SkillNumber(castRow, "AreaSize", 3)
			self:ExecuteAreaDamageSkill(castId, damageMul, Vector2(dirX, dirY), meleeLength, self:SkillNumber(castRow, "AreaReach", 1.6), self:SkillNumber(castRow, "AreaWidth", meleeLength))
		elseif skillType == "Ultimate" then
			local ultimateSize = self:SkillNumber(castRow, "AreaSize", 8)
			self:ExecuteAreaDamageSkill(castId, damageMul, Vector2(0, 0), ultimateSize, 0.0, ultimateSize)
		elseif skillType == "Dash" then
			self:ExecuteDashSkill(castId, dirX, dirY, damageMul)
		elseif skillType == "Projectile" then
			self:ExecuteProjectileSkill(castId, damageMul, dirX, dirY, hitEffectRUID, hitEffectScale)
		elseif skillType == "Guard" then
			self:StartGuard(castRow, damageMul)
		elseif skillType == "Buff" then
			-- 자가 강화는 BuffIds 가 맡는다(아래 ApplySkillBuffs). 도발·아군 버프·몬스터 약화 같은 범위 효과는 행의 열이 있을 때만.
			self:ExecuteBuffSkill(castId, castRow)
		elseif skillType == "Summon" then
			self:ExecuteSummonSkill(castId, castRow)
		else
			self:CreateSkillArea(castId, dirX, dirY)
		end
		-- 스킬 행의 BuffIds(자가 강화·강타 준비 등)와, 이 스킬에 딸린 패시브(Trigger=OnParentCast)를 건다.
		self:ApplySkillBuffs(castRow)
		self:FireSkillTriggers("OnParentCast", skillId)

		if isvalid(combatForHit) then
			---@type PlayerCombat
			local ch2 = combatForHit
			-- 투사체는 탄환 자신의 HitEffectRUID를 쓴다. Pending을 남기면 도구 평타에 스킬 FX가 붙는다.
			ch2.PendingHitEffectRUID = ""
			ch2.PendingHitEffectScale = 1.0
			ch2.PendingSkillId = ""
		end
		
		-- 지연 착탄 장판(Field + ArmDelay > 0)은 시전 순간 이펙트를 생략한다 — 예고 원이 깔리고 착탄 때 TickSkillAreas 가 같은 이펙트를 터뜨린다.
		-- (시전 순간에 터지면 "피하면 안 맞는" 예고가 망가진다. 모루 낙하·불씨 결정·붉은 너클의 일격 등)
		local delayedField = skillType == "Field" and self:SkillNumber(castRow, "ArmDelay", 0) > 0
		if effectRUID ~= nil and effectRUID ~= "" and not delayedField then
			-- T66: 전방 오프셋 + 좌우 플립 (CSV EffectOffset/EffectScale 또는 프로퍼티 폴백)
			local offset = self:SkillNumber(castRow, "EffectOffset", self.SkillEffectForwardOffset)
			local scale = self:SkillNumber(castRow, "EffectScale", self.SkillEffectScale)
			-- EffectAnchor: 공란 = 시전 뒤 현재 위치, start = 시전 순간 위치(돌진 출발점에서 팡), follow = 시전자에 붙어 따라다님.
			local fxAnchor = self:SkillText(castRow, "EffectAnchor")
			local myPos = self.Entity.TransformComponent.WorldPosition
			if fxAnchor == "start" then myPos = castStartPos end
			local fxHeight = self:GetSkillEffectHeight(castRow, dirX)
			local fxPos = Vector3(myPos.x + dirX * offset, myPos.y + dirY * offset + fxHeight, myPos.z)
			-- EffectFacing: 원본 그림이 보는 방향(공란·left = 왼쪽, right = 오른쪽). 지정된 방향성 이펙트는 위·아래 시전 때 세워서 튼다.
			local fxFlip = self:IsSkillEffectFlipX(castRow, dirX)
			local fxRot = self:GetSkillEffectRotation(castRow, dirX, dirY)
			-- EffectPlayRate(공란 1) · EffectEndFrame(공란 = 끝까지): 긴 루프형 클립을 짧게 끊어 "팡" 하고 끝나게 한다.
			local fxRate = self:SkillNumber(castRow, "EffectPlayRate", 1)
			local fxEnd = math.floor(self:SkillNumber(castRow, "EffectEndFrame", -1))
			if fxAnchor == "follow" then
				self:MulticastPlayEffectFollow(effectRUID, fxFlip, scale, fxHeight, fxRate, fxEnd)
			else
				self:MulticastPlayEffectDir(effectRUID, fxPos, fxFlip, scale, fxRot, fxRate, fxEnd)
			end
			log("[T66][FX] cast skill=" .. castId .. " ruid=" .. tostring(effectRUID) .. " anchor=" .. fxAnchor .. " offset=" .. tostring(offset) .. " flip=" .. tostring(fxFlip) .. " rot=" .. tostring(fxRot))
		end
		-- T46: SoundRUID 시전 사운드 (데이터 주도)
		local soundRUID = castRow:GetItem("SoundRUID")
		if soundRUID ~= nil and soundRUID ~= "" then
			self:MulticastPlaySkillSound(soundRUID)
		end
	end

	@ExecSpace("Client")
	method void ClientSyncCooldown(string skillId, number serverTime)
		-- The server confirmed the cast; stamp the cooldown using the CLIENT clock so the local
		-- precheck and the HUD cooldown readout (UISkillBarController) both count down on one timebase
		-- (server/client ElapsedSeconds are not synchronized, so the raw serverTime is not used here).
		if not self.CooldownMap then self.CooldownMap = {} end
		self.CooldownMap[skillId] = _UtilLogic.ElapsedSeconds
	end

	-- =========================================================================
	-- SKILL TREE (S2) — 해금/레벨업 상태, SP, 서버 검증 (docs/design/skill-tree-plan.md)
	-- =========================================================================

	method integer GetSkillLevel(string skillId)
		-- SkillLevelsJson에서 보유 레벨 조회 (0 = 미해금). @Sync 프로퍼티라 서버/클라 공용.
		if skillId == nil or skillId == "" then return 0 end
		local ok, levels = pcall(function() return _HttpService:JSONDecode(self.SkillLevelsJson) end)
		if not ok or levels == nil then return 0 end
		return tonumber(levels[skillId]) or 0
	end

	method number GetEffectiveDamageMultiplier(string skillId, integer level)
		-- 실효 배율 = DamageMultiplier + DamagePerLevel × (level-1)
		local ds = _DataService:GetTable("SkillDataSet")
		if not ds then return 1.0 end
		local row = ds:FindRow("SkillId", skillId)
		if not row then return 1.0 end
		local base = tonumber(row:GetItem("DamageMultiplier")) or 1.0
		if level < 1 then return base end
		local perLevel = tonumber(row:GetItem("DamagePerLevel")) or 0.0
		return base + perLevel * (level - 1)
	end

	method number GetEffectiveCooldown(string skillId, integer level)
		-- 실효 쿨다운 = Cooldown + CooldownPerLevel × (level-1), 하한 0.1초
		local ds = _DataService:GetTable("SkillDataSet")
		if not ds then return 0.0 end
		local row = ds:FindRow("SkillId", skillId)
		if not row then return 0.0 end
		local base = tonumber(row:GetItem("Cooldown")) or 0.0
		-- 패시브 CooldownPct(맨주먹 파이터 삼위일체의 극의 등): 재사용 대기시간 비율 감소, 최대 50%.
		local cdScale = 1 - math.min(0.5, math.max(0, self:GetPassiveBonus("CooldownPct")))
		if level < 1 then return base * cdScale end
		local perLevel = tonumber(row:GetItem("CooldownPerLevel")) or 0.0
		return math.max(0.1, (base + perLevel * (level - 1)) * cdScale)
	end

	method number GetPassiveBonus(string statName)
		-- 배운 패시브의 PassiveStat/PassiveStat2 합. 직업 변형 행(JobVariantOf)은 원본 스킬 레벨로 세고,
		-- 변형이 있는 직업이면 원본 행은 세지 않는다(예: 맨주먹 파이터의 회복 → 불굴의 투혼).
		-- 스킬바가 0.04초마다 쿨다운(→ CooldownPct)을 묻는다. 스킬 레벨·직업이 그대로면 캐시를 쓴다.
		local cacheKey = tostring(self.SkillLevelsJson) .. "|" .. tostring(self.JobId)
		local cache = self._T.PassiveCache
		if cache == nil or cache.key ~= cacheKey then
			cache = { key = cacheKey, values = {} }
			self._T.PassiveCache = cache
		end
		local cached = cache.values[statName]
		if cached ~= nil then return cached + self:GetGearPerk(statName) end
		local total = 0
		local ds = _DataService:GetTable("SkillDataSet")
		if ds == nil then return self:GetGearPerk(statName) end
		local rows = {}
		local replaced = {}
		for i = 1, ds:GetRowCount() do
			local row = ds:FindRow("SkillId", ds:GetCell(i, "SkillId"))
			if row ~= nil and self:IsSkillJobAllowed(row) then
				rows[#rows + 1] = row
				local baseOf = self:SkillText(row, "JobVariantOf")
				if baseOf ~= "" and self.JobId ~= "" then replaced[baseOf] = true end
			end
		end
		for _, row in ipairs(rows) do
			local skillId = self:SkillText(row, "SkillId")
			if not replaced[skillId] then
				local level = self:GetEffectiveSkillLevel(row)
				if level >= 1 then
					if self:SkillText(row, "PassiveStat") == statName then total = total + self:SkillNumber(row, "PassiveValuePerLevel", 0) * level end
					if self:SkillText(row, "PassiveStat2") == statName then total = total + self:SkillNumber(row, "PassiveValue2", 0) * level end
				end
			end
		end
		cache.values[statName] = total
		return total + self:GetGearPerk(statName)
	end

	method number GetGearPerk(string statName)
		-- 장착 장비 고유 효과(item_dataset.PerkStat / PerkValue) 합. 패시브와 같은 소비처(GetPassiveBonus)로 흘러간다.
		-- 스킬바가 0.04초마다 쿨다운(→ CooldownPct)을 물으므로 슬롯 합산은 0.5초 캐시.
		local now = _UtilLogic.ElapsedSeconds
		local cache = self._T.GearPerkCache
		if cache == nil or now - cache.at > 0.5 then
			cache = { at = now, values = {} }
			local pi = self.Entity:GetComponent("script.PlayerInventory")
			local ds = _DataService:GetTable("item_dataset")
			if isvalid(pi) and ds ~= nil then
				---@type PlayerInventory
				local p = pi
				for _, slot in ipairs(p:GetGearSlotOrder()) do
					local key = p:GetGearKey(slot)
					if key ~= "" then
						local row = ds:FindRow("Name", p:GetBaseItemName(key))
						local stat = self:SkillText(row, "PerkStat")
						if stat ~= "" then
							cache.values[stat] = (cache.values[stat] or 0) + self:SkillNumber(row, "PerkValue", 0)
						end
						-- 대장간 주문 부여 슬롯 (PlayerInventory.EnhanceJson)
						for _, e in pairs(p:GetEnhanceData(key).slots) do
							if e.stat ~= nil and e.stat ~= "" then
								cache.values[e.stat] = (cache.values[e.stat] or 0) + (tonumber(e.val) or 0)
							end
						end
					end
				end
			end
			self._T.GearPerkCache = cache
		end
		return cache.values[statName] or 0
	end

	method integer GetEffectiveSkillLevel(any row)
		-- 스킬 행의 실효 레벨. 직업 변형 행은 원본 스킬(JobVariantOf)의 레벨을 쓴다.
		if row == nil then return 0 end
		local baseOf = self:SkillText(row, "JobVariantOf")
		if baseOf ~= "" then return self:GetSkillLevel(baseOf) end
		return self:GetSkillLevel(self:SkillText(row, "SkillId"))
	end

	method any GetJobVariantRow(string baseSkillId)
		-- 현재 직업 전용으로 baseSkillId 를 대체하는 행(SkillDataSet.JobVariantOf). 없으면 nil. (규칙 23: 반환 any)
		if baseSkillId == nil or baseSkillId == "" or self.JobId == "" then return nil end
		-- 스킬바가 0.04초마다 아이콘을 묻는다 — 직업이 그대로면 {원본 id → 변형 행} 캐시를 쓴다.
		local cache = self._T.VariantCache
		if cache == nil or cache.job ~= self.JobId then
			cache = { job = self.JobId, map = {} }
			local ds = _DataService:GetTable("SkillDataSet")
			if ds ~= nil then
				for i = 1, ds:GetRowCount() do
					local row = ds:FindRow("SkillId", ds:GetCell(i, "SkillId"))
					local baseOf = self:SkillText(row, "JobVariantOf")
					if row ~= nil and baseOf ~= "" and self:SkillText(row, "JobId") == self.JobId then
						cache.map[baseOf] = row
					end
				end
			end
			self._T.VariantCache = cache
		end
		return cache.map[baseSkillId]
	end

	method string GetSkillIconRUID(string skillId)
		-- 스킬창·스킬바에 보일 아이콘: 현재 직업의 변형 행이 있으면 그 아이콘, 없으면 원본 행 아이콘.
		local variantRow = self:GetJobVariantRow(skillId)
		if variantRow ~= nil then
			local icon = self:SkillText(variantRow, "IconRUID")
			if icon ~= "" then return icon end
		end
		local ds = _DataService:GetTable("SkillDataSet")
		if ds == nil then return "" end
		return self:SkillText(ds:FindRow("SkillId", skillId), "IconRUID")
	end

	method number GetBuffDurationScale()
		-- 자가 강화 지속시간 배율 = 1 + 패시브 BuffDurationPct × 삼위일체 균형도.
		local pct = self:GetPassiveBonus("BuffDurationPct")
		if pct <= 0 then return 1.0 end
		return 1.0 + pct * self:GetTrinityBalance()
	end

	@ExecSpace("ServerOnly")
	method void ApplySkillBuffs(any row)
		-- 스킬 행의 BuffIds("a|b") 를 건다. 지속시간 = 행 Duration(공란이면 BuffDataSet 기본) × 지속시간 배율.
		local ids = self:SkillText(row, "BuffIds")
		if ids == "" then return end
		local buffs = self.Entity:GetComponent("script.PlayerBuffs")
		if not isvalid(buffs) then return end
		local duration = self:SkillNumber(row, "Duration", 0)
		if duration > 0 then duration = duration * self:GetBuffDurationScale() end
		local buffDs = _DataService:GetTable("BuffDataSet")
		for _, buffId in ipairs(self:SplitList(ids, "|")) do
			if buffId ~= "" then
				-- 슈퍼아머는 초 단위 정밀 창도 함께 연다: 버프 만료는 os.time(정수 초)이라 1초 남짓한 시전 슈퍼아머(쇠망치 회전·그림자 난도)가 0초로 끝날 수 있다.
				local buffRow = buffDs ~= nil and buffDs:FindRow("BuffId", buffId) or nil
				if duration > 0 and self:SkillText(buffRow, "StatKey") == "SuperArmor" then
					self._T.SuperArmorUntil = math.max(tonumber(self._T.SuperArmorUntil) or 0, _UtilLogic.ElapsedSeconds + duration)
				end
				local ok = buffs:ApplyBuffFor(buffId, duration)
				log("[SKILL-BUFF] " .. self:SkillText(row, "SkillId") .. " -> " .. buffId .. " ok=" .. tostring(ok) .. " dur=" .. string.format("%.1f", duration))
			end
		end
	end

	@ExecSpace("ServerOnly")
	method void StartGuard(any row, number reflection)
		-- 피해 감소·반사 창 (Type=Guard 시전 / Trigger=OnHit 자동 발동 공용). 지속시간에 자가 강화 배율을 적용한다.
		local now = _UtilLogic.ElapsedSeconds
		self._T.GuardUntil = now + self:SkillNumber(row, "Duration", 6) * self:GetBuffDurationScale()
		self._T.GuardReduction = self:SkillNumber(row, "StatusValue", 0)
		self._T.GuardReflection = reflection
	end

	@ExecSpace("ServerOnly")
	method void ExecuteBuffSkill(string skillId, any row)
		-- Type=Buff 의 범위 효과 (job-branch-redesign §7.3·§7.5). 자기 자신에게 거는 BuffIds 는 시전부의 ApplySkillBuffs 가 맡는다.
		--   TauntRadius·TauntDuration : 반경 안 몬스터의 표적을 나로 고정(쇠망치 도발). 보스는 MonsterAI 가 무시한다.
		--   BuffTarget=Allies·BuffRadius : 반경 안 다른 플레이어에게도 BuffIds 를 건다(야생의 고무).
		--   Status + BuffRadius : 반경 안 몬스터에게 피해 없이 상태이상만 건다(야생의 고무 → 약화).
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return end
		local center = self.Entity.TransformComponent.WorldPosition:ToVector2()
		local combatMap = self:IsCombatSkillMap()
		local tauntR = self:SkillNumber(row, "TauntRadius", 0)
		local tauntS = self:SkillNumber(row, "TauntDuration", 0)
		local radius = self:SkillNumber(row, "BuffRadius", 0)
		local hasStatus = self:SkillText(row, "Status") ~= "" and radius > 0
		local taunted = 0
		local weakened = 0
		if combatMap and ((tauntR > 0 and tauntS > 0) or hasStatus) then
			for _, comp in ipairs(map:GetChildComponentsByTypeName("script.Monster", false)) do
				---@type Monster
				local monster = comp
				local e = monster.Entity
				if isvalid(e) and not monster.IsDead and monster.Hp > 0 then
					local d = Vector2.Distance(center, e.TransformComponent.WorldPosition:ToVector2())
					if tauntR > 0 and tauntS > 0 and d <= tauntR then
						local ai = e:GetComponent("script.MonsterAI")
						if isvalid(ai) then
							---@type MonsterAI
							local a = ai
							a:SetForcedTarget(self.Entity, tauntS, 2)
							taunted = taunted + 1
						end
					end
					if hasStatus and d <= radius then
						monster:ApplySkillStatus(skillId, self.Entity)
						weakened = weakened + 1
					end
				end
			end
		end
		local allies = 0
		if self:SkillText(row, "BuffTarget") == "Allies" and radius > 0 then
			for _, player in pairs(_UserService:GetUsersByMapName(map.Name)) do
				if isvalid(player) and player ~= self.Entity then
					local pc = player:GetComponent("script.PlayerController")
					if isvalid(pc) and not pc.IsDead and Vector2.Distance(center, player.TransformComponent.WorldPosition:ToVector2()) <= radius then
						self:ApplySkillBuffsTo(player, row)
						allies = allies + 1
					end
				end
			end
		end
		log("[SKILL] buff " .. skillId .. " taunted=" .. tostring(taunted) .. " allies=" .. tostring(allies) .. " status=" .. tostring(weakened))
	end

	@ExecSpace("ServerOnly")
	method void ApplySkillBuffsTo(Entity player, any row)
		-- 다른 플레이어에게 스킬 행의 BuffIds 를 건다(아군 버프). 지속시간 = 행 Duration × 시전자의 지속시간 배율.
		local ids = self:SkillText(row, "BuffIds")
		if ids == "" or not isvalid(player) then return end
		local buffs = player:GetComponent("script.PlayerBuffs")
		if not isvalid(buffs) then return end
		local duration = self:SkillNumber(row, "Duration", 0)
		if duration > 0 then duration = duration * self:GetBuffDurationScale() end
		for _, buffId in ipairs(self:SplitList(ids, "|")) do
			if buffId ~= "" then buffs:ApplyBuffFor(buffId, duration) end
		end
	end

	method number GetSummonPowerScale()
		-- 소환수 피해·체력 배율 = 1 + 무리의 우두머리(SummonPowerPct).
		return 1 + math.max(0, self:GetPassiveBonus("SummonPowerPct"))
	end

	@ExecSpace("ServerOnly")
	method integer ComputeSummonDamage(string skillId)
		-- 소환수 1타 피해 = 시전 스킬의 계열 공격력 × 스킬 배율(레벨) × 소환수 배율. Summon.Attack 이 부른다.
		local mul = self:GetEffectiveDamageMultiplier(skillId, self:GetSkillLevel(skillId)) * self:GetSummonPowerScale()
		return self:ComputeSkillDamage(skillId, mul)
	end

	@ExecSpace("ServerOnly")
	method void ExecuteSummonSkill(string skillId, any row)
		-- 소환(Type=Summon, job-branch-redesign §7.4): SkillDataSet.SummonId → SummonDataSet 행의 모델을 내 앞에 스폰하고 script.Summon 을 붙인다.
		-- 같은 스킬의 소환수는 MaxCount(+ MaxBonusStat 패시브 — 무리의 우두머리 SummonMax)까지. 넘치면 가장 오래된 것을 돌려보낸다.
		local map = self.Entity.CurrentMap
		local summonId = self:SkillText(row, "SummonId")
		local sds = _DataService:GetTable("SummonDataSet")
		local srow = sds ~= nil and sds:FindRow("SummonId", summonId) or nil
		if not isvalid(map) or srow == nil then
			log_warning("[SUMMON] missing SummonDataSet row: " .. tostring(summonId))
			return
		end
		local modelName = self:SkillText(srow, "ModelName")
		local modelId = _EntryService:GetModelIdByName(modelName)
		if modelId == nil or modelId == "" then modelId = modelName end
		if self._T.Summons == nil then self._T.Summons = {} end
		local list = {}
		for _, e in ipairs(self._T.Summons[skillId] or {}) do
			if isvalid(e) then list[#list + 1] = e end
		end
		local maxCount = math.max(1, math.floor(self:SkillNumber(srow, "MaxCount", 1)))
		local bonusStat = self:SkillText(srow, "MaxBonusStat")
		if bonusStat ~= "" then maxCount = maxCount + math.floor(math.max(0, self:GetPassiveBonus(bonusStat)) + 0.0001) end
		while #list >= maxCount do
			local oldest = table.remove(list, 1)
			local old = oldest:GetComponent("script.Summon")
			if isvalid(old) then
				---@type Summon
				local o = old
				o:Dismiss("replaced")
			else
				oldest:Destroy()
			end
		end
		local pos = self.Entity.TransformComponent.WorldPosition
		local spawnPos = Vector3(pos.x + self.LastDirectionX * 1.2, pos.y + self.LastDirectionY * 1.2, pos.z)
		if self:IsObstacle(Vector2(spawnPos.x, spawnPos.y), 0.3, nil) then spawnPos = pos end
		local e = _SpawnService:SpawnByModelId(modelId, "Summon_" .. summonId, spawnPos, map)
		if not isvalid(e) then
			log_warning("[SUMMON] spawn failed model=" .. tostring(modelName))
			return
		end
		e:AddComponent("script.Summon")
		local comp = e:GetComponent("script.Summon")
		local playerComp = self.Entity.PlayerComponent
		local hpBase = (playerComp ~= nil and playerComp.MaxHp or 100) * self:GetSummonPowerScale()
		if not isvalid(comp) then
			e:Destroy()
			return
		end
		---@type Summon
		local s = comp
		if not s:Setup(self.Entity, skillId, summonId, self:SkillNumber(row, "Duration", 30), hpBase) then
			e:Destroy()
			return
		end
		list[#list + 1] = e
		self._T.Summons[skillId] = list
		log("[SUMMON] cast " .. skillId .. " id=" .. summonId .. " count=" .. tostring(#list) .. "/" .. tostring(maxCount))
	end

	@ExecSpace("ServerOnly")
	method void HealSummonsNear(Vector3 center, number radius, integer amount)
		-- 내 소환수 중 center 반경 안에 있는 것을 회복한다(회복 오라·생명 펄스가 아군 소환수도 살린다).
		if amount <= 0 or self._T.Summons == nil then return end
		for _, list in pairs(self._T.Summons) do
			for _, e in ipairs(list) do
				if isvalid(e) and Vector2.Distance(e.TransformComponent.WorldPosition:ToVector2(), center:ToVector2()) <= radius then
					local comp = e:GetComponent("script.Summon")
					if isvalid(comp) then
						---@type Summon
						local s = comp
						s:Heal(amount)
					end
				end
			end
		end
	end

	@ExecSpace("ServerOnly")
	method integer BuffAllSummonsNear(Entity map, Vector3 center, number radius, number pct, number seconds)
		-- 생명 펄스: 맵의 모든 플레이어 소환수 중 반경 안의 것에 공격 강화를 건다. 강화된 소환수 수를 돌려준다.
		if not isvalid(map) or pct <= 0 or seconds <= 0 then return 0 end
		local count = 0
		for _, comp in ipairs(map:GetChildComponentsByTypeName("script.Summon", false)) do
			local e = comp.Entity
			if isvalid(e) and Vector2.Distance(e.TransformComponent.WorldPosition:ToVector2(), center:ToVector2()) <= radius then
				---@type Summon
				local s = comp
				s:ApplyAttackBuff(pct, seconds)
				count = count + 1
			end
		end
		return count
	end

	@ExecSpace("Client")
	method void ClientSummonHp(Entity summon, number hp, number maxHp, number buffSeconds, boolean alive)
		-- 주인 클라: 소환수 머리 위 체력바 데이터 갱신. 막대 생성·위치는 UpdateSummonHpBars 가 매 프레임 처리한다.
		-- ⚠ RPC 본문 — 사용자 타입 주석 금지 (규칙 53).
		if self._T.SummonBars == nil then self._T.SummonBars = {} end
		local bars = self._T.SummonBars
		local key = isvalid(summon) and summon.Id or nil
		if key == nil then return end
		local rec = bars[key]
		if not alive then
			if rec ~= nil then self:DestroySummonBar(rec) end
			bars[key] = nil
			return
		end
		if rec == nil then
			rec = { entity = summon }
			bars[key] = rec
		end
		rec.entity = summon
		rec.hp = hp
		rec.maxHp = math.max(1, maxHp)
		rec.buffUntil = _UtilLogic.ElapsedSeconds + math.max(0, buffSeconds)
	end

	@ExecSpace("ClientOnly")
	method void DestroySummonBar(any rec)
		-- 막대 UI 엔티티 정리.
		if rec ~= nil and isvalid(rec.bar) then rec.bar:Destroy() end
		if rec ~= nil then rec.bar = nil end
	end

	@ExecSpace("ClientOnly")
	method void UpdateSummonHpBars()
		-- 내 소환수 머리 위 체력바: HUD 아래 uisprite(바탕) + Fill(채움) 을 소환수 피격 박스 위쪽으로 매 프레임 옮긴다.
		-- 색 = 체력 비율(초록 > 60% · 노랑 · 빨강 ≤ 30%). 생명 펄스 강화 중에는 바탕 테두리를 금색으로 바꾼다.
		local bars = self._T.SummonBars
		if bars == nil then return end
		local hud = _EntityService:GetEntityByPath("/ui/HUDGroup")
		local now = _UtilLogic.ElapsedSeconds
		local barW = self.SummonHpBarWidth
		local barH = self.SummonHpBarHeight
		for key, rec in pairs(bars) do
			local e = rec.entity
			if not isvalid(e) then
				self:DestroySummonBar(rec)
				bars[key] = nil
			elseif isvalid(hud) then
				if not isvalid(rec.bar) then
					local bg = _SpawnService:SpawnByModelId("uisprite", "SummonHpBar", Vector3.zero, hud)
					if isvalid(bg) then
						local t = bg.UITransformComponent
						t.AlignmentOption = AlignmentType.Center
						t.Pivot = Vector2(0.5, 0.5)
						t.RectSize = Vector2(barW, barH)
						bg.SpriteGUIRendererComponent.RaycastTarget = false
						local fill = _SpawnService:SpawnByModelId("uisprite", "Fill", Vector3.zero, bg)
						if isvalid(fill) then
							local ft = fill.UITransformComponent
							ft.AlignmentOption = AlignmentType.Left
							ft.Pivot = Vector2(0, 0.5)
							ft.anchoredPosition = Vector2(2, 0)
							fill.SpriteGUIRendererComponent.RaycastTarget = false
							rec.fill = fill
						end
						rec.bar = bg
					end
				end
				if isvalid(rec.bar) then
					local ratio = math.max(0, math.min(1, (rec.hp or 0) / math.max(1, rec.maxHp or 1)))
					local buffed = now < (rec.buffUntil or 0)
					rec.bar.SpriteGUIRendererComponent.Color = buffed and Color(0.95, 0.76, 0.25, 0.95) or Color(0.08, 0.08, 0.1, 0.85)
					if isvalid(rec.fill) then
						local c = Color(0.35, 0.85, 0.35, 1)
						if ratio <= 0.3 then c = Color(0.92, 0.27, 0.22, 1) elseif ratio <= 0.6 then c = Color(0.95, 0.80, 0.25, 1) end
						rec.fill.SpriteGUIRendererComponent.Color = c
						rec.fill.UITransformComponent.RectSize = Vector2(math.max(0, (barW - 4) * ratio), barH - 4)
					end
					-- 피격 박스 위쪽(오프셋·크기 × Scale) + 여유. 박스가 없으면 Scale 기준 추정.
					local p = e.TransformComponent.WorldPosition
					local s = e.TransformComponent.Scale
					local top = p.y + 0.9 * math.abs(s.y)
					local hit = e.HitComponent
					if isvalid(hit) then top = p.y + (hit.ColliderOffset.y + hit.BoxSize.y * 0.5) * math.abs(s.y) end
					local screen = _UILogic:WorldToScreenPosition(Vector2(p.x, top + self.SummonHpBarOffsetY))
					rec.bar.UITransformComponent.anchoredPosition = _UILogic:ScreenToUIPosition(screen)
				end
			end
		end
	end

	@ExecSpace("ServerOnly")
	method void HealAllSummonsNear(Entity map, Vector3 center, number radius, integer amount)
		-- 맵의 모든 플레이어 소환수 중 반경 안의 것을 회복한다.
		if not isvalid(map) or amount <= 0 then return end
		for _, player in pairs(_UserService:GetUsersByMapName(map.Name)) do
			local pc = isvalid(player) and player:GetComponent("script.PlayerController") or nil
			if isvalid(pc) then
				---@type PlayerController
				local controller = pc
				controller:HealSummonsNear(center, radius, amount)
			end
		end
	end

	@ExecSpace("ServerOnly")
	method void FireSkillTriggers(string trigger, string parentSkillId)
		-- 슬롯 없이 발동하는 패시브(SkillDataSet.Trigger). 배운 행만, 행별 재사용 대기시간을 지킨다.
		--   OnParentCast    : ParentSkillId 스킬을 시전할 때 BuffIds 를 함께 건다 (예: 기합 → 투기 방출)
		--   LowHp           : 피격 후 HP 비율 ≤ StatusValue 면 기력 전량 + BuffIds (예: 불굴의 투혼)
		--   OnParentTrigger : ParentSkillId(또는 그 직업 변형) 트리거가 발동하면 연쇄 발동 (예: 불굴의 투혼 → 강철 피부)
		-- LowHp 가 아닌 행의 StatusValue > 0 은 Guard 창(피해 감소율, 반사율 = 배율)으로 쓴다.
		local ds = _DataService:GetTable("SkillDataSet")
		if ds == nil then return end
		local playerComp = self.Entity.PlayerComponent
		if playerComp == nil then return end
		local now = _UtilLogic.ElapsedSeconds
		if self._T.TriggerAt == nil then self._T.TriggerAt = {} end
		for i = 1, ds:GetRowCount() do
			local row = ds:FindRow("SkillId", ds:GetCell(i, "SkillId"))
			if row ~= nil and self:SkillText(row, "Trigger") == trigger and self:IsSkillJobAllowed(row) then
				local skillId = self:SkillText(row, "SkillId")
				local level = self:GetEffectiveSkillLevel(row)
				local parentOk = parentSkillId == "" or self:SkillText(row, "ParentSkillId") == parentSkillId
				local cd = self:GetEffectiveCooldown(skillId, level)
				local last = self._T.TriggerAt[skillId] or -999.0
				if level >= 1 and parentOk and now - last >= cd then
					local fire = true
					if trigger == "LowHp" then
						local maxHp = math.max(1, playerComp.MaxHp)
						fire = playerComp.Hp > 0 and playerComp.Hp / maxHp <= self:SkillNumber(row, "StatusValue", 0.3)
					end
					if fire then
						self._T.TriggerAt[skillId] = now
						if trigger == "LowHp" then
							self.Stamina = self.MaxStamina
						elseif self:SkillNumber(row, "StatusValue", 0) > 0 then
							self:StartGuard(row, self:GetEffectiveDamageMultiplier(skillId, level))
						end
						self:ApplySkillBuffs(row)
						local fx = self:SkillText(row, "EffectRUID")
						if fx ~= "" then
							self:MulticastPlayEffectEx(fx, self.Entity.TransformComponent.WorldPosition, self.LastDirectionX > 0, self:SkillNumber(row, "EffectScale", 1))
						end
						if trigger ~= "OnParentCast" then
							self:ClientShowMineFeedback("[" .. self:SkillText(row, "Name") .. "] 발동!", playerComp.UserId)
						end
						log("[SKILL-TRIGGER] " .. trigger .. " " .. skillId .. " lv=" .. tostring(level))
						-- 연쇄: 이 행(직업 변형이면 원본 스킬 id)을 선행으로 둔 OnParentTrigger 패시브. 한 단계만 내려간다.
						if trigger ~= "OnParentTrigger" then
							local baseId = self:SkillText(row, "JobVariantOf")
							if baseId == "" then baseId = skillId end
							self:FireSkillTriggers("OnParentTrigger", baseId)
						end
					end
				end
			end
		end
	end

	method number GetCritChance()
		-- 치명타 확률 = 기본 + 솜씨 × DexCritPerPoint + 패시브·장비(CritChance), 0 ~ MaxCritChance. PlayerCombat.CalcCritical 이 부른다.
		local chance = self.BaseCritChance + self.StatDex * self.DexCritPerPoint + self:GetPassiveBonus("CritChance")
		return math.max(0, math.min(self.MaxCritChance, chance))
	end

	method number GetCritDamageRate()
		-- 치명타 피해 배율 = 기본 + 패시브·장비(CritDamage). PlayerCombat.GetCriticalDamageRate 가 부른다.
		return self.BaseCritDamage + math.max(0, self:GetPassiveBonus("CritDamage"))
	end

	method number GetCritChanceFor(string skillId)
		-- 이 타격의 치명 확률 = GetCritChance(상한 MaxCritChance) + 시전 스킬의 CritBonus(급소 찌르기·불씨 저격). 스킬 보너스는 상한 위로 얹고 최대 100%.
		-- 소환 스킬(Type=Summon)의 타격 = 소환수 공격이라 치명이 없다(단순화, §7.1).
		local chance = self:GetCritChance()
		if skillId == nil or skillId == "" then return chance end
		local ds = _DataService:GetTable("SkillDataSet")
		if ds == nil then return chance end
		local row = ds:FindRow("SkillId", skillId)
		if self:SkillText(row, "Type") == "Summon" then return 0 end
		return math.min(1, chance + math.max(0, self:SkillNumber(row, "CritBonus", 0)))
	end

	@ExecSpace("ServerOnly")
	method boolean IsForcedCrit(string skillId)
		-- 확정 치명(NextCrit 버프 — 그림자 걸음)을 이번 시전에 예약해 둔 스킬의 타격인가. 시전 때 버프를 소모하고 그 시전의 모든 타격(장판 틱·투사체 포함)에 적용한다.
		local fc = self._T.ForcedCrit
		if fc == nil or skillId == nil or skillId == "" then return false end
		return fc.skillId == skillId and _UtilLogic.ElapsedSeconds < fc.untilAt
	end

	method number GetControlDurationScale()
		-- 내가 건 상태이상(속박·기절·둔화·산성·방어력 감소) 지속 배율 = 1 + 교감 × SpiControlPerPoint + 패시브·장비(ControlDurationPct).
		-- Monster.ApplySkillHit 이 상태이상 지속시간에 곱한다.
		return 1 + self.StatSpi * self.SpiControlPerPoint + math.max(0, self:GetPassiveBonus("ControlDurationPct"))
	end

	method number GetTrinityBalance()
		-- 삼위일체 균형도 = min(힘, 솜씨, 체력) / 평균. 0(몰빵)~1(1:1:1). 모두 0 이면 1.
		local s = self.StatStr
		local d = self.StatDex
		local v = self.StatVit
		local avg = (s + d + v) / 3.0
		if avg <= 0 then return 1.0 end
		return math.min(s, d, v) / avg
	end

	method integer GetTrinityPoints()
		-- 삼위일체 계열 유효 포인트 = (힘+솜씨+체력) × (기본 계수 + 균형 계수 × 균형도).
		local sum = self.StatStr + self.StatDex + self.StatVit
		local factor = self.TrinityBaseFactor + self.TrinityBalanceFactor * self:GetTrinityBalance()
		return math.floor(sum * factor + 0.0001)
	end

	method string GetBasicAttackStat()
		-- 평타(Ctrl) 피해 계열. BasicAttackStatByJob("직업:계열|...")에 없으면 STR.
		if self.JobId == nil or self.JobId == "" then return "STR" end
		for _, pair in ipairs(self:SplitList(self.BasicAttackStatByJob or "", "|")) do
			local kv = self:SplitList(pair, ":")
			if kv[1] == self.JobId and kv[2] ~= nil and kv[2] ~= "" then return kv[2] end
		end
		return "STR"
	end

	method table SplitList(string text, string separator)
		-- _UtilLogic:Split 방어 래퍼. 빈 문자열 → {}, 구분자가 없어 nil 이 오면 {text} (QuestData.ParseItems 와 같은 규약).
		if text == nil or text == "" then return {} end
		local parts = _UtilLogic:Split(text, separator)
		if parts == nil then return { text } end
		return parts
	end

	method integer GetGloveFistAttack()
		-- 삼위일체 계열 "무기" 수치: 장착 장갑 방어력 × GloveAttackRatio. 장갑이 없으면 0(맨주먹).
		local pi = self.Entity:GetComponent("script.PlayerInventory")
		if not isvalid(pi) then return 0 end
		---@type PlayerInventory
		local p = pi
		local key = p:GetGearKey("gloves")
		if key == "" then return 0 end
		return math.floor(p:GetItemNumber(p:GetBaseItemName(key), "Defense") * self.GloveAttackRatio + 0.0001)
	end
	method number GetEffectiveMineCooldown()
		-- 실효 채집 쿨다운 = MineCooldown + Σ패시브(MineCooldown, 음수), 하한 0.2초
		-- T16 GatherSpeed mult: 쿨다운 / mult (채집 빨라짐)
		local cd = self.MineCooldown + self:GetPassiveBonus("MineCooldown")
		local buffs = self.Entity:GetComponent("script.PlayerBuffs")
		if isvalid(buffs) then
			local mult = buffs:GetStatMult("GatherSpeed")
			if mult > 0.01 then
				cd = cd / mult
			end
			cd = cd - buffs:GetStatAdd("GatherSpeed") * 0.05
		end
		-- 힘: 1 포인트당 공격·채집 속도 +StrSpeedPerPoint (평타 간격도 이 쿨다운을 따른다 — 구 솜씨 효과를 힘으로 이관, 2026-10-01)
		cd = cd / (1 + self.StatStr * self.StrSpeedPerPoint)
		return math.max(0.2, cd)
	end

	method number GetBuffedMoveSpeed()
		-- T16 MoveSpeed: base 7.2 * mult + add (2x scale)
		-- 장비·주문 부여 MoveSpeedPct(예: 멧돼지 가죽 장식)는 기본 속도에 곱한다.
		local base = 7.2 * (1 + math.min(0.5, math.max(0, self:GetPassiveBonus("MoveSpeedPct"))))
		local buffs = self.Entity:GetComponent("script.PlayerBuffs")
		if isvalid(buffs) then
			return base * buffs:GetStatMult("MoveSpeed") + buffs:GetStatAdd("MoveSpeed")
		end
		return base
	end

	method number GetBuffedAttackPower()
		-- T16 AttackPower 가산 (BaseDamage에 더함)
		local buffs = self.Entity:GetComponent("script.PlayerBuffs")
		if isvalid(buffs) then
			return buffs:GetStatAdd("AttackPower") + (buffs:GetStatMult("AttackPower") - 1.0) * 8.0
		end
		return 0.0
	end

	method number GetBuffedStaminaRegen()
		-- T16 StaminaRegen: 초당 기본 2 + add, * mult
		local base = 2.0
		local buffs = self.Entity:GetComponent("script.PlayerBuffs")
		if isvalid(buffs) then
			return (base + buffs:GetStatAdd("StaminaRegen")) * buffs:GetStatMult("StaminaRegen")
		end
		return base
	end

	method boolean IsSkillEquipRequirementMet(any row)
		-- RequireEquippedItem이 있으면 장착 도구 Name이 일치해야 시전한다.
		if row == nil then return true end
		local requireItem = ""
		local okR, rawR = pcall(function() return row:GetItem("RequireEquippedItem") end)
		if okR and rawR ~= nil then requireItem = tostring(rawR) end
		if requireItem == "" then return true end
		local inv = self.Entity:GetComponent("script.PlayerInventory")
		if not isvalid(inv) then return false end
		---@type PlayerInventory
		local p = inv
		local equipped = p:GetBaseItemName(p.EquippedTool or "")
		if equipped == requireItem then return true end
		local disp = p:GetItemDisplayName(requireItem)
		local msg = disp .. "을(를) 들고 있어야 합니다."
		local playerComp = self.Entity.PlayerComponent
		if playerComp ~= nil then
			self:ClientShowMineFeedback(msg, playerComp.UserId)
		else
			self:ShowMineFeedback(msg)
		end
		return false
	end

	method boolean ConsumeSkillItemIfNeeded(any row, boolean doRemove)
		-- SkillDataSet ConsumeItem/ConsumeCount. doRemove=false면 보유만 검사 (클라 프리체크).
		if row == nil then return true end
		local consumeItem = ""
		local okI, rawI = pcall(function() return row:GetItem("ConsumeItem") end)
		if okI and rawI ~= nil then consumeItem = tostring(rawI) end
		if consumeItem == "" then return true end
		local consumeCount = 1
		local okC, rawC = pcall(function() return row:GetItem("ConsumeCount") end)
		if okC and rawC ~= nil and tostring(rawC) ~= "" then
			consumeCount = math.floor(tonumber(rawC) or 1)
		end
		if consumeCount < 1 then consumeCount = 1 end

		local inv = self.Entity:GetComponent("script.PlayerInventory")
		if not isvalid(inv) then return false end
		---@type PlayerInventory
		local p = inv
		if p:GetItemCount(consumeItem) < consumeCount then
			local disp = p:GetItemDisplayName(consumeItem)
			local playerComp = self.Entity.PlayerComponent
			local msg = disp .. "이(가) 부족합니다."
			if playerComp ~= nil then
				self:ClientShowMineFeedback(msg, playerComp.UserId)
			else
				self:ShowMineFeedback(msg)
			end
			return false
		end
		if doRemove then
			-- 탄약 보유 검사 뒤에만 보존 확률을 적용한다.
			if self:SkillText(row, "DamageModel") == "Throw" and math.random() < math.min(1, self:GetPassiveBonus("AmmoSave")) then return true end
			if not p:RemoveItem(consumeItem, consumeCount) then
				return false
			end
			p:SyncEquippedToolToSelectedSlot()
			log("[SKILL] Consume " .. consumeItem .. " x" .. tostring(consumeCount))
		end
		return true
	end

	method boolean IsUnlockOwnedItemSatisfied(any row)
		-- UnlockOwnedItem 컬럼: 현재 보유 또는 도감 누적 획득이면 통과.
		if row == nil then return false end
		local ok, raw = pcall(function() return row:GetItem("UnlockOwnedItem") end)
		if not ok or raw == nil or tostring(raw) == "" then return false end
		local inv = self.Entity:GetComponent("script.PlayerInventory")
		if not isvalid(inv) then return false end
		---@type PlayerInventory
		local p = inv
		return p:HasAcquiredItem(tostring(raw))
	end

	@ExecSpace("ServerOnly")
	method boolean IsSkillUnlockGateSatisfied(any row)
		-- UnlockAchievementId와 UnlockOwnedItem이 둘 다 있으면 OR, 하나만 있으면 그 조건.
		if row == nil then return true end
		if not self:IsSkillQuestAllowed(row) then return false end
		local achId = tonumber(row:GetItem("UnlockAchievementId"))
		local hasAch = achId ~= nil and achId > 0
		local ok, raw = pcall(function() return row:GetItem("UnlockOwnedItem") end)
		local hasOwned = ok and raw ~= nil and tostring(raw) ~= ""
		if not hasAch and not hasOwned then return true end
		local achOk = false
		if hasAch then
			achOk = self:IsUnlockAchievementSatisfied(achId)
		end
		local ownedOk = false
		if hasOwned then
			ownedOk = self:IsUnlockOwnedItemSatisfied(row)
		end
		if hasAch and hasOwned then return achOk or ownedOk end
		if hasAch then return achOk end
		return ownedOk
	end

	@ExecSpace("ServerOnly")
	method boolean IsUnlockAchievementSatisfied(integer achievementId)
		-- 패키지 업적 게이트 판정: Completed 상태이거나, 최종 스텝을 달성 가능(진행도 충족)한 경우 통과.
		local pa = self.Entity.PlayerAchievement
		if pa == nil then return false end
		
		local data = _AchievementDataSetLogic:GetData(achievementId)
		if data == nil then return false end
		
		local userData = pa.UserDataTable[achievementId]
		if userData == nil then return false end
		
		if userData.State == _AchievementStateEnum.Completed then return true end
		if not userData:IsCompletable(data) then return false end
		
		-- 다단계 업적은 마지막 스텝에서만 게이트 통과
		return data:GetStepData(userData.Step + 1) == nil
	end

	@ExecSpace("Server")
	method void ServerRequestSkillLevelUp(string skillId)
		-- 스킬트리 해금/레벨업 서버 검증: ①선행 스킬 ②캐릭터 레벨 ③업적 게이트 ④SP ⑤MaxLevel
		local playerComp = self.Entity.PlayerComponent
		if playerComp == nil or senderUserId ~= playerComp.UserId then return end
		
		local ds = _DataService:GetTable("SkillDataSet")
		if not ds then return end
		local row = ds:FindRow("SkillId", skillId)
		if not row then return end
		if not self:IsSkillJobAllowed(row) then return end
		
		local ok, levels = pcall(function() return _HttpService:JSONDecode(self.SkillLevelsJson) end)
		if not ok or levels == nil then levels = {} end
		local curLevel = tonumber(levels[skillId]) or 0
		
		-- ⑤ 최대 레벨
		local maxLevel = tonumber(row:GetItem("MaxLevel")) or 1
		if curLevel >= maxLevel then
			self:ClientShowMineFeedback("이미 최대 레벨입니다.", playerComp.UserId)
			return
		end
		
		-- 해금(0→1) 시에만 검사하는 게이트
		if curLevel == 0 then
			-- ① 선행 스킬: 부모 Lv ≥ ParentRequiredLevel (공란/누락=1, T58)
			local parentId = row:GetItem("ParentSkillId")
			if parentId ~= nil and parentId ~= "" then
				local parentNeed = 1
				local okPrl, rawPrl = pcall(function() return row:GetItem("ParentRequiredLevel") end)
				if okPrl and rawPrl ~= nil and tostring(rawPrl) ~= "" then
					parentNeed = math.floor(tonumber(rawPrl) or 1)
				end
				if parentNeed < 1 then parentNeed = 1 end
				local parentLv = tonumber(levels[parentId]) or 0
				if parentLv < parentNeed then
					local parentName = parentId
					local parentRow = ds:FindRow("SkillId", parentId)
					if parentRow ~= nil then
						local pn = parentRow:GetItem("Name")
						if pn ~= nil and pn ~= "" then parentName = tostring(pn) end
					end
					self:ClientShowMineFeedback(
						"선행 스킬 '" .. parentName .. "' Lv " .. tostring(parentNeed) .. " 필요",
						playerComp.UserId)
					return
				end
			end
			-- ② 캐릭터 레벨
			local reqLevel = tonumber(row:GetItem("RequiredLevel")) or 1
			if self.Level < reqLevel then
				self:ClientShowMineFeedback("레벨 " .. reqLevel .. " 이상 필요합니다.", playerComp.UserId)
				return
			end
			-- ③ 해금 게이트: UnlockAchievementId 또는 UnlockOwnedItem (둘 다 있으면 OR)
			if not self:IsSkillUnlockGateSatisfied(row) then
				self:ClientShowMineFeedback("해금 목표를 먼저 달성해야 합니다.", playerComp.UserId)
				return
			end
		end
		
		-- ④ SP 비용
		local spCost = tonumber(row:GetItem("SPCost")) or 1
		if self.SP < spCost then
			self:ClientShowMineFeedback("SP가 부족합니다. (필요: " .. spCost .. ")", playerComp.UserId)
			return
		end
		
		levels[skillId] = curLevel + 1
		self.SP = self.SP - spCost
		self.SkillLevelsJson = _HttpService:JSONEncode(levels)

		-- T45④: 최초 해금 시 빈 슬롯 자동 장착 (액티브만)
		if curLevel == 0 then
			self:TryAutoEquipOnUnlock(skillId)
			if _ActionSignals ~= nil then
				_ActionSignals:EmitToPlayer(self.Entity, _ActionEnum.LearnSkill, skillId, 1)
			end
		end
		
		if _PersistenceManager then
			_PersistenceManager:MarkPlayerDirty(playerComp.UserId)
		end
		
		local skillName = row:GetItem("Name") or skillId
		if curLevel == 0 then
			self:ClientShowMineFeedback("[스킬 해금] " .. skillName .. " Lv.1", playerComp.UserId)
		else
			self:ClientShowMineFeedback("[스킬 강화] " .. skillName .. " Lv." .. (curLevel + 1), playerComp.UserId)
		end
		log("[SKILL-TREE] " .. playerComp.UserId .. " leveled " .. skillId .. " -> " .. (curLevel + 1) .. " (SP left: " .. self.SP .. ")")
	end

	method integer GetCharacterAttack()
		-- 힘 계열 공격력(무기 제외). 구 호출부 호환 — GetStatPower("STR") 와 같다.
		return self:GetStatPower("STR")
	end

	method integer GetStatPoints(string statKey)
		-- 분배한 능력치 포인트. STR/DEX/INT/SPI/VIT.
		if statKey == "STR" then return self.StatStr end
		if statKey == "DEX" then return self.StatDex end
		if statKey == "INT" then return self.StatInt end
		if statKey == "SPI" then return self.StatSpi end
		if statKey == "VIT" then return self.StatVit end
		if statKey == "TRI" then return self:GetTrinityPoints() end
		return 0
	end

	method number GetPowerStatPoints(string statKey)
		-- 계열 공격력에 쓰는 포인트 = 분배 포인트 + 환산 포인트. 강철 체격(VitToStr)은 체력 포인트의 일부를 힘 계열로 더한다.
		-- 캐릭터창의 분배 숫자(GetStatPoints)는 그대로 둔다 — 환산분은 계열 공격력 합계에만 보인다.
		local pts = self:GetStatPoints(statKey)
		if statKey == "STR" then
			local ratio = self:GetPassiveBonus("VitToStr")
			if ratio > 0 then pts = pts + math.floor(self.StatVit * ratio + 0.0001) end
		end
		return pts
	end

	method string GetStatLabel(string statKey)
		if statKey == "STR" then return "힘" end
		if statKey == "DEX" then return "솜씨" end
		if statKey == "INT" then return "지능" end
		if statKey == "SPI" then return "교감" end
		if statKey == "VIT" then return "체력" end
		if statKey == "TRI" then return "삼위일체" end
		return statKey
	end

	method integer GetStatPower(string statKey)
		-- 계열 공격력(무기 제외) = 기본 + 레벨 성장 + 능력치 기여 + 버프. 서버 피해식과 UI 가 같은 식을 쓴다.
		return self:GetStatPowerWithExtra(statKey, 0)
	end

	method integer GetSubStatPoints(any row)
		-- 스킬 보조 능력치(SkillDataSet.SubStat)가 주 능력치처럼 계열 공격력에 더해지는 포인트.
		-- 주 능력치 × SubStatCap 까지만 인정한다 → 그 비율까지 섞으면 공격력 손해 없이 보조 능력치의 공통 효과(솜씨 = 치명)를 얻고,
		-- 넘기면 공격력이 덜 오른다. "주 능력치 기반 + 보조를 적당히 섞는 게 효율" 구조(2026-10-06, 정밀 폭파술사).
		local sub = self:SkillText(row, "SubStat")
		if sub == "" then return 0 end
		local stat = self:GetSkillScaleStat(row)
		if sub == stat then return 0 end
		local cap = math.max(0, self:SkillNumber(row, "SubStatCap", 0))
		local limit = math.floor(self:GetPowerStatPoints(stat) * cap + 0.0001)
		return math.max(0, math.min(self:GetPowerStatPoints(sub), limit))
	end

	method integer GetSkillStatPower(any row)
		-- 스킬의 계열 공격력(무기 제외) = 주 계열(ScaleStat) 공격력 + 상한 안의 보조 능력치(SubStat) 기여.
		return self:GetStatPowerWithExtra(self:GetSkillScaleStat(row), self:GetSubStatPoints(row))
	end

	method integer GetStatPowerWithExtra(string statKey, integer extraPoints)
		-- GetStatPower 본체. extraPoints = 주 능력치처럼 더할 추가 포인트(스킬 보조 능력치). 버프 비율(AttackPct)도 같이 곱해진다.
		local base = 8
		local combat = self.Entity:GetComponent("script.PlayerCombat")
		if isvalid(combat) then
			---@type PlayerCombat
			local c = combat
			base = c.BaseDamage
		end
		local lv = math.max(1, self.Level or 1)
		local growth = (lv - 1) * self.LevelPowerGrowth + (self:GetPowerStatPoints(statKey) + math.max(0, extraPoints or 0)) * self.StatPowerPerPoint
		local buff = 0
		local pct = 0
		local buffs = self.Entity:GetComponent("script.PlayerBuffs")
		if isvalid(buffs) then
			if statKey == "INT" then
				buff = buffs:GetStatAdd("MagicPower") + (buffs:GetStatMult("MagicPower") - 1.0) * 8.0
			else
				buff = self:GetBuffedAttackPower()
			end
			-- AttackPct: 계열 공격력 비율 증가(기합 등). 0.15 = +15%.
			pct = buffs:GetStatAdd("AttackPct")
		end
		return math.floor((base + growth + buff) * (1 + pct) + 0.0001)
	end

	method integer GetStatWeaponAttack(string statKey)
		-- 계열 공격력에 더해지는 무기 수치: 지능은 MagicAttack, 삼위일체는 장갑 방어력 전환, 나머지는 Attack.
		-- 주무기 미등록이면 보유 최고 무기(자동)를 쓴다 — PlayerInventory.GetGearStat 규약.
		if statKey == "INT" then return self:GetGearStat("MagicAttack") end
		if statKey == "TRI" then return self:GetGloveFistAttack() end
		return self:GetGearStat("Attack")
	end

	method integer GetStatAttackTotal(string statKey)
		-- 계열 공격력 합계(무기 포함) — 캐릭터 정보창·스킬 설명·평타가 쓰는 값.
		return self:GetStatPower(statKey) + self:GetStatWeaponAttack(statKey)
	end

	method integer GetGearStat(string colName)
		-- 장비 슬롯(주무기·방어구) 수치 합. 주무기 미등록이면 보유 최고 무기를 자동으로 쓴다(PlayerInventory.GetGearKey).
		local pi = self.Entity:GetComponent("script.PlayerInventory")
		if not isvalid(pi) then return 0 end
		---@type PlayerInventory
		local p = pi
		return math.floor(p:GetGearStat(colName))
	end

	method integer GetTotalDefense()
		-- 방어력 = 기본(Defense) + 장비 + 레벨 성장 + 체력 기여.
		local lv = math.max(1, self.Level or 1)
		local grow = math.floor((lv - 1) * self.LevelDefGrowth + self.StatVit * self.VitDefPerPoint + 0.0001)
		return self.Defense + self:GetGearStat("Defense") + grow
	end

	method integer GetMagicAttack()
		-- 지능 계열 공격력(무기 제외). 구 호출부 호환.
		return self:GetStatPower("INT")
	end

	method integer GetComputedMaxHp()
		-- 최대 HP = BaseMaxHp + 레벨 성장 + 체력 기여.
		local lv = math.max(1, self.Level or 1)
		return math.floor(self.BaseMaxHp + (lv - 1) * self.LevelHpGrowth + self.StatVit * self.VitHpPerPoint)
	end

	@ExecSpace("ServerOnly")
	method void ApplyDerivedStats()
		-- 레벨·능력치에서 파생되는 최대 HP 를 PlayerComponent 에 반영하고 HP·마나를 새 최대치로 자른다.
		-- 로드 직후·레벨업·능력치 분배 때 부른다.
		local pcomp = self.Entity.PlayerComponent
		if pcomp ~= nil then
			local maxHp = self:GetComputedMaxHp()
			pcomp.MaxHp = maxHp
			if pcomp.Hp > maxHp then pcomp.Hp = maxHp end
		end
		local maxMana = self:GetMaxMana()
		if self.Mana > maxMana then self.Mana = maxMana end
	end

	@ExecSpace("ServerOnly")
	method any BuildProgressReset(string kind)
		-- 선검증·후적용: 소모품 경로는 이 계획을 만든 뒤 1개 소모하고 Yield 없이 적용한다.
		if kind ~= "AP" and kind ~= "JobSP" and kind ~= "All" then return nil end
		local resetAp = (kind == "AP" or kind == "All")
		local resetSp = (kind == "JobSP" or kind == "All")
		local refundAp = 0
		local refundSp = 0
		local nextLevels = self.SkillLevelsJson
		if resetAp then
			refundAp = math.max(0, self.StatStr) + math.max(0, self.StatDex) + math.max(0, self.StatInt)
				+ math.max(0, self.StatSpi) + math.max(0, self.StatVit)
		end
		if resetSp then
			local ds = _DataService:GetTable("SkillDataSet")
			if ds == nil then return nil end
			local ok, levels = pcall(function() return _HttpService:JSONDecode(self.SkillLevelsJson) end)
			if not ok or type(levels) ~= "table" then return nil end
			for i = 1, ds:GetRowCount() do
				local row = ds:FindRow("SkillId", ds:GetCell(i, "SkillId"))
				local job = self:SkillText(row, "JobId")
				if job == "" or job ~= self.JobId or self:SkillText(row, "JobVariantOf") ~= "" then continue end
				local id = self:SkillText(row, "SkillId")
				-- 최대 레벨을 줄인 패치에서도 구 레벨 전량 환급. SPCost는 이번 패치에서 변경하지 않는다.
				local level = math.max(0, math.floor(tonumber(levels[id]) or 0))
				local cost = self:SkillNumber(row, "SPCost", 1)
				if cost < 0 or cost ~= math.floor(cost) then return nil end
				refundSp = refundSp + level * cost
				levels[id] = nil
			end
			nextLevels = _HttpService:JSONEncode(levels)
		end
		if kind ~= "All" and refundAp + refundSp <= 0 then return nil end
		return { resetAp = resetAp, resetSp = resetSp, ap = refundAp, sp = refundSp, levels = nextLevels }
	end

	@ExecSpace("ServerOnly")
	method void ApplyProgressReset(any plan)
		if plan == nil then return end
		if plan.resetAp then
			self.AP = self.AP + plan.ap
			self.StatStr = 0
			self.StatDex = 0
			self.StatInt = 0
			self.StatSpi = 0
			self.StatVit = 0
		end
		if plan.resetSp then
			self.SP = self.SP + plan.sp
			self.SkillLevelsJson = plan.levels
			self:SanitizeEquippedSkills()
		end
		self:ApplyDerivedStats()
		local player = self.Entity.PlayerComponent
		if plan.markDirty ~= false and player ~= nil and _PersistenceManager ~= nil then _PersistenceManager:MarkPlayerDirty(player.UserId) end
		log("[BUILD-RESET] AP=" .. tostring(plan.ap) .. " SP=" .. tostring(plan.sp) .. " job=" .. self.JobId)
	end

	@ExecSpace("Server")
	method void ServerRequestAllocateStat(string statKey)
		-- 캐릭터 정보창의 능력치 + 버튼. AP 1 을 해당 능력치에 넣는다.
		local playerComp = self.Entity.PlayerComponent
		if playerComp == nil or senderUserId ~= playerComp.UserId then return end
		if self.AP <= 0 then
			self:ClientShowMineFeedback("분배할 AP 가 없습니다.")
			return
		end
		if statKey == "STR" then
			self.StatStr = self.StatStr + 1
		elseif statKey == "DEX" then
			self.StatDex = self.StatDex + 1
		elseif statKey == "INT" then
			self.StatInt = self.StatInt + 1
		elseif statKey == "SPI" then
			self.StatSpi = self.StatSpi + 1
		elseif statKey == "VIT" then
			self.StatVit = self.StatVit + 1
		else
			return
		end
		self.AP = self.AP - 1
		self:ApplyDerivedStats()
		if _PersistenceManager then
			_PersistenceManager:MarkPlayerDirty(playerComp.UserId)
		end
	end

	method string GetSkillKindLabel(any row)
		-- DamageModel/Type → 물리 스킬·마법 스킬·투척 스킬·패시브.
		if row == nil then return "액티브" end
		local typeStr = row:GetItem("Type") or ""
		if typeStr == "Passive" then return "패시브" end
		if typeStr == "Summon" then return "소환 스킬" end
		local model = ""
		local okM, rawM = pcall(function() return row:GetItem("DamageModel") end)
		if okM and rawM ~= nil then model = tostring(rawM) end
		if model == "Magic" then return "마법 스킬" end
		if model == "Throw" then return "투척 스킬" end
		if model == "Physical" then return "물리 스킬" end
		return "액티브"
	end

	method string GetSkillScaleStat(any row)
		-- 스킬 피해가 따르는 능력치 계열. SkillDataSet.ScaleStat 공란이면 Magic=INT, 그 외=STR.
		if row == nil then return "STR" end
		local st = self:SkillText(row, "ScaleStat")
		if st == "STR" or st == "DEX" or st == "INT" or st == "SPI" or st == "TRI" then return st end
		if self:SkillText(row, "DamageModel") == "Magic" then return "INT" end
		return "STR"
	end

	method boolean IsDamageSkillRow(any row)
		-- 피해를 주는 스킬인지(패시브·회복 오라 제외).
		if row == nil then return false end
		local ty = self:SkillText(row, "Type")
		if ty == "Passive" or ty == "HealAura" then return false end
		local model = self:SkillText(row, "DamageModel")
		return model == "Physical" or model == "Magic" or model == "Throw"
	end

	method integer GetWeaponAttackFor(string statKey, string damageModel)
		-- 무기 수치. 삼위일체는 장갑 방어력 환산(무기 공격력은 더하지 않는다), 마법 피해는 MagicAttack, 그 밖은 Attack.
		-- 예전에는 계열(지능=MagicAttack)로 골랐지만, 계열과 피해 종류가 갈라진 뒤(예: 솜씨 계열 마법 스킬)에는 피해 종류(DamageModel)로 고른다.
		if statKey == "TRI" then return self:GetGloveFistAttack() end
		if damageModel == "Magic" then return self:GetGearStat("MagicAttack") end
		return self:GetGearStat("Attack")
	end

	method integer GetSkillCore(any row)
		-- 스킬 피해 코어 = 계열 공격력 + 무기 수치(DamageModel 기준) + 장비 스킬 공격력 + 스킬 기본 위력(SkillPower).
		local stat = self:GetSkillScaleStat(row)
		local skillPower = 0
		if row ~= nil then skillPower = math.floor(self:SkillNumber(row, "SkillPower", 0)) end
		return self:GetSkillStatPower(row) + self:GetWeaponAttackFor(stat, self:SkillText(row, "DamageModel")) + self:GetGearStat("SkillAttack") + skillPower
	end

	method string GetEquippedWeaponType()
		-- 주무기의 평타 방식(item_dataset.WeaponType: Melee 기본 / Wand / Nature). 서버·클라 공용.
		-- 직업 제한을 거친 실효 주무기(자동 주무기 포함) 기준이다.
		local inv = self.Entity:GetComponent("script.PlayerInventory")
		if not isvalid(inv) then return "Melee" end
		---@type PlayerInventory
		local p = inv
		local key = p:GetGearKey("weapon")
		if key == "" then return "Melee" end
		local t = p:GetItemText(p:GetBaseItemName(key), "WeaponType")
		if t == "" then return "Melee" end
		return t
	end

	method table GetWeaponAttackList(string weaponType)
		-- WeaponAttackDataSet 에서 이 무기 종류의 행을 { key, mode, stage, hold } 목록으로 캐시한다 (정적 데이터라 한 번만 읽는다).
		local cache = self._T.WeaponAttackCache
		if cache == nil then
			cache = {}
			self._T.WeaponAttackCache = cache
		end
		local list = cache[weaponType]
		if list ~= nil then return list end
		list = {}
		local ds = _DataService:GetTable("WeaponAttackDataSet")
		if ds ~= nil then
			for i = 1, ds:GetRowCount() do
				if ds:GetCell(i, "WeaponType") == weaponType then
					list[#list + 1] = {
						key = ds:GetCell(i, "Key"),
						mode = ds:GetCell(i, "Mode"),
						stage = math.floor(tonumber(ds:GetCell(i, "Stage")) or 1),
						hold = tonumber(ds:GetCell(i, "HoldSeconds")) or 0,
						-- 이 패시브(PassiveStat)를 배워야 쓰는 변형(투척 숙련 → 단검 탭 투척). 공란 = 항상.
						req = ds:GetCell(i, "RequirePassive") or "",
					}
				end
			end
		end
		cache[weaponType] = list
		return list
	end

	method any GetWeaponAttackRow(string weaponType, string mode, integer stage)
		-- 무기 종류·방식(Tap/Charge)·단계의 WeaponAttackDataSet 행. 없거나 RequirePassive 를 아직 배우지 않았으면 nil.
		for _, e in ipairs(self:GetWeaponAttackList(weaponType)) do
			if e.mode == mode and e.stage == stage and (e.req == "" or self:GetPassiveBonus(e.req) > 0) then
				local ds = _DataService:GetTable("WeaponAttackDataSet")
				if ds ~= nil then return ds:FindRow("Key", e.key) end
			end
		end
		return nil
	end

	method integer GetChargeStageFor(string weaponType, number seconds)
		-- 충전 시간(초)이 도달한 가장 높은 충전 단계. 1단계 미달이거나 충전 행이 없는 무기면 0. 서버·클라 공용.
		local best = 0
		local bestHold = -1
		for _, e in ipairs(self:GetWeaponAttackList(weaponType)) do
			if e.mode == "Charge" and e.hold <= seconds and e.hold > bestHold then
				best = e.stage
				bestHold = e.hold
			end
		end
		return best
	end

	method integer ComputeWeaponAttackDamage(any row)
		-- 무기 평타 변형의 피해(또는 회복량) = (계열 공격력 + 무기 수치) × 배율.
		-- 평타라서 장비 SkillAttack 은 더하지 않는다 (SkillAttack = 평타를 뺀 모든 스킬).
		local stat = self:SkillText(row, "Stat")
		if stat == "" then stat = "STR" end
		local weapon = self:GetWeaponAttackFor(stat, self:SkillText(row, "DamageModel"))
		return math.floor((self:GetStatPower(stat) + weapon) * self:SkillNumber(row, "Multiplier", 1.0))
	end

	method string GetSkillDamageLine(any row)
		-- 스킬 상세 패널용 피해 설명: 계열·배율·현재 능력치 기준 1타 피해(몬스터 방어 적용 전).
		-- 미해금 스킬은 Lv1 기준으로 보여 준다. 피해가 없는 스킬은 "".
		if not self:IsDamageSkillRow(row) then return "" end
		local skillId = self:SkillText(row, "SkillId")
		local level = self:GetEffectiveSkillLevel(row)
		local shownLevel = level
		if shownLevel < 1 then shownLevel = 1 end
		local mul = self:GetEffectiveDamageMultiplier(skillId, shownLevel)
		local stat = self:GetSkillScaleStat(row)
		local core = self:GetSkillCore(row)
		local throwBonus = 0
		if self:SkillText(row, "DamageModel") == "Throw" then throwBonus = self:GetPassiveBonus("ThrowDamagePct") end
		local dmg = math.floor(core * mul * (1 + throwBonus))
		local pct = math.floor(mul * 100 + 0.5)
		local line = "피해: " .. self:GetStatLabel(stat) .. " 계열 공격력 기준 " .. tostring(pct) .. "%"
		line = line .. "\n현재 1타 약 " .. tostring(dmg) .. " (위력 " .. tostring(core) .. " × " .. tostring(pct) .. "%"
		if level < 1 then line = line .. ", Lv1 기준" end
		line = line .. ")"
		-- 보조 능력치(SubStat): 주 능력치 × 상한까지 주 능력치처럼 반영 — 현재 인정분/상한을 보여 준다.
		local sub = self:SkillText(row, "SubStat")
		if sub ~= "" and sub ~= stat then
			local cap = math.max(0, self:SkillNumber(row, "SubStatCap", 0))
			local limit = math.floor(self:GetPowerStatPoints(stat) * cap + 0.0001)
			line = line .. "\n" .. self:GetStatLabel(sub) .. "도 " .. self:GetStatLabel(stat) .. "의 "
				.. tostring(math.floor(cap * 100 + 0.5)) .. "%까지 위력에 반영 (현재 "
				.. tostring(self:GetSubStatPoints(row)) .. "/" .. tostring(limit) .. ")"
		end
		if throwBonus > 0 then line = line .. "\n투척 피해 보너스 +" .. tostring(math.floor(throwBonus * 100 + 0.5)) .. "%" end
		local critBonus = self:SkillNumber(row, "CritBonus", 0)
		if critBonus > 0 then
			line = line .. "\n치명 확률 +" .. tostring(math.floor(critBonus * 100 + 0.5)) .. "% (현재 " .. tostring(math.floor(self:GetCritChanceFor(skillId) * 100 + 0.5)) .. "%)"
		end
		local per = self:SkillNumber(row, "DamagePerLevel", 0)
		if per > 0 then
			line = line .. "\n스킬 레벨당 배율 +" .. tostring(math.floor(per * 100 + 0.5)) .. "%"
		end
		return line
	end

	@ExecSpace("ServerOnly")
	method integer ComputeSkillDamage(string skillId, number damageMul)
		-- 스킬 피해 = (계열 공격력 + 무기 + 장비 스킬 공격력 + SkillPower) × 배율.
		-- 계열은 SkillDataSet.ScaleStat(힘·솜씨·지능·교감). 손에 든 도구/장비 구분(구 WeaponSource)은 폐지 —
		-- 무기는 장비 주무기(미등록이면 보유 최고 무기)가 계열 공격력에 더해지는 것으로 일원화했다.
		local row = nil
		local ds = _DataService:GetTable("SkillDataSet")
		if ds ~= nil and skillId ~= nil and skillId ~= "" then
			row = ds:FindRow("SkillId", skillId)
		end
		local stat = self:GetSkillScaleStat(row)
		local core = self:GetSkillCore(row)
		local throwBonus = 0
		if self:SkillText(row, "DamageModel") == "Throw" then throwBonus = self:GetPassiveBonus("ThrowDamagePct") end
		local dmg = math.floor(core * damageMul * (1 + throwBonus))
		log("[DMG] skill=" .. tostring(skillId) .. " stat=" .. stat .. " core=" .. tostring(core)
			.. " mul=" .. string.format("%.2f", damageMul) .. " -> " .. tostring(dmg))
		return dmg
	end

	@ExecSpace("ServerOnly")
	method void ExecuteAreaDamageSkill(string skillId, number damageMul, Vector2 dir, number boxSize, number reach, number width)
		-- Melee / Ultimate: emit a damage box (ahead of the player by `reach`, or centered when reach == 0)
		-- that only hits monster HitBoxes, reusing PlayerCombat's CalcDamage / IsAttackTarget path.
		-- boxSize = 시전 방향 길이, width = 좌우 폭 (같으면 정사각). 방향이 없으면(Ultimate) 정사각.
		local combat = self.Entity:GetComponent("script.PlayerCombat")
		if not isvalid(combat) then return end
		---@type PlayerCombat
		local c = combat
		
		local finalDmg = self:ComputeSkillDamage(skillId, damageMul)
		local myPos = self.Entity.TransformComponent.WorldPosition
		local center = Vector2(myPos.x + dir.x * reach, myPos.y + dir.y * reach)
		local size = Vector2(boxSize, boxSize)
		if dir.x ~= 0 then
			size = Vector2(boxSize, width)
		elseif dir.y ~= 0 then
			size = Vector2(width, boxSize)
		end
		local shape = BoxShape(center, size, 0)
		
		local prev = c.PendingDamage
		c.PendingDamage = finalDmg
		c:AttackFast(shape, nil, CollisionGroups.HitBox)
		c.PendingDamage = prev
		log("[SKILL] Area damage " .. finalDmg .. " box " .. string.format("%.1fx%.1f", size.x, size.y) .. " at (" .. string.format("%.1f, %.1f", center.x, center.y) .. ")")
	end

	@ExecSpace("ServerOnly")
	method void ExecuteDashSkill(string skillId, integer dirX, integer dirY, number damageMul)
		-- Teleport-dash a short distance toward facing, stopping just before the first obstacle.
		-- T66: 경로 AABB 스윕 → PendingDamage+AttackFast (4방향 축정렬).
		local body = self.Entity.KinematicbodyComponent
		local transform = self.Entity.TransformComponent
		if not isvalid(transform) then return end
		
		local currentPos
		if isvalid(body) then
			currentPos = body:GetWorldGroundPosition()
		else
			currentPos = transform.WorldPosition:ToVector2()
		end
		
		local dirVec = Vector2(dirX, dirY)
		if dirVec:Magnitude() <= 0.0001 then
			dirVec = Vector2(self.LastDirectionX, self.LastDirectionY)
			if dirVec:Magnitude() <= 0.0001 then dirVec = Vector2(-1, 0) end
		end
		dirVec = dirVec:Normalize()
		
		local maxDist = 5.0
		local step = 0.5
		local finalPos = currentPos
		for d = step, maxDist, step do
			local checkPos = currentPos + dirVec * d
			if self:IsObstacle(checkPos, 0.3, currentPos) then break end
			finalPos = checkPos
		end
		
		if isvalid(body) then
			body:SetWorldPosition(Vector2(finalPos.x, finalPos.y))
		else
			transform.WorldPosition = Vector3(finalPos.x, finalPos.y, transform.WorldPosition.z)
		end

		local mul = damageMul or 0
		if mul > 0 and self:IsCombatSkillMap() then
			local combat = self.Entity:GetComponent("script.PlayerCombat")
			if isvalid(combat) then
				---@type PlayerCombat
				local c = combat
				local finalDmg = self:ComputeSkillDamage(skillId, mul)
				-- 경로 판정 여유 = AreaWidth / 2 (공란 2.4 → 기존 1.2). 경로 양옆과 앞뒤에 같은 여유를 둔다.
				local dashRow = _DataService:GetTable("SkillDataSet"):FindRow("SkillId", skillId)
				local margin = math.max(0.5, self:SkillNumber(dashRow, "AreaWidth", 2.4) * 0.5)
				local minX = math.min(currentPos.x, finalPos.x) - margin
				local maxX = math.max(currentPos.x, finalPos.x) + margin
				local minY = math.min(currentPos.y, finalPos.y) - margin
				local maxY = math.max(currentPos.y, finalPos.y) + margin
				local center = Vector2((minX + maxX) * 0.5, (minY + maxY) * 0.5)
				local size = Vector2(math.max(1.5, maxX - minX), math.max(1.5, maxY - minY))
				local prev = c.PendingDamage
				c.PendingDamage = finalDmg
				c:AttackFast(BoxShape(center, size, 0), nil, CollisionGroups.HitBox)
				c.PendingDamage = prev
				log("[T66][DASH] dmg=" .. finalDmg .. " box=(" .. string.format("%.1f,%.1f", size.x, size.y) .. ") at (" .. string.format("%.1f,%.1f", center.x, center.y) .. ")")
			end
		end
		log("[SKILL] Dash to (" .. string.format("%.1f, %.1f", finalPos.x, finalPos.y) .. ")")
	end

	@ExecSpace("ServerOnly")
	method boolean SpawnPlayerProjectile(table spec)
		-- 투사체 한 발 생성 (스킬·무기 평타 공용). spec 은 호출자가 자기 데이터셋 행에서 만든 값 묶음이다.
		-- 행을 직접 넘기지 않는 이유: 열 이름이 데이터셋마다 달라 없는 열을 읽으면 LEA-3011 이 난다 (pcall 로도 로그는 남는다).
		-- spec: name, skillId("" = 스킬이 아닌 평타), damage, dx, dy, ruid, tint(Color|nil), speed, life, visual, hitSize,
		--       pierce, splashSize, splashMul, impactOnly, grow, hitRUID, hitScale
		local map = self.Entity.CurrentMap
		local modelId = _EntryService:GetModelIdByName("Projectile_Fireball")
		if not isvalid(map) or modelId == nil or modelId == "" then return false end
		local pos = self.Entity.TransformComponent.WorldPosition
		local proj = _SpawnService:SpawnByModelId(modelId, "Projectile_" .. spec.name, Vector3(pos.x + spec.dx * 1.2, pos.y + spec.dy * 1.2, pos.z), map)
		if not isvalid(proj) then return false end
		local sprite = proj.SpriteRendererComponent
		if isvalid(sprite) then
			if spec.ruid ~= "" then sprite.SpriteRUID = spec.ruid end
			-- 틴트는 곱연산이다(규칙 61) — 공식 리소스 하나를 색만 바꿔 여러 투사체로 쓴다.
			if spec.tint ~= nil then sprite.Color = spec.tint end
			sprite.IgnoreMapLayerCheck = true
			sprite.SortingLayer = _RenderLayers.EntityLayer
			sprite.OrderInLayer = 500
			sprite.FlipX = spec.dx > 0
		end
		if not isvalid(proj.KinematicbodyComponent) then proj:AddComponent("KinematicbodyComponent") end
		proj.KinematicbodyComponent.EnableJump = false
		proj.KinematicbodyComponent.EnableShadow = false
		proj.KinematicbodyComponent.EnableTileCollision = false
		proj:AddComponent("script.Projectile")
		local p = proj:GetComponent("script.Projectile")
		if not isvalid(p) then
			proj:Destroy()
			return false
		end
		p:Initialize(self.Entity, Vector2(spec.dx, spec.dy), spec.damage, spec.speed, spec.hitRUID)
		p.SkillId = spec.skillId
		p.HitEffectScale = spec.hitScale
		p.LifeTime = spec.life
		-- VisualSize: 그림 배율만(판정 HitSize 와 분리).
		p.VisualSize = spec.visual
		p.HitSize = spec.hitSize
		p.PierceCount = spec.pierce
		p.SplashSize = spec.splashSize
		p.SplashMultiplier = spec.splashMul
		p.ImpactOnly = spec.impactOnly
		p.Grow = spec.grow
		return true
	end

	@ExecSpace("ServerOnly")
	method void ExecuteProjectileSkill(string skillId, number damageMul, integer dirX, integer dirY, string hitEffectRUID, number hitEffectScale)
		local map = self.Entity.CurrentMap
		local modelId = _EntryService:GetModelIdByName("Projectile_Fireball")
		if not isvalid(map) or modelId == nil or modelId == "" then return end
		local row = _DataService:GetTable("SkillDataSet"):FindRow("SkillId", skillId)
		if row == nil then return end
		local count = math.max(1, math.min(9, math.floor(self:SkillNumber(row, "ProjectileCount", 1))))
		local spread = math.rad(self:SkillNumber(row, "SpreadDegrees", 0))
		local damage = self:ComputeSkillDamage(skillId, damageMul)
		-- 발마다 같은 값(방향만 다르다). ProjectileScale 공란이면 ProjectileSize 를 그림 배율로도 쓴다.
		local spec = {
			name = skillId,
			skillId = skillId,
			damage = damage,
			dx = 0,
			dy = 0,
			ruid = self:SkillText(row, "ProjectileRUID"),
			tint = nil,
			speed = self:SkillNumber(row, "ProjectileSpeed", 6),
			life = self:SkillNumber(row, "ProjectileLife", 2),
			visual = self:SkillNumber(row, "ProjectileScale", self:SkillNumber(row, "ProjectileSize", 2)),
			hitSize = self:SkillNumber(row, "ProjectileSize", 1.6),
			pierce = math.floor(self:SkillNumber(row, "PierceCount", 1)),
			splashSize = self:SkillNumber(row, "SplashSize", 0),
			splashMul = self:SkillNumber(row, "SplashMultiplier", 0),
			impactOnly = self:SkillText(row, "ImpactOnly") == "true",
			grow = self:SkillText(row, "GrowProjectile") == "true",
			hitRUID = hitEffectRUID,
			hitScale = hitEffectScale,
		}
		for i = 1, count do
			local angle = count > 1 and (-spread * 0.5 + spread * (i - 1) / (count - 1)) or 0
			spec.dx = dirX * math.cos(angle) - dirY * math.sin(angle)
			spec.dy = dirX * math.sin(angle) + dirY * math.cos(angle)
			self:SpawnPlayerProjectile(spec)
		end
		log("[SKILL] projectile skill=" .. skillId .. " count=" .. count)
	end

	@ExecSpace("ServerOnly")
	method void PlayWeaponAttackPresentation(any row, integer dirX, integer dirY, boolean atCaster)
		-- 무기 평타 변형의 시전 모션·이펙트·사운드 (스킬 시전과 같은 장치). 열이 비어 있으면 그 항목은 건너뛴다.
		local castAction = self:SkillText(row, "CastAction")
		if castAction ~= "" then self:MulticastPlayCastAction(castAction) end
		local fx = self:SkillText(row, "EffectRUID")
		if fx ~= "" then
			local pos = self.Entity.TransformComponent.WorldPosition
			local off = 0.0
			if not atCaster then off = self.SkillEffectForwardOffset end
			self:MulticastPlayEffectEx(fx, Vector3(pos.x + dirX * off, pos.y + dirY * off, pos.z), dirX > 0, self:SkillNumber(row, "EffectScale", 1))
		end
		local snd = self:SkillText(row, "SoundRUID")
		if snd ~= "" then self:MulticastPlaySkillSound(snd) end
	end

	@ExecSpace("ServerOnly")
	method void FireWeaponProjectile(any row, integer dirX, integer dirY)
		-- 무기 평타 변형(WeaponAttackDataSet Kind=Projectile): 자연 무기 탭 정령탄 · 마법봉 충전탄.
		-- 피해 = (계열 공격력 + 무기 수치) × 배율. 스킬이 아니므로 skillId 는 "" (상태이상·콤보·넉백 예외 없음 — 평타는 넉백을 준다).
		local tint = nil
		local tintText = self:SkillText(row, "ProjectileTint")
		if tintText ~= "" then
			local rgb = self:SplitList(tintText, "|")
			tint = Color(tonumber(rgb[1]) or 1, tonumber(rgb[2]) or 1, tonumber(rgb[3]) or 1, 1)
		end
		local damage = self:ComputeWeaponAttackDamage(row)
		-- DamageBonusStat: 이 변형에만 붙는 패시브 피해 보너스(투척 숙련 → BasicThrowDamagePct). 공란 = 없음.
		local bonusStat = self:SkillText(row, "DamageBonusStat")
		if bonusStat ~= "" then damage = math.floor(damage * (1 + math.max(0, self:GetPassiveBonus(bonusStat)))) end
		local spec = {
			name = "Basic",
			skillId = "",
			damage = damage,
			dx = dirX,
			dy = dirY,
			ruid = self:SkillText(row, "ProjectileRUID"),
			tint = tint,
			speed = self:SkillNumber(row, "ProjectileSpeed", 8),
			life = self:SkillNumber(row, "ProjectileLife", 0.7),
			visual = self:SkillNumber(row, "ProjectileScale", self:SkillNumber(row, "ProjectileSize", 1.2)),
			hitSize = self:SkillNumber(row, "ProjectileSize", 1.2),
			pierce = math.floor(self:SkillNumber(row, "PierceCount", 1)),
			splashSize = 0,
			splashMul = 0,
			impactOnly = false,
			grow = false,
			hitRUID = self:SkillText(row, "HitEffectRUID"),
			hitScale = self:SkillNumber(row, "HitEffectScale", 1.0),
		}
		if not self:SpawnPlayerProjectile(spec) then return end
		self:PlayWeaponAttackPresentation(row, dirX, dirY, false)
		log("[WEAPON] shot " .. self:SkillText(row, "Key") .. " dmg=" .. tostring(damage))
	end

	@ExecSpace("ServerOnly")
	method void DoHealPulse(any row)
		-- 자연 무기 충전 방출(WeaponAttackDataSet Kind=HealPulse): 반경 안의 아군(자신 포함)을 즉시 회복한다.
		-- 회복량 = (계열 공격력 + 무기 수치) × 배율 × (1 + HealPowerPct). 지연 콜백이 없는 즉시 판정이다.
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return end
		local radius = self:SkillNumber(row, "Radius", 3)
		local center = self.Entity.TransformComponent.WorldPosition
		local amount = math.floor(self:ComputeWeaponAttackDamage(row) * (1 + self:GetPassiveBonus("HealPowerPct")))
		local healed = 0
		for _, player in pairs(_UserService:GetUsersByMapName(map.Name)) do
			local pc = player:GetComponent("script.PlayerController")
			if isvalid(pc) and not pc.IsDead then
				local p = player.TransformComponent.WorldPosition
				if Vector2.Distance(p:ToVector2(), center:ToVector2()) <= radius then
					local hp = player.PlayerComponent
					if hp ~= nil then
						hp.Hp = math.min(hp.MaxHp, hp.Hp + amount)
						healed = healed + 1
					end
				end
			end
		end
		-- 소환수도 회복한다(§3.4 생명 펄스: 자신·다른 플레이어·소환수).
		self:HealAllSummonsNear(map, center, radius, amount)
		-- 소환수 강화(WeaponAttackDataSet.SummonBuffPct/Seconds — 충전 단계별). 소환사가 슬롯 없이 회복·강화를 함께 준다.
		local buffPct = self:SkillNumber(row, "SummonBuffPct", 0)
		local buffSec = self:SkillNumber(row, "SummonBuffSeconds", 0)
		local buffed = self:BuffAllSummonsNear(map, center, radius, buffPct, buffSec)
		self:PlayWeaponAttackPresentation(row, self.LastDirectionX, self.LastDirectionY, true)
		local playerComp = self.Entity.PlayerComponent
		if playerComp ~= nil then
			local msg = "[생명 펄스] 회복 " .. tostring(amount)
			if buffed > 0 then msg = msg .. " · 소환수 공격 +" .. tostring(math.floor(buffPct * 100 + 0.5)) .. "% " .. tostring(math.floor(buffSec)) .. "초" end
			self:ClientShowMineFeedback(msg, playerComp.UserId)
		end
		log("[WEAPON] heal pulse amount=" .. tostring(amount) .. " radius=" .. tostring(radius) .. " healed=" .. tostring(healed) .. " summonBuffed=" .. tostring(buffed))
	end
	@ExecSpace("Multicast")
	method void MulticastPlayEffect(string effectRUID, Vector3 pos)
		-- 하위 호환: 정렬 옵션 포함 기본 재생 (플립/스케일 기본값).
		self:MulticastPlayEffectEx(effectRUID, pos, self.LastDirectionX > 0, self.SkillEffectScale)
	end

	@ExecSpace("Multicast")
	method void MulticastPlayEffectEx(string effectRUID, Vector3 pos, boolean flipX, number scale)
		-- T70: 클라만 재생. 시그니처 유지(Monster·Summon·Projectile 호출 호환 — 규칙 46). 회전이 필요하면 MulticastPlayEffectDir.
		self:PlayEffectLocal(effectRUID, pos, flipX, scale, 0.0, 1.0, -1)
	end

	@ExecSpace("Multicast")
	method void MulticastPlayEffectDir(string effectRUID, Vector3 pos, boolean flipX, number scale, number zRotation, number playRate, integer endFrame)
		-- 방향성 스킬 이펙트: 좌우 반전 + Z 회전(도, 반시계 +). 위·아래 시전 때 가로 그림을 세운다. PlayerController 내부 전용.
		self:PlayEffectLocal(effectRUID, pos, flipX, scale, zRotation, playRate, endFrame)
	end

	@ExecSpace("Multicast")
	method void MulticastPlayEffectFollow(string effectRUID, boolean flipX, number scale, number height, number playRate, integer endFrame)
		-- 시전자에 붙어 따라다니는 이펙트(EffectAnchor=follow). 부모(플레이어) Scale 이 곱해지므로 로컬 값은 나눠서 넘긴다.
		if effectRUID == nil or effectRUID == "" then return end
		if not self:IsClient() then return end
		local ps = self.Entity.TransformComponent.Scale
		local sx = math.max(0.01, math.abs(ps.x))
		local sy = math.max(0.01, math.abs(ps.y))
		local s = scale
		if s == nil or s <= 0 then s = 1.0 end
		local opts = { IgnoreMapLayerCheck = true, SortingLayer = _RenderLayers.EntityLayer, OrderInLayer = 500, FlipX = flipX == true }
		if playRate ~= nil and playRate > 0 and playRate ~= 1 then opts.PlayRate = playRate end
		if endFrame ~= nil and endFrame >= 0 then opts.EndFrameIndex = endFrame end
		local serial = _EffectService:PlayEffectAttached(effectRUID, self.Entity, Vector3(0, height / sy, 0), 0.0, Vector3(s / sx, s / sy, 1), false, opts)
		log("[T71][FX] variant=follow serial=" .. tostring(serial) .. " ruid=" .. effectRUID)
	end

	method void PlayEffectLocal(string effectRUID, Vector3 pos, boolean flipX, number scale, number zRotation, number playRate, integer endFrame)
		-- 클라만 재생. full 옵션 → min(IgnoreMapLayerCheck만) → none 폴백. EffectService.d.mlua options 키 실확인.
		-- T71(지휘자 런타임 실측 2026-07-18): instigator=nil이면 클라 생성이 조용히 실패(serial=0).
		-- 반드시 유효 엔티티(self.Entity)를 넘길 것 — SpawnByModelId parent nil 금지(핵심 규칙 4)와 동계열 함정.
		if effectRUID == nil or effectRUID == "" then return end
		if not self:IsClient() then return end
		local s = scale
		if s == nil or s <= 0 then s = 1.0 end
		local rot = zRotation or 0.0
		local scaleVec = Vector3(s, s, s)
		local fullOpts = {
			IgnoreMapLayerCheck = true,
			SortingLayer = _RenderLayers.EntityLayer,
			OrderInLayer = 500,
			FlipX = flipX == true,
		}
		-- 재생 속도·끝 프레임은 지정됐을 때만 옵션에 넣는다(기본 호출은 예전과 같은 옵션).
		if playRate ~= nil and playRate > 0 and playRate ~= 1 then fullOpts.PlayRate = playRate end
		if endFrame ~= nil and endFrame >= 0 then fullOpts.EndFrameIndex = endFrame end
		local serial = _EffectService:PlayEffect(effectRUID, self.Entity, pos, rot, scaleVec, false, fullOpts)
		log("[T71][FX] variant=full serial=" .. tostring(serial) .. " ruid=" .. effectRUID)
		if serial ~= nil and serial ~= 0 then return end
		local minOpts = { IgnoreMapLayerCheck = true }
		serial = _EffectService:PlayEffect(effectRUID, self.Entity, pos, rot, scaleVec, false, minOpts)
		log("[T71][FX] variant=min serial=" .. tostring(serial) .. " ruid=" .. effectRUID)
		if serial ~= nil and serial ~= 0 then return end
		serial = _EffectService:PlayEffect(effectRUID, self.Entity, pos, rot, scaleVec, false, nil)
		log("[T71][FX] variant=none serial=" .. tostring(serial) .. " ruid=" .. effectRUID)
		if serial == nil or serial == 0 then
			log_warning("[T71][FX] ALL-FAIL ruid=" .. effectRUID)
		end
	end

	method boolean IsSkillEffectFlipX(any row, integer dirX)
		-- 스킬 이펙트 좌우 반전 여부. EffectFacing 공란·left = 원본이 왼쪽을 본다(오른쪽 시전 때 반전),
		-- right = 원본이 오른쪽을 본다(왼쪽 시전 때 반전). 공식 리소스 대부분은 왼쪽이지만 예외가 있다(스크류 펀치 — 규칙 65).
		if self:SkillText(row, "EffectFacing") == "right" then
			return dirX < 0
		end
		return dirX > 0
	end

	method number GetSkillEffectHeight(any row, integer dirX)
		-- 좌우 시전 때 이펙트 피벗을 들어 올리는 높이(월드 유닛, EffectHeight 공란 = 0).
		-- 원본 이펙트는 배율 1 캐릭터(키 약 0.7칸) 기준이라, 배율 2.8 플레이어(키 약 2칸)의 팔 높이에 맞추려면 올려야 한다.
		-- 위·아래 시전은 그림을 세우므로(GetSkillEffectRotation) 올리지 않는다.
		if dirX == 0 then return 0.0 end
		return self:SkillNumber(row, "EffectHeight", 0)
	end

	method number GetSkillEffectRotation(any row, integer dirX, integer dirY)
		-- 방향성 이펙트(EffectFacing 지정)만 위·아래 시전 때 가로 그림을 시전 방향으로 세운다. 도 단위, 반시계 +.
		-- 공란이면 기존처럼 회전하지 않는다(대칭형 이펙트가 대부분이라 일괄 회전하지 않는다).
		local facing = self:SkillText(row, "EffectFacing")
		if facing == "" or dirX ~= 0 or dirY == 0 then return 0.0 end
		local up = dirY > 0
		if facing == "right" then
			if up then return 90.0 end
			return -90.0
		end
		if up then return -90.0 end
		return 90.0
	end

	@ExecSpace("Multicast")
	method void MulticastPlayCastAction(string actionName)
		-- T70: 시전 모션 — MineState OnEnter와 동일 (body ActionStateChangedEvent, Onetime, PlayRate 1.33).
		if actionName == nil or actionName == "" then return end
		if not self:IsClient() then return end
		local avatarRenderer = self.Entity.AvatarRendererComponent
		if not isvalid(avatarRenderer) then return end
		local body = avatarRenderer:GetBodyEntity()
		if not isvalid(body) then return end
		local event = ActionStateChangedEvent()
		event.CoreActionName = actionName
		event.PartsActionName = actionName
		event.PlayType = SpriteAnimClipPlayType.Onetime
		event.PlayRate = 1.33
		body:SendEvent(event)
		log("[T70][CAST] play action=" .. actionName)
	end

	method boolean IsChanneling()
		-- 채널 스킬(쇠망치 회전) 시전 중인가. 서버·클라가 각자 자기 시계로 _T.ChannelUntil 을 둔다(서버 = 시전 확정 시, 클라 = MulticastBeginChannel).
		return _UtilLogic.ElapsedSeconds < (tonumber(self._T.ChannelUntil) or 0)
	end

	@ExecSpace("Multicast")
	method void MulticastBeginChannel(string mode, number seconds, string action)
		-- 채널 시작을 모든 클라에 알린다. 로컬은 입력 차단(IsChanneling), spin 은 모든 클라가 회전 연출(UpdateChannelVisual).
		if not self:IsClient() then return end
		self._T.ChannelUntil = _UtilLogic.ElapsedSeconds + seconds
		self._T.ChannelMode = mode
		self._T.ChannelAction = action
		self._T.ChannelBeat = 0
		self._T.ChannelNextBeat = 0
		local pcc = self.Entity.PlayerControllerComponent
		self._T.ChannelFaceX = -1
		if isvalid(pcc) then self._T.ChannelFaceX = pcc.LookDirectionX end
		self._T.ChannelSign = -1
		if mode == "spin" and self.Entity == _UserService.LocalPlayer then self:SuspendArrowActionKeys() end
	end

	@ExecSpace("ClientOnly")
	method void SuspendArrowActionKeys()
		-- 회전 중에는 엔진 PlayerControllerComponent 의 방향키 액션을 뗀다 — 컨트롤러가 방향키로 좌우를 정하고(회전 반전을 덮음)
		-- 자체 이동까지 더해 속도가 겹쳤다(2026-10-06 Play). 우리 이동은 _InputService 로 키를 직접 읽어 영향 없다.
		-- 원래 액션 이름을 저장해 RestoreArrowActionKeys 가 되돌린다(WASD 를 영구히 떼는 OnBeginPlay 와 같은 API).
		if self._T.SpinKeys ~= nil then return end
		local pcc = self.Entity.PlayerControllerComponent
		if not isvalid(pcc) then return end
		local saved = {}
		for _, key in ipairs({ KeyboardKey.LeftArrow, KeyboardKey.RightArrow, KeyboardKey.UpArrow, KeyboardKey.DownArrow }) do
			local name = pcc:GetActionName(key)
			if name ~= nil and name ~= "" then
				saved[#saved + 1] = { key = key, name = name }
				pcc:RemoveActionKey(key)
			end
		end
		self._T.SpinKeys = saved
		log("[CHANNEL] arrow action keys suspended n=" .. tostring(#saved))
	end

	@ExecSpace("ClientOnly")
	method void RestoreArrowActionKeys()
		-- SuspendArrowActionKeys 가 뗀 방향키 액션을 원래 이름으로 다시 붙인다.
		local saved = self._T.SpinKeys
		if saved == nil then return end
		self._T.SpinKeys = nil
		local pcc = self.Entity.PlayerControllerComponent
		if not isvalid(pcc) then return end
		for _, e in ipairs(saved) do
			pcc:SetActionKey(e.key, e.name)
		end
		log("[CHANNEL] arrow action keys restored n=" .. tostring(#saved))
	end

	@ExecSpace("ClientOnly")
	method void ApplySpinFacing()
		-- 회전 중이면 현재 박자의 좌우 방향을 다시 쓴다. OnUpdate 의 이동 처리(MoveToDirection) 직후에 불러
		-- 이동 입력이 정한 방향을 그 프레임 안에서 덮는다.
		if self._T.ChannelMode ~= "spin" then return end
		local pcc = self.Entity.PlayerControllerComponent
		if isvalid(pcc) then pcc.LookDirectionX = tonumber(self._T.ChannelSign) or -1 end
	end

	@ExecSpace("ClientOnly")
	method void UpdateChannelVisual()
		-- 회전 연출: MSW 아바타에는 회전 동작이 없어서, SpinBeatSeconds 마다 좌우를 뒤집고 두 박자마다 휘두르기(CastAction)를
		-- 다시 틀어 "망치를 들고 도는" 모습을 만든다. 끝나면 원래 방향과 서기/걷기 모션으로 되돌린다.
		if self._T.ChannelMode ~= "spin" then return end
		local now = _UtilLogic.ElapsedSeconds
		local pcc = self.Entity.PlayerControllerComponent
		local pos = self.Entity.TransformComponent.WorldPosition
		local last = self._T.ChannelLastPos
		self._T.ChannelLastPos = pos
		if now >= (tonumber(self._T.ChannelUntil) or 0) then
			self._T.ChannelMode = nil
			self:RestoreArrowActionKeys()
			if isvalid(pcc) and self._T.ChannelFaceX ~= nil then pcc.LookDirectionX = self._T.ChannelFaceX end
			-- 마지막 휘두르기 프레임에 멈춰 있지 않게 현재 이동 여부에 맞는 기본 모션으로 되돌린다.
			local moving = last ~= nil and Vector2.Distance(pos:ToVector2(), last:ToVector2()) > 0.001
			local ev = BodyActionStateChangeEvent()
			if moving then ev.ActionState = MapleAvatarBodyActionState.Walk else ev.ActionState = MapleAvatarBodyActionState.Stand end
			ev.needResetAction = true
			self.Entity:SendEvent(ev)
			return
		end
		if now < (tonumber(self._T.ChannelNextBeat) or 0) then return end
		self._T.ChannelNextBeat = now + self.SpinBeatSeconds
		local beat = (tonumber(self._T.ChannelBeat) or 0) + 1
		self._T.ChannelBeat = beat
		if beat % 2 == 0 then self._T.ChannelSign = 1 else self._T.ChannelSign = -1 end
		if isvalid(pcc) then pcc.LookDirectionX = self._T.ChannelSign end
		local action = self._T.ChannelAction or ""
		if action ~= "" and beat % 2 == 1 then
			local avatarRenderer = self.Entity.AvatarRendererComponent
			if isvalid(avatarRenderer) then
				local body = avatarRenderer:GetBodyEntity()
				if isvalid(body) then
					local event = ActionStateChangedEvent()
					event.CoreActionName = action
					event.PartsActionName = action
					event.PlayType = SpriteAnimClipPlayType.Onetime
					event.PlayRate = 2.0
					body:SendEvent(event)
				end
			end
		end
	end

	@ExecSpace("Multicast")
	method void MulticastPlayHitSound(string soundRUID)
		-- 몬스터 피격음(도구 HitSoundRUID). 맨손 기본음은 DefaultHitSoundVolume 으로 줄여 재생한다 — 스킬 시전음과 볼륨을 따로 두려고 분리.
		if soundRUID == nil or soundRUID == "" then return end
		_BGMManager:PlayInGameSound(soundRUID, self:GetToolSoundVolume(soundRUID, "HitSoundRUID"))
	end

	@ExecSpace("Multicast")
	method void MulticastPlaySkillSound(string soundRUID)
		-- T46: 시전 사운드 (SoundService — 클라 재생).
		if soundRUID == nil or soundRUID == "" then return end
		_BGMManager:PlayInGameSound(soundRUID, 1.0)
	end

	@ExecSpace("ServerOnly")
	@EventSender("Self")
	handler HandlePlayerHit(HitEvent event)
		-- 피해와 i-frame은 유지하고, 같은 면역 창에서 HIT 경직·넉백만 건너뛴다.
		if self.IsDead then return end
		if not isvalid(event.AttackerEntity) then return end
		
		local playerComp = self.Entity.PlayerComponent
		if playerComp == nil then return end

		local monsterAttack = event.AttackerEntity:GetComponent("script.MonsterMeleeAttack")
		local isTouchHit = false
		if event.Extra == "touch" or (isvalid(monsterAttack) and monsterAttack.LastAttackInfo == "touch") then
			isTouchHit = true
		end
		-- 잔존 장판 도트: 피해만 받는다(넉백·HIT 경직·정식 i-frame 모두 없음).
		local isDotHit = event.Extra == "dot"

		local now = _UtilLogic.ElapsedSeconds

		-- 도착 보호: 맵 진입 직후(전환 커버 아래·렌더 안정 전)에는 피해·넉백·경직을 모두 무시한다.
		if now < (tonumber(self._T.ArrivalImmuneUntil) or 0) then
			return
		end

		-- T104: 피격 i-frame 및 접촉 면역 완전 분리
		-- 1. 단순 접촉(비비기) 피격: 1.2초 접촉 면역 중이면 완전 무시. 정식 피격 i-frame(IFrameTimer)은 건드리지 않음.
		-- 2. 정식 공격(돌진/스윙/슬램): 접촉 면역과 100% 무관하게 진입. 정식 공격 간 0.4초 i-frame만 적용.
		-- 결과: 비비기 1.2초 무적 중이어도 몬스터의 돌진/정식 공격은 100% 즉시 피격 적중 보장!
		if isDotHit then
			if now < (tonumber(self._T.DotImmuneUntil) or 0) then return end
			self._T.DotImmuneUntil = now + self.DotTickImmuneSeconds
		elseif isTouchHit then
			if now < (self._T.TouchImmuneUntil or 0) then return end
			self._T.TouchImmuneUntil = now + self.TouchImmuneDuration
		else
			if self.IFrameTimer > 0 then return end
			self.IFrameTimer = 0.4
			_TimerService:SetTimerOnce(function()
				if isvalid(self.Entity) then
					self.IFrameTimer = 0.0
					log("[IFRAME] Server reset player IFrameTimer to 0.0")
				end
			end, 0.4)
		end
		self._T.LastHitWasTouch = isTouchHit
		
		if self.FishingState ~= "None" then
			self:ServerRequestCancelFishing()
		end

		-- Check contact damage from attacker
		local damage = event.TotalDamage

		if damage <= 0 then
			if isvalid(monsterAttack) then
				if isTouchHit then
					local tDmg = monsterAttack.TouchDamage
					if tDmg <= 0 or tDmg == 2 then
						tDmg = math.max(1, math.floor(monsterAttack.ContactDamage * 0.5))
					end
					damage = math.max(1, math.floor(tDmg))
				else
					damage = math.max(1, math.floor(monsterAttack.ContactDamage))
				end
			else
				damage = 5
			end
		end

		-- 방어력 감쇠 (2026-09-23 ⚖️ 방어구 시스템): 받는 피해 × 100 / (100 + 방어력).
		-- 예전엔 몬스터 피해가 0일 때의 폴백에서만 Defense 를 빼서, 실제로는 방어력이 거의 적용되지 않았다.
		local totalDef = self:GetTotalDefense()
		if totalDef > 0 then
			damage = math.max(1, math.floor(damage * 100 / (100 + totalDef) + 0.5))
		end

		if now < (self._T.TemperedUntil or 0) then damage = math.max(1, damage - (self._T.TemperedReduction or 0)) end
		local guardOn = now < (self._T.GuardUntil or 0)
		if guardOn then damage = math.max(1, math.floor(damage * (1 - (self._T.GuardReduction or 0)))) end
		-- 장비·주문 부여 DamageReductionPct(예: 철편 덧댐 룬), 최대 50%
		-- 버프(쇠망치 도발 provoke_guard 등)의 같은 키도 더한다. 합산 상한 50%.
		local buffsRed = self.Entity:GetComponent("script.PlayerBuffs")
		local buffRed = isvalid(buffsRed) and buffsRed:GetStatAdd("DamageReductionPct") or 0
		local dmgRedPct = math.min(0.5, math.max(0, self:GetPassiveBonus("DamageReductionPct") + buffRed))
		if dmgRedPct > 0 then damage = math.max(1, math.floor(damage * (1 - dmgRedPct))) end
		-- Apply damage to player HP
		playerComp.Hp = math.max(0, playerComp.Hp - damage)
		self:MarkCombat()
		if guardOn then
			local target = event.AttackerEntity
			local monster = target:GetComponent("script.Monster")
			local combat = self.Entity:GetComponent("script.PlayerCombat")
			local distance = Vector2.Distance(target.TransformComponent.WorldPosition:ToVector2(), self.Entity.TransformComponent.WorldPosition:ToVector2())
			if isvalid(monster) and isvalid(combat) and distance <= 3 then
				combat:DealSkillHit(target, math.max(1, math.floor(damage * (self._T.GuardReflection or 0))), "", "", 1)
			end
		end
		-- 저체력 자동 발동 패시브(Trigger=LowHp, 예: 불굴의 투혼 → 연쇄 강철 피부). 쓰러지는 타격이면 발동하지 않는다.
		if playerComp.Hp > 0 then
			self:FireSkillTriggers("LowHp", "")
		end

		if isDotHit then
			log("Player " .. self.Entity.Name .. " dot tick " .. damage .. ". HP remaining: " .. playerComp.Hp)
			if playerComp.Hp <= 0 then
				self:ServerDie()
			end
			return
		end

		-- HIT 경직과 넉백은 피해와 별도의 면역 창을 공유한다.
		-- 면역 중 피격은 피해·사망 처리를 유지하며 면역 종료 시각을 연장하지 않는다.
		-- ⚠ KnockbackImmuneDuration은 i-frame(0.4s)보다 반드시 커야 한다.
		local nowKb = _UtilLogic.ElapsedSeconds
		-- 슈퍼아머 버프(StatKey=SuperArmor, 강철 피부·불굴의 투혼): 피해는 받고 HIT 경직·넉백만 무시한다.
		local superArmor = false
		local buffsKb = self.Entity:GetComponent("script.PlayerBuffs")
		if isvalid(buffsKb) and buffsKb:GetStatAdd("SuperArmor") > 0 then superArmor = true end
		if nowKb < (tonumber(self._T.SuperArmorUntil) or 0) then superArmor = true end
		if superArmor then
			log("Player " .. self.Entity.Name .. " hit for " .. damage .. " damage (super armor). HP remaining: " .. playerComp.Hp)
			if playerComp.Hp <= 0 then
				self:ServerDie()
			end
			return
		end
		if not isTouchHit and nowKb < (self._T.KnockbackImmuneUntil or 0) then
			log("Player " .. self.Entity.Name .. " hit for " .. damage .. " damage (HIT/knockback immune). HP remaining: " .. playerComp.Hp)
			if playerComp.Hp <= 0 then
				self:ServerDie()
			end
			return
		end
		if not isTouchHit then
			self._T.KnockbackImmuneUntil = nowKb + self.KnockbackImmuneDuration
		end

		-- Trigger hit animation state and schedule IDLE restore on server
		-- T101: 단순 접촉 피격 시에는 StateComponent를 "HIT"로 굳히지 않는다 (정식 공격만 HIT 전환).
		if not isTouchHit then
			local sc = self.Entity.StateComponent
			if isvalid(sc) then
				sc:ChangeState("HIT")
				_TimerService:SetTimerOnce(function()
					if isvalid(self.Entity) and not self.IsDead then
						local currentSc = self.Entity.StateComponent
						if isvalid(currentSc) and currentSc.CurrentStateName == "HIT" then
							currentSc:ChangeState("IDLE")
							log("[KNOCKBACK] Server restored player state from HIT to IDLE")
						end
					end
				end, 0.2)
			end
		end
		
		-- Apply Knockback (Server-side teleport push with obstacle checking)
		local pp = self.Entity.TransformComponent.WorldPosition
		local ap = event.AttackerEntity.TransformComponent.WorldPosition
		local kx = pp.x - ap.x
		local ky = pp.y - ap.y
		local len = math.sqrt(kx * kx + ky * ky)
		if len <= 0.0001 then kx = 1 ky = 0 len = 1 end
		
		local dirX = kx / len
		local dirY = ky / len
		
		-- T101: 단순 접촉은 0.5m로 가볍게 밀어내고, 정식 공격은 1.4m, 보스는 2.4m
		local dist = 1.4
		if isTouchHit then
			dist = 0.5
		else
			local attackerMon = event.AttackerEntity:GetComponent("script.Monster")
			if isvalid(attackerMon) and (attackerMon.IsBoss or attackerMon.MonsterId == "slime_king") then
				dist = 2.4
			elseif isvalid(attackerMon) and attackerMon.MonsterId == "boar" then
				dist = 2.0
			end
		end
		local targetPos = Vector3(pp.x + dirX * dist, pp.y + dirY * dist, pp.z)
		local finalKnockPos = pp  -- Default to no movement
		
		if not self:IsObstacle(Vector2(targetPos.x, targetPos.y), 0.3, nil) then
			playerComp:SetWorldPosition(targetPos)
			finalKnockPos = targetPos
			log("[KNOCKBACK] Server pushed player to: (" .. string.format("%.2f, %.2f", targetPos.x, targetPos.y) .. ")")
		else
			local halfPos = Vector3(pp.x + dirX * (dist * 0.5), pp.y + dirY * (dist * 0.5), pp.z)
			if not self:IsObstacle(Vector2(halfPos.x, halfPos.y), 0.3, nil) then
				playerComp:SetWorldPosition(halfPos)
				finalKnockPos = halfPos
				log("[KNOCKBACK] Server pushed player (half-distance) to: (" .. string.format("%.2f, %.2f", halfPos.x, halfPos.y) .. ")")
			end
		end
		
		local knockDur = isTouchHit and 0.1 or 0.2
		self:ClientApplyKnockback(pp.x, pp.y, finalKnockPos.x, finalKnockPos.y, knockDur, isTouchHit)
		
		log("Player " .. self.Entity.Name .. " hit for " .. damage .. " damage. HP remaining: " .. playerComp.Hp .. " (isTouch=" .. tostring(isTouchHit) .. ")")
		
		-- Check Death
		if playerComp.Hp <= 0 then
			self:ServerDie()
		end
	end

	@ExecSpace("Server")
	method void ServerRequestSleep(string bedEntityId)
		-- description: Process player request to sleep in bed on server.
		if self.IsDead or self.IsSleeping then return end
		local playerComp = self.Entity.PlayerComponent
		if playerComp == nil or senderUserId ~= playerComp.UserId then return end
		
		local bed = _EntityService:GetEntity(bedEntityId)
		if not isvalid(bed) then return end
		
		local myPos = self.Entity.TransformComponent.WorldPosition
		local bedPos = bed.TransformComponent.WorldPosition
		local dist = Vector2.Distance(Vector2(myPos.x, myPos.y), Vector2(bedPos.x, bedPos.y))
		if dist > 3.0 then return end
		
		local currentMap = self.Entity.CurrentMap
		if isvalid(currentMap) and string.sub(currentMap.Name, 1, 5) == "Home_" then
			local ownerId = string.sub(currentMap.Name, 6)
			if _PersistenceManager and not _PersistenceManager:CheckGuestPermission(ownerId, senderUserId, "interact") then
				self:ShowMineFeedback("이 영지의 침대를 이용할 수 있는 권한이 없습니다.")
				return
			end
		end
		
		self.IsSleeping = true
		self.SleepStartTimeTicks = tostring(DateTime.UtcNow.Ticks)
		self._T.SleepHpAccum = 0.0
		self._T.SleepStaminaAccum = 0.0
		
		local movement = self.Entity.MovementComponent
		if isvalid(movement) then movement:Stop() end
		
		if _PersistenceManager then
			_PersistenceManager:MarkPlayerDirty(senderUserId)
		end
		
		log("[SLEEP] Player " .. self.Entity.Name .. " started sleeping in bed: " .. bedEntityId)
		self:ClientOnSleepStart()
	end

	@ExecSpace("Server")
	method void ServerRequestWakeUp()
		-- description: Process player request to wake up on server.
		if not self.IsSleeping then return end
		local playerComp = self.Entity.PlayerComponent
		if playerComp == nil or senderUserId ~= playerComp.UserId then return end
		
		self.IsSleeping = false
		self.SleepStartTimeTicks = "0"
		
		if _PersistenceManager then
			_PersistenceManager:MarkPlayerDirty(senderUserId)
		end
		
		log("[SLEEP] Player " .. self.Entity.Name .. " woke up.")
		self:ClientOnSleepEnd()
	end

	@ExecSpace("Client")
	method void ClientOnSleepStart()
		-- description: Handle client-side feedback when sleeping starts (T8).
		_ScreenMessageLogic:PrivateMsg("수면 시작 — 약 10초에 HP/마나/기력 풀충전. 이동키로 기상.")
	end

	@ExecSpace("Client")
	method void ClientOnSleepEnd()
		-- description: Handle client-side feedback when sleeping ends.
		_ScreenMessageLogic:PrivateMsg("잠에서 깨어났습니다.")
	end

	@ExecSpace("ClientOnly")
	method Entity FindNearbyBed()
		-- T67: 조준선(IsAimTarget) 필터.
		local currentMap = self.Entity.CurrentMap
		if not isvalid(currentMap) then return nil end
		
		local myPos = self.Entity.TransformComponent.WorldPosition:ToVector2()
		local closest = nil
		local minDist = 9999.0
		
		local bedComponents = currentMap:GetChildComponentsByTypeName("script.Furniture_Bed", true)
		if not bedComponents then return nil end
		
		for _, comp in ipairs(bedComponents) do
			if isvalid(comp) then
				local ent = comp.Entity
				if isvalid(ent) and self:IsAimTargetCore(ent, false) then
					local fPos = ent.TransformComponent.WorldPosition:ToVector2()
					local dist = (myPos - fPos):Magnitude()
					if dist < minDist then
						minDist = dist
						closest = ent
					end
				end
			end
		end
		
		return closest
	end

	@ExecSpace("ClientOnly")
	method Entity FindNearbyTreasureChest()
		-- T67: 조준선(IsAimTarget) 필터. 포탈보다 우선 처리용.
		local currentMap = self.Entity.CurrentMap
		if not isvalid(currentMap) then return nil end
		local myPos = self.Entity.TransformComponent.WorldPosition:ToVector2()
		local closest = nil
		local minDist = 9999.0
		local comps = currentMap:GetChildComponentsByTypeName("script.TreasureChest", true)
		if not comps then
			comps = currentMap:GetChildComponentsByTypeName("TreasureChest", true)
		end
		if not comps then return nil end
		for _, comp in ipairs(comps) do
			if isvalid(comp) then
				if not comp.IsOpened then
					local ent = comp.Entity
					if isvalid(ent) and self:IsAimTargetCore(ent, false) then
						local fPos = ent.TransformComponent.WorldPosition:ToVector2()
						local dist = (myPos - fPos):Magnitude()
						if dist < minDist then
							minDist = dist
							closest = ent
						end
					end
				end
			end
		end
		return closest
	end

	@ExecSpace("ClientOnly")
	method Entity FindNearbyFishingSpot()
		-- T67: 조준선(IsAimTarget) 필터.
		local currentMap = self.Entity.CurrentMap
		if not isvalid(currentMap) then return nil end
		local myPos = self.Entity.TransformComponent.WorldPosition:ToVector2()
		local closest = nil
		local minDist = 9999.0
		local comps = currentMap:GetChildComponentsByTypeName("script.FishingSpot", true)
		if not comps then return nil end
		for _, comp in ipairs(comps) do
			if isvalid(comp) then
				local ent = comp.Entity
				if isvalid(ent) and self:IsAimTargetCore(ent, false) then
					local fPos = ent.TransformComponent.WorldPosition:ToVector2()
					local dist = (myPos - fPos):Magnitude()
					if dist < minDist then
						minDist = dist
						closest = ent
					end
				end
			end
		end
		return closest
	end

	@ExecSpace("ClientOnly")
	method boolean IsAimTileWater()
		-- 조준 셀 물 판정 + [FISHING] 로그. F 입력 등 단발 판정용.
		-- 고빈도 폴링(가이드 프로브)은 IsAimTileWaterCore(false)를 쓸 것 — 로그 스팸 방지.
		return self:IsAimTileWaterCore(true)
	end

	@ExecSpace("ClientOnly")
	method boolean IsAimTileWaterCore(boolean verbose)
		-- 조준 셀(L1)이 물 타일인지 판정. 셀 환산·바라보는 방향은 채광/설치와 **같은 단일 규약**을 쓴다
		-- (T67 조준선 = tilemap:ToCellPosition + LastDirectionX/Y). 자체 환산을 두면 조준선과 어긋난다.
		local currentMap = self.Entity.CurrentMap
		if not isvalid(currentMap) then return false end

		local tilemap = currentMap:GetFirstChildComponentByTypeName("RectTileMapComponent")
		if not isvalid(tilemap) then return false end
		local playerWorldPos = self.Entity.TransformComponent.WorldPosition
		local aimWorldX = playerWorldPos.x + self.LastDirectionX * 1.8
		local aimWorldY = playerWorldPos.y + self.LastDirectionY * 1.8
		local aimCell = tilemap:ToCellPosition(Vector3(aimWorldX, aimWorldY, 0))
		if aimCell == nil then return false end

		local l1 = currentMap:GetChildByName("RectTileMap")
		if not isvalid(l1) or not isvalid(l1.RectTileMapComponent) then return false end

		local tileName = "nil"
		local tile = l1.RectTileMapComponent:GetTile(aimCell)
		if tile ~= nil then tileName = tile.Name end
		local isWater = (tileName == "Water")
		if verbose then
			log("[FISHING] aim=(" .. aimCell.x .. "," .. aimCell.y .. ") tile=" .. tileName
				.. " water=" .. tostring(isWater))
		end
		return isWater
	end

	method string GetMapSpotType()
		local currentMap = self.Entity.CurrentMap
		if not isvalid(currentMap) then return "field" end
		local mapName = currentMap.Name
		if string.sub(mapName, 1, 5) == "Home_" then
			return "estate"
		elseif mapName == "town" then
			return "town"
		elseif mapName == "template_boss" or mapName == "boss"
			or string.sub(mapName, 1, 10) == "raidlobby_" or string.sub(mapName, 1, 5) == "raid_" then
			-- 레이드 대기실/보스방은 template_boss 의 런타임 사본이라 이름이 다르다.
			return "boss"
		else
			return "field"
		end
	end

	@ExecSpace("Server")
	method void ServerRequestTileFishingInteract()
		local playerComp = self.Entity.PlayerComponent
		if playerComp == nil or senderUserId ~= playerComp.UserId then return end
		if self.IsDead or self.IsSleeping then return end
		
		if not self:IsEquippedFishingRod() then
			self:ClientShowMineFeedback("낚싯대를 장착해야 합니다.")
			return
		end

		local currentMap = self.Entity.CurrentMap
		if not isvalid(currentMap) then return end
		
		local spotComp = currentMap:GetFirstChildComponentByTypeName("script.FishingSpot", true)
		if not isvalid(spotComp) then
			spotComp = currentMap:GetComponent("script.FishingSpot")
			if not isvalid(spotComp) then
				currentMap:AddComponent("script.FishingSpot")
				spotComp = currentMap:GetComponent("script.FishingSpot")
			end
		end

		if isvalid(spotComp) then
			local spotType = self:GetMapSpotType()
			if self.FishingState == "None" then
				spotComp:StartFishing(self.Entity, spotType)
			elseif self.FishingState == "Casting" then
				spotComp:PullRod(self.Entity)
			end
		end
	end

	method boolean IsEquippedFishingRod()
		local inv = self.Entity:GetComponent("script.PlayerInventory")
		if not isvalid(inv) then return false end
		local toolKey = inv.EquippedTool
		if toolKey == nil or toolKey == "" then return false end
		local baseName = inv:GetBaseItemName(toolKey)
		local ds = _DataService:GetTable("item_dataset")
		if ds == nil then return false end
		local row = ds:FindRow("Name", baseName)
		if row == nil then return false end
		return row:GetItem("ToolType") == "rod"
	end

	@ExecSpace("Server")
	method void ServerRequestFishingInteract(string spotEntityId)
		local playerComp = self.Entity.PlayerComponent
		if playerComp == nil or senderUserId ~= playerComp.UserId then return end
		if self.IsDead or self.IsSleeping then return end
		
		local spotEnt = _EntityService:GetEntity(spotEntityId)
		if not isvalid(spotEnt) then return end
		local spot = spotEnt:GetComponent("script.FishingSpot")
		if not isvalid(spot) then return end
		
		if isvalid(self.Entity.TransformComponent) and isvalid(spotEnt.TransformComponent) then
			-- 거리 = 트리거 박스(BoxSize × Scale) 가장자리까지. 중심점 거리는 크게 키운 연못에서 가장자리에 서도
			-- 3.5 를 넘어 요청이 조용히 버려졌다 — 클라 조준(IsAimTargetCore)도 같은 박스를 쓴다 (2026-10-05).
			local myPos = self.Entity.TransformComponent.WorldPosition
			local box = { minX = 0, maxX = 0, minY = 0, maxY = 0 }
			local dist = 0
			local limit = 3.5
			if _ObstacleQuery:GetColliderAABB(spotEnt, box) then
				local nx = math.max(box.minX, math.min(myPos.x, box.maxX))
				local ny = math.max(box.minY, math.min(myPos.y, box.maxY))
				dist = Vector2.Distance(Vector2(myPos.x, myPos.y), Vector2(nx, ny))
				limit = self.FishingReachFromEdge
			else
				local spotPos = spotEnt.TransformComponent.WorldPosition
				dist = Vector2.Distance(Vector2(myPos.x, myPos.y), Vector2(spotPos.x, spotPos.y))
			end
			if dist > limit then
				log(string.format("[FISHING] reject: too far spot=%s dist=%.2f limit=%.2f", tostring(spotEnt.Name), dist, limit))
				return
			end
		end
		
		if not self:IsEquippedFishingRod() then
			self:ClientShowMineFeedback("낚싯대를 장착해야 합니다.")
			return
		end
		
		if self.FishingState == "None" then
			spot:StartFishing(self.Entity)
		elseif self.FishingState == "Casting" then
			spot:PullRod(self.Entity)
		end
		-- T64: Reeling 중 상호작용 RPC는 무시 — 홀드는 ServerSetReelHold 전담.
	end

	@ExecSpace("Server")
	method void ServerRequestCancelFishing()
		local playerComp = self.Entity.PlayerComponent
		if playerComp == nil or senderUserId ~= playerComp.UserId then return end
		if self.FishingState == "None" then return end
		if isvalid(self.ActiveFishingSpot) then
			local spot = self.ActiveFishingSpot:GetComponent("script.FishingSpot")
			if isvalid(spot) then
				spot:CancelFishing(self.Entity)
			end
		end
		self.FishingState = "None"
		self.ActiveFishingSpot = nil
		self:ClientShowMineFeedback("낚시가 취소되었습니다.")
	end

	-- =========================================================================
	-- T64: 낚시 v2 — 릴링 홀드 입력 중계 + 낚시 숙련 레벨
	-- =========================================================================

	@ExecSpace("Server")
	method void ServerSetReelHold(boolean holding)
		-- T64: 클라 홀드/릴리즈 변화를 활성 낚시터의 릴링 세션에 반영.
		local playerComp = self.Entity.PlayerComponent
		if playerComp == nil or senderUserId ~= playerComp.UserId then return end
		if self.FishingState ~= "Reeling" then return end
		if not isvalid(self.ActiveFishingSpot) then return end
		local spot = self.ActiveFishingSpot:GetComponent("script.FishingSpot")
		if isvalid(spot) then
			spot:SetReelHold(self.Entity, holding)
		end
	end

	@ExecSpace("ClientOnly")
	method void SetMobileReelHold(boolean holding)
		-- T64: BtnInteract Pressed/Released(UIHUDController) → 홀드 플래그. OnUpdate 폴링이 소비.
		if self.Entity ~= _UserService.LocalPlayer then return end
		self._T.MobileReelHold = holding
	end

	method integer GetFishingMaxXp(integer level)
		-- T64: 숙련 레벨업 필요 XP 곡선 = FishingXpBase × FishingXpGrowth^(level-1)
		if level < 1 then level = 1 end
		return math.floor(self.FishingXpBase * (self.FishingXpGrowth ^ (level - 1)))
	end

	method integer GetHobbyLevel(string hobbyKey)
		local key = string.lower(hobbyKey or "")
		if key == "fishing" or key == "fish" or key == "낚시" then
			return tonumber(self.FishingLevel) or 1
		elseif key == "ranching" or key == "사육" then
			return tonumber(self.RanchingLevel) or 1
		elseif key == "farming" or key == "농사" then
			return 1
		elseif key == "mining" or key == "채광" then
			return 1
		end
		return 1
	end

	method string GetHobbySummary()
		return "취미: 낚시 Lv." .. tostring(self.FishingLevel) .. " · 사육 Lv." .. tostring(self.RanchingLevel)
	end

	method integer GetRanchingMaxXp(integer level)
		-- 사육 레벨업 필요 XP = RanchingXpBase × RanchingXpGrowth^(level-1)
		if level < 1 then level = 1 end
		return math.floor(self.RanchingXpBase * (self.RanchingXpGrowth ^ (level - 1)))
	end

	method number GetRanchingCareBonus()
		-- 사육 레벨이 가축 CareBonus 에 더하는 값: (레벨-1) × RanchingCarePerLevel, 상한 RanchingCareMax.
		local lv = math.max(1, tonumber(self.RanchingLevel) or 1)
		return math.min(self.RanchingCareMax, (lv - 1) * self.RanchingCarePerLevel)
	end

	@ExecSpace("ServerOnly")
	method void AddRanchingXP(integer amount)
		-- 사육 XP 적립 + 레벨업. 단계 보상이 있는 레벨이면 멘토에게 받으러 오라고 안내한다.
		if amount <= 0 then return end
		local playerComp = self.Entity.PlayerComponent
		self.RanchingXp = self.RanchingXp + amount
		while self.RanchingXp >= self:GetRanchingMaxXp(self.RanchingLevel) do
			self.RanchingXp = self.RanchingXp - self:GetRanchingMaxXp(self.RanchingLevel)
			self.RanchingLevel = self.RanchingLevel + 1
			local msg = "사육 숙련 레벨 업! Lv." .. tostring(self.RanchingLevel) .. " (생산 대기 단축 · 친밀도 상승)"
			if #self:GetHobbyRewardRows("ranching", self.RanchingLevel - 1, self.RanchingLevel) > 0 then
				msg = msg .. " — 헛간지기 토리에게 가면 보상을 받을 수 있어요"
			end
			self:ShowMineFeedback(msg)
			log("[RANCH] level up -> " .. tostring(self.RanchingLevel) .. " xp=" .. tostring(self.RanchingXp))
		end
		if playerComp ~= nil and _PersistenceManager then
			_PersistenceManager:MarkPlayerDirty(playerComp.UserId)
		end
	end

	@ExecSpace("ServerOnly")
	method table GetHobbyRewardRows(string hobby, integer fromExclusive, integer toInclusive)
		-- HobbyRewardDataSet 에서 hobby 의 (fromExclusive, toInclusive] 레벨 보상 행 목록 { level, items, desc }.
		local out = {}
		local ds = _DataService:GetTable("HobbyRewardDataSet")
		if ds == nil then return out end
		for i = 1, ds:GetRowCount() do
			if tostring(ds:GetCell(i, "Hobby") or "") == hobby then
				local lv = math.floor(tonumber(ds:GetCell(i, "Level")) or 0)
				if lv > fromExclusive and lv <= toInclusive then
					out[#out + 1] = { level = lv, items = tostring(ds:GetCell(i, "RewardItems") or ""), desc = tostring(ds:GetCell(i, "Desc") or "") }
				end
			end
		end
		table.sort(out, function(a, b) return a.level < b.level end)
		return out
	end

	@ExecSpace("Server")
	method void ServerVisitHobbyMentor(string npcId)
		-- 주민에게 말을 걸 때(VillagerDialog) 부른다. 그 주민이 사육 멘토면 밀린 단계 보상을 지급하고 현황을 알려 준다.
		local playerComp = self.Entity.PlayerComponent
		if playerComp == nil or senderUserId ~= playerComp.UserId then return end
		if npcId == nil or npcId ~= self.RanchingMentorNpcId then return end

		local inv = self.Entity:GetComponent("script.PlayerInventory")
		local rows = self:GetHobbyRewardRows("ranching", self.RanchingRewardLevel, self.RanchingLevel)
		for _, r in ipairs(rows) do
			local granted = {}
			for part in string.gmatch(r.items, "[^|]+") do
				-- "Name:count" — 반환값 개수 불일치(LWA-1111)를 피해 캡처 1개짜리 string.match 로만 나눈다(workflow.md 선례).
				local name = string.match(part, "^%s*([^:]-)%s*:") or string.match(part, "^%s*(.-)%s*$") or ""
				local cnt = math.floor(tonumber(string.match(part, ":%s*(%d+)")) or 1)
				if name ~= "" and cnt > 0 and isvalid(inv) then
					inv:AddItem(name, cnt)
					granted[#granted + 1] = name .. " x" .. tostring(cnt)
				end
			end
			self.RanchingRewardLevel = r.level
			local note = r.desc ~= "" and (" — " .. r.desc) or ""
			self:ShowMineFeedback("토리: 사육 Lv." .. tostring(r.level) .. " 달성 보상" .. note)
			log("[RANCH] reward lv=" .. tostring(r.level) .. " items=" .. table.concat(granted, ", "))
		end
		if #rows > 0 then
			if _PersistenceManager then _PersistenceManager:MarkPlayerDirty(playerComp.UserId) end
		else
			if self.RanchingRewardLevel < self.RanchingLevel then self.RanchingRewardLevel = self.RanchingLevel end
		end
		self:ShowMineFeedback("사육 Lv." .. tostring(self.RanchingLevel) .. " · 다음 레벨까지 "
			.. tostring(self.RanchingXp) .. "/" .. tostring(self:GetRanchingMaxXp(self.RanchingLevel)) .. " XP (가축에게 먹이를 주면 올라요)")
	end

	@ExecSpace("ServerOnly")
	method void AddFishingXP(integer amount)
		-- T64: 어획 시 숙련 XP 적립 + 레벨업 처리. 영속은 PersistenceManager(dirty 마킹).
		if amount <= 0 then return end
		local playerComp = self.Entity.PlayerComponent
		self.FishingXp = self.FishingXp + amount
		local leveledUp = false
		while self.FishingXp >= self:GetFishingMaxXp(self.FishingLevel) do
			self.FishingXp = self.FishingXp - self:GetFishingMaxXp(self.FishingLevel)
			self.FishingLevel = self.FishingLevel + 1
			leveledUp = true
			if playerComp ~= nil then
				self:ClientShowMineFeedback("낚시 숙련 레벨 업! Lv." .. tostring(self.FishingLevel)
					.. " (텐션 완화·새 어종 개방)", playerComp.UserId)
			end
		end
		if leveledUp then
			log("[T64][FISHING] FishingLevel up -> " .. tostring(self.FishingLevel)
				.. " xp=" .. tostring(self.FishingXp))
		end
		if playerComp ~= nil and _PersistenceManager then
			_PersistenceManager:MarkPlayerDirty(playerComp.UserId)
		end
	end

	@ExecSpace("Client")
	method void ClientReelBegin()
		-- T64: 릴링 시작 — HUD 게이지 표시. 홀드 상태 초기화.
		self._T.ReelHolding = false
		self._T.MobileReelHold = false
		local gauge = _EntityService:GetEntityByPath("/ui/HUDGroup/FishingGauge")
		if isvalid(gauge) then
			local ctrl = gauge:GetComponent("script.UIFishingGaugeController")
			if isvalid(ctrl) then
				ctrl:Show()
			end
		end
	end

	@ExecSpace("Client")
	method void ClientReelUpdate(number progress, number tension, boolean danger)
		-- T64: 서버 릴링 틱(10Hz) → 게이지 갱신.
		local gauge = _EntityService:GetEntityByPath("/ui/HUDGroup/FishingGauge")
		if isvalid(gauge) then
			local ctrl = gauge:GetComponent("script.UIFishingGaugeController")
			if isvalid(ctrl) then
				ctrl:UpdateGauge(progress, tension, danger)
			end
		end
	end

	@ExecSpace("Client")
	method void ClientReelEnd()
		-- T64: 릴링 종료(성공/실패/취소) — 게이지 숨김 + 홀드 상태 리셋.
		self._T.ReelHolding = false
		self._T.MobileReelHold = false
		local gauge = _EntityService:GetEntityByPath("/ui/HUDGroup/FishingGauge")
		if isvalid(gauge) then
			local ctrl = gauge:GetComponent("script.UIFishingGaugeController")
			if isvalid(ctrl) then
				ctrl:Hide()
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void UpdateAvatarYOrder(boolean force)
		-- description: Updates AvatarRendererComponent OrderInLayer.
		local transform = self.Entity.TransformComponent
		if not isvalid(transform) then return end
		local y = transform.WorldPosition.y
		if force or self._LastAvatarY == nil or math.abs(y - self._LastAvatarY) >= 0.05 then
			self._LastAvatarY = y
			local avatar = self.Entity.AvatarRendererComponent
			if isvalid(avatar) and _RenderLayers then
				avatar.SortingLayer = _RenderLayers.EntityLayer
				-- 아바타 Transform은 이미 발밑 위치이므로 박스 보정을 타지 않고 ComputeYOrder를 직접 호출한다.
				-- 단, 아바타도 유닛이므로 UnitTieBias(+1)를 추가 가산하여 유닛 우선 정렬을 보장한다.
				local baseOrder = _RenderLayers:ComputeYOrder(y)
				avatar.OrderInLayer = baseOrder + (_RenderLayers.UnitTieBias or 1)
			end
		end
	end


	method string SkillText(any row, string key)
		if row == nil then return "" end
		local ok, value = pcall(function() return row:GetItem(key) end)
		if not ok or value == nil then return "" end
		return tostring(value)
	end

	method number SkillNumber(any row, string key, number fallback)
		return tonumber(self:SkillText(row, key)) or fallback
	end

	method number GetMaxMana()
		-- 최대 마나 = 기본 + 패시브 + 레벨 성장 + 지능 기여.
		local lv = math.max(1, self.Level or 1)
		return self.BaseMaxMana + self:GetPassiveBonus("MaxMana") + (lv - 1) * self.LevelManaGrowth + self.StatInt * self.IntManaPerPoint
	end

	method boolean IsSkillJobAllowed(any row)
		if row == nil then return false end
		local job = self:SkillText(row, "JobId")
		return job == "" or job == self.JobId
	end

	method boolean IsSkillQuestAllowed(any row)
		-- 스킬 해금 퀘스트(UnlockQuestId) 완료 여부. 서버 습득 검증·스킬창 표시가 모두 여기를 거친다.
		local id = self:SkillNumber(row, "UnlockQuestId", 0)
		if id <= 0 then return true end
		-- 테스트 모드 직업 테스트(TestModeConfig.UnlockAllPortals 와 같은 스위치): 상위 스킬 해금 퀘스트를 건너뛴다.
		if _TestModeConfig ~= nil and _TestModeConfig.EnableTestMode == true and _TestModeConfig.UnlockAllPortals == true then
			return true
		end
		local pq = self.Entity.PlayerQuest
		if not isvalid(pq) then return false end
		local data = pq.UserDataTable[id]
		return data ~= nil and data.State == _QuestStateEnum.Completed
	end

	method string GetJobName(string jobId)
		if jobId == "" then return "모험가" end
		local ds = _DataService:GetTable("SkillDataSet")
		if ds ~= nil then
			local row = ds:FindRow("JobId", jobId)
			if row ~= nil then return self:SkillText(row, "JobName") end
		end
		return ""
	end

	@ExecSpace("ServerOnly")
	method boolean CanReceiveJob(string jobId)
		return jobId ~= "" and self.JobId == "" and self:GetJobName(jobId) ~= ""
	end

	@ExecSpace("ServerOnly")
	method void GrantJob(string jobId)
		if not self:CanReceiveJob(jobId) then return end
		self.JobId = jobId
		self.Mana = self:GetMaxMana()
		self:SanitizeEquippedSkills()
		local uid = self.Entity.PlayerComponent.UserId
		_PersistenceManager:MarkPlayerDirty(uid)
		self:ClientShowMineFeedback("[전직] " .. self:GetJobName(jobId) .. " — K에서 직업 스킬을 배워 보세요.", uid)
		log("[JOB] granted user=" .. uid .. " job=" .. jobId)
	end

	@ExecSpace("ServerOnly")
	method void RecoverJobFromQuests()
		-- 두 저장소의 로드 순서와 관계없이 완료한 전직 시험을 복구한다. SP/아이템은 재지급하지 않는다.
		if self.JobId ~= "" then return end
		local pq = self.Entity.PlayerQuest
		if not isvalid(pq) then return end
		local chosen = 0
		local job = ""
		for id, state in pairs(pq.UserDataTable) do
			if state.State == _QuestStateEnum.Completed then
				local data = _QuestDataSetLogic:GetData(id)
				if data ~= nil and data.RewardJobId ~= "" and (chosen == 0 or id < chosen) then
					chosen = id
					job = data.RewardJobId
				end
			end
		end
		if job ~= "" then self:GrantJob(job) end
	end

	method boolean IsCombatSkillMap()
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return false end
		return map.Name ~= "town" and map.Name ~= "map01" and string.sub(map.Name, 1, 5) ~= "Home_"
	end

	@ExecSpace("ServerOnly")
	method void ClearSkillAreas()
		for _, area in pairs(self._T.SkillAreas or {}) do
			if isvalid(area.marker) then area.marker:Destroy() end
		end
		self._T.SkillAreas = {}
		self._T.GuardUntil = 0
		self._T.TemperedUntil = 0
		self._T.TemperedReduction = 0
	end

	@ExecSpace("ServerOnly")
	method void CreateSkillArea(string skillId, integer dirX, integer dirY)
		local ds = _DataService:GetTable("SkillDataSet")
		local row = ds:FindRow("SkillId", skillId)
		local map = self.Entity.CurrentMap
		if row == nil or not isvalid(map) then return end
		local pos = self.Entity.TransformComponent.WorldPosition
		local reach = self:SkillNumber(row, "AreaReach", 0)
		local center = Vector3(pos.x + dirX * reach, pos.y + dirY * reach, pos.z)
		if not self._T.SkillAreas then self._T.SkillAreas = {} end
		local old = self._T.SkillAreas[skillId]
		if old ~= nil and isvalid(old.marker) then old.marker:Destroy() end
		local size = self:SkillNumber(row, "AreaSize", 3)
		local duration = self:SkillNumber(row, "Duration", 6)
		local armDelay = self:SkillNumber(row, "ArmDelay", 0)
		local kind = row:GetItem("Type")
		-- 방향성 착탄 이펙트(EffectFacing 지정 — 붉은 너클의 일격): 원본 피벗이 시전자 자리라, 장판 중심이 아니라
		-- 시전 위치 + 방향 × EffectOffset 에서 시전 방향에 맞춰 터뜨린다. 공란이면 기존처럼 장판 중심·반전 없음.
		local fxPose = nil
		if self:SkillText(row, "EffectFacing") ~= "" then
			local fxOffset = self:SkillNumber(row, "EffectOffset", 0)
			fxPose = {
				pos = Vector3(pos.x + dirX * fxOffset, pos.y + dirY * fxOffset + self:GetSkillEffectHeight(row, dirX), pos.z),
				flip = self:IsSkillEffectFlipX(row, dirX),
				rot = self:GetSkillEffectRotation(row, dirX, dirY),
			}
		end
		-- 지속 장판(Field 이면서 지속시간 동안 여러 번 틱하는 것 — 산성 포션·대연성 진)은 촉매 연구(FieldDurationPct·FieldDamagePct)를 받는다.
		-- 한 번만 터지는 지연 착탄(모루 낙하·불씨 결정·균열 각인)은 장판이 아니므로 제외한다.
		local persistent = kind == "Field" and (duration - armDelay) > self:SkillNumber(row, "TickInterval", 1)
		local fieldDamageMul = 1
		if persistent then
			duration = armDelay + (duration - armDelay) * (1 + math.max(0, self:GetPassiveBonus("FieldDurationPct")))
			fieldDamageMul = 1 + math.max(0, self:GetPassiveBonus("FieldDamagePct"))
		end
		-- 장판 표시: SkillAreaMarker(반투명 원판 + 발광 테두리 + 착탄/남은 시간 채움). 원 반지름 = AreaSize/2 = 판정 반지름.
		local marker = nil
		-- HideAreaMarker=true(붉은 너클의 일격): 바닥 원판 없이 이펙트만 보인다(판정·틱은 그대로).
		local hideMarker = self:SkillText(row, "HideAreaMarker") == "true"
		if not hideMarker then
			local modelId = _EntryService:GetModelIdByName(self.SkillAreaMarkerModel)
			if modelId == nil or modelId == "" then modelId = self.SkillAreaMarkerModel end
			marker = _SpawnService:SpawnByModelId(modelId, "SkillArea_" .. skillId, center, map)
		end
		if hideMarker then
			-- 표시 없음(의도).
		elseif isvalid(marker) then
			local mk = marker:GetComponent("script.MonsterTelegraphMarker")
			local spriteRadius = 0.24
			if isvalid(mk) then
				---@type MonsterTelegraphMarker
				local m = mk
				m.AllyKind = kind
				m.ArmSeconds = armDelay
				m.LifeSeconds = duration
				if m.SpriteRadius > 0 then spriteRadius = m.SpriteRadius end
			end
			local s = (size * 0.5) / spriteRadius
			marker.TransformComponent.Scale = Vector3(s, s, 1)
			-- 안전장치: 영역 정리를 놓쳐도 지속시간이 지나면 스스로 사라진다.
			marker:Destroy(duration + 0.5)
		else
			log_warning("[SKILL-AREA] marker model missing: " .. tostring(self.SkillAreaMarkerModel))
		end
		local now = _UtilLogic.ElapsedSeconds
		-- AreaFollow=true(쇠망치 회전): 장판이 시전자를 따라간다 — 판정 중심은 틱마다, 바닥 표시는 FollowSkillAreas 가 0.05초마다 옮긴다.
		local follow = self:SkillText(row, "AreaFollow") == "true"
		-- 방향성 이펙트 위치(fxPose)도 따라가도록 시전 위치 기준 상대 좌표를 기억한다.
		local fxRelX = 0
		local fxRelY = 0
		if fxPose ~= nil then
			fxRelX = fxPose.pos.x - pos.x
			fxRelY = fxPose.pos.y - pos.y
		end
		self._T.SkillAreas[skillId] = { row = row, map = map, center = center, size = size, marker = marker, expires = now + duration, nextTick = now + armDelay, kind = kind, damageMul = fieldDamageMul, fxPose = fxPose,
			follow = follow, offsetX = dirX * reach, offsetY = dirY * reach, fxRelX = fxRelX, fxRelY = fxRelY }
		if follow and self._T.AreaFollowTimer == nil then
			self._T.AreaFollowTimer = _TimerService:SetTimerRepeat(function() self:FollowSkillAreas() end, 0.05)
		end
		log("[SKILL-AREA] create " .. skillId .. " kind=" .. tostring(kind) .. " r=" .. tostring(size * 0.5) .. " arm=" .. tostring(armDelay) .. " life=" .. string.format("%.2f", duration) .. " dmgMul=" .. string.format("%.2f", fieldDamageMul) .. " follow=" .. tostring(follow))
	end

	@ExecSpace("ServerOnly")
	method void FollowSkillAreas()
		-- 따라가는 장판(AreaFollow)의 중심·바닥 표시를 시전자 현재 위치로 옮긴다. 남은 게 없으면 타이머를 멈춘다.
		local any = false
		local pos = self.Entity.TransformComponent.WorldPosition
		for _, area in pairs(self._T.SkillAreas or {}) do
			if area.follow then
				any = true
				area.center = Vector3(pos.x + area.offsetX, pos.y + area.offsetY, pos.z)
				if isvalid(area.marker) then
					area.marker.TransformComponent.WorldPosition = area.center
				end
				if area.fxPose ~= nil then
					area.fxPose.pos = Vector3(pos.x + area.fxRelX, pos.y + area.fxRelY, pos.z)
				end
			end
		end
		if not any and self._T.AreaFollowTimer ~= nil then
			_TimerService:ClearTimer(self._T.AreaFollowTimer)
			self._T.AreaFollowTimer = nil
		end
	end

	@ExecSpace("ServerOnly")
	method void TickSkillAreas()
		if self.IsDead then self:ClearSkillAreas() return end
		local now = _UtilLogic.ElapsedSeconds
		-- 틱 판정은 0.25초 타이머로 돈다. 예정 시각을 now 기준으로 다시 잡으면 타이머 오차로 0.25초 간격 틱(쇠망치 회전·그림자 난도)이 한 번씩 건너뛰어진다.
		-- 그래서 예정 시각을 누적하고(밀렸으면 now 기준으로 재설정), 만료·틱 비교에 같은 여유(slack)를 둔다.
		local slack = 0.02
		for skillId, area in pairs(self._T.SkillAreas or {}) do
			if now + slack >= area.expires or area.map ~= self.Entity.CurrentMap then
				if isvalid(area.marker) then area.marker:Destroy() end
				self._T.SkillAreas[skillId] = nil
			elseif now + slack >= area.nextTick then
				local interval = math.max(0.25, self:SkillNumber(area.row, "TickInterval", 1))
				area.nextTick = area.nextTick + interval
				if area.nextTick <= now then area.nextTick = now + interval end
				-- 따라가는 장판은 판정 직전에 중심을 시전자 위치로 맞춘다(타이머 사이에 움직인 만큼).
				if area.follow then
					local p = self.Entity.TransformComponent.WorldPosition
					area.center = Vector3(p.x + area.offsetX, p.y + area.offsetY, p.z)
					if area.fxPose ~= nil then
						area.fxPose.pos = Vector3(p.x + area.fxRelX, p.y + area.fxRelY, p.z)
					end
				end
				if area.kind == "HealAura" then
					-- 회복량: 그 스킬의 계열 능력치 1 포인트당 +HealPowerPerPoint. 패시브·장비(HealPowerPct)는 비율로 더한다.
					local healStat = self:GetSkillScaleStat(area.row)
					local heal = math.floor((self:SkillNumber(area.row, "HealPerTick", 4) + self:GetSkillLevel(skillId) * 2)
						* (1 + self:GetStatPoints(healStat) * self.HealPowerPerPoint + self:GetPassiveBonus("HealPowerPct")))
					for _, player in pairs(_UserService:GetUsersByMapName(area.map.Name)) do
						local pc = player:GetComponent("script.PlayerController")
						if isvalid(pc) and not pc.IsDead then
							local p = player.TransformComponent.WorldPosition
							if Vector2.Distance(p:ToVector2(), area.center:ToVector2()) <= area.size * 0.5 then
								local hp = player.PlayerComponent
								hp.Hp = math.min(hp.MaxHp, hp.Hp + heal)
							end
						end
					end
					-- 소환수도 회복한다 (job-branch-redesign §5.4 자연의 활력).
					self:HealAllSummonsNear(area.map, area.center, area.size * 0.5, heal)
				else
					local hits = self:DamageSkillArea(skillId, area.center, area.size, area.damageMul or 1)
					if area.kind == "Trap" and hits > 0 then
						area.expires = now
						-- 덫 발동음: 시전음(SoundRUID)과 분리된 TriggerSoundRUID (데이터 주도)
						local triggerSound = self:SkillText(area.row, "TriggerSoundRUID")
						if triggerSound ~= "" then self:MulticastPlaySkillSound(triggerSound) end
						log("[SKILL-AREA] trap trigger " .. skillId .. " hits=" .. tostring(hits))
					end
				end
				local fx = self:SkillText(area.row, "EffectRUID")
				if fx ~= "" and area.kind ~= "Trap" then
					local pose = area.fxPose
					if pose ~= nil then
						self:MulticastPlayEffectDir(fx, pose.pos, pose.flip, self:SkillNumber(area.row, "EffectScale", 1), pose.rot, 1.0, -1)
					else
						self:MulticastPlayEffectEx(fx, area.center, false, self:SkillNumber(area.row, "EffectScale", 1))
					end
				end
			end
		end
	end

	@ExecSpace("ServerOnly")
	method integer DamageSkillArea(string skillId, Vector3 center, number size, number multiplier)
		if not self:IsCombatSkillMap() then return 0 end
		local sim = _CollisionService:GetSimulator(self.Entity)
		local combat = self.Entity:GetComponent("script.PlayerCombat")
		if sim == nil or not isvalid(combat) then return 0 end
		local ds = _DataService:GetTable("SkillDataSet")
		local row = ds:FindRow("SkillId", skillId)
		if row == nil then return 0 end
		local hits = 0
		local seen = {}
		local damage = self:ComputeSkillDamage(skillId, self:GetEffectiveDamageMultiplier(skillId, self:GetSkillLevel(skillId)) * multiplier)
		-- 판정 = 원(반지름 AreaSize/2). 바닥에 그려지는 장판 원과 같은 크기다.
		for _, hit in pairs(sim:OverlapAll({CollisionGroups.HitBox}, CircleShape(center:ToVector2(), size * 0.5))) do
			local target = hit.Entity
			if isvalid(target) and not seen[target.Id] then
				seen[target.Id] = true
				local monster = target:GetComponent("script.Monster")
				if isvalid(monster) and not monster.IsDead then
					combat:DealSkillHit(target, damage, skillId, self:SkillText(row, "HitEffectRUID"), self:SkillNumber(row, "HitEffectScale", 1))
					hits = hits + 1
				end
			end
		end
		return hits
	end

	@ExecSpace("ServerOnly")
	method void RefreshTemperedSkin()
		local inv = self.Entity:GetComponent("script.PlayerInventory")
		local ds = _DataService:GetTable("SkillDataSet")
		if not isvalid(inv) or ds == nil then return end
		for i = 1, ds:GetRowCount() do
			local row = ds:FindRow("SkillId", ds:GetCell(i, "SkillId"))
			if self:IsSkillJobAllowed(row) and self:SkillText(row, "PassiveStat") == "DamageReduction" then
				local level = self:GetSkillLevel(row:GetItem("SkillId"))
				local item = self:SkillText(row, "PassiveItem")
				if level > 0 and item ~= "" and inv:GetItemCount(item) > 0 then
					self._T.TemperedUntil = _UtilLogic.ElapsedSeconds + self:SkillNumber(row, "Duration", 6)
					self._T.TemperedReduction = level * self:SkillNumber(row, "PassiveValuePerLevel", 0)
				end
			end
		end
	end

end

@Component
script PlayerController extends Component

	@Sync
	property integer LastDirectionX = -1

	@Sync
	property integer LastDirectionY = 0

	property any KeyDownHandler = nil

	property any ScreenTouchHandler = nil

	@Sync
	property integer Level = 1

	@Sync
	property integer Stamina = 100

	@Sync
	property integer MaxStamina = 100

	@Sync property string JobId = ""
	-- 캐릭터 슬롯별 무료 재분배 적용 버전. 서버 메모리 → PersistenceManager 선캡처로 저장한다.
	@HideFromInspector property integer JobBranchResetVersion = 0
	@Sync property number Mana = 60
	property number BaseMaxMana = 60
	property number BaseManaRegen = 2
	-- 피격하거나 몬스터를 때린 뒤 이 시간(초) 동안은 전투 상태. 비전투 회복 패시브(OutOfCombatHealPct)가 멈춘다.
	property number CombatHoldSeconds = 4.0
	-- (구) 장판 표시용 레티클 — 2026-09-29 SkillAreaMarkerModel 로 대체되어 쓰지 않는다. 모델 값 호환을 위해 선언만 남긴다.
	property string SkillAreaRUID = "0ac43ac8bf83461692fc56565d048df7"
	-- 설치·장판 스킬(Field/Trap/HealAura) 바닥 표시 모델. 판정 원 = 보이는 원(MonsterTelegraphMarker 아군 모드).
	property string SkillAreaMarkerModel = "SkillAreaMarker"
	-- 회전 채널 스킬(SkillDataSet.Channel=spin — 쇠망치 회전)의 연출 박자(초): 이 간격마다 좌우를 뒤집고, 두 박자마다 휘두르기 모션을 다시 튼다.
	property number SpinBeatSeconds = 0.12
	-- 회전 채널 중 이동 속도 배율(평소 이동 속도 대비).
	property number SpinMoveScale = 0.8

	@Sync
	property integer XP = 0

	@Sync
	property integer MaxXP = 100

	@Sync
	property integer Attack = 15

	@Sync
	property integer Defense = 10

	@Sync
	property number GatheringSpeed = 1.0

	@Sync
	property number MovementSpeed = 100

	@Sync
	property Entity ActivePortal = nil

	-- 전환 연출에 표시할 실제 목적지 맵 이름. 호출부가 ClientWarpWithCover 호출 직전에 채워 두면
	-- UIHUDController.pendingWarpDestMap 으로 그대로 전달해 출발지 추정만으로 라벨을 잘못 붙이지 않게 한다
	-- (규칙 46 — ClientWarpWithCover/BeginWarpTransition 인자 수는 고정, 값은 프로퍼티로 전달한다).
	property string pendingWarpDestMap = ""

	property number LastMineTime = 0.0

	property number KnockbackSpeed = 16.0

	@HideFromInspector
	property number KnockTimer = 0

	@HideFromInspector
	property Vector2 KnockVel = Vector2(0, 0)

	property number MineCooldown = 0.6

	property boolean HasRequestedInitialStones = false

	@Sync
	property string UnlockedWaypointsJson = "[]"

	-- 보스 레이드 주간 처치 기록: {"resetAt":<elapsed>,"counts":{"<bossId>":n}}
	@Sync
	property string RaidClearsJson = "{}"

	property string ReticleSpriteRUID = "662fd2de11094cf08be40d8b3fab11bc"

	property number ReticleScale = 1.0
	property number ReticleOffsetX = 0.0
	property number ReticleOffsetY = 0.0

	@Sync
	property number IFrameTimer = 0.0

	-- 피격 후 넉백(강제 밀림)과 HIT 경직을 함께 무시하는 시간. 피해는 그대로 받는다.
	-- ⚠ IFrameTimer(0.4초)보다 커야 의미가 있다 — 같거나 작으면 두 창이 겹쳐 매 피격마다 밀린다.
	property number KnockbackImmuneDuration = 1.2
	-- 도착 보호 (2026-09-25): 맵 진입 후 피격 무시. 클라가 전환 커버를 걷으며 통지하면(ServerNotifyWarpRevealed)
	-- ArrivalGraceAfterReveal 뒤에 끝난다. 통지가 없는 이동(리스폰·레이드 등)은 ArrivalProtectSeconds 뒤 자동 종료.
	-- 2026-09-26: 포탈 안전지대(몬스터 접근 차단)를 끄고 이 도착 무적 하나로 일원화 — 보호 중에는 캐릭터가 반투명하게 깜빡인다.
	property number ArrivalProtectSeconds = 6.0
	property number ArrivalGraceAfterReveal = 2.0
	-- 클라 깜빡임 표시용. 판정은 서버 _T.ArrivalImmuneUntil 이 기준이다.
	@Sync property boolean ArrivalProtected = false

	-- T101: 몬스터 단순 접촉(비비기) 피격 시 피해 및 경직을 무시하는 면역 시간 (초)
	@Sync
	property number TouchImmuneDuration = 1.2
	-- 보스 잔존 장판(도트) 틱의 최소 간격. 장판 여러 개가 겹쳐도 이 간격보다 자주 맞지 않는다.
	property number DotTickImmuneSeconds = 0.3

	@Sync
	property boolean IsDead = false
	-- 쓰러짐(HP 0) 처리 — 2026-09-30 제작자 확정 규칙.
	--   · 쓰러지면 DeathLossItems 를 DeathLossRatio 만큼, 코인을 DeathCoinLossRatio 만큼 잃는다(인벤토리만 — 상자 보관분은 무관).
	--     item_dataset.DeathEffect=protect_inventory 아이템(인벤토리 보호권)이 있으면 1개 소모하고 손실을 막는다.
	--   · 일반: DEAD 모션으로 DownedRespawnSeconds 기다린 뒤 마을(DeathTownMap)에서 깨어난다.
	--   · 즉시 부활권(DeathEffect=instant_revive) 사용 시 그 자리에서 부활 — 레이드 중에도 가능.
	--   · 미클리어 레이드 보스방: 자동 부활 없음. 파티 전멸 → 전원 대기실 부활, 보스 처치 → 그 방에서 부활(BossRaidLogic).
	property string DeathLossItems = "Wood,Stone,Copper Ore,Iron Ore"
	property number DeathLossRatio = 0.5
	-- 코인은 원자재보다 약하게(제작자 2026-09-30: 50% 는 과함 → 20~30%). 보호권·부활권 규칙은 원자재와 같다.
	property string DeathCoinItem = "Coin"
	property number DeathCoinLossRatio = 0.2
	property number DownedRespawnSeconds = 8.0
	property string DeathTownMap = "town"
	property number DeathTownX = 10
	property number DeathTownY = -2
	-- 깨어나기 직전 클라 화면을 덮는 시간. 다 덮인 뒤에 순간이동해야 튀는 장면이 안 보인다.
	property number RespawnCoverLeadSeconds = 0.3
	-- 깨어난 직후 피해·넉백을 무시하는 시간. 도착 보호와 같은 장치라 깜빡임 표시도 같이 나온다.
	property number RespawnProtectSeconds = 3.0
	-- 깨어날 때 채우는 HP 비율(1 = 가득).
	property number RespawnHpRatio = 1.0

	@Sync
	property boolean CanMineOnCurrentMap = true

	@Sync
	property boolean CanPlaceOnCurrentMap = true

	@Sync
	property boolean CanInteractOnCurrentMap = true

	-- T45: 신규 캐릭터는 QWER 공백. 해금 후 자동/수동 장착.
	@Sync
	property string EquippedSkillsJson = "[]"

	-- Skill Tree (S2): 보유 스킬 레벨 맵 JSON (skillId -> level). 0 또는 부재 = 미해금.
	@Sync
	property string SkillLevelsJson = "{}"

	-- Skill Tree (S2): 투자 가능한 스킬 포인트. 레벨업 시 SPPerLevelUp만큼 지급.
	@Sync
	property integer SP = 0

	-- 레벨업당 SP 지급량 (밸런스 튜닝값 — 인스펙터 프로퍼티로 관리)
	property integer SPPerLevelUp = 3

	-- 능력치 (2026-09-25 도입, 2026-10-01 직업 재설계 — docs/design/job-branch-redesign.md §3):
	-- 레벨업마다 기본 성장 + AP 를 받아 5개 능력치에 직접 분배한다. 능력치는 직업이 아니라 플레이 스타일에 붙는다.
	--   STR 힘   : 물리·투척 계열 공격력 + 공통 효과: 공격·채집 속도
	--   DEX 솜씨 : 정밀(덫·표창 등) 계열 공격력 + 공통 효과: 치명타 확률
	--   INT 지능 : 마법 계열 공격력 + 공통 효과: 최대 마나 (회복 스킬의 회복량도 지능 계열이 된다)
	--   SPI 교감 : 영향력(소환수·약화·제압) 계열 공격력 + 공통 효과: 내가 건 상태이상 지속
	--   VIT 체력 : 최대 HP + 방어력
	-- 스킬 피해 = (계열 공격력 + 무기 수치 + 장비 스킬 공격력 + 스킬 기본 위력) × 스킬 배율.
	-- 무기 수치: 삼위일체는 장갑 환산, 마법 피해(DamageModel=Magic)는 MagicAttack, 그 밖은 Attack. 스킬별 계열은 SkillDataSet.ScaleStat.
	@Sync property integer StatStr = 0
	@Sync property integer StatDex = 0
	@Sync property integer StatInt = 0
	@Sync property integer StatSpi = 0
	@Sync property integer StatVit = 0
	@Sync property integer AP = 0
	property integer APPerLevelUp = 3
	-- 계열 공격력 = 기본(PlayerCombat.BaseDamage) + (레벨-1)×LevelPowerGrowth + 능력치×StatPowerPerPoint (소수 버림)
	property number LevelPowerGrowth = 0.5
	property number StatPowerPerPoint = 0.5
	-- 최대 HP = BaseMaxHp + (레벨-1)×LevelHpGrowth + 체력×VitHpPerPoint
	property number BaseMaxHp = 1000
	property number LevelHpGrowth = 20
	property number VitHpPerPoint = 10
	-- 방어력 += (레벨-1)×LevelDefGrowth + 체력×VitDefPerPoint (소수 버림)
	property number LevelDefGrowth = 0.5
	property number VitDefPerPoint = 0.25
	-- 최대 마나 += (레벨-1)×LevelManaGrowth + 지능×IntManaPerPoint
	property number LevelManaGrowth = 2
	property number IntManaPerPoint = 1
	-- 능력치 공통 효과 계수 (1 포인트당).
	-- 힘: 공격·채집 속도 +0.5% / 솜씨: 치명타 확률 +0.4%p / 교감: 내가 건 상태이상 지속 +0.5% / 회복 스킬: 그 스킬 계열 능력치 1당 회복량 +1%
	property number StrSpeedPerPoint = 0.005
	property number DexCritPerPoint = 0.004
	property number SpiControlPerPoint = 0.005
	property number HealPowerPerPoint = 0.01
	-- 치명타: 확률 = BaseCritChance + 솜씨 × DexCritPerPoint + 패시브·장비(PassiveStat=CritChance), 상한 MaxCritChance.
	-- 피해 배율 = BaseCritDamage + 패시브·장비(CritDamage).
	property number BaseCritChance = 0.05
	property number MaxCritChance = 0.75
	property number BaseCritDamage = 1.5
	-- 정밀 배합(FarDamagePct): 이 거리(월드 유닛) 이상 떨어진 적에게 피해 보너스. Monster.ResolveSkillDamage 가 읽는다.
	property number FarDamageDistance = 4
	-- 충전 평타(마법봉·자연 무기): 공격키를 ChargeStartDelay 초 이상 누르면 충전을 시작한다. 그보다 짧으면 탭(즉시 휘두르기)이다.
	-- 단계별 필요 시간·배율은 WeaponAttackDataSet. 충전 중 이동 속도는 ChargeMoveScale 배.
	property number ChargeStartDelay = 0.25
	property number ChargeMoveScale = 0.6
	-- 서버가 충전 시간을 재검증할 때 허용하는 오차(초)와, 충전 발사 사이 최소 간격(서버 방어 — 정상 플레이에는 닿지 않는다).
	property number ChargeTolerance = 0.2
	property number ChargeMinInterval = 0.4
	-- 삼위일체(TRI) 계열 — 히든 직업 맨주먹 파이터 (docs/design/hidden_job_barefist_fighter.md §7).
	--   유효 포인트 = (힘 + 솜씨 + 체력) × (TrinityBaseFactor + TrinityBalanceFactor × 균형도)
	--   균형도 = 최솟값 / 평균 (0 = 한쪽 몰빵, 1 = 1:1:1).
	--   ⚖️ 2026-09-26: 1:1:1 이면 같은 AP 를 한 능력치에 몰아준 타 직업보다 20% 강하다(×1.2) — 특수 기믹 없는 싸움 특화 직업의 대가. 몰빵은 ×0.5.
	property number TrinityBaseFactor = 0.5
	property number TrinityBalanceFactor = 0.7
	-- 삼위일체 계열의 "무기" 수치 = 장착 장갑 방어력 × GloveAttackRatio (무기 공격력은 더하지 않는다).
	property number GloveAttackRatio = 1.5
	-- 직업별 평타(Ctrl) 계열. "직업Id:계열|..." — 목록에 없는 직업은 STR.
	property string BasicAttackStatByJob = "barefist_fighter:TRI"

	property any CooldownMap = nil

	@Sync
	property boolean IsSleeping = false

	@Sync
	property string SleepStartTimeTicks = "0"
	-- 수면 중 초당 회복 비율(최대치 대비). 0.1 = 초당 10% → 약 10초에 HP·마나·기력 풀충전. (구: 10분 풀충전)
	property number SleepRestorePerSecond = 0.1

	@Sync
	property string FishingState = "None"

	@Sync
	property Entity ActiveFishingSpot = nil
	-- 낚시터 트리거 박스 가장자리에서 이 거리(유닛) 안이면 서버가 낚시 요청을 받는다 (조준 거리 1.8 + 여유)
	property number FishingReachFromEdge = 2.5

	-- T64: 낚시 숙련 레벨/경험치 (영속 — PersistenceManager)
	@Sync
	property integer FishingLevel = 1

	@Sync
	property integer FishingXp = 0

	-- T64: 숙련 레벨업 곡선 설정값 (필요 XP = Base × Growth^(level-1))
	property integer FishingXpBase = 30

	property number FishingXpGrowth = 1.35

	-- 취미 2호 「사육」 숙련 (2026-09-30 제작자 확정). 가축 먹이 주기로 XP(AnimalDataSet.FeedXp),
	-- 레벨이 오르면 생산 대기 단축·친밀도 상승(가축 CareBonus 에 가산). 단계 보상은 멘토 NPC(헛간지기 토리)에게 말을 걸 때
	-- HobbyRewardDataSet(Hobby=ranching) 에서 받는다. 영속 — PersistenceManager(ranchingLevel/Xp/RewardLevel).
	@Sync
	property integer RanchingLevel = 1
	@Sync
	property integer RanchingXp = 0
	-- 받은 단계 보상의 최고 레벨(이 레벨 이하 보상은 이미 받음).
	property integer RanchingRewardLevel = 1
	property integer RanchingXpBase = 40
	property number RanchingXpGrowth = 1.4
	-- 레벨당 가축 CareBonus 가산(생산 대기 단축 비율)과 상한.
	property number RanchingCarePerLevel = 0.02
	property number RanchingCareMax = 0.2
	property string RanchingMentorNpcId = "barnkeeper"

	-- T65: 맨손(도구 공란) 스윙/타격 SFX 폴백 — item_dataset SwingSoundRUID/HitSoundRUID 공란 시 사용
	-- 2026-10-06 제작자 선정 (가벼운 주먹 소리). 이전: 스윙 8c62b200… · 타격 c1707b72…
	property string DefaultSwingSoundRUID = "5f9fd5d11f054593a85b1c66e5829723"

	property string DefaultHitSoundRUID = "50c95260aa524be6b7bb9eeb48a30ec2"
	-- 맨손 기본음 볼륨 (0~1). 도구가 자기 소리를 지정한 경우(곡괭이 등)는 건드리지 않고 1.0 그대로.
	property number DefaultSwingSoundVolume = 0.45
	property number DefaultHitSoundVolume = 0.45

	-- T66: 시전 이펙트 전방 오프셋(월드 유닛)·스케일 (CSV EffectOffset/EffectScale 공란 시 폴백)
	property number SkillEffectForwardOffset = 0.8
	property number SkillEffectScale = 1.0

	-- 상호작용 가이드: 조준 대상 하이라이트 틴트 (SpriteRenderer 한정 — 아바타 NPC는 라벨만)
	property Color InteractHighlightColor = Color(1.0, 0.85, 0.45, 1.0)
	-- 소환수 머리 위 체력바(UI 픽셀 · 월드 여유 높이). 모델 기본값이 없어 인스펙터에서 숨긴다(LWA-4012).
	@HideFromInspector property number SummonHpBarWidth = 96
	@HideFromInspector property number SummonHpBarHeight = 14
	@HideFromInspector property number SummonHpBarOffsetY = 0.25
	-- 충전 무기 탭만 쓸 때 "꾹 누르면 충전" 팁 반복 간격(탭 횟수).
	@HideFromInspector property integer ChargeHintEveryTaps = 20

	-- 상호작용 가이드: 물 타일 조준(엔티티 없는 대상) 라벨
	property string WaterAimInteractLabel = "낚시하기"

	-- 상호작용 가이드: 대상 재탐지 주기(초). 라벨 위치 추적은 매 프레임
	property number InteractGuideProbeInterval = 0.15

	-- T89: 아바타 Y정렬 갱신용 이전 Y 위치 기록
	@HideFromInspector
	property number _LastAvatarY = -999999

	method void OnBeginPlay()
		-- description: Initialize key and screen touch event listeners on the client.
		self.CooldownMap = {}
		
		if self:IsClient() then
			local isLocal = (_UserService.LocalPlayer == self.Entity)
			if isLocal then
				self.KeyDownHandler = _InputService:ConnectEvent(KeyDownEvent, self.OnKeyDown)
				self.ScreenTouchHandler = _InputService:ConnectEvent(ScreenTouchEvent, self.OnScreenTouch)
			
				-- Remove ONLY the WASD movement keys from the engine PlayerControllerComponent — do NOT
				-- disable the whole component (that also killed facing/LookDirectionX, jump, and the MOVE/IDLE
				-- walk animation). Our custom arrow-key movement drives MovementComponent every frame, so the
				-- controller's own locomotion is already overridden; WASD only survived as an in-place walk
				-- animation. Dropping the WASD action keys makes WASD inert while the arrow keys keep driving
				-- facing/jump/animation natively. (W stays usable as skill slot 2 via OnKeyDown.)
				-- Delayed one tick so the controller has bound its default action keys first.
				_TimerService:SetTimerOnce(function()
					if not isvalid(self) or not isvalid(self.Entity) then return end
					if self.Entity ~= _UserService.LocalPlayer then return end
					local pcc = self.Entity.PlayerControllerComponent
					if isvalid(pcc) then
						pcc:RemoveActionKey(KeyboardKey.W)
						pcc:RemoveActionKey(KeyboardKey.A)
						pcc:RemoveActionKey(KeyboardKey.S)
						pcc:RemoveActionKey(KeyboardKey.D)
					end
				end, 0.2)
			
				local movement = self.Entity.MovementComponent
				if isvalid(movement) then
					movement.InputSpeed = 7.2  -- Set top-down movement speed (2x scale)
				end

				local stateComp = self.Entity.StateComponent
				if isvalid(stateComp) then
					stateComp:ChangeState("IDLE")
					stateComp:DisconnectHitEvent()
				end
			end

			self:UpdateAvatarYOrder(true)
			
			if isLocal then
				log("PlayerController initialized on client for LocalPlayer. Facing: " .. self.LastDirectionX .. ", " .. self.LastDirectionY)
			end
		else
			log("PlayerController initialized on server for player: " .. self.Entity.Name)
			local sc = self.Entity.StateComponent
			if isvalid(sc) then
				sc:DisconnectHitEvent()
			end
			-- 이미 영지 맵에 서 있는 채 박스 밖이면 (구 세이브·클리핑) 한 틱 뒤 스냅.
			-- LoadPlayerData 워프보다 먼저/나중에 돌아도 양쪽 다 가드하므로 순서는 상관없다.
			_TimerService:SetTimerOnce(function()
				if isvalid(self) and isvalid(self.Entity) then
					self:GuardHomeBounds()
				end
			end, 0.5)
			self._T.StaminaTimer = _TimerService:SetTimerRepeat(function()
				if self.IsDead then
					self:TickDownedWatchdog()
					return
				end
				self.Mana = math.min(self:GetMaxMana(), self.Mana + self.BaseManaRegen + self:GetPassiveBonus("ManaRegen"))
				local playerComp = self.Entity.PlayerComponent
				if self.IsSleeping then
					-- 수면 회복: 초당 최대치의 SleepRestorePerSecond(기본 10%)씩 HP·마나·기력을 채운다(약 10초 풀충전).
					local rate = self.SleepRestorePerSecond
					self._T.SleepHpAccum = (self._T.SleepHpAccum or 0.0) + (playerComp.MaxHp * rate)
					self._T.SleepStaminaAccum = (self._T.SleepStaminaAccum or 0.0) + (self.MaxStamina * rate)
					self.Mana = math.min(self:GetMaxMana(), self.Mana + self:GetMaxMana() * rate)
					
					local hpAdd = math.floor(self._T.SleepHpAccum)
					if hpAdd > 0 then
						playerComp.Hp = math.min(playerComp.MaxHp, playerComp.Hp + hpAdd)
						self._T.SleepHpAccum = self._T.SleepHpAccum - hpAdd
					end
					
					local staminaAdd = math.floor(self._T.SleepStaminaAccum)
					if staminaAdd > 0 then
						self.Stamina = math.min(self.MaxStamina, self.Stamina + staminaAdd)
						self._T.SleepStaminaAccum = self._T.SleepStaminaAccum - staminaAdd
					end
				else
					if self.Stamina < self.MaxStamina then
						local regen = math.floor(self:GetBuffedStaminaRegen() + 0.5)
						if regen < 1 then regen = 1 end
						self.Stamina = math.min(self.MaxStamina, self.Stamina + regen)
					end
					self:TickOutOfCombatHeal()
				end
			end, 1.0)
			self._T.SkillAreaTimer = _TimerService:SetTimerRepeat(function() self:TickSkillAreas() end, 0.25)
		end
	end

	method void OnEndPlay()
		-- description: Clean up event listeners and local preview on client, and stamina timer on server.
		if self:IsClient() then
			if self.KeyDownHandler then
				_InputService:DisconnectEvent(KeyDownEvent, self.KeyDownHandler)
				self.KeyDownHandler = nil
			end
			if self.ScreenTouchHandler then
				_InputService:DisconnectEvent(ScreenTouchEvent, self.ScreenTouchHandler)
				self.ScreenTouchHandler = nil
			end
			local preview = self._T.PlacementPreviewEntity
			if isvalid(preview) then
				preview.Enable = false
				preview.Visible = false
				self._T.PlacementPreviewEntity = nil
			end
			self:CancelCharge()
			self:ClearInteractHighlight()
			local guideLabel = self._T.InteractGuideLabel
			if isvalid(guideLabel) then
				guideLabel.Enable = false
				self._T.InteractGuideLabel = nil
			end
			log("PlayerController cleaned up on client.")
		else
			if self._T.StaminaTimer then
				_TimerService:ClearTimer(self._T.StaminaTimer)
				self._T.StaminaTimer = nil
			end
			if self._T.SkillAreaTimer then _TimerService:ClearTimer(self._T.SkillAreaTimer) end
			if self._T.AreaFollowTimer then _TimerService:ClearTimer(self._T.AreaFollowTimer) end
			-- 쓰러진 채 나간 경우 깨우기 타이머를 걷는다(재접속 시 HP 는 PersistenceManager 가 채운다).
			if self._T.respawnTimer then
				_TimerService:ClearTimer(self._T.respawnTimer)
				self._T.respawnTimer = nil
			end
			self:ClearSkillAreas()
			log("PlayerController cleaned up on server.")
		end
	end

	@ExecSpace("ServerOnly")
	method void MarkCombat()
		-- 피격(HandleHitEvent 경로)·몬스터 타격(Monster.HandleHitEvent) 시 호출. 전투 상태 시작/연장.
		self._T.LastCombatAt = _UtilLogic.ElapsedSeconds
	end

	@ExecSpace("ServerOnly")
	method boolean IsInCombat()
		-- 마지막 피격/타격 후 CombatHoldSeconds 가 지나지 않았으면 전투 중.
		local last = self._T.LastCombatAt
		if last == nil then return false end
		return _UtilLogic.ElapsedSeconds - last < self.CombatHoldSeconds
	end

	@ExecSpace("ServerOnly")
	method void TickOutOfCombatHeal()
		-- 비전투 회복 패시브(SkillDataSet PassiveStat=OutOfCombatHealPct): 1초마다 최대 체력 × 비율 회복.
		-- 기력(스태미나)을 쓰지 않는다. 소수점 회복량은 누적해 정수가 될 때 반영한다.
		local pct = self:GetPassiveBonus("OutOfCombatHealPct")
		if pct <= 0 then return end
		if self:IsInCombat() then
			self._T.OocHealAccum = 0
			return
		end
		local playerComp = self.Entity.PlayerComponent
		if playerComp == nil or playerComp.Hp <= 0 or playerComp.Hp >= playerComp.MaxHp then return end
		local accum = (self._T.OocHealAccum or 0.0) + playerComp.MaxHp * pct
		local add = math.floor(accum)
		if add > 0 then
			playerComp.Hp = math.min(playerComp.MaxHp, playerComp.Hp + add)
			accum = accum - add
		end
		self._T.OocHealAccum = accum
	end

	method boolean IsWallAt(Vector2 checkPos)
		-- T99: 판정은 ObstacleQuery 공용 모듈. 시그니처·의미 불변(T36 회귀 0).
		return _ObstacleQuery:IsWallAt(self.Entity, checkPos)
	end

	method boolean IsObstacle(Vector2 checkPos, number radius, any currentPos)
		-- T99: 판정은 ObstacleQuery 공용 모듈. 시그니처·의미 불변(T36·T41 회귀 0).
		return _ObstacleQuery:IsObstacle(self.Entity, checkPos, radius, currentPos, self.OverlapQueryRadius)
	end

	@ExecSpace("Server")
	method void RequestInitialStones()
		-- Client request to spawn initial stones (Disabled as per user request).
	end


	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- description: Handle updates per frame.
		self:UpdateAvatarYOrder(false)
		-- 회전 채널 연출은 원격 플레이어 아바타에도 보여야 하므로 로컬 가드보다 먼저 돈다.
		self:UpdateChannelVisual()

		-- 🔴 멀티플레이어 환경 가드: 원격 플레이어(다른 유저)는 로컬 클라이언트에서 입력을 처리하거나
		-- StateComponent/Movement를 조작해선 안 됨 (LEA-3022 InvalidExecSpace 및 조작 간섭 방지).
		local localPlayer = _UserService.LocalPlayer
		if not isvalid(localPlayer) or localPlayer ~= self.Entity then
			return
		end

		if self.IsSleeping then
			self:CancelCharge()
			local movement = self.Entity.MovementComponent
			if isvalid(movement) then movement:Stop() end
			if _InputService:IsKeyPressed(KeyboardKey.LeftArrow) or
			   _InputService:IsKeyPressed(KeyboardKey.RightArrow) or
			   _InputService:IsKeyPressed(KeyboardKey.UpArrow) or
			   _InputService:IsKeyPressed(KeyboardKey.DownArrow) or
			   _InputService:IsKeyPressed(KeyboardKey.W) or
			   _InputService:IsKeyPressed(KeyboardKey.A) or
			   _InputService:IsKeyPressed(KeyboardKey.S) or
			   _InputService:IsKeyPressed(KeyboardKey.D) then
				self:ServerRequestWakeUp()
			end
			return
		end

		if self.FishingState ~= "None" then
			self:CancelCharge()
			local movement = self.Entity.MovementComponent
			if isvalid(movement) then movement:Stop() end
			if _InputService:IsKeyPressed(KeyboardKey.LeftArrow) or
			   _InputService:IsKeyPressed(KeyboardKey.RightArrow) or
			   _InputService:IsKeyPressed(KeyboardKey.UpArrow) or
			   _InputService:IsKeyPressed(KeyboardKey.DownArrow) or
			   _InputService:IsKeyPressed(KeyboardKey.W) or
			   _InputService:IsKeyPressed(KeyboardKey.A) or
			   _InputService:IsKeyPressed(KeyboardKey.S) or
			   _InputService:IsKeyPressed(KeyboardKey.D) then
				self:ServerRequestCancelFishing()
				return
			end
			-- T64: 릴링 홀드 폴링 — F 키(PC) 또는 BtnInteract 홀드 플래그(모바일). 변화 시에만 RPC.
			if self.FishingState == "Reeling" then
				local holding = _InputService:IsKeyPressed(KeyboardKey.F) or (self._T.MobileReelHold == true)
				if holding ~= (self._T.ReelHolding == true) then
					self._T.ReelHolding = holding
					self:ServerSetReelHold(holding)
				end
			end
			return
		end

		-- T16: 이동속도 버프 반영 (충전 중에는 ChargeMoveScale 배)
		local movementBuff = self.Entity.MovementComponent
		if isvalid(movementBuff) then
			local moveSpeed = self:GetBuffedMoveSpeed()
			if self._T.ChargeActive then moveSpeed = moveSpeed * self.ChargeMoveScale end
			movementBuff.InputSpeed = moveSpeed
		end

		-- Resolve any overlaps with resource colliders first
		self:ResolveOverlaps(delta)

		-- description: Monitor player movement inputs to track last facing direction and drive movement.
		-- Handle visual IFrame flashing (translucent blinking) — 피격 i-frame 과 도착 무적 모두 같은 깜빡임.
		-- 버프·디버프 틴트(PlayerBuffs.GetVisualTint)도 여기서 같이 칠한다 — 내 아바타 색을 쓰는 곳은 이 한 곳이다.
		local avatar = self.Entity.AvatarRendererComponent
		if isvalid(avatar) then
			local alpha = 1.0
			if self.IFrameTimer > 0 or self.ArrivalProtected then
				-- Blink visual every 0.1s
				local sec = math.floor(_UtilLogic.ElapsedSeconds * 10)
				if sec % 2 == 0 then alpha = 0.4 else alpha = 0.8 end
			end
			local tint = Color(1, 1, 1, 1)
			local buffComp = self.Entity:GetComponent("script.PlayerBuffs")
			if isvalid(buffComp) then tint = buffComp:GetVisualTint() end
			local colorKey = string.format("%.2f|%.2f|%.2f|%.2f", tint.r, tint.g, tint.b, alpha)
			if colorKey ~= self._T.AvatarColorKey then
				self._T.AvatarColorKey = colorKey
				avatar:SetColor(tint.r, tint.g, tint.b, alpha)
			end
		end
		
		if self.IsDead then
			self:CancelCharge()
			local movement = self.Entity.MovementComponent
			if isvalid(movement) then movement:Stop() end
			return
		end

		-- 충전 평타(마법봉·자연 무기) 홀드 폴링 — 짧게 누르면 탭(OnKeyDown), 오래 누르면 충전.
		self:UpdateCharge(delta)
		
		-- Knockback: while active, interpolate player position smoothly on client (EaseOutCubic)
		if self.KnockTimer > 0 then
			self.KnockTimer = self.KnockTimer - delta
			
			local startPos = self._T.KnockStartPos
			local targetPos = self._T.KnockTargetPos
			local duration = self._T.KnockDuration
			
			if startPos and targetPos and duration and duration > 0 then
				local progress = 1.0 - math.max(0.0, self.KnockTimer / duration)
				-- EaseOutCubic formula: f(t) = 1 - (1-t)^3
				local t = 1.0 - progress
				local ease = 1.0 - (t * t * t)
				
				local currentPos = startPos + (targetPos - startPos) * ease
				local transform = self.Entity.TransformComponent
				if isvalid(transform) then
					transform.WorldPosition = Vector3(currentPos.x, currentPos.y, transform.WorldPosition.z)
				end
			end
			
			-- T101: 단순 접촉 피격 밀림일 때는 조작(movement:Stop())을 잠그지 않고 방향키 입력을 허용한다.
			-- 정식 윈드업 공격/스킬에 의한 넉백일 때만 movement:Stop()으로 조작을 차단.
			if not self._T.KnockIsTouch then
				local movement = self.Entity.MovementComponent
				if isvalid(movement) then
					movement:Stop()
				end
				return
			end
		end
		
		local dx = 0
		local dy = 0
		
		if _InputService:IsKeyPressed(KeyboardKey.LeftArrow) then
			dx = -1
		elseif _InputService:IsKeyPressed(KeyboardKey.RightArrow) then
			dx = 1
		end
		
		if _InputService:IsKeyPressed(KeyboardKey.UpArrow) then
			dy = 1
		elseif _InputService:IsKeyPressed(KeyboardKey.DownArrow) then
			dy = -1
		end
		
		local inputDx = dx
		local inputDy = dy
		
		-- Drive movement via MovementComponent
		local movement = self.Entity.MovementComponent
		if isvalid(movement) then
			if dx ~= 0 or dy ~= 0 then
				local speed = movement.InputSpeed
				local currentPos = nil
				local body = self.Entity.KinematicbodyComponent
				if isvalid(body) then
					currentPos = body:GetWorldGroundPosition()
				else
					currentPos = self.Entity.TransformComponent.WorldPosition:ToVector2()
				end
				
				local r = 0.3
				local step = speed * delta
				
				-- Test X movement
				if dx ~= 0 then
					local testXPos = currentPos + Vector2(dx * step, 0)
					if self:IsObstacle(testXPos, r, currentPos) then
						dx = 0
					end
				end
				
				-- Test Y movement
				if dy ~= 0 then
					local testYPos = currentPos + Vector2(0, dy * step)
					if self:IsObstacle(testYPos, r, currentPos) then
						dy = 0
					end
				end
				
				if dx ~= 0 or dy ~= 0 then
					local moveDir = Vector2(dx, dy):Normalize()
					if self._T.ChannelMode == "spin" then
						-- 회전 채널(쇠망치 회전) 중 이동: MovementComponent 를 쓰면 엔진이 진행 방향으로 몸을 돌리고
						-- 이동 모션을 잡아 회전 휘두르기·좌우 반전이 사라진다(2026-10-06 Play). 같은 속도·같은 장애물 검사로
						-- 몸체 위치만 직접 옮긴다(소환수 순간이동과 같은 KinematicbodyComponent.SetWorldPosition).
						-- 속도는 엔진 RectTile 환산(InputSpeed ÷ 1.2 × SpeedFactor, platform-rect §7)과 같게 맞춘 뒤 SpinMoveScale 만큼 늦춘다.
						movement:Stop()
						local sfx = 1
						local sfy = 1
						if isvalid(body) then
							sfx = body.SpeedFactor.x
							sfy = body.SpeedFactor.y
						end
						local spinStep = speed / 1.2 * self.SpinMoveScale * delta
						local wp = self.Entity.TransformComponent.WorldPosition
						local nx = wp.x + moveDir.x * spinStep * sfx
						local ny = wp.y + moveDir.y * spinStep * sfy
						if isvalid(body) then
							body:SetWorldPosition(Vector2(nx, ny))
						else
							self.Entity.TransformComponent.WorldPosition = Vector3(nx, ny, wp.z)
						end
					else
						movement:MoveToDirection(moveDir, delta)
					end
				else
					movement:Stop()
				end
			else
				movement:Stop()
			end
		end
		-- 회전 채널(쇠망치 회전) 중이면 이동이 정한 좌우 방향을 회전 박자 방향으로 다시 덮는다.
		self:ApplySpinFacing()

		-- Aim follows the last movement input (4/8-dir target); visual facing stays horizontal via MovementComponent.
		if inputDx ~= 0 or inputDy ~= 0 then
			local newDirX = inputDx
			local newDirY = inputDy
		
			-- Send to server if direction changed
			if newDirX ~= self.LastDirectionX or newDirY ~= self.LastDirectionY then
				self.LastDirectionX = newDirX
				self.LastDirectionY = newDirY
				self:ServerSetDirection(newDirX, newDirY)
			end
		end
		
		-- Belt-and-suspenders walk animation: the engine PlayerControllerComponent normally auto-
		-- transitions MOVE/IDLE, but our custom controller drives MovementComponent directly, so its
		-- auto-transition may not always fire. Mirror MOVE/IDLE from our arrow-key input as a fallback.
		-- In RectTile mode (no Rigidbody footholds), FALL/JUMP states never auto-transition to IDLE
		-- via NCIsOnGround, so FALL/JUMP must also transition back to IDLE/MOVE on ground locomotion.
		-- Guarded to never clobber HIT/DEAD/MINE/ATTACK.
		-- 회전 채널 중에는 MOVE/IDLE 로 바꾸지 않는다 — 상태 전환이 걷기·서기 모션을 다시 틀어 회전 휘두르기를 덮는다.
		if self:IsClient() and self._T.ChannelMode ~= "spin" then
			local stateComp = self.Entity.StateComponent
			if isvalid(stateComp) then
				local cur = stateComp.CurrentStateName
				if cur == nil or cur == "" or cur == "IDLE" or cur == "MOVE" or cur == "FALL" or cur == "JUMP" then
					local moving = (inputDx ~= 0 or inputDy ~= 0)
					if moving and cur ~= "MOVE" then
						stateComp:ChangeState("MOVE")
					elseif not moving and cur ~= "IDLE" then
						stateComp:ChangeState("IDLE")
					end
				end
			end
		end
		
		-- Update local placement preview
		self:UpdatePlacementPreview()

		-- 조준 대상 상호작용 가이드 (라벨 + 하이라이트)
		self:UpdateInteractGuide()

		-- 내 소환수 머리 위 체력바
		self:UpdateSummonHpBars()
	end

	@ExecSpace("Server")
	method void ServerSetDirection(integer dirX, integer dirY)
		-- description: Synchronize client facing direction to server.
		local playerComp = self.Entity.PlayerComponent
		if playerComp == nil or senderUserId ~= playerComp.UserId then
			return
		end
		
		-- 클라이언트 입력은 반드시 4방향 단위 벡터로 정규화한다.
		if math.abs(dirX) >= math.abs(dirY) and dirX ~= 0 then
			self.LastDirectionX = dirX > 0 and 1 or -1
			self.LastDirectionY = 0
		elseif dirY ~= 0 then
			self.LastDirectionX = 0
			self.LastDirectionY = dirY > 0 and 1 or -1
		else
			return
		end
		log("Player facing updated on server: " .. self.LastDirectionX .. ", " .. self.LastDirectionY)
	end

	@ExecSpace("ServerOnly")
	method void ServerDie()
		-- HP 0 → 쓰러짐. 조작·피격을 막고 DEAD 모션을 튼 뒤, 손실(보호권 있으면 면제)을 적용하고 귀환 흐름을 연다.
		-- 일반 맵: DownedRespawnSeconds 뒤 마을. 미클리어 레이드 보스방: 자동 부활 없이 BossRaidLogic 이 판정.
		if self.IsDead then return end
		self.IsDead = true
		self._T.DownedAt = _UtilLogic.ElapsedSeconds
		self:ClearSkillAreas()

		local movement = self.Entity.MovementComponent
		if isvalid(movement) then movement:Stop() end

		-- 낚시 중이었다면 세션을 정리한다(쓰러진 채 입질·릴링이 진행되지 않게).
		if self.FishingState ~= "None" then
			if isvalid(self.ActiveFishingSpot) then
				local spot = self.ActiveFishingSpot:GetComponent("script.FishingSpot")
				if isvalid(spot) then spot:CancelFishing(self.Entity) end
			end
			self.FishingState = "None"
			self.ActiveFishingSpot = nil
		end

		-- DEAD 는 StateComponent 기본 상태 — AvatarStateAnimationComponent 가 아바타 dead 동작으로 잇는다.
		-- DEAD 에서는 IDLE 외 전이가 막히므로(DEAD lock) 클라 MOVE/IDLE 미러링·HIT 복귀 타이머도 덮어쓰지 못한다.
		local sc = self.Entity.StateComponent
		if isvalid(sc) then sc:ChangeState("DEAD") end

		local lossText = self:ApplyDeathLoss()

		local mapName = ""
		if isvalid(self.Entity.CurrentMap) then mapName = self.Entity.CurrentMap.Name end
		local inRaid = _BossRaidLogic ~= nil and _BossRaidLogic:IsActiveBossRoom(mapName)
		local mode = inRaid and "raid" or "normal"
		local pos = self.Entity.TransformComponent.WorldPosition
		log("[DEATH] down user=" .. tostring(self.Entity.PlayerComponent.UserId) .. " map=" .. mapName
			.. " pos=(" .. string.format("%.1f, %.1f", pos.x, pos.y) .. ") mode=" .. mode .. " loss=" .. lossText)

		self:ClientOnDowned(mode, self.DownedRespawnSeconds, lossText)

		if self._T.respawnTimer ~= nil then
			_TimerService:ClearTimer(self._T.respawnTimer)
			self._T.respawnTimer = nil
		end
		if inRaid then
			-- 파티 전멸이면 BossRaidLogic 이 전원을 대기실로 보낸다. 아니면 보스 처치·부활권까지 쓰러진 채 대기.
			_BossRaidLogic:OnPlayerDowned(self.Entity)
			return
		end
		self._T.respawnTimer = _TimerService:SetTimerOnce(function()
			self._T.respawnTimer = nil
			if isvalid(self.Entity) and self.IsDead then self:WakeInTown() end
		end, self.DownedRespawnSeconds)
	end

	@ExecSpace("ServerOnly")
	method void TickDownedWatchdog()
		-- 쓰러진 채 복구 경로가 끊긴 경우의 안전망(1초 주기 서버 타이머가 부른다).
		-- ServerDie 는 단발 타이머(마을 귀환)·레이드 전멸 판정 한 번에 의존해서, 그 사이 어긋나면(맵 이동·인스턴스 파기·판정 경합 등)
		-- 영구히 쓰러진 채 남았다. 일정 시간이 지나도 복구되지 않으면 여기서 다시 시도한다. 정상 경로는 이 시간 안에 끝난다.
		local now = _UtilLogic.ElapsedSeconds
		if self._T.DownedAt == nil then self._T.DownedAt = now end
		local mapName = ""
		if isvalid(self.Entity.CurrentMap) then mapName = self.Entity.CurrentMap.Name end
		local inRaid = _BossRaidLogic ~= nil and _BossRaidLogic:IsActiveBossRoom(mapName)
		if inRaid then
			-- 활성 보스방: 전멸 판정을 놓쳤을 수 있으니 다시 본다(한 명이라도 서 있으면 아무 일도 없다).
			if now - self._T.DownedAt > 2.0 then _BossRaidLogic:CheckRaidWipe(mapName) end
			return
		end
		if self._T.respawnTimer ~= nil then return end
		if now - self._T.DownedAt < self.DownedRespawnSeconds + 3.0 then return end
		log("[DEATH] watchdog: stuck downed user=" .. tostring(self.Entity.PlayerComponent.UserId) .. " map=" .. mapName .. " -> town")
		self:WakeInTown()
	end

	@ExecSpace("ServerOnly")
	method string ApplyDeathLoss()
		-- 쓰러짐 손실. PlayerInventory(인벤토리)만 깎는다 — 상자(Chest)는 가구 엔티티의 별도 보관함이라 대상이 아니다.
		-- 인벤토리 보호권(DeathEffect=protect_inventory)이 있으면 1개 소모하고 손실을 막는다. 반환 = 패널 안내 문구.
		-- 손실은 쓰러지는 즉시 확정한다(쓰러진 채 접속을 끊어 피하지 못하게). 즉시 부활권은 상위 티켓이라
		-- 사용하면 RestoreDeathLoss 가 여기서 깎은 것(또는 소모된 보호권)을 _T.deathLossRecord 대로 되돌린다.
		self._T.deathLossRecord = nil
		local inv = self.Entity:GetComponent("script.PlayerInventory")
		if not isvalid(inv) then return "" end
		---@type PlayerInventory
		local pinv = inv
		local record = {}

		local guardName = pinv:GetDeathEffectItemName("protect_inventory")
		if guardName ~= "" and pinv:GetItemCount(guardName) > 0 and pinv:RemoveItem(guardName, 1) then
			record[#record + 1] = { name = guardName, count = 1 }
			self._T.deathLossRecord = record
			log("[DEATH] loss blocked by " .. guardName .. " (left " .. tostring(pinv:GetItemCount(guardName)) .. ")")
			return "인벤토리 보호권을 1개 사용해 가방을 지켰어요"
		end

		-- (아이템 이름, 비율) 목록: 원자재 DeathLossItems × DeathLossRatio + 코인 DeathCoinItem × DeathCoinLossRatio.
		-- 코인도 RemoveItem/AddItem 이 IsCurrencyItem 분기로 Coin 프로퍼티를 다루므로 같은 경로로 깎고 되돌린다.
		local targets = {}
		local ratio = math.max(0, math.min(1, self.DeathLossRatio))
		for name in string.gmatch(self.DeathLossItems or "", "[^,]+") do
			local itemName = string.match(name, "^%s*(.-)%s*$")
			if itemName ~= nil and itemName ~= "" then targets[#targets + 1] = { name = itemName, ratio = ratio } end
		end
		if self.DeathCoinItem ~= nil and self.DeathCoinItem ~= "" then
			targets[#targets + 1] = { name = self.DeathCoinItem, ratio = math.max(0, math.min(1, self.DeathCoinLossRatio)) }
		end

		local parts = {}
		for _, tg in ipairs(targets) do
			local count = pinv:GetItemCount(tg.name)
			local loss = math.floor(count * tg.ratio)
			if loss > 0 and pinv:RemoveItem(tg.name, loss) then
				record[#record + 1] = { name = tg.name, count = loss }
				parts[#parts + 1] = self:GetItemDisplayName(tg.name) .. " " .. tostring(loss)
				log("[DEATH] lost " .. tostring(loss) .. " " .. tg.name .. " (had " .. tostring(count) .. ")")
			end
		end
		self._T.deathLossRecord = record
		if #parts == 0 then return "잃어버린 물건은 없어요" end
		return "잃어버린 물건: " .. table.concat(parts, " · ")
	end

	@ExecSpace("ServerOnly")
	method void RestoreDeathLoss()
		-- 즉시 부활권(상위 티켓) 사용 시 이번 쓰러짐의 손실을 되돌린다 — 깎인 물건 또는 소모된 인벤토리 보호권.
		local record = self._T.deathLossRecord
		self._T.deathLossRecord = nil
		if record == nil then return end
		local inv = self.Entity:GetComponent("script.PlayerInventory")
		if not isvalid(inv) then return end
		---@type PlayerInventory
		local pinv = inv
		for _, e in ipairs(record) do
			if e.name ~= nil and e.name ~= "" and (tonumber(e.count) or 0) > 0 then
				pinv:AddItem(e.name, math.floor(tonumber(e.count) or 0))
				log("[DEATH] restored " .. tostring(e.count) .. " " .. tostring(e.name))
			end
		end
	end

	@ExecSpace("ServerOnly")
	method string GetItemDisplayName(string itemName)
		-- item_dataset.DisplayName(한글명). 없으면 Name 그대로.
		local ds = _DataService:GetTable("item_dataset")
		if ds == nil then return itemName end
		local row = ds:FindRow("Name", itemName)
		if row == nil then return itemName end
		local ok, v = pcall(function() return row:GetItem("DisplayName") end)
		if ok and v ~= nil and tostring(v) ~= "" then return tostring(v) end
		return itemName
	end

	@ExecSpace("ServerOnly")
	method void ReviveInPlace(string reason)
		-- 그 자리에서 깨어난다: HP 회복 → DEAD 해제(IDLE) → 짧은 보호 → 패널 닫기.
		-- 즉시 부활권 · 레이드 보스 처치 · (이동 전) 마을/대기실 귀환이 공통으로 쓴다.
		if not self.IsDead then return end
		if self._T.respawnTimer ~= nil then
			_TimerService:ClearTimer(self._T.respawnTimer)
			self._T.respawnTimer = nil
		end
		self.IsDead = false
		-- 부활 이후에는 되돌릴 손실 기록을 남기지 않는다(다음 쓰러짐 전 부활권 오사용 방지).
		self._T.deathLossRecord = nil

		local playerComp = self.Entity.PlayerComponent
		if playerComp == nil then return end
		local ratio = math.max(0.05, math.min(1.0, self.RespawnHpRatio))
		playerComp.Hp = math.max(1, math.floor(playerComp.MaxHp * ratio))

		local sc = self.Entity.StateComponent
		if isvalid(sc) and sc.CurrentStateName == "DEAD" then sc:ChangeState("IDLE") end

		-- 같은 맵에서 일어나면 OnMapEnter 가 불리지 않아 도착 보호가 걸리지 않는다 → 여기서 직접 건다.
		-- (맵을 옮기는 경우는 OnMapEnter 가 다시 걸어 준다 — 더 긴 쪽이 남는다.)
		local untilAt = _UtilLogic.ElapsedSeconds + self.RespawnProtectSeconds
		if untilAt > (tonumber(self._T.ArrivalImmuneUntil) or 0) then
			self._T.ArrivalImmuneUntil = untilAt
			self.ArrivalProtected = true
			self:ScheduleArrivalEnd(self.RespawnProtectSeconds)
		end

		self:ClientOnRevived()
		log("[DEATH] revive user=" .. tostring(playerComp.UserId) .. " reason=" .. reason .. " hp=" .. tostring(playerComp.Hp))
	end

	@ExecSpace("ServerOnly")
	method void ReviveAndMove(string targetMap, number x, number y, string reason)
		-- 화면을 덮고(RespawnCoverLeadSeconds) 부활시킨 뒤 targetMap 의 (x, y)로 보낸다. 마을 귀환·레이드 전멸 공용.
		-- 이미 그 맵이면 같은 맵 순간이동(짧은 커버)으로 처리한다 — 맵 이동 대기 커버가 타임아웃까지 남지 않게.
		if not self.IsDead then return end
		if self._T.respawnTimer ~= nil then
			_TimerService:ClearTimer(self._T.respawnTimer)
			self._T.respawnTimer = nil
		end
		local curMap = ""
		if isvalid(self.Entity.CurrentMap) then curMap = self.Entity.CurrentMap.Name end
		local sameMap = (curMap == targetMap)
		self:ClientPlayRespawnCover(not sameMap)
		self._T.respawnTimer = _TimerService:SetTimerOnce(function()
			self._T.respawnTimer = nil
			if not isvalid(self.Entity) or not self.IsDead then return end
			self:ReviveInPlace(reason)
			local playerComp = self.Entity.PlayerComponent
			if playerComp == nil then return end
			if sameMap then
				playerComp:SetWorldPosition(Vector3(x, y, 0))
			else
				playerComp:MoveToMapPosition(targetMap, Vector2(x, y))
			end
			log("[DEATH] moved user=" .. tostring(playerComp.UserId) .. " -> " .. targetMap
				.. " (" .. tostring(x) .. ", " .. tostring(y) .. ") reason=" .. reason)
		end, self.RespawnCoverLeadSeconds)
	end

	@ExecSpace("ServerOnly")
	method void WakeInTown()
		-- 일반 쓰러짐의 기본 귀환: 마을에서 깨어난다. 레이드 보스방에서는 쓰지 않는다(BossRaidLogic 판정).
		self:ReviveAndMove(self.DeathTownMap, self.DeathTownX, self.DeathTownY, "town")
	end

	@ExecSpace("ServerOnly")
	method void TryInstantRevive()
		-- 즉시 부활권 1개를 써서 그 자리에서 부활한다(레이드 포함). 쓰러짐 패널 버튼 · 인벤토리 사용 공용 진입점.
		if not self.IsDead then
			self:ShowMineFeedback("즉시 부활권은 쓰러져 있을 때 쓸 수 있어요.")
			return
		end
		local inv = self.Entity:GetComponent("script.PlayerInventory")
		if not isvalid(inv) then return end
		---@type PlayerInventory
		local pinv = inv
		local reviveName = pinv:GetDeathEffectItemName("instant_revive")
		if reviveName == "" or pinv:GetItemCount(reviveName) < 1 then
			self:ShowMineFeedback("즉시 부활권이 없어요. 마을 상점에서 살 수 있어요.")
			return
		end
		if not pinv:RemoveItem(reviveName, 1) then return end
		self:RestoreDeathLoss()
		self:ReviveInPlace("instant_revive")
		self:ShowMineFeedback("즉시 부활권을 사용했어요. 그 자리에서 일어나고 가방도 지켰어요.")
	end

	@ExecSpace("Server")
	method void ServerRequestInstantRevive()
		-- 쓰러짐 패널 "즉시 부활권 사용" 버튼.
		local playerComp = self.Entity.PlayerComponent
		if playerComp == nil or senderUserId ~= playerComp.UserId then return end
		self:TryInstantRevive()
	end

	@ExecSpace("Server")
	method void ServerRequestWakeInTown()
		-- 쓰러짐 패널 "마을에서 깨어나기" 버튼 — 남은 대기 없이 바로. 레이드 보스방에서는 막는다.
		local playerComp = self.Entity.PlayerComponent
		if playerComp == nil or senderUserId ~= playerComp.UserId then return end
		if not self.IsDead then return end
		local mapName = ""
		if isvalid(self.Entity.CurrentMap) then mapName = self.Entity.CurrentMap.Name end
		if _BossRaidLogic ~= nil and _BossRaidLogic:IsActiveBossRoom(mapName) then return end
		self:WakeInTown()
	end

	@ExecSpace("Client")
	method void ClientOnDowned(string mode, number seconds, string lossText)
		-- 쓰러짐 안내(본인 클라): 토스트 + 쓰러짐 패널(남은 시간 · 잃은 물건 · 즉시 부활권 버튼).
		-- ⚠ RPC 본문에 `---@type` 사용자 타입 주석 금지 (규칙 53 — LEA-1118) — 동적 디스패치.
		_ScreenMessageLogic:PrivateMsg("쓰러졌어요…")
		local hud = _EntityService:GetEntityByPath("/ui/HUDGroup")
		if not isvalid(hud) then return end
		local ctrl = hud:GetComponent("script.UIHUDController")
		if not isvalid(ctrl) then
			ctrl = hud:GetFirstChildComponentByTypeName("script.UIHUDController", true)
		end
		if isvalid(ctrl) then
			ctrl:ShowDowned(mode, seconds, lossText)
		end
	end

	@ExecSpace("Client")
	method void ClientOnRevived()
		-- 부활 통지(본인 클라): 쓰러짐 패널을 닫는다. ⚠ RPC 본문 — 사용자 타입 주석 금지 (규칙 53).
		local hud = _EntityService:GetEntityByPath("/ui/HUDGroup")
		if not isvalid(hud) then return end
		local ctrl = hud:GetComponent("script.UIHUDController")
		if not isvalid(ctrl) then
			ctrl = hud:GetFirstChildComponentByTypeName("script.UIHUDController", true)
		end
		if isvalid(ctrl) then
			ctrl:HideDowned()
		end
	end

	@ExecSpace("Client")
	method void ClientPlayRespawnCover(boolean waitForMapChange)
		-- 깨어나기 직전 화면을 덮는다. 같은 맵 순간이동이면 짧게 덮었다 걷고,
		-- 맵 이동(마을·대기실)은 포탈 전환과 같은 커버로 도착·렌더 안정까지 기다린다.
		-- ⚠ RPC 본문 — 사용자 타입 주석 금지 (규칙 53).
		local hud = _EntityService:GetEntityByPath("/ui/HUDGroup")
		if not isvalid(hud) then return end
		local ctrl = hud:GetComponent("script.UIHUDController")
		if not isvalid(ctrl) then
			ctrl = hud:GetFirstChildComponentByTypeName("script.UIHUDController", true)
		end
		if isvalid(ctrl) then
			ctrl:PlayRespawnCover(waitForMapChange)
		end
	end

	@ExecSpace("Client")
	method void ClientApplyKnockback(number startX, number startY, number targetX, number targetY, number duration, boolean isTouch)
		-- Initializes the visual cubic-ease-out knockback interpolation on the client.
		self._T.KnockStartPos = Vector2(startX, startY)
		self._T.KnockTargetPos = Vector2(targetX, targetY)
		self._T.KnockDuration = duration
		self._T.KnockIsTouch = (isTouch == true)
		self.KnockTimer = duration
		
		log("[KNOCKBACK] ClientApplyKnockback initialized: StartPos=(" .. string.format("%.2f, %.2f", startX, startY) .. "), TargetPos=(" .. string.format("%.2f, %.2f", targetX, targetY) .. "), Duration=" .. duration .. ", isTouch=" .. tostring(isTouch))
	end

	@ExecSpace("ClientOnly")
	method void TryMine()
		-- description: Attempts to trigger mining, placement, or consumable use on client-side.
		if self.Entity ~= _UserService.LocalPlayer then return end
		-- 회전 채널(쇠망치 회전) 중에는 평타·채집을 쓰지 않는다. 서버도 같은 기준으로 거절한다(RequestMine).
		if self:IsChanneling() then return end
		-- 모바일: 충전을 마치고 버튼을 뗄 때 따라오는 클릭 이벤트가 탭 평타를 또 치지 않게 막는다 (SetMobileAttackHold).
		local suppress = self._T.SuppressTapUntil
		if suppress ~= nil and _UtilLogic.ElapsedSeconds < suppress then return end
		local inv = self.Entity:GetComponent("script.PlayerInventory")
		local activeItem = ""
		if isvalid(inv) then
			local slots = _HttpService:JSONDecode(inv.QuickSlotsJson) or {}
			activeItem = slots[inv.SelectedQuickSlotIndex] or ""
			-- consumable: 쿨다운/타일맵 무관 — 퀵슬롯 Ctrl로 즉시 사용
			if activeItem ~= "" then
				local baseName = inv:GetBaseItemName(activeItem)
				local ds = _DataService:GetTable("item_dataset")
				if ds ~= nil then
					local row = ds:FindRow("Name", baseName)
					if row ~= nil and row:GetItem("Category") == "consumable" then
						-- 칸 키를 보낸다: 이름 붙은 가축·호루라기는 키로 개체를 구분한다(서버가 GetBaseItemName 으로 기본 이름을 구함).
						inv:ServerRequestUseItem(activeItem)
						return
					end
				end
			end
		end

		local now = _UtilLogic.ElapsedSeconds

		local currentMap = self.Entity.CurrentMap
		if not isvalid(currentMap) then return end
		local tilemap = currentMap:GetFirstChildComponentByTypeName("RectTileMapComponent")
		if not isvalid(tilemap) then return end
		local playerPos = self.Entity.TransformComponent.WorldPosition
		local aimWorldX = playerPos.x + self.LastDirectionX * 1.8
		local aimWorldY = playerPos.y + self.LastDirectionY * 1.8
		local targetCell = tilemap:ToCellPosition(Vector3(aimWorldX, aimWorldY, 0))
		if targetCell == nil then return end

		local isPlaceable = false
		local isBuildItem = false
		local terrainAction = ""
		local isTerrainTool = false
		local terrainCooldown = 0
		if isvalid(inv) and activeItem ~= "" then
			local baseName = inv:GetBaseItemName(activeItem)
			local ds = _DataService:GetTable("item_dataset")
			if ds ~= nil then
				local row = ds:FindRow("Name", baseName)
				if row ~= nil then
					local ok, v = pcall(function() return row:GetItem("TerrainEditAction") end)
					if ok and v ~= nil then terrainAction = v end
					if row:GetItem("Category") == "furniture" then
						isPlaceable = true
					elseif row:GetItem("Category") == "build" then
						isBuildItem = true
					end
					if terrainAction ~= nil and terrainAction ~= "" then
						isTerrainTool = row:GetItem("Category") == "tool"
						-- T61: 지형 편집 전용 쿨다운(TerrainEditCooldown 컬럼) — 공란이면 채집 쿨다운 폴백
						local okCd, rawCd = pcall(function() return row:GetItem("TerrainEditCooldown") end)
						if okCd and rawCd ~= nil and tostring(rawCd) ~= "" then
							terrainCooldown = tonumber(rawCd) or 0
						end
					end
				end
			end
		end

		local cooldown = self:GetEffectiveMineCooldown()
		if terrainAction ~= nil and terrainAction ~= "" and terrainCooldown > 0 then
			cooldown = terrainCooldown
		end
		if now - self.LastMineTime < cooldown then
			return
		end
		self.LastMineTime = now

		if terrainAction ~= nil and terrainAction ~= "" then
			if isTerrainTool then
				local state = self.Entity.StateComponent
				if isvalid(state) then
					state:ChangeState("MINE")
				end
				-- T65: 지형 편집 도구는 스윙음만 (타격음 확장 금지)
				self:ClientPlaySwingSound()
			end
			inv:ServerRequestTerrainEdit(activeItem, targetCell.x, targetCell.y, self.LastDirectionX, self.LastDirectionY)
			return
		end

		if isBuildItem and _BuildingManager ~= nil then
			-- 건축: 조준 칸(BuildingManager:GetAimUnit — 미리보기와 같은 단일 소스, 규칙 18)의 원점 셀을 보낸다.
			local unit = _BuildingManager:GetPlacementAimUnit(inv:GetBaseItemName(activeItem), playerPos.x, playerPos.y, self.LastDirectionX, self.LastDirectionY)
			log("[BUILD] place request " .. activeItem .. " unit=(" .. unit.x .. ", " .. unit.y .. ")")
			inv:ServerRequestPlace(activeItem, unit.x * 2, unit.y * 2)
			return
		end

		if isPlaceable then
			local baseName = inv:GetBaseItemName(activeItem)
			-- 점유 n×n (가구 기본 2, item_dataset.FootprintSize) — 미리보기·서버 검증과 같은 단일 소스.
			local footprint = _ResourceSpawner:GetPlaceFootprint(baseName)
			if footprint > 1 then
				local origin = _ResourceSpawner:GetAimBlockOrigin(targetCell.x, targetCell.y, self.LastDirectionX, self.LastDirectionY, footprint)
				targetCell = Vector2Int(origin.x, origin.y)
			end
			log("[PLACE] Requesting placement of " .. activeItem .. " at cell (" .. targetCell.x .. ", " .. targetCell.y .. ")")
			inv:ServerRequestPlace(activeItem, targetCell.x, targetCell.y)
			return
		end
		
		local state = self.Entity.StateComponent
		if isvalid(state) then
			state:ChangeState("MINE")
		end
		-- T65: 채집/공격 스윙음 (허공 포함 — 매 Ctrl 스윙)
		self:ClientPlaySwingSound()
		
		self:RequestMine(targetCell.x, targetCell.y)
	end

	@ExecSpace("ClientOnly")
	method void OnKeyDown(KeyDownEvent event)
		-- description: Handle keyboard input events on client.
		if self.Entity ~= _UserService.LocalPlayer then return end
		
		-- 메인 메뉴(타이틀/슬롯선택/커스텀)가 열려있으면 단축키 비활성화
		local mainMenu = _EntityService:GetEntityByPath("/ui/MainMenuGroup")
		if isvalid(mainMenu) and mainMenu.Enable then return end

		if self.IsSleeping then
			self:ServerRequestWakeUp()
			return
		end
		
		local key = event.key
		
		if key == KeyboardKey.LeftControl or key == KeyboardKey.RightControl then
			-- 충전 폴링(UpdateCharge)의 홀드 시작 기준. 탭은 그대로 즉시 처리한다.
			if self._T.AttackHeldSince == nil then
				self._T.AttackHeldSince = _UtilLogic.ElapsedSeconds
				self._T.ChargeChecked = nil
			end
			-- 충전 가능한 무기(마법봉·자연 무기)는 탭을 "뗄 때" 처리한다 — 누르는 순간엔 탭인지 홀드인지 모르기 때문이다.
			-- 충전이 시작되지 않은 채 키를 떼면 UpdateCharge 가 그때 TryMine 을 부른다. 그 밖의 무기는 지금처럼 즉시 처리.
			if self:ShouldDeferTap() then
				self._T.DeferTap = true
			else
				self:TryMine()
			end
		elseif key == KeyboardKey.LeftAlt or key == KeyboardKey.RightAlt then
			log("Visual Jump key (Alt) pressed.")
			local movement = self.Entity.MovementComponent
			if isvalid(movement) then
				movement:Jump()
			end
		elseif key == KeyboardKey.Space then
			local popup = _EntityService:GetEntityByPath("/ui/PopupGroup/CraftingPopup")
			if isvalid(popup) and popup.Enable then
				local controller = popup:GetComponent("script.UICraftingController")
				if isvalid(controller) then
					controller:TryCraft()
				end
			end
		elseif key == KeyboardKey.I then
			local popup = _EntityService:GetEntityByPath("/ui/PopupGroup/InventoryPopup")
			if isvalid(popup) then
				local controller = popup:GetComponent("script.UIInventoryController")
				if isvalid(controller) then
					controller:Toggle()
				end
			end
		elseif key == KeyboardKey.C then
			local popup = _EntityService:GetEntityByPath("/ui/PopupGroup/CraftingPopup")
			if isvalid(popup) then
				local controller = popup:GetComponent("script.UICraftingController")
				if isvalid(controller) then
					controller:Toggle()
				end
			end
		elseif key == KeyboardKey.H then
			-- Character info popup. Moved from E to H to free E for skill slot 3. (Phase 13 #2)
			local popup = _EntityService:GetEntityByPath("/ui/PopupGroup/CharacterPopup")
			if isvalid(popup) then
				local controller = popup:GetComponent("script.UICharacterController")
				if isvalid(controller) then
					controller:Toggle()
				end
			end
		elseif key == KeyboardKey.Q then
			self:TryCastSlot(1)
		elseif key == KeyboardKey.W then
			self:TryCastSlot(2)
		elseif key == KeyboardKey.E then
			self:TryCastSlot(3)
		elseif key == KeyboardKey.R then
			self:TryCastSlot(4)
		elseif key == KeyboardKey.K then
			-- 스킬트리 팝업 토글 (S3)
			local popup = _EntityService:GetEntityByPath("/ui/PopupGroup/SkillTreePopup")
			if isvalid(popup) then
				local controller = popup:GetComponent("script.UISkillTreeController")
				if isvalid(controller) then
					---@type UISkillTreeController
					local c = controller
					c:Toggle()
				end
			end
		elseif key == KeyboardKey.B then
			-- R-1 Stage B: 보스 컨텐츠 창 토글 (HUD BtnBossRaid 와 같은 경로)
			local popup = _EntityService:GetEntityByPath("/ui/PopupGroup/BossContentsPopup")
			if not isvalid(popup) then
				log_warning("[RAID-UI] B key: BossContentsPopup missing")
				return
			end
			---@type UIBossContentsController
			local controller = popup:GetComponent("script.UIBossContentsController")
			if isvalid(controller) then
				controller:Toggle()
			else
				log_warning("[RAID-UI] B key: UIBossContentsController missing")
			end
		elseif key == KeyboardKey.J then
			-- T22: 도감 팝업 토글 (아이템/몬스터/업적)
			local popup = _EntityService:GetEntityByPath("/ui/PopupGroup/CollectionPopup")
			if not isvalid(popup) then
				log_warning("[DEX] J key: CollectionPopup missing")
				return
			end
			---@type UICollectionController
			local controller = popup:GetComponent("script.UICollectionController")
			if isvalid(controller) then
				controller:Toggle()
			else
				log_warning("[DEX] J key: UICollectionController missing")
			end
		elseif key == KeyboardKey.F then
			-- T59: F 본문은 TryInteract로 추출(로직 변경 없음). 분산 핸들러는 기존 KeyDown 동시 리슨 유지.
			self:TryInteract()
		else
			-- Numeric Keys (1 to 0)
			local slotIndex = 0
			if key == KeyboardKey.Alpha1 then slotIndex = 1
			elseif key == KeyboardKey.Alpha2 then slotIndex = 2
			elseif key == KeyboardKey.Alpha3 then slotIndex = 3
			elseif key == KeyboardKey.Alpha4 then slotIndex = 4
			elseif key == KeyboardKey.Alpha5 then slotIndex = 5
			elseif key == KeyboardKey.Alpha6 then slotIndex = 6
			elseif key == KeyboardKey.Alpha7 then slotIndex = 7
			elseif key == KeyboardKey.Alpha8 then slotIndex = 8
			elseif key == KeyboardKey.Alpha9 then slotIndex = 9
			elseif key == KeyboardKey.Alpha0 then slotIndex = 10
			end
		
			if slotIndex > 0 then
				local pinv = self.Entity:GetComponent("script.PlayerInventory")
				if isvalid(pinv) then
					pinv:ServerSelectQuickSlot(slotIndex)
				end
			end
		end
	end

	@ExecSpace("ClientOnly")
	method Entity FindNearbyFurnace()
		-- T67: 조준선(IsAimTarget) 필터 — 근접 거리 판정 폐지.
		local currentMap = self.Entity.CurrentMap
		if not isvalid(currentMap) then return nil end
		
		local myPos = self.Entity.TransformComponent.WorldPosition:ToVector2()
		local closest = nil
		local minDist = 9999.0
		
		local furnaceComponents = currentMap:GetChildComponentsByTypeName("script.Furnace", true)
		if not furnaceComponents then return nil end
		
		for _, comp in ipairs(furnaceComponents) do
			if isvalid(comp) then
				local ent = comp.Entity
				if isvalid(ent) and self:IsAimTargetCore(ent, false) then
					local fPos = ent.TransformComponent.WorldPosition:ToVector2()
					local dist = (myPos - fPos):Magnitude()
					if dist < minDist then
						minDist = dist
						closest = ent
					end
				end
			end
		end
		
		return closest
	end

	@ExecSpace("ClientOnly")
	method Entity FindNearbyChest()
		-- T67: 조준선(IsAimTarget) 필터 — 근접 거리 판정 폐지.
		local currentMap = self.Entity.CurrentMap
		if not isvalid(currentMap) then return nil end
		
		local myPos = self.Entity.TransformComponent.WorldPosition:ToVector2()
		local closest = nil
		local minDist = 9999.0
		
		local chestComponents = currentMap:GetChildComponentsByTypeName("script.Chest", true)
		if not chestComponents then return nil end
		
		for _, comp in ipairs(chestComponents) do
			if isvalid(comp) then
				local ent = comp.Entity
				if isvalid(ent) and self:IsAimTargetCore(ent, false) then
					local fPos = ent.TransformComponent.WorldPosition:ToVector2()
					local dist = (myPos - fPos):Magnitude()
					if dist < minDist then
						minDist = dist
						closest = ent
					end
				end
			end
		end
		
		return closest
	end

	method string ResolveEquippedToolSound(string columnName)
		-- T65: 장착 퀵슬롯 도구의 SwingSoundRUID/HitSoundRUID — 공란·미장착이면 Default* 폴백.
		local defaultRuid = ""
		if columnName == "SwingSoundRUID" then
			defaultRuid = self.DefaultSwingSoundRUID or ""
		elseif columnName == "HitSoundRUID" then
			defaultRuid = self.DefaultHitSoundRUID or ""
		end
		local inv = self.Entity:GetComponent("script.PlayerInventory")
		if not isvalid(inv) then return defaultRuid end
		---@type PlayerInventory
		local pi = inv
		local slots = _HttpService:JSONDecode(pi.QuickSlotsJson) or {}
		local activeItem = slots[pi.SelectedQuickSlotIndex] or ""
		if activeItem == "" then return defaultRuid end
		local baseName = pi:GetBaseItemName(activeItem)
		local ds = _DataService:GetTable("item_dataset")
		if ds == nil then return defaultRuid end
		local row = ds:FindRow("Name", baseName)
		if row == nil then return defaultRuid end
		local ok, v = pcall(function() return row:GetItem(columnName) end)
		if ok and v ~= nil and tostring(v) ~= "" then
			return tostring(v)
		end
		return defaultRuid
	end

	method number GetToolSoundVolume(string ruid, string columnName)
		-- 맨손 기본음(Default*SoundRUID)과 같은 소리일 때만 줄인 볼륨, 아니면 1.0.
		if columnName == "SwingSoundRUID" and ruid == self.DefaultSwingSoundRUID then return self.DefaultSwingSoundVolume end
		if columnName == "HitSoundRUID" and ruid == self.DefaultHitSoundRUID then return self.DefaultHitSoundVolume end
		return 1.0
	end

	@ExecSpace("ClientOnly")
	method void ClientPlaySwingSound()
		-- T65: 로컬 스윙음 (TryMine MINE 진입 — 허공/지형 편집 포함).
		local ruid = self:ResolveEquippedToolSound("SwingSoundRUID")
		if ruid == nil or ruid == "" then return end
		if not _BGMManager:PlayInGameSound(ruid, self:GetToolSoundVolume(ruid, "SwingSoundRUID")) then return end
		log("[T65][SWING] sound=" .. ruid)
	end

	@ExecSpace("Client")
	method void ClientPlayMineEffect(boolean hitSuccess, Entity targetEntity)
		-- T65: 자원 명중 타격음 (RequestMine→Client RPC). 몬스터는 HandleHitEvent 경로.
		if not hitSuccess then return end
		if isvalid(targetEntity) and isvalid(targetEntity:GetComponent("script.Monster")) then
			return
		end
		local ruid = self:ResolveEquippedToolSound("HitSoundRUID")
		if ruid == nil or ruid == "" then return end
		if not _BGMManager:PlayInGameSound(ruid, self:GetToolSoundVolume(ruid, "HitSoundRUID")) then return end
		log("[T65][HIT] resource sound=" .. ruid)
	end

	@ExecSpace("Client")
	method void ShowMineFeedback(string message)
		-- description: Show gathering feedback as a screen popup message.
		_ScreenMessageLogic:PrivateMsg(message)
		log("[Gather] " .. message)
	end

	@ExecSpace("Server")
	method void RequestMine(integer targetCellX, integer targetCellY)
		-- description: Execute mining verification and execution on the server.
		local playerComp = self.Entity.PlayerComponent
		if playerComp == nil or senderUserId ~= playerComp.UserId then
			return
		end
		if self:IsChanneling() then return end
		
		local now = _UtilLogic.ServerElapsedSeconds
		if now - self.LastMineTime < self:GetEffectiveMineCooldown() - 0.1 then
			return
		end
		self.LastMineTime = now
		
		local currentMap = self.Entity.CurrentMap
		if not isvalid(currentMap) then
			log_warning("Player is not on a valid map.")
			return
		end
		
		---@type RectTileMapComponent
		local tilemap = currentMap:GetFirstChildComponentByTypeName("RectTileMapComponent", true)
		if not isvalid(tilemap) then
			log_warning("Target map does not contain a RectTileMapComponent.")
			return
		end
		
		-- 서버 위치와 서버가 보관한 방향 기준으로 타겟 셀의 거리 및 방향 검증
		local playerPos = self.Entity.TransformComponent.WorldPosition
		local targetCenterX = targetCellX + 0.5
		local targetCenterY = targetCellY + 0.5
		local dx = targetCenterX - playerPos.x
		local dy = targetCenterY - playerPos.y
		local distSq = dx * dx + dy * dy
		if distSq > 12.25 then
			log_warning("Player " .. self.Entity.Name .. " attempted out-of-range mine target.")
			return
		end
		if self.LastDirectionX ~= 0 and (dx * self.LastDirectionX < -0.5) then
			log_warning("Player " .. self.Entity.Name .. " attempted backward mine target X.")
			return
		end
		if self.LastDirectionY ~= 0 and (dy * self.LastDirectionY < -0.5) then
			log_warning("Player " .. self.Entity.Name .. " attempted backward mine target Y.")
			return
		end
		
		-- Locate cell targeted by client
		local targetCell = Vector2Int(targetCellX, targetCellY)
		
		-- Combat: if a monster is within the front attack range, attack in front instead of mining.
		local playerPos = self.Entity.TransformComponent.WorldPosition
		-- 원거리 평타 무기(WeaponAttackDataSet 에 Tap 행이 있는 무기 — 자연 무기)는 근접 상자 대신 탄을 쏜다. 전투 맵에서만.
		local tapRow = nil
		if self:IsCombatSkillMap() then
			tapRow = self:GetWeaponAttackRow(self:GetEquippedWeaponType(), "Tap", 1)
		end
		local monsterEntity = self:FindMonsterInFront(currentMap, playerPos, self.LastDirectionX, self.LastDirectionY)
		if isvalid(monsterEntity) then
			if tapRow ~= nil then
				self:FireWeaponProjectile(tapRow, self.LastDirectionX, self.LastDirectionY)
			else
				local combat = self.Entity:GetComponent("script.PlayerCombat")
				if isvalid(combat) then
					---@type PlayerCombat
					local pc = combat
					pc:DoAttackInFront(Vector2(playerPos.x, playerPos.y), self.LastDirectionX, self.LastDirectionY)
				end
			end
			self:ClientPlayMineEffect(true, monsterEntity)
			return
		end
		
		-- Query the spawned resource entity occupying the target cell (entity-only mining)
		local key = math.floor(targetCell.x) .. "_" .. math.floor(targetCell.y)
		local resourceSpawner = _ResourceSpawner
		local pivotKey = nil
		---@type Entity
		local targetEntity = nil
		
		local gridToEntity = resourceSpawner and resourceSpawner:GetGridToEntity(currentMap.Name)
		if gridToEntity then
			local gridData = gridToEntity[key]
			if gridData and (gridData.isTile or gridData.isBuild or isvalid(gridData.entity)) then
				pivotKey = math.floor(gridData.pivotX) .. "_" .. math.floor(gridData.pivotY)
				targetEntity = gridData.entity
			end
			
			-- 타겟 셀에서 미검출 시, 바라보는 방향 전방(2.0 유닛) 셀 추가 탐색 (2배 스케일 채광 판정)
			if pivotKey == nil then
				local probeX = math.floor(playerPos.x + self.LastDirectionX * 2.0)
				local probeY = math.floor(playerPos.y + self.LastDirectionY * 2.0)
				local probeKey = probeX .. "_" .. probeY
				local pData = gridToEntity[probeKey]
				if pData and (pData.isTile or pData.isBuild or isvalid(pData.entity)) then
					pivotKey = math.floor(pData.pivotX) .. "_" .. math.floor(pData.pivotY)
					targetEntity = pData.entity
				end
			end
		end
		
		-- 건축 바닥 철거 타격: 바닥은 GridToEntity 밖(위에 가구를 놓아야 한다)이라 점유가 없는 조준 셀만 따로 본다.
		if pivotKey == nil and _BuildingManager ~= nil and _BuildingManager:TryHitFloor(currentMap, targetCell.x, targetCell.y, self.Entity) then
			self:ClientPlayMineEffect(true, nil)
			return
		end

		if pivotKey ~= nil then

			-- Play hit effect on all clients (attached to target resource entity)
			self:ClientPlayMineEffect(true, targetEntity)
		
			-- Report the hit to the durability manager using the entity's pivot key
			_TileDurabilityManager:HitResource(currentMap, pivotKey, self.Entity)
		else
			-- Play air swing effect on all clients (attached to player)
			self:ClientPlayMineEffect(false, nil)
			log("No resource entity found at target cell " .. tostring(targetCell))
			-- 자원도 몬스터도 없는 허공이면 원거리 평타는 그대로 발사한다 (몬스터가 근접 범위 밖일 수 있다).
			if tapRow ~= nil then
				self:FireWeaponProjectile(tapRow, self.LastDirectionX, self.LastDirectionY)
			end
		end
	end

	-- =========================================================================
	-- 충전 평타 (마법봉 · 자연 무기) — docs/design/job-branch-redesign.md §3.4
	-- 탭: OnKeyDown → TryMine (즉시 휘두르기·정령탄). 홀드: UpdateCharge 가 키를 폴링해 충전 시간을 재고,
	-- 키를 떼면 서버에 발사(생명 펄스)를 요청한다. 서버는 자기 시계로 충전 시간을 다시 잰다(클라 보고값을 믿지 않는다).
	-- 엔진 KeyHoldEvent 대신 IsKeyPressed 폴링을 쓴다(낚시 릴 홀드와 같은 패턴): 시작 지연을 직접 정할 수 있고 모바일 버튼 홀드와 한 경로가 된다.
	-- =========================================================================

	@ExecSpace("ClientOnly")
	method boolean IsHandItemBlockingAttack()
		-- 손에 든 퀵슬롯 아이템이 소비·설치·지형 편집용이면 Ctrl 은 그 용도다(TryMine 앞쪽 분기와 같은 기준). 충전하지 않는다.
		local inv = self.Entity:GetComponent("script.PlayerInventory")
		if not isvalid(inv) then return false end
		---@type PlayerInventory
		local p = inv
		local slots = _HttpService:JSONDecode(p.QuickSlotsJson) or {}
		local activeItem = slots[p.SelectedQuickSlotIndex] or ""
		if activeItem == "" then return false end
		local baseName = p:GetBaseItemName(activeItem)
		local category = p:GetItemText(baseName, "Category")
		if category == "consumable" or category == "furniture" or category == "build" then return true end
		return p:GetItemText(baseName, "TerrainEditAction") ~= ""
	end

	@ExecSpace("ClientOnly")
	method boolean ShouldDeferTap()
		-- 탭을 뗄 때로 미룰지: 충전할 수 있는 상황(전투 맵 · 충전 단계가 있는 주무기 · 손 아이템이 다른 용도가 아님)일 때만.
		-- 아니면 지금처럼 누르는 즉시 처리한다. 재충전 대기 중이어도 미룬다(뗄 때 탭으로 나간다).
		if self.IsDead or self.IsSleeping or self.FishingState ~= "None" then return false end
		if not self:IsCombatSkillMap() then return false end
		if self:GetChargeStageFor(self:GetEquippedWeaponType(), 999) < 1 then return false end
		return not self:IsHandItemBlockingAttack()
	end

	@ExecSpace("ClientOnly")
	method boolean CanBeginCharge(number now)
		-- 충전 가능 조건: 전투 맵 · 충전 단계가 있는 주무기 · 메인 메뉴가 닫힘 · 손 아이템이 다른 용도가 아님 · 생명 펄스 재충전 대기 중이 아님.
		if self.IsDead or self.IsSleeping or self.FishingState ~= "None" then return false end
		if not self:IsCombatSkillMap() then return false end
		local mainMenu = _EntityService:GetEntityByPath("/ui/MainMenuGroup")
		if isvalid(mainMenu) and mainMenu.Enable then return false end
		local weaponType = self:GetEquippedWeaponType()
		if self:GetChargeStageFor(weaponType, 999) < 1 then return false end
		if self:IsHandItemBlockingAttack() then return false end
		local row1 = self:GetWeaponAttackRow(weaponType, "Charge", 1)
		if row1 ~= nil and self:SkillText(row1, "Kind") == "HealPulse" and now < (self._T.PulseReadyAt or 0) then
			self:ShowMineFeedback("[생명 펄스] 재충전 중입니다.")
			return false
		end
		return true
	end

	@ExecSpace("ClientOnly")
	method void BeginCharge(number now)
		-- 충전 시작: 상태 기록 + 머리 위로 에너지가 모이는 반복 파티클(공식 BasicParticle — 리소스 불필요) + 서버에 기준점 통지.
		self._T.ChargeActive = true
		self._T.ChargeBegan = now
		self._T.ChargeStage = 0
		self._T.ChargeWeapon = self:GetEquippedWeaponType()
		self._T.ChargeParticle = _ParticleService:PlayBasicParticleAttached(BasicParticleType.ChargeOrb, self.Entity, Vector3(0, 0.5, 0), 0, Vector3(1, 1, 1), true)
		self:ServerRequestChargeStart()
		log("[WEAPON] charge begin weapon=" .. tostring(self._T.ChargeWeapon))
	end

	@ExecSpace("ClientOnly")
	method void TickCharge(number now)
		-- 충전 단계 갱신. 단계가 오를 때 한 번 터지는 원형 파동으로 "다음 단계 도달"을 알린다.
		local stage = self:GetChargeStageFor(self._T.ChargeWeapon or "", now - (self._T.ChargeBegan or now))
		if stage > (self._T.ChargeStage or 0) then
			self._T.ChargeStage = stage
			_ParticleService:PlayBasicParticleAttached(BasicParticleType.CircleBurst, self.Entity, Vector3(0, 0.5, 0), 0, Vector3(1, 1, 1), false)
			log("[WEAPON] charge stage=" .. tostring(stage))
		end
	end

	@ExecSpace("ClientOnly")
	method void EndChargeVisual()
		-- 반복 파티클 회수 (serial 은 BeginCharge 가 보관한다).
		local serial = self._T.ChargeParticle
		if serial ~= nil and serial ~= 0 then _ParticleService:RemoveParticle(serial) end
		self._T.ChargeParticle = nil
	end

	@ExecSpace("ClientOnly")
	method void ReleaseCharge(number now)
		-- 키를 뗐다: 1단계 이상 모였으면 서버에 발사(펄스)를 요청한다. 방향은 서버가 다시 정리한다.
		local weaponType = self._T.ChargeWeapon or ""
		local stage = self:GetChargeStageFor(weaponType, now - (self._T.ChargeBegan or now))
		self:EndChargeVisual()
		self._T.ChargeActive = false
		self._T.ChargeStage = 0
		if stage < 1 then
			log("[WEAPON] charge cancelled before stage 1")
			return
		end
		-- 생명 펄스: 서버와 같은 재충전 대기를 클라에서도 세어 다음 충전 시작 단계에서 막는다.
		local row = self:GetWeaponAttackRow(weaponType, "Charge", stage)
		if row ~= nil and self:SkillText(row, "Kind") == "HealPulse" then
			self._T.PulseReadyAt = now + self:SkillNumber(row, "LockoutSeconds", 3)
		end
		self:ServerRequestChargeRelease(self.LastDirectionX, self.LastDirectionY)
		self._T.ChargeUsedThisSession = true
		log("[WEAPON] charge release weapon=" .. weaponType .. " stage=" .. tostring(stage))
	end

	@ExecSpace("ClientOnly")
	method void MaybeShowChargeHint()
		-- 충전 무기를 들고 탭만 쓰는 동안 "꾹 누르면 충전 공격"을 알려 준다: 첫 탭에 한 번, 이후 ChargeHintEveryTaps 번마다.
		-- 이번 접속에서 충전을 한 번이라도 쓰면 다시 띄우지 않는다. 문구는 1단계 충전 행의 Kind(Projectile/HealPulse)로 고른다.
		if self._T.ChargeUsedThisSession == true then return end
		local count = (self._T.ChargeHintTapCount or 0) + 1
		self._T.ChargeHintTapCount = count
		if count ~= 1 and count % math.max(1, self.ChargeHintEveryTaps) ~= 0 then return end
		local row = self:GetWeaponAttackRow(self:GetEquippedWeaponType(), "Charge", 1)
		if row == nil then return end
		local what = "충전 공격"
		local kind = self:SkillText(row, "Kind")
		if kind == "HealPulse" then what = "생명 펄스(주변 아군·소환수 회복)" elseif kind == "Projectile" then what = "충전 마법탄" end
		self:ShowMineFeedback("[팁] 공격 키(Ctrl · 공격 버튼)를 꾹 눌렀다 떼면 " .. what .. "!")
	end

	@ExecSpace("ClientOnly")
	method void CancelCharge()
		-- 스킬 시전·사망·수면·낚시·맵 이동으로 충전을 버린다(발사 없음). 서버의 시작 기록은 다음 시작 때 덮인다.
		-- 뗄 때 처리하려던 탭도 함께 버린다(스킬을 쓴 뒤 뒤늦게 평타가 나가지 않게).
		self._T.DeferTap = nil
		if not self._T.ChargeActive then return end
		self:EndChargeVisual()
		self._T.ChargeActive = false
		self._T.ChargeStage = 0
		-- 키를 계속 누르고 있어도 같은 홀드에서는 다시 충전하지 않는다.
		self._T.ChargeChecked = self._T.AttackHeldSince
		log("[WEAPON] charge cancelled")
	end

	@ExecSpace("ClientOnly")
	method void UpdateCharge(number delta)
		-- 공격키(Ctrl · 모바일 공격 버튼) 홀드 폴링. OnUpdate 에서 로컬 플레이어만 부른다.
		-- 짧게 누르면 탭(OnKeyDown 의 TryMine)이고, ChargeStartDelay 이상 누르면 충전이 시작된다(충전 가능한 무기만).
		local now = _UtilLogic.ElapsedSeconds
		local holding = _InputService:IsKeyPressed(KeyboardKey.LeftControl)
			or _InputService:IsKeyPressed(KeyboardKey.RightControl)
			or self._T.MobileAttackHold == true
		if not holding then
			self._T.AttackHeldSince = nil
			self._T.ChargeChecked = nil
			local deferredTap = self._T.DeferTap
			self._T.DeferTap = nil
			if self._T.ChargeActive then
				self:ReleaseCharge(now)
			elseif deferredTap then
				-- 충전으로 이어지지 않은 누름 = 탭. 뗀 지금 휘두른다(정령탄·근접 상자는 TryMine → RequestMine 이 정한다).
				self:TryMine()
				self:MaybeShowChargeHint()
			end
			return
		end
		if self._T.AttackHeldSince == nil then self._T.AttackHeldSince = now end
		if self._T.ChargeActive then
			self:TickCharge(now)
			return
		end
		-- 이 홀드에서는 한 번만 판정한다(충전이 안 되는 무기·장소에서 매 프레임 조회하지 않도록).
		if self._T.ChargeChecked ~= self._T.AttackHeldSince and now - self._T.AttackHeldSince >= self.ChargeStartDelay then
			self._T.ChargeChecked = self._T.AttackHeldSince
			if self:CanBeginCharge(now) then self:BeginCharge(now) end
		end
	end

	@ExecSpace("ClientOnly")
	method void SetMobileAttackHold(boolean holding)
		-- UIHUDController 공격 버튼(BtnMine)의 Pressed/Released → 홀드 플래그. UpdateCharge 폴링이 소비한다(낚시 릴 홀드와 같은 패턴).
		local now = _UtilLogic.ElapsedSeconds
		if holding then
			self._T.AttackHeldSince = now
			self._T.ChargeChecked = nil
		elseif self._T.ChargeActive then
			-- 뗄 때 따라오는 클릭 이벤트가 충전 발사 직후 탭 평타를 또 치지 않게 막는다.
			self._T.SuppressTapUntil = now + 0.35
		end
		self._T.MobileAttackHold = holding
	end

	@ExecSpace("Server")
	method void ServerRequestChargeStart()
		-- 충전 시작을 서버에 알린다: 서버 시계로 충전 시간을 재기 위한 기준점이다.
		local playerComp = self.Entity.PlayerComponent
		if playerComp == nil or senderUserId ~= playerComp.UserId then return end
		if self.IsDead or self.IsSleeping or self.FishingState ~= "None" or self:IsChanneling() then return end
		if not self:IsCombatSkillMap() then return end
		if self:GetChargeStageFor(self:GetEquippedWeaponType(), 999) < 1 then return end
		self._T.ChargeStartAt = _UtilLogic.ServerElapsedSeconds
	end

	@ExecSpace("Server")
	method void ServerRequestChargeRelease(integer dirX, integer dirY)
		-- 충전 해제: 서버가 잰 충전 시간으로 단계를 정하고 마법탄 발사 또는 생명 펄스를 실행한다. 클라가 말한 단계는 받지 않는다.
		local playerComp = self.Entity.PlayerComponent
		if playerComp == nil or senderUserId ~= playerComp.UserId then return end
		if self.IsDead or self.IsSleeping or self.FishingState ~= "None" then return end
		local startAt = self._T.ChargeStartAt
		self._T.ChargeStartAt = nil
		if startAt == nil or self:IsChanneling() then return end
		if not self:IsCombatSkillMap() then return end
		local now = _UtilLogic.ServerElapsedSeconds
		if now - (self._T.LastChargeFireAt or -999) < self.ChargeMinInterval then return end
		local held = now - startAt
		local weaponType = self:GetEquippedWeaponType()
		local stage = self:GetChargeStageFor(weaponType, held + self.ChargeTolerance)
		if stage < 1 then return end
		local row = self:GetWeaponAttackRow(weaponType, "Charge", stage)
		if row == nil then return end
		-- 방향은 서버에서 -1/0/1 로 정리한다(큰 클라이언트 벡터로 원거리 시전할 수 없게). 둘 다 0 이면 서버가 보관한 방향.
		if dirX > 0 then dirX = 1 elseif dirX < 0 then dirX = -1 else dirX = 0 end
		if dirY > 0 then dirY = 1 elseif dirY < 0 then dirY = -1 else dirY = 0 end
		if dirX == 0 and dirY == 0 then
			dirX = self.LastDirectionX
			dirY = self.LastDirectionY
		end
		local kind = self:SkillText(row, "Kind")
		if kind == "HealPulse" then
			if now < (self._T.PulseReadyAt or 0) then
				self:ClientShowMineFeedback("[생명 펄스] 재충전 중입니다.", playerComp.UserId)
				return
			end
			self._T.PulseReadyAt = now + self:SkillNumber(row, "LockoutSeconds", 3)
			self:DoHealPulse(row)
		elseif kind == "Projectile" then
			self:FireWeaponProjectile(row, dirX, dirY)
		else
			return
		end
		self._T.LastChargeFireAt = now
		-- 퀘스트/업적: 충전 평타 사용(전직 첫 퀘스트의 "충전 공격 1회").
		_ActionSignals:EmitToPlayer(self.Entity, _ActionEnum.ChargeAttack, weaponType, 1)
		log("[WEAPON] charge fire weapon=" .. weaponType .. " stage=" .. tostring(stage) .. " held=" .. string.format("%.2f", held))
	end

	@ExecSpace("ServerOnly")
	method Entity FindMonsterInFront(Entity map, Vector3 playerPos, integer dirX, integer dirY)
		-- 플레이어가 바라보는 전방 범위 내의 가장 가까운 생존 몬스터 검색 (보스 및 대형 몬스터 히트박스 반경 반영)
		if not isvalid(map) then return nil end
		local monsters = map:GetChildComponentsByTypeName("script.Monster", false)
		if monsters == nil then return nil end
		
		local bestMonster = nil
		local minDistanceSq = 999999.0
		
		for i, mc in ipairs(monsters) do
			if isvalid(mc) and isvalid(mc.Entity) then
				---@type Monster
				local mon = mc
				if not mon.IsDead and isvalid(mc.Entity.TransformComponent) then
					local p = mc.Entity.TransformComponent.WorldPosition
					local dx = p.x - playerPos.x
					local dy = p.y - playerPos.y
					local distSq = dx * dx + dy * dy
					
					-- 몬스터 크기(히트박스/보스)에 따른 유효 반경 가산
					local hitRadius = 0.6
					if mon.IsBoss or mon.MonsterId == "slime_king" then
						hitRadius = 2.4
					else
						local hitComp = mc.Entity:GetComponent("MOD.Core.HitComponent")
						if isvalid(hitComp) then
							hitRadius = math.max(hitComp.BoxSize.x, hitComp.BoxSize.y) * 0.5
						end
					end
					
					local maxDist = 2.0 + hitRadius
					if distSq <= maxDist * maxDist then
						local inFront = false
						local crossTol = 1.2 + hitRadius * 0.7
						local fwdLimit = 1.8 + hitRadius
						
						if math.abs(dirX) > 0 then
							-- X축(좌우)을 바라볼 때
							if (dx * dirX >= -0.5) and (math.abs(dy) <= crossTol) and (math.abs(dx) <= fwdLimit) then
								inFront = true
							end
						elseif math.abs(dirY) > 0 then
							-- Y축(상하)을 바라볼 때
							if (dy * dirY >= -0.5) and (math.abs(dx) <= crossTol) and (math.abs(dy) <= fwdLimit) then
								inFront = true
							end
						else
							-- 방향이 없는 경우 주변
							if distSq <= (1.2 + hitRadius) * (1.2 + hitRadius) then
								inFront = true
							end
						end
						
						if inFront and distSq < minDistanceSq then
							minDistanceSq = distSq
							bestMonster = mc.Entity
						end
					end
				end
			end
		end
		return bestMonster
	end

	@ExecSpace("ServerOnly")
	method Entity FindMonsterAt(Entity map, Vector3 worldPos)
		-- Returns a living monster entity whose hitbox covers or is near worldPos, or nil.
		if not isvalid(map) then return nil end
		local monsters = map:GetChildComponentsByTypeName("script.Monster", false)
		if monsters == nil then return nil end
		for i, mc in ipairs(monsters) do
			if isvalid(mc) and isvalid(mc.Entity) then
				---@type Monster
				local mon = mc
				if not mon.IsDead and isvalid(mc.Entity.TransformComponent) then
					local p = mc.Entity.TransformComponent.WorldPosition
					local dx = p.x - worldPos.x
					local dy = p.y - worldPos.y
					local hitRadius = 1.2
					if mon.IsBoss or mon.MonsterId == "slime_king" then
						hitRadius = 2.6
					else
						local hitComp = mc.Entity:GetComponent("MOD.Core.HitComponent")
						if isvalid(hitComp) then
							hitRadius = math.max(1.2, math.max(hitComp.BoxSize.x, hitComp.BoxSize.y) * 0.6)
						end
					end
					if dx * dx + dy * dy <= hitRadius * hitRadius then return mc.Entity end
				end
			end
		end
		return nil
	end

	@ExecSpace("ServerOnly")
	method void AddXP(integer amount)
		self.XP = self.XP + amount
		local leveledUp = false
		while self.XP >= self.MaxXP do
			self.Level = self.Level + 1
			self.XP = self.XP - self.MaxXP
			self.MaxXP = math.floor(self.MaxXP * 1.5)
			self.MaxStamina = self.MaxStamina + 10
			self.Stamina = self.MaxStamina
			self.GatheringSpeed = self.GatheringSpeed + 0.2
			self.SP = self.SP + self.SPPerLevelUp
			self.AP = self.AP + self.APPerLevelUp
			leveledUp = true
			
			self:ShowMineFeedback("레벨 업! Lv." .. self.Level .. " (SP +" .. self.SPPerLevelUp .. " · AP +" .. self.APPerLevelUp .. ")")
		end
		if leveledUp then
			-- 레벨 성장(최대 HP 등)을 반영하고 HP·마나를 가득 채운다.
			self:ApplyDerivedStats()
			local pcomp = self.Entity.PlayerComponent
			if pcomp ~= nil then pcomp.Hp = pcomp.MaxHp end
			self.Mana = self:GetMaxMana()
		end
		if leveledUp and _PersistenceManager then
			local playerComp = self.Entity.PlayerComponent
			if playerComp then
				_PersistenceManager:MarkPlayerDirty(playerComp.UserId)
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void UpdatePlacementPreview()
		-- description: Updates the local placement preview entity when holding placeable furniture or tiles.
		if self.Entity ~= _UserService.LocalPlayer then return end
		
		local inv = self.Entity:GetComponent("script.PlayerInventory")
		if not isvalid(inv) then return end
		
		local slots = _HttpService:JSONDecode(inv.QuickSlotsJson) or {}
		local activeItem = slots[inv.SelectedQuickSlotIndex] or ""
		-- log("[PREVIEW] Active Item: " .. activeItem .. " Slot: " .. inv.SelectedQuickSlotIndex)
		
		local isPlaceable = false
		local iconRuid = ""
		local placedTileName = ""
		local previewRuid = ""
		local previewScaleRaw = ""
		local isCropSeed = false
		
		if activeItem ~= "" then
			local baseName = inv:GetBaseItemName(activeItem)
			local ds = _DataService:GetTable("item_dataset")
			if ds ~= nil then
				local row = ds:FindRow("Name", baseName)
				if row ~= nil and row:GetItem("Category") == "build" and _BuildingManager ~= nil then
					-- 건축 부품·설계도: 2×2 칸 단위 미리보기 (조준 칸·판정은 BuildingManager 단일 소스).
					self:UpdateBuildPreview(baseName)
					return
				end
				if row ~= nil and row:GetItem("Category") == "furniture" then
					isPlaceable = true
					local cropDs = _DataService:GetTable("CropDataSet")
					isCropSeed = cropDs ~= nil and cropDs:FindRow("SeedItem", baseName) ~= nil
					iconRuid = row:GetItem("IconRUID") or ""
					placedTileName = row:GetItem("PlacedTileName") or ""
					previewRuid = row:GetItem("PreviewRUID") or ""
					previewScaleRaw = row:GetItem("PreviewScale") or ""
				end
			end
		end
		
		if isPlaceable then
			local tilemap = self.Entity.CurrentMap:GetFirstChildComponentByTypeName("RectTileMapComponent")
			if isvalid(tilemap) then
				local playerWorldPos = self.Entity.TransformComponent.WorldPosition
				local aimWorldX = playerWorldPos.x + self.LastDirectionX * 1.8
				local aimWorldY = playerWorldPos.y + self.LastDirectionY * 1.8
				local targetCell = tilemap:ToCellPosition(Vector3(aimWorldX, aimWorldY, 0))
				if targetCell == nil then return end
				-- 점유 n×n (바닥 타일·씨앗 = 1, 가구 = item_dataset.FootprintSize, 공란 2) — 설치 요청·서버 검증과 같은 단일 소스.
				local footprint = _ResourceSpawner:GetPlaceFootprint(inv:GetBaseItemName(activeItem))
				if footprint > 1 then
					local origin = _ResourceSpawner:GetAimBlockOrigin(targetCell.x, targetCell.y, self.LastDirectionX, self.LastDirectionY, footprint)
					targetCell = Vector2Int(origin.x, origin.y)
				end
				local half = footprint * 0.5
				local cellWorldPos = Vector3(targetCell.x + half, targetCell.y + half, 0)
				local previewScale = Vector3(footprint, footprint, 1.0)
				-- item_dataset.PreviewScale 이 있으면 그 값을 쓴다. 모델 Scale 과 어긋나면 미리보기만 딴 크기로 보인다.
				local previewScaleNum = tonumber(previewScaleRaw)
				if previewScaleNum ~= nil and previewScaleNum > 0 then
					previewScale = Vector3(previewScaleNum, previewScaleNum, 1.0)
				end
				
				local preview = self._T.PlacementPreviewEntity
				if not isvalid(preview) then
					preview = self.Entity.CurrentMap:GetChildByName("PlacementPreview")
					self._T.PlacementPreviewEntity = preview
				end
				
				if isvalid(preview) then
					preview.Enable = true
					preview.Visible = true
					preview.TransformComponent.Scale = previewScale
					
					local sprite = preview.SpriteRendererComponent
					if isvalid(sprite) then
						local spriteRuid = iconRuid
						if placedTileName == "" then
							if previewRuid ~= "" then
								spriteRuid = previewRuid
							end
						end
						if sprite.SpriteRUID ~= spriteRuid then
							sprite.SpriteRUID = spriteRuid
							self._T.LastActiveItem = activeItem
						end
					end
				end
				
				preview = self._T.PlacementPreviewEntity
				if isvalid(preview) then
					preview.TransformComponent.WorldPosition = cellWorldPos
					
					local canPlace = not isCropSeed or _ResourceSpawner:IsPlantableFarmCell(self.Entity.CurrentMap, targetCell.x, targetCell.y)
					-- Client-side occupancy check using collision simulator
					local simulator = _CollisionService:GetSimulator(self.Entity)
					if simulator then
						local checkCenter = Vector2(targetCell.x + half, targetCell.y + half)
						local checkSize = Vector2(footprint - 0.2, footprint - 0.2)
						if footprint <= 1 then checkSize = Vector2(0.9, 0.9) end
						local checkShape = BoxShape(checkCenter, checkSize, 0)
						-- Check all relevant collision groups
						local groups = { CollisionGroups.Default, CollisionGroups.TriggerBox, CollisionGroups.HitBox }
						local overlaps = simulator:OverlapAll(groups, checkShape)
						
						for _, comp in ipairs(overlaps) do
							if isvalid(comp) and isvalid(comp.Entity) then
								local ent = comp.Entity
								-- Block if there's any entity except self, the preview itself, or temporary item drops
									if ent ~= self.Entity and (isvalid(ent:GetComponent("script.ResourceOccupiedArea")) or isvalid(ent:GetComponent("script.PlaceableFurniture")) or ent.PlayerComponent ~= nil) then
									canPlace = false
									break
								end
							end
						end
					end
					if canPlace then
						if not self.CanPlaceOnCurrentMap then
							canPlace = false
						end
					end
					
					if canPlace then
						local currentMap = self.Entity.CurrentMap
						local layer1 = currentMap:GetChildByName("RectTileMap")
						local layer2 = currentMap:GetChildByName("RectTileMap2")
						local hasBase = false
						if isvalid(layer1) and isvalid(layer1.RectTileMapComponent) then
							if layer1.RectTileMapComponent:GetTile(targetCell) ~= nil then hasBase = true end
						end
						if isvalid(layer2) and isvalid(layer2.RectTileMapComponent) then
							if layer2.RectTileMapComponent:GetTile(targetCell) ~= nil then hasBase = true end
						end
						if not hasBase then 
							canPlace = false 
						end
					end
					
					local sprite = preview.SpriteRendererComponent
					if isvalid(sprite) then
						if canPlace then
							sprite.Color = Color(0.2, 1.0, 0.2, 0.6)
						else
							sprite.Color = Color(1.0, 0.2, 0.2, 0.6)
						end
						local mapRadius = 75
						if _ResourceSpawner then mapRadius = _ResourceSpawner.MapRadius end
						sprite.OrderInLayer = math.floor((mapRadius - targetCell.y) * 100) + 1
					end
				end
			end
		else
				-- Mining mode (tool / bare-hand / empty slot): show the mining target-cell reticle.
				self:UpdateMineReticle()
		end

	end

	@ExecSpace("ClientOnly")
	method void UpdateBuildPreview(string itemName)
		-- 건축 미리보기: 조준 칸(설계도는 집 전체 외곽)을 흰 정사각 스프라이트 틴트로 덮는다 (PlacementPreview 재사용).
		-- 색 판정 = BuildingManager:CheckPlanClient (클라 근사, 칸이 바뀌거나 0.25초마다 재계산). 최종 판정은 서버.
		local currentMap = self.Entity.CurrentMap
		if not isvalid(currentMap) then return end
		local pos = self.Entity.TransformComponent.WorldPosition
		local unit = _BuildingManager:GetPlacementAimUnit(itemName, pos.x, pos.y, self.LastDirectionX, self.LastDirectionY)
		local key = itemName .. "@" .. unit.x .. "_" .. unit.y .. "_" .. self.LastDirectionY
		local now = _UtilLogic.ElapsedSeconds
		if self._T.BuildPreviewKey ~= key or now >= (self._T.BuildPreviewNext or 0) then
			self._T.BuildPreviewKey = key
			self._T.BuildPreviewNext = now + 0.25
			local plan = _BuildingManager:BuildPlan(itemName, unit.x, unit.y)
			local bounds = _BuildingManager:GetPlanBounds(plan)
			local ok = bounds.x0 ~= nil and self.CanPlaceOnCurrentMap
			if ok then
				ok = _BuildingManager:CheckPlanClient(currentMap, plan, self.Entity) == ""
			end
			self._T.BuildPreviewOk = ok
			self._T.BuildPreviewBounds = bounds
		end
		local b = self._T.BuildPreviewBounds
		if b == nil or b.x0 == nil then return end

		local preview = self._T.PlacementPreviewEntity
		if not isvalid(preview) then
			preview = currentMap:GetChildByName("PlacementPreview")
			self._T.PlacementPreviewEntity = preview
		end
		if not isvalid(preview) then return end
		local wCells = (b.x1 - b.x0 + 1) * 2
		local hCells = (b.y1 - b.y0 + 1) * 2
		local px = math.max(1, _BuildingManager.PreviewSpritePx)
		preview.Enable = true
		preview.Visible = true
		preview.TransformComponent.WorldPosition = Vector3(b.x0 * 2 + wCells * 0.5, b.y0 * 2 + hCells * 0.5, 0)
		preview.TransformComponent.Scale = Vector3(wCells * 100 / px, hCells * 100 / px, 1.0)
		local sprite = preview.SpriteRendererComponent
		if isvalid(sprite) then
			if sprite.SpriteRUID ~= _BuildingManager.PreviewSpriteRUID then
				sprite.SpriteRUID = _BuildingManager.PreviewSpriteRUID
				self._T.LastActiveItem = itemName
			end
			if self._T.BuildPreviewOk then
				sprite.Color = Color(0.25, 1.0, 0.35, 0.35)
			else
				sprite.Color = Color(1.0, 0.25, 0.2, 0.35)
			end
			local mapRadius = 75
			if _ResourceSpawner then mapRadius = _ResourceSpawner.MapRadius end
			sprite.OrderInLayer = math.floor((mapRadius - b.y0 * 2) * 100) + 1
		end
	end

	method boolean IsAimTarget(Entity target)
		-- T67/T82 조준 판정 + [T82][AIM] 로그. F 입력 등 단발 판정용 (분산 인터랙터블도 이걸 호출).
		-- 고빈도 폴링(가이드 프로브)은 IsAimTargetCore(target, false)를 쓸 것 — 로그 스팸 방지.
		return self:IsAimTargetCore(target, true)
	end

	method boolean IsAimTargetCore(Entity target, boolean verbose)
		-- T67: 조준선 셀(playerCell+LastDirection)이 대상 footprint 안이면 true.
		-- T82: TriggerComponent가 있으면(유효 AABB)면 조준 셀 월드 1×1과 Trigger AABB 겹침으로 판정.
		-- Trigger 없으면 기존 AimFootprintW/H 경로(기본 1×1, 대형은 컴포넌트 프로퍼티 — 이름 분기 금지).
		if not isvalid(target) then return false end
		local currentMap = self.Entity.CurrentMap
		if not isvalid(currentMap) then return false end
		local tilemap = currentMap:GetFirstChildComponentByTypeName("RectTileMapComponent")
		if not isvalid(tilemap) then return false end
		local playerWorldPos = self.Entity.TransformComponent.WorldPosition
		local aimWorldX = playerWorldPos.x + self.LastDirectionX * 1.8
		local aimWorldY = playerWorldPos.y + self.LastDirectionY * 1.8
		local aimCell = tilemap:ToCellPosition(Vector3(aimWorldX, aimWorldY, 0))
		if aimCell == nil then return false end
		local targetName = target.Name
		if targetName == nil then targetName = "?" end

		-- T82: Trigger AABB ∩ aim-cell world rect
		local box = { minX = 0, maxX = 0, minY = 0, maxY = 0 }
		if self:GetColliderAABB(target, box) then
			local aimMinX = aimCell.x
			local aimMaxX = aimCell.x + 1
			local aimMinY = aimCell.y
			local aimMaxY = aimCell.y + 1
			local eps = 0.001
			local hit = aimMaxX > (box.minX - eps) and aimMinX < (box.maxX + eps)
				and aimMaxY > (box.minY - eps) and aimMinY < (box.maxY + eps)
			if verbose then
				log(string.format("[T82][AIM] target=%s mode=trigger hit=%s", targetName, tostring(hit)))
			end
			return hit
		end

		local targetCell = tilemap:ToCellPosition(target.TransformComponent.WorldPosition)
		if targetCell == nil then return false end
		local fp = self:ReadAimFootprint(target)
		local fw = fp.x
		local fh = fp.y
		local maxDx = math.floor((fw - 1) / 2)
		local maxDy = math.floor((fh - 1) / 2)
		local dx = math.abs(aimCell.x - targetCell.x)
		local dy = math.abs(aimCell.y - targetCell.y)
		local hit = dx <= maxDx and dy <= maxDy
		if verbose then
			log(string.format("[T82][AIM] target=%s mode=footprint hit=%s", targetName, tostring(hit)))
		end
		return hit
	end

	method Vector2Int ReadAimFootprint(Entity target)
		-- AimFootprintW/H → Vector2Int(w,h). mlua는 method integer, integer 다중 반환 시그니처 불가(LEA-3015).
		local typeNames = {
			"script.ResearchLab",
			"script.BlacksmithAnvil",
			"script.BuildingTable",
			"script.ConstructionSignInteract",
			"script.BulletinBoard",
			"script.Furniture_Bed",
			"script.Furnace",
			"script.Chest",
			"script.FishingSpot",
			"script.TreasureChest",
			"script.MerchantInteract",
			"script.VillagerDialog",
			"script.FishingLeaderboardInteract",
			"script.Animal",
		}
		for _, typeName in ipairs(typeNames) do
			local comp = target:GetComponent(typeName)
			if isvalid(comp) then
				local okW, w = pcall(function() return comp.AimFootprintW end)
				local okH, h = pcall(function() return comp.AimFootprintH end)
				if okW and okH and w ~= nil and h ~= nil then
					local fw = math.max(1, math.floor(tonumber(w) or 1))
					local fh = math.max(1, math.floor(tonumber(h) or 1))
					return Vector2Int(fw, fh)
				end
			end
		end
		return Vector2Int(1, 1)
	end

	@ExecSpace("ClientOnly")
	method boolean IsTerrainEditItemActive()
		-- 지금 든 아이템이 지형 편집 도구(2×2 블록 편집)인지.
		-- 🔴 서버(PlayerInventory:ServerRequestTerrainEdit)와 **같은 컬럼**(item_dataset.TerrainEditAction)을
		--    본다 — 조준점이 실제 편집 대상과 어긋나지 않으려면 판정 기준이 하나여야 한다.
		local inv = self.Entity:GetComponent("script.PlayerInventory")
		if not isvalid(inv) then return false end
		local slots = _HttpService:JSONDecode(inv.QuickSlotsJson) or {}
		local activeItem = slots[inv.SelectedQuickSlotIndex] or ""
		if activeItem == "" then return false end
		local ds = _DataService:GetTable("item_dataset")
		if ds == nil then return false end
		local row = ds:FindRow("Name", inv:GetBaseItemName(activeItem))
		if row == nil then return false end
		-- 데이터셋 리프레시 전이라 컬럼이 없을 수 있어 pcall 폴백을 둔다. 컬럼이 실제로 없으면 LEA-3011 로그는 남는다.
		local ok, v = pcall(function() return row:GetItem("TerrainEditAction") end)
		if not ok or v == nil then return false end
		return v ~= ""
	end

	@ExecSpace("ClientOnly")
	method void UpdateMineReticle()
		-- Highlights the cell the next Ctrl mine will hit (aim = LastDirection*), reusing the
		-- PlacementPreview entity. Mutually exclusive with the furniture placement preview.
		local currentMap = self.Entity.CurrentMap
		if not isvalid(currentMap) then return end
		local tilemap = currentMap:GetFirstChildComponentByTypeName("RectTileMapComponent")
		if not isvalid(tilemap) then return end
		
		local playerWorldPos = self.Entity.TransformComponent.WorldPosition
		local aimWorldX = playerWorldPos.x + self.LastDirectionX * 1.8
		local aimWorldY = playerWorldPos.y + self.LastDirectionY * 1.8
		local targetCell = tilemap:ToCellPosition(Vector3(aimWorldX, aimWorldY, 0))
		if targetCell == nil then return end

		local isTerrain = self:IsTerrainEditItemActive()
		local cellWorldPos = nil
		if isTerrain and _ResourceSpawner ~= nil then
			-- 2×2 지형 편집 도구(물삽/호미/삽/풀씨 등):
			-- 서버(PlayerInventory:ServerRequestTerrainEdit)와 동일하게 GetAimBlockOrigin을 호출하여
			-- 실제로 편집되는 2×2 블록(origin.x .. origin.x+2, origin.y .. origin.y+2)의 정중앙에 조준점을 위치시킨다.
			local origin = _ResourceSpawner:GetAimBlockOrigin(targetCell.x, targetCell.y, self.LastDirectionX, self.LastDirectionY, 2)
			cellWorldPos = Vector3(origin.x + 1.0 + self.ReticleOffsetX, origin.y + 1.0 + self.ReticleOffsetY, 0)
		else
			-- 일반 채광/벌목 도구 및 맨손 (1×1 단일 타일):
			-- 대상 타일 셀(targetCell.x .. targetCell.x+1, targetCell.y .. targetCell.y+1)의 정중앙에 조준점을 위치시킨다.
			cellWorldPos = Vector3(targetCell.x + 0.5 + self.ReticleOffsetX, targetCell.y + 0.5 + self.ReticleOffsetY, 0)
		end

		local preview = self._T.PlacementPreviewEntity
		if not isvalid(preview) then
			preview = currentMap:GetChildByName("PlacementPreview")
			self._T.PlacementPreviewEntity = preview
		end
		if not isvalid(preview) then return end
		
		preview.Enable = true
		preview.Visible = true
		preview.TransformComponent.WorldPosition = cellWorldPos
		preview.TransformComponent.Scale = Vector3(self.ReticleScale, self.ReticleScale, 1.0)
		
		local sprite = preview.SpriteRendererComponent
		if isvalid(sprite) then
			-- Swap to the reticle sprite once when entering mining mode.
			if sprite.SpriteRUID ~= self.ReticleSpriteRUID then
				sprite.SpriteRUID = self.ReticleSpriteRUID
				self._T.LastActiveItem = "__mine__"
			end
			sprite.Color = Color(1, 1, 1, 0.85)
			local mapRadius = 75
			if _ResourceSpawner then mapRadius = _ResourceSpawner.MapRadius end
			sprite.OrderInLayer = math.floor((mapRadius - targetCell.y) * 100) + 1
		end
	end

	method string ReadInteractLabel(Entity target, string fallback)
		-- 대상의 상호작용 컴포넌트에서 InteractLabel 프로퍼티를 읽는다 (ReadAimFootprint와 같은 탐색 패턴).
		-- 라벨 문구는 각 인터랙터블 스크립트의 property 기본값이 소스 — 여기서 이름 분기 금지(R3).
		local typeNames = {
			"script.RaidGate",
			"script.PortalGate",
			"script.TerritoryPortal",
			"script.ResearchLab",
			"script.BlacksmithAnvil",
			"script.BuildingTable",
			"script.ConstructionSignInteract",
			"script.BulletinBoard",
			"script.Furniture_Bed",
			"script.Furnace",
			"script.Chest",
			"script.FishingSpot",
			"script.TreasureChest",
			"script.MerchantInteract",
			"script.VillagerDialog",
			"script.FishingLeaderboardInteract",
			"script.Animal",
			"script.AnimalPen",
		}
		for _, typeName in ipairs(typeNames) do
			local comp = target:GetComponent(typeName)
			if isvalid(comp) then
				local ok, v = pcall(function() return comp.InteractLabel end)
				if ok and v ~= nil and tostring(v) ~= "" then
					return tostring(v)
				end
			end
		end
		return fallback
	end

	@ExecSpace("ClientOnly")
	method table FindAimedDistributedInteractable()
		-- InteractRequestEvent 분산 핸들러(연구소/게시판/상인/주민/낚시왕/가축)와 같은 대상 집합을
		-- 같은 게이트(IsAimTargetCore)로 탐지만 한다. 반환: { target=Entity, label=string } 또는 {}.
		local out = {}
		local currentMap = self.Entity.CurrentMap
		if not isvalid(currentMap) then return out end
		local myPos = self.Entity.TransformComponent.WorldPosition:ToVector2()
		local minDist = 9999.0
		local typeNames = {
			"script.ResearchLab",
			"script.BlacksmithAnvil",
			"script.BuildingTable",
			"script.ConstructionSignInteract",
			"script.BulletinBoard",
			"script.MerchantInteract",
			"script.VillagerDialog",
			"script.FishingLeaderboardInteract",
			"script.Animal",
		}
		for _, typeName in ipairs(typeNames) do
			local comps = currentMap:GetChildComponentsByTypeName(typeName, true)
			if comps then
				for _, comp in ipairs(comps) do
					if isvalid(comp) then
						local ent = comp.Entity
						if isvalid(ent) and self:IsAimTargetCore(ent, false) then
							local d = (myPos - ent.TransformComponent.WorldPosition:ToVector2()):Magnitude()
							if d < minDist then
								minDist = d
								out.target = ent
							end
						end
					end
				end
			end
		end
		-- 가축우리는 맨 마지막: 우리 안 가축을 조준 중이면 먹이 주기가 우선이다(AnimalPen.TryInteract 와 같은 양보 규칙).
		if not isvalid(out.target) then
			local pens = currentMap:GetChildComponentsByTypeName("script.AnimalPen", true)
			if pens then
				for _, pen in ipairs(pens) do
					if isvalid(pen) and isvalid(pen.Entity) and self:IsAimTargetCore(pen.Entity, false) then
						out.target = pen.Entity
						break
					end
				end
			end
		end
		if isvalid(out.target) then
			out.label = self:ReadInteractLabel(out.target, "상호작용")
		end
		return out
	end

	@ExecSpace("ClientOnly")
	method table ProbeInteractTarget()
		-- 가이드용 대상 탐지 — TryInteract와 **같은 우선순위**를 판정만 하고 실행하지 않는다.
		-- ⚠️ 우선순위를 한쪽만 바꾸면 가이드와 실제 F 동작이 어긋난다(규칙 18 계열 — 반드시 같이 수정).
		-- 반환: { target=Entity|nil, label=string|nil, ax/ay=물 조준 앵커(월드) }
		local out = {}
		if self.FishingState ~= "None" then return out end
		if self.IsDead or self.IsSleeping then return out end

		local target = self:FindNearbyTreasureChest()
		if isvalid(target) then
			out.target = target
			out.label = self:ReadInteractLabel(target, "보물상자 열기")
			return out
		end
		if isvalid(self.ActivePortal) then
			out.target = self.ActivePortal
			out.label = self:ReadInteractLabel(self.ActivePortal, "포탈 이용하기")
			return out
		end
		target = self:FindNearbyBed()
		if isvalid(target) then
			out.target = target
			out.label = self:ReadInteractLabel(target, "잠자기")
			return out
		end
		target = self:FindNearbyFurnace()
		if isvalid(target) then
			out.target = target
			out.label = self:ReadInteractLabel(target, "화로 사용하기")
			return out
		end
		target = self:FindNearbyChest()
		if isvalid(target) then
			out.target = target
			out.label = self:ReadInteractLabel(target, "상자 열기")
			return out
		end
		target = self:FindNearbyFishingSpot()
		if isvalid(target) then
			out.target = target
			out.label = self:ReadInteractLabel(target, "낚시하기")
			return out
		end
		-- 건축 문(타일): TryInteract 와 같은 자리(낚시터 다음·물 앞)에서 판정한다.
		local door = self:FindAimedBuildDoor()
		if door.ux ~= nil then
			out.label = door.label
			out.ax = door.ax
			out.ay = door.ay
			return out
		end
		if self:IsAimTileWaterCore(false) then
			local currentMap = self.Entity.CurrentMap
			if isvalid(currentMap) then
				local tilemap = currentMap:GetFirstChildComponentByTypeName("RectTileMapComponent")
				if isvalid(tilemap) then
					local playerCell = tilemap:ToCellPosition(self.Entity.TransformComponent.WorldPosition)
					if playerCell ~= nil then
						out.label = self.WaterAimInteractLabel
						out.ax = playerCell.x + self.LastDirectionX + 0.5
						out.ay = playerCell.y + self.LastDirectionY + 1.4
						return out
					end
				end
			end
			return out
		end
		return self:FindAimedDistributedInteractable()
	end

	@ExecSpace("ClientOnly")
	method Entity EnsureInteractGuideLabel()
		-- HUD 아래 uitext 1개를 지연 생성 — UIHUDController.InitTimeUI(TimeClock)와 같은 런타임 스폰 패턴.
		-- .ui 파일 무수정: Maker 재직렬화 원복(규칙 11) 영향권 밖.
		local hud = _EntityService:GetEntityByPath("/ui/HUDGroup")
		if not isvalid(hud) then return nil end
		local label = hud:GetChildByName("InteractGuideLabel")
		if not isvalid(label) then
			label = _SpawnService:SpawnByModelId("uitext", "InteractGuideLabel", Vector3.zero, hud)
		end
		if not isvalid(label) then return nil end
		self._T.InteractGuideLabel = label

		local sprite = label.SpriteGUIRendererComponent
		if isvalid(sprite) then
			sprite.Color = Color(0, 0, 0, 0)
			sprite.RaycastTarget = false
		end
		local transform = label.UITransformComponent
		if isvalid(transform) then
			transform.AlignmentOption = AlignmentType.CastFrom("Center")
			transform.RectSize = Vector2(420, 32)
		end
		local textComp = label.TextComponent
		if isvalid(textComp) then
			textComp.Font = FontType.Maple
			textComp.FontSize = 19
			textComp.FontColor = Color(1.0, 1.0, 1.0, 1.0)
			textComp.UseOutLine = true
			textComp.OutlineColor = Color(0.10, 0.07, 0.02, 1.0)
			textComp.OutlineWidth = 1.2
			textComp.Alignment = TextAlignmentType.MiddleCenter
		end
		return label
	end

	@ExecSpace("ClientOnly")
	method void ApplyInteractHighlight(Entity target)
		-- 대상 스프라이트의 원래 틴트를 저장하고 하이라이트 색을 적용한다.
		-- AvatarRenderer(NPC)는 Color 프로퍼티가 없어 스킵 — 라벨만으로 피드백.
		local sprite = target.SpriteRendererComponent
		if not isvalid(sprite) then return end
		local c = sprite.Color
		self._T.GuideTintTarget = target
		self._T.GuideTintSaved = Color(c.r, c.g, c.b, c.a)
		sprite.Color = self.InteractHighlightColor
	end

	@ExecSpace("ClientOnly")
	method void ClearInteractHighlight()
		-- 하이라이트 원복. 대상이 이미 파괴됐으면 복원 생략(스테일 핸들 무해).
		local target = self._T.GuideTintTarget
		if isvalid(target) then
			local sprite = target.SpriteRendererComponent
			if isvalid(sprite) and self._T.GuideTintSaved ~= nil then
				sprite.Color = self._T.GuideTintSaved
			end
		end
		self._T.GuideTintTarget = nil
		self._T.GuideTintSaved = nil
	end

	@ExecSpace("ClientOnly")
	method void UpdateInteractGuide()
		-- 조준 대상 상호작용 가이드: 탐지는 InteractGuideProbeInterval 주기, 라벨 위치 추적은 매 프레임.
		-- 진한 노랑 틴트 = 지금 F를 누르면 반응할 대상. 라벨 = "[F] {행동}" (모바일은 키 프리픽스 없음).
		if self.Entity ~= _UserService.LocalPlayer then return end

		local now = _UtilLogic.ElapsedSeconds
		local nextProbe = self._T.GuideNextProbe or 0
		if now >= nextProbe then
			self._T.GuideNextProbe = now + self.InteractGuideProbeInterval
			local res = self:ProbeInteractTarget()
			local changed = false
			if res.label ~= self._T.GuideLabelText then changed = true end
			if res.target ~= self._T.GuideTarget then changed = true end
			self._T.GuideLabelText = res.label
			self._T.GuideTarget = res.target
			self._T.GuideWaterX = res.ax
			self._T.GuideWaterY = res.ay
			if changed then
				self:ClearInteractHighlight()
				if isvalid(res.target) then
					self:ApplyInteractHighlight(res.target)
				end
				if res.label ~= nil then
					local tname = "tile"
					if isvalid(res.target) then tname = res.target.Name end
					log("[GUIDE] label=" .. res.label .. " target=" .. tname)
				end
			end
		end

		local text = self._T.GuideLabelText
		local label = self._T.InteractGuideLabel
		if text == nil then
			if isvalid(label) then label.Enable = false end
			return
		end
		if not isvalid(label) then
			label = self:EnsureInteractGuideLabel()
			if not isvalid(label) then return end
		end
		label.Enable = true

		-- 앵커: 대상 콜라이더 상단 중심(Scale 반영 AABB — 규칙 14), 없으면 위치+1. 물은 조준 셀 상단.
		local ax = nil
		local ay = nil
		local target = self._T.GuideTarget
		if isvalid(target) then
			local box = { minX = 0, maxX = 0, minY = 0, maxY = 0 }
			if self:GetColliderAABB(target, box) then
				ax = (box.minX + box.maxX) * 0.5
				ay = box.maxY + 0.35
			else
				local p = target.TransformComponent.WorldPosition
				ax = p.x
				ay = p.y + 1.0
			end
		elseif self._T.GuideWaterX ~= nil then
			ax = self._T.GuideWaterX
			ay = self._T.GuideWaterY
		end
		if ax == nil then
			label.Enable = false
			return
		end

		if self._T.GuideIsPC == nil then
			self._T.GuideIsPC = Environment:IsPCPlatform()
		end
		local full = text
		if self._T.GuideIsPC then
			full = "[F] " .. text
		end
		local textComp = label.TextComponent
		if isvalid(textComp) and textComp.Text ~= full then
			textComp.Text = full
		end

		local screenPos = _UILogic:WorldToScreenPosition(Vector2(ax, ay))
		local uiPos = _UILogic:ScreenToUIPosition(screenPos)
		local transform = label.UITransformComponent
		if isvalid(transform) then
			transform.anchoredPosition = uiPos
		end
	end

	@ExecSpace("ClientOnly")
	method boolean TryInteract()
		-- T59: F/BtnInteract 공통 상호작용 본문 (KeyDown F에서 이동 — 로직 변경 금지).
		if self.Entity ~= _UserService.LocalPlayer then return false end
		if self.FishingState ~= "None" then
			-- T64: 릴링 중 단발 F는 소비만 — 홀드는 OnUpdate 폴링(ServerSetReelHold)이 전담.
			if self.FishingState == "Reeling" then
				return true
			end
			if isvalid(self.ActiveFishingSpot) then
				self:ServerRequestFishingInteract(self.ActiveFishingSpot.Id)
			else
				self:ServerRequestTileFishingInteract()
			end
			return true
		end
		-- 보물 상자: 포탈보다 우선 (홈 포탈 옆 스폰 시 F가 워프로만 먹히던 문제)
		local nearbyTreasure = self:FindNearbyTreasureChest()
		if isvalid(nearbyTreasure) then
			local tc = nearbyTreasure:GetComponent("script.TreasureChest")
			if not isvalid(tc) then tc = nearbyTreasure:GetComponent("TreasureChest") end
			if isvalid(tc) then
				if tc.IsOpened then
					self:ShowMineFeedback("이미 열어본 상자입니다.")
				else
					tc:ServerRequestOpen()
				end
				return true
			end
		end
		if isvalid(self.ActivePortal) then
			-- Estate portals open the destination list (town / hunting grounds); fixed portals in
			-- other maps warp straight to their single target. See TryUsePortal.
			self:TryUsePortal()
			return true
		end
		local nearbyBed = self:FindNearbyBed()
		if isvalid(nearbyBed) then
			self:ServerRequestSleep(nearbyBed.Id)
			return true
		end
		local nearbyFurnace = self:FindNearbyFurnace()
		if isvalid(nearbyFurnace) then
			local popup = _EntityService:GetEntityByPath("/ui/PopupGroup/FurnacePopup")
			if isvalid(popup) then
				local controller = popup:GetComponent("script.UIFurnaceController")
				if isvalid(controller) then
					local c = controller
					if popup.Enable then
						c:Close()
					else
						c:Open(nearbyFurnace)
					end
				end
			end
			return true
		end

		local nearbyChest = self:FindNearbyChest()
		if isvalid(nearbyChest) then
			local popup = _EntityService:GetEntityByPath("/ui/PopupGroup/ChestPopup")
			if isvalid(popup) then
				local controller = popup:GetComponent("script.UIChestController")
				if isvalid(controller) then
					local c = controller
					if popup.Enable then
						c:Close()
					else
						c:Open(nearbyChest)
					end
				end
			end
			return true
		end

		local nearbyFishingSpot = self:FindNearbyFishingSpot()
		if isvalid(nearbyFishingSpot) then
			self:ServerRequestFishingInteract(nearbyFishingSpot.Id)
			return true
		end

		-- 건축 문(타일): ProbeInteractTarget 과 같은 자리에서 판정한다. 여닫기 검증은 서버(BuildingManager:ToggleDoorAt).
		local door = self:FindAimedBuildDoor()
		if door.ux ~= nil then
			self:ServerRequestToggleBuildDoor(door.cx, door.cy)
			return true
		end

		if self:IsAimTileWater() then
			self:ServerRequestTileFishingInteract()
			return true
		end
		return false
	end

	@ExecSpace("ClientOnly")
	method table FindAimedBuildDoor()
		-- 조준 셀(IsAimTargetCore 와 같은 규약: 발 + LastDirection×1.8)에 칠해진 건축 문 타일.
		-- 반환: { ux, uy, cx, cy, label, ax, ay } 또는 {} (문 상태는 복제된 타일 이름으로 판정 — BuildingManager:GetDoorAtCell).
		local out = {}
		if _BuildingManager == nil then return out end
		local currentMap = self.Entity.CurrentMap
		if not isvalid(currentMap) then return out end
		local tilemap = currentMap:GetFirstChildComponentByTypeName("RectTileMapComponent")
		if not isvalid(tilemap) then return out end
		local p = self.Entity.TransformComponent.WorldPosition
		local aimCell = tilemap:ToCellPosition(Vector3(p.x + self.LastDirectionX * 1.8, p.y + self.LastDirectionY * 1.8, 0))
		if aimCell == nil then return out end
		local door = _BuildingManager:GetDoorAtCell(currentMap, aimCell.x, aimCell.y)
		if door.ux == nil then return out end
		out.ux = door.ux
		out.uy = door.uy
		out.cx = aimCell.x
		out.cy = aimCell.y
		if door.open then
			out.label = _BuildingManager.DoorCloseLabel
		else
			out.label = _BuildingManager.DoorOpenLabel
		end
		out.ax = door.ux * 2 + 1.0
		out.ay = door.uy * 2 + 2.35
		return out
	end

	@ExecSpace("Server")
	method void ServerRequestToggleBuildDoor(integer cellX, integer cellY)
		-- 건축 문 여닫기 요청 → BuildingManager:ToggleDoorAt (거리·사람 겹침 검증은 서버).
		local playerComp = self.Entity.PlayerComponent
		if playerComp == nil or senderUserId ~= playerComp.UserId then return end
		if _BuildingManager == nil then return end
		_BuildingManager:ToggleDoorAt(self.Entity, cellX, cellY)
	end

	@ExecSpace("ClientOnly")
	method void OnInteractButton()
		-- T59: BtnInteract = TryInteract + 미처리 시 InteractRequestEvent(분산 핸들러 브리지).
		-- T64: 릴링 중 클릭(릴리즈 시 발화)은 무시 — 홀드는 SetMobileReelHold 경로.
		if self.Entity ~= _UserService.LocalPlayer then return end
		if self.FishingState == "Reeling" then
			return
		end
		if self:TryInteract() then
			return
		end
		local evt = InteractRequestEvent()
		self.Entity:SendEvent(evt)
		log("[T59] InteractRequestEvent sent (no PC-owned target)")
	end

	@ExecSpace("ClientOnly")
	method void OnScreenTouch(ScreenTouchEvent event)
		-- description: Handles screen touch and mouse clicks. Placement logic has been removed as it is now tool-driven.
		if self.Entity ~= _UserService.LocalPlayer then return end
		if event.TouchId ~= 1 then return end
		if _InputService:IsPointerOverUI() then return end
		
		-- Optionally, could add interaction logic here in the future
	end

	method void OnMapEnter(Entity enteredMap)
		-- 맵 진입 시 영지 밖 좌표 가드. 세이브 오염·포탈 타깃 오류가 벽 너머로 워프시키는 것을 차단한다.
		-- + 도착 보호: 클라가 맵을 그리는 동안(전환 커버 아래) 몬스터에게 맞지 않게 한다.
		if self:IsServer() then
			self:GuardHomeBounds()
			-- 도착 보호는 몬스터가 있는 전투 맵에서만 건다. 마을·영지는 보호할 대상이 없고, 게임 시작(슬롯 로드)처럼
			-- 전환 커버 통지(ServerNotifyWarpRevealed)가 없는 진입에서는 ArrivalProtectSeconds 내내 깜빡이기만 했다(2026-10-02 제작자 보고).
			local mapName = isvalid(enteredMap) and enteredMap.Name or ""
			local combatMap = mapName ~= "" and mapName ~= "town" and mapName ~= "map01" and string.sub(mapName, 1, 5) ~= "Home_"
			if combatMap then
				self._T.ArrivalImmuneUntil = _UtilLogic.ElapsedSeconds + self.ArrivalProtectSeconds
				self.ArrivalProtected = true
				self:ScheduleArrivalEnd(self.ArrivalProtectSeconds)
			else
				self._T.ArrivalImmuneUntil = 0
				self.ArrivalProtected = false
				if self._T.arrivalEndTimer ~= nil then
					_TimerService:ClearTimer(self._T.arrivalEndTimer)
					self._T.arrivalEndTimer = nil
				end
			end
		else
			-- 클라: 맵을 옮기면 충전 중이던 평타 충전은 버린다 (파티클 회수·상태 초기화).
			self:CancelCharge()
		end
	end

	@ExecSpace("ServerOnly")
	method void GuardHomeBounds()
		-- 영지(Home_*)에 있는데 플레이어블 박스(X/Y -27~27) 밖이면 기본 스폰으로 스냅한다.
		local currentMap = self.Entity.CurrentMap
		if not isvalid(currentMap) or string.sub(currentMap.Name, 1, 5) ~= "Home_" then return end
		if _ResourceSpawner == nil then return end
		local transform = self.Entity.TransformComponent
		if not isvalid(transform) then return end
		local pos = transform.WorldPosition
		if _ResourceSpawner:IsInsidePlayable(pos.x, pos.y) then return end
		local clamped = _ResourceSpawner:ClampHomeWorldPosition(pos.x, pos.y)
		if clamped == nil then return end
		local playerComp = self.Entity.PlayerComponent
		if isvalid(playerComp) then
			playerComp:SetWorldPosition(Vector3(clamped.x, clamped.y, pos.z))
		end
	end

	method Vector2 ResolveHomeWarpPosition(string targetMap, number x, number y)
		-- Home_* 워프 좌표가 영지 밖이면 기본 스폰으로 치환한다. 그 외 맵은 그대로.
		if targetMap == nil or string.sub(targetMap, 1, 5) ~= "Home_" then
			return Vector2(x, y)
		end
		if _ResourceSpawner == nil then
			return Vector2(x, y)
		end
		local clamped = _ResourceSpawner:ClampHomeWorldPosition(x, y)
		if clamped == nil then
			return Vector2(x, y)
		end
		return clamped
	end

	@ExecSpace("Server")
	method void ServerRequestWarp()
		local playerComp = self.Entity.PlayerComponent
		if playerComp == nil or senderUserId ~= playerComp.UserId then
			return
		end
		if not isvalid(self.ActivePortal) then return end
		
		-- Automatically unlock waypoint of current hunting ground map on returning to home/warp
		local currentMap = self.Entity.CurrentMap
		if isvalid(currentMap) then
			local ds = _DataService:GetTable("PortalDestinationDataSet")
			if ds then
				local rowCount = ds:GetRowCount()
				for i = 1, rowCount do
					local mapName = ds:GetCell(i, "MapName")
					local destId = ds:GetCell(i, "DestinationId")
					local displayName = ds:GetCell(i, "DisplayName")
					local unlockType = ds:GetCell(i, "UnlockType")
					if mapName == currentMap.Name and unlockType == "waypoint" then
						self:UnlockWaypoint(destId, displayName)
						break
					end
				end
			end
		end
		
		-- 레이드 대기실의 보스방 진입 게이트는 "정해진 맵으로 이동"이 아니라 "난이도를 고르고 인스턴스를 연다".
		-- 같은 엔티티에 PortalGate 도 붙어 있으므로(트리거·색 담당) 반드시 이 분기를 먼저 본다.
		local raidGate = self.ActivePortal:GetComponent("script.RaidGate")
		if isvalid(raidGate) and _BossRaidLogic ~= nil then
			_BossRaidLogic:OpenDifficultySelect(self.Entity, self.ActivePortal)
			return
		end

		local portalGate = self.ActivePortal:GetComponent("script.PortalGate")
		local territoryPortal = self.ActivePortal:GetComponent("script.TerritoryPortal")

		if isvalid(portalGate) then
			local targetMap = portalGate.TargetMapName
			if targetMap == "Home" then
				targetMap = "Home_" .. playerComp.UserId
			end
			
			local targetPos = portalGate.TargetPosition
			local safe = self:ResolveHomeWarpPosition(targetMap, targetPos.x, targetPos.y)
			playerComp:MoveToMapPosition(targetMap, safe)
			log("PlayerController: Warped player " .. playerComp.UserId .. " to " .. targetMap .. " at " .. tostring(safe))

			-- 보스 대기실에 **직접 도달**한 순간 그 보스를 활성화한다. 보스 컨텐츠 창은 활성화된
			-- 보스만 보내 주므로, 최초 1회는 반드시 사냥터 포탈로 걸어 들어와야 한다.
			if _BossRaidLogic ~= nil and string.sub(targetMap, 1, 10) == "raidlobby_" then
				_BossRaidLogic:NotifyLobbyArrival(self.Entity, targetMap)
			end

			-- 업적/퀘스트 진행: 포탈 이동 액션 발행
			if _ActionSignals ~= nil then
				_ActionSignals:EmitToPlayer(self.Entity, _ActionEnum.Warp, targetMap, 1)
			end
		elseif isvalid(territoryPortal) then
			local subIndex = territoryPortal.SubTerritoryIndex
			local ownerId = playerComp.UserId
			local currentMap = self.Entity.CurrentMap
			if isvalid(currentMap) then
				if string.sub(currentMap.Name, 1, 5) == "Home_" then
					ownerId = string.sub(currentMap.Name, 6)
					local p1, _ = string.find(ownerId, "_Sub_")
					if p1 then
						ownerId = string.sub(ownerId, 1, p1 - 1)
					end
				end
			end
			
			if _PersistenceManager then
				_PersistenceManager:LoadSubTerritoryMap(ownerId, subIndex)
			end
			
			local targetMap = "Home_" .. ownerId .. "_Sub_" .. subIndex
			local safe = self:ResolveHomeWarpPosition(targetMap, -3, 0)
			playerComp:MoveToMapPosition(targetMap, safe)
			log("PlayerController: Warped player " .. playerComp.UserId .. " to sub-territory " .. targetMap)
		end
	end

	@ExecSpace("ClientOnly")
	method void TryUsePortal()
		-- Portals placed on estate (Home_*) maps are universal: they always open the full,
		-- grouped destination list popup, regardless of any TargetMapName/DestinationGroup values
		-- the PortalGate may carry (C-1 design; also means old saves need no group migration).
		-- Fixed portals on non-estate maps (town/hunt) keep their immediate warp behavior.
		if not isvalid(self.ActivePortal) then return end
		local currentMap = self.Entity.CurrentMap

		local portalGate = self.ActivePortal:GetComponent("script.PortalGate")
		if isvalid(portalGate) and isvalid(currentMap) and string.sub(currentMap.Name, 1, 5) == "Home_" then
			local popup = _EntityService:GetEntityByPath("/ui/PopupGroup/WarpPopup")
			if isvalid(popup) then
				local ctrl = popup:GetComponent("script.UIWarpController")
				if isvalid(ctrl) then
					---@type UIWarpController
					local warpCtrl = ctrl
					warpCtrl:Open()
				end
			end
		else
			-- 레이드 게이트는 이동이 아니라 난이도 창을 여는 것이므로 전환 연출 없이 바로 요청한다.
			if isvalid(self.ActivePortal:GetComponent("script.RaidGate")) then
				self:ServerRequestWarp()
			else
				-- 덮기 → 이동: 커버가 실제로 그려진 뒤에 워프를 요청한다.
				-- 실제 목적지(고정 포탈의 TargetMapName — "Home" 그대로도 ResolveWarpLabel 이 인식한다)를
				-- 미리 적어 둔다. 이게 없던 2026-10-03 버전은 fromMap만으로 추정해 마을/사냥터 ↔ 내 영지
				-- 귀환 라벨이 거꾸로 붙었다(2026-10-04 수정).
				if isvalid(portalGate) then
					self.pendingWarpDestMap = portalGate.TargetMapName
				end
				self:ClientWarpWithCover(function()
					self:ServerRequestWarp()
				end)
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void ClientBeginWarpFade()
		-- (구 진입점, 호환 유지) 커버만 띄운다. 새 코드는 ClientWarpWithCover 를 쓴다.
		self:ClientWarpWithCover(nil)
	end

	@ExecSpace("ClientOnly")
	method void ClientWarpWithCover(any request)
		-- 포탈 이동 전환: HUD 커버를 먼저 그리고, 다 덮인 뒤 request()(워프 RPC)를 호출한다.
		-- HUD 컨트롤러를 못 찾으면 연출 없이 즉시 요청한다(이동이 막히지 않게).
		-- 호출부가 직전에 적어 둔 pendingWarpDestMap(실제 목적지)을 HUD 쪽 같은 이름 프로퍼티로 그대로 넘긴다.
		local destMap = self.pendingWarpDestMap
		self.pendingWarpDestMap = ""
		local hudGroup = _EntityService:GetEntityByPath("/ui/HUDGroup")
		local ctrl = nil
		if isvalid(hudGroup) then
			ctrl = hudGroup:GetComponent("script.UIHUDController")
			if not isvalid(ctrl) then
				ctrl = hudGroup:GetFirstChildComponentByTypeName("script.UIHUDController", true)
			end
		end
		if isvalid(ctrl) then
			---@type UIHUDController
			local c = ctrl
			c.pendingWarpDestMap = destMap
			c:BeginWarpTransition(request)
		elseif request ~= nil then
			request()
		end
	end

	@ExecSpace("Client")
	method void ClientCancelWarpCover()
		-- 서버가 이동 요청을 거절했을 때(보스 입장 조건 미달 등) 전환 커버를 즉시 걷는다.
		local hudGroup = _EntityService:GetEntityByPath("/ui/HUDGroup")
		if not isvalid(hudGroup) then return end
		local ctrl = hudGroup:GetComponent("script.UIHUDController")
		if not isvalid(ctrl) then
			ctrl = hudGroup:GetFirstChildComponentByTypeName("script.UIHUDController", true)
		end
		-- RPC 메서드 본문이라 사용자 스크립트 타입 주석을 달지 않는다(LEA-1118, ClientOpenRaidDifficulty 참고) — 동적 디스패치.
		if isvalid(ctrl) then
			ctrl:CancelWarpTransition()
		end
	end

	@ExecSpace("ServerOnly")
	method boolean IsArrivalProtected()
		-- 맵 진입 직후 도착 보호 중인지(보스 패턴 디버프 등 다른 스크립트가 참조).
		return _UtilLogic.ElapsedSeconds < (tonumber(self._T.ArrivalImmuneUntil) or 0)
	end

	@ExecSpace("Server")
	method void ServerNotifyWarpRevealed()
		-- 클라 화면이 다시 보이기 시작했다는 통지 → 도착 보호를 ArrivalGraceAfterReveal 뒤에 끝낸다.
		local playerComp = self.Entity.PlayerComponent
		if playerComp == nil or senderUserId ~= playerComp.UserId then return end
		local untilAt = _UtilLogic.ElapsedSeconds + self.ArrivalGraceAfterReveal
		local cur = tonumber(self._T.ArrivalImmuneUntil) or 0
		if untilAt < cur then
			self._T.ArrivalImmuneUntil = untilAt
			self:ScheduleArrivalEnd(self.ArrivalGraceAfterReveal)
		end
		log("[ARRIVAL] reveal notified — protection ends in " .. tostring(self.ArrivalGraceAfterReveal) .. "s")
	end

	@ExecSpace("ServerOnly")
	method void ScheduleArrivalEnd(number seconds)
		-- 도착 무적 표시(ArrivalProtected)를 보호 종료 시각에 맞춰 끈다. 새로 예약하면 이전 예약은 취소.
		if self._T.arrivalEndTimer ~= nil then
			_TimerService:ClearTimer(self._T.arrivalEndTimer)
			self._T.arrivalEndTimer = nil
		end
		self._T.arrivalEndTimer = _TimerService:SetTimerOnce(function()
			self._T.arrivalEndTimer = nil
			if isvalid(self.Entity) and not self:IsArrivalProtected() then
				self.ArrivalProtected = false
			end
		end, seconds + 0.05)
	end

	@ExecSpace("ServerOnly")
	method boolean UnlockWaypoint(string waypointId, string displayName)
		if not waypointId or waypointId == "" then return false end
		
		local currentList = {}
		local ok, decoded = pcall(function() return _HttpService:JSONDecode(self.UnlockedWaypointsJson) end)
		if ok and decoded then
			currentList = decoded
		end
		
		for _, id in ipairs(currentList) do
			if id == waypointId then
				return false
			end
		end
		
		table.insert(currentList, waypointId)
		self.UnlockedWaypointsJson = _HttpService:JSONEncode(currentList)
		
		local feedbackMsg = "[활성화] " .. (displayName or waypointId) .. " 웨이포인트를 활성화했습니다!"
		self:ClientShowMineFeedback(feedbackMsg)
		
		local playerComp = self.Entity.PlayerComponent
		if playerComp and _PersistenceManager then
			_PersistenceManager:MarkPlayerDirty(playerComp.UserId)
		end
		return true
	end

	method boolean IsWaypointUnlocked(string waypointId)
		if not waypointId or waypointId == "" then return true end
		-- 테스트 모드 포탈 전체 해금 (TestModeConfig.UnlockAllPortals). 서버·클라 양쪽 판정이 모두 여기를 거친다.
		if _TestModeConfig ~= nil and _TestModeConfig.EnableTestMode == true and _TestModeConfig.UnlockAllPortals == true then
			return true
		end
		
		local currentList = {}
		local ok, decoded = pcall(function() return _HttpService:JSONDecode(self.UnlockedWaypointsJson) end)
		if ok and decoded then
			currentList = decoded
		end
		
		for _, id in ipairs(currentList) do
			if id == waypointId then
				return true
			end
		end
		return false
	end

	method table DecodeRaidClears()
		-- RaidClearsJson -> { resetAt = integer, counts = { bossId = n } }.
		-- 주간 경계는 퀘스트와 같은 배관(_DateTimeLogic:GetNextCycleBaseTime(_CycleEnum.Week))을 쓴다.
		-- 경계를 지났으면 counts 를 비우고 다음 경계를 다시 잡는다(지연 리셋 — 별도 타이머 불필요).
		local state = { resetAt = 0, counts = {} }
		local ok, decoded = pcall(function() return _HttpService:JSONDecode(self.RaidClearsJson) end)
		if ok and decoded ~= nil and type(decoded) == "table" then
			state.resetAt = math.floor(tonumber(decoded.resetAt) or 0)
			if type(decoded.counts) == "table" then state.counts = decoded.counts end
		end

		local now = 0
		if _DateTimeLogic ~= nil then now = _DateTimeLogic:GetTimeElapsed() end
		if state.resetAt <= 0 or now >= state.resetAt then
			state.counts = {}
			if _DateTimeLogic ~= nil then
				state.resetAt = _DateTimeLogic:GetNextCycleBaseTime(_CycleEnum.Week, now)
			end
		end
		return state
	end

	method integer GetRaidClearCount(string bossId)
		-- 이번 주 해당 보스 처치 횟수. 주간 경계를 지났으면 0.
		if bossId == nil or bossId == "" then return 0 end
		local state = self:DecodeRaidClears()
		return math.floor(tonumber(state.counts[bossId]) or 0)
	end

	@ExecSpace("ServerOnly")
	method void AddRaidClear(string bossId)
		-- 주간 처치 카운트 +1 후 즉시 dirty 표시 (웨이포인트 해금과 동일 패턴).
		if bossId == nil or bossId == "" then return end
		local state = self:DecodeRaidClears()
		state.counts[bossId] = math.floor(tonumber(state.counts[bossId]) or 0) + 1
		self.RaidClearsJson = _HttpService:JSONEncode(state)
		local playerComp = self.Entity.PlayerComponent
		if playerComp ~= nil and _PersistenceManager ~= nil then
			_PersistenceManager:MarkPlayerDirty(playerComp.UserId)
		end
		log("[RAID] clear count " .. bossId .. " -> " .. tostring(state.counts[bossId]))
	end

	@ExecSpace("Server")
	method void ServerRequestWarpTo(string mapName)
		-- Server-validated warp to a destination chosen in the estate list portal. Only maps present
		-- in PortalDestinationDataSet are allowed (no arbitrary map jumps from a spoofed client).
		local playerComp = self.Entity.PlayerComponent
		if playerComp == nil or senderUserId ~= playerComp.UserId then return end
		-- 거절 시에는 반드시 클라 전환 커버를 걷고 이유를 알린다 — 조용히 return 하면 커버가 도착을
		-- 기다리다 걷혀 "포탈 이동이 가끔 실패"로 보인다(2026-10-06). 조준(IsAimTarget) 재검사는 두지 않는다:
		-- 목록 창은 포탈 트리거 안에서만 열리고, 창을 고르는 사이 방향을 바꾸면 조준이 빗나가 거절됐었다.
		-- ActivePortal 은 서버 트리거가 정하므로 위조 방지는 아래 검사로 충분하다(고정 포탈 ServerRequestWarp 와 동일 기준).
		local currentMap = self.Entity.CurrentMap
		local reject = ""
		if not isvalid(currentMap) or string.sub(currentMap.Name, 1, 5) ~= "Home_" then
			reject = "not_estate"
		elseif not isvalid(self.ActivePortal) or self.ActivePortal.CurrentMap ~= currentMap then
			reject = "no_active_portal"
		elseif not isvalid(self.ActivePortal:GetComponent("script.PortalGate")) then
			reject = "not_portal_gate"
		end
		if reject ~= "" then
			log_warning("PlayerController: Rejected list-warp to '" .. tostring(mapName) .. "' reason=" .. reject)
			self:ClientCancelWarpCover()
			if reject == "no_active_portal" then
				self:ClientShowWarpFeedback("포탈 가까이에서 목적지를 골라 주세요.")
			end
			return
		end

		local ds = _DataService:GetTable("PortalDestinationDataSet")
		if ds == nil then
			self:ClientCancelWarpCover()
			return
		end
		local row = ds:FindRow("MapName", mapName)
		if row == nil then
			log_warning("PlayerController: Rejected warp to unknown destination '" .. mapName .. "'.")
			self:ClientCancelWarpCover()
			return
		end

		local unlockType = row:GetItem("UnlockType") or "always"
		if unlockType == "waypoint" then
			local destId = row:GetItem("DestinationId")
			if not self:IsWaypointUnlocked(destId) then
				log_warning("PlayerController: Rejected warp to locked waypoint destination '" .. destId .. "'.")
				self:ClientCancelWarpCover()
				self:ClientShowWarpFeedback("이 사냥터 구역의 웨이포인트를 먼저 활성화해야 합니다!")
				return
			end
		end
		
		local target = mapName
		if target == "Home" then
			target = "Home_" .. playerComp.UserId
		end
		local arriveX = tonumber(row:GetItem("ArriveX")) or 0
		local arriveY = tonumber(row:GetItem("ArriveY")) or 0
		local safe = self:ResolveHomeWarpPosition(target, arriveX, arriveY)
		playerComp:MoveToMapPosition(target, safe)
		log("PlayerController: List-warped " .. playerComp.UserId .. " to " .. target)
		-- 업적/퀘스트 진행: 포탈 이동 액션 발행
		if _ActionSignals ~= nil then
			_ActionSignals:EmitToPlayer(self.Entity, _ActionEnum.Warp, target, 1)
		end
	end

	@ExecSpace("Client")
	method void ClientHideSpawnFade()
		-- Server tells this client its home is ready: fade out the black spawn cover.
		local hudGroup = _EntityService:GetEntityByPath("/ui/HUDGroup")
		if not isvalid(hudGroup) then return end
		local ctrl = hudGroup:GetComponent("script.UIHUDController")
		if not isvalid(ctrl) then
			ctrl = hudGroup:GetFirstChildComponentByTypeName("script.UIHUDController", true)
		end
		if isvalid(ctrl) then
			---@type UIHUDController
			local c = ctrl
			c:FadeOutSpawn()
		end
	end

	@ExecSpace("Client")
	method void ClientOpenMainMenu(string metaJson)
		-- 슬롯 선택 화면 오픈 (spawnFade 유지). 테스트 모드도 연다 — 메뉴가 배지를 띄우고 서버가 테스트 전용 슬롯을 준다.
		local ent = _EntityService:GetEntityByPath("/ui/MainMenuGroup/Controller")
		if not isvalid(ent) then
			log_warning("[MAINMENU] Controller missing")
			return
		end
		local c = ent:GetComponent("script.UIMainMenuController")
		if isvalid(c) then
			c:OpenWithMetaJson(metaJson or "{}")
		end
	end

	@ExecSpace("Client")
	method void ClientCloseMainMenu()
		local ent = _EntityService:GetEntityByPath("/ui/MainMenuGroup/Controller")
		if not isvalid(ent) then return end
		local c = ent:GetComponent("script.UIMainMenuController")
		if isvalid(c) then c:Close() end
	end

	@ExecSpace("Client")
	method void ClientRefreshMainMenu(string metaJson)
		local ent = _EntityService:GetEntityByPath("/ui/MainMenuGroup/Controller")
		if not isvalid(ent) then return end
		local c = ent:GetComponent("script.UIMainMenuController")
		if isvalid(c) then c:ApplyMetaJson(metaJson or "{}") end

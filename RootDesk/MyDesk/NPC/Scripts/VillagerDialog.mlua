@Component
script VillagerDialog extends Component
	-- F「대화하기」→ 메이플식 하단 대화창 (UIDialogController).
	-- 자동 혼잣말만 ChatBalloon 유지.

	property string NpcId = "elder"
	property string DisplayName = ""
	property number InteractRange = 3.0
	property integer AimFootprintW = 1
	property integer AimFootprintH = 1
	property string InteractLabel = "대화하기"
	property number BalloonDuration = 4.0
	property number AutoTalkInterval = 15.0
	property number AutoTalkRange = 6.0
	property number AutoTalkAccum = 0
	property any keyHandler = nil
	property any interactRequestHandler = nil
	property any balloonClearTimer = nil

	method void OnBeginPlay()
		-- 클라: F/모바일 상호작용. 서버: 자동 혼잣말.
		if self:IsClient() then
			self.keyHandler = _InputService:ConnectEvent(KeyDownEvent, self.OnKeyDown)
			local lp = _UserService.LocalPlayer
			if isvalid(lp) then
				self.interactRequestHandler = lp:ConnectEvent(InteractRequestEvent, function()
					self:TryInteract()
				end)
			else
				log_warning("[DIALOG] LocalPlayer nil — InteractRequestEvent not connected")
			end
			log("[DIALOG] client ready npc=" .. tostring(self.NpcId))
		end
		if self:IsServer() then
			self.AutoTalkAccum = 0
			log("[DIALOG] server ready npc=" .. tostring(self.NpcId))
		end
	end

	method void OnEndPlay()
		-- 핸들러·타이머 정리.
		if self:IsClient() then
			if self.keyHandler ~= nil then
				_InputService:DisconnectEvent(KeyDownEvent, self.keyHandler)
				self.keyHandler = nil
			end
			if self.interactRequestHandler ~= nil then
				local lp = _UserService.LocalPlayer
				if isvalid(lp) then
					lp:DisconnectEvent(InteractRequestEvent, self.interactRequestHandler)
				end
				self.interactRequestHandler = nil
			end
		end
		if self.balloonClearTimer ~= nil then
			_TimerService:ClearTimer(self.balloonClearTimer)
			self.balloonClearTimer = nil
		end
	end

	method void OnUpdate(number delta)
		-- 서버: 근처 플레이어 있을 때만 주기 자동 혼잣말(말풍선).
		if not self:IsServer() then return end
		local interval = self.AutoTalkInterval
		if interval <= 0 then return end
		self.AutoTalkAccum = self.AutoTalkAccum + delta
		if self.AutoTalkAccum < interval then return end
		self.AutoTalkAccum = 0
		if not self:HasNearbyPlayer(self.AutoTalkRange) then return end
		local text = self:PickAmbientText()
		if text ~= "" then
			self:ShowBalloon(text, "auto")
		end
	end

	@ExecSpace("ClientOnly")
	method void OnKeyDown(KeyDownEvent event)
		-- F 키 → TryInteract.
		if event.key ~= KeyboardKey.F then return end
		self:TryInteract()
	end

	@ExecSpace("ClientOnly")
	method void TryInteract()
		-- 조준 게이트 후 대화창 오픈.
		local localPlayer = _UserService.LocalPlayer
		if not isvalid(localPlayer) then return end
		local pc = localPlayer:GetComponent("script.PlayerController")
		if not isvalid(pc) then return end
		if not pc:IsAimTarget(self.Entity) then return end

		local dialog = self:GetDialogController()
		if dialog ~= nil and dialog:IsOpen() then
			return
		end

		local speaker = self:GetSpeakerName()
		local offer = self:FindOfferQuest(localPlayer)
		local questId = 0
		local offerPages = nil
		if offer ~= nil then
			questId = math.floor(tonumber(offer.id) or 0)
			offerPages = offer.pages
		end
		if questId > 0 and offerPages ~= nil and #offerPages > 0 then
			if dialog ~= nil then
				dialog:OpenQuestOffer(speaker, offerPages, questId)
				log("[DIALOG] offer npc=" .. tostring(self.NpcId) .. " quest=" .. tostring(questId))
				return
			end
		end

		local talkPages = self:BuildTalkPages()
		if #talkPages == 0 then
			log_warning("[DIALOG] no talk pages npc=" .. tostring(self.NpcId))
			return
		end
		if dialog ~= nil then
			dialog:OpenTalk(speaker, talkPages)
			log("[DIALOG] talk npc=" .. tostring(self.NpcId) .. " pages=" .. tostring(#talkPages))
		end
	end

	@ExecSpace("ClientOnly")
	method any GetDialogController()
		-- DialogGroup 컨트롤러 조회. (커스텀 script 반환 타입 금지 → any)
		local ent = _EntityService:GetEntityByPath("/ui/DialogGroup/Controller")
		if not isvalid(ent) then
			log_warning("[DIALOG] DialogGroup/Controller missing")
			return nil
		end
		local comp = ent:GetComponent("script.UIDialogController")
		if not isvalid(comp) then
			log_warning("[DIALOG] UIDialogController missing")
			return nil
		end
		return comp
	end

	method string GetSpeakerName()
		-- DisplayName 우선, 없으면 NpcId 매핑.
		if self.DisplayName ~= nil and self.DisplayName ~= "" then
			return self.DisplayName
		end
		local id = self.NpcId or ""
		if id == "elder" then return "촌장" end
		if id == "fisher" then return "낚시꾼" end
		if id == "resident_a" then return "미나" end
		if id == "resident_b" then return "유나" end
		if id == "resident_c" then return "다은" end
		if id == "resident_d" then return "토리" end
		return id
	end

	@ExecSpace("ClientOnly")
	method any FindOfferQuest(Entity player)
		-- GiverNpcId 일치 + 수락 가능 퀘스트 1건.
		-- 반환: { id=integer, pages=table } 또는 nil
		-- ⚠ mlua는 method integer, table 다중 반환 시그니처 불가(LEA-3015).
		if not isvalid(player) or player.PlayerQuest == nil then return nil end
		local ds = _DataService:GetTable("QuestDataSet")
		if ds == nil then return nil end
		local rows = ds:GetAllRow()
		if rows == nil then return nil end
		local npcId = self.NpcId or ""
		local elapsed = 0
		if _DateTimeLogic ~= nil then
			elapsed = _DateTimeLogic:GetTimeElapsed()
		end

		local bestId = 0
		local bestPriority = -999999
		for _, row in ipairs(rows) do
			local disable = ""
			local okD, rawD = pcall(function() return row:GetItem("Disable") end)
			if okD and rawD ~= nil then disable = tostring(rawD) end
			if disable ~= "" then continue end

			local giver = ""
			local okG, rawG = pcall(function() return row:GetItem("GiverNpcId") end)
			if okG and rawG ~= nil then giver = tostring(rawG) end
			if giver ~= npcId then continue end

			local auto = ""
			local okA, rawA = pcall(function() return row:GetItem("AutoAccept") end)
			if okA and rawA ~= nil then auto = tostring(rawA) end
			if auto ~= "" then continue end

			local id = math.floor(tonumber(row:GetItem("Id")) or 0)
			if id <= 0 then continue end
			local data = _QuestDataSetLogic ~= nil and _QuestDataSetLogic:GetData(id) or nil
			if data == nil then continue end
			local userData = player.PlayerQuest:GetOrCreateUserData(id)
			if not userData:IsAcceptable(player, data, elapsed) then continue end

			local pri = math.floor(tonumber(row:GetItem("Priority")) or 0)
			if pri > bestPriority then
				bestPriority = pri
				bestId = id
			end
		end

		if bestId <= 0 then return nil end
		local pages = self:LoadStoryPages(bestId, "offer")
		if pages == nil or #pages == 0 then
			local data = _QuestDataSetLogic:GetData(bestId)
			local desc = data ~= nil and tostring(data.Desc or "") or ""
			local name = data ~= nil and tostring(data.Name or "") or ""
			pages = {}
			if name ~= "" then table.insert(pages, "【" .. name .. "】") end
			if desc ~= "" then table.insert(pages, desc) end
			table.insert(pages, "이 부탁을 맡아 주겠나?")
		end
		return { id = bestId, pages = pages }
	end

	method table LoadStoryPages(integer questId, string phase)
		-- StoryDialogDataSet에서 Seq 순 페이지.
		local ds = _DataService:GetTable("StoryDialogDataSet")
		if ds == nil then return {} end
		local rows = ds:GetAllRow()
		if rows == nil then return {} end
		local list = {}
		for _, row in ipairs(rows) do
			local qid = math.floor(tonumber(row:GetItem("QuestId")) or 0)
			if qid ~= questId then continue end
			local ph = tostring(row:GetItem("Phase") or "")
			if ph ~= phase then continue end
			local seq = math.floor(tonumber(row:GetItem("Seq")) or 0)
			local text = tostring(row:GetItem("Text") or "")
			if text ~= "" then
				table.insert(list, { seq = seq, text = text })
			end
		end
		table.sort(list, function(a, b) return a.seq < b.seq end)
		local pages = {}
		for _, e in ipairs(list) do
			table.insert(pages, e.text)
		end
		return pages
	end

	@ExecSpace("ClientOnly")
	method table BuildTalkPages()
		-- 앰비언트 한 줄 → 단페이지. (스토리 progress/complete는 후속)
		local pages = {}
		local progressPages = self:TryProgressOrCompletePages()
		if progressPages ~= nil and #progressPages > 0 then
			return progressPages
		end
		local text = self:PickAmbientText()
		if text ~= "" then
			table.insert(pages, text)
		end
		return pages
	end

	@ExecSpace("ClientOnly")
	method table TryProgressOrCompletePages()
		-- 진행 중/완료 보고 대사 (TurnInNpcId).
		local lp = _UserService.LocalPlayer
		if not isvalid(lp) or lp.PlayerQuest == nil then return nil end
		local ds = _DataService:GetTable("QuestDataSet")
		if ds == nil then return nil end
		local rows = ds:GetAllRow()
		if rows == nil then return nil end
		local npcId = self.NpcId or ""

		for _, row in ipairs(rows) do
			local turnIn = ""
			local okT, rawT = pcall(function() return row:GetItem("TurnInNpcId") end)
			if okT and rawT ~= nil then turnIn = tostring(rawT) end
			if turnIn == "" then
				local okG, rawG = pcall(function() return row:GetItem("GiverNpcId") end)
				if okG and rawG ~= nil then turnIn = tostring(rawG) end
			end
			if turnIn ~= npcId then continue end
			local id = math.floor(tonumber(row:GetItem("Id")) or 0)
			if id <= 0 then continue end
			local userData = lp.PlayerQuest.UserDataTable[id]
			if userData == nil then continue end
			local data = _QuestDataSetLogic ~= nil and _QuestDataSetLogic:GetData(id) or nil
			if data == nil then continue end

			if userData.State == _QuestStateEnum.InProgress and userData:IsCompletable(data) then
				local pages = self:LoadStoryPages(id, "complete")
				if #pages == 0 then
					pages = { "수고했네. 보상을 받지.", tostring(data.Name or "") .. " 완료!" }
				end
				lp.PlayerQuest:RequestCompleteQuests({ id })
				return pages
			end
			if userData.State == _QuestStateEnum.InProgress then
				local pages = self:LoadStoryPages(id, "progress")
				if #pages == 0 then
					pages = { tostring(data.ProgressingDesc or "아직 끝나지 않은 것 같군.") }
				end
				return pages
			end
		end
		return nil
	end

	method boolean HasNearbyPlayer(number range)
		-- 맵 내 플레이어가 range 이내인지.
		local map = self.Entity.CurrentMap
		if not isvalid(map) or map.MapComponent == nil then return false end
		local players = _UserService:GetUsersByMapComponent(map.MapComponent)
		if players == nil then return false end
		for _, player in pairs(players) do
			if isvalid(player) then
				local d = self:GetDistanceToPlayer(player)
				if d <= range then return true end
			end
		end
		return false
	end

	method number GetDistanceToPlayer(Entity player)
		-- 월드 거리.
		if not isvalid(player) then return 9999 end
		local myPos = self.Entity.TransformComponent.WorldPosition
		local playerPos = player.TransformComponent.WorldPosition
		return Vector2.Distance(Vector2(myPos.x, myPos.y), Vector2(playerPos.x, playerPos.y))
	end

	method string GetTimeBand()
		-- day|night.
		local night = false
		if _PersistenceManager ~= nil then
			local ok, v = pcall(function() return _PersistenceManager:IsNight() end)
			if ok and v == true then night = true end
		end
		if night then return "night" end
		return "day"
	end

	method string GetWeatherId()
		-- WeatherManager.
		if _WeatherManager == nil then return "clear" end
		local ok, wid = pcall(function() return _WeatherManager:GetCurrentWeatherId() end)
		if ok and wid ~= nil and tostring(wid) ~= "" then return tostring(wid) end
		local ok2, syncId = pcall(function() return _WeatherManager.CurrentWeatherId end)
		if ok2 and syncId ~= nil and tostring(syncId) ~= "" then return tostring(syncId) end
		return "clear"
	end

	method string PickAmbientText()
		-- DialogDataSet Weight 추첨.
		local ds = _DataService:GetTable("DialogDataSet")
		if ds == nil then return "" end
		local npcId = self.NpcId or ""
		local band = self:GetTimeBand()
		local weather = self:GetWeatherId()
		local rows = ds:GetAllRow()
		if rows == nil then return "" end

		local pool = {}
		local totalW = 0
		for _, row in ipairs(rows) do
			local id = row:GetItem("NpcId") or ""
			if id == npcId then
				local tb = row:GetItem("TimeBand") or "any"
				if tb == "" then tb = "any" end
				local okWeather = true
				local wId = ""
				local okW, rawW = pcall(function() return row:GetItem("WeatherId") end)
				if okW and rawW ~= nil then wId = tostring(rawW) end
				if wId ~= "" and wId ~= weather then okWeather = false end
				local timeOk = (tb == "any" or tb == band)
				if timeOk and okWeather then
					local w = tonumber(row:GetItem("Weight")) or 0
					if w > 0 then
						local text = row:GetItem("Text") or ""
						if text ~= "" then
							table.insert(pool, { text = tostring(text), w = w })
							totalW = totalW + w
						end
					end
				end
			end
		end
		if totalW <= 0 or #pool == 0 then return "" end
		local rng = _UtilLogic:RandomDouble() * totalW
		local acc = 0
		local chosen = pool[1].text
		for _, e in ipairs(pool) do
			acc = acc + e.w
			if rng <= acc then
				chosen = e.text
				break
			end
		end
		return chosen
	end

	method void ShowBalloon(string text, string reason)
		-- 자동 혼잣말 말풍선 (F 대화와 분리).
		if not self:IsServer() then return end
		local balloon = self.Entity.ChatBalloonComponent
		if not isvalid(balloon) then return end
		local dur = self.BalloonDuration
		if dur < 1 then dur = 3 end
		if dur > 5 then dur = 5 end
		balloon.Enable = true
		balloon.ChatModeEnabled = true
		balloon.HideDuration = 0.05
		balloon.AutoShowEnabled = true
		if balloon.Offset < 0.5 then balloon.Offset = 1.2 end
		balloon.ShowDuration = dur
		balloon.Message = ""
		balloon.Message = text
		self:ClientShowBalloon(text, dur)
		if self.balloonClearTimer ~= nil then
			_TimerService:ClearTimer(self.balloonClearTimer)
			self.balloonClearTimer = nil
		end
		self.balloonClearTimer = _TimerService:SetTimerOnce(function()
			if isvalid(self.Entity) and isvalid(self.Entity.ChatBalloonComponent) then
				local b = self.Entity.ChatBalloonComponent
				b.Message = ""
				b.AutoShowEnabled = false
			end
			self:ClientClearBalloon()
			self.balloonClearTimer = nil
		end, dur + 0.15)
	end

	@ExecSpace("Multicast")
	method void ClientShowBalloon(string text, number dur)
		-- 클라 말풍선 재적용.
		local balloon = self.Entity.ChatBalloonComponent
		if not isvalid(balloon) then return end
		balloon.Enable = true
		balloon.ChatModeEnabled = true
		balloon.HideDuration = 0.05
		balloon.AutoShowEnabled = true
		if balloon.Offset < 0.5 then balloon.Offset = 1.2 end
		balloon.ShowDuration = dur
		balloon.Message = ""
		balloon.Message = text
	end

	@ExecSpace("Multicast")
	method void ClientClearBalloon()
		-- 말풍선 종료.
		local balloon = self.Entity.ChatBalloonComponent
		if not isvalid(balloon) then return end
		balloon.Message = ""
		balloon.AutoShowEnabled = false
	end

end

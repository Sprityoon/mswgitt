@Logic
script FriendManager extends Logic

	-- 게임 내 친구 목록 (2026-10-24). MSW 에 친구 API 가 없어 직접 둔다.
	-- 친구는 캐릭터(슬롯) 단위 — PlayerInventory.FriendsData 에 "캐릭터Id|UserId|이름;…" 로 저장(PersistenceManager 가 영속화).
	-- 신청 → 상대 수락 시 양쪽 목록에 동시에 추가한다(둘 다 접속 중일 때만 성립). 삭제는 상대가 접속 중이면 양쪽, 아니면 내 쪽만 지운다.
	-- 친구 창의 [초대]는 EstateInviteManager.SendInviteFrom 으로 넘긴다 — 수락하면 초대한 사람과 함께 그 영지로 간다.
	-- 같은 월드 인스턴스(채널)에 있는 유저만 접속 중으로 보인다(_UserService 범위 — 다른 채널 친구는 "접속 안 함").

	property integer MaxFriends = 50
	property number RequestExpireSeconds = 300.0
	property number RequestCooldownSeconds = 3.0

	-- 신청받은 userId -> { [보낸 userId] = { cid, name, expireAt } }
	@HideFromInspector property table Requests = {}
	-- 신청을 보낸 userId -> 마지막 전송 시각
	@HideFromInspector property table LastRequestTimes = {}

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- 서버 측 신청 상태 초기화.
		self.Requests = {}
		self.LastRequestTimes = {}
		log("[FRIEND] FriendManager ready")
	end

	@ExecSpace("ServerOnly")
	method any GetInv(string userId)
		-- 접속 중인 유저의 PlayerInventory (없으면 nil).
		local ent = _UserService:GetUserEntityByUserId(userId)
		if not isvalid(ent) then return nil end
		local inv = ent:GetComponent("script.PlayerInventory")
		if not isvalid(inv) then return nil end
		return inv
	end

	@ExecSpace("ServerOnly")
	method string CharacterIdOf(string userId)
		-- 현재 접속 캐릭터 Id ("<uid>_s<slot>"). 슬롯 선택 전이면 "".
		if _PersistenceManager == nil or _PersistenceManager:GetActiveSlot(userId) < 1 then return "" end
		return _PersistenceManager:GetCharacterId(userId)
	end

	@ExecSpace("ServerOnly")
	method string NameOf(string userId)
		-- 표시 이름 (구분자 문자는 저장 형식을 깨므로 지운다).
		local name = "모험가"
		if _EstateInviteManager ~= nil then name = _EstateInviteManager:ResolveDisplayName(userId) end
		local clean, _ = string.gsub(name or "", "[|;\t\n]", "")
		if clean == "" then clean = "모험가" end
		return clean
	end

	@ExecSpace("ServerOnly")
	method table ParseFriends(string data)
		-- "cid|uid|name;…" → { {cid, uid, name}, … }
		local list = {}
		for entry in string.gmatch(data or "", "[^;]+") do
			for cid, uid, name in string.gmatch(entry, "([^|]*)|([^|]*)|(.*)") do
				if cid ~= "" then list[#list + 1] = { cid = cid, uid = uid, name = name } end
			end
		end
		return list
	end

	@ExecSpace("ServerOnly")
	method string EncodeFriends(table list)
		-- ParseFriends 의 역.
		local parts = {}
		for _, f in ipairs(list) do
			parts[#parts + 1] = f.cid .. "|" .. f.uid .. "|" .. f.name
		end
		return table.concat(parts, ";")
	end

	@ExecSpace("ServerOnly")
	method integer FindFriend(table list, string cid)
		-- 목록에서 캐릭터 Id 위치 (없으면 0).
		for i, f in ipairs(list) do
			if f.cid == cid then return i end
		end
		return 0
	end

	@ExecSpace("ServerOnly")
	method void SaveFriends(string userId, any inv, table list)
		-- 목록을 저장 문자열로 되돌리고 저장 대상으로 표시한다.
		inv.FriendsData = self:EncodeFriends(list)
		if _PersistenceManager ~= nil then _PersistenceManager:MarkPlayerDirty(userId) end
	end

	@ExecSpace("ServerOnly")
	method void Notify(string userId, string message)
		-- 시스템 채팅으로 알린다 (영지 초대와 같은 통보 경로).
		if _EstateInviteManager ~= nil then _EstateInviteManager:Notify(userId, message) end
	end

	@ExecSpace("ServerOnly")
	method boolean IsFriendOnline(table f)
		-- 친구 캐릭터가 지금 그 캐릭터로 접속해 있는가.
		if not isvalid(_UserService:GetUserEntityByUserId(f.uid)) then return false end
		return self:CharacterIdOf(f.uid) == f.cid
	end

	@ExecSpace("ServerOnly")
	method string DescribeLocation(string userId)
		-- 친구 창에 보여 줄 현재 위치 한 마디.
		local ent = _UserService:GetUserEntityByUserId(userId)
		if not isvalid(ent) or not isvalid(ent.CurrentMap) then return "접속 중" end
		local name = ent.CurrentMap.Name or ""
		if string.sub(name, 1, 5) == "Home_" then
			if _PersistenceManager ~= nil and _PersistenceManager:GetHomeOwnerId(name) == userId then return "자기 영지" end
			return "영지 방문 중"
		end
		if string.sub(name, 1, 4) == "town" then return "마을" end
		if string.sub(name, 1, 4) == "raid" then return "보스전" end
		if string.sub(name, 1, 4) == "hunt" then return "사냥터" end
		return "접속 중"
	end

	@ExecSpace("Server")
	method void ServerSendRequest(string toUserId)
		-- 플레이어 클릭 메뉴의 [친구 신청].
		local fromUserId = senderUserId
		if fromUserId == nil or fromUserId == "" or toUserId == nil or toUserId == "" then return end
		if toUserId == fromUserId then return end
		local now = _UtilLogic.ServerElapsedSeconds or 0
		if (now - (self.LastRequestTimes[fromUserId] or -999)) < self.RequestCooldownSeconds then
			self:Notify(fromUserId, "친구 신청을 너무 빠르게 보낼 수 없습니다.")
			return
		end
		local myInv = self:GetInv(fromUserId)
		local targetInv = self:GetInv(toUserId)
		local myCid = self:CharacterIdOf(fromUserId)
		local targetCid = self:CharacterIdOf(toUserId)
		if myInv == nil or targetInv == nil or myCid == "" or targetCid == "" then
			self:Notify(fromUserId, "상대를 찾을 수 없습니다.")
			return
		end
		local mine = self:ParseFriends(myInv.FriendsData)
		local targetName = self:NameOf(toUserId)
		if self:FindFriend(mine, targetCid) > 0 then
			self:Notify(fromUserId, targetName .. "님은 이미 친구입니다.")
			return
		end
		if #mine >= self.MaxFriends then
			self:Notify(fromUserId, "친구는 최대 " .. tostring(self.MaxFriends) .. "명까지입니다.")
			return
		end
		-- 상대가 이미 나에게 신청해 둔 상태면 곧바로 성립시킨다.
		local mineIncoming = self.Requests[fromUserId]
		if mineIncoming ~= nil and mineIncoming[toUserId] ~= nil then
			self:Accept(fromUserId, toUserId)
			return
		end
		self.LastRequestTimes[fromUserId] = now
		if self.Requests[toUserId] == nil then self.Requests[toUserId] = {} end
		self.Requests[toUserId][fromUserId] = { cid = myCid, name = self:NameOf(fromUserId), expireAt = now + self.RequestExpireSeconds }
		self:Notify(fromUserId, targetName .. "님에게 친구 신청을 보냈습니다.")
		self:Notify(toUserId, self:NameOf(fromUserId) .. "님이 친구 신청을 보냈습니다. 친구 창(L)에서 수락할 수 있어요.")
		self:PushList(toUserId)
		log("[VRF][FRIEND] request " .. fromUserId .. " -> " .. toUserId)
	end

	@ExecSpace("Server")
	method void ServerRespondRequest(string fromUserId, boolean accept)
		-- 친구 창의 신청 줄 [수락]/[거절].
		local myUserId = senderUserId
		if myUserId == nil or myUserId == "" then return end
		local incoming = self.Requests[myUserId]
		local record = nil
		if incoming ~= nil then record = incoming[fromUserId] end
		if record == nil then
			self:PushList(myUserId)
			return
		end
		if not accept then
			incoming[fromUserId] = nil
			self:Notify(fromUserId, self:NameOf(myUserId) .. "님이 친구 신청을 거절했습니다.")
			self:PushList(myUserId)
			return
		end
		self:Accept(myUserId, fromUserId)
	end

	@ExecSpace("ServerOnly")
	method void Accept(string myUserId, string fromUserId)
		-- 두 사람을 서로의 목록에 넣는다. 신청자가 나갔거나 캐릭터가 바뀌었으면 성립하지 않는다.
		local incoming = self.Requests[myUserId]
		local record = nil
		if incoming ~= nil then
			record = incoming[fromUserId]
			incoming[fromUserId] = nil
		end
		local reverse = self.Requests[fromUserId]
		if reverse ~= nil then reverse[myUserId] = nil end

		local now = _UtilLogic.ServerElapsedSeconds or 0
		local myInv = self:GetInv(myUserId)
		local fromInv = self:GetInv(fromUserId)
		local myCid = self:CharacterIdOf(myUserId)
		local fromCid = self:CharacterIdOf(fromUserId)
		if record == nil or now > record.expireAt or myInv == nil or fromInv == nil or myCid == "" or fromCid ~= record.cid then
			self:Notify(myUserId, "신청이 만료되었거나 상대가 접속 중이 아닙니다.")
			self:PushList(myUserId)
			return
		end
		local mine = self:ParseFriends(myInv.FriendsData)
		local theirs = self:ParseFriends(fromInv.FriendsData)
		if (#mine >= self.MaxFriends and self:FindFriend(mine, fromCid) == 0) or (#theirs >= self.MaxFriends and self:FindFriend(theirs, myCid) == 0) then
			self:Notify(myUserId, "친구 목록이 가득 찼습니다 (최대 " .. tostring(self.MaxFriends) .. "명).")
			self:PushList(myUserId)
			return
		end
		local myName = self:NameOf(myUserId)
		local fromName = self:NameOf(fromUserId)
		if self:FindFriend(mine, fromCid) == 0 then mine[#mine + 1] = { cid = fromCid, uid = fromUserId, name = fromName } end
		if self:FindFriend(theirs, myCid) == 0 then theirs[#theirs + 1] = { cid = myCid, uid = myUserId, name = myName } end
		self:SaveFriends(myUserId, myInv, mine)
		self:SaveFriends(fromUserId, fromInv, theirs)
		self:Notify(myUserId, fromName .. "님과 친구가 되었습니다.")
		self:Notify(fromUserId, myName .. "님과 친구가 되었습니다.")
		self:PushList(myUserId)
		self:PushList(fromUserId)
		log("[VRF][FRIEND] accepted " .. myCid .. " <-> " .. fromCid)
	end

	@ExecSpace("Server")
	method void ServerRemoveFriend(string friendCid)
		-- 친구 창의 [삭제]. 상대가 그 캐릭터로 접속 중이면 상대 목록에서도 지운다.
		local myUserId = senderUserId
		if myUserId == nil or myUserId == "" then return end
		local myInv = self:GetInv(myUserId)
		if myInv == nil then return end
		local mine = self:ParseFriends(myInv.FriendsData)
		local idx = self:FindFriend(mine, friendCid)
		if idx == 0 then
			self:PushList(myUserId)
			return
		end
		local f = mine[idx]
		table.remove(mine, idx)
		self:SaveFriends(myUserId, myInv, mine)
		if self:IsFriendOnline(f) then
			local theirInv = self:GetInv(f.uid)
			if theirInv ~= nil then
				local theirs = self:ParseFriends(theirInv.FriendsData)
				local j = self:FindFriend(theirs, self:CharacterIdOf(myUserId))
				if j > 0 then
					table.remove(theirs, j)
					self:SaveFriends(f.uid, theirInv, theirs)
					self:PushList(f.uid)
				end
			end
		end
		self:Notify(myUserId, f.name .. "님을 친구 목록에서 삭제했습니다.")
		self:PushList(myUserId)
	end

	@ExecSpace("Server")
	method void ServerInviteFriend(string friendCid)
		-- 친구 창의 [초대] — 어디서든 보낼 수 있다(수락하면 함께 내 영지로 이동).
		local myUserId = senderUserId
		if myUserId == nil or myUserId == "" then return end
		local myInv = self:GetInv(myUserId)
		if myInv == nil then return end
		local mine = self:ParseFriends(myInv.FriendsData)
		local idx = self:FindFriend(mine, friendCid)
		if idx == 0 then return end
		local f = mine[idx]
		if not self:IsFriendOnline(f) then
			self:Notify(myUserId, f.name .. "님은 지금 접속 중이 아닙니다.")
			return
		end
		if _EstateInviteManager ~= nil then _EstateInviteManager:SendInviteFrom(myUserId, f.uid) end
	end

	@ExecSpace("Server")
	method void ServerRequestList()
		-- 친구 창을 열거나 열려 있는 동안 주기적으로 부른다.
		local myUserId = senderUserId
		if myUserId == nil or myUserId == "" then return end
		self:PushList(myUserId)
	end

	@ExecSpace("ServerOnly")
	method void PushList(string userId)
		-- 신청 + 친구 목록을 한 줄씩 묶어 그 유저 클라이언트에 보낸다.
		-- 줄 = "종류\tId\t이름\t상태\t접속(1/0)" — 종류 R=받은 신청(Id=보낸 UserId), F=친구(Id=캐릭터Id).
		local inv = self:GetInv(userId)
		if inv == nil then return end
		local now = _UtilLogic.ServerElapsedSeconds or 0
		local lines = {}
		local incoming = self.Requests[userId]
		if incoming ~= nil then
			for fromUserId, r in pairs(incoming) do
				if now > r.expireAt or self:CharacterIdOf(fromUserId) ~= r.cid then
					incoming[fromUserId] = nil
				else
					lines[#lines + 1] = "R\t" .. fromUserId .. "\t" .. r.name .. "\t친구 신청\t1"
				end
			end
		end
		local mine = self:ParseFriends(inv.FriendsData)
		local renamed = false
		local onlineLines = {}
		local offlineLines = {}
		for _, f in ipairs(mine) do
			if self:IsFriendOnline(f) then
				local cur = self:NameOf(f.uid)
				if cur ~= f.name then
					f.name = cur
					renamed = true
				end
				onlineLines[#onlineLines + 1] = "F\t" .. f.cid .. "\t" .. f.name .. "\t" .. self:DescribeLocation(f.uid) .. "\t1"
			else
				offlineLines[#offlineLines + 1] = "F\t" .. f.cid .. "\t" .. f.name .. "\t접속 안 함\t0"
			end
		end
		if renamed then self:SaveFriends(userId, inv, mine) end
		for _, l in ipairs(onlineLines) do lines[#lines + 1] = l end
		for _, l in ipairs(offlineLines) do lines[#lines + 1] = l end
		self:ClientApplyList(table.concat(lines, "\n"), #mine, self.MaxFriends, userId)
	end

	@ExecSpace("Client")
	method void ClientApplyList(string payload, integer friendCount, integer maxFriends)
		-- 받은 목록을 친구 창에 그린다 (대상 유저 Id 는 호출부 마지막 인자).
		local popup = _EntityService:GetEntityByPath("/ui/PopupGroup/FriendPopup")
		if not isvalid(popup) then return end
		local ctrl = popup:GetComponent("script.UIFriendController")
		if isvalid(ctrl) then
			ctrl:ApplyList(payload, friendCount, maxFriends)
		end
	end

end

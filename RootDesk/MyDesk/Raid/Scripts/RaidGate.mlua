@Component
script RaidGate extends Component
	-- 레이드 대기실에 세워지는 보스방 진입 게이트.
	--
	-- 일반 포탈(PortalGate)이 "이미 있는 맵으로 이동"이라면, 이 게이트는 "난이도를 고르게 한 뒤
	-- 보스방 인스턴스를 새로 연다". 트리거 감지 / ActivePortal 배선 / 스프라이트 색은 같은 엔티티에
	-- 함께 붙는 PortalGate 가 그대로 담당하고(프리셋 우선), 이 컴포넌트는 **어떤 보스인지**만
	-- 들고 있다가 PlayerController:ServerRequestWarp 의 F 분기에서 읽힌다.
	--
	-- 난이도는 여기 담기지 않는다 — F 를 누르면 난이도 선택 창이 뜨고, 그 창이 고른 값으로
	-- BossRaidLogic:RequestEnterBossRoom 을 부른다. 대기실이 공유 맵이라 게이트에 난이도를 박아 두면
	-- 먼저 들어온 사람의 선택이 다른 사람에게 그대로 적용돼 버린다.
	--
	-- 게이트는 BossRaidLogic:SpawnLobbyGate 가 대기실을 만들 때 한 번 세우고 BossId 를 주입한다.

	@Sync
	property string BossId = ""

	-- 조준 가이드 라벨 (PlayerController:ReadInteractLabel 이 읽는다)
	property string InteractLabel = "보스전 입장하기"

end

@Component
script RaidGate extends Component
	-- 레이드 대기실에 세워지는 보스방 진입 게이트.
	--
	-- 일반 포탈(PortalGate)이 "이미 있는 맵으로 이동"이라면, 이 게이트는 "보스방 인스턴스를 새로 열고
	-- 그 방에 있던 전원을 밀어 넣는다". 트리거 감지 / ActivePortal 배선 / 스프라이트 색은 같은 엔티티에
	-- 함께 붙는 PortalGate 가 그대로 담당하고(프리셋 우선), 이 컴포넌트는 "어떤 보스·난이도로 들어갈지"만
	-- 들고 있다가 PlayerController:ServerRequestWarp 의 F 분기에서 읽힌다.
	--
	-- 게이트는 BossRaidLogic:SpawnLobbyGate 가 런타임에 세우고 여기 두 값을 주입한다.

	@Sync
	property string BossId = ""

	@Sync
	property string DifficultyId = ""

	-- 조준 가이드 라벨 (PlayerController:ReadInteractLabel 이 읽는다)
	property string InteractLabel = "보스전 입장하기"

end

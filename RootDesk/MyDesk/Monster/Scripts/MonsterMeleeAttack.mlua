@Component
script MonsterMeleeAttack extends AttackComponent
	-- On-demand contact attack for top-down monsters. The AI script calls DoAttack()
	-- when a player is in range; a box centered on the monster damages player hitboxes.

	property number ContactDamage = 5
	property number AttackBoxSize = 2.2

	-- T38: 접촉 데미지 (겹침 시 주기 타격)
	property number TouchDamage = 2
	@HideFromInspector property number TouchTickInterval = 0.8
	@HideFromInspector property number TouchRadius = 0.55
	@HideFromInspector property number TouchBoxSize = 1.1

	-- 착지 내려찍기(LEAP) 전용 피해량. 0 이하면 ContactDamage 를 그대로 쓴다.
	property number SlamDamage = 0

	@Sync
	property string LastAttackInfo = ""

	@ExecSpace("ServerOnly")
	method void DoAttack()
		-- 윈드업 만료 시점 정식 공격 (attackInfo="attack")
		self.LastAttackInfo = "attack"
		self:DoAttackWithInfo("attack", self.AttackBoxSize)
	end

	@ExecSpace("ServerOnly")
	method void DoSlamAttack(Vector2 center, number radius)
		-- LEAP 착지 광역 타격 (attackInfo="slam").
		-- 판정 원의 중심/반지름은 텔레그래프 마커에 쓴 값과 동일하게 호출부에서 넘겨받는다
		-- (보이는 원 = 맞는 원. 몬스터 위치 기준 사각 박스를 쓰던 구형 경로는 시각 불일치였다).
		self.LastAttackInfo = "slam"
		local r = radius
		if r == nil or r <= 0 then r = self.AttackBoxSize * 0.5 end
		local shape = CircleShape(center, r)
		self:AttackFast(shape, "slam", CollisionGroups.HitBox)
		log("[BOSS][SLAM] aoe center=(" .. tostring(center.x) .. "," .. tostring(center.y) .. ") r=" .. tostring(r))
	end

	@ExecSpace("ServerOnly")
	method void DoPatternCircle(Vector2 center, number radius, integer damage)
		-- 보스 패턴(BossPatternController) 예고 원 타격 (attackInfo="pattern").
		-- 피해량은 패턴 행마다 달라서 호출부가 넘긴다. 다음 패턴 타격이 덮어쓸 때까지 유지한다
		-- (CalcDamage 호출 시점이 AttackFast 반환 뒤여도 값이 비지 않도록 일부러 지우지 않는다).
		self.LastAttackInfo = "pattern"
		self._T.patternDamage = damage
		local r = radius
		if r == nil or r <= 0 then r = 1 end
		self:AttackFast(CircleShape(center, r), "pattern", CollisionGroups.HitBox)
	end

	@ExecSpace("ServerOnly")
	method void DoTouchAttack()
		-- (legacy) 트랜스폼 원점 기준 정사각 접촉 틱. 콜라이더를 못 읽는 폴백 경로 전용.
		self.LastAttackInfo = "touch"
		self:DoAttackWithInfo("touch", self.TouchBoxSize)
	end

	@ExecSpace("ServerOnly")
	method void DoTouchAttackBox(Vector2 center, Vector2 size)
		-- 접촉 틱 공격 (attackInfo="touch"). 판정 박스를 호출부가 실제 콜라이더에서 산출해 넘긴다.
		-- 구형은 몬스터 트랜스폼 원점 기준 고정 정사각이라, Scale 이 큰 몹(슬라임킹 2.8)이나
		-- ColliderOffset 이 있는 발밑 피벗 몹에서 "몸에 붙어도 안 맞는" 상태가 됐다.
		self.LastAttackInfo = "touch"
		local shape = BoxShape(center, size, 0)
		self:AttackFast(shape, "touch", CollisionGroups.HitBox)
	end

	@ExecSpace("ServerOnly")
	method void DoAttackWithInfo(string attackInfo, number boxSize)
		self.LastAttackInfo = attackInfo
		local t = self.Entity.TransformComponent
		if not isvalid(t) then return end
		local p = t.WorldPosition
		local shape = BoxShape(Vector2(p.x, p.y), Vector2(boxSize, boxSize), 0)
		self:AttackFast(shape, attackInfo, CollisionGroups.HitBox)
	end

	@ExecSpace("ServerOnly")
	method void DoAttackBoxAt(Vector2 center, Vector2 size, string attackInfo)
		self.LastAttackInfo = attackInfo
		local shape = BoxShape(center, size, 0)
		self:AttackFast(shape, attackInfo, CollisionGroups.HitBox)
	end

	@ExecSpace("ServerOnly")
	method void BeginChargeHits()
		-- 돌진 1회 시작: 이번 돌진에 이미 맞은 플레이어 목록 초기화(플레이어당 1회 적중).
		self._T.chargeHitIds = {}
	end

	@ExecSpace("ServerOnly")
	method void DoChargeSweep(Vector2 center, Vector2 size)
		-- 돌진 접촉 판정: 이번 프레임 몸통이 지나간 구간(직전→현재 몸통 박스의 합집합)과
		-- 겹치는 플레이어 히트박스를 타격. 이미 맞은 플레이어는 IsAttackTarget 에서 제외.
		self.LastAttackInfo = "charge"
		local shape = BoxShape(center, size, 0)
		self:AttackFast(shape, "charge", CollisionGroups.HitBox)
	end

	method void OnAttack(Entity defender)
		-- ⚠ AttackComponent 훅에 @ExecSpace 금지.
		if self.LastAttackInfo == "charge" and self._T.chargeHitIds ~= nil and isvalid(defender) then
			self._T.chargeHitIds[defender.Id] = true
		end
	end

	method integer CalcDamage(Entity attacker, Entity defender, string attackInfo)
		-- attackInfo 태깅으로 분기 (이름 분기 아님). ⚠ AttackComponent 훅에 @ExecSpace 금지.
		if attackInfo == "touch" then
			local dmg = self.TouchDamage
			-- T102: 모델 기본값 2이거나 미설정된 경우, 몬스터 본체 공격력(ContactDamage)의 50%로 자동 비례 산출
			if dmg <= 0 or dmg == 2 then
				dmg = math.max(1, math.floor(self.ContactDamage * 0.5))
			end
			return math.floor(dmg)
		end
		if attackInfo == "pattern" and self._T.patternDamage ~= nil then
			return math.floor(self._T.patternDamage)
		end
		if attackInfo == "slam" and self.SlamDamage > 0 then
			return math.floor(self.SlamDamage)
		end
		return math.floor(self.ContactDamage)
	end

	method boolean IsAttackTarget(Entity defender, string attackInfo)
		-- Only player entities take this monster's contact damage.
		if isvalid(defender.PlayerComponent) == false then return false end
		if attackInfo == "charge" and self._T.chargeHitIds ~= nil and self._T.chargeHitIds[defender.Id] then
			return false
		end
		return __base:IsAttackTarget(defender, attackInfo)
	end

end

@Component
script Monster extends Component
	-- Generic monster HP / death / respawn. Map-type agnostic (reused by every monster model).
	-- HP uses `number` (double); the AI script reads IsDead to play the death clip.

	@Sync property number MaxHp = 30
	property number Defense = 6
	property number RootThrowBonus = 0.25
	property number BossControlScale = 0.25
	-- 보스에게 건 균열(Vulnerable, 받는 피해 증가)은 이 배율로 줄어든다 (균열 각인: 일반 +20% / 보스 +10%).
	property number BossVulnerableScale = 0.5
	-- 보스에게 건 약화(Weaken, 주는 피해 감소)는 이 배율로 줄어든다 (야생의 고무: 일반 −15% / 보스 약 −8%).
	property number BossWeakenScale = 0.55
	-- 장비·주문 부여 적중 시 둔화(SlowOnHit)의 지속 시간(초)
	property number GearSlowDuration = 2.0
	@Sync @HideFromInspector property number Hp = 0
	@Sync property boolean RespawnOn = false
	@Sync @HideFromInspector property boolean IsDead = false
	@Sync property number RespawnDelay = 5
	@Sync @HideFromInspector property number DestroyDelay = 0.7
	@HideFromInspector property string DamageSkinRUID = "02c22d93421b4038b3c413b3e40b57ec"

	-- Boss config (data-driven via the .model). A boss drops loot to its killer and
	-- unlocks the next-tier hunting-ground waypoint on death (game_design.md §2.2 ③).
	@Sync property boolean IsBoss = false
	property string BossDropItem = "copper ore"
	property number BossDropMin = 5
	property number BossDropMax = 10
	-- Waypoint unlocked when this boss dies (matches a PortalDestinationDataSet DestinationId).
	property string UnlockWaypointId = ""
	property string UnlockWaypointName = ""

	-- Stable data key (model id slug: slime / boar / horn_mushroom / slime_king).
	-- Spawner injects after spawn; empty falls back to Entity.Name for hand-placed monsters.
	property string MonsterId = ""

	-- 바이옴 틴트(BiomeDataSet.MonsterTint) 등 스폰 시 정해진 기본 색. 피격 플래시·공격 예고가 끝나면 흰색이 아니라 이 색으로 복귀한다.
	-- (구형은 무조건 흰색으로 되돌려 "어둡게 스폰된 몬스터가 맞으면 원래 색으로 돌아오는" 현상이 났다.)
	@Sync @HideFromInspector property Color BaseTint = Color(1, 1, 1, 1)

	-- 지금 걸린 상태이상 중 시각 표시가 있는 것(StatusVisualDataSet)을 우선순위 순으로 쉼표로 이은 값.
	-- 상태이상 자체(_T.SkillStatuses)는 서버 전용이라, 클라 연출(머리 위 이펙트·틴트)은 이 값만 본다.
	@Sync @HideFromInspector property string StatusVisual = ""

	-- 드롭 테이블만 다른 SourceId 로 갈아끼운다 (레이드 난이도별 보상). 공란이면 MonsterId 를 쓴다.
	-- MonsterId 자체를 바꾸지 않는 이유: 퀘스트 Kill 조건·도감 집계 키가 MonsterId 이기 때문이다.
	property string DropSourceOverride = ""

	-- Last entity that damaged this monster (the killer credit, server-side only).
	@HideFromInspector property any LastAttacker = nil

	method void OnBeginPlay()
		-- Initializes current HP and binds the taken-hit damage skin if present.
		self.Hp = self.MaxHp
		local skinSetting = self.Entity.DamageSkinSettingComponent
		if isvalid(skinSetting) then
			skinSetting.DamageSkinId = DataRef(self.DamageSkinRUID)
		end
		-- 늦게 들어온 클라는 OnSyncProperty 없이 현재 값만 받으므로 시작할 때 한 번 그린다.
		if self:IsClient() then
			self:ApplyStatusVisualClient()
		end
	end

	method void OnEndPlay()
		-- 머리 위 상태이상 이펙트 정리(클라).
		if self:IsClient() then
			self:ClearStatusVisualClient()
		end
		if self._T.StatusTimer ~= nil then
			_TimerService:ClearTimer(self._T.StatusTimer)
			self._T.StatusTimer = nil
		end
	end

	method table GetStatusVisualRows()
		-- StatusVisualDataSet 캐시: StatusKey → { priority, name, tint(Color), effect, scale }. 서버·클라 공용.
		if self._T.StatusRows ~= nil then return self._T.StatusRows end
		local rows = {}
		local ds = _DataService:GetTable("StatusVisualDataSet")
		if ds ~= nil then
			for i = 1, ds:GetRowCount() do
				local key = tostring(ds:GetCell(i, "StatusKey") or "")
				if key ~= "" then
					local tint = Color(1, 1, 1, 1)
					local parts = {}
					for s in string.gmatch(tostring(ds:GetCell(i, "Tint") or ""), "[^|]+") do parts[#parts + 1] = tonumber(s) or 1 end
					if #parts >= 3 then tint = Color(parts[1], parts[2], parts[3], 1) end
					rows[key] = {
						priority = tonumber(ds:GetCell(i, "Priority")) or 99,
						name = tostring(ds:GetCell(i, "DisplayName") or key),
						tint = tint,
						effect = tostring(ds:GetCell(i, "EffectRUID") or ""),
						scale = tonumber(ds:GetCell(i, "EffectScale")) or 1,
					}
				end
			end
		end
		self._T.StatusRows = rows
		return rows
	end

	method table SplitStatusVisual()
		-- StatusVisual("Stun,Slow") → { "Stun", "Slow" }
		local keys = {}
		for s in string.gmatch(tostring(self.StatusVisual or ""), "[^,]+") do keys[#keys + 1] = s end
		return keys
	end

	method Color GetRestTint()
		-- 평소 색 = 스폰 기본 틴트(BaseTint) × 가장 우선인 상태이상 틴트. 피격 플래시·공격 예고가 끝나면 이 색으로 돌아온다.
		local base = self.BaseTint
		local keys = self:SplitStatusVisual()
		if #keys == 0 then return base end
		local row = self:GetStatusVisualRows()[keys[1]]
		if row == nil then return base end
		return Color(base.r * row.tint.r, base.g * row.tint.g, base.b * row.tint.b, base.a)
	end

	@ExecSpace("ServerOnly")
	method void RefreshStatusVisual()
		-- 지금 걸린 상태이상으로 StatusVisual(@Sync)과 평소 색을 다시 맞추고, 가장 빨리 끝나는 상태에 맞춰 다음 갱신을 예약한다.
		local rows = self:GetStatusVisualRows()
		local now = _UtilLogic.ElapsedSeconds
		local active = {}
		local nextExpire = nil
		if not self.IsDead then
			for key, st in pairs(self._T.SkillStatuses or {}) do
				if st ~= nil and st.expires > now and rows[key] ~= nil then
					active[#active + 1] = key
					if nextExpire == nil or st.expires < nextExpire then nextExpire = st.expires end
				end
			end
		end
		table.sort(active, function(a, b) return rows[a].priority < rows[b].priority end)
		local joined = table.concat(active, ",")
		if joined ~= self.StatusVisual then
			self.StatusVisual = joined
			-- 피격 플래시 중이면 플래시가 끝날 때 복귀 색을 칠한다(FlashHit).
			local sprite = self.Entity.SpriteRendererComponent
			if isvalid(sprite) and (self._T.FlashUntil or 0) <= now then
				sprite.Color = self:GetRestTint()
			end
			log("[STATUS-FX] " .. self:GetMonsterId() .. " visual=" .. (joined == "" and "-" or joined))
		end
		if self._T.StatusTimer ~= nil then
			_TimerService:ClearTimer(self._T.StatusTimer)
			self._T.StatusTimer = nil
		end
		if nextExpire ~= nil then
			self._T.StatusTimer = _TimerService:SetTimerOnce(function()
				self._T.StatusTimer = nil
				if isvalid(self.Entity) then self:RefreshStatusVisual() end
			end, math.max(0.05, nextExpire - now + 0.02))
		end
	end

	@ExecSpace("ClientOnly")
	method void OnSyncProperty(string propertyName, any newValue)
		-- 상태이상 표시가 바뀌면 머리 위 이펙트를 다시 붙인다.
		if propertyName == "StatusVisual" then
			self:ApplyStatusVisualClient()
		end
	end

	@ExecSpace("ClientOnly")
	method void ClearStatusVisualClient()
		-- 붙여 둔 루프 이펙트를 모두 뗀다.
		for _, serial in pairs(self._T.StatusFx or {}) do
			if serial ~= nil and serial ~= 0 then _EffectService:RemoveEffect(serial) end
		end
		self._T.StatusFx = {}
	end

	@ExecSpace("ClientOnly")
	method void ApplyStatusVisualClient()
		-- 머리 위(피격 박스 윗변)에 상태이상 루프 이펙트를 최대 3개, 우선순위 순으로 가로로 붙인다.
		-- 부모(몬스터) Scale 이 곱해지므로 로컬 위치·배율은 나눠서 넘긴다. 피격 박스는 로컬 단위다(규칙 14).
		self:ClearStatusVisualClient()
		if self.IsDead then return end
		local keys = self:SplitStatusVisual()
		if #keys == 0 then return end
		local rows = self:GetStatusVisualRows()
		local ts = self.Entity.TransformComponent.Scale
		local sx = math.max(0.01, math.abs(ts.x))
		local sy = math.max(0.01, math.abs(ts.y))
		local headY = 1.0 / sy
		local hit = self.Entity.HitComponent
		if isvalid(hit) then headY = hit.ColliderOffset.y + hit.BoxSize.y * 0.5 end
		local shown = math.min(3, #keys)
		local opts = { IgnoreMapLayerCheck = true, SortingLayer = _RenderLayers.EntityLayer, OrderInLayer = 600 }
		for i = 1, shown do
			local row = rows[keys[i]]
			if row ~= nil and row.effect ~= "" then
				local x = (i - (shown + 1) * 0.5) * (0.9 / sx)
				local s = row.scale
				local serial = _EffectService:PlayEffectAttached(row.effect, self.Entity, Vector3(x, headY + 0.35 / sy, 0), 0, Vector3(s / sx, s / sy, 1), true, opts)
				self._T.StatusFx[keys[i]] = serial
			end
		end
	end

	method string GetMonsterId()
		-- Data-lookup key: MonsterId property preferred over unstable Entity.Name.
		if self.MonsterId ~= nil and self.MonsterId ~= "" then
			return self.MonsterId
		end
		return self.Entity.Name or ""
	end

	@ExecSpace("ServerOnly")
	method void Dead()
		-- Flags death, drives the DEAD state, then hides/destroys (or keeps for respawn).
		self.IsDead = true
		-- 죽으면 상태이상 표시(머리 위 이펙트·틴트)를 걷는다.
		self:RefreshStatusVisual()
		local sc = self.Entity.StateComponent
		if isvalid(sc) then sc:ChangeState("DEAD") end

		local mid = self:GetMonsterId()

		-- Coin drop based on MonsterCoinDropDataSet (key = MonsterId model slug)
		local map = self.Entity.CurrentMap
		local transform = self.Entity.TransformComponent
		if isvalid(map) and isvalid(transform) and _TileDurabilityManager ~= nil then
			local dropDs = _DataService:GetTable("MonsterCoinDropDataSet")
			if dropDs ~= nil and mid ~= "" then
				local row = dropDs:FindRow("MonsterId", mid)
				if row ~= nil then
					-- UserDataRow: GetItem only (no RowIndex) — §1.2 rule 7 / T35.
					-- 없는 컬럼 GetItem은 LEA-3011. pcall은 예외만 삼킬 뿐 LEA-3011 로그는 그대로 남는다 — 열 이름 정합은 scripts/check_dataset_columns.cjs 가 정적으로 지킨다.
					local function rowNum(col, defaultVal)
						local ok, v = pcall(function() return row:GetItem(col) end)
						if ok and v ~= nil and v ~= "" then
							return tonumber(v) or defaultVal
						end
						return defaultVal
					end
					local dropChance = rowNum("DropChance", 0.0)
					if math.random() <= dropChance then
						local minAmt = math.floor(rowNum("MinAmount", 1))
						local maxAmt = math.floor(rowNum("MaxAmount", 1))
						if maxAmt < minAmt then maxAmt = minAmt end
						local count = math.random(minAmt, maxAmt)
						local p = transform.WorldPosition
						-- item_dataset id column (Name "Coin" → id "coin")
						_TileDurabilityManager:SpawnResourceDrop(map, Vector3(p.x, p.y, 0), "coin", count, count, 0)
						log("[MONSTER] Dropped " .. count .. " Coins from " .. mid)
					end
				end
			end
		end

		-- ItemDropDataSet 확률 드롭 — 보스/일반 구분 없이 모든 몬스터에 적용한다.
		-- (과거에는 GrantBossRewards 안에서만 호출돼 일반 슬라임의 slime_jelly 행이 영영 롤링되지 않았다.)
		if isvalid(map) and isvalid(transform) and _TileDurabilityManager ~= nil then
			self:DropFromItemDropDataSet(map, transform.WorldPosition)
		end

		-- Boss reward: drop loot at the corpse + unlock the next-tier waypoint for the killer.
		if self.IsBoss then
			self:GrantBossRewards()
		end

		-- 처치 크레딧 대상: 보스는 그 방에 있던 전원(레이드 파티원 포함), 일반 몬스터는 막타자.
		-- 퀘스트 Kill 진행과 처치 경험치가 같은 목록을 쓴다.
		local credited = {}
		if self.IsBoss then
			credited = self:GetBossCreditPlayers()
		elseif isvalid(self.LastAttacker) then
			credited[1] = self.LastAttacker
		end

		-- 처치 경험치 (MonsterCoinDropDataSet.KillXp)
		if mid ~= "" and #credited > 0 then
			local killXp = self:GetKillXp(mid)
			if killXp > 0 then
				for _, player in ipairs(credited) do
					local pcComp = player:GetComponent("script.PlayerController")
					if isvalid(pcComp) then
						---@type PlayerController
						local controller = pcComp
						controller:AddXP(killXp)
					end
				end
				log("[MONSTER] " .. mid .. " kill xp " .. tostring(killXp) .. " -> " .. tostring(#credited) .. " player(s)")
			end
		end

		-- 업적/퀘스트 진행: 처치 액션 발행 (CondArg = MonsterId)
		-- 보스는 전원에게 — 관문 퀘스트(217·227·236·246)가 파티 전원에게 오른다. 일반 몬스터는 막타자에게만.
		if _ActionSignals ~= nil and mid ~= "" then
			for _, player in ipairs(credited) do
				_ActionSignals:EmitToPlayer(player, _ActionEnum.Kill, mid, 1)
			end
			if self.IsBoss then
				log("[BOSS] " .. mid .. " kill credit -> " .. tostring(#credited) .. " player(s)")
			end
		end

		-- 레이드 인스턴스에서 죽은 보스면 주간 카운트·보상·인스턴스 정리를 BossRaidLogic 이 전담한다.
		-- 레이드 사본이 아니면 BossRaidLogic 쪽에서 자체적으로 무시한다.
		if self.IsBoss and _BossRaidLogic ~= nil then
			_BossRaidLogic:OnRaidBossDefeated(self.Entity, self.LastAttacker)
		end

		-- T22: 도감 몬스터 처치 수 기록 (막타 플레이어)
		if isvalid(self.LastAttacker) and mid ~= "" then
			local killerInv = self.LastAttacker:GetComponent("script.PlayerInventory")
			if isvalid(killerInv) then
				---@type PlayerInventory
				local kinv = killerInv
				kinv:RecordMonsterKill(mid)
			end
		end

		local delayHide = function()
			self.Entity:SetVisible(false)
			self.Entity:SetEnable(false)
			if self.RespawnOn == false then self.Entity:Destroy() end
		end
		_TimerService:SetTimerOnce(delayHide, self.DestroyDelay)
	end

	@ExecSpace("ServerOnly")
	method void GrantBossRewards()
		-- Drops the boss loot at its position and unlocks the configured waypoint for the killer.
		local map = self.Entity.CurrentMap
		local t = self.Entity.TransformComponent

		-- Loot drop (reuses the resource-drop spawner; pickupGrace 0 = immediately pickable).
		-- 보스 고정 드롭도 기여자 각자에게 소유권을 붙여 따로 떨군다 (일반 드롭과 같은 규칙).
		if isvalid(map) and isvalid(t) and self.BossDropItem ~= "" and _TileDurabilityManager ~= nil then
			local p = t.WorldPosition
			for _, player in ipairs(self:GetDropContributors()) do
				if isvalid(player) and player.PlayerComponent ~= nil then
					_TileDurabilityManager:SpawnResourceDropOwned(map, Vector3(p.x, p.y, 0), self.BossDropItem, self.BossDropMin, self.BossDropMax, 0, player.PlayerComponent.UserId, 0)
				end
			end
		end

		-- ItemDropDataSet 드롭은 Dead()에서 전 몬스터 공통으로 처리한다(여기서 중복 호출하지 않는다).

		-- Next-tier waypoint unlock — 보스가 죽은 맵에 있던 **전원**(레이드 파티원 포함)에게 연다.
		-- 막타자 1인만 열던 시절엔 파티원이 다음 사냥터로 못 넘어갔다 (주간 카운트·코인은 이미 전원 지급).
		if self.UnlockWaypointId ~= "" then
			local recipients = self:GetBossCreditPlayers()
			for _, player in ipairs(recipients) do
				local pc = player:GetComponent("script.PlayerController")
				if isvalid(pc) then
					---@type PlayerController
					local controller = pc
					controller:UnlockWaypoint(self.UnlockWaypointId, self.UnlockWaypointName)
				end
			end
			log("[BOSS] " .. self:GetMonsterId() .. " unlocked waypoint " .. self.UnlockWaypointId .. " for " .. tostring(#recipients) .. " player(s)")
		end
	end

	@ExecSpace("ServerOnly")
	method table GetBossCreditPlayers()
		-- 보스 처치 크레딧(웨이포인트 해금·퀘스트 Kill) 대상: 보스가 죽은 맵에 있던 전원.
		-- 레이드 보스방은 파티 전용 인스턴스라 곧 파티원 목록이다. 비어 있으면 막타자로 폴백.
		local list = {}
		local map = self.Entity.CurrentMap
		if isvalid(map) and map.MapComponent ~= nil then
			local users = _UserService:GetUsersByMapComponent(map.MapComponent)
			if users ~= nil then
				for _, user in ipairs(users) do
					if isvalid(user) then list[#list + 1] = user end
				end
			end
		end
		if #list == 0 and isvalid(self.LastAttacker) then
			list[1] = self.LastAttacker
		end
		return list
	end

	@ExecSpace("ServerOnly")
	method integer GetKillXp(string mid)
		-- MonsterCoinDropDataSet 의 KillXp 열(처치 1회당 경험치). 행이 없거나 공란이면 0.
		-- 열 이름 정합은 scripts/check_dataset_columns.cjs 가 정적으로 지킨다(규칙 7 ②).
		local ds = _DataService:GetTable("MonsterCoinDropDataSet")
		if ds == nil or mid == nil or mid == "" then return 0 end
		local row = ds:FindRow("MonsterId", mid)
		if row == nil then return 0 end
		return math.max(0, math.floor(tonumber(row:GetItem("KillXp")) or 0))
	end

	@ExecSpace("ServerOnly")
	method boolean IsQuestGuaranteedDrop(Entity player, string guaranteeIds, string itemId)
		-- ItemDropDataSet.GuaranteeQuestIds("302|312|...") 보장 판정.
		-- **해당 기여자**가 그 퀘스트를 진행 중이고 해당 아이템을 아직 하나도 갖고 있지 않을 때만 true.
		-- 획득하면 보유 수량 때문에 false로 돌아가 원래 확률로 복귀한다(= 최초 1회 확정).
		-- 🔴 판정 대상이 파티원 각자여야 한다 — 막타자 한 명으로 굴리면 그 사람의 퀘스트 상태가
		--    파티 전체 드롭을 결정해 버린다 (2026-09-16 제작자 지적).
		if guaranteeIds == nil or guaranteeIds == "" then return false end
		if itemId == nil or itemId == "" then return false end
		if not isvalid(player) then return false end

		local quest = player:GetComponent("script.PlayerQuest")
		if not isvalid(quest) then return false end
		---@type PlayerQuest
		local pq = quest
		local progressing = pq.ProgressingIdTable
		if progressing == nil then return false end

		local questActive = false
		for token in string.gmatch(guaranteeIds, "[^|]+") do
			local qid = math.tointeger(tonumber(token))
			if qid ~= nil and progressing[qid] == true then
				questActive = true
				break
			end
		end
		if not questActive then return false end

		-- 인벤토리 키는 item_dataset.Name (규칙 4). ItemDropDataSet.ItemId는 id 컬럼이다.
		local itemDs = _DataService:GetTable("item_dataset")
		if itemDs == nil then return false end
		local row = itemDs:FindRow("id", itemId)
		if row == nil then return false end
		local itemName = row:GetItem("Name") or ""
		if itemName == "" then return false end

		local inv = player:GetComponent("script.PlayerInventory")
		if not isvalid(inv) then return false end
		---@type PlayerInventory
		local pinv = inv
		if pinv:GetItemCount(itemName) > 0 then return false end

		log("[MONSTER] quest-guaranteed drop armed: " .. itemName .. " (" .. guaranteeIds .. ")")
		return true
	end

	@ExecSpace("ServerOnly")
	method table GetDropContributors()
		-- 전리품을 받을 사람들. 지금은 막타자 1인이지만, R-2 파티가 붙으면 여기에 파티원을 채우면 된다.
		-- 드롭 루틴은 이 목록을 받아 **1인씩 따로** 확률을 굴리므로 호출부 변경만으로 파티 드롭이 완성된다.
		local list = {}
		if isvalid(self.LastAttacker) then
			list[#list + 1] = self.LastAttacker
		end
		return list
	end

	method void DropFromItemDropDataSet(Entity map, any worldPos)
		-- ItemDropDataSet에서 SourceId==MonsterId 행을 확률 드롭. ItemId = item_dataset.id.
		-- 🔴 확률은 **기여자 1인마다 따로** 굴리고, 떨어진 전리품에는 그 사람의 소유권을 건다.
		--    퀘스트 확정 드롭·LootChance 보너스가 개인 상태로 평가돼야 하기 때문이다
		--    (막타자 한 명으로 굴리면 그 사람의 퀘스트 상태가 파티 전체 드롭을 결정해 버린다).
		local ds = _DataService:GetTable("ItemDropDataSet")
		if ds == nil then return end
		-- 레이드 난이도 사본은 DropSourceOverride 로 보상 테이블만 분기한다(MonsterId 는 그대로).
		local sourceId = self.DropSourceOverride
		if sourceId == nil or sourceId == "" then sourceId = self:GetMonsterId() end
		if sourceId == "" then return end

		local contributors = self:GetDropContributors()
		if #contributors == 0 then return end

		local rowCount = ds:GetRowCount()
		for _, player in ipairs(contributors) do
			if isvalid(player) and player.PlayerComponent ~= nil then
				local ownerId = player.PlayerComponent.UserId
				for i = 1, rowCount do
					local sid = ds:GetCell(i, "SourceId") or ""
					if sid == sourceId then
						local prob = tonumber(ds:GetCell(i, "Probability")) or 0.0
						-- 퀘스트 보장 드롭: GuaranteeQuestIds에 적힌 퀘스트를 진행 중이고 아직 그 아이템이
						-- 없으면 확률을 무시하고 1회 확정 드롭한다(전직 시험 증표 — 대형 슬라임 젤리).
						local guaranteeIds = ""
						local okGuar, guarRaw = pcall(function() return ds:GetCell(i, "GuaranteeQuestIds") end)
						if okGuar and guarRaw ~= nil then guaranteeIds = tostring(guarRaw) end
						local rowItemId = ds:GetCell(i, "ItemId") or ""
						local forced = self:IsQuestGuaranteedDrop(player, guaranteeIds, rowItemId)
						if forced or math.random() <= prob then
							local itemId = rowItemId
							local minC = math.floor(tonumber(ds:GetCell(i, "MinCount")) or 1)
							local maxC = math.floor(tonumber(ds:GetCell(i, "MaxCount")) or minC)
							if maxC < minC then maxC = minC end
							local count = math.random(minC, maxC)
							local okNatural, natural = pcall(function() return ds:GetCell(i, "NaturalLoot") end)
							if okNatural and natural == "true" then
								local pc = player:GetComponent("script.PlayerController")
								if isvalid(pc) then
									local chance = pc:GetPassiveBonus("LootChance")
									if self:GetSkillStatus("Root") ~= nil then chance = chance * 2 end
									if math.random() < math.min(1, chance) then count = count + 1 end
								end
							end
							if itemId ~= "" and count > 0 then
								_TileDurabilityManager:SpawnResourceDropOwned(map, Vector3(worldPos.x, worldPos.y, 0), itemId, count, count, 0, ownerId, 0)
								log("[MONSTER] drop id=" .. itemId .. " x" .. tostring(count) .. " from " .. sourceId .. " owner=" .. ownerId)
							end
						end
					end
				end
			end
		end
	end

	@ExecSpace("ServerOnly")
	method void Respawn()
		-- Restores visibility/HP and returns to IDLE (only used when RespawnOn = true).
		self.IsDead = false
		self._T.SkillStatuses = {}
		self:RefreshStatusVisual()
		self.LastAttacker = nil
		self.Entity:SetVisible(true)
		self.Entity:SetEnable(true)
		self.Hp = self.MaxHp
		local sc = self.Entity.StateComponent
		if isvalid(sc) then sc:ChangeState("IDLE") end
	end

	@ExecSpace("ServerOnly")
	@EventSender("Self")
	handler HandleHitEvent(HitEvent event)
		-- Subtracts incoming damage; on HP<=0 runs Dead() once (idempotent re-entry guard).
		local originalHp = self.Hp
		if originalHp <= 0 then return end
		self.Hp = self.Hp - event.TotalDamage

		-- Remember who dealt the killing blow so a boss can credit drops/unlock to them.
		if isvalid(event.AttackerEntity) then
			self.LastAttacker = event.AttackerEntity
		end

		-- Hit feedback: knockback away from the attacker + brief red flash.
		-- 넉백 정책(IsKnockbackAllowed): 속박·기절 중이거나 스킬의 Knockback 열이 0 이면 밀지 않는다.
		if isvalid(event.AttackerEntity) and self:IsKnockbackAllowed(event.AttackerEntity) then
			local ai = self.Entity:GetComponent("script.MonsterAI")
			if isvalid(ai) then
				---@type MonsterAI
				local mai = ai
				local ap = event.AttackerEntity.TransformComponent.WorldPosition
				mai:ApplyKnockback(Vector2(ap.x, ap.y))
			end
		end
		self:FlashHit()

		-- T65: 피격음 — 공격자 장착 도구 HitSoundRUID (MulticastPlaySkillSound 선례)
		-- T66: 피격 이펙트 — PlayerCombat.PendingHitEffectRUID (HitEvent.Extra로는 스킬 식별 불가 확인)
		if isvalid(event.AttackerEntity) then
			local pcComp = event.AttackerEntity:GetComponent("script.PlayerController")
			if isvalid(pcComp) then
				---@type PlayerController
				local pc = pcComp
				-- 몬스터를 때린 플레이어는 전투 상태 (비전투 회복 패시브 정지)
				pc:MarkCombat()
				local hitRuid = pc:ResolveEquippedToolSound("HitSoundRUID")
				if hitRuid ~= nil and hitRuid ~= "" then
					pc:MulticastPlaySkillSound(hitRuid)
					log("[T65][HIT] monster sound=" .. hitRuid)
				end
				local combatComp = event.AttackerEntity:GetComponent("script.PlayerCombat")
				if isvalid(combatComp) then
					---@type PlayerCombat
					local combat = combatComp
					self:ApplySkillHit(combat.PendingSkillId, event.AttackerEntity)
					local fx = combat.PendingHitEffectRUID
					if fx ~= nil and fx ~= "" then
						local mpos = self.Entity.TransformComponent.WorldPosition
						-- 배율은 스킬별 HitEffectScale(원본 클립 크기 편차 보정), 좌우 플립은 공격자 시선.
						-- 구형은 둘 다 상수(1.0 / false)여서 매직 클로 히트 FX 가 0.56x0.37 유닛으로
						-- 사실상 안 보였고, 스킬 간 타격감이 4배까지 벌어졌다.
						local hs = combat.PendingHitEffectScale
						if hs == nil or hs <= 0 then hs = 1.0 end
						pc:MulticastPlayEffectEx(fx, mpos, pc.LastDirectionX > 0, hs)
						log("[T66][HITFX] monster ruid=" .. fx .. " scale=" .. tostring(hs))
					end
				end
			end
		end

		if self.Hp > 0 then return end
		self:Dead()
		if self.RespawnOn then
			_TimerService:SetTimerOnce(function() self:Respawn() end, self.RespawnDelay)
		end
	end

	@ExecSpace("ServerOnly")
	method void FlashHit()
		-- Tints the sprite red for a moment to register a hit (Color is @Sync → shows on clients).
		local sprite = self.Entity.SpriteRendererComponent
		if not isvalid(sprite) then return end
		sprite.Color = Color(1, 0.4, 0.4, 1)
		self._T.FlashUntil = _UtilLogic.ElapsedSeconds + 0.1
		_TimerService:SetTimerOnce(function()
			-- 복귀 색 = 기본 틴트 × 상태이상 틴트(GetRestTint).
			local s = self.Entity.SpriteRendererComponent
			if isvalid(s) then s.Color = self:GetRestTint() end
		end, 0.1)
	end


	method table GetSkillStatus(string key)
		local status = (self._T.SkillStatuses or {})[key]
		if status == nil or status.expires <= _UtilLogic.ElapsedSeconds then return nil end
		return status
	end

	method boolean IsKnockbackAllowed(Entity attacker)
		-- 이번 타격이 넉백을 주는가 (2026-10-01 넉백 정책).
		--  ① 속박·기절 중인 적은 밀지 않는다 — 덫에 묶인 적이 맞을 때마다 덫 밖으로 밀려나는 일을 막는다.
		--     보스의 속박·기절은 둔화로 바뀌어(ApplySkillHit) 여기 걸리지 않는다.
		--  ② 스킬 행의 Knockback 열이 0 이면 넉백이 없다(장판·덫·도트 틱). 공란 = 넉백 있음. 평타는 항상 넉백이 있다.
		if self:GetSkillStatus("Root") ~= nil or self:GetSkillStatus("Stun") ~= nil then return false end
		local combatComp = attacker:GetComponent("script.PlayerCombat")
		if not isvalid(combatComp) then return true end
		---@type PlayerCombat
		local combat = combatComp
		local skillId = combat.PendingSkillId
		if skillId == nil or skillId == "" then return true end
		local ds = _DataService:GetTable("SkillDataSet")
		local row = ds ~= nil and ds:FindRow("SkillId", skillId) or nil
		if row == nil then return true end
		local pcComp = attacker:GetComponent("script.PlayerController")
		if not isvalid(pcComp) then return true end
		---@type PlayerController
		local pc = pcComp
		return pc:SkillNumber(row, "Knockback", 1) > 0
	end

	method number GetOutgoingDamageScale()
		-- 이 몬스터가 주는 피해 배율. 약화(Weaken — 야생의 고무)가 걸려 있으면 줄어든다. 보스 값은 걸 때 이미 줄였다.
		-- MonsterMeleeAttack·MonsterProjectile 의 CalcDamage 가 곱한다.
		local weaken = self:GetSkillStatus("Weaken")
		if weaken == nil then return 1 end
		return math.max(0.1, 1 - weaken.value)
	end

	method number GetSkillMoveFactor()
		if self:GetSkillStatus("Root") ~= nil then return 0 end
		local acid = self:GetSkillStatus("Acid")
		local slow = self:GetSkillStatus("Slow")
		return math.max(0.1, 1 - math.max(acid ~= nil and acid.value or 0, slow ~= nil and slow.value or 0))
	end

	method integer ResolveSkillDamage(integer baseDamage, string skillId, Entity attacker)
		local pc = attacker:GetComponent("script.PlayerController")
		local damage = baseDamage
		local shred = 0
		local armor = self:GetSkillStatus("ArmorBreak")
		local root = self:GetSkillStatus("Root")
		if armor ~= nil then shred = armor.value * armor.stacks end
		if root ~= nil then shred = math.max(shred, root.value) end
		if isvalid(pc) then
			local ds = _DataService:GetTable("SkillDataSet")
			local row = ds ~= nil and ds:FindRow("SkillId", skillId) or nil
			if row ~= nil then
				local combo = self:GetSkillStatus(pc:SkillText(row, "ComboStatus"))
				if combo ~= nil then damage = damage * (1 + combo.stacks * pc:SkillNumber(row, "ComboMultiplier", 0)) end
				if root ~= nil and pc:SkillText(row, "DamageModel") == "Throw" then damage = damage * (1 + self.RootThrowBonus) end
			end
			-- 장비·주문 부여 전투 특수능력 (⚖️ 2026-09-26: 상태이상 대상 추가 피해는 희귀 파츠의 몫)
			--   ControlledDamagePct: 둔화·속박·기절·산성 상태의 적에게 추가 피해 (보스는 속박·기절이 둔화로 바뀌어도 인정)
			--   BossDamagePct: 보스에게 추가 피해
			local controlled = root ~= nil or self:GetSkillStatus("Stun") ~= nil or self:GetSkillStatus("Slow") ~= nil or self:GetSkillStatus("Acid") ~= nil
			if controlled then
				local cb = pc:GetPassiveBonus("ControlledDamagePct")
				if cb > 0 then damage = damage * (1 + cb) end
			end
			if self.IsBoss then
				local bb = pc:GetPassiveBonus("BossDamagePct")
				if bb > 0 then damage = damage * (1 + bb) end
			end
			-- 정밀 배합(FarDamagePct): 공격자와 FarDamageDistance 이상 떨어진 적에게 추가 피해 (투사체·장판 포함 — 맞은 순간의 거리).
			local far = pc:GetPassiveBonus("FarDamagePct")
			if far > 0 then
				local ap = attacker.TransformComponent.WorldPosition
				local mp = self.Entity.TransformComponent.WorldPosition
				if Vector2.Distance(ap:ToVector2(), mp:ToVector2()) >= pc.FarDamageDistance then damage = damage * (1 + far) end
			end
		end
		-- 균열(Vulnerable — 균열 각인): 받는 모든 피해 증가. 몬스터 쪽 상태라 누가 때리든 적용된다(파티 딜 지원). 보스 값은 걸 때 이미 줄였다.
		local vulnerable = self:GetSkillStatus("Vulnerable")
		if vulnerable ~= nil then damage = damage * (1 + vulnerable.value) end
		return math.max(1, math.floor(damage - self.Defense * (1 - math.min(0.8, shred))))
	end

	@ExecSpace("ServerOnly")
	method void ApplySkillHit(string skillId, Entity attacker)
		local pc = attacker:GetComponent("script.PlayerController")
		if not isvalid(pc) then return end
		pc:RefreshTemperedSkin()
		-- 장비·주문 부여 SlowOnHit(예: 점성 젤리 코어): 평타·스킬 적중 모두 둔화(최대 60%), 더 강한 둔화는 유지.
		local gearSlow = math.min(0.6, pc:GetPassiveBonus("SlowOnHit"))
		if gearSlow > 0 then
			if not self._T.SkillStatuses then self._T.SkillStatuses = {} end
			local old = self:GetSkillStatus("Slow")
			local v = gearSlow
			if old ~= nil and old.value > v then v = old.value end
			-- 내가 건 상태이상 지속은 교감·패시브(GetControlDurationScale)만큼 늘어난다.
			self._T.SkillStatuses["Slow"] = { expires = _UtilLogic.ElapsedSeconds + self.GearSlowDuration * pc:GetControlDurationScale(), value = v, stacks = 1 }
		end
		self:ApplySkillStatus(skillId, attacker)
		-- 장비 둔화처럼 ApplySkillStatus 밖에서 건 상태도 표시에 반영한다.
		self:RefreshStatusVisual()
	end

	@ExecSpace("ServerOnly")
	method void ApplySkillStatus(string skillId, Entity attacker)
		-- 스킬 행의 상태이상(Status·콤보 소모)만 건다. 적중(ApplySkillHit)과, 피해 없이 상태만 거는 오라(야생의 고무 → 약화)가 함께 쓴다.
		-- 장판 판정은 피해가 최소 1이라 "상태만" 걸 수 없어서 따로 둔 경로다 (job-branch-redesign §7.5).
		local pc = attacker:GetComponent("script.PlayerController")
		if not isvalid(pc) then return end
		local ds = _DataService:GetTable("SkillDataSet")
		local row = ds ~= nil and ds:FindRow("SkillId", skillId) or nil
		if row == nil then return end
		if not self._T.SkillStatuses then self._T.SkillStatuses = {} end
		if pc:SkillText(row, "ConsumeCombo") == "true" then self._T.SkillStatuses[pc:SkillText(row, "ComboStatus")] = nil end
		local key = pc:SkillText(row, "Status")
		if key == "" then return end
		-- 내가 건 상태이상 지속은 교감·패시브(GetControlDurationScale)만큼 늘어난다. 보스는 아래에서 둔화로 바뀌며 한 번 더 줄어든다.
		local duration = pc:SkillNumber(row, "StatusDuration", 0) * pc:GetControlDurationScale()
		local value = pc:SkillNumber(row, "StatusValue", 0)
		if self.IsBoss and (key == "Root" or key == "Stun") then
			key = "Slow"
			value = self.BossControlScale
			duration = duration * self.BossControlScale
		elseif self.IsBoss and key == "Vulnerable" then
			value = value * self.BossVulnerableScale
		elseif self.IsBoss and key == "Weaken" then
			value = value * self.BossWeakenScale
		end
		local old = self:GetSkillStatus(key)
		-- 최대 중첩 = 스킬 행 StatusMaxStacks + 패시브 "<상태>MaxStacks"(파쇄 숙련 → ArmorBreakMaxStacks, 레벨 비례 값의 정수 부분).
		local maxStacks = pc:SkillNumber(row, "StatusMaxStacks", 1) + math.floor(math.max(0, pc:GetPassiveBonus(key .. "MaxStacks")) + 0.0001)
		local stacks = math.min(maxStacks, (old ~= nil and old.stacks or 0) + 1)
		self._T.SkillStatuses[key] = { expires = _UtilLogic.ElapsedSeconds + duration, value = value, stacks = stacks }
		log("[SKILL-STATUS] " .. self:GetMonsterId() .. " " .. key .. " stacks=" .. stacks)
		self:RefreshStatusVisual()
	end

end

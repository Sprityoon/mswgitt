@Component
script MonsterAI extends Component
	-- Pattern A top-down (RectTile) monster controller. Owns its own state variable and
	-- swaps SpriteRUID per state (no AIChase/AIWander, no StateComponent marker states).
	-- WANDER <-> STAND idle loop, CHASE the nearest player, ATTACK in range, RETURN to spawn
	-- when leashed too far. All RUIDs / ranges / timings are model properties (data-driven).

	-- Per-state animation clips (assigned per-model; default empty).
	property string StandRUID = ""
	property string MoveRUID = ""
	property string AttackRUID = ""
	property string DieRUID = ""
	
	-- Monster Attack Type ("CONTACT", "MELEE_WEAPON", "RANGED", "MAGIC", "CHARGE", "LEAP")
	-- CHARGE: 정지 텔레그래프(AttackWindup) → 돌진 시작 시 유저 거리만큼 전속 직진 → 감속 정지.
	-- LEAP: 예고 끝 유저 위치 고정 → 그 위치까지 점프(FLY) → 공중 체공(HANG) → 수직 내려찍기(SLAM).
	property string AttackType = "CONTACT"


	-- Behaviour tuning (units).
	property number DetectRange = 6.0
	property number AttackRange = 1.0
	-- T38: CHASE 접근 정지 거리 (파고들기 제거). AttackRange 이내에서 정지.
	property number StopDistance = 0.8
	-- 추적 로직 개선: 스폰 기준 리쉬 거리를 넉넉히 잡아 추적이 너무 쉽게 끊기지 않도록 한다.
	property number LeashRange = 15.0
	-- 공격 준비(주황 틴트) 대기 시간. 몹별 모델 프로퍼티로 다르게 둘 수 있다.
	property number AttackWindup = 0.5
	property number AttackCooldown = 1.5
	-- (legacy) CONTACT 윈드업 접근 배율. 준비 상태에서는 전 타입 정지하므로 현재 미사용.
	@HideFromInspector property number AttackApproachSpeedMultiplier = 0.5
	-- 리쉬 이탈/타겟 상실로 귀환할 때 이동 속도 배율. 1.0보다 크면 평시보다 빠르게 스폰으로 돌아간다.
	property number ReturnSpeedMultiplier = 2.2

	-- CHARGE 전용 튜닝(AttackType == "CHARGE"일 때만 사용).
	-- 돌진 이동 속도 배율(평시 InputSpeed 대비). 정지 텔레그래프 이후 이 속도로 고정 방향 직진.
	property number ChargeSpeedMultiplier = 3.0
	-- (legacy) 예전 고정 오버슈트 배율. 현재는 돌진 시작 시 유저 거리를 쓰고, 이후는 감속으로 멈춘다.
	@HideFromInspector property number ChargeOvershootMultiplier = 1.2
	-- 전속 돌진 이후 감속 구간 지속시간(초). 이 시간 동안 속도가 0으로 줄어든다.
	property number ChargeDecelDuration = 0.4
	-- 돌진 단계 최대 지속시간 안전장치(벽 충돌 등으로 목표 거리에 못 미쳐도 이 시간이 지나면 강제 종료).
	property number ChargeMaxDuration = 2.0

	-- LEAP 전용 튜닝(AttackType == "LEAP"일 때만 사용). 크기는 고정, 위치 이동만 사용.
	-- 예고 구간은 2단계다: 앞부분은 장판이 플레이어를 "추적"하고, 마지막 TelegraphLockLead 초에
	-- 좌표가 "확정"되며 링이 점멸한다. 실제 회피 시간은 예고 전체가 아니라 이 확정 이후 구간이다.
	-- (구형은 예고 시작에 좌표를 고정해서, 걷기만 해도 빠져나가는 무의미한 패턴이었다.)
	-- 확정 시점부터 착지까지 남는 시간 = TelegraphLockLead + 비행 + 체공 + 내려찍기.
	-- (legacy) 예전 스케일 연출용 — 더 이상 적용하지 않음.
	@HideFromInspector property number LeapPeakScale = 1.0
	@HideFromInspector property number LeapRiseFraction = 0.65
	-- 도약 비행(FLY) 최대 시간(초). 실제 비행 시간은 거리/속도로 산출해 이 값 안에서 정한다.
	property number LeapRiseDuration = 0.5
	-- 착지점 상공 체공(HANG) 시간(초).
	property number LeapHangDuration = 0.55
	-- 수직 내려찍기(SLAM) 연출 시간(초).
	property number LeapSlamDuration = 0.18
	-- 스캔 위치 대비 착지 지점 비율(1.0 = 플레이어가 있던 자리에 그대로 착지).
	property number LeapLandingFraction = 1.0
	-- 비행 이동 속도 배율(평시 InputSpeed 대비). 거리가 멀수록 비행 시간이 길어진다.
	property number LeapSpeedMultiplier = 6.0
	-- ★ 난이도의 핵심 손잡이: 좌표 "확정"부터 "착지"까지 플레이어에게 주는 시간(초).
	-- 확정 시점을 (남은 예고 + 예상 비행 + 체공 + 내려찍기)가 이 값이 되는 순간으로 잡기 때문에,
	-- 가까이서 뛰든 멀리서 뛰든 회피 여유가 항상 같다. 거리가 멀수록 그만큼 일찍 확정된다.
	-- 필요한 이동 거리는 SlamRadius 이므로, 대략 SlamRadius / 플레이어속도 에 가까울수록 어려워진다.
	property number LeapReactionWindow = 0.7
	-- (legacy)
	@HideFromInspector property number LeapMidpointFraction = 1.0
	@HideFromInspector property number LeapAnimHoldProgress = 0.7
	-- 공중 체공 포즈로 고정할 공격 클립 프레임 인덱스(FLY/HANG).
	property integer LeapAirFrameIndex = 2
	-- 내려찍기 구간 애니 재생 배율.
	property number LeapAnimFallPlayRate = 1.5

	-- 착지 광역 타격 반지름(월드 단위). 텔레그래프 링 반지름과 동일한 단일 소스다.
	property number SlamRadius = 2.2
	-- 착지 예고 마커 모델명. 빈 값이면 마커 없이 동작한다(마커 미사용 몹 호환).
	property string TelegraphModelId = ""
	-- 착지 충격 카메라 흔들림(세기 / 지속 시간).
	property number ImpactShakeIntensity = 0.35
	property number ImpactShakeDuration = 0.25
	-- 착지 충격 파티클 스케일 배율(SlamRadius 대비).
	@HideFromInspector property number ImpactParticleScale = 0.9
	-- RectTile 은 실제 속도 = InputSpeed / 1.2 다(platform-rect.md §7). 비행 시간 산출에 쓴다.
	@HideFromInspector property number RectTileSpeedDivisor = 1.2
	-- 비행 종료 판정 허용 오차(월드 단위). 이 안쪽이면 스냅 없이 그대로 착지한다.
	@HideFromInspector property number LeapArriveTolerance = 0.35
	-- 스폰 직후 공격/접촉/소환 금지 유예(초). 보스 입장 직격 방지.
	property number SpawnGraceDuration = 0

	-- 미니언 소환(보스 패턴). Interval<=0 또는 ModelId 빈 값이면 비활성.
	property number MinionSummonInterval = 0
	property string MinionModelId = ""
	property integer MinionSummonCount = 4
	property number MinionSummonRadius = 2.5

	@HideFromInspector property number KnockbackSpeed = 7.0
	@HideFromInspector property number KnockbackDuration = 0.18
	-- 피격 후 이 시간(초) 동안은 리쉬(귀환)를 보류하고 끝까지 추적/반격한다.
	@HideFromInspector property number AggroGraceDuration = 4.0

	-- 접촉 피격 판정 여유(월드 단위). 실제 콜라이더 바깥으로 이만큼 더 나가면 접촉으로 친다.
	-- 플레이어 몸 두께를 감안한 값 — 0 이면 콜라이더에 정확히 겹쳐야만 맞는다.
	property number TouchMargin = 0.35
	-- HitComponent 를 못 읽을 때 쓰는 접촉 박스 반폭(월드 단위) 폴백.
	@HideFromInspector property number TouchFallbackHalfExtent = 0.55
	@HideFromInspector property number WanderMin = 1.0
	@HideFromInspector property number WanderMax = 2.5
	@HideFromInspector property number StandMin = 1.0
	@HideFromInspector property number StandMax = 2.0

	-- T99: 엔티티 장애물(자원·가구) — ObstacleQuery 공용. 임계값은 프로퍼티.
	@HideFromInspector property number ObstacleRadius = 0.6
	@HideFromInspector property number ObstacleQueryRadius = 3.0
	@HideFromInspector property number ObstacleStuckSeconds = 1.5
	@HideFromInspector property number ObstacleStuckCooldown = 4.0
	@HideFromInspector property number ObstacleEscapeStep = 0.75
	@HideFromInspector property number ObstacleStuckTimer = 0
	@HideFromInspector property number ObstacleEscapeCooldownTimer = 0
	@HideFromInspector property number ObstacleLastX = 0
	@HideFromInspector property number ObstacleLastY = 0
	@HideFromInspector property boolean ObstaclePosInit = false

	-- T39: 원거리 투사체 설정. ProjectileModelId가 빈 값이면 근접 전용(현행 유지),
	-- 모델명이 들어가면 윈드업 만료 시점에 근접 대신 투사체를 발사한다(모델 프로퍼티 = 데이터 주도, 이름 분기 금지).
	property string ProjectileModelId = ""
	property number ProjectileSpeed = 4.5
	property integer ProjectileDamage = 5
	property number ProjectileLifeTime = 1.5
	property number ProjectileHitRadius = 0.4

	-- T38: 윈드업 텔레그래프 (클라 OnSyncProperty 연출)
	@Sync
	property boolean TelegraphOn = false

	@HideFromInspector property string CurrentAIState = "STAND"
	@HideFromInspector property number StateTimer = 0
	@HideFromInspector property Vector2 MoveDir = Vector2(1, 0)
	@HideFromInspector property Vector2 SpawnPos = Vector2(0, 0)
	@HideFromInspector property number AttackCooldownTimer = 0
	@HideFromInspector property boolean DeathPlayed = false
	-- T93: 접근 차단 장치 히스테리시스 — 진입 후 이탈 반경을 벗어날 때까지 유지
	@HideFromInspector property boolean InsideAvoidZone = false
	-- CHARGE 상태 진행 단계("PAUSE" 정지 | "DASH" 전속 직진 | "DECEL" 감속 정지)
	@HideFromInspector property string ChargePhase = "PAUSE"
	@HideFromInspector property Vector2 ChargeDir = Vector2(1, 0)
	@HideFromInspector property number ChargeDistanceRemaining = 0
	@HideFromInspector property Vector2 ChargeLastPos = Vector2(0, 0)
	@HideFromInspector property number ChargeDecelTimer = 0
	@HideFromInspector property number KnockTimer = 0
	@HideFromInspector property Vector2 KnockVel = Vector2(0, 0)
	@HideFromInspector property number AggroGraceTimer = 0
	@HideFromInspector property number TouchCooldownTimer = 0
	@HideFromInspector property boolean AttackStrikePending = false
	-- LEAP 단계("WINDUP" | "FLY" 스캔 위치 점프 | "HANG" 공중 체공 | "SLAM" 수직 내려찍기)
	@HideFromInspector property string LeapPhase = "WINDUP"
	-- 착지 좌표가 확정됐는지(추적 종료). WINDUP 안에서 TelegraphLockLead 시점에 true 가 된다.
	@HideFromInspector property boolean LeapLocked = false
	@HideFromInspector property Vector2 LeapStartPos = Vector2(0, 0)
	@HideFromInspector property Vector2 LeapTargetPos = Vector2(0, 0)
	@HideFromInspector property number LeapPhaseDuration = 0
	@HideFromInspector property boolean LeapAnimHeld = false
	@HideFromInspector property boolean LeapAnimResumed = false
	@HideFromInspector property number MinionSummonTimer = 0
	@HideFromInspector property number SpawnGraceTimer = 0
	-- 플레이어를 처음 감지한 뒤에만 쿨/유예를 깎는다(맵 선스폰 보스 대응).
	@HideFromInspector property boolean EngagementStarted = false

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- Records the spawn anchor (for leashing) and starts in the idle STAND state.
		local p = self:Pos2D()
		self.SpawnPos = p
		self.ObstacleLastX = p.x
		self.ObstacleLastY = p.y
		self.ObstaclePosInit = true
		self.TelegraphOn = false
		self.EngagementStarted = false
		self.AttackCooldownTimer = 0
		self.SpawnGraceTimer = 0
		-- 첫 소환 타이머는 교전 시작 시 다시 맞춘다(선스폰 중 소진 방지).
		if self.MinionSummonInterval > 0 then
			self.MinionSummonTimer = self.MinionSummonInterval
		end
		self:EnterState("STAND")
		-- T99: 스폰 직후 자원 AABB 안에 끼면 즉시 밀어낸다.
		self:TryPushOutOfObstacles()
	end

	@ExecSpace("ServerOnly")
	method void OnEndPlay()
		-- 맵 종료/엔티티 제거 시 예고 장판이 지면에 남지 않게 정리한다.
		self:ClearTelegraphMarker()
	end

	@ExecSpace("ServerOnly")
	method void BeginEngagement()
		-- 플레이어 첫 감지 시 1회: 공격 쿨 + 스폰 유예 + 미니언 타이머 리셋.
		if self.EngagementStarted then return end
		self.EngagementStarted = true
		if self.AttackCooldown > 0 then
			self.AttackCooldownTimer = self.AttackCooldown
		end
		if self.SpawnGraceDuration > 0 then
			self.SpawnGraceTimer = self.SpawnGraceDuration
		elseif self.AttackType == "LEAP" then
			-- LEAP 보스는 모델 유예가 비어도 최소 AttackCooldown(하한 5초)
			local g = self.AttackCooldown
			if g < 5 then g = 5 end
			self.SpawnGraceTimer = g
		end
		if self.MinionSummonInterval > 0 then
			self.MinionSummonTimer = self.MinionSummonInterval
		end
		log("[MONSTER] " .. self.Entity.Name .. " engagement start CD=" .. tostring(self.AttackCooldownTimer) .. " grace=" .. tostring(self.SpawnGraceTimer))
	end

	@ExecSpace("ClientOnly")
	method void OnSyncProperty(string propertyName, any newValue)
		-- T38 텔레그래프: 서버 Color 직접 조작 금지 → @Sync 플래그로 클라 틴트.
		if propertyName ~= "TelegraphOn" then return end
		local sprite = self.Entity.SpriteRendererComponent
		if not isvalid(sprite) then return end
		if newValue == true then
			sprite.Color = Color(1.0, 0.55, 0.2, 1.0)
		else
			sprite.Color = Color(1.0, 1.0, 1.0, 1.0)
		end
	end

	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
		-- Drives the monster: death > attack-window > leash/return > chase/attack > wander.
		local monster = self:GetMonster()
		if isvalid(monster) and monster.IsDead then
			if not self.DeathPlayed then
				self.DeathPlayed = true
				self.TelegraphOn = false
				self.AttackStrikePending = false
				self:SetSpritePlayRate(1)
				self:SetSprite(self.DieRUID)
				self:StopMovement()
				-- 예고 중 사망하면 장판이 지면에 남는다 — 반드시 같이 정리한다.
				self:ClearTelegraphMarker()
			end
			return
		end
		if self.DeathPlayed then self.DeathPlayed = false end
		-- Boss phases remain uninterrupted; boss hard control is converted to a brief slow.
		if isvalid(monster) and monster:GetSkillStatus("Stun") ~= nil and self.CurrentAIState ~= "LEAP" then
			self:StopMovement()
			self.AttackStrikePending = false
			self.TelegraphOn = false
			self:ClearTelegraphMarker()
			self:EnterState("STAND")
			return
		end

		-- Knockback window: drift away from the attacker, overriding AI movement.
		if self.KnockTimer > 0 then
			self.KnockTimer = self.KnockTimer - delta
			-- LEAP 중에는 ApplyKnockback 이 넉백을 걸지 않으므로 여기 들어오지 않는다.
			-- 그래도 타이밍 경합으로 남아 있으면 장판만 정리하고 도약은 그대로 진행시킨다.
			if self.CurrentAIState == "LEAP" then
				self.KnockTimer = 0
				self.KnockVel = Vector2(0, 0)
			end
			local kb = self.Entity.KinematicbodyComponent
			if isvalid(kb) then kb.MoveVelocity = self.KnockVel end
			self.KnockVel = Vector2(self.KnockVel.x * 0.85, self.KnockVel.y * 0.85)
			return
		end

		-- 쿨/유예는 교전 시작 후에만 감소(맵 생성 시 선스폰된 보스가 쿨을 미리 소진하지 않음).
		if self.EngagementStarted then
			if self.AttackCooldownTimer > 0 then
				self.AttackCooldownTimer = self.AttackCooldownTimer - delta
			end
			if self.SpawnGraceTimer > 0 then
				self.SpawnGraceTimer = self.SpawnGraceTimer - delta
			end
		end

		-- 피격 시 갱신되는 어그로 유예 타이머 감소. 이 값이 남아 있으면 리쉬(귀환)를 보류한다.
		if self.AggroGraceTimer > 0 then
			self.AggroGraceTimer = self.AggroGraceTimer - delta
		end

		-- T38: 접촉 데미지 틱 (상시 발동하여 스폰/입장 직후 몸체 파고들기 방지)
		self:TickTouchDamage(delta)

		-- 미니언 소환 타이머(교전 시작 후에만 깎임 — 선스폰 중 30초 소진 방지)
		if self.EngagementStarted then
			self:TickMinionSummon(delta)
		end

		-- ATTACK is a short non-interruptible window (windup → strike on timer).
		-- 준비 상태(주황 틴트)에서는 전 타입 일시 정지. 대기시간은 AttackWindup(몹별 상이).
		if self.CurrentAIState == "ATTACK" then
			self.StateTimer = self.StateTimer - delta
			self:StopMovement()

			-- T38: 타격은 윈드업 만료 시점
			if self.StateTimer <= 0 then
				if self.AttackStrikePending then
					self.AttackStrikePending = false
					self.TelegraphOn = false
					if self.ProjectileModelId ~= "" then
						-- T39: 원거리 분기 — 근접 대신 투사체 발사 (텔레그래프/쿨다운 파이프라인 공유)
						self:FireProjectile()
					else
						local atk = self:GetAttack()
						if isvalid(atk) then
							if self.AttackType == "CONTACT" or self.AttackType == "MELEE_WEAPON" then
								atk:DoAttack()
							end
						end
					end
				end
				self:EnterState("STAND")
			end
			return
		end

		-- CHARGE / LEAP: 비중단 윈도우. 한번 시작하면 감지범위 밖이어도 끝까지 진행.
		if self.CurrentAIState == "CHARGE" then
			self:UpdateCharge(delta)
			return
		end
		if self.CurrentAIState == "LEAP" then
			self:UpdateLeap(delta)
			return
		end

		local myPos = self:Pos2D()

		-- T93: 활성 차단 장치 반경 안이면 보스 외 몬스터는 즉시 이탈(추격·배회보다 우선).
		if self:TryFleeAvoidZone(myPos, delta) then
			return
		end

		-- 타겟/거리 선계산 (귀환 재교전 판정과 추적 판정이 공유).
		local target = self:FindNearestPlayer()
		local hasTarget = isvalid(target)
		local tp = nil
		local dSq = 0
		if hasTarget then
			tp = self:EntityPos2D(target)
			tp = self:ClampChaseTargetOutsideAvoid(myPos, tp)
			dSq = self:DistSq(myPos, tp)
		end
		local distSpawnSq = self:DistSq(myPos, self.SpawnPos)
		local beyondLeash = distSpawnSq > self.LeashRange * self.LeashRange
		local aggroActive = self.AggroGraceTimer > 0
		local playerDetected = hasTarget and dSq <= self.DetectRange * self.DetectRange
		local atkRangeSq = self.AttackRange * self.AttackRange
		local stopSq = self.StopDistance * self.StopDistance

		-- RETURN: 스폰으로 복귀하되, 복귀 도중이라도 (리쉬 안쪽에서 플레이어를 다시 감지)하거나
		-- (방금 피격당해 어그로 유예가 살아있으면) 즉시 추적으로 전환해 무시하지 않도록 한다.
		if self.CurrentAIState == "RETURN" then
			if (playerDetected and not beyondLeash) or (aggroActive and hasTarget) then
				self:EnterState("CHASE")
				-- 아래 추적 로직으로 계속 진행 (return 하지 않음)
			else
				self:MoveTowardScaled(self.SpawnPos, delta, self.ReturnSpeedMultiplier)
				if distSpawnSq <= 0.25 then
					self:EnterState("STAND")
				end
				return
			end
		end

		-- Leash: 스폰에서 LeashRange 이상 벗어났고, 어그로 유예도 없을 때만 귀환을 시작한다.
		-- (피격 직후에는 리쉬를 보류해 끝까지 추적/반격한다.)
		if beyondLeash and not aggroActive then
			self:EnterState("RETURN")
			self:MoveTowardScaled(self.SpawnPos, delta, self.ReturnSpeedMultiplier)
			return
		end

		-- Player-driven behaviour — AttackRange 단일 기준 (T38, 리터럴 0.81 제거)
		if hasTarget and (playerDetected or aggroActive) then
			-- 첫 감지 시 쿨/유예 시작(선스폰 보스가 입장 전에 쿨을 소진하지 않도록)
			self:BeginEngagement()
			if dSq <= atkRangeSq then
				self:Face(tp.x - myPos.x)
				if self.AttackCooldownTimer <= 0 and self.SpawnGraceTimer <= 0 then
					if self.AttackType == "CHARGE" then
						self:EnterState("CHARGE")
					elseif self.AttackType == "LEAP" then
						self:EnterState("LEAP")
					else
						self:EnterState("ATTACK")
					end
				else
					-- 쿨 중: 굳지 않고 계속 추적(StopDistance 이내만 정지) — 보스 LEAP 여유 패턴
					if self.CurrentAIState ~= "CHASE" then self:EnterState("CHASE") end
					if dSq <= stopSq then
						self:StopMovement()
					else
						self:MoveToward(tp, delta)
					end
				end
				return
			else
				if self.CurrentAIState ~= "CHASE" then self:EnterState("CHASE") end
				if dSq <= stopSq then
					self:StopMovement()
				else
					self:MoveToward(tp, delta)
				end
				return
			end
		end

		-- 추적 중 타겟을 놓친 경우(감지범위 밖으로 벗어남 + 어그로 유예 소멸): 제자리에서 배회로 굳어버리지
		-- 않도록 곧바로 귀환을 시작한다 (T-chase-return: 빠른 원위치 복귀).
		if self.CurrentAIState == "CHASE" then
			self:EnterState("RETURN")
			self:MoveTowardScaled(self.SpawnPos, delta, self.ReturnSpeedMultiplier)
			return
		end

		-- Idle: alternate WANDER and STAND on a timer.
		self:TickWander(delta)
	end

	@ExecSpace("ServerOnly")
	method boolean IsAirborne()
		-- LEAP 비행/체공/내려찍기 구간 여부. 이 동안은 몸이 공중에 있다.
		if self.CurrentAIState ~= "LEAP" then return false end
		return self.LeapPhase == "FLY" or self.LeapPhase == "HANG" or self.LeapPhase == "SLAM"
	end

	@ExecSpace("ServerOnly")
	method boolean IsSlamCommitted()
		-- 착지 좌표 확정(WINDUP 후반) ~ 착지까지의 구간. 접촉 틱을 멈춰야 하는 창이다.
		-- 🔴 규칙 44: 플레이어 i-frame(0.4초)보다 짧은 주기의 접촉 틱이 착지 직전에 들어가면
		--    정작 광역타가 i-frame 에 막혀 조용히 사라진다. 공중 구간만 막으면 그 합이 0.4초에
		--    근접할 때 다시 새므로, "확정 이후" 전체를 무접촉 창으로 잡아 여유를 확보한다.
		if self.CurrentAIState ~= "LEAP" then return false end
		if self:IsAirborne() then return true end
		return self.LeapPhase == "WINDUP" and self.LeapLocked
	end

	@ExecSpace("ServerOnly")
	method void TickTouchDamage(number delta)
		-- T38: TouchRadius 내 최근접 플레이어에 주기 접촉 데미지 (i-frame에 연타 억제 위임)
		-- ⚠ 착지 좌표 확정 시점부터 착지까지는 접촉 틱을 멈춘다(규칙 44). 플레이어 i-frame 이
		--   0.4초인데 접촉 틱이 그보다 잦으면, 착지 직전에 소모된 i-frame 때문에 정작 광역타가
		--   조용히 씹힌다. 예고 앞부분(추적 구간)과 그 외 지상 구간에서는 그대로 돌기 때문에
		--   규칙 42의 파고들기 방지와도 충돌하지 않는다.
		if self:IsSlamCommitted() then return end
		local atk = self:GetAttack()
		if not isvalid(atk) then return end
		if self.TouchCooldownTimer > 0 then
			self.TouchCooldownTimer = self.TouchCooldownTimer - delta
			return
		end
		local target = self:FindNearestPlayer()
		if not isvalid(target) then return end
		local tp = self:EntityPos2D(target)

		-- 접촉 판정 = 실제 콜라이더 박스(+여유). 보이는 몸통과 판정이 일치한다.
		local box = self:GetTouchBox()
		local dx = tp.x - box.cx
		local dy = tp.y - box.cy
		if dx < 0 then dx = -dx end
		if dy < 0 then dy = -dy end
		if dx <= box.halfX and dy <= box.halfY then
			atk:DoTouchAttackBox(Vector2(box.cx, box.cy), Vector2(box.halfX * 2, box.halfY * 2))
			local interval = atk.TouchTickInterval
			if interval == nil or interval <= 0 then interval = 0.35 end
			self.TouchCooldownTimer = interval
		end
	end

	@ExecSpace("ServerOnly")
	method table GetTouchBox()
		-- 접촉 판정 박스를 HitComponent 실물에서 산출한다 → { cx, cy, halfX, halfY }.
		-- 🔴 규칙 14: 엔진이 쓰는 실제 콜라이더는 BoxSize / ColliderOffset 에 Transform.Scale 이
		--    곱해진 값이다. Scale 을 빼먹으면 큰 몹일수록 판정이 실물보다 작아진다.
		--    실측(슬라임킹): BoxSize 3.4×2.4 × Scale 2.8 = 월드 9.52×6.72 (반폭 4.76/3.36),
		--    ColliderOffset (0,1) × 2.8 = 원점보다 2.8 위가 몸통 중심.
		--    구형은 원점 기준 반지름 1.8 원이라, 몸통 좌우 끝(±4.76)에 붙어 서면 판정 밖이었다
		--    ("가까이 붙어도 충돌 데미지가 안 들어온다"의 원인).
		local p = self:Pos2D()
		local cx = p.x
		local cy = p.y
		local fallback = self.TouchFallbackHalfExtent
		if fallback <= 0 then fallback = 0.55 end
		local halfX = fallback
		local halfY = fallback

		local hit = self.Entity.HitComponent
		local t = self.Entity.TransformComponent
		if isvalid(hit) and isvalid(t) then
			local sx = t.Scale.x
			local sy = t.Scale.y
			if sx < 0 then sx = -sx end
			if sy < 0 then sy = -sy end
			if sx <= 0.0001 then sx = 1 end
			if sy <= 0.0001 then sy = 1 end
			halfX = hit.BoxSize.x * sx * 0.5
			halfY = hit.BoxSize.y * sy * 0.5
			cx = cx + hit.ColliderOffset.x * sx
			cy = cy + hit.ColliderOffset.y * sy
		end

		local m = self.TouchMargin
		if m < 0 then m = 0 end
		halfX = halfX + m
		halfY = halfY + m

		-- 데이터 주도 하한: 모델이 TouchRadius 를 주면 그 값을 최소 반폭으로 보장한다
		-- (콜라이더가 스프라이트보다 작게 잡힌 몹의 보정용).
		local atk = self:GetAttack()
		if isvalid(atk) and atk.TouchRadius > 0 then
			if halfX < atk.TouchRadius then halfX = atk.TouchRadius end
			if halfY < atk.TouchRadius then halfY = atk.TouchRadius end
		end

		return { cx = cx, cy = cy, halfX = halfX, halfY = halfY }
	end

	@ExecSpace("ServerOnly")
	method void FireProjectile()
		-- T39: ProjectileModelId 모델을 스폰해 최근접 플레이어 방향으로 발사.
		-- 모델명 → 모델 ID 해석(_EntryService) 후 원문 폴백 — MonsterSpawner와 동일 패턴.
		-- parent는 CurrentMap(8대 규칙 4 — nil 금지). 수치는 전부 프로퍼티(코드 리터럴 0).
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return end
		local target = self:FindNearestPlayer()
		if not isvalid(target) then return end
		local myPos = self:Pos2D()
		local tp = self:EntityPos2D(target)
		local dir = Vector2(tp.x - myPos.x, tp.y - myPos.y)
		self:Face(dir.x)
		local modelId = _EntryService:GetModelIdByName(self.ProjectileModelId)
		if modelId == nil or modelId == "" then
			modelId = self.ProjectileModelId
		end
		local proj = _SpawnService:SpawnByModelId(modelId, "Projectile_" .. self.Entity.Name, Vector3(myPos.x, myPos.y, 0), map)
		if not isvalid(proj) then
			log_warning("[MONSTER] projectile model spawn failed: " .. self.ProjectileModelId)
			return
		end
		---@type MonsterProjectile
		local pc = proj:GetComponent("script.MonsterProjectile")
		if not isvalid(pc) then
			log_warning("[MONSTER] script.MonsterProjectile missing on model: " .. self.ProjectileModelId)
			proj:Destroy()
			return
		end
		pc:Fire(self.Entity, dir, self.ProjectileDamage, self.ProjectileSpeed, self.ProjectileHitRadius, self.ProjectileLifeTime)
		log("[MONSTER] projectile fired by " .. self.Entity.Name)
	end

	@ExecSpace("ServerOnly")
	method void TickWander(number delta)
		-- Random-walk while WANDER, pause while STAND, swap when the state timer expires.
		self.StateTimer = self.StateTimer - delta
		if self.CurrentAIState == "WANDER" then
			self:MoveDirVec(self.MoveDir, delta)
			if self.StateTimer <= 0 then self:EnterState("STAND") end
		else
			if self.CurrentAIState ~= "STAND" then self:EnterState("STAND") end
			if self.StateTimer <= 0 then self:EnterState("WANDER") end
		end
	end

	@ExecSpace("ServerOnly")
	method void EnterState(string newState)
		-- Centralizes per-state setup: sprite swap, timers, and one-shot side effects.
		-- LEAP 이 아닌 상태로 나가는 모든 경로(리쉬 귀환·갇힘 탈출·추적 복귀 등)에서 예고 장판을
		-- 반드시 회수한다. LEAP 진입 시에는 SpawnTelegraphMarker 가 먼저 정리하므로 중복이 없다.
		if newState ~= "LEAP" then
			self:ClearTelegraphMarker()
		end
		self.CurrentAIState = newState
		if newState == "STAND" then
			self.TelegraphOn = false
			self.AttackStrikePending = false
			self.StateTimer = self.StandMin + _UtilLogic:RandomDouble() * (self.StandMax - self.StandMin)
			self:SetSprite(self.StandRUID)
			self:StopMovement()
		elseif newState == "WANDER" then
			self.TelegraphOn = false
			local ang = _UtilLogic:RandomDouble() * 6.2831853
			self.MoveDir = Vector2(math.cos(ang), math.sin(ang))
			self.StateTimer = self.WanderMin + _UtilLogic:RandomDouble() * (self.WanderMax - self.WanderMin)
			self:SetSprite(self.MoveRUID)
		elseif newState == "CHASE" or newState == "RETURN" then
			self.TelegraphOn = false
			self:SetSprite(self.MoveRUID)
		elseif newState == "ATTACK" then
			-- 진입 시 즉시 타격 금지 → 정지 윈드업 텔레그래프 후 만료 시 타격
			self.StateTimer = self.AttackWindup
			self.AttackCooldownTimer = self.AttackCooldown
			self.AttackStrikePending = true
			self.TelegraphOn = true
			self:SetSprite(self.AttackRUID)
			self:StopMovement()
		elseif newState == "CHARGE" then
			-- 정지 텔레그래프(PAUSE) → 유저 거리만큼 DASH → DECEL 감속 정지
			-- 쿨타임은 돌진 "종료" 시 EndCharge에서 건다(시작 시 걸면 돌진 중 소진되어 연속 돌진됨).
			self.ChargePhase = "PAUSE"
			self.ChargeDecelTimer = 0
			self.StateTimer = self.AttackWindup
			self.TelegraphOn = true
			self:SetSprite(self.AttackRUID)
			self:StopMovement()
		elseif newState == "LEAP" then
			-- 코어키퍼식 도약: 지면 예고(장판 추적 → 좌표 확정) → FLY → HANG → SLAM. 쿨은 EndLeap.
			-- 장판은 예고 앞부분 동안 플레이어를 따라다니다가, 착지까지 LeapReactionWindow 만 남는
			-- 순간에 좌표가 확정된다. 그래야 "예고를 보고 반응"해야 피할 수 있다 —
			-- 예고 시작에 고정하면 예고 전체가 회피 시간이라 걷기만 해도 빠져나간다.
			self.LeapPhase = "WINDUP"
			self.LeapPhaseDuration = self.AttackWindup
			self.StateTimer = self.AttackWindup
			self.LeapLocked = false
			self.LeapStartPos = self:Pos2D()
			self.LeapTargetPos = self:ResolveLeapTarget(self.LeapStartPos)
			self.LeapAnimHeld = false
			self.LeapAnimResumed = false
			self.TelegraphOn = true
			self:SetSprite(self.AttackRUID)
			self:SetSpritePlayRate(1)
			self:StopMovement()
			self:Face(self.LeapTargetPos.x - self.LeapStartPos.x)
			-- 채움 원이 "확정까지 남은 시간"을 나타내도록 추적 구간 예상 길이를 넘긴다.
			local trackDur = self:LeapTrackSeconds()
			self:SpawnTelegraphMarker(self.LeapTargetPos, trackDur)
			if trackDur <= 0 then
				-- 이미 사거리가 멀어 예고 전체가 반응 시간에 못 미치는 경우 즉시 확정한다.
				self:LockLeapTarget()
			end
		end
	end

	@ExecSpace("ServerOnly")
	method Vector2 ResolveLeapTarget(Vector2 startPos)
		-- 착지 좌표를 1회 확정한다. 최근접 플레이어 방향으로 LeapLandingFraction 만큼 나아간 지점.
		local target = self:FindNearestPlayer()
		if not isvalid(target) then return startPos end
		local scan = self:EntityPos2D(target)
		local frac = self.LeapLandingFraction
		if frac < 0.1 then frac = 0.1 end
		if frac > 1.0 then frac = 1.0 end
		return Vector2(
			startPos.x + (scan.x - startPos.x) * frac,
			startPos.y + (scan.y - startPos.y) * frac
		)
	end

	@ExecSpace("ServerOnly")
	method number EstimateLeapFlySeconds(Vector2 from, Vector2 to)
		-- 예상 비행 시간. BeginLeapFlight 의 산출식과 동일해야 확정 타이밍이 어긋나지 않는다.
		local dist = math.sqrt(self:DistSq(from, to))
		local mc = self.Entity.MovementComponent
		local base = 1.0
		if isvalid(mc) and mc.InputSpeed > 0 then base = mc.InputSpeed end
		local div = self.RectTileSpeedDivisor
		if div <= 0 then div = 1.2 end
		local speed = base * self.LeapSpeedMultiplier / div
		if speed < 0.1 then speed = 0.1 end
		local flyDur = dist / speed
		local maxDur = self.LeapRiseDuration * 2
		if maxDur < 0.1 then maxDur = 0.1 end
		if flyDur < 0.08 then flyDur = 0.08 end
		if flyDur > maxDur then flyDur = maxDur end
		return flyDur
	end

	@ExecSpace("ServerOnly")
	method number EstimateLeapImpactDelay(Vector2 from, Vector2 to)
		-- 지금 도약을 시작한다고 가정했을 때 착지까지 걸리는 시간 = 비행 + 체공 + 내려찍기.
		local hang = self.LeapHangDuration
		if hang < 0.05 then hang = 0.05 end
		local slam = self.LeapSlamDuration
		if slam < 0.05 then slam = 0.05 end
		return self:EstimateLeapFlySeconds(from, to) + hang + slam
	end

	@ExecSpace("ServerOnly")
	method number LeapTrackSeconds()
		-- 장판이 플레이어를 추적하는 구간의 예상 길이(초). 마커 채움 연출용 초기값으로만 쓴다
		-- (실제 확정 시점은 매 프레임 EstimateLeapImpactDelay 로 다시 판정한다).
		local w = self.AttackWindup
		if w < 0 then w = 0 end
		local lead = self.LeapReactionWindow - self:EstimateLeapImpactDelay(self:Pos2D(), self.LeapTargetPos)
		if lead < 0 then lead = 0 end
		if lead > w then lead = w end
		return w - lead
	end

	@ExecSpace("ServerOnly")
	method void LockLeapTarget()
		-- 착지 좌표 확정. 이후 장판은 움직이지 않고 링이 점멸해 "지금 피하라"를 알린다.
		if self.LeapLocked then return end
		self.LeapLocked = true
		self:CommitTelegraphMarker()
		log("[BOSS][LEAP] target locked (" .. tostring(self.LeapTargetPos.x) .. "," .. tostring(self.LeapTargetPos.y) .. ")")
	end

	@ExecSpace("ServerOnly")
	method void MoveTelegraphMarker(Vector2 pos)
		-- 추적 구간에서 장판을 옮긴다. Body 없는 데코 엔티티라 Transform 직접 대입이 허용된다.
		local marker = self._T.telegraphMarker
		if marker == nil then return end
		if not isvalid(marker) then return end
		local t = marker.TransformComponent
		if not isvalid(t) then return end
		t.WorldPosition = Vector3(pos.x, pos.y, t.WorldPosition.z)
	end

	@ExecSpace("ServerOnly")
	method void EndCharge()
		-- 돌진 종료: 완전 정지 + 회복 쿨 시작(다음 CHARGE까지 AttackCooldown 대기).
		self:StopMovement()
		self.AttackCooldownTimer = self.AttackCooldown
		self:EnterState("STAND")
	end

	@ExecSpace("ServerOnly")
	method void UpdateCharge(number delta)
		-- CHARGE: PAUSE(정지 텔레그래프) → DASH(시작 시 유저 거리·고정 방향 전속) → DECEL(감속 정지).
		-- DASH/DECEL 방향은 시작 시점에 고정되어 재조준하지 않으므로 옆으로 피할 수 있다.
		if self.ChargePhase == "PAUSE" then
			self.StateTimer = self.StateTimer - delta
			self:StopMovement()
			if self.StateTimer <= 0 then
				local target = self:FindNearestPlayer()
				local myPos = self:Pos2D()
				local dir = self.MoveDir
				local distToTarget = self.AttackRange
				if isvalid(target) then
					local tp = self:EntityPos2D(target)
					local dx = tp.x - myPos.x
					local dy = tp.y - myPos.y
					local len = math.sqrt(dx * dx + dy * dy)
					if len > 0.0001 then
						dir = Vector2(dx / len, dy / len)
						distToTarget = len
					end
				end
				-- 최소 한 걸음은 나가도록 하되, 고정 overshoot 배율은 쓰지 않는다.
				if distToTarget < 0.35 then distToTarget = 0.35 end
				self.ChargeDir = dir
				self.ChargeDistanceRemaining = distToTarget
				self.ChargeLastPos = myPos
				self.ChargePhase = "DASH"
				self.StateTimer = self.ChargeMaxDuration
				self.TelegraphOn = false
			end
			return
		end

		self.StateTimer = self.StateTimer - delta
		local cur = self:Pos2D()
		-- MoveToDirection은 같은 프레임에 Transform에 즉시 반영되지 않으므로,
		-- 직전 프레임 이동 결과를 이번 프레임 시작 시점에 측정해 소진 거리에 반영한다.
		local movedSinceLast = math.sqrt(self:DistSq(self.ChargeLastPos, cur))
		self.ChargeLastPos = cur

		if self.ChargePhase == "DASH" then
			self.ChargeDistanceRemaining = self.ChargeDistanceRemaining - movedSinceLast
			if self.StateTimer <= 0 then
				self:EndCharge()
				return
			end
			if self.ChargeDistanceRemaining <= 0 then
				self.ChargePhase = "DECEL"
				self.ChargeDecelTimer = 0
			else
				self:MoveTowardScaled(Vector2(cur.x + self.ChargeDir.x, cur.y + self.ChargeDir.y), delta, self.ChargeSpeedMultiplier)
				return
			end
		end

		-- DECEL: 전속 이후 남은 관성만 감속하며 멈춘다 (고정 추가 거리 없음).
		if self.ChargePhase == "DECEL" then
			self.ChargeDecelTimer = self.ChargeDecelTimer + delta
			local decelDur = self.ChargeDecelDuration
			if decelDur < 0.05 then decelDur = 0.05 end
			if self.ChargeDecelTimer >= decelDur or self.StateTimer <= 0 then
				self:EndCharge()
				return
			end
			local t = self.ChargeDecelTimer / decelDur
			if t < 0 then t = 0 end
			if t > 1 then t = 1 end
			-- 초반엔 빠르고 끝으로 갈수록 더 크게 줄어드는 ease-out 감속
			local ease = 1.0 - t
			ease = ease * ease
			local speedMul = self.ChargeSpeedMultiplier * ease
			if speedMul < 0.05 then
				self:EndCharge()
				return
			end
			self:MoveTowardScaled(Vector2(cur.x + self.ChargeDir.x, cur.y + self.ChargeDir.y), delta, speedMul)
		end
	end

	@ExecSpace("ServerOnly")
	method void SpawnTelegraphMarker(Vector2 pos, number fillSeconds)
		-- 착지 예고 장판을 착지 예정 좌표에 띄운다.
		-- 링 반지름은 SlamRadius 하나에서 나오고 같은 값이 판정 원에도 쓰인다 = 보이는 원이 맞는 원.
		self:ClearTelegraphMarker()
		if self.TelegraphModelId == nil or self.TelegraphModelId == "" then return end
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return end
		-- 모델명 → 모델 ID 해석 후 원문 폴백 (FireProjectile / MonsterSpawner 와 동일 패턴).
		local modelId = _EntryService:GetModelIdByName(self.TelegraphModelId)
		if modelId == nil or modelId == "" then
			modelId = self.TelegraphModelId
		end
		local marker = _SpawnService:SpawnByModelId(modelId, "Telegraph_" .. self.Entity.Name, Vector3(pos.x, pos.y, 0), map)
		if not isvalid(marker) then
			log_warning("[BOSS][TELEGRAPH] marker model spawn failed: " .. self.TelegraphModelId)
			return
		end
		---@type MonsterTelegraphMarker
		local mk = marker:GetComponent("script.MonsterTelegraphMarker")
		local spriteRadius = 1.0
		if isvalid(mk) then
			mk.FillSeconds = fillSeconds
			mk.Committed = false
			if mk.SpriteRadius > 0 then spriteRadius = mk.SpriteRadius end
		else
			log_warning("[BOSS][TELEGRAPH] script.MonsterTelegraphMarker missing on model: " .. self.TelegraphModelId)
		end
		-- Body 없는 데코 엔티티이므로 Transform 직접 대입이 허용된다(platform.md §11).
		local t = marker.TransformComponent
		if isvalid(t) then
			local s = self.SlamRadius / spriteRadius
			if s <= 0 then s = 1 end
			t.Scale = Vector3(s, s, 1)
		end
		self._T.telegraphMarker = marker
		log("[BOSS][TELEGRAPH] marker at (" .. tostring(pos.x) .. "," .. tostring(pos.y) .. ") r=" .. tostring(self.SlamRadius))
	end

	@ExecSpace("ServerOnly")
	method void CommitTelegraphMarker()
		-- 도약 개시를 마커에 알린다 — 채움 100% 고정 + 링 점멸("착지 임박").
		local marker = self._T.telegraphMarker
		if marker == nil then return end
		if not isvalid(marker) then return end
		---@type MonsterTelegraphMarker
		local mk = marker:GetComponent("script.MonsterTelegraphMarker")
		if isvalid(mk) then mk.Committed = true end
	end

	@ExecSpace("ServerOnly")
	method void ClearTelegraphMarker()
		-- 마커 제거. 착지·피격 중단·사망·리스폰 등 모든 종료 경로에서 호출해 장판이 남지 않게 한다.
		local marker = self._T.telegraphMarker
		self._T.telegraphMarker = nil
		if marker == nil then return end
		if not isvalid(marker) then return end
		marker:Destroy()
	end

	@ExecSpace("Multicast")
	method void MulticastImpactFX(Vector3 pos, number radius)
		-- 착지 충격 연출: 원형 충격파 파티클 + 카메라 흔들림. 클라에서만 재생한다.
		-- ⚠ 규칙 12 — instigator 에 nil 을 넘기면 클라 생성이 에러 없이 실패(serial=0)한다.
		if not self:IsClient() then return end
		-- Multicast 는 월드 인스턴스의 전 클라에 도달한다. 다른 맵에 있는 플레이어까지
		-- 화면이 흔들리고 엉뚱한 좌표에 파티클이 생기지 않도록 같은 맵만 통과시킨다.
		local localPlayer = _UserService.LocalPlayer
		local myMap = self.Entity.CurrentMap
		if isvalid(localPlayer) and isvalid(myMap) then
			if localPlayer.CurrentMap ~= myMap then return end
		end
		local s = radius * self.ImpactParticleScale
		if s <= 0 then s = 1 end
		local serial = _ParticleService:PlayBasicParticle(
			BasicParticleType.DustExplosion, self.Entity, pos, 0.0, Vector3(s, s, s), false, nil)
		log("[BOSS][SLAM] impact fx serial=" .. tostring(serial))
		if self.ImpactShakeIntensity > 0 and self.ImpactShakeDuration > 0 then
			local cam = _CameraService:GetCurrentCameraComponent()
			if isvalid(cam) then
				cam:ShakeCamera(self.ImpactShakeIntensity, self.ImpactShakeDuration)
			end
		end
	end

	@ExecSpace("ServerOnly")
	method void EndLeap()
		-- 착지 타격: 판정 원의 중심은 마커를 찍은 좌표 그대로다.
		-- 벽 등에 막혀 크게 못 미쳤을 때만 1회 스냅해, 몸이 자기 장판 밖에 서는 상황을 막는다.
		-- (구형은 매 프레임 SetWorldPosition 으로 날아간 뒤 착지에서 또 스냅해 "순간이동"으로 보였다.)
		local landing = self.LeapTargetPos
		local cur = self:Pos2D()
		local tol = self.LeapArriveTolerance
		if tol <= 0 then tol = 0.35 end
		if self:DistSq(cur, landing) > tol * tol then
			self:SetBodyPosition(landing.x, landing.y)
		end
		self.TelegraphOn = false
		self.LeapAnimHeld = false
		self.LeapAnimResumed = false
		-- 프레임 범위 복구 후 기본 재생
		local sprite = self.Entity.SpriteRendererComponent
		if isvalid(sprite) then
			sprite.StartFrameIndex = 0
			sprite.EndFrameIndex = 2147483647
			sprite.PlayRate = 1
		end
		self:StopMovement()
		self:ClearTelegraphMarker()

		local atk = self:GetAttack()
		if isvalid(atk) then
			atk:DoSlamAttack(landing, self.SlamRadius)
			-- 착지 직후 접촉 틱이 곧바로 겹쳐 광역타의 손맛을 덮지 않도록 한 박자 늦춘다.
			local iv = atk.TouchTickInterval
			if iv == nil or iv <= 0 then iv = 0.35 end
			self.TouchCooldownTimer = iv
		end
		self:MulticastImpactFX(Vector3(landing.x, landing.y, 0), self.SlamRadius)

		self.AttackCooldownTimer = self.AttackCooldown
		self:EnterState("STAND")
	end

	@ExecSpace("ServerOnly")
	method void SetSpriteAirHold()
		-- FLY/HANG: 공격 클립의 공중 프레임으로 고정(PlayRate=0).
		local sprite = self.Entity.SpriteRendererComponent
		if not isvalid(sprite) then return end
		if self.AttackRUID ~= nil and self.AttackRUID ~= "" then
			sprite.SpriteRUID = self.AttackRUID
		end
		local f = self.LeapAirFrameIndex
		if f < 0 then f = 0 end
		sprite.StartFrameIndex = f
		sprite.EndFrameIndex = f
		sprite.PlayRate = 0
		self.LeapAnimHeld = true
	end

	@ExecSpace("ServerOnly")
	method void SetSpriteFallResume()
		-- SLAM: 공중 프레임부터 나머지를 빠르게 재생.
		local sprite = self.Entity.SpriteRendererComponent
		if not isvalid(sprite) then return end
		local f = self.LeapAirFrameIndex
		if f < 0 then f = 0 end
		sprite.StartFrameIndex = f
		sprite.EndFrameIndex = 2147483647
		local fallRate = self.LeapAnimFallPlayRate
		if fallRate < 0.1 then fallRate = 1.0 end
		sprite.PlayRate = fallRate
		self.LeapAnimResumed = true
	end

	@ExecSpace("ServerOnly")
	method void BeginLeapFlight()
		-- 예고 종료 → 도약 개시. 비행 시간을 거리/속도로 산출해 도착과 연출이 어긋나지 않게 한다.
		-- 고정 시간으로 먼 거리를 덮으면 프레임당 이동량이 폭증해 순간이동처럼 보인다.
		local start = self:Pos2D()
		self.LeapStartPos = start
		-- 정상 흐름이라면 WINDUP 중 이미 확정됐다. 안전망으로 한 번 더 호출한다(멱등).
		self:LockLeapTarget()
		self:Face(self.LeapTargetPos.x - start.x)
		self:SetSpriteAirHold()

		local dist = math.sqrt(self:DistSq(start, self.LeapTargetPos))
		local mc = self.Entity.MovementComponent
		local base = 1.0
		if isvalid(mc) and mc.InputSpeed > 0 then base = mc.InputSpeed end
		local div = self.RectTileSpeedDivisor
		if div <= 0 then div = 1.2 end
		local speed = base * self.LeapSpeedMultiplier / div
		if speed < 0.1 then speed = 0.1 end
		local flyDur = dist / speed
		local maxDur = self.LeapRiseDuration * 2
		if maxDur < 0.1 then maxDur = 0.1 end
		if flyDur < 0.08 then flyDur = 0.08 end
		if flyDur > maxDur then flyDur = maxDur end

		-- RectTile 의 점프는 시각 전용(높이 변화 없음)이라 이동/충돌에 영향이 없다.
		-- 그림자가 함께 생겨 "지금 공중에 있고 저기로 떨어진다"가 읽힌다.
		if isvalid(mc) then mc:Jump() end

		self.LeapPhase = "FLY"
		self.LeapPhaseDuration = flyDur
		self.StateTimer = flyDur
		self.TelegraphOn = false
		log("[BOSS][LEAP] fly dist=" .. tostring(dist) .. " dur=" .. tostring(flyDur))
	end

	@ExecSpace("ServerOnly")
	method void UpdateLeap(number delta)
		-- LEAP (회피 가능, 궤적 고정 — 코어키퍼식 도약):
		-- WINDUP: 착지점 확정 + 장판 표시 후 제자리 예고 (여기가 플레이어의 회피 시간)
		-- FLY   : MoveToDirection 으로 실제 비행 (프레임 단위 좌표 스냅 금지)
		-- HANG  : 착지점 상공 체공
		-- SLAM  : 수직 내려찍기 → 착지 광역 타격
		if self.LeapPhase == "WINDUP" then
			self.StateTimer = self.StateTimer - delta
			self:StopMovement()
			if not self.LeapLocked then
				local myPos = self:Pos2D()
				-- 지금 확정하면 착지까지 남는 총 시간 = 남은 예고 + 비행 + 체공 + 내려찍기.
				-- 이 값이 LeapReactionWindow 이하로 떨어지는 순간이 확정 시점이다 → 거리와 무관하게
				-- 회피 여유가 일정해진다(멀리서 뛰면 비행이 길어지므로 그만큼 일찍 확정된다).
				local untilImpact = self.StateTimer + self:EstimateLeapImpactDelay(myPos, self.LeapTargetPos)
				if untilImpact <= self.LeapReactionWindow then
					self:LockLeapTarget()
				else
					-- 추적 구간: 장판과 시선이 플레이어를 따라간다.
					local tracked = self:ResolveLeapTarget(myPos)
					self.LeapTargetPos = tracked
					self:MoveTelegraphMarker(tracked)
					self:Face(tracked.x - myPos.x)
				end
			end
			if self.StateTimer <= 0 then
				self:BeginLeapFlight()
			end
			return
		end

		if self.LeapPhase == "FLY" then
			self.StateTimer = self.StateTimer - delta
			self:SetSpriteAirHold()
			local cur = self:Pos2D()
			local tol = self.LeapArriveTolerance
			if tol <= 0 then tol = 0.35 end
			local arrived = self:DistSq(cur, self.LeapTargetPos) <= tol * tol
			if arrived or self.StateTimer <= 0 then
				self:StopMovement()
				self:SetSpriteAirHold()
				self.LeapPhase = "HANG"
				local hangDur = self.LeapHangDuration
				if hangDur < 0.05 then hangDur = 0.05 end
				self.LeapPhaseDuration = hangDur
				self.StateTimer = hangDur
				return
			end
			-- 실제 이동이라 장애물 슬라이드와 위치 동기가 그대로 살아 있다.
			self:MoveTowardScaled(self.LeapTargetPos, delta, self.LeapSpeedMultiplier)
			return
		end

		if self.LeapPhase == "HANG" then
			self.StateTimer = self.StateTimer - delta
			self:StopMovement()
			self:SetSpriteAirHold()
			if self.StateTimer <= 0 then
				self.LeapPhase = "SLAM"
				self:SetSpriteFallResume()
				local slamDur = self.LeapSlamDuration
				if slamDur < 0.05 then slamDur = 0.05 end
				self.LeapPhaseDuration = slamDur
				self.StateTimer = slamDur
			end
			return
		end

		if self.LeapPhase == "SLAM" then
			self.StateTimer = self.StateTimer - delta
			self:StopMovement()
			if self.StateTimer <= 0 then
				self:EndLeap()
			end
		end
	end

	@ExecSpace("ServerOnly")
	method void TickMinionSummon(number delta)
		-- 교전 중 주기적으로 일반 몹을 원형으로 소환. LEAP/CHARGE/ATTACK/스폰유예 중엔 발동만 미룸.
		if self.MinionSummonInterval <= 0 then return end
		if self.MinionModelId == nil or self.MinionModelId == "" then return end
		if self.MinionSummonTimer > 0 then
			self.MinionSummonTimer = self.MinionSummonTimer - delta
		end
		if self.MinionSummonTimer > 0 then return end
		if self.SpawnGraceTimer > 0 then return end
		if self.CurrentAIState == "LEAP" or self.CurrentAIState == "CHARGE" or self.CurrentAIState == "ATTACK" then
			return
		end
		-- 주변에 플레이어가 있을 때만(감지/어그로)
		local target = self:FindNearestPlayer()
		if not isvalid(target) then return end
		local myPos = self:Pos2D()
		local tp = self:EntityPos2D(target)
		local dSq = self:DistSq(myPos, tp)
		local inFight = dSq <= self.DetectRange * self.DetectRange or self.AggroGraceTimer > 0
		if not inFight then return end
		self:SummonMinions()
		self.MinionSummonTimer = self.MinionSummonInterval
	end

	@ExecSpace("ServerOnly")
	method void SummonMinions()
		-- MinionModelId 모델을 사방에 뿌리듯 스폰. 리스폰 비활성(보스 전용 소환물).
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return end
		local count = self.MinionSummonCount
		if count < 1 then return end
		local modelId = _EntryService:GetModelIdByName(self.MinionModelId)
		if modelId == nil or modelId == "" then
			modelId = self.MinionModelId
		end
		local center = self:Pos2D()
		local radius = self.MinionSummonRadius
		if radius < 0.5 then radius = 0.5 end
		local spawned = 0
		for i = 1, count do
			local ang = ((i - 1) / count) * 6.2831853 + _UtilLogic:RandomDouble() * 0.35
			local r = radius * (0.65 + _UtilLogic:RandomDouble() * 0.45)
			local x = center.x + math.cos(ang) * r
			local y = center.y + math.sin(ang) * r
			local name = "Minion_" .. self.MinionModelId .. "_" .. tostring(i) .. "_" .. tostring(math.floor(_UtilLogic.ElapsedSeconds * 1000) % 100000)
			local ent = _SpawnService:SpawnByModelId(modelId, name, Vector3(x, y, 0), map)
			if isvalid(ent) then
				---@type Monster
				local m = ent:GetComponent("script.Monster")
				if isvalid(m) then
					m.MonsterId = self.MinionModelId
					m.RespawnOn = false
					m.Hp = m.MaxHp
				end
				spawned = spawned + 1
			end
		end
		log("[MONSTER] " .. self.Entity.Name .. " summoned " .. tostring(spawned) .. "x " .. self.MinionModelId)
	end

	@ExecSpace("ServerOnly")
	method void SetBodyPosition(number x, number y)
		-- 내려찍기 궤적용 월드 좌표 스냅(스크립트 연출 구간). 연속 추적용 아님.
		local kb = self.Entity.KinematicbodyComponent
		if isvalid(kb) then
			kb:SetWorldPosition(Vector2(x, y))
		end
		local mc = self.Entity.MovementComponent
		if isvalid(mc) then
			mc:Stop()
		end
	end

	@ExecSpace("ServerOnly")
	method void ApplyKnockback(Vector2 fromPos)
		-- Pushes the monster directly away from fromPos for KnockbackDuration seconds.
		-- ⚠ 도약(LEAP)은 한번 시작하면 넉백으로 밀리지도, 취소되지도 않는다(슈퍼아머).
		--   예전에는 도약 중 한 대만 맞아도 CHASE 로 강제 전환되어 착지 광역타가 통째로 사라졌다.
		--   피해·어그로는 그대로 들어가고, 회피는 넉백이 아니라 장판 밖으로 나가서 한다.
		if self.CurrentAIState == "LEAP" then
			self.AggroGraceTimer = self.AggroGraceDuration
			self:BeginEngagement()
			return
		end
		local p = self:Pos2D()
		local dx = p.x - fromPos.x
		local dy = p.y - fromPos.y
		local len = math.sqrt(dx * dx + dy * dy)
		if len <= 0.0001 then dx = 1 dy = 0 len = 1 end
		
		local speed = self.KnockbackSpeed
		local duration = self.KnockbackDuration
		
		-- 보스 및 대형 몬스터 넉백 면역/저항 (Super Armor / Knockback Resistance)
		local mon = self.Entity:GetComponent("script.Monster")
		if isvalid(mon) and (mon.IsBoss or mon.MonsterId == "slime_king") then
			-- 슬라임킹은 넉백 속도 25%, 지속시간 50%로 대폭 감소하여 묵직하게 버팀
			speed = speed * 0.25
			duration = duration * 0.5
		end
		
		self.KnockVel = Vector2(dx / len * speed, dy / len * speed)
		self.KnockTimer = duration
		-- 피격 시 어그로 유예 갱신: 귀환/복귀 중이어도 넉백이 끝나면 곧바로 추적/반격하도록 한다.
		self.AggroGraceTimer = self.AggroGraceDuration
		-- 원거리 선공으로 교전이 열린 경우에도 쿨/유예 시작
		self:BeginEngagement()
	end

	@ExecSpace("ServerOnly")
	method void MoveToward(Vector2 targetPos, number delta)
		-- Moves one frame toward targetPos using a normalized direction.
		local myPos = self:Pos2D()
		-- T93: 목적지가 장치 반경 안이면 가장자리로 클램프해 진입을 막는다.
		targetPos = self:ClampChaseTargetOutsideAvoid(myPos, targetPos)
		local dx = targetPos.x - myPos.x
		local dy = targetPos.y - myPos.y
		local len = math.sqrt(dx * dx + dy * dy)
		if len <= 0.0001 then return end
		self:MoveDirVec(Vector2(dx / len, dy / len), delta)
	end

	@ExecSpace("ServerOnly")
	method boolean IsBossMonster()
		-- Monster.IsBoss 모델 프로퍼티로 보스 여부를 판정한다(이름 분기 금지).
		local m = self:GetMonster()
		return isvalid(m) and m.IsBoss
	end

	@ExecSpace("ServerOnly")
	method boolean TryFleeAvoidZone(Vector2 myPos, number delta)
		-- 진입 반경(또는 히스테리시스 이탈 반경) 안이면 중심에서 멀어지고 true를 반환한다.
		if self:IsBossMonster() then return false end
		if _MonsterAvoidanceRegistry == nil then return false end
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return false end
		local list = _MonsterAvoidanceRegistry:GetActiveForMap(map.Name)
		if list == nil or #list == 0 then
			self.InsideAvoidZone = false
			return false
		end
		local bestDx = 0
		local bestDy = 0
		local bestDistSq = nil
		local anyInsideEnter = false
		local anyInsideExit = false
		local wasInside = self.InsideAvoidZone
		for i, e in ipairs(list) do
			local enterR = e.enterR or 0
			local exitR = e.exitR or enterR
			if exitR < enterR then exitR = enterR end
			local dx = myPos.x - (e.x or 0)
			local dy = myPos.y - (e.y or 0)
			local distSq = dx * dx + dy * dy
			local enterSq = enterR * enterR
			local exitSq = exitR * exitR
			if distSq <= enterSq then anyInsideEnter = true end
			if distSq <= exitSq then anyInsideExit = true end
			local shouldFlee = distSq <= enterSq or (self.InsideAvoidZone and distSq <= exitSq)
			if shouldFlee then
				if bestDistSq == nil or distSq < bestDistSq then
					bestDistSq = distSq
					local len = math.sqrt(distSq)
					if len <= 0.0001 then
						bestDx = 1
						bestDy = 0
					else
						bestDx = dx / len
						bestDy = dy / len
					end
				end
			end
		end
		if anyInsideEnter then
			self.InsideAvoidZone = true
		elseif not anyInsideExit then
			self.InsideAvoidZone = false
		end
		if bestDistSq == nil then return false end
		if self.CurrentAIState ~= "CHASE" and self.CurrentAIState ~= "RETURN" then
			self:EnterState("CHASE")
		end
		self:MoveDirVec(Vector2(bestDx, bestDy), delta)
		if anyInsideEnter and not wasInside then
			log("[T93][AVOID] flee enter distSq=" .. tostring(bestDistSq))
		end
		return true
	end

	@ExecSpace("ServerOnly")
	method Vector2 ClampChaseTargetOutsideAvoid(Vector2 myPos, Vector2 tp)
		-- 추적 목표가 장치 진입 반경 안이면 이탈 반경 가장자리로 밀어 목적지로 삼지 않는다.
		if self:IsBossMonster() then return tp end
		if _MonsterAvoidanceRegistry == nil then return tp end
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return tp end
		local list = _MonsterAvoidanceRegistry:GetActiveForMap(map.Name)
		if list == nil or #list == 0 then return tp end
		local out = tp
		for i, e in ipairs(list) do
			local enterR = e.enterR or 0
			local exitR = e.exitR or enterR
			if exitR < enterR then exitR = enterR end
			local cx = e.x or 0
			local cy = e.y or 0
			local dx = out.x - cx
			local dy = out.y - cy
			local distSq = dx * dx + dy * dy
			if distSq < enterR * enterR then
				-- 몬스터가 있는 쪽의 가장자리로 투영
				local fromCx = myPos.x - cx
				local fromCy = myPos.y - cy
				local len = math.sqrt(fromCx * fromCx + fromCy * fromCy)
				if len <= 0.0001 then
					fromCx = 1
					fromCy = 0
					len = 1
				end
				out = Vector2(cx + fromCx / len * exitR, cy + fromCy / len * exitR)
			end
		end
		return out
	end

	@ExecSpace("ServerOnly")
	method void MoveTowardScaled(Vector2 targetPos, number delta, number speedMultiplier)
		-- InputSpeed를 speedMultiplier배로 일시 조정해 이동(돌진 접근/빠른 귀환에 공용 사용).
		local mc = self.Entity.MovementComponent
		if not isvalid(mc) then
			self:MoveToward(targetPos, delta)
			return
		end
		local old = mc.InputSpeed
		mc.InputSpeed = old * speedMultiplier
		self:MoveToward(targetPos, delta)
		mc.InputSpeed = old
	end

	@ExecSpace("ServerOnly")
	method void MoveDirVec(Vector2 dir, number delta)
		-- Applies movement via MovementComponent with T99 entity-obstacle slide (player-equivalent).
		-- 적용 순서: 호출부(TryFleeAvoidZone / CHASE / WANDER 등) → 여기 장애물 슬라이드 → MoveToDirection.
		local mc = self.Entity.MovementComponent
		if not isvalid(mc) then return end
		local dx = dir.x
		local dy = dir.y
		local len = math.sqrt(dx * dx + dy * dy)
		if len <= 0.0001 then
			mc:Stop()
			self:TickObstacleStuck(false, delta)
			return
		end
		dx = dx / len
		dy = dy / len
		local currentPos = self:Pos2D()
		local r = self.ObstacleRadius
		if r == nil or r <= 0 then r = 0.6 end
		local queryR = self.ObstacleQueryRadius
		if queryR == nil or queryR < r then queryR = 3.0 end
		local monster = self:GetMonster()
		local skillFactor = isvalid(monster) and monster:GetSkillMoveFactor() or 1
		if skillFactor <= 0 then mc:Stop() return end
		local step = mc.InputSpeed * delta * skillFactor
		local moved = false
		local outDx = 0
		local outDy = 0
		if _ObstacleQuery ~= nil then
			local testFull = Vector2(currentPos.x + dx * step, currentPos.y + dy * step)
			if not _ObstacleQuery:IsObstacle(self.Entity, testFull, r, currentPos, queryR) then
				outDx = dx
				outDy = dy
				moved = true
			else
				local canX = false
				local canY = false
				if math.abs(dx) > 0.0001 then
					local testX = Vector2(currentPos.x + dx * step, currentPos.y)
					canX = not _ObstacleQuery:IsObstacle(self.Entity, testX, r, currentPos, queryR)
				end
				if math.abs(dy) > 0.0001 then
					local testY = Vector2(currentPos.x, currentPos.y + dy * step)
					canY = not _ObstacleQuery:IsObstacle(self.Entity, testY, r, currentPos, queryR)
				end
				if canX and canY then
					if math.abs(dx) >= math.abs(dy) then
						outDx = dx
						outDy = 0
					else
						outDx = 0
						outDy = dy
					end
					moved = true
				elseif canX then
					outDx = dx
					outDy = 0
					moved = true
				elseif canY then
					outDx = 0
					outDy = dy
					moved = true
				end
			end
		else
			outDx = dx
			outDy = dy
			moved = true
		end
		if moved then
			mc:MoveToDirection(Vector2(outDx, outDy), delta * skillFactor)
			self:Face(outDx ~= 0 and outDx or dir.x)
		else
			mc:Stop()
			self:Face(dir.x)
		end
		self:TickObstacleStuck(moved, delta)
	end

	@ExecSpace("ServerOnly")
	method void TickObstacleStuck(boolean movedIntent, number delta)
		-- 이동 의인데 실제 변위가 없으면 갇힘 타이머를 쌓고, 임계 시 탈출한다.
		-- ⚠ 도약 비행 중에는 갇힘 판정을 하지 않는다. 여기서 EscapeObstacleStuck 이 걸리면
		--   공중에서 스폰 방향으로 튕겨나가 RETURN 으로 빠지는데, 이것이 정확히 "갑자기
		--   순간이동한다"로 보이는 증상이다. 착지 후 지상 이동부터 다시 센다.
		if self:IsAirborne() then
			self.ObstacleStuckTimer = 0
			local p = self:Pos2D()
			self.ObstacleLastX = p.x
			self.ObstacleLastY = p.y
			return
		end
		if self.ObstacleEscapeCooldownTimer > 0 then
			self.ObstacleEscapeCooldownTimer = self.ObstacleEscapeCooldownTimer - delta
			return
		end
		local p = self:Pos2D()
		if not self.ObstaclePosInit then
			self.ObstacleLastX = p.x
			self.ObstacleLastY = p.y
			self.ObstaclePosInit = true
			self.ObstacleStuckTimer = 0
			return
		end
		local dx = p.x - self.ObstacleLastX
		local dy = p.y - self.ObstacleLastY
		local progressed = (dx * dx + dy * dy) > 0.0001
		self.ObstacleLastX = p.x
		self.ObstacleLastY = p.y
		if movedIntent and progressed then
			self.ObstacleStuckTimer = 0
			return
		end
		if not movedIntent then
			-- 의도적 정지(공격 등)는 갇힘으로 치지 않음 — MoveDirVec에서만 movedIntent=false+Stop
			-- 장애물로 막혀 Stop된 경우 movedIntent=false 이므로 타이머를 올린다.
			self.ObstacleStuckTimer = self.ObstacleStuckTimer + delta
		else
			-- 의도는 이동인데 변위 없음
			self.ObstacleStuckTimer = self.ObstacleStuckTimer + delta
		end
		local limit = self.ObstacleStuckSeconds
		if limit == nil or limit <= 0 then limit = 1.5 end
		if self.ObstacleStuckTimer >= limit then
			self:EscapeObstacleStuck()
		end
	end

	@ExecSpace("ServerOnly")
	method boolean TryPushOutOfObstacles()
		-- ResolveOverlaps와 동일 MTV로 한 번 밀어낸다. 성공 시 true.
		if _ObstacleQuery == nil then return false end
		local p = self:Pos2D()
		local r = self.ObstacleRadius
		if r == nil or r <= 0 then r = 0.6 end
		local queryR = self.ObstacleQueryRadius
		if queryR == nil or queryR < r then queryR = 3.0 end
		local push = _ObstacleQuery:ComputeOverlapPush(self.Entity, p, r, queryR, p.x, p.y)
		if push.x == 0 and push.y == 0 then return false end
		local target = Vector2(p.x + push.x, p.y + push.y)
		local body = self.Entity.KinematicbodyComponent
		if isvalid(body) then
			body:SetWorldPosition(target)
		else
			local t = self.Entity.TransformComponent
			if isvalid(t) then
				t.WorldPosition = Vector3(target.x, target.y, t.WorldPosition.z)
			end
		end
		self.ObstacleLastX = target.x
		self.ObstacleLastY = target.y
		return true
	end

	@ExecSpace("ServerOnly")
	method void EscapeObstacleStuck()
		-- 갇힘 폴백: MTV 밀어내기 → 실패 시 스폰 방향 스텝 → RETURN.
		self.ObstacleStuckTimer = 0
		local cd = self.ObstacleStuckCooldown
		if cd == nil or cd < 0 then cd = 4.0 end
		self.ObstacleEscapeCooldownTimer = cd
		local ok = self:TryPushOutOfObstacles()
		if not ok then
			local p = self:Pos2D()
			local dx = self.SpawnPos.x - p.x
			local dy = self.SpawnPos.y - p.y
			local len = math.sqrt(dx * dx + dy * dy)
			local step = self.ObstacleEscapeStep
			if step == nil or step <= 0 then step = 0.75 end
			local target = self.SpawnPos
			if len > step then
				target = Vector2(p.x + dx / len * step, p.y + dy / len * step)
			end
			local body = self.Entity.KinematicbodyComponent
			if isvalid(body) then
				body:SetWorldPosition(target)
			else
				local t = self.Entity.TransformComponent
				if isvalid(t) then
					t.WorldPosition = Vector3(target.x, target.y, t.WorldPosition.z)
				end
			end
			self.ObstacleLastX = target.x
			self.ObstacleLastY = target.y
		end
		self:EnterState("RETURN")
		-- log("[T99][OBS] stuck escape push=" .. tostring(ok) .. " entity=" .. tostring(self.Entity.Name))
	end

	@ExecSpace("ServerOnly")
	method void StopMovement()
		-- Halts the body.
		local mc = self.Entity.MovementComponent
		if isvalid(mc) then mc:Stop() end
	end

	@ExecSpace("ServerOnly")
	method void Face(number dx)
		-- Slime sprites face left by default; flip when moving/aiming right.
		if dx == 0 then return end
		local sprite = self.Entity.SpriteRendererComponent
		if isvalid(sprite) then sprite.FlipX = dx > 0 end
	end

	@ExecSpace("ServerOnly")
	method void SetSprite(string ruid)
		-- Swaps the rendered clip; ignores empty RUIDs so the model default stays.
		if ruid == nil or ruid == "" then return end
		local sprite = self.Entity.SpriteRendererComponent
		if not isvalid(sprite) then return end
		sprite.SpriteRUID = ruid
		sprite.PlayRate = 1
		sprite.StartFrameIndex = 0
		sprite.EndFrameIndex = 2147483647
	end

	@ExecSpace("ServerOnly")
	method void SetSpritePlayRate(number rate)
		-- 점프 중 애니 홀드(0) / 재개(>0). SpriteRenderer PlayRate 동기 프로퍼티.
		local sprite = self.Entity.SpriteRendererComponent
		if not isvalid(sprite) then return end
		if rate < 0 then rate = 0 end
		sprite.PlayRate = rate
	end

	@ExecSpace("ServerOnly")
	method Vector2 Pos2D()
		-- This monster's world position as a Vector2.
		local p = self.Entity.TransformComponent.WorldPosition
		return Vector2(p.x, p.y)
	end

	@ExecSpace("ServerOnly")
	method Vector2 EntityPos2D(Entity e)
		-- Another entity's world position as a Vector2.
		local p = e.TransformComponent.WorldPosition
		return Vector2(p.x, p.y)
	end

	@ExecSpace("ServerOnly")
	method number DistSq(Vector2 a, Vector2 b)
		-- Squared 2D distance (avoids sqrt for range comparisons).
		local dx = a.x - b.x
		local dy = a.y - b.y
		return dx * dx + dy * dy
	end

	@ExecSpace("ServerOnly")
	method Entity FindNearestPlayer()
		-- Returns the nearest player entity on this map, or nil if none.
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return nil end
		local mapComp = map.MapComponent
		if not isvalid(mapComp) then return nil end
		local users = _UserService:GetUsersByMapComponent(mapComp)
		if users == nil then return nil end
		local myPos = self:Pos2D()
		local best = nil
		local bestSq = 0
		for i, u in ipairs(users) do
			if isvalid(u) then
				local dx = u.TransformComponent.WorldPosition.x - myPos.x
				local dy = u.TransformComponent.WorldPosition.y - myPos.y
				local dSq = dx * dx + dy * dy
				if best == nil or dSq < bestSq then
					best = u
					bestSq = dSq
				end
			end
		end
		return best
	end

	@ExecSpace("ServerOnly")
	method Monster GetMonster()
		-- The sibling HP component.
		---@type Monster
		local m = self.Entity:GetComponent("script.Monster")
		return m
	end

	@ExecSpace("ServerOnly")
	method MonsterMeleeAttack GetAttack()
		-- The sibling attack component.
		---@type MonsterMeleeAttack
		local a = self.Entity:GetComponent("script.MonsterMeleeAttack")
		return a
	end

end

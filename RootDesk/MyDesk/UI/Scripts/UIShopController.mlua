@Component
script UIShopController extends Component

	-- In-game NPC shop UI controller (ClientOnly)
	-- Manages items rendering, tab switching, and purchase/sales requests.

	property Entity btnClose = "4d3c93f5-1fed-4925-8dfc-c0178c0d1bbe"
	property Entity btnTabBuy = "b807f549-5a57-4bf6-be4a-62f118a33569"
	property Entity btnTabSell = "2cfb4121-a723-485f-a42c-e13971bf6f1f"
	property Entity coinText = "06e0ea70-52a4-4033-aba6-fb371afd05ec"

	-- Bindings for 6 slots
	property Entity slot1 = "b0a3bf45-7f83-45a6-9bcd-850865325484"
	property Entity slot1_icon = "8504a814-e5b6-441d-a3cd-cc078faeba29"
	property Entity slot1_name = "30fbaad9-d8a6-41c8-9995-7c6d35e9d925"
	property Entity slot1_price = "20d50837-676c-4e95-b64d-02b049deffd8"

	property Entity slot2 = "989bff95-4bb0-4ea2-8268-e9d727959128"
	property Entity slot2_icon = "4b6504b6-a04e-4cf3-9985-75471246b956"
	property Entity slot2_name = "aa10e524-3e10-4fb2-8350-87da723f0a4c"
	property Entity slot2_price = "b1de72f8-fab3-4406-966c-ca02f4b57dd5"

	property Entity slot3 = "b2ffcbd5-1372-4711-8886-fd15bef19713"
	property Entity slot3_icon = "36660c9e-d9fe-4c05-a9c0-8e6bdc463265"
	property Entity slot3_name = "ee4f16f1-cb1b-4ccd-89b4-83f9a1832271"
	property Entity slot3_price = "9d0c3876-ce5e-4328-94a0-1963ccdb2f2d"

	property Entity slot4 = "668fc66c-b9e7-415f-aff8-44a31cd0082b"
	property Entity slot4_icon = "a3093b4c-f562-481a-bfa0-6f43d71382fe"
	property Entity slot4_name = "6d2ae06e-ecbc-4b10-be8d-7658b0f21864"
	property Entity slot4_price = "3cefc4e9-4a5f-45b6-96b1-7c57f70a3015"

	property Entity slot5 = "6d76a5ea-61e2-4ba6-9e0f-c833616a4d30"
	property Entity slot5_icon = "43749044-5207-4f83-8a9d-87cf036ea928"
	property Entity slot5_name = "74239c10-1bbf-497a-82ff-27ed04a44414"
	property Entity slot5_price = "2bccaa99-4cff-477a-898a-3e1d73f592ac"

	property Entity slot6 = "ac94f0d1-714f-45cf-8737-bd7d6757f22a"
	property Entity slot6_icon = "0444251b-8cec-4e38-b0d0-8be5f52a68eb"
	property Entity slot6_name = "f1e65861-c49a-428d-b8e5-6bd0081bdf4b"
	property Entity slot6_price = "e11a4798-1040-4004-89b0-961e4feed9af"

	-- 페이지 넘김 (2026-09-30): 슬롯은 6칸 고정인데 구매 목록이 6개를 넘어 뒤쪽 품목이 보이지 않았다.
	property Entity btnPrevPage = "4d411011-dcc6-4e25-be0b-1be4714d6149"
	property Entity btnNextPage = "a384eee3-5812-4468-8f1c-08358713af11"
	property Entity pageText = "2e97db52-8c2d-4f2a-a2b6-fb033de3f8dc"
	property integer currentPage = 1
	property integer pageCount = 1
	property any prevPageHandler = nil
	property any nextPageHandler = nil

	-- 판매자 (2026-09-30): ShopItemDataSet.Vendor 로 품목을 나눈다. 공란 = "merchant"(마을 상점).
	-- 헛간지기 토리(VillagerDialog NpcId "barnkeeper")는 가축·펫·먹이를 판다 — VillagerDialog:TryInteract 가 OpenVendor 를 부른다.
	property string currentVendor = "merchant"
	property Entity titleText = "2af5ae21-c4d2-4b44-a225-07dc2ba6a107"

	-- 분류 칩 + 정렬 (2026-09-30): 분류 = ShopItemDataSet.ShopCategory(상점 전용 표기). 칩1 = 전체, 칩2~5 = 지금 목록에 있는 분류(등장 순).
	property Entity chip1 = "3207bb21-ae95-4913-9f40-dff6339cd594"
	property Entity chip2 = "7f3ed42e-aa9a-4585-b260-3df49c79d153"
	property Entity chip3 = "4fa41d51-893b-439b-8693-c280b0676201"
	property Entity chip4 = "efce98d9-0c75-436c-8fc1-238ec704d03e"
	property Entity chip5 = "5d5e72e1-58cf-42fd-8a87-9e85773b9b2c"
	property Entity btnSort = "5024f18d-c609-438e-b4ee-8f8936e55b7b"
	property string currentCategory = ""
	-- default = 데이터 순 · name = 이름순 · price_asc = 낮은 가격순 · price_desc = 높은 가격순
	property string sortMode = "default"
	property table chipCategories = {}
	property table chipHandlers = {}
	property any sortHandler = nil

	-- 구매 수량 모달(기존 버리기 수량 선택 방식 재사용).
	property Entity buyPopup = "818ff2e6-f3fd-4cf5-8a0e-c165d178ccd3"
	property Entity buyCard = "f9a9db7a-7cf7-41be-a25b-283529d7e04a"
	property table buyHandlers = {}

	-- Runtime state (client-only)
	property string currentTab = "buy"  -- "buy" or "sell"
	property table shopItems = {}       -- index -> { name, price }
	property table slotHandlers = {}    -- index -> handler

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 기존 상점과 수량 모달의 버튼을 한 번만 연결한다.
		self.Entity.Enable = false
		self:InitBuyQuantity()

		if isvalid(self.btnClose) then
			self.btnClose:ConnectEvent(ButtonClickEvent, function() self:Close() end)
		end

		if isvalid(self.btnTabBuy) then
			self.btnTabBuy:ConnectEvent(ButtonClickEvent, function() self:SetTab("buy") end)
		end

		if isvalid(self.btnTabSell) then
			self.btnTabSell:ConnectEvent(ButtonClickEvent, function() self:SetTab("sell") end)
		end

		-- Connect click events for 6 slots
		for i = 1, 6 do
			local slot = self["slot" .. i]
			if isvalid(slot) then
				local index = i
				local h = slot:ConnectEvent(ButtonClickEvent, function() self:OnSlotClick(index) end)
				self.slotHandlers[i] = h
			end
		end

		if isvalid(self.btnPrevPage) then
			self.prevPageHandler = self.btnPrevPage:ConnectEvent(ButtonClickEvent, function() self:ChangePage(-1) end)
		end
		if isvalid(self.btnNextPage) then
			self.nextPageHandler = self.btnNextPage:ConnectEvent(ButtonClickEvent, function() self:ChangePage(1) end)
		end

		for i = 1, 5 do
			local chip = self["chip" .. i]
			if isvalid(chip) then
				local index = i
				self.chipHandlers[i] = chip:ConnectEvent(ButtonClickEvent, function() self:OnChipClick(index) end)
			end
		end
		if isvalid(self.btnSort) then
			self.sortHandler = self.btnSort:ConnectEvent(ButtonClickEvent, function() self:CycleSort() end)
		end
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- 수량 모달의 입력도 함께 해제한다.
		self:CloseBuyQuantity()
		for _, rec in ipairs(self.buyHandlers) do
			if isvalid(rec.entity) then rec.entity:DisconnectEvent(ButtonClickEvent, rec.hook) end
		end
		self.buyHandlers = {}
		for i = 1, 6 do
			local slot = self["slot" .. i]
			local h = self.slotHandlers[i]
			if isvalid(slot) and h ~= nil then
				slot:DisconnectEvent(ButtonClickEvent, h)
			end
		end
		if isvalid(self.btnPrevPage) and self.prevPageHandler ~= nil then
			self.btnPrevPage:DisconnectEvent(ButtonClickEvent, self.prevPageHandler)
		end
		if isvalid(self.btnNextPage) and self.nextPageHandler ~= nil then
			self.btnNextPage:DisconnectEvent(ButtonClickEvent, self.nextPageHandler)
		end
		for i = 1, 5 do
			local chip = self["chip" .. i]
			local h = self.chipHandlers[i]
			if isvalid(chip) and h ~= nil then
				chip:DisconnectEvent(ButtonClickEvent, h)
			end
		end
		if isvalid(self.btnSort) and self.sortHandler ~= nil then
			self.btnSort:DisconnectEvent(ButtonClickEvent, self.sortHandler)
		end
	end

	@ExecSpace("ClientOnly")
	method void ChangePage(integer delta)
		-- 이전/다음 페이지. 범위를 벗어나면 무시한다.
		local nextPage = self.currentPage + delta
		if nextPage < 1 or nextPage > self.pageCount then return end
		self.currentPage = nextPage
		self:RefreshShop()
	end

	@ExecSpace("ClientOnly")
	method void OnChipClick(integer index)
		-- 분류 칩: 1 = 전체, 2~5 = chipCategories[index].
		if index == 1 then
			self.currentCategory = ""
		else
			self.currentCategory = self.chipCategories[index] or ""
		end
		self.currentPage = 1
		self:RefreshShop()
	end

	@ExecSpace("ClientOnly")
	method void CycleSort()
		-- 정렬 순환: 기본순 → 이름순 → 낮은 가격순 → 높은 가격순 → 기본순.
		local order = { "default", "name", "price_asc", "price_desc" }
		local nextIdx = 1
		for i, m in ipairs(order) do
			if m == self.sortMode then nextIdx = (i % #order) + 1 end
		end
		self.sortMode = order[nextIdx]
		self.currentPage = 1
		self:RefreshShop()
	end

	@ExecSpace("ClientOnly")
	method string GetSortLabel()
		-- 정렬 버튼 표기.
		if self.sortMode == "name" then return "정렬: 이름순" end
		if self.sortMode == "price_asc" then return "정렬: 낮은 가격" end
		if self.sortMode == "price_desc" then return "정렬: 높은 가격" end
		return "정렬: 기본순"
	end

	@ExecSpace("ClientOnly")
	method void Open()
		-- 마을 상점(기존 진입점 — MerchantInteract). 시그니처 유지(규칙 46).
		self:OpenVendor("merchant", "상점")
	end

	@ExecSpace("ClientOnly")
	method void OpenVendor(string vendorId, string title)
		-- 판매자별 상점 열기. vendorId 는 ShopItemDataSet.Vendor 값(공란 행 = "merchant").
		self.currentVendor = vendorId
		self.currentCategory = ""
		self.sortMode = "default"
		if isvalid(self.titleText) then
			local t = self.titleText.TextGUIRendererComponent
			if isvalid(t) then t.Text = title end
		end
		self.Entity.Enable = true
		self:SetTab("buy")
		log("[SHOP] open vendor=" .. vendorId)
	end

	@ExecSpace("ClientOnly")
	method boolean HasVendorItems(string vendorId)
		-- 이 판매자에게 등록된 품목이 하나라도 있는가(VillagerDialog 가 상점 NPC 여부 판정에 쓴다).
		local shopDs = _DataService:GetTable("ShopItemDataSet")
		if shopDs == nil then return false end
		for i = 1, shopDs:GetRowCount() do
			if self:RowVendor(shopDs, i) == vendorId then return true end
		end
		return false
	end

	@ExecSpace("ClientOnly")
	method string RowVendor(any shopDs, integer i)
		-- ShopItemDataSet.Vendor (공란 = "merchant").
		local ok, v = pcall(function() return shopDs:GetCell(i, "Vendor") end)
		if ok and v ~= nil and tostring(v) ~= "" then return tostring(v) end
		return "merchant"
	end

	@ExecSpace("ClientOnly")
	method void Close()
		-- 상점을 닫으면 미확정 구매도 취소한다(ESC/공통 닫기 포함).
		self:CloseBuyQuantity()
		self.Entity.Enable = false
	end

	@ExecSpace("ClientOnly")
	method void SetTab(string tabName)
		-- 구매/판매 전환 시 이전 구매 선택은 취소한다.
		self:CloseBuyQuantity()
		self.currentTab = tabName
		self.currentPage = 1
		self.currentCategory = ""

		-- Highlight the active tab (Buy = green, Sell = grey/blue). ui8 스킨이면 탭 그림으로.
		if _UI8Skin ~= nil and isvalid(self.btnTabBuy) and _UI8Skin:Pick(self.btnTabBuy, tabName == "buy", "tab_on", "tab_off") then
			_UI8Skin:Pick(self.btnTabSell, tabName == "sell", "tab_on", "tab_off")
			self:SetTabLabelColor(self.btnTabBuy, tabName == "buy")
			self:SetTabLabelColor(self.btnTabSell, tabName == "sell")
		elseif isvalid(self.btnTabBuy) and isvalid(self.btnTabBuy.SpriteGUIRendererComponent) then
			if tabName == "buy" then
				self.btnTabBuy.SpriteGUIRendererComponent.Color = Color(0.18, 0.40, 0.20, 1.0) -- Active Green
			else
				self.btnTabBuy.SpriteGUIRendererComponent.Color = Color(0.30, 0.30, 0.36, 1.0) -- Inactive Grey
			end
		end

		if not (_UI8Skin ~= nil and _UI8Skin:HasSkin(self.btnTabSell)) and isvalid(self.btnTabSell) and isvalid(self.btnTabSell.SpriteGUIRendererComponent) then
			if tabName == "sell" then
				self.btnTabSell.SpriteGUIRendererComponent.Color = Color(0.18, 0.40, 0.20, 1.0) -- Active Green
			else
				self.btnTabSell.SpriteGUIRendererComponent.Color = Color(0.30, 0.30, 0.36, 1.0) -- Inactive Grey
			end
		end

		self:RefreshShop()
	end

	@ExecSpace("ClientOnly")
	method void SetAnyText(Entity e, string text)
		-- 신형/구형 글자 컴포넌트 어느 쪽이든 글자를 쓴다.
		if not isvalid(e) then return end
		if isvalid(e.TextGUIRendererComponent) then
			e.TextGUIRendererComponent.Text = text
		elseif isvalid(e.TextComponent) then
			e.TextComponent.Text = text
		end
	end

	@ExecSpace("ClientOnly")
	method void SetTabLabelColor(Entity tab, boolean on)
		-- ui8 탭: 켜짐(앰버) = 진한 갈색 글자, 꺼짐(나무) = 크림 글자.
		if not isvalid(tab) then return end
		local c = Color(1, 0.94, 0.8, 1)
		if on then c = Color(0.27, 0.13, 0.04, 1) end
		if isvalid(tab.TextGUIRendererComponent) then
			tab.TextGUIRendererComponent.FontColor = c
		elseif isvalid(tab.TextComponent) then
			tab.TextComponent.FontColor = c
		end
	end

	@ExecSpace("ClientOnly")
	method void RefreshShop()
		-- 판매자·탭 → 분류 칩 → 분류 필터 → 정렬 → 페이지 순으로 목록을 만든다.
		local localPlayer = _UserService.LocalPlayer
		if not isvalid(localPlayer) then return end

		local inv = localPlayer:GetComponent("script.PlayerInventory")
		if not isvalid(inv) then return end

		-- Update coin text
		if isvalid(self.coinText) and isvalid(self.coinText.TextComponent) then
			self.coinText.TextComponent.Text = "보유 코인: " .. tostring(inv.Coin) .. " 코인"
		end

		local shopDs = _DataService:GetTable("ShopItemDataSet")
		if shopDs == nil then
			log_error("RefreshShop: ShopItemDataSet not found.")
			return
		end
		local itemDs = _DataService:GetTable("item_dataset")
		if itemDs == nil then
			log_error("RefreshShop: item_dataset not found.")
			return
		end

		-- ① 이 판매자 · 이 탭의 전체 품목
		local all = {}
		for i = 1, shopDs:GetRowCount() do
			if self:RowVendor(shopDs, i) == self.currentVendor then
				local itemName = shopDs:GetCell(i, "Name") or ""
				local buyPrice = inv:GetShopBuyPrice(itemName)
				local sellPrice = tonumber(shopDs:GetCell(i, "SellPrice")) or 0
				local price = 0
				if self.currentTab == "buy" then price = buyPrice else price = sellPrice end
				if itemName ~= "" and price > 0 then
					local cat = ""
					local okC, vC = pcall(function() return shopDs:GetCell(i, "ShopCategory") end)
					if okC and vC ~= nil then cat = tostring(vC) end
					local row = itemDs:FindRow("Name", itemName)
					local disp = itemName
					local ruid = ""
					if row ~= nil then
						ruid = row:GetItem("IconRUID") or ""
						local okD, vD = pcall(function() return row:GetItem("DisplayName") end)
						if okD and vD ~= nil and tostring(vD) ~= "" then disp = tostring(vD) end
					end
					all[#all + 1] = { name = itemName, price = price, cat = cat, disp = disp, ruid = ruid, order = i }
				end
			end
		end

		-- ② 분류 칩: 전체 + 등장 순 분류(최대 4개)
		self.chipCategories = {}
		local seen = {}
		local cats = {}
		for _, e in ipairs(all) do
			if e.cat ~= "" and not seen[e.cat] then
				seen[e.cat] = true
				cats[#cats + 1] = e.cat
			end
		end
		if self.currentCategory ~= "" and not seen[self.currentCategory] then self.currentCategory = "" end
		for i = 1, 5 do
			local chip = self["chip" .. i]
			if isvalid(chip) then
				local label = ""
				local key = ""
				if i == 1 then
					label = "전체"
				elseif cats[i - 1] ~= nil then
					key = cats[i - 1]
					label = key
				end
				self.chipCategories[i] = key
				-- 분류가 하나뿐이면 칩 줄 전체를 숨긴다(고를 게 없다).
				chip.Enable = (label ~= "") and (#cats > 1)
				local t = chip.TextGUIRendererComponent
				if isvalid(t) then t.Text = label end
				local s = chip.SpriteGUIRendererComponent
				if _UI8Skin ~= nil and _UI8Skin:Pick(chip, key == self.currentCategory, "tab_on", "tab_off") then
					self:SetTabLabelColor(chip, key == self.currentCategory)
				elseif isvalid(s) then
					if key == self.currentCategory then
						s.Color = Color(0.18, 0.40, 0.20, 1.0)
					else
						s.Color = Color(0.30, 0.30, 0.36, 1.0)
					end
				end
			end
		end

		-- ③ 분류 필터
		local list = {}
		for _, e in ipairs(all) do
			if self.currentCategory == "" or e.cat == self.currentCategory then list[#list + 1] = e end
		end

		-- ④ 정렬 (같으면 데이터 순으로 안정화)
		local mode = self.sortMode
		table.sort(list, function(a, b)
			if mode == "name" and a.disp ~= b.disp then return a.disp < b.disp end
			if mode == "price_asc" and a.price ~= b.price then return a.price < b.price end
			if mode == "price_desc" and a.price ~= b.price then return a.price > b.price end
			return a.order < b.order
		end)
		if isvalid(self.btnSort) then
			local st = self.btnSort.TextGUIRendererComponent
			if isvalid(st) then st.Text = self:GetSortLabel() end
		end

		-- ⑤ 페이지
		self.pageCount = math.max(1, math.ceil(#list / 6))
		if self.currentPage > self.pageCount then self.currentPage = self.pageCount end
		if self.currentPage < 1 then self.currentPage = 1 end
		local pageStart = (self.currentPage - 1) * 6

		self.shopItems = {}
		for slotIdx = 1, 6 do
			local slot = self["slot" .. slotIdx]
			local e = list[pageStart + slotIdx]
			if isvalid(slot) then
				if e == nil then
					slot.Enable = false
				else
					self.shopItems[slotIdx] = { name = e.name, price = e.price }
					local icon = self["slot" .. slotIdx .. "_icon"]
					local nameTxt = self["slot" .. slotIdx .. "_name"]
					local priceTxt = self["slot" .. slotIdx .. "_price"]
					if isvalid(icon) and isvalid(icon.SpriteGUIRendererComponent) then
						icon.SpriteGUIRendererComponent.ImageRUID = e.ruid
					end
					-- ui8 이후 카드 글자는 신형 TextGUIRenderer(구형 TextComponent 도 계속 지원)
					self:SetAnyText(nameTxt, e.disp)
					self:SetAnyText(priceTxt, tostring(e.price) .. " 코인")
					-- 카드 세 번째 줄: 지금 내가 가진 수량(사고팔기 전에 얼마나 있는지 바로 보이게).
					local ownEnt = slot:GetChildByName("OwnText")
					if isvalid(ownEnt) then
						local ownTxt = ownEnt.TextGUIRendererComponent
						if isvalid(ownTxt) then ownTxt.Text = "보유: " .. tostring(inv:GetItemCount(e.name)) .. "개" end
					end
					slot.Enable = true
				end
			end
		end

		local multi = self.pageCount > 1
		if isvalid(self.pageText) then
			self.pageText.Enable = multi
			local t = self.pageText.TextGUIRendererComponent
			if isvalid(t) then t.Text = tostring(self.currentPage) .. " / " .. tostring(self.pageCount) end
		end
		-- [< 이전]  1 / 2  [다음 >] 좌우 대칭: 페이지가 여럿이면 두 버튼을 항상 보이고, 갈 수 없는 쪽만 회색 비활성으로 둔다.
		if isvalid(self.btnPrevPage) then
			self.btnPrevPage.Enable = multi
			if multi and _UIButtonStyle ~= nil then _UIButtonStyle:SetActive(self.btnPrevPage, self.currentPage > 1) end
		end
		if isvalid(self.btnNextPage) then
			self.btnNextPage.Enable = multi
			if multi and _UIButtonStyle ~= nil then _UIButtonStyle:SetActive(self.btnNextPage, self.currentPage < self.pageCount) end
		end
		self:RefreshBuyQuantity()
	end

	@ExecSpace("ClientOnly")
	method void OnSlotClick(integer index)
		-- 구매는 수량 확인을 거친다. 모달 뒤 슬롯의 중복 입력은 무시한다.
		if isvalid(self.buyPopup) and self.buyPopup.Enable then return end
		local item = self.shopItems[index]
		if item == nil then return end

		local localPlayer = _UserService.LocalPlayer
		if not isvalid(localPlayer) then return end

		local inv = localPlayer:GetComponent("script.PlayerInventory")
		if not isvalid(inv) then return end

		if self.currentTab == "buy" then
			self:OpenBuyQuantity(item.name)
		else
			-- Verify item exists in inventory first (client check before server request)
			if inv:GetItemCount(item.name) <= 0 then
				local pc = localPlayer:GetComponent("script.PlayerController")
				if isvalid(pc) then
					---@type PlayerController
					local c = pc
					c:ClientShowMineFeedback("판매할 아이템이 인벤토리에 없습니다!")
				end
				return
			end
			inv:ServerRequestSellItem(item.name)
		end
	end

	@ExecSpace("ClientOnly")
	method void InitBuyQuantity()
		-- 고정 수량 버튼은 기존 가방 수량창처럼 +/-/최소/최대를 쓴다.
		self:CloseBuyQuantity()
		if not isvalid(self.buyCard) then return end
		local actions = {
			BtnMinus = function() self:ChangeBuyCount(-1) end,
			BtnPlus = function() self:ChangeBuyCount(1) end,
			BtnMin = function() self:SetBuyCount(1) end,
			BtnMax = function() self:SetBuyCount(self._T.buyMax or 1) end,
			BtnBuy = function() self:ConfirmBuyQuantity() end,
			BtnCancel = function() self:CloseBuyQuantity() end,
			BtnClose = function() self:CloseBuyQuantity() end,
		}
		for name, action in pairs(actions) do
			local button = self.buyCard:GetChildByName(name)
			if isvalid(button) then
				self.buyHandlers[#self.buyHandlers + 1] = { entity = button, hook = button:ConnectEvent(ButtonClickEvent, action) }
			end
		end
		log("[VRF][SHOP-QUANTITY] ready buttons=" .. tostring(#self.buyHandlers))
	end

	@ExecSpace("ClientOnly")
	method void OpenBuyQuantity(string itemName)
		-- 슬롯 인덱스 대신 품목 키를 고정해 목록 재정렬/동기화에도 다른 물건을 사지 않는다.
		if not isvalid(self.buyPopup) or not isvalid(self.buyCard) then return end
		self._T.buyItem = itemName
		self._T.buyCount = 1
		local ds = _DataService:GetTable("item_dataset")
		local row = ds ~= nil and ds:FindRow("Name", itemName) or nil
		local label = row ~= nil and row:GetItem("DisplayName") or ""
		if label == nil or label == "" then label = itemName end
		self:SetAnyText(self.buyCard:GetChildByName("ItemName"), label)
		self.buyPopup.Enable = true
		self:RefreshBuyQuantity()
		log("[VRF][SHOP-QUANTITY] open item=" .. itemName)
	end

	@ExecSpace("ClientOnly")
	method void SetBuyCount(integer value)
		-- 실제 잔액·품목별 상한으로 RefreshBuyQuantity가 다시 제한한다.
		self._T.buyCount = value
		self:RefreshBuyQuantity()
	end

	@ExecSpace("ClientOnly")
	method void ChangeBuyCount(integer delta)
		-- 단품 제한 품목은 plus/minus를 눌러도 1을 넘을 수 없다.
		self:SetBuyCount((self._T.buyCount or 1) + delta)
	end

	@ExecSpace("ClientOnly")
	method void SetBuyButtonActive(string buttonName, boolean active)
		-- 공용 비활성 스타일과 실제 입력 차단을 함께 적용한다.
		local button = self.buyCard:GetChildByName(buttonName)
		if not isvalid(button) then return end
		if _UIButtonStyle ~= nil then
			_UIButtonStyle:SetActive(button, active)
		elseif isvalid(button.ButtonComponent) then
			button.ButtonComponent.Enable = active
		end
	end

	@ExecSpace("ClientOnly")
	method void RefreshBuyQuantity()
		-- 수량·단가·총액과 잔액 기준 최대치를 갱신한다. AP/SP 제한도 서버와 같은 함수를 쓴다.
		if not isvalid(self.buyPopup) or not self.buyPopup.Enable or not isvalid(self.buyCard) then return end
		local player = _UserService.LocalPlayer
		local inv = isvalid(player) and player:GetComponent("script.PlayerInventory") or nil
		local itemName = self._T.buyItem or ""
		if not isvalid(inv) or itemName == "" then self:CloseBuyQuantity() return end
		local price = inv:GetShopBuyPrice(itemName)
		local limit = inv:GetShopMaxBuyCount(itemName)
		if price <= 0 or limit < 1 then self:CloseBuyQuantity() return end
		local affordable = math.max(0, math.floor(inv.Coin / price))
		self._T.buyMax = math.max(1, math.min(limit, affordable))
		self._T.buyCount = math.max(1, math.min(self._T.buyMax, self._T.buyCount or 1))
		self._T.buyPrice = price
		local count = self._T.buyCount
		self:SetAnyText(self.buyCard:GetChildByName("CountText"), tostring(count) .. "개")
		self:SetAnyText(self.buyCard:GetChildByName("UnitPrice"), "개당 " .. tostring(price) .. " 코인 · 보유 " .. tostring(inv.Coin) .. " 코인")
		local hint = "1회 구매 한도: " .. tostring(limit) .. "개"
		if limit == 1 then hint = "한 번에 1개만 구매할 수 있습니다." end
		self:SetAnyText(self.buyCard:GetChildByName("LimitText"), hint)
		local total = "합계 " .. tostring(price * count) .. " 코인"
		if affordable < 1 then total = total .. " (코인 부족)" end
		self:SetAnyText(self.buyCard:GetChildByName("TotalPrice"), total)
		self:SetBuyButtonActive("BtnMinus", count > 1)
		self:SetBuyButtonActive("BtnMin", count > 1)
		self:SetBuyButtonActive("BtnPlus", count < self._T.buyMax)
		self:SetBuyButtonActive("BtnMax", count < self._T.buyMax)
		self:SetBuyButtonActive("BtnBuy", affordable >= count)
	end

	@ExecSpace("ClientOnly")
	method void CloseBuyQuantity()
		-- 취소/상점 닫기/탭 전환에서는 서버 구매 요청을 보내지 않는다.
		if isvalid(self.buyPopup) then self.buyPopup.Enable = false end
		self._T.buyItem = ""
	end

	@ExecSpace("ClientOnly")
	method void ConfirmBuyQuantity()
		-- 표시했던 단가를 서버에 전달한다. 클릭 즉시 모달을 닫아 중복 확인을 막는다.
		if not isvalid(self.buyPopup) or not self.buyPopup.Enable then return end
		local player = _UserService.LocalPlayer
		local inv = isvalid(player) and player:GetComponent("script.PlayerInventory") or nil
		local itemName = self._T.buyItem or ""
		if not isvalid(inv) or itemName == "" then return end
		local count = self._T.buyCount or 1
		local price = self._T.buyPrice or 0
		self:CloseBuyQuantity()
		inv:ServerRequestBuyQuantity(itemName, count, price)
	end

end

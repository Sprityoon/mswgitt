@Logic
script UI8Skin extends Logic
	-- ui8 스킨 런타임 헬퍼 (클라 전용). 스킨은 두 가지다.
	--  ① 조각: "Skin" 자식(조각 스프라이트 묶음). 본체 스프라이트가 투명이라 ButtonComponent ColorTint 호버가
	--     보이지 않으므로 여기서 호버·누름 색을 조각에 직접 칠한다.
	--  ② 통째: 자기 글자가 있는 버튼·탭·줄은 본체 스프라이트가 ui8 통째 그림이다(호버는 ColorTint 그대로).
	-- 선택/비활성 같은 상태 전환은 둘 다 SetVariant / Pick 으로 그림을 바꾼다(호출부는 Skin 이 없으면 기존 색칠로 폴백).
	-- 조각 조립은 scripts/ui8_kit.cjs, RUID 표는 scripts/ui8_apply_20261017.cjs 가 아래 표시 사이에 생성한다.

	property Color HoverTint = Color(1, 0.93, 0.76, 1)
	property Color PressTint = Color(0.82, 0.78, 0.72, 1)
	-- 변형 이름 → { 조각 이름 → RUID }
	property table variants = {}
	-- "c" 조각 RUID → 변형 이름 (조각 스킨의 현재 변형 역조회)
	property table byCenter = {}
	-- 통째 그림 RUID → 변형 이름 (통째 스킨의 현재 변형 역조회)
	property table byFull = {}
	-- 엔티티 Id → { entity, eh(버튼 상태 이벤트 핸들러) }
	property table bound = {}
	-- 엔티티 Id → true : 호버 칠하기 잠금(비활성 버튼)
	property table locked = {}
	property integer scanTimer = 0

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 변형 표를 만들고, 열린 UI 를 주기적으로 훑어 Skin 버튼에 호버 색을 연결한다.
		self.variants = self:BuildVariants()
		for name, v in pairs(self.variants) do
			if v.c ~= nil then self.byCenter[v.c] = name end
			if v.full ~= nil then self.byFull[v.full] = name end
		end
		self:Scan()
		self.scanTimer = _TimerService:SetTimerRepeat(function() self:Scan() end, 1)
		log("[VRF][UI8] skin logic ready variants=" .. tostring(self:CountVariants()))
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- 타이머와 버튼 이벤트를 정리한다.
		if self.scanTimer ~= 0 then _TimerService:ClearTimer(self.scanTimer) end
		for _, rec in pairs(self.bound) do
			if isvalid(rec.entity) and rec.eh ~= nil then rec.entity:DisconnectEvent(ButtonStateChangeEvent, rec.eh) end
		end
		self.bound = {}
	end

	method integer CountVariants()
		-- 변형 개수(로그용).
		local n = 0
		for _ in pairs(self.variants) do n = n + 1 end
		return n
	end

	@ExecSpace("ClientOnly")
	method void Scan()
		-- 켜져 있는 UI 를 훑어 아직 연결하지 않은 Skin 버튼을 연결하고, 사라진 엔티티는 지운다.
		for id, rec in pairs(self.bound) do
			if not isvalid(rec.entity) then self.bound[id] = nil end
		end
		local roots = { "/ui/PopupGroup", "/ui/HUDGroup", "/ui/DialogGroup", "/ui/NamingGroup", "/ui/AnvilGroup", "/ui/SettingsGroup" }
		for _, p in ipairs(roots) do
			local e = _EntityService:GetEntityByPath(p)
			if isvalid(e) then self:Walk(e) end
		end
	end

	@ExecSpace("ClientOnly")
	method void Walk(Entity e)
		-- 꺼진 가지는 건너뛴다(열릴 때 다음 훑기에서 연결).
		if not e.Enable then return end
		if e.Name == "Skin" then return end
		if self.bound[e.Id] == nil and isvalid(e.ButtonComponent) then
			local skin = e:GetChildByName("Skin")
			if isvalid(skin) then self:Bind(e) end
		end
		for _, c in ipairs(e.Children:ToTable()) do
			self:Walk(c)
		end
	end

	@ExecSpace("ClientOnly")
	method void Bind(Entity e)
		-- 버튼 상태 변화(호버·누름)를 조각 색으로 옮긴다.
		local target = e
		local h = e:ConnectEvent(ButtonStateChangeEvent, function(ev)
			self:OnButtonState(target, ev.state)
		end)
		self.bound[e.Id] = { entity = e, eh = h }
	end

	@ExecSpace("ClientOnly")
	method void OnButtonState(Entity e, any state)
		-- 호버=따뜻한 골드, 누름=어둡게, 나머지=원래색.
		if not isvalid(e) or self.locked[e.Id] then return end
		local tint = Color(1, 1, 1, 1)
		if state == ButtonState.Hover then
			tint = self.HoverTint
		elseif state == ButtonState.Pressed then
			tint = self.PressTint
		end
		self:Tint(e, tint)
	end

	@ExecSpace("ClientOnly")
	method void Tint(Entity e, Color tint)
		-- Skin 조각 전부에 같은 색을 곱한다.
		local skin = e:GetChildByName("Skin")
		if not isvalid(skin) then return end
		for _, p in ipairs(skin.Children:ToTable()) do
			local s = p.SpriteGUIRendererComponent
			if isvalid(s) then s.Color = Color(tint.r, tint.g, tint.b, s.Color.a) end
		end
	end

	@ExecSpace("ClientOnly")
	method boolean HasSkin(Entity e)
		-- ui8 스킨(조각 Skin 자식 또는 통째 그림)인지.
		if not isvalid(e) then return false end
		if isvalid(e:GetChildByName("Skin")) then return true end
		local s = e.SpriteGUIRendererComponent
		if not isvalid(s) then return false end
		return self.byFull[s.ImageRUID.DataId] ~= nil
	end

	@ExecSpace("ClientOnly")
	method string GetVariant(Entity e)
		-- 현재 변형 이름(조각은 가운데 조각, 통째는 본체 RUID 역조회). 모르면 "".
		local skin = e:GetChildByName("Skin")
		if not isvalid(skin) then
			local s = e.SpriteGUIRendererComponent
			if not isvalid(s) then return "" end
			local fn = self.byFull[s.ImageRUID.DataId]
			if fn == nil then return "" end
			return fn
		end
		local c = skin:GetChildByName("c")
		if not isvalid(c) then return "" end
		local name = self.byCenter[c.SpriteGUIRendererComponent.ImageRUID.DataId]
		if name == nil then return "" end
		return name
	end

	@ExecSpace("ClientOnly")
	method boolean SetVariant(Entity e, string name)
		-- 조각 이미지를 변형 name 으로 바꾼다. 조각 구성이 다른 변형(9↔3)은 없는 조각을 건너뛴다.
		if not isvalid(e) then return false end
		local v = self.variants[name]
		if v == nil then
			log_warning("[UI8] unknown variant " .. name)
			return false
		end
		local skin = e:GetChildByName("Skin")
		if not isvalid(skin) then
			-- 통째 스킨: 본체 그림을 바꾸고 색은 원래대로.
			local s = e.SpriteGUIRendererComponent
			if not isvalid(s) or v.full == nil then return false end
			s.ImageRUID = v.full
			s.Color = Color(1, 1, 1, s.Color.a)
			return true
		end
		for k, r in pairs(v) do
			local p = skin:GetChildByName(k)
			if isvalid(p) then p.SpriteGUIRendererComponent.ImageRUID = r end
		end
		return true
	end

	@ExecSpace("ClientOnly")
	method boolean Pick(Entity e, boolean on, string onVariant, string offVariant)
		-- 선택/해제 같은 두 상태 전환. Skin 이 없으면 false — 호출부가 기존 색 칠하기로 처리한다.
		if not self:HasSkin(e) then return false end
		if on then
			self:SetVariant(e, onVariant)
		else
			self:SetVariant(e, offVariant)
		end
		return true
	end

	@ExecSpace("ClientOnly")
	method void SetLocked(Entity e, boolean on)
		-- 비활성 버튼은 호버 색을 칠하지 않고 원래색으로 둔다.
		if not isvalid(e) then return end
		if on then
			self.locked[e.Id] = true
			self:Tint(e, Color(1, 1, 1, 1))
		else
			self.locked[e.Id] = nil
		end
	end

	method table BuildVariants()
		-- 생성 영역(손으로 고치지 말 것 — scripts/ui8_apply_20261017.cjs 가 다시 쓴다).
		local t = {}
		-- [UI8-VARIANTS-BEGIN]
		t["popup_frame"] = { full = "a9803eda3ef94f27afa4288f6384b974", tl = "fc86ce9c1f8647a3a20ddea40fc6ad43", t = "16a36296620b456e82cf5dc9d404adb6", tr = "6e1ac317cb084c908a58fc27e1ad19c4", l = "5c6e925ece724be482abb19f51b775dc", c = "232350c1a4a645f6a670319b699ed044", r = "f79d70ad9fca43cdbd5ee48cbf1d01f9", bl = "49d68773812846368bdb76ae9760a816", b = "a604a4fcbf76445eab1bb0686a980134", br = "4e6f76c9f0d34495a9a99dc29512a260" }

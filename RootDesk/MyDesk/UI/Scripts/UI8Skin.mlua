		t["dialog_frame"] = { full = "6c14a296c624476f901975526e731bfc", tl = "0d15aa6b5ae74c38953e5840c91ff440", t = "8fc86fd6fe864981906228bb29ba26ba", tr = "312c6d7139b94ae880c109f676a7858e", l = "d7cf60a82ad648e99c311866071c0766", c = "30f2f4633e8f4aa29a5ce5807523b63f", r = "bcee9cd5f5394993b77b27bdee59b18d", bl = "aea45a016f114e2d9a4f8123ebdfc569", b = "632df6814c7f496ab40913766db7c34f", br = "18fa4cbce86b4cb4862b9f57a49ac3af" }
		t["darkwood_filigree"] = { full = "66eb734bb7e14bd799c4ca822d62ef1b", tl = "bdb8c319edfc4563b681a9e34c289594", t = "d5a65abeace34f3a90edd9929846eb3e", tr = "e750aa0fb3e8446383eaa49bcb88b615", l = "c6664b8b19e34123a7642ad966e2797e", c = "1451707c05454c3898e1a0573314b2ca", r = "9beffab73ead4d76a45980098121e823", bl = "d6a0b823332d47c7b8d00836090a77a1", b = "264a92e44385407581ed75e63e95da34", br = "a8b64b9d6f8c4abda0f3ba2605bc0cd7" }

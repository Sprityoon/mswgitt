@Logic
script UI8Skin extends Logic
	-- ui8 스킨 런타임 헬퍼 (클라 전용). 스킨은 두 가지다.
	--  ① 조각: "Skin" 자식(조각 스프라이트 묶음). 본체 스프라이트가 투명이라 ButtonComponent ColorTint 호버가
	--     보이지 않으므로 여기서 호버·누름 색을 조각에 직접 칠한다.
	--  ② 통째: 자기 글자가 있는 버튼·탭·줄은 본체 스프라이트가 ui8 통째 그림이다(호버는 ColorTint 그대로).
	-- 선택/비활성 같은 상태 전환은 둘 다 SetVariant / Pick 으로 그림을 바꾼다(호출부는 Skin 이 없으면 기존 색칠로 폴백).
	-- 조각 조립은 scripts/ui8_kit.cjs, RUID 표는 scripts/ui8_apply_20261017.cjs 가 아래 표시 사이에 생성한다.

	property Color HoverTint = Color(1, 0.93, 0.76, 1)
	property Color PressTint = Color(0.82, 0.78, 0.72, 1)
	-- 변형 이름 → { 조각 이름 → RUID }
	property table variants = {}
	-- "c" 조각 RUID → 변형 이름 (조각 스킨의 현재 변형 역조회)
	property table byCenter = {}
	-- 통째 그림 RUID → 변형 이름 (통째 스킨의 현재 변형 역조회)
	property table byFull = {}
	-- 엔티티 Id → { entity, eh(버튼 상태 이벤트 핸들러) }
	property table bound = {}
	-- 엔티티 Id → true : 호버 칠하기 잠금(비활성 버튼)
	property table locked = {}
	property integer scanTimer = 0
	-- 조각 RUID → { w, h, e } (여백 뺀 원래 크기·여백 텍셀, ui8_bleed.json). 판 맞춤(FitSkin)에 쓴다.
	property table bleed = {}
	-- Skin 엔티티 Id → { skin, host, w, h } : 판 크기 변화 감시 대상과 마지막으로 맞춘 크기
	property table fits = {}

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 변형 표를 만들고, 열린 UI 를 주기적으로 훑어 Skin 버튼에 호버 색을 연결한다.
		self.variants = self:BuildVariants()
		for name, v in pairs(self.variants) do
			if v.c ~= nil then self.byCenter[v.c] = name end
			if v.full ~= nil then self.byFull[v.full] = name end
		end
		self.bleed = self:BuildBleed()
		self:Scan()
		self.scanTimer = _TimerService:SetTimerRepeat(function() self:Scan() end, 1)
		local nFit = 0
		for _ in pairs(self.fits) do nFit = nFit + 1 end
		log("[VRF][UI8] skin logic ready variants=" .. tostring(self:CountVariants()) .. " fitSkins=" .. tostring(nFit))
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- 판 실금 방지: 컨트롤러가 런타임에 판 크기를 바꾸면(포탈 목록·제작대·툴팁 등) 늘어나는 조각의 여백이
		-- .ui 저장 크기 기준이라 그림이 안쪽으로 밀려 조각 사이에 틈이 생긴다(2026-10-21) → 크기가 바뀐 판만 다시 맞춘다.
		for id, rec in pairs(self.fits) do
			local host = rec.host
			if not isvalid(rec.skin) or not isvalid(host) then
				self.fits[id] = nil
			elseif host.EnabledInHierarchy then
				local rs = host.UITransformComponent.RectSize
				if rs.x ~= rec.w or rs.y ~= rec.h then
					self:FitSkin(host)
				end
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- 타이머와 버튼 이벤트를 정리한다.
		if self.scanTimer ~= 0 then _TimerService:ClearTimer(self.scanTimer) end
		for _, rec in pairs(self.bound) do
			if isvalid(rec.entity) and rec.eh ~= nil then rec.entity:DisconnectEvent(ButtonStateChangeEvent, rec.eh) end
		end
		self.bound = {}
	end

	method integer CountVariants()
		-- 변형 개수(로그용).
		local n = 0
		for _ in pairs(self.variants) do n = n + 1 end
		return n
	end

	@ExecSpace("ClientOnly")
	method void Scan()
		-- 켜져 있는 UI 를 훑어 아직 연결하지 않은 Skin 버튼을 연결하고, 사라진 엔티티는 지운다.
		for id, rec in pairs(self.bound) do
			if not isvalid(rec.entity) then self.bound[id] = nil end
		end
		local roots = { "/ui/PopupGroup", "/ui/HUDGroup", "/ui/DialogGroup", "/ui/NamingGroup", "/ui/AnvilGroup", "/ui/SettingsGroup", "/ui/TooltipGroup" }
		for _, p in ipairs(roots) do
			local e = _EntityService:GetEntityByPath(p)
			if isvalid(e) then
				self:WalkFits(e)
				self:Walk(e)
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void WalkFits(Entity e)
		-- 판 맞춤 감시 대상 등록. 꺼진 가지도 훑는다(창을 여는 순간 크기가 바뀌므로 미리 알고 있어야 한다).
		if e.Name == "Skin" then
			if self.fits[e.Id] == nil and isvalid(e.Parent) and isvalid(e.Parent.UITransformComponent) then
				-- w/h = -1 : 다음 OnUpdate 에서 한 번 맞춘다(같은 크기면 저장값 그대로 나온다).
				self.fits[e.Id] = { skin = e, host = e.Parent, w = -1, h = -1 }
			end
			return
		end
		for _, c in ipairs(e.Children:ToTable()) do
			self:WalkFits(c)
		end
	end

	@ExecSpace("ClientOnly")
	method any PieceInfo(Entity p)
		-- 조각 RUID 의 { w, h, e }. 여백 조각(ui8b_)이 아니면 nil.
		if not isvalid(p) or not isvalid(p.SpriteGUIRendererComponent) then return nil end
		return self.bleed[p.SpriteGUIRendererComponent.ImageRUID.DataId]
	end

	@ExecSpace("ClientOnly")
	method number ArtSize(Entity p, boolean xAxis)
		-- 고정 크기 조각(모서리·3조각 양 끝)의 그림 크기 = 표시 크기 / (1 + 2e/원래 크기).
		local info = self:PieceInfo(p)
		local rs = p.UITransformComponent.RectSize
		if xAxis then
			if info == nil then return rs.x end
			return rs.x / (1 + 2 * info.e / info.w)
		end
		if info == nil then return rs.y end
		return rs.y / (1 + 2 * info.e / info.h)
	end

	@ExecSpace("ClientOnly")
	method void FitSkin(Entity host)
		-- host 아래 Skin 의 늘어나는 조각(c·t·b·l·r)을 host 현재 크기에 맞춰 다시 놓는다.
		-- 그림 경계는 ui8_kit.skin9/skin3 과 같은 규칙: 모서리(양 끝) 그림 크기 L/R/T/B 에서 겹침 o 만큼 안쪽.
		-- 여백 폭 = e × (그 축 그림 길이) / 원래 크기. 규칙 10(stretch 를 믿지 않음)에 따라 Offset·RectSize·위치 모두 명시.
		if not isvalid(host) or not isvalid(host.UITransformComponent) then return end
		local skin = host:GetChildByName("Skin")
		if not isvalid(skin) or not isvalid(skin.UITransformComponent) then return end
		local hs = host.UITransformComponent.RectSize
		local rec = self.fits[skin.Id]
		if rec == nil then
			rec = { skin = skin, host = host }
			self.fits[skin.Id] = rec
		end
		rec.w = hs.x
		rec.h = hs.y

		-- Skin 컨테이너: 가로는 host 폭, 세로는 host 높이(3조각 가운데 정렬 판이면 저장된 높이 그대로).
		local st = skin.UITransformComponent
		local sw = hs.x
		local sh = hs.y
		if (st.AnchorsMax.y - st.AnchorsMin.y) < 0.5 then sh = st.OffsetMax.y - st.OffsetMin.y end
		st.RectSize = Vector2(sw, sh)

		local tl = skin:GetChildByName("tl")
		local nine = isvalid(tl)
		local L = 0
		local R = 0
		local T = 0
		local B = 0
		local o = 4
		if nine then
			L = self:ArtSize(tl, true)
			T = self:ArtSize(tl, false)
			R = self:ArtSize(skin:GetChildByName("tr"), true)
			B = self:ArtSize(skin:GetChildByName("bl"), false)
		else
			local l = skin:GetChildByName("l")
			local r = skin:GetChildByName("r")
			if not isvalid(l) or not isvalid(r) then return end
			L = self:ArtSize(l, true)
			R = self:ArtSize(r, true)
			o = math.min(2, math.floor(math.min(L, R) / 2 + 0.001))
		end
		-- 그림 경계(판 가장자리 기준 Offset): 가로 [L-o, -(R-o)], 세로는 9조각 [B-o, -(T-o)] / 3조각 [0, 0]
		local loX = L - o
		local hiX = -(R - o)
		local loY = 0
		local hiY = 0
		if nine then
			loY = B - o
			hiY = -(T - o)
		end
		for _, name in ipairs({ "c", "t", "b", "l", "r" }) do
			local p = skin:GetChildByName(name)
			local info = self:PieceInfo(p)
			if info ~= nil and isvalid(p.UITransformComponent) then
				local t = p.UITransformComponent
				local sx = (t.AnchorsMax.x - t.AnchorsMin.x) > 0.5
				local sy = (t.AnchorsMax.y - t.AnchorsMin.y) > 0.5
				local mn = t.OffsetMin
				local mx = t.OffsetMax
				local minX, maxX, minY, maxY = mn.x, mx.x, mn.y, mx.y
				if sx then
					local m = info.e * (sw - loX + hiX) / info.w
					minX = loX - m
					maxX = hiX + m
				end
				if sy then
					local m = info.e * (sh - loY + hiY) / info.h
					minY = loY - m
					maxY = hiY + m
				end
				local w = maxX - minX
				local h = maxY - minY
				if sx then w = w + sw end
				if sy then h = h + sh end
				local pv = t.Pivot
				t.OffsetMin = Vector2(minX, minY)
				t.OffsetMax = Vector2(maxX, maxY)
				t.RectSize = Vector2(w, h)
				t.anchoredPosition = Vector2(minX * (1 - pv.x) + maxX * pv.x, minY * (1 - pv.y) + maxY * pv.y)
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void Walk(Entity e)
		-- 꺼진 가지는 건너뛴다(열릴 때 다음 훑기에서 연결).
		if not e.Enable then return end
		if e.Name == "Skin" then return end
		if self.bound[e.Id] == nil and isvalid(e.ButtonComponent) then
			local skin = e:GetChildByName("Skin")
			if isvalid(skin) then self:Bind(e) end
		end
		for _, c in ipairs(e.Children:ToTable()) do
			self:Walk(c)
		end
	end

	@ExecSpace("ClientOnly")
	method void Bind(Entity e)
		-- 버튼 상태 변화(호버·누름)를 조각 색으로 옮긴다.
		local target = e
		local h = e:ConnectEvent(ButtonStateChangeEvent, function(ev)
			self:OnButtonState(target, ev.state)
		end)
		self.bound[e.Id] = { entity = e, eh = h }
	end

	@ExecSpace("ClientOnly")
	method void OnButtonState(Entity e, any state)
		-- 호버=따뜻한 골드, 누름=어둡게, 나머지=원래색.
		if not isvalid(e) or self.locked[e.Id] then return end
		local tint = Color(1, 1, 1, 1)
		if state == ButtonState.Hover then
			tint = self.HoverTint
		elseif state == ButtonState.Pressed then
			tint = self.PressTint
		end
		self:Tint(e, tint)
	end

	@ExecSpace("ClientOnly")
	method void Tint(Entity e, Color tint)
		-- Skin 조각 전부에 같은 색을 곱한다.
		local skin = e:GetChildByName("Skin")
		if not isvalid(skin) then return end
		for _, p in ipairs(skin.Children:ToTable()) do
			local s = p.SpriteGUIRendererComponent
			if isvalid(s) then s.Color = Color(tint.r, tint.g, tint.b, s.Color.a) end
		end
	end

	@ExecSpace("ClientOnly")
	method boolean HasSkin(Entity e)
		-- ui8 스킨(조각 Skin 자식 또는 통째 그림)인지.
		if not isvalid(e) then return false end
		if isvalid(e:GetChildByName("Skin")) then return true end
		local s = e.SpriteGUIRendererComponent
		if not isvalid(s) then return false end
		return self.byFull[s.ImageRUID.DataId] ~= nil
	end

	@ExecSpace("ClientOnly")
	method string GetVariant(Entity e)
		-- 현재 변형 이름(조각은 가운데 조각, 통째는 본체 RUID 역조회). 모르면 "".
		local skin = e:GetChildByName("Skin")
		if not isvalid(skin) then
			local s = e.SpriteGUIRendererComponent
			if not isvalid(s) then return "" end
			local fn = self.byFull[s.ImageRUID.DataId]
			if fn == nil then return "" end
			return fn
		end
		local c = skin:GetChildByName("c")
		if not isvalid(c) then return "" end
		local name = self.byCenter[c.SpriteGUIRendererComponent.ImageRUID.DataId]
		if name == nil then return "" end
		return name
	end

	@ExecSpace("ClientOnly")
	method boolean SetVariant(Entity e, string name)
		-- 조각 이미지를 변형 name 으로 바꾼다. 조각 구성이 다른 변형(9↔3)은 없는 조각을 건너뛴다.
		if not isvalid(e) then return false end
		local v = self.variants[name]
		if v == nil then
			log_warning("[UI8] unknown variant " .. name)
			return false
		end
		local skin = e:GetChildByName("Skin")
		if not isvalid(skin) then
			-- 통째 스킨: 본체 그림을 바꾸고 색은 원래대로.
			local s = e.SpriteGUIRendererComponent
			if not isvalid(s) or v.full == nil then return false end
			s.ImageRUID = v.full
			s.Color = Color(1, 1, 1, s.Color.a)
			return true
		end
		for k, r in pairs(v) do
			local p = skin:GetChildByName(k)
			if isvalid(p) then p.SpriteGUIRendererComponent.ImageRUID = r end
		end
		-- 변형마다 조각 원래 크기가 달라 여백 폭도 다르다 → 바꾼 그림 기준으로 다시 맞춘다.
		self:FitSkin(e)
		return true
	end

	@ExecSpace("ClientOnly")
	method boolean Pick(Entity e, boolean on, string onVariant, string offVariant)
		-- 선택/해제 같은 두 상태 전환. Skin 이 없으면 false — 호출부가 기존 색 칠하기로 처리한다.
		if not self:HasSkin(e) then return false end
		if on then
			self:SetVariant(e, onVariant)
		else
			self:SetVariant(e, offVariant)
		end
		return true
	end

	@ExecSpace("ClientOnly")
	method void SetLocked(Entity e, boolean on)
		-- 비활성 버튼은 호버 색을 칠하지 않고 원래색으로 둔다.
		if not isvalid(e) then return end
		if on then
			self.locked[e.Id] = true
			self:Tint(e, Color(1, 1, 1, 1))
		else
			self.locked[e.Id] = nil
		end
	end

	method table BuildVariants()
		-- 생성 영역(손으로 고치지 말 것 — scripts/ui8_apply_20261017.cjs 가 다시 쓴다).
		local t = {}
		-- [UI8-VARIANTS-BEGIN]
		t["popup_frame"] = { full = "a9803eda3ef94f27afa4288f6384b974", tl = "b0c98dd657ea42b28d625f8d7944ee44", t = "3aa6482bb2c847adbd93972341b6ae8a", tr = "6435a073e54c485faf33389e9794b972", l = "2aeaf41c268544cbaecf0a9a5b9f5318", c = "41a50d5d2f2d4aefae334423489276e8", r = "1e38677aa5db4748bdd12f46aec7330b", bl = "a8ecc9ccdff24ff192198cba54c1b0eb", b = "1b02a9180c5545bf8e02c2f1dd512bf3", br = "b935725a41264ebfb5c607feb6b5f138" }
		t["subpanel"] = { full = "c0a5ff7d776e42b0a44ebe720422864e", tl = "5fdd5d92bdb54d1ab8c085e7d9eb0f67", t = "8775a679bbeb41baa26208968ac72126", tr = "ca9ebd847288490e9c7c267ca393f46d", l = "2b06e29c43104fb6b2127cbcb5b2e0ce", c = "9c6d0fc981af48b48d05cbbdb8248117", r = "3eda4af5862943f7a97ce4641be6b9f4", bl = "ba294aec71e24c06abe78b028cd83f38", b = "44e599d80e494832bd2477badc4fa830", br = "22a1965480bf4afcbc02fde23645cf67" }
		t["dialog_frame"] = { full = "6c14a296c624476f901975526e731bfc", tl = "09e04aaa36f9495889123d2660c1edbf", t = "ef3cb2a3b1f944e7b6235609f03ca0cd", tr = "6a4d8b2c48224e50b9a5d3110ef2f613", l = "8f5b6a999aea4aa799d07baa20f9f978", c = "50cf6992ae154d48a9de502234fe4aa9", r = "083e1344f5164900883c5b72854b691b", bl = "7b5931900505454a9921c4b3669e7145", b = "7aa9da181c6f4cd2b8500c1078bae7f5", br = "d6d74e14f59b467fb8ea6509e977623c" }
		t["darkwood_filigree"] = { full = "66eb734bb7e14bd799c4ca822d62ef1b", tl = "75ff35e3652f4eb39015852ce8c95a18", t = "14d212ce51ca45d5a32ef8fdb257ca7d", tr = "6c89eb52d81148f49c7d96be6f7bb2ed", l = "369614535b7e4471859c0ed7f8655038", c = "3cedab48e36c41f1bb29372f07419b61", r = "14297f3c6ab94451b90d8bd5924b0483", bl = "1b5f0056743c4f49acb2530411417aa0", b = "26a26849c60445da8b943ea63cf1fede", br = "74e96616cd31481f991317e414fd83ae" }
		t["fish_board"] = { full = "fb5eb5c3436449668aef3ddb7cd38842", tl = "baa70560b5b849dab41a916b88809d6f", t = "7f888a51ac594d3daa5c7cf226d9d861", tr = "ec8699c78dbf41c6ab90dcc8af0ddf8d", l = "dc8dc261d6844e228962f33a55d08e97", c = "bba4569533ef45e8b2b39fbe84a7010b", r = "0ba332ee427d412a8c96fda7db5c4e71", bl = "c7b177f3e2fb472ca6dade7ee80a33d6", b = "74d8931fb2214842b143b91747401141", br = "3c196296120b47b8accae6c9dd9aa29c" }
		t["status_card"] = { full = "82b714a1f6f04812b5d2075234184bfe", tl = "b166894fd405484cad1001941851eb34", t = "3ef2e62949f9487eab6c70560de7ec72", tr = "61c1dd57e4254795842b99b9a00268f0", l = "5729f9dd82c745848b821a2cfc829288", c = "de3cd22b8a354e7abd2f7773363ef093", r = "a69a735460c74a72a6247c6c99490d51", bl = "51d54717dac548a8be6f85c79f97e903", b = "57f744c65d054086af38ebfe6c1f4c17", br = "687174987c0346e7a95a14dc212f93e9" }

		t["status_card"] = { full = "82b714a1f6f04812b5d2075234184bfe", tl = "105e24187ee14d7b960a08436e47c358", t = "2c604d95a00f41bb98dceeda0b939ec8", tr = "527e52a031e84326a5664b064134cd49", l = "5d3b40cee14b4617b3ae40d47568f3bd", c = "b12bc680eb21494db3f36a4a853c62b5", r = "264b7c48626b4c16b1c50961a6cdc275", bl = "f39b1d5f48c24a729157625cac96fc3a", b = "541f0e7bb7b849999086e3e7f6eb5249", br = "75fd3d645ced44e5bbb6c2827334ada9" }

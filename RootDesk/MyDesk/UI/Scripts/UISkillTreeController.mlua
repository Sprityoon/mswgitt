@Component
script UISkillTreeController extends Component

	-- SkillTreePopup: SkillDataSet의 TreeRow/TreeCol 좌표로 노드를 배치하고 노드 4상태
	-- (잠김 / 목표 진행 중 / 해금 가능 / 보유)를 렌더링한다. (docs/design/skill-tree-plan.md §2 UI)
	-- T45: 보유 스킬 선택 → QWER 장착 버튼 + 현재 장착 슬롯 표시.
	-- T47: 노드 클릭=선택/상세만 · SP 투자는 [레벨업] 버튼만.
	-- T50: 노드=아이콘 칩+Lv 뱃지 · 상세=우측 SkillDetailPanel · EquipBar DetailText 이관.

	property Entity btnClose = "da9d3a55-39ec-42c3-8e38-14c714c3cf71"

	property Entity spText = "4e3d8f52-1eec-4615-8d8d-2b68360f4b6b"

	property ButtonComponent btnEquipQ = "ad27c86b-d307-4ce1-99cb-92e8dd5685b3"
	property ButtonComponent btnEquipW = "cc23b1a5-be5c-4772-8ca1-01bc64033a6b"
	property ButtonComponent btnEquipE = "3deee177-323d-49b5-9c3d-ff5fbde0eea7"
	property ButtonComponent btnEquipR = "61e8acd4-707c-4da1-8a43-a9457da438c0"
	property Entity btnLevelUp = "e0252252-4361-4d90-b2f1-7aec1cf80bec"

	property integer MaxRows = 3

	-- 목록형 UI 풀 크기 (.ui 의 Row_* / Sec_* 개수와 일치해야 한다)
	property integer RowPoolSize = 24

	property integer SecPoolSize = 5

	-- 목록 배치 수치 (.ui 저작값과 일치)
	property number RowPitch = 50.0

	property number SecPitch = 38.0

	property integer MaxCols = 3

	property any closeHandler = nil

	property any levelUpHandler = nil

	property table nodeHandlers = {}
	property table nodeHoverHandlers = {}
	property table equipHandlers = {}

	-- 행 슬롯 인덱스("1".."24") -> skillId (Refresh 시 CSV 기준으로 재구성)
	property table nodeSkillMap = {}

	property string selectedSkillId = ""
	property string selectedJobId = ""

	-- 선택된 계열 탭. "" 이면 Refresh 때 첫 계열로 맞춘다.
	property string selectedCat = ""

	-- 현재 직업 탭에 존재하는 계열 키 목록 (탭 버튼 라벨의 원본)
	property table catList = {}

	-- 목록 칸(548px)에 실제로 보이는 행 수. 마스크를 못 쓰므로(규칙 49)
	-- 넘치는 행은 그리지 않고 잘라낸다.
	property integer VisibleRowCount = 10

	-- 호버 미리보기 중이면 선택 대신 이 skillId를 패널에 표시
	property string hoverSkillId = ""

	property number RefreshAccum = 0.0

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		self.Entity.Enable = false
		self:ResolveEquipRefs()
		self:ResolveDetailRefs()

		if isvalid(self.btnClose) then
			self.closeHandler = self.btnClose:ConnectEvent(ButtonClickEvent, self.OnCloseClicked)
		end

		self:SetupNodeEvents()
		self:SetupJobTabs()
		self:SetupCatTabs()
		self:SetupEquipButtons()
		self:SetupLevelUpButton()
		self:RefreshDetailPanel("")
	end

	@ExecSpace("ClientOnly")
	method void ResolveEquipRefs()
		-- 경로 해석으로 장착 바 자식 확보 (UUID 폴백).
		self._T.btnQE = self.Entity:GetChildByName("BtnQ", true)
		self._T.btnWE = self.Entity:GetChildByName("BtnW", true)
		self._T.btnEE = self.Entity:GetChildByName("BtnE", true)
		self._T.btnRE = self.Entity:GetChildByName("BtnR", true)
		self._T.btnLevelUpE = self.Entity:GetChildByName("BtnLevelUp", true)
		if not isvalid(self._T.btnLevelUpE) and isvalid(self.btnLevelUp) then
			self._T.btnLevelUpE = self.btnLevelUp
		end
	end

	@ExecSpace("ClientOnly")
	method void ResolveDetailRefs()
		-- T50: SkillDetailPanel 자식 (경로 해석). T58: DParent 선행 줄.
		self._T.detailPanel = self.Entity:GetChildByName("SkillDetailPanel", true)
		self._T.dIcon = self.Entity:GetChildByName("DIcon", true)
		self._T.dName = self.Entity:GetChildByName("DName", true)
		self._T.dTypeLv = self.Entity:GetChildByName("DTypeLv", true)
		self._T.dDesc = self.Entity:GetChildByName("DDesc", true)
		self._T.dParent = self.Entity:GetChildByName("DParent", true)
		self._T.dUnlock = self.Entity:GetChildByName("DUnlock", true)
		self._T.dGate = self.Entity:GetChildByName("DGate", true)
		self._T.dCost = self.Entity:GetChildByName("DCost", true)
	end

	method integer GetParentRequiredLevelFromRow(any row)
		-- ParentRequiredLevel 컬럼 (공란/누락=1). pcall 가드 — 규칙 7.
		if row == nil then return 1 end
		local ok, raw = pcall(function() return row:GetItem("ParentRequiredLevel") end)
		if not ok or raw == nil or tostring(raw) == "" then return 1 end
		local n = math.floor(tonumber(raw) or 1)
		if n < 1 then n = 1 end
		return n
	end

	method integer GetParentRequiredLevelFromDs(any ds, integer rowIndex)
		-- GetCell 경로 폴백 (공란/누락=1).
		if ds == nil then return 1 end
		local ok, raw = pcall(function() return ds:GetCell(rowIndex, "ParentRequiredLevel") end)
		if not ok or raw == nil or tostring(raw) == "" then return 1 end
		local n = math.floor(tonumber(raw) or 1)
		if n < 1 then n = 1 end
		return n
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		if self.closeHandler and isvalid(self.btnClose) then
			self.btnClose:DisconnectEvent(ButtonClickEvent, self.closeHandler)
		end
		local levelBtn = self._T.btnLevelUpE
		if not isvalid(levelBtn) then levelBtn = self.btnLevelUp end
		if self.levelUpHandler and isvalid(levelBtn) then
			levelBtn:DisconnectEvent(ButtonClickEvent, self.levelUpHandler)
		end
		self.levelUpHandler = nil
		for ent, clickHandler in pairs(self.nodeHandlers) do
			if isvalid(ent) then
				ent:DisconnectEvent(ButtonClickEvent, clickHandler)
			end
		end
		self.nodeHandlers = {}
		for ent, h in pairs(self.nodeHoverHandlers) do
			if isvalid(ent) then
				ent:DisconnectEvent(ButtonStateChangeEvent, h)
			end
		end
		self.nodeHoverHandlers = {}
		for ent, h in pairs(self.equipHandlers) do
			if isvalid(ent) then
				ent:DisconnectEvent(ButtonClickEvent, h)
			end
		end
		self.equipHandlers = {}
	end

	@ExecSpace("ClientOnly")
	method void Toggle()
		if self.Entity.Enable then
			self:Close()
		else
			self:Open()
		end
	end

	@ExecSpace("ClientOnly")
	method void Open()
		self.Entity.Enable = true
		self:ResolveEquipRefs()
		self:ResolveDetailRefs()
		self.hoverSkillId = ""
		self:Refresh()
	end

	@ExecSpace("ClientOnly")
	method void Close()
		self.Entity.Enable = false
		self.hoverSkillId = ""
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- 열려 있는 동안 0.25초 주기로 갱신 (SP/업적 진행도 실시간 반영)
		if not self.Entity.Enable then return end
		self.RefreshAccum = self.RefreshAccum + delta
		if self.RefreshAccum < 0.25 then return end
		self.RefreshAccum = 0.0
		self:Refresh()
	end

	method any GetLocalPlayerController()
		local lp = _UserService.LocalPlayer
		if not isvalid(lp) then return nil end
		local pc = lp:GetComponent("script.PlayerController")
		if not isvalid(pc) then return nil end
		return pc
	end

	@ExecSpace("ClientOnly")
	method void SetupNodeEvents()
		-- 목록형: Row_1..RowPoolSize 버튼에 클릭/호버를 건다. 어떤 스킬이 실리는지는
		-- Refresh 가 rowSkillMap 으로 매 프레임 다시 정한다(행은 재사용되는 슬롯일 뿐).
		for i = 1, self.RowPoolSize do
			local row = self.Entity:GetChildByName("Row_" .. i, true)
			if isvalid(row) then
				local key = tostring(i)
				local clickHandler = row:ConnectEvent(ButtonClickEvent, function()
					self:OnNodeClicked(key)
				end)
				self.nodeHandlers[row] = clickHandler
				local hoverHandler = row:ConnectEvent(ButtonStateChangeEvent, function(ev)
					self:OnNodeHoverState(key, ev)
				end)
				self.nodeHoverHandlers[row] = hoverHandler
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void OnNodeHoverState(string key, ButtonStateChangeEvent ev)
		if ev == nil then return end
		local skillId = self.nodeSkillMap[key]
		if skillId == nil or skillId == "" then return end
		if ev.state == ButtonState.Hover then
			self.hoverSkillId = skillId
			self:RefreshDetailPanel(skillId)
		elseif ev.state == ButtonState.Normal or ev.state == ButtonState.Released then
			if self.hoverSkillId == skillId then
				self.hoverSkillId = ""
				self:RefreshDetailPanel(self.selectedSkillId or "")
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void SetupEquipButtons()
		-- T45: QWER 장착 버튼.
		local pairs_ = {
			{ ent = self._T.btnQE, slot = 1 },
			{ ent = self._T.btnWE, slot = 2 },
			{ ent = self._T.btnEE, slot = 3 },
			{ ent = self._T.btnRE, slot = 4 },
		}
		for _, p in ipairs(pairs_) do
			if isvalid(p.ent) then
				local slotIdx = p.slot
				local h = p.ent:ConnectEvent(ButtonClickEvent, function()
					self:OnEquipSlotClicked(slotIdx)
				end)
				self.equipHandlers[p.ent] = h
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void SetupLevelUpButton()
		-- T47: [레벨업] 버튼 — SP 투자의 유일한 진입점.
		local btn = self._T.btnLevelUpE
		if not isvalid(btn) then btn = self.btnLevelUp end
		if not isvalid(btn) then
			log_warning("[SKILL-TREE-UX] BtnLevelUp missing")
			return
		end
		if isvalid(btn.SpriteGUIRendererComponent) then
			btn.SpriteGUIRendererComponent.RaycastTarget = true
		end
		self.levelUpHandler = btn:ConnectEvent(ButtonClickEvent, function()
			self:OnLevelUpClicked()
		end)
		log("[SKILL-TREE-UX] BtnLevelUp wired")
	end

	@ExecSpace("ClientOnly")
	method void OnNodeClicked(string key)
		-- T47: 노드 클릭 = 선택/상세만 (SP 투자 없음).
		local skillId = self.nodeSkillMap[key]
		if skillId == nil or skillId == "" then return end

		self.selectedSkillId = skillId
		self.hoverSkillId = ""
		log("[SKILL-TREE-UX] select " .. skillId)
		self:Refresh()
	end

	@ExecSpace("ClientOnly")
	method void OnLevelUpClicked()
		-- T47: 선택된 스킬에만 ServerRequestSkillLevelUp (클라 게이트 통과 시).
		local skillId = self.selectedSkillId or ""
		if skillId == "" then return end

		local pc = self:GetLocalPlayerController()
		if pc == nil then return end
		---@type PlayerController
		local controller = pc

		local st = self:EvalLevelUpState(skillId, controller)
		if not st.can then
			log("[SKILL-TREE-UX] levelup blocked: " .. tostring(st.reason))
			return
		end

		log("[SKILL-TREE-UX] levelup request " .. skillId)
		controller:ServerRequestSkillLevelUp(skillId)
		self:Refresh()
	end

	method table EvalLevelUpState(string skillId, any pc)
		-- 클라 표시용 게이트 미러 (서버 ServerRequestSkillLevelUp과 동일 조건).
		-- returns { can, label, reason }
		local result = { can = false, label = "레벨업", reason = "스킬을 선택하세요" }
		if skillId == nil or skillId == "" then
			return result
		end
		---@type PlayerController
		local controller = pc
		if controller == nil then
			result.reason = "플레이어 없음"
			return result
		end

		local ds = _DataService:GetTable("SkillDataSet")
		if ds == nil then
			result.reason = "데이터 없음"
			return result
		end
		local row = ds:FindRow("SkillId", skillId)
		if row == nil then
			result.reason = "스킬 없음"
			return result
		end

		if not controller:IsSkillJobAllowed(row) then result.reason = "해당 직업 전직 필요" return result end
		local maxLevel = tonumber(row:GetItem("MaxLevel")) or 1
		local spCost = tonumber(row:GetItem("SPCost")) or 1
		local parentId = row:GetItem("ParentSkillId")
		local parentNeed = self:GetParentRequiredLevelFromRow(row)
		local reqLevel = tonumber(row:GetItem("RequiredLevel")) or 1
		local level = controller:GetSkillLevel(skillId)
		local label = "레벨업 (SP " .. tostring(spCost) .. ")"
		if level < 1 then
			if spCost <= 0 then
				label = "해금"
			else
				label = "해금 (SP " .. tostring(spCost) .. ")"
			end
		elseif spCost <= 0 then
			label = "레벨업"
		end

		if level >= maxLevel then
			result.label = "MAX"
			result.reason = "이미 최대 레벨"
			return result
		end
		if level < 1 then
			-- T58: 서버와 동일 — 부모 Lv ≥ ParentRequiredLevel
			if parentId ~= nil and parentId ~= "" then
				local parentLv = controller:GetSkillLevel(parentId)
				if parentLv < parentNeed then
					local parentName = parentId
					local pRow = ds:FindRow("SkillId", parentId)
					if pRow ~= nil then
						local pn = pRow:GetItem("Name")
						if pn ~= nil and pn ~= "" then parentName = tostring(pn) end
					end
					result.label = label
					result.reason = "선행 스킬 '" .. parentName .. "' Lv " .. tostring(parentNeed) .. " 필요"
					return result
				end
			end
			if controller.Level < reqLevel then
				result.label = label
				result.reason = "Lv." .. tostring(reqLevel) .. " 필요"
				return result
			end
			if not self:IsUnlockGateOpenClient(row, controller) then
				result.label = label
				result.reason = self:UnlockGateReasonClient(row, controller)
				return result
			end
		end
		if controller.SP < spCost then
			result.label = label
			result.reason = "SP 부족 (필요 " .. tostring(spCost) .. ")"
			return result
		end
		result.can = true
		result.label = label
		result.reason = ""
		return result
	end

	@ExecSpace("ClientOnly")
	method void OnEquipSlotClicked(integer slotIndex)
		-- 선택 스킬을 해당 슬롯에 장착. 이미 그 슬롯이면 해제.
		if self.selectedSkillId == nil or self.selectedSkillId == "" then return end
		local pc = self:GetLocalPlayerController()
		if pc == nil then return end
		---@type PlayerController
		local controller = pc
		if controller:GetSkillLevel(self.selectedSkillId) < 1 then return end

		local slots = controller:GetEquippedSlots()
		local equipId = self.selectedSkillId
		if slots[slotIndex] == equipId then
			equipId = ""
		end
		controller:ServerRequestEquipSkill(slotIndex, equipId)
		self:RefreshEquipDetail()
	end

	method string StripCsvQuotes(string s)
		if s == nil then return "" end
		local t = tostring(s)
		-- SkillDataSet Description 셀이 """...""" 형태로 올 수 있음
		while string.sub(t, 1, 1) == "\"" and string.sub(t, -1) == "\"" and #t >= 2 do
			t = string.sub(t, 2, -2)
		end
		return t
	end

	method string TypeDisplayLabel(string typeStr)
		-- 폴백. 상세 패널은 GetSkillKindLabel을 쓴다.
		if typeStr == nil then return "액티브" end
		if typeStr == "Passive" then return "패시브" end
		return "액티브"
	end

	@ExecSpace("ClientOnly")
	method void SetTextSafe(Entity ent, string text, boolean show)
		-- 이 패널은 레거시 TextComponent 와 TextGUIRendererComponent 가 섞여 있다.
		-- (DName/DTypeLv 는 렌더 불량으로 재생성하면서 GUI 렌더러가 됐다.)
		-- 둘 다 지원해야 조용히 글자가 안 바뀌는 사고를 피한다 — 규칙 24 계열.
		if not isvalid(ent) then return end
		if isvalid(ent.TextComponent) then
			ent.TextComponent.Text = text or ""
		elseif isvalid(ent.TextGUIRendererComponent) then
			ent.TextGUIRendererComponent.Text = text or ""
		end
		ent.Enable = show
	end

	@ExecSpace("ClientOnly")
	method void RefreshDetailPanel(string skillId)
		-- T50: 우측 고정 상세 패널. skillId 공란 = 미선택 안내 1줄.
		self:ResolveDetailRefs()
		local sid = skillId or ""
		if sid == "" then
			if isvalid(self._T.dIcon) then self._T.dIcon.Enable = false end
			self:SetTextSafe(self._T.dName, "노드를 선택하세요", true)
			self:SetTextSafe(self._T.dTypeLv, "", false)
			self:SetTextSafe(self._T.dDesc, "", false)
			self:SetTextSafe(self._T.dUnlock, "", false)
			self:SetTextSafe(self._T.dParent, "", false)
			self:SetTextSafe(self._T.dGate, "", false)
			self:SetTextSafe(self._T.dCost, "", false)
			return
		end

		local ds = _DataService:GetTable("SkillDataSet")
		if ds == nil then
			self:SetTextSafe(self._T.dName, "데이터 없음", true)
			return
		end
		local row = ds:FindRow("SkillId", sid)
		if row == nil then
			self:SetTextSafe(self._T.dName, "스킬 없음", true)
			return
		end

		local name = row:GetItem("Name") or sid
		local maxLevel = tonumber(row:GetItem("MaxLevel")) or 1
		local spCost = tonumber(row:GetItem("SPCost")) or 1
		local desc = self:StripCsvQuotes(row:GetItem("Description") or "")
		local iconRuid = row:GetItem("IconRUID") or ""
		local level = 0
		local pc = self:GetLocalPlayerController()
		if pc ~= nil then
			---@type PlayerController
			local controller = pc
			level = controller:GetSkillLevel(sid)
		end

		-- DIcon
		if isvalid(self._T.dIcon) then
			local ispr = self._T.dIcon.SpriteGUIRendererComponent
			if isvalid(ispr) and iconRuid ~= nil and iconRuid ~= "" then
				self._T.dIcon.Enable = true
				ispr.ImageRUID = iconRuid
				ispr.Color = Color(1, 1, 1, 1)
			else
				self._T.dIcon.Enable = false
			end
		end

		self:SetTextSafe(self._T.dName, name, true)
		local kindLabel = self:TypeDisplayLabel(row:GetItem("Type"))
		if pc ~= nil then
			pcall(function() kindLabel = pc:GetSkillKindLabel(row) end)
		end
		local typeLv = kindLabel .. " · Lv " .. tostring(level) .. "/" .. tostring(maxLevel)
		self:SetTextSafe(self._T.dTypeLv, typeLv, true)
		local consumeLine = self:FormatConsumeLine(row)
		local equipLine = self:FormatEquipReqLine(row)
		local extra = consumeLine
		if equipLine ~= "" then
			if extra ~= "" then extra = extra .. "\n" .. equipLine else extra = equipLine end
		end
		if extra ~= "" then
			if desc ~= "" then
				desc = desc .. "\n" .. extra
			else
				desc = extra
			end
		end
		self:SetTextSafe(self._T.dDesc, desc, true)

		-- T58: 선행 조건 줄 (Description 아래). 선행 없으면 숨김.
		local parentId = row:GetItem("ParentSkillId")
		if parentId ~= nil and parentId ~= "" then
			local parentNeed = self:GetParentRequiredLevelFromRow(row)
			local parentName = parentId
			local parentLv = 0
			local pRow = ds:FindRow("SkillId", parentId)
			if pRow ~= nil then
				local pn = pRow:GetItem("Name")
				if pn ~= nil and pn ~= "" then parentName = tostring(pn) end
			end
			if pc ~= nil then
				parentLv = pc:GetSkillLevel(parentId)
			end
			local parentLine = "선행: " .. parentName .. " Lv " .. tostring(parentNeed)
				.. " (현재 " .. tostring(parentLv) .. ")"
			self:SetTextSafe(self._T.dParent, parentLine, true)
			if isvalid(self._T.dParent) and isvalid(self._T.dParent.TextComponent) then
				if parentLv >= parentNeed then
					self._T.dParent.TextComponent.FontColor = Color(0.94, 0.66, 0.19, 1.0)
				else
					self._T.dParent.TextComponent.FontColor = Color(0.85, 0.33, 0.31, 1.0)
				end
			end
		else
			self:SetTextSafe(self._T.dParent, "", false)
		end

		-- 해금 목표 줄. 선행 줄과 같은 규칙 — 이미 배운 스킬은 지난 조건이라 숨긴다.
		local unlockLine = self:UnlockGoalLine(row, pc)
		if unlockLine ~= "" and level < 1 then
			self:SetTextSafe(self._T.dUnlock, unlockLine, true)
			if isvalid(self._T.dUnlock) and isvalid(self._T.dUnlock.TextComponent) then
				if self:IsUnlockGateOpenClient(row, pc) then
					self._T.dUnlock.TextComponent.FontColor = Color(0.94, 0.66, 0.19, 1.0)
				else
					self._T.dUnlock.TextComponent.FontColor = Color(0.85, 0.33, 0.31, 1.0)
				end
			end
		else
			self:SetTextSafe(self._T.dUnlock, "", false)
		end

		local gate = ""
		local st = { can = false, reason = "" }
		if pc ~= nil then
			st = self:EvalLevelUpState(sid, pc)
		end
		if st.reason ~= nil and st.reason ~= "" then
			gate = st.reason
		elseif level >= maxLevel then
			gate = "최대 레벨"
		elseif level >= 1 then
			gate = "강화 가능"
		else
			gate = "해금 가능"
		end
		self:SetTextSafe(self._T.dGate, gate, true)

		local costLine = "레벨업: SP " .. tostring(spCost)
		if level < 1 then
			if spCost <= 0 then
				costLine = "해금"
			else
				costLine = "해금: SP " .. tostring(spCost)
			end
		elseif level >= maxLevel then
			costLine = "MAX"
		elseif spCost <= 0 then
			costLine = "레벨업"
		end
		if pc ~= nil and row:GetItem("Type") ~= "Passive" then
			costLine = costLine .. " · MP " .. pc:SkillNumber(row, "ManaCost", 0) .. " · 기력 " .. (tonumber(row:GetItem("StaminaCost")) or 0)
		end
		self:SetTextSafe(self._T.dCost, costLine, true)
	end

	@ExecSpace("ClientOnly")
	method void RefreshEquipDetail()
		-- T50: EquipBar는 QWER·[레벨업]만. 상세 문구는 SkillDetailPanel.
		local pc = self:GetLocalPlayerController()
		local sid = self.selectedSkillId or ""
		local slots = { "", "", "", "" }
		if pc ~= nil then
			---@type PlayerController
			local controller = pc
			slots = controller:GetEquippedSlots()
		end

		local st = { can = false, label = "레벨업", reason = "스킬을 선택하세요" }
		if pc ~= nil and sid ~= "" then
			st = self:EvalLevelUpState(sid, pc)
		end

		-- 호버 중이면 미리보기 skillId, 아니면 선택 skillId
		local panelId = self.hoverSkillId
		if panelId == nil or panelId == "" then
			panelId = sid
		end
		self:RefreshDetailPanel(panelId)

		-- T47: [레벨업] 버튼 — 가능=초록, 불가=회색+라벨/사유
		local levelBtn = self._T.btnLevelUpE
		if not isvalid(levelBtn) then levelBtn = self.btnLevelUp end
		if isvalid(levelBtn) then
			local activeBg = Color(0.22, 0.55, 0.32, 1.0)
			local disabledBg = Color(0.28, 0.28, 0.30, 1.0)
			local activeText = Color(0.12, 0.18, 0.12, 1.0)
			local disabledText = Color(0.72, 0.72, 0.75, 1.0)
			local spr = levelBtn.SpriteGUIRendererComponent
			if isvalid(spr) then
				if st.can then spr.Color = activeBg else spr.Color = disabledBg end
				spr.RaycastTarget = true
			end
			local txt = levelBtn.TextComponent
			if isvalid(txt) then
				txt.Text = st.label
				if st.can then txt.FontColor = activeText else txt.FontColor = disabledText end
			end
			levelBtn.Enable = true
		end

		-- QWER 하이라이트: 선택 스킬이 장착된 슬롯 = 골드 (레벨업 초록과 구분)
		local selBg = Color(0.94, 0.66, 0.19, 1.0)
		local idleBg = Color(0.18, 0.20, 0.16, 1.0)
		local selText = Color(0.15, 0.12, 0.08, 1.0)
		local idleText = Color(0.79, 0.75, 0.70, 1.0)
		local btnEnts = { self._T.btnQE, self._T.btnWE, self._T.btnEE, self._T.btnRE }
		for i = 1, 4 do
			local be = btnEnts[i]
			if isvalid(be) then
				local on = (sid ~= "" and slots[i] == sid)
				local spr = be.SpriteGUIRendererComponent
				if isvalid(spr) then
					if on then spr.Color = selBg else spr.Color = idleBg end
				end
				local txt = be.TextComponent
				if isvalid(txt) then
					if on then txt.FontColor = selText else txt.FontColor = idleText end
				end
			end
		end
	end

	@ExecSpace("ClientOnly")
	method boolean IsUnlockGateOpenClient(any row, any pc)
		-- UnlockAchievementId OR UnlockOwnedItem (둘 다 있으면 OR). 게이트 없으면 true.
		if row == nil then return true end
		if pc == nil or not pc:IsSkillJobAllowed(row) or not pc:IsSkillQuestAllowed(row) then return false end
		local achId = tonumber(row:GetItem("UnlockAchievementId"))
		local hasAch = achId ~= nil and achId > 0
		local ok, raw = pcall(function() return row:GetItem("UnlockOwnedItem") end)
		local hasOwned = ok and raw ~= nil and tostring(raw) ~= ""
		if not hasAch and not hasOwned then return true end
		local achOk = false
		if hasAch then
			achOk = self:IsAchievementDoneClient(achId)
		end
		local ownedOk = false
		if hasOwned and pc ~= nil then
			ownedOk = pc:IsUnlockOwnedItemSatisfied(row)
		end
		if hasAch and hasOwned then return achOk or ownedOk end
		if hasAch then return achOk end
		return ownedOk
	end

	@ExecSpace("ClientOnly")
	method string UnlockGateReasonClient(any row, any pc)
		-- 해금 게이트 미충족 시 상세 패널/버튼 사유.
		if row == nil then return "해금 목표를 먼저 달성해야 합니다." end
		if pc ~= nil then
			local qid = pc:SkillNumber(row, "UnlockQuestId", 0)
			if qid > 0 then
				local q = _QuestDataSetLogic:GetData(qid)
				return "멘토 보고: " .. (q ~= nil and q.Name or tostring(qid))
			end
		end
		local achId = tonumber(row:GetItem("UnlockAchievementId"))
		if achId ~= nil and achId > 0 then
			-- 진행률만 보여주면 "무엇을" 해야 하는지 알 수 없다. 업적 이름을 같이 적는다.
			local data = _AchievementDataSetLogic:GetData(achId)
			local pct = math.floor(self:GetAchievementPctClient(achId) * 100)
			if data ~= nil and tostring(data.Name or "") ~= "" then
				return "'" .. tostring(data.Name) .. "' 달성 필요 (" .. tostring(pct) .. "%)"
			end
			return "해금 목표 미달성 (" .. tostring(pct) .. "%)"
		end
		local ok, raw = pcall(function() return row:GetItem("UnlockOwnedItem") end)
		if ok and raw ~= nil and tostring(raw) ~= "" then
			local disp = tostring(raw)
			if pc ~= nil then
				local inv = pc.Entity:GetComponent("script.PlayerInventory")
				if isvalid(inv) then
					disp = inv:GetItemDisplayName(tostring(raw))
				end
			end
			return disp .. " 제작 후 해금"
		end
		return "해금 목표를 먼저 달성해야 합니다."
	end

	@ExecSpace("ClientOnly")
	method string AchievementGoalText(integer achId)
		-- "제련 입문 (0/1)\n광석을 1회 제련해 수거하세요." 형태.
		-- 업적 이름과 현재 스텝 설명을 같이 보여준다 — 이름만으로는 뭘 해야 할지 모른다.
		local data = _AchievementDataSetLogic:GetData(achId)
		if data == nil then return "" end

		local step = 1
		local cur = 0
		local lp = _UserService.LocalPlayer
		if isvalid(lp) and lp.PlayerAchievement ~= nil then
			local userData = lp.PlayerAchievement.UserDataTable[achId]
			if userData ~= nil then
				if userData.Step > 0 then step = userData.Step end
				cur = userData.Value or 0
			end
		end

		local stepData = data.StepDatas[step]
		if stepData == nil then stepData = data:GetStepData(1) end

		local title = tostring(data.Name or "")
		if stepData ~= nil and stepData.Value > 0 then
			if cur > stepData.Value then cur = stepData.Value end
			title = title .. " (" .. tostring(cur) .. "/" .. tostring(stepData.Value) .. ")"
		end
		if stepData ~= nil and stepData.Description ~= nil and tostring(stepData.Description) ~= "" then
			return title .. "\n" .. tostring(stepData.Description)
		end
		return title
	end

	@ExecSpace("ClientOnly")
	method string UnlockGoalLine(any row, any pc)
		-- 상세 패널의 "해금" 줄. 게이트가 없으면 빈 문자열(줄 숨김).
		if row == nil then return "" end
		if pc ~= nil then
			local qid = pc:SkillNumber(row, "UnlockQuestId", 0)
			if qid > 0 then
				local q = _QuestDataSetLogic:GetData(qid)
				return "멘토 보고: " .. (q ~= nil and q.Name or tostring(qid))
			end
		end
		local achId = tonumber(row:GetItem("UnlockAchievementId"))
		if achId ~= nil and achId > 0 then
			local goal = self:AchievementGoalText(achId)
			if goal ~= "" then return "해금: " .. goal end
			return "해금: 업적 " .. tostring(achId) .. " 달성"
		end
		local ok, raw = pcall(function() return row:GetItem("UnlockOwnedItem") end)
		if ok and raw ~= nil and tostring(raw) ~= "" then
			local disp = tostring(raw)
			if pc ~= nil then
				local inv = pc.Entity:GetComponent("script.PlayerInventory")
				if isvalid(inv) then
					disp = inv:GetItemDisplayName(tostring(raw))
				end
			end
			return "해금: " .. disp .. " 제작"
		end
		return ""
	end

	method string FormatConsumeLine(any row)
		-- ConsumeItem이 있으면 "소모: 표시명 xN".
		if row == nil then return "" end
		local ok, raw = pcall(function() return row:GetItem("ConsumeItem") end)
		if not ok or raw == nil or tostring(raw) == "" then return "" end
		local consumeItem = tostring(raw)
		local n = 1
		local okC, rawC = pcall(function() return row:GetItem("ConsumeCount") end)
		if okC and rawC ~= nil and tostring(rawC) ~= "" then
			n = math.floor(tonumber(rawC) or 1)
		end
		if n < 1 then n = 1 end
		local disp = consumeItem
		local ds = _DataService:GetTable("item_dataset")
		if ds ~= nil then
			local irow = ds:FindRow("Name", consumeItem)
			if irow ~= nil then
				local okD, v = pcall(function() return irow:GetItem("DisplayName") end)
				if okD and v ~= nil and tostring(v) ~= "" then disp = tostring(v) end
			end
		end
		return "소모: " .. disp .. " x" .. tostring(n)
	end

	method string FormatEquipReqLine(any row)
		-- RequireEquippedItem이 있으면 "장착: 표시명".
		if row == nil then return "" end
		local ok, raw = pcall(function() return row:GetItem("RequireEquippedItem") end)
		if not ok or raw == nil or tostring(raw) == "" then return "" end
		local itemName = tostring(raw)
		local disp = itemName
		local ds = _DataService:GetTable("item_dataset")
		if ds ~= nil then
			local irow = ds:FindRow("Name", itemName)
			if irow ~= nil then
				local okD, v = pcall(function() return irow:GetItem("DisplayName") end)
				if okD and v ~= nil and tostring(v) ~= "" then disp = tostring(v) end
			end
		end
		return "장착: " .. disp
	end

	@ExecSpace("ClientOnly")
	method boolean IsAchievementDoneClient(integer achId)
		-- 서버 IsUnlockAchievementSatisfied의 표시용 클라 미러 (UserDataTable은 @Sync로 내려옴)
		local lp = _UserService.LocalPlayer
		if not isvalid(lp) then return false end
		local pa = lp.PlayerAchievement
		if pa == nil then return false end

		local data = _AchievementDataSetLogic:GetData(achId)
		if data == nil then return false end

		local userData = pa.UserDataTable[achId]
		if userData == nil then return false end

		if userData.State == _AchievementStateEnum.Completed then return true end
		if not userData:IsCompletable(data) then return false end
		return data:GetStepData(userData.Step + 1) == nil
	end

	@ExecSpace("ClientOnly")
	method number GetAchievementPctClient(integer achId)
		-- 현재 스텝 진행률 0.0~1.0 (표시용)
		local lp = _UserService.LocalPlayer
		if not isvalid(lp) then return 0.0 end
		local pa = lp.PlayerAchievement
		if pa == nil then return 0.0 end

		local data = _AchievementDataSetLogic:GetData(achId)
		if data == nil then return 0.0 end

		local userData = pa.UserDataTable[achId]
		if userData == nil then return 0.0 end

		local stepData = data.StepDatas[userData.Step]
		if stepData == nil or stepData.Value <= 0 then return 1.0 end

		return math.min(1.0, userData.Value / stepData.Value)
	end

	@ExecSpace("ClientOnly")
	method void SetNodeVisual(Entity node, Color bgColor, string lvStr, string iconRuid, string skillName, boolean dimIcon)
		-- T50: 아이콘 + Lv 뱃지만. NameText/SubText 엔티티 삭제됨.
		if isvalid(node.SpriteGUIRendererComponent) then
			node.SpriteGUIRendererComponent.Color = bgColor
		end
		local lvEnt = node:GetChildByName("LvText")
		if isvalid(lvEnt) and isvalid(lvEnt.TextComponent) then
			lvEnt.TextComponent.Text = lvStr
		end
		local iconEnt = node:GetChildByName("Icon")
		local fbEnt = node:GetChildByName("FallbackText")
		local hasIcon = (iconRuid ~= nil and iconRuid ~= "")
		if isvalid(iconEnt) then
			local ispr = iconEnt.SpriteGUIRendererComponent
			if isvalid(ispr) and hasIcon then
				iconEnt.Enable = true
				ispr.ImageRUID = iconRuid
				if dimIcon then
					ispr.Color = Color(0.25, 0.25, 0.28, 1.0)
				else
					ispr.Color = Color(1, 1, 1, 1)
				end
			else
				iconEnt.Enable = false
			end
		end
		-- IconRUID 공란(패시브 2종): 이름 앞 2글자 폴백
		if isvalid(fbEnt) then
			if not hasIcon then
				local fb = skillName or ""
				if #fb > 6 then
					-- UTF-8 한글 2글자 ≈ 6바이트; 안전하게 앞 6바이트
					fb = string.sub(fb, 1, 6)
				end
				if isvalid(fbEnt.TextComponent) then
					fbEnt.TextComponent.Text = fb
					if dimIcon then
						fbEnt.TextComponent.FontColor = Color(0.45, 0.45, 0.5, 1.0)
					else
						fbEnt.TextComponent.FontColor = Color(0.96, 0.94, 0.9, 1.0)
					end
				end
				fbEnt.Enable = true
			else
				fbEnt.Enable = false
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void Refresh()
		local pc = self:GetLocalPlayerController()
		if pc == nil then return end
		---@type PlayerController
		local controller = pc
		self:RefreshJobTabs(controller)

		if isvalid(self.spText) and isvalid(self.spText.TextComponent) then
			self.spText.TextComponent.Text = controller:GetJobName(controller.JobId) .. " · Lv " .. controller.Level .. " · SP " .. controller.SP .. " · MP " .. math.floor(controller.Mana) .. "/" .. controller:GetMaxMana()
		end

		self:RefreshSkillList(controller)
		self:RefreshCatTabs()
		self:RefreshEquipDetail()
	end

	@ExecSpace("ClientOnly")
	method void RefreshSkillList(any pc)
		-- 계열은 상단 탭으로 갈라지고, 선택된 계열 안에서만 선행 사슬을 따라
		-- 세로로 늘어놓는다. 들여쓰기 + └ 로 "무엇이 무엇의 강화인지"를 표현한다
		-- (skill-tree-plan §8 의 트리 의도를 목록 형태로 유지).
		---@type PlayerController
		local controller = pc
		self.nodeSkillMap = {}

		local ds = _DataService:GetTable("SkillDataSet")
		if ds == nil then return end

		-- 1) 현재 탭에 속한 스킬을 CSV 순서대로 모은다
		local entries = {}
		local byId = {}
		local rowCount = ds:GetRowCount()
		for i = 1, rowCount do
			local skillId = ds:GetCell(i, "SkillId")
			if skillId ~= nil and skillId ~= "" then
				local row = ds:FindRow("SkillId", skillId)
				if controller:SkillText(row, "JobId") == self.selectedJobId then
					local e = {
						id = skillId,
						rowIndex = i,
						parent = ds:GetCell(i, "ParentSkillId") or "",
						cat = self:SkillCategoryOf(ds, i),
						children = {},
					}
					entries[#entries + 1] = e
					byId[skillId] = e
				end
			end
		end

		-- 2) 부모-자식 연결 (같은 탭 안에서만)
		local roots = {}
		for _, e in ipairs(entries) do
			local p = byId[e.parent]
			if e.parent ~= "" and p ~= nil then
				p.children[#p.children + 1] = e
			else
				roots[#roots + 1] = e
			end
		end

		-- 3) 계열 목록을 정해진 순서로 만든다 (탭 버튼의 원본)
		local order = { "combat", "mobility", "support", "passive", "gather" }
		local catRoots = {}
		local seen = {}
		for _, e in ipairs(roots) do
			if catRoots[e.cat] == nil then catRoots[e.cat] = {} end
			table.insert(catRoots[e.cat], e)
			seen[e.cat] = true
		end
		self.catList = {}
		for _, cat in ipairs(order) do
			if seen[cat] then table.insert(self.catList, cat) end
		end
		-- order 에 없는 계열(향후 Category 열로 추가될 값)도 뒤에 붙인다
		for _, e in ipairs(roots) do
			local known = false
			for _, c in ipairs(self.catList) do
				if c == e.cat then known = true end
			end
			if not known then table.insert(self.catList, e.cat) end
		end

		-- 4) 선택 계열 보정 — 탭을 바꿔 사라진 계열이면 첫 계열로 되돌린다
		local valid = false
		for _, c in ipairs(self.catList) do
			if c == self.selectedCat then valid = true end
		end
		if not valid then
			self.selectedCat = #self.catList > 0 and self.catList[1] or ""
		end

		-- 5) 선택된 계열만 배치한다. 계열이 탭으로 갈렸으니 섹션 머리글은 쓰지 않는다.
		self._T.listRowIdx = 0
		self._T.listY = 0.0
		local picked = catRoots[self.selectedCat]
		if picked ~= nil then
			for _, root in ipairs(picked) do
				self:EmitSkillRow(root, 0, ds, controller)
			end
		end

		-- 6) 남는 슬롯은 숨긴다
		for i = 1, self.SecPoolSize do
			local sec = self.Entity:GetChildByName("Sec_" .. i, true)
			if isvalid(sec) then sec.Enable = false end
		end
		for i = self._T.listRowIdx + 1, self.RowPoolSize do
			local row = self.Entity:GetChildByName("Row_" .. i, true)
			if isvalid(row) then row.Enable = false end
		end
	end

	@ExecSpace("ClientOnly")
	method void EmitSkillRow(any entry, integer depth, any ds, any pc)
		-- 한 스킬과 그 자식들을 깊이 우선으로 슬롯에 배치한다.
		-- 커서(_T.listRowIdx / _T.listY)를 전진시킨다 — 다중 반환 금지(규칙 23).
		if entry == nil then return end
		local cap = self.RowPoolSize
		if self.VisibleRowCount < cap then cap = self.VisibleRowCount end
		if self._T.listRowIdx >= cap then return end
		self._T.listRowIdx = self._T.listRowIdx + 1
		local idx = self._T.listRowIdx
		local row = self.Entity:GetChildByName("Row_" .. idx, true)
		if isvalid(row) then
			row.Enable = true
			self.nodeSkillMap[tostring(idx)] = entry.id
			local tf = row.UITransformComponent
			if isvalid(tf) then tf.anchoredPosition = Vector2(0, -self._T.listY) end
			self:RefreshRow(row, ds, entry.rowIndex, entry.id, pc, depth)
		end
		self._T.listY = self._T.listY + self.RowPitch
		for _, child in ipairs(entry.children) do
			self:EmitSkillRow(child, depth + 1, ds, pc)
		end
	end

	@ExecSpace("ClientOnly")
	method boolean HasCategoryColumn(any ds)
		-- 없는 열을 GetCell 로 찔러보면 pcall 로 감싸도 LEA-3011 이 로그에 남는다.
		-- UserDataSet.Columns 로 먼저 존재를 확인한다.
		if self._T.hasCatCol ~= nil then return self._T.hasCatCol end
		local found = false
		local cols = ds.Columns
		if cols ~= nil then found = cols:Contains("Category") end
		self._T.hasCatCol = found
		return found
	end

	@ExecSpace("ClientOnly")
	method string SkillCategoryOf(any ds, integer rowIndex)
		-- CSV 에 Category 열이 생기면 그걸 우선 쓰고, 없으면 Type 으로 계열을 유추한다.
		if self:HasCategoryColumn(ds) then
			local v = ds:GetCell(rowIndex, "Category")
			if v ~= nil and tostring(v) ~= "" then return tostring(v) end
		end
		local t = ds:GetCell(rowIndex, "Type")
		local ty = (t ~= nil) and tostring(t) or ""
		if ty == "Passive" then return "passive" end
		if ty == "Dash" then return "mobility" end
		if ty == "Guard" or ty == "HealAura" then return "support" end
		return "combat"
	end

	method string CategoryLabel(string cat)
		-- 계열 키 -> 화면 표시명 (design-policy §6: 키는 영문, 표시는 한글)
		if cat == "combat" then return "공격" end
		if cat == "mobility" then return "이동" end
		if cat == "support" then return "보조" end
		if cat == "passive" then return "특성" end
		if cat == "gather" then return "채집" end
		return cat
	end

	@ExecSpace("ClientOnly")
	method void SetChildText(Entity parent, string childName, string text)
		if not isvalid(parent) then return end
		local c = parent:GetChildByName(childName, true)
		if not isvalid(c) then return end
		self:SetTextSafe(c, text, true)
	end

	@ExecSpace("ClientOnly")
	method void RefreshRow(Entity row, any ds, integer rowIndex, string skillId, any pc, integer depth)
		-- 한 행의 아이콘 / 이름(들여쓰기) / 상태 / 레벨을 채우고 배경색으로 상태를 구분한다.
		---@type PlayerController
		local controller = pc
		local skillName = ds:GetCell(rowIndex, "Name") or skillId
		local maxLevel = tonumber(ds:GetCell(rowIndex, "MaxLevel")) or 1
		local parentId = ds:GetCell(rowIndex, "ParentSkillId")
		local parentNeed = self:GetParentRequiredLevelFromDs(ds, rowIndex)
		local reqLevel = tonumber(ds:GetCell(rowIndex, "RequiredLevel")) or 1
		local iconRuid = ds:GetCell(rowIndex, "IconRUID") or ""
		local level = controller:GetSkillLevel(skillId)
		local selected = (self.selectedSkillId == skillId)

		-- 계보 표현: 깊이만큼 들여쓰고, 자식이면 └ 를 앞에 붙인다
		local indent = depth * 26
		local label = skillName
		if depth > 0 then label = "└ " .. skillName end

		local icon = row:GetChildByName("Icon", true)
		if isvalid(icon) then
			local tf = icon.UITransformComponent
			if isvalid(tf) then tf.anchoredPosition = Vector2(8 + indent, 0) end
			local spr = icon.SpriteGUIRendererComponent
			if isvalid(spr) then
				if iconRuid ~= "" then
					icon.Enable = true
					spr.ImageRUID = iconRuid
				else
					icon.Enable = false
				end
			end
		end
		local nameEnt = row:GetChildByName("Name", true)
		if isvalid(nameEnt) then
			local tf = nameEnt.UITransformComponent
			if isvalid(tf) then tf.anchoredPosition = Vector2(52 + indent, 0) end
			self:SetTextSafe(nameEnt, label, true)
		end
		self:SetChildText(row, "Lv", tostring(level) .. "/" .. tostring(maxLevel))

		-- 상태 판정 (서버 게이트의 클라 미러)
		local parentOk = true
		if parentId ~= nil and parentId ~= "" then
			parentOk = (controller:GetSkillLevel(parentId) >= parentNeed)
		end
		local levelOk = (controller.Level >= reqLevel)
		local dsRow = ds:FindRow("SkillId", skillId)
		local achOk = self:IsUnlockGateOpenClient(dsRow, controller)

		local state = ""
		local bg = Color(0.20, 0.16, 0.11, 1.0)
		if level >= maxLevel and level >= 1 then
			state = "MAX"
			bg = Color(0.22, 0.30, 0.24, 1.0)
		elseif level >= 1 then
			state = "강화 가능"
			bg = Color(0.20, 0.26, 0.34, 1.0)
		elseif parentOk and levelOk and achOk then
			state = "해금 가능"
			bg = Color(0.40, 0.30, 0.10, 1.0)
		elseif not levelOk then
			state = "Lv " .. tostring(reqLevel) .. " 필요"
			bg = Color(0.16, 0.14, 0.13, 1.0)
		elseif not parentOk then
			state = "선행 필요"
			bg = Color(0.16, 0.14, 0.13, 1.0)
		else
			state = "목표 미달"
			bg = Color(0.16, 0.14, 0.13, 1.0)
		end
		if selected then
			bg = Color(bg.r + 0.12, bg.g + 0.12, bg.b + 0.12, 1.0)
		end
		self:SetChildText(row, "State", state)
		local rspr = row.SpriteGUIRendererComponent
		if isvalid(rspr) then rspr.Color = bg end
	end

	@ExecSpace("ClientOnly")
	method void RefreshLinks(any ds, any pc)
		-- T58: ParentSkillId에서 링크 파생. 같은 열·바로 위 행만 표시(§8.3).
		if ds == nil or pc == nil then return end
		local rowCount = ds:GetRowCount()
		for i = 1, rowCount do
			local skillId = ds:GetCell(i, "SkillId") or ""
			local parentId = ds:GetCell(i, "ParentSkillId") or ""
			if pc:SkillText(ds:FindRow("SkillId", skillId), "JobId") ~= self.selectedJobId then continue end
			if skillId == "" or parentId == "" then continue end

			local treeRow = tonumber(ds:GetCell(i, "TreeRow")) or 0
			local treeCol = tonumber(ds:GetCell(i, "TreeCol")) or 0
			local pRow = ds:FindRow("SkillId", parentId)
			if pRow == nil then
				log_warning("[SKILL-TREE] link parent missing skillId=" .. skillId .. " parent=" .. parentId)
				continue
			end
			local parentRow = tonumber(pRow:GetItem("TreeRow")) or 0
			local parentCol = tonumber(pRow:GetItem("TreeCol")) or 0
			-- 위상 가드: 같은 열 + 바로 위 행
			if math.abs(parentCol - treeCol) > 1 or parentRow ~= (treeRow - 1) then
				log_warning("[SKILL-TREE] link topology skip skill=" .. skillId
					.. " child=(" .. tostring(treeRow) .. "," .. tostring(treeCol) .. ")"
					.. " parent=(" .. tostring(parentRow) .. "," .. tostring(parentCol) .. ")")
				continue
			end
			if treeRow < 2 or treeRow > self.MaxRows or treeCol < 1 or treeCol > self.MaxCols then
				continue
			end

			local link = self.Entity:GetChildByName("Link_" .. treeRow .. "_" .. treeCol, true)
			if not isvalid(link) then
				log_warning("[SKILL-TREE] Link_" .. treeRow .. "_" .. treeCol .. " missing")
				continue
			end
			link.Enable = true
			local parentNode = self.Entity:GetChildByName("Node_" .. parentRow .. "_" .. parentCol, true)
			local childNode = self.Entity:GetChildByName("Node_" .. treeRow .. "_" .. treeCol, true)
			if isvalid(parentNode) and isvalid(childNode) then
				local a = parentNode.UITransformComponent.anchoredPosition
				local b = childNode.UITransformComponent.anchoredPosition
				local dx = b.x - a.x
				local dy = b.y - a.y
				link.UITransformComponent.anchoredPosition = Vector2((a.x + b.x) * 0.5, (a.y + b.y) * 0.5)
				link.UITransformComponent.RectSize = Vector2(8, math.max(8, math.sqrt(dx * dx + dy * dy) - 88))
				link.UITransformComponent.ZRotation = -math.deg(math.atan(dx, dy))
			end

			local parentNeed = self:GetParentRequiredLevelFromDs(ds, i)
			local parentLv = pc:GetSkillLevel(parentId)
			local childLv = pc:GetSkillLevel(skillId)
			local spr = link.SpriteGUIRendererComponent
			if isvalid(spr) then
				-- 자식 보유=금색 실선 / 해금 가능(부모 충족)=금색 하이라이트 / 미충족=dim
				if childLv >= 1 then
					spr.Color = Color(1.0, 0.8, 0.1, 1.0)
				elseif parentLv >= parentNeed then
					spr.Color = Color(0.85, 0.70, 0.25, 0.95)
				else
					spr.Color = Color(0.48, 0.44, 0.40, 0.9)
				end
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void RefreshNode(Entity node, any ds, integer rowIndex, string skillId, any pc)
		---@type PlayerController
		local controller = pc

		local skillName = ds:GetCell(rowIndex, "Name") or skillId
		local maxLevel = tonumber(ds:GetCell(rowIndex, "MaxLevel")) or 1
		local parentId = ds:GetCell(rowIndex, "ParentSkillId")
		local parentNeed = self:GetParentRequiredLevelFromDs(ds, rowIndex)
		local reqLevel = tonumber(ds:GetCell(rowIndex, "RequiredLevel")) or 1
		local iconRuid = ds:GetCell(rowIndex, "IconRUID") or ""

		local level = controller:GetSkillLevel(skillId)
		local selected = (self.selectedSkillId == skillId)
		local lvBadge = tostring(level) .. "/" .. tostring(maxLevel)

		if level >= 1 then
			local bg = Color(0.16, 0.32, 0.55, 1.0)
			if selected then bg = Color(0.28, 0.42, 0.62, 1.0) end
			self:SetNodeVisual(node, bg, lvBadge, iconRuid, skillName, false)
			return
		end

		-- T58: 부모 Lv ≥ ParentRequiredLevel (서버 게이트 미러)
		local parentOk = true
		if parentId ~= nil and parentId ~= "" then
			parentOk = (controller:GetSkillLevel(parentId) >= parentNeed)
		end
		local levelOk = (controller.Level >= reqLevel)
		local row = ds:FindRow("SkillId", skillId)
		local achOk = self:IsUnlockGateOpenClient(row, controller)

		if parentOk and levelOk and achOk then
			-- 해금 가능: 금색 하이라이트 (트리 진행감, §8.4)
			local bg = Color(0.72, 0.52, 0.14, 1.0)
			if selected then bg = Color(0.94, 0.66, 0.19, 1.0) end
			self:SetNodeVisual(node, bg, lvBadge, iconRuid, skillName, false)
		elseif parentOk and levelOk and not achOk then
			local bg = Color(0.55, 0.38, 0.12, 1.0)
			if selected then bg = Color(0.68, 0.48, 0.18, 1.0) end
			self:SetNodeVisual(node, bg, lvBadge, iconRuid, skillName, true)
		else
			local bg = Color(0.22, 0.22, 0.26, 1.0)
			if selected then bg = Color(0.32, 0.32, 0.38, 1.0) end
			self:SetNodeVisual(node, bg, lvBadge, iconRuid, skillName, true)
		end
	end

	@ExecSpace("ClientOnly")
	method void OnCloseClicked(ButtonClickEvent event)
		self:Close()
	end


	@ExecSpace("ClientOnly")
	method void SetupCatTabs()
		-- 계열 탭 6칸은 고정 슬롯이고, 라벨/표시 여부는 Refresh 때 catList 로 정해진다.
		for i = 1, 6 do
			local tab = self.Entity:GetChildByName("CatTab_" .. i, true)
			if isvalid(tab) then
				local slot = i
				self.nodeHandlers[tab] = tab:ConnectEvent(ButtonClickEvent, function()
					if self.catList[slot] == nil then return end
					self.selectedCat = self.catList[slot]
					self.selectedSkillId = ""
					self.hoverSkillId = ""
					self:Refresh()
				end)
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void RefreshCatTabs()
		for i = 1, 6 do
			local tab = self.Entity:GetChildByName("CatTab_" .. i, true)
			if isvalid(tab) then
				local cat = self.catList[i]
				if cat == nil then
					tab.Enable = false
				else
					tab.Enable = true
					self:SetTextSafe(tab, self:CategoryLabel(cat), true)
					if isvalid(tab.SpriteGUIRendererComponent) then
						if cat == self.selectedCat then
							tab.SpriteGUIRendererComponent.Color = Color(0.65, 0.43, 0.15, 1)
						else
							tab.SpriteGUIRendererComponent.Color = Color(0.24, 0.18, 0.13, 1)
						end
					end
				end
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void SetupJobTabs()
		for _, name in ipairs({ "TabCommon", "TabJob" }) do
			local tab = self.Entity:GetChildByName(name, true)
			if isvalid(tab) then
				local tabName = name
				self.nodeHandlers[tab] = tab:ConnectEvent(ButtonClickEvent, function()
					local pc = self:GetLocalPlayerController()
					if pc == nil then return end
					self.selectedJobId = tabName == "TabCommon" and "" or pc.JobId
					self.selectedCat = ""
					self.selectedSkillId = ""
					self.hoverSkillId = ""
					self:Refresh()
				end)
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void RefreshJobTabs(any pc)
		if self.selectedJobId ~= "" and self.selectedJobId ~= pc.JobId then self.selectedJobId = "" end
		local common = self.Entity:GetChildByName("TabCommon", true)
		local job = self.Entity:GetChildByName("TabJob", true)
		self:SetTextSafe(common, "공용", true)
		self:SetTextSafe(job, pc:GetJobName(pc.JobId), pc.JobId ~= "")
		for _, tab in ipairs({ common, job }) do
			if isvalid(tab) and isvalid(tab.SpriteGUIRendererComponent) then
				local selected = (tab == common and self.selectedJobId == "") or (tab == job and self.selectedJobId ~= "")
				tab.SpriteGUIRendererComponent.Color = selected and Color(0.65, 0.43, 0.15, 1) or Color(0.24, 0.18, 0.13, 1)
			end
		end
		local hint = pc.JobId == "" and "마을 멘토의 기초 과제 → 전직 시험" or "실전 수련을 보고하면 다음 기술이 열립니다."
		self:SetTextSafe(self.Entity:GetChildByName("JobHint", true), hint, true)
	end

end

@Component
script UIMinimapController extends Component

	property number MapRadius = 120.0

	property integer GridCells = 15

	property number TilesPerCell = 6.0

	property any updateTimer = nil

	property any layer1 = nil

	property any layer2 = nil

	property boolean mapReady = false

	property string cachedMapName = ""

	property any coordsText = nil

	property any mapNameText = nil

	property boolean IsFullViewMode = false

	property any fullViewVignette = nil

	property any fullViewGuide = nil

	property any fullViewCloseBtn = nil

	property number defaultZoomRatio = 33.0

	property number defaultZoomRatioMin = 1.0

	property Vector3 lastPlayerPos = Vector3(0, 0, 0)

	property Vector2 panCamPos = Vector2(0, 0)

	property Vector2 dragStartMousePos = Vector2(0, 0)

	property Vector2 dragStartCamPos = Vector2(0, 0)

	property boolean isDraggingMap = false

	property any keyHandler = nil

	property any touchHandler = nil

	property any touchHoldHandler = nil

	property any touchReleaseHandler = nil

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- Caches the tilemap layers, then repaints the player-centered window on a light timer.
		self:CacheTileMaps()
		
		-- Resolve FullView overlay entities
		self.fullViewVignette = _EntityService:GetEntityByPath("/ui/HUDGroup/FullViewVignette")
		self.fullViewGuide = _EntityService:GetEntityByPath("/ui/HUDGroup/FullViewGuide")
		self.fullViewCloseBtn = _EntityService:GetEntityByPath("/ui/HUDGroup/FullViewCloseBtn")
		if isvalid(self.fullViewCloseBtn) then
			self.fullViewCloseBtn:ConnectEvent(ButtonClickEvent, function()
				self:ExitFullView()
			end)
		end

		-- Spawn or find the Map Name UI Text entity
		local mapNameEnt = self.Entity:GetChildByName("MapNameText")
		if not isvalid(mapNameEnt) then
			mapNameEnt = _SpawnService:SpawnByModelId("uitext", "MapNameText", Vector3.zero, self.Entity)
		end
		if isvalid(mapNameEnt) then
			local sprite = mapNameEnt.SpriteGUIRendererComponent
			if isvalid(sprite) then
				sprite.Color = Color(0.06, 0.08, 0.11, 0.75)
			end
			local transform = mapNameEnt.UITransformComponent
			if isvalid(transform) then
				transform.AlignmentOption = AlignmentType.CastFrom("TopCenter")
				transform.anchoredPosition = Vector2(0, 16)
				transform.RectSize = Vector2(166, 26)
			end
			self.mapNameText = mapNameEnt.TextComponent
			if isvalid(self.mapNameText) then
				self.mapNameText.FontSize = 18
				self.mapNameText.FontColor = Color(1.0, 0.92, 0.70, 1.0)
				self.mapNameText.UseOutLine = true
				self.mapNameText.OutlineColor = Color(0.0, 0.0, 0.0, 1.0)
				self.mapNameText.OutlineWidth = 1.0
				self.mapNameText.Alignment = 4 -- MiddleCenter
			end
		end

		-- Spawn or find the Coords UI Text entity
		local coords = self.Entity:GetChildByName("Coords")
		if not isvalid(coords) then
			coords = _SpawnService:SpawnByModelId("uitext", "Coords", Vector3.zero, self.Entity)
		end
		if isvalid(coords) then
			local sprite = coords.SpriteGUIRendererComponent
			if isvalid(sprite) then
				sprite.Color = Color(0, 0, 0, 0)
			end
			local transform = coords.UITransformComponent
			if isvalid(transform) then
				transform.AlignmentOption = AlignmentType.CastFrom("BottomCenter")
				transform.anchoredPosition = Vector2(0, -15) -- 15 pixels below bottom edge
				transform.RectSize = Vector2(120, 25)
			end
			self.coordsText = coords.TextComponent
			if isvalid(self.coordsText) then
				self.coordsText.FontSize = 20
				self.coordsText.FontColor = Color(1.0, 1.0, 1.0, 1.0)
				self.coordsText.UseOutLine = true
				self.coordsText.OutlineColor = Color(0.0, 0.0, 0.0, 1.0)
				self.coordsText.OutlineWidth = 1.0
				self.coordsText.Alignment = 4 -- MiddleCenter
			end
		end

		-- Connect Minimap click button event (Entity and Bg child)
		local onMinimapClick = function()
			local mainMenu = _EntityService:GetEntityByPath("/ui/MainMenuGroup")
			if isvalid(mainMenu) and mainMenu.Enable then return end
			self:ToggleFullView()
		end
		self.Entity:ConnectEvent(ButtonClickEvent, onMinimapClick)
		local bgEnt = self.Entity:GetChildByName("Bg")
		if isvalid(bgEnt) then
			bgEnt:ConnectEvent(ButtonClickEvent, onMinimapClick)
		end

		-- Connect Tab / ESC key down event via InputService
		self.keyHandler = _InputService:ConnectEvent(KeyDownEvent, function(event)
			local mainMenu = _EntityService:GetEntityByPath("/ui/MainMenuGroup")
			if isvalid(mainMenu) and mainMenu.Enable then return end
			if event.key == KeyboardKey.Tab then
				self:ToggleFullView()
			elseif event.key == KeyboardKey.Escape and self.IsFullViewMode then
				self:ExitFullView()
			end
		end)

		-- Connect Mouse/Touch drag events for Free-Pan Camera (Drag Only)
		self.touchHandler = _InputService:ConnectEvent(ScreenTouchEvent, function(event)
			if not self.IsFullViewMode then return end
			self.isDraggingMap = true
			self.dragStartMousePos = event.TouchPoint
			self.dragStartCamPos = Vector2(self.panCamPos.x, self.panCamPos.y)
		end)

		self.touchHoldHandler = _InputService:ConnectEvent(ScreenTouchHoldEvent, function(event)
			if not self.IsFullViewMode or not self.isDraggingMap then return end
			local delta = event.TouchPoint - self.dragStartMousePos
			local factor = 30.0
			local worldDeltaX = -delta.x / factor
			local worldDeltaY = -delta.y / factor

			local panRadius = self:GetMapPanRadius(self.cachedMapName)
			self.panCamPos.x = math.max(-panRadius, math.min(panRadius, self.dragStartCamPos.x + worldDeltaX))
			self.panCamPos.y = math.max(-panRadius, math.min(panRadius, self.dragStartCamPos.y + worldDeltaY))

			local cam = _CameraService:GetCurrentCameraComponent()
			local player = _UserService.LocalPlayer
			if isvalid(cam) and isvalid(player) and isvalid(player.TransformComponent) then
				local ppos = player.TransformComponent.WorldPosition
				cam.CameraOffset = Vector2(self.panCamPos.x - ppos.x, self.panCamPos.y - ppos.y)
			end
		end)

		self.touchReleaseHandler = _InputService:ConnectEvent(ScreenTouchReleaseEvent, function(event)
			self.isDraggingMap = false
		end)

		-- Periodic check for minimap repaint
		self.updateTimer = _TimerService:SetTimerRepeat(function()
			self:RepaintWindow()
		end, 0.05)
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- Releases the repaint timer and restores camera zoom.
		if self.IsFullViewMode then
			self:ExitFullView()
		end
		if self.keyHandler then
			_InputService:DisconnectEvent(KeyDownEvent, self.keyHandler)
			self.keyHandler = nil
		end
		if self.touchHandler then
			_InputService:DisconnectEvent(ScreenTouchEvent, self.touchHandler)
			self.touchHandler = nil
		end
		if self.touchHoldHandler then
			_InputService:DisconnectEvent(ScreenTouchHoldEvent, self.touchHoldHandler)
			self.touchHoldHandler = nil
		end
		if self.touchReleaseHandler then
			_InputService:DisconnectEvent(ScreenTouchReleaseEvent, self.touchReleaseHandler)
			self.touchReleaseHandler = nil
		end
		if self.updateTimer then
			_TimerService:ClearTimer(self.updateTimer)
			self.updateTimer = nil
		end
	end

	@ExecSpace("ClientOnly")
	method number GetMapPanRadius(string mapName)
		if mapName == nil or mapName == "" then return 30.0 end
		if string.sub(mapName, 1, 5) == "Home_" or mapName == "map01" then
			return 30.0
		elseif mapName == "town" then
			return 35.0
		elseif mapName == "template_field" then
			return 30.0
		elseif mapName == "template_boss" then
			return 15.0
		end
		return 30.0
	end

	@ExecSpace("ClientOnly")
	method void ToggleFullView()
		if self.IsFullViewMode then
			self:ExitFullView()
		else
			self:EnterFullView()
		end
	end

	@ExecSpace("ClientOnly")
	method number GetOptimalZoomRatio(string mapName)
		local ds = _DataService:GetTable("MapCameraDataSet")
		if ds ~= nil then
			local rowCount = ds:GetRowCount()
			local defaultZoom = 3.0
			for i = 1, rowCount do
				local key = ds:GetCell(i, "MapKey")
				local zoom = tonumber(ds:GetCell(i, "FullViewZoomRatio")) or 3.0
				if key == "default" then
					defaultZoom = zoom
				end
				if mapName ~= nil and mapName ~= "" then
					if key == "Home" and (string.sub(mapName, 1, 5) == "Home_" or mapName == "map01") then
						return zoom
					elseif key == mapName then
						return zoom
					end
				end
			end
			return defaultZoom
		end

		-- Fallback
		if mapName ~= nil and (string.sub(mapName, 1, 5) == "Home_" or mapName == "map01") then
			return 3.0
		elseif mapName == "town" then
			return 2.8
		elseif mapName == "template_field" then
			return 3.0
		elseif mapName == "template_boss" then
			return 4.5
		end
		return 3.0
	end

	@ExecSpace("ClientOnly")
	method number GetDefaultZoomRatio(string mapName)
		local ds = _DataService:GetTable("MapCameraDataSet")
		if ds ~= nil then
			local rowCount = ds:GetRowCount()
			local defaultZoom = 33.0
			for i = 1, rowCount do
				local key = ds:GetCell(i, "MapKey")
				local zoom = tonumber(ds:GetCell(i, "DefaultZoomRatio")) or 33.0
				if key == "default" then
					defaultZoom = zoom
				end
				if mapName ~= nil and mapName ~= "" then
					if key == "Home" and (string.sub(mapName, 1, 5) == "Home_" or mapName == "map01") then
						return zoom
					elseif key == mapName then
						return zoom
					end
				end
			end
			return defaultZoom
		end
		return self.defaultZoomRatio or 33.0
	end

	@ExecSpace("ClientOnly")
	method void EnterFullView()
		local cam = _CameraService:GetCurrentCameraComponent()
		if not isvalid(cam) then return end

		local optimalZoom = self:GetOptimalZoomRatio(self.cachedMapName)
		pcall(function()
			self.defaultZoomRatioMin = cam.ZoomRatioMin
			cam.ZoomRatioMin = 30.0
		end)
		cam.ZoomRatio = optimalZoom

		local player = _UserService.LocalPlayer
		if isvalid(player) and isvalid(player.TransformComponent) then
			local ppos = player.TransformComponent.WorldPosition
			self.lastPlayerPos = ppos
			self.panCamPos = Vector2(0, 0)
			-- Center camera to map origin (0, 0)
			cam.CameraOffset = Vector2(self.panCamPos.x - ppos.x, self.panCamPos.y - ppos.y)
		end

		-- Hide other HUD UI elements during FullView
		local hud = _EntityService:GetEntityByPath("/ui/HUDGroup")
		if isvalid(hud) then
			local c = hud:GetComponent("script.UIHUDController")
			if isvalid(c) then
				c:SetPlayHudVisible(false)
			end
		end

		if isvalid(self.fullViewVignette) then
			self.fullViewVignette.Enable = true
		end
		if isvalid(self.fullViewGuide) then
			self.fullViewGuide.Enable = true
		end
		if isvalid(self.fullViewCloseBtn) then
			self.fullViewCloseBtn.Enable = true
		end

		self.isDraggingMap = false
		self.IsFullViewMode = true
		log("[MINIMAP] Entered Free-Pan FullView mode with ZoomRatio=" .. tostring(optimalZoom))
	end

	@ExecSpace("ClientOnly")
	method void ExitFullView()
		local cam = _CameraService:GetCurrentCameraComponent()
		if isvalid(cam) then
			local defaultZoom = self:GetDefaultZoomRatio(self.cachedMapName)
			cam.ZoomRatio = defaultZoom
			pcall(function()
				cam.ZoomRatioMin = self.defaultZoomRatioMin or 30.0
			end)
			cam.CameraOffset = Vector2(0, 0)
		end

		if isvalid(self.fullViewVignette) then
			self.fullViewVignette.Enable = false
		end
		if isvalid(self.fullViewGuide) then
			self.fullViewGuide.Enable = false
		end
		if isvalid(self.fullViewCloseBtn) then
			self.fullViewCloseBtn.Enable = false
		end

		-- Restore other HUD UI elements after FullView
		local hud = _EntityService:GetEntityByPath("/ui/HUDGroup")
		if isvalid(hud) then
			local c = hud:GetComponent("script.UIHUDController")
			if isvalid(c) then
				c:SetPlayHudVisible(true)
			end
		end

		self.isDraggingMap = false
		self.IsFullViewMode = false
		log("[MINIMAP] Exited FullView mode, restored ZoomRatio=" .. tostring(self.defaultZoomRatio))
	end

	@ExecSpace("ClientOnly")
	method void CacheTileMaps()
		-- Resolves the base-earth (layer1) and grass/overlay (layer2) RectTileMapComponents
		-- from the map the local player is currently on (home / town / etc.), not a fixed map.
		local player = _UserService.LocalPlayer
		if not isvalid(player) then
			_TimerService:SetTimerOnce(function() self:CacheTileMaps() end, 0.5)
			return
		end
		local map = player.CurrentMap
		if not isvalid(map) then
			_TimerService:SetTimerOnce(function() self:CacheTileMaps() end, 0.5)
			return
		end
		local l1 = map:GetChildByName("RectTileMap")
		local l2 = map:GetChildByName("RectTileMap2")
		self.layer1 = isvalid(l1) and l1.RectTileMapComponent or nil
		self.layer2 = isvalid(l2) and l2.RectTileMapComponent or nil

		if not isvalid(self.layer1) then
			local allMaps = map:GetChildComponentsByTypeName("MOD.Core.RectTileMapComponent", true)
			if allMaps ~= nil and #allMaps > 0 then
				self.layer1 = allMaps[1]
				if #allMaps > 1 then
					self.layer2 = allMaps[2]
				end
			end
		end

		if not isvalid(self.layer1) then
			_TimerService:SetTimerOnce(function() self:CacheTileMaps() end, 0.5)
			return
		end
		self.cachedMapName = map.Name
		self.mapReady = true
		log("UIMinimapController: Tilemap layers cached for minimap on map " .. map.Name .. ".")
	end

	@ExecSpace("ClientOnly")
	method Color TileColor(string tileName)
		-- Maps a tile name to its minimap color. Prefix-based so new variants inherit a family color.
		-- wall.tileset 2026-07-08 밀착 페어 스킴: Layer 1 = "Soil" 전면(L2 홀로 드러나면 광장/밭 바닥 = 흙색),
		-- Layer 2 = 잔디 커버 — FullGrass/Grass*Corner = 잔디색, 방향 에지 Grass{dir} = 밀착 길 = 흙색.
		if tileName == nil or tileName == "" then
			return Color(0.06, 0.07, 0.09, 1.0)
		end
		if tileName == "FullGrass" then
			return Color(0.39, 0.60, 0.13, 1.0)
		elseif string.sub(tileName, 1, 8) == "SubGrass" then
			-- SubGrass{LTRD|RTLD} = 대각 2칸 흙 (길의 대각 접속 — 2026-07-15 추가) — 방향 에지와 같은 흙색
			return Color(0.76, 0.60, 0.42, 1.0)
		elseif string.sub(tileName, 1, 5) == "Grass" then
			if string.sub(tileName, -6) == "Corner" then
				-- Grass{LT|RT|LD|RD}Corner = 오목 모서리 노치 (대부분 잔디) — 잔디색
				return Color(0.39, 0.60, 0.13, 1.0)
			end
			-- Grass{LT,T,RT,L,R,LD,D,RD} = 방향 에지 (밀착 길 페어) — 흙색으로 길을 그린다
			return Color(0.76, 0.60, 0.42, 1.0)
		elseif tileName == "Soil" then
			return Color(0.76, 0.60, 0.42, 1.0)
		elseif tileName == "Water" then
			return Color(0.20, 0.45, 0.85, 1.0)
		elseif string.sub(tileName, 1, 10) == "TerraceTop" then
			return Color(0.30, 0.48, 0.12, 1.0)
		elseif string.sub(tileName, 1, 9) == "CliffFace" then
			return Color(0.45, 0.32, 0.22, 1.0)
		elseif tileName == "Big Wall" then
			return Color(0.25, 0.20, 0.16, 1.0)
		elseif string.sub(tileName, 1, 9) == "BaseGrass" then
			return Color(0.39, 0.60, 0.13, 1.0)
		elseif string.sub(tileName, 1, 8) == "BaseSand" then
			return Color(0.91, 0.82, 0.55, 1.0)
		elseif string.sub(tileName, 1, 8) == "BaseSnow" then
			return Color(0.90, 0.93, 0.95, 1.0)
		elseif string.sub(tileName, 1, 9) == "BaseEarth" then
			return Color(0.70, 0.53, 0.42, 1.0)
		end
		return Color(0.55, 0.50, 0.45, 1.0)
	end

	@ExecSpace("ClientOnly")
	method string TileNameAt(integer wx, integer wy)
		-- Returns the topmost actual tile name at world cell (wx, wy): overlay (layer2) over base (layer1).
		local cell = Vector2Int(wx, wy)
		if isvalid(self.layer2) then
			local t2 = self.layer2:GetTile(cell)
			if t2 ~= nil and t2.Name ~= nil and t2.Name ~= "" then
				return t2.Name
			end
		end
		if isvalid(self.layer1) then
			local t1 = self.layer1:GetTile(cell)
			if t1 ~= nil and t1.Name ~= nil then
				return t1.Name
			end
		end
		return ""
	end

	@ExecSpace("ClientOnly")
	method void RepaintWindow()
		-- Repaints all cells with the actual tilemap state in the window centered on the player.
		if not self.mapReady then return end
		local player = _UserService.LocalPlayer
		if not isvalid(player) then return end

		-- Re-cache tilemap layers when the player has moved to a different map (home <-> town warp).
		local curMap = player.CurrentMap
		if isvalid(curMap) and curMap.Name ~= self.cachedMapName then
			self.mapReady = false
			self:CacheTileMaps()
			return
		end

		local worldPos = player.TransformComponent.WorldPosition
		local px = math.floor(worldPos.x)
		local py = math.floor(worldPos.y)
		
		if isvalid(self.coordsText) then
			self.coordsText.Text = string.format("(%d, %d)", px, py)
		end
		
		if isvalid(self.mapNameText) then
			self.mapNameText.Text = self:GetMapDisplayName(self.cachedMapName)
		end
		
		local gridCells = self.GridCells
		local half = math.floor(gridCells / 2)
		local tilesPerCell = math.floor(self.TilesPerCell)
		
		local yellow = {}
		if isvalid(curMap) then
			local dialogs = curMap:GetChildComponentsByTypeName("script.VillagerDialog", true)
			if dialogs ~= nil then
				for _, dialog in ipairs(dialogs) do
					if isvalid(dialog) then
						local kind = dialog:GetQuestPingKind(player)
						if kind ~= nil and kind ~= "" and isvalid(dialog.Entity) and isvalid(dialog.Entity.TransformComponent) then
							local np = dialog.Entity.TransformComponent.WorldPosition
							local nx = math.floor(np.x)
							local ny = math.floor(np.y)
							local cc = half + math.floor((nx - px) / tilesPerCell)
							local rr = half + math.floor((ny - py) / tilesPerCell)
							if cc >= 0 and cc < gridCells and rr >= 0 and rr < gridCells then
								yellow[tostring(rr) .. "_" .. tostring(cc)] = true
							end
						end
					end
				end
			end
		end

		for r = 0, gridCells - 1 do
			for c = 0, gridCells - 1 do
				local cellEntity = self.Entity:GetChildByName("Cell_" .. r .. "_" .. c)
				if isvalid(cellEntity) and isvalid(cellEntity.SpriteGUIRendererComponent) then
					local wx = px + (c - half) * tilesPerCell
					local wy = py + (r - half) * tilesPerCell
					local tileName = self:TileNameAt(wx, wy)
					local col = self:TileColor(tileName)
					if yellow[tostring(r) .. "_" .. tostring(c)] == true then
						col = Color(1.0, 0.86, 0.12, 1.0)
					end
					cellEntity.SpriteGUIRendererComponent.Color = col
				end
			end
		end
	end

	@ExecSpace("ClientOnly")
	method string GetMapDisplayName(string mapName)
		if mapName == nil or mapName == "" then return "" end
		if string.sub(mapName, 1, 5) == "Home_" then
			return "개인 영지"
		end
		
		local ds = _DataService:GetTable("PortalDestinationDataSet")
		if ds ~= nil then
			local rowCount = ds:GetRowCount()
			for i = 1, rowCount do
				if ds:GetCell(i, "MapName") == mapName then
					return ds:GetCell(i, "DisplayName")
				end
			end
		end
		return mapName
	end

end
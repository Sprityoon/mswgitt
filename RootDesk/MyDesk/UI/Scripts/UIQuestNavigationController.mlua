@Component
script UIQuestNavigationController extends Component

	-- 마을 및 퀘스트 맵에서 보고 가능(초록 !) 또는 미수락 퀘스트(금색 !)를 가진 주민의 방향과 거리를 안내하는 네비게이션 컨트롤러.
	-- 보고 가능한 주민이 있으면 그쪽을 먼저 안내한다 (VillagerDialog:GetQuestPingKind "done" > "!").
	-- 1) 화면 밖(Off-screen) 시 화면 테두리에 골드 뱃지([!] NPC이름 거리m ➔) 표시
	-- 2) 플레이어 캐릭터 주변 궤도에 실시간 방향 가이드 화살표 표시
	-- 3) 상호작용 거리(2.5m 이내) 도달 시 또는 미수락 퀘스트 부재 시 자동 숨김

	property any scanTimer = nil
	property any updateTimer = nil

	property any targetNpc = nil
	property string targetKind = ""
	property string targetNpcName = ""
	property Vector2 targetNpcPos = Vector2(0, 0)
	property boolean hasTarget = false

	property Entity rootEntity = nil
	property Entity edgeBadge = nil
	property Entity badgeIcon = nil
	property Entity badgeName = nil
	property Entity badgeDist = nil
	property Entity badgeArrow = nil
	property Entity playerCompass = nil
	property Entity compassArrow = nil

	-- ── 튜토리얼 길안내 (2026-10-23 — 초반 퀘스트 목표물·조작 안내) ──
	-- 트래커에 표시 중인 퀘스트의 "아직 못 채운 첫 조건"을 보고
	--  ① 목표물(채집 자원·작물·몬스터·게시판 등)을 찾아 머리 위 ▼ + 화면 밖이면 기존 화살표/뱃지로 안내하고
	--  ② 퀵슬롯 위 안내 패널에 무엇을 눌러야 하는지(PC/모바일)를 보여 준다.
	-- 문구 = QuestConditionDataSet.GuideHint / GuideHintMobile, 대상 지정 = GuideTarget (공란이면 조건에서 자동 추론).
	property Entity hintPanel = nil
	property Entity hintText = nil
	property Entity targetMarker = nil
	property Entity markerLabel = nil
	property Entity guideTargetEnt = nil
	property string guideText = ""
	property string guideLabel = ""
	property string guideKey = ""
	property number guideSearchAt = 0
	-- TIP 패널은 조건이 바뀔 때(새 퀘스트·다음 조건)만 TipShowSeconds 동안 띄운다 — 같은 내용이 퀘스트 추적기에도 있어 계속 떠 있으면 거슬린다. ▼ 목표물은 계속 표시.
	property number TipShowSeconds = 5
	property number guideTipUntil = 0
	property table itemSourceCache = {}
	property boolean itemSourceBuilt = false

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		self.rootEntity = self.Entity
		self:EnsureUIElements()
		self:SetNavVisible(false)
		self:SetGuideVisible(false, false)

		-- 타겟 주민 탐색 타이머 (0.25초 주기)
		self.scanTimer = _TimerService:SetTimerRepeat(function()
			self:ScanTargetNpc()
		end, 0.25)

		-- 방향/거리/위치 실시간 갱신 타이머 (30fps)
		self.updateTimer = _TimerService:SetTimerRepeat(function()
			self:UpdateNavigation()
		end, 1/30)
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		if self.scanTimer ~= nil then
			_TimerService:ClearTimer(self.scanTimer)
			self.scanTimer = nil
		end
		if self.updateTimer ~= nil then
			_TimerService:ClearTimer(self.updateTimer)
			self.updateTimer = nil
		end
	end

	@ExecSpace("ClientOnly")
	method void EnsureUIElements()
		local root = self.Entity
		if not isvalid(root) then return end

		-- 1. 화면 테두리 뱃지 (EdgeBadge)
		local edge = root:GetChildByName("EdgeBadge")
		if not isvalid(edge) then
			edge = _SpawnService:SpawnByModelId("uisprite", "EdgeBadge", Vector3.zero, root)
		end
		if isvalid(edge) then
			self.edgeBadge = edge
			local sprite = edge.SpriteGUIRendererComponent
			if isvalid(sprite) then
				sprite.Color = Color(0.10, 0.08, 0.06, 0.90)
				sprite.RaycastTarget = false
			end
			local transform = edge.UITransformComponent
			if isvalid(transform) then
				transform.AlignmentOption = AlignmentType.CastFrom("Center")
				transform.RectSize = Vector2(210, 46)
			end

			-- 느낌표 아이콘
			local icon = edge:GetChildByName("Icon")
			if not isvalid(icon) then
				icon = _SpawnService:SpawnByModelId("uitext", "Icon", Vector3.zero, edge)
			end
			if isvalid(icon) then
				self.badgeIcon = icon
				local s = icon.SpriteGUIRendererComponent
				if isvalid(s) then s.Color = Color(0, 0, 0, 0) s.RaycastTarget = false end
				local t = icon.UITransformComponent
				if isvalid(t) then
					t.AlignmentOption = AlignmentType.CastFrom("Left")
					t.anchoredPosition = Vector2(18, 0)
					t.RectSize = Vector2(30, 40)
				end
				local txt = icon.TextComponent
				if isvalid(txt) then
					txt.Text = "!"
					txt.Font = FontType.Maple
					txt.FontSize = 26
					txt.FontColor = Color(1.0, 0.86, 0.12, 1.0)
					txt.UseOutLine = true
					txt.OutlineColor = Color(0.18, 0.10, 0.02, 1.0)
					txt.OutlineWidth = 1.5
					txt.Alignment = TextAlignmentType.MiddleCenter
				end
			end

			-- NPC 이름
			local nameEnt = edge:GetChildByName("Name")
			if not isvalid(nameEnt) then
				nameEnt = _SpawnService:SpawnByModelId("uitext", "Name", Vector3.zero, edge)
			end
			if isvalid(nameEnt) then
				self.badgeName = nameEnt
				local s = nameEnt.SpriteGUIRendererComponent
				if isvalid(s) then s.Color = Color(0, 0, 0, 0) s.RaycastTarget = false end
				local t = nameEnt.UITransformComponent
				if isvalid(t) then
					t.AlignmentOption = AlignmentType.CastFrom("Left")
					t.anchoredPosition = Vector2(70, 0)
					t.RectSize = Vector2(90, 36)
				end
				local txt = nameEnt.TextComponent
				if isvalid(txt) then
					txt.Text = ""
					txt.Font = FontType.Maple
					txt.FontSize = 18
					txt.FontColor = Color(1.0, 1.0, 1.0, 1.0)
					txt.UseOutLine = true
					txt.OutlineColor = Color(0.0, 0.0, 0.0, 1.0)
					txt.OutlineWidth = 1.0
					txt.Alignment = TextAlignmentType.MiddleLeft
				end
			end

			-- 거리 텍스트
			local distEnt = edge:GetChildByName("Dist")
			if not isvalid(distEnt) then
				distEnt = _SpawnService:SpawnByModelId("uitext", "Dist", Vector3.zero, edge)
			end
			if isvalid(distEnt) then
				self.badgeDist = distEnt
				local s = distEnt.SpriteGUIRendererComponent
				if isvalid(s) then s.Color = Color(0, 0, 0, 0) s.RaycastTarget = false end
				local t = distEnt.UITransformComponent
				if isvalid(t) then
					t.AlignmentOption = AlignmentType.CastFrom("Right")
					t.anchoredPosition = Vector2(-42, 0)
					t.RectSize = Vector2(50, 36)
				end
				local txt = distEnt.TextComponent
				if isvalid(txt) then
					txt.Text = ""
					txt.Font = FontType.Maple
					txt.FontSize = 16
					txt.FontColor = Color(1.0, 0.86, 0.12, 1.0)
					txt.UseOutLine = true
					txt.OutlineColor = Color(0.18, 0.10, 0.02, 1.0)
					txt.OutlineWidth = 1.0
					txt.Alignment = TextAlignmentType.MiddleRight
				end
			end

			-- 화살표 아이콘
			local arrowEnt = edge:GetChildByName("Arrow")
			if not isvalid(arrowEnt) then
				arrowEnt = _SpawnService:SpawnByModelId("uitext", "Arrow", Vector3.zero, edge)
			end
			if isvalid(arrowEnt) then
				self.badgeArrow = arrowEnt
				local s = arrowEnt.SpriteGUIRendererComponent
				if isvalid(s) then s.Color = Color(0, 0, 0, 0) s.RaycastTarget = false end
				local t = arrowEnt.UITransformComponent
				if isvalid(t) then
					t.AlignmentOption = AlignmentType.CastFrom("Right")
					t.anchoredPosition = Vector2(-16, 0)
					t.RectSize = Vector2(28, 28)
					t.Pivot = Vector2(0.5, 0.5)
				end
				local txt = arrowEnt.TextComponent
				if isvalid(txt) then
					txt.Text = "▲"
					txt.Font = FontType.Maple
					txt.FontSize = 18
					txt.FontColor = Color(1.0, 0.86, 0.12, 1.0)
					txt.UseOutLine = true
					txt.OutlineColor = Color(0.18, 0.10, 0.02, 1.0)
					txt.OutlineWidth = 1.2
					txt.Alignment = TextAlignmentType.MiddleCenter
				end
			end
		end

		-- 3. 튜토리얼 안내 패널 (퀵슬롯 위) + 목표물 머리 위 ▼ 마커
		local panel = root:GetChildByName("GuidePanel")
		if not isvalid(panel) then
			panel = _SpawnService:SpawnByModelId("uisprite", "GuidePanel", Vector3.zero, root)
		end
		if isvalid(panel) then
			self.hintPanel = panel
			local s = panel.SpriteGUIRendererComponent
			if isvalid(s) then
				s.Color = Color(0.10, 0.08, 0.06, 0.88)
				s.RaycastTarget = false
			end
			local t = panel.UITransformComponent
			if isvalid(t) then
				t.AlignmentOption = AlignmentType.CastFrom("Center")
				t.RectSize = Vector2(960, 60)
				t.anchoredPosition = Vector2(0, -292)
			end
			local txtEnt = panel:GetChildByName("Text")
			if not isvalid(txtEnt) then
				txtEnt = _SpawnService:SpawnByModelId("uitext", "Text", Vector3.zero, panel)
			end
			if isvalid(txtEnt) then
				self.hintText = txtEnt
				local ts = txtEnt.SpriteGUIRendererComponent
				if isvalid(ts) then ts.Color = Color(0, 0, 0, 0) ts.RaycastTarget = false end
				local tt = txtEnt.UITransformComponent
				if isvalid(tt) then
					tt.AlignmentOption = AlignmentType.CastFrom("Center")
					tt.anchoredPosition = Vector2(0, 0)
					tt.RectSize = Vector2(930, 52)
				end
				local txt = txtEnt.TextComponent
				if isvalid(txt) then
					txt.Text = ""
					txt.Font = FontType.Maple
					txt.FontSize = 24
					txt.FontColor = Color(1.0, 0.95, 0.80, 1.0)
					txt.UseOutLine = true
					txt.OutlineColor = Color(0.0, 0.0, 0.0, 1.0)
					txt.OutlineWidth = 1.0
					txt.Alignment = TextAlignmentType.MiddleCenter
				end
			end
		end

		local marker = root:GetChildByName("GuideMarker")
		if not isvalid(marker) then
			marker = _SpawnService:SpawnByModelId("uitext", "GuideMarker", Vector3.zero, root)
		end
		if isvalid(marker) then
			self.targetMarker = marker
			local s = marker.SpriteGUIRendererComponent
			if isvalid(s) then s.Color = Color(0, 0, 0, 0) s.RaycastTarget = false end
			local t = marker.UITransformComponent
			if isvalid(t) then
				t.AlignmentOption = AlignmentType.CastFrom("Center")
				t.RectSize = Vector2(40, 40)
			end
			local txt = marker.TextComponent
			if isvalid(txt) then
				txt.Text = "▼"
				txt.Font = FontType.Maple
				txt.FontSize = 32
				txt.FontColor = Color(1.0, 0.86, 0.12, 1.0)
				txt.UseOutLine = true
				txt.OutlineColor = Color(0.18, 0.10, 0.02, 1.0)
				txt.OutlineWidth = 1.6
				txt.Alignment = TextAlignmentType.MiddleCenter
			end
			local lbl = marker:GetChildByName("Label")
			if not isvalid(lbl) then
				lbl = _SpawnService:SpawnByModelId("uitext", "Label", Vector3.zero, marker)
			end
			if isvalid(lbl) then
				self.markerLabel = lbl
				local ls = lbl.SpriteGUIRendererComponent
				if isvalid(ls) then ls.Color = Color(0, 0, 0, 0) ls.RaycastTarget = false end
				local lt = lbl.UITransformComponent
				if isvalid(lt) then
					lt.AlignmentOption = AlignmentType.CastFrom("Center")
					lt.anchoredPosition = Vector2(0, 30)
					lt.RectSize = Vector2(240, 30)
				end
				local ltxt = lbl.TextComponent
				if isvalid(ltxt) then
					ltxt.Text = ""
					ltxt.Font = FontType.Maple
					ltxt.FontSize = 21
					ltxt.FontColor = Color(1.0, 1.0, 1.0, 1.0)
					ltxt.UseOutLine = true
					ltxt.OutlineColor = Color(0.0, 0.0, 0.0, 1.0)
					ltxt.OutlineWidth = 1.0
					ltxt.Alignment = TextAlignmentType.MiddleCenter
				end
			end
		end

		-- 2. 플레이어 주변 방향 나침반 (PlayerCompass)
		local compass = root:GetChildByName("PlayerCompass")
		if not isvalid(compass) then
			compass = _SpawnService:SpawnByModelId("uitext", "PlayerCompass", Vector3.zero, root)
		end
		if isvalid(compass) then
			self.playerCompass = compass
			local s = compass.SpriteGUIRendererComponent
			if isvalid(s) then s.Color = Color(0, 0, 0, 0) s.RaycastTarget = false end
			local t = compass.UITransformComponent
			if isvalid(t) then
				t.AlignmentOption = AlignmentType.CastFrom("Center")
				t.RectSize = Vector2(36, 36)
				t.Pivot = Vector2(0.5, 0.5)
			end
			local txt = compass.TextComponent
			if isvalid(txt) then
				txt.Text = "▲"
				txt.Font = FontType.Maple
				txt.FontSize = 24
				txt.FontColor = Color(1.0, 0.86, 0.12, 0.90)
				txt.UseOutLine = true
				txt.OutlineColor = Color(0.18, 0.10, 0.02, 1.0)
				txt.OutlineWidth = 1.4
				txt.Alignment = TextAlignmentType.MiddleCenter
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void SetNavVisible(boolean vis)
		if isvalid(self.edgeBadge) then
			self.edgeBadge.Enable = vis
		end
		if isvalid(self.playerCompass) then
			self.playerCompass.Enable = vis
		end
	end

	@ExecSpace("ClientOnly")
	method void SetGuideVisible(boolean panelVis, boolean markerVis)
		-- 튜토리얼 안내 패널·목표물 마커 표시 전환.
		if isvalid(self.hintPanel) and self.hintPanel.Enable ~= panelVis then self.hintPanel.Enable = panelVis end
		if isvalid(self.targetMarker) and self.targetMarker.Enable ~= markerVis then self.targetMarker.Enable = markerVis end
	end

	@ExecSpace("ClientOnly")
	method any GetGuideRow(integer questId, integer condIndex)
		-- QuestConditionDataSet 에서 questId 의 condIndex 번째 행 (조건 로드 순서 = CSV 행 순서).
		local ds = _DataService:GetTable("QuestConditionDataSet")
		if ds == nil then return nil end
		local seen = 0
		for _, row in ipairs(ds:GetAllRow() or {}) do
			if math.floor(tonumber(row:GetItem("Id")) or 0) == questId then
				seen = seen + 1
				if seen == condIndex then return row end
			end
		end
		return nil
	end

	@ExecSpace("ClientOnly")
	method string RowCell(any row, string col)
		-- 선택 컬럼 안전 읽기 (없거나 빈 값이면 "").
		if row == nil then return "" end
		local ok, v = pcall(function() return row:GetItem(col) end)
		if ok and v ~= nil then return tostring(v) end
		return ""
	end

	@ExecSpace("ClientOnly")
	method table GetItemSources(string itemName)
		-- 아이템 Name → 그 아이템이 나오는 월드 엔티티 이름 목록 (드롭 자원 SourceId + 작물 Crop_<CropId>). 한 번 만들어 캐시한다.
		-- 드롭표(ItemDropDataSet)는 서버 전용이라 서버가 동기화한 ResourceSpawner.GatherSourcesJson 을 쓴다.
		if not self.itemSourceBuilt then
			local srcJson = ""
			if _ResourceSpawner ~= nil then srcJson = _ResourceSpawner.GatherSourcesJson or "" end
			if srcJson == "" then return {} end
			self.itemSourceBuilt = true
			local cache = {}
			local okJ, flat = pcall(function() return _HttpService:JSONDecode(srcJson) end)
			if okJ and type(flat) == "table" then
				for name, joined in pairs(flat) do
					cache[name] = {}
					for src in string.gmatch(tostring(joined), "[^|]+") do cache[name][src] = true end
				end
			end
			local cropDs = _DataService:GetTable("CropDataSet")
			if cropDs ~= nil then
				for _, r in ipairs(cropDs:GetAllRow() or {}) do
					local name = tostring(r:GetItem("HarvestItem") or "")
					local cropId, _spaces = string.gsub(tostring(r:GetItem("CropId") or ""), " ", "")
					if name ~= "" and cropId ~= "" then
						if cache[name] == nil then cache[name] = {} end
						cache[name]["Crop_" .. cropId] = true
					end
				end
			end
			self.itemSourceCache = cache
		end
		return self.itemSourceCache[itemName] or {}
	end

	@ExecSpace("ClientOnly")
	method Entity FindNearestByNames(Entity curMap, table names, Vector3 from)
		-- 맵 바로 아래 엔티티 중 이름이 names 에 있는 가장 가까운 것. 작물은 다 자란 것을 우선한다(덜 자란 건 4유닛 불리하게).
		local best = nil
		local bestD = 999999
		for _, child in ipairs(curMap.Children:ToTable()) do
			if isvalid(child) and names[child.Name] == true and child.Enable and isvalid(child.TransformComponent) then
				local p = child.TransformComponent.WorldPosition
				local d = (p.x - from.x) * (p.x - from.x) + (p.y - from.y) * (p.y - from.y)
				local crop = child:GetComponent("script.Crop")
				if isvalid(crop) and not crop:IsMature() then d = d + 16 end
				if d < bestD then
					bestD = d
					best = child
				end
			end
		end
		return best
	end

	@ExecSpace("ClientOnly")
	method Entity FindNearestComponent(Entity curMap, string typeName, Vector3 from, string monsterId)
		-- 컴포넌트 타입으로 가장 가까운 엔티티 (monsterId 가 있으면 script.Monster.MonsterId 일치만).
		local best = nil
		local bestD = 999999
		for _, comp in ipairs(curMap:GetChildComponentsByTypeName(typeName, true) or {}) do
			if isvalid(comp) and isvalid(comp.Entity) and comp.Entity.Enable then
				local ok = true
				if monsterId ~= "" then ok = (comp.MonsterId == monsterId) end
				if ok then
					local p = comp.Entity.TransformComponent.WorldPosition
					local d = (p.x - from.x) * (p.x - from.x) + (p.y - from.y) * (p.y - from.y)
					if d < bestD then
						bestD = d
						best = comp.Entity
					end
				end
			end
		end
		return best
	end

	@ExecSpace("ClientOnly")
	method Entity ResolveGuideTarget(Entity curMap, Vector3 from, integer actionEnum, string condTarget, string spec)
		-- GuideTarget 지정("none" · "entity:<이름>" · "component:<script.X>" · "monster:<MonsterId>" · "item:<Name>")이 우선,
		-- 공란이면 조건으로 추론: 채집 → 그 아이템이 나오는 자원/작물 · 처치 → 몬스터 · 납품 → 게시판 · 이동 → 포탈.
		if spec == "none" then return nil end
		local kind = ""
		local arg = ""
		local sepStart, sepEnd = string.find(spec, ":", 1, true)
		if sepStart ~= nil and sepStart > 1 then
			kind = string.sub(spec, 1, sepStart - 1)
			arg = string.sub(spec, sepEnd + 1)
		end
		if kind ~= "" then
			-- 지정 대상 그대로
		elseif actionEnum == _ActionEnum.Gather then
			kind = "item"
			arg = condTarget
		elseif actionEnum == _ActionEnum.Kill then
			kind = "monster"
			arg = condTarget
		elseif actionEnum == _ActionEnum.Deliver then
			kind = "component"
			arg = "script.BulletinBoard"
		elseif actionEnum == _ActionEnum.Warp then
			kind = "component"
			arg = "script.PortalGate"
		end
		if kind == "entity" then return curMap:GetChildByName(arg, true) end
		if kind == "component" then return self:FindNearestComponent(curMap, arg, from, "") end
		if kind == "monster" then return self:FindNearestComponent(curMap, "script.Monster", from, arg) end
		self._T.guideRedirectHome = false
		if kind == "item" then
			-- 마을의 풀·나무는 장식이라 캐지지 않는다(같은 이름 GrownGrass 가 배치돼 있어 안내가 장식을 가리켰다, 2026-10-24 제작자).
			-- 마을에서는 채집 대상 대신 영지 포탈(PortalToHome)을 가리키고 이름표를 "영지로 가서 …"로 바꾼다(UpdateGuide 가 접두어를 붙임).
			if curMap.Name == "town" then
				local portal = curMap:GetChildByName("PortalToHome", true)
				if isvalid(portal) then
					self._T.guideRedirectHome = true
					return portal
				end
				return nil
			end
			return self:FindNearestByNames(curMap, self:GetItemSources(arg), from)
		end
		return nil
	end

	@ExecSpace("ClientOnly")
	method void UpdateGuide(Entity player)
		-- 트래커 퀘스트의 첫 미달 조건 → 안내 문구/목표물. 목표 탐색은 1초에 한 번(맵 자식 순회 비용).
		self.guideText = ""
		local tracker = _EntityService:GetEntityByPath("/ui/HUDGroup/QuestTracker")
		local qc = isvalid(tracker) and tracker:GetComponent("script.UIQuestController") or nil
		local qid = 0
		if isvalid(qc) then qid = qc.DisplayedQuestId end
		local pq = player.PlayerQuest
		if qid == 0 or pq == nil or _QuestDataSetLogic == nil then
			self.guideTargetEnt = nil
			return
		end
		local data = _QuestDataSetLogic:GetData(qid)
		local userData = pq.UserDataTable[qid]
		if data == nil or userData == nil or userData.State ~= _QuestStateEnum.InProgress or userData:IsReadyToTurnIn(data, player) then
			self.guideTargetEnt = nil
			return
		end
		local conds = data.ConditionDatas or {}
		local idx = 0
		for i = 1, #conds do
			local v = 0
			if userData.Values ~= nil and userData.Values[i] ~= nil then v = userData.Values[i] end
			if v < conds[i].Value then
				idx = i
				break
			end
		end
		if idx == 0 then
			self.guideTargetEnt = nil
			return
		end
		local row = self:GetGuideRow(qid, idx)
		local hint = self:RowCell(row, "GuideHint")
		local mobileHint = self:RowCell(row, "GuideHintMobile")
		local spec = self:RowCell(row, "GuideTarget")
		if hint == "" and spec == "" then
			self.guideTargetEnt = nil
			return
		end
		local isMobile = false
		local okM, vM = pcall(function() return _ApplicationService:IsMobilePlatform() end)
		if okM and vM == true then isMobile = true end
		if isMobile and mobileHint ~= "" then hint = mobileHint end
		self.guideText = hint
		self.guideLabel = conds[idx].Description or ""
		if self._T.guideRedirectHome == true then self.guideLabel = "영지로 가서 " .. self.guideLabel end

		local key = tostring(qid) .. "/" .. tostring(idx)
		local now = _UtilLogic.ElapsedSeconds
		if key ~= self.guideKey or now >= self.guideSearchAt or not isvalid(self.guideTargetEnt) then
			if key ~= self.guideKey then
				self.guideTipUntil = now + self.TipShowSeconds
				log("[VRF][GUIDE] quest=" .. tostring(qid) .. " cond=" .. tostring(idx) .. " hint=" .. hint)
			end
			self.guideKey = key
			self.guideSearchAt = now + 1.0
			local actionEnum = 0
			local targetName = ""
			local cd = conds[idx].ConditionData
			if cd ~= nil then
				local list = cd:GetActionEnumList()
				if list ~= nil and #list > 0 then actionEnum = list[1] end
				local okT, vT = pcall(function() return cd.Target end)
				if okT and vT ~= nil then targetName = tostring(vT) end
			end
			local curMap = player.CurrentMap
			if isvalid(curMap) then
				self.guideTargetEnt = self:ResolveGuideTarget(curMap, player.TransformComponent.WorldPosition, actionEnum, targetName, spec)
			else
				self.guideTargetEnt = nil
			end
		end
	end

	@ExecSpace("ClientOnly")
	method boolean HasActiveResearchQuest(Entity player)
		if not isvalid(player) or player.PlayerQuest == nil or _QuestDataSetLogic == nil then return false end
		local pq = player.PlayerQuest
		local prog = pq.ProgressingIdTable
		if prog == nil then return false end
		for id, _ in pairs(prog) do
			local userData = pq.UserDataTable[id]
			if userData ~= nil and userData.State == _QuestStateEnum.InProgress then
				local data = _QuestDataSetLogic:GetData(id)
				if data ~= nil and not userData:IsCompletable(data) then
					if id == 218 then return true end
					if data.ConditionDatas ~= nil then
						for _, cond in ipairs(data.ConditionDatas) do
							local actionCond = cond.ConditionData
							if actionCond ~= nil then
								local enumList = actionCond:GetActionEnumList()
								if enumList ~= nil then
									for _, ae in ipairs(enumList) do
										if ae == _ActionEnum.Research then
											return true
										end
									end
								end
							end
						end
					end
				end
			end
		end
		return false
	end

	@ExecSpace("ClientOnly")
	method Entity FindResearchLabEntity(Entity curMap)
		if not isvalid(curMap) then return nil end
		local lab = curMap:GetChildByName("ResearchLab", true)
		if isvalid(lab) then return lab end
		local direct = _EntityService:GetEntityByPath("/maps/town/ResearchLab")
		if isvalid(direct) then return direct end
		local dialogs = curMap:GetChildComponentsByTypeName("script.VillagerDialog", true)
		if dialogs ~= nil then
			for _, d in ipairs(dialogs) do
				if isvalid(d) and d.NpcId == "researcher" and isvalid(d.Entity) then
					return d.Entity
				end
			end
		end
		return nil
	end

	@ExecSpace("ClientOnly")
	method void ScanTargetNpc()
		local player = _UserService.LocalPlayer
		if not isvalid(player) then
			self.hasTarget = false
			self.targetNpc = nil
			return
		end

		local curMap = player.CurrentMap
		if not isvalid(curMap) then
			self.hasTarget = false
			self.targetNpc = nil
			return
		end

		self:UpdateGuide(player)

		local dialogs = curMap:GetChildComponentsByTypeName("script.VillagerDialog", true)
		local hasDialogs = dialogs ~= nil and #dialogs > 0
		local hasResearchQuest = self:HasActiveResearchQuest(player)
		local hasGuideTarget = isvalid(self.guideTargetEnt)

		if not hasDialogs and not hasResearchQuest and not hasGuideTarget then
			self.hasTarget = false
			self.targetNpc = nil
			return
		end

		local playerPos = player.TransformComponent.WorldPosition
		local bestDist = 999999
		local bestRank = 0
		local bestKind = ""
		local bestTargetEnt = nil
		local bestTargetName = ""
		local bestPos = Vector2(0, 0)

		-- 1. 주민 탐색 (보고 가능 done: 순위 3, 수락 가능 !: 순위 1)
		if hasDialogs then
			for _, dialog in ipairs(dialogs) do
				if isvalid(dialog) and isvalid(dialog.Entity) and isvalid(dialog.Entity.TransformComponent) then
					local kind = dialog:GetQuestPingKind(player)
					local rank = 0
					if kind == "done" then rank = 3 elseif kind == "!" then rank = 1 end
					if rank > 0 then
						local np = dialog.Entity.TransformComponent.WorldPosition
						local d = Vector2.Distance(Vector2(playerPos.x, playerPos.y), Vector2(np.x, np.y))
						if rank > bestRank or (rank == bestRank and d < bestDist) then
							bestRank = rank
							bestKind = kind
							bestDist = d
							bestTargetEnt = dialog.Entity
							bestTargetName = dialog:GetSpeakerName()
							bestPos = Vector2(np.x, np.y)
						end
					end
				end
			end
		end

		-- 2. 연구소 퀘스트 진행 중이면 연구소 안내 (순위 2: 일반 !보다 높고 보고 가능보다는 낮음)
		if hasResearchQuest then
			local lab = self:FindResearchLabEntity(curMap)
			if isvalid(lab) and isvalid(lab.TransformComponent) then
				local lp = lab.TransformComponent.WorldPosition
				local d = Vector2.Distance(Vector2(playerPos.x, playerPos.y), Vector2(lp.x, lp.y))
				local labRank = 2
				if labRank > bestRank or (labRank == bestRank and d < bestDist) then
					bestRank = labRank
					bestKind = "!"
					bestDist = d
					bestTargetEnt = lab
					bestTargetName = "연구소"
					bestPos = Vector2(lp.x, lp.y)
				end
			end
		end

		-- 3. 튜토리얼 목표물 (순위 2.5: 보고 가능 주민보다는 낮고, 연구소·새 퀘스트 주민보다 높다 — 지금 할 일이 먼저)
		self._T.TargetIsGuide = false
		if hasGuideTarget then
			local gp = self.guideTargetEnt.TransformComponent.WorldPosition
			local d = Vector2.Distance(Vector2(playerPos.x, playerPos.y), Vector2(gp.x, gp.y))
			if 2.5 > bestRank then
				bestRank = 2.5
				bestKind = "!"
				bestDist = d
				bestTargetEnt = self.guideTargetEnt
				bestTargetName = self.guideLabel
				bestPos = Vector2(gp.x, gp.y)
				self._T.TargetIsGuide = true
			end
		end

		if bestTargetEnt ~= nil then
			self.targetNpc = bestTargetEnt
			self.targetNpcName = bestTargetName
			self.targetNpcPos = bestPos
			self.hasTarget = true
			if bestKind ~= self.targetKind then
				self.targetKind = bestKind
				self:ApplyKindColor(bestKind)
				log("[QNAV] target=" .. tostring(bestTargetName) .. " kind=" .. bestKind)
			end
		else
			self.hasTarget = false
			self.targetNpc = nil
		end
	end

	@ExecSpace("ClientOnly")
	method void ApplyKindColor(string kind)
		-- 보고 가능은 초록, 수락 가능은 금색 — NPC 머리 위 마크와 같은 색으로 뱃지·나침반을 칠한다.
		local col = Color(1.0, 0.86, 0.12, 1.0)
		if kind == "done" then col = Color(0.42, 1.0, 0.36, 1.0) end
		local targets = { self.badgeIcon, self.badgeDist, self.badgeArrow, self.playerCompass }
		for _, ent in ipairs(targets) do
			if isvalid(ent) and isvalid(ent.TextComponent) then
				local a = ent.TextComponent.FontColor.a
				ent.TextComponent.FontColor = Color(col.r, col.g, col.b, a)
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void UpdateGuideOverlay()
		-- 안내 패널(무엇을 누를지) + 화면 안 목표물 머리 위 ▼(살짝 통통 튐)·이름.
		local hasText = self.guideText ~= ""
		if hasText and isvalid(self.hintText) and isvalid(self.hintText.TextComponent) then
			local shown = "TIP  " .. self.guideText
			if self.hintText.TextComponent.Text ~= shown then self.hintText.TextComponent.Text = shown end
		end
		local markerVis = false
		local target = self.guideTargetEnt
		if isvalid(target) and isvalid(target.TransformComponent) and isvalid(self.targetMarker) then
			local tp = target.TransformComponent.WorldPosition
			local ui = _UILogic:ScreenToUIPosition(_UILogic:WorldToScreenPosition(Vector2(tp.x, tp.y)))
			if math.abs(ui.x) < 900 and math.abs(ui.y) < 500 then
				markerVis = true
				local bob = math.sin(_UtilLogic.ElapsedSeconds * 5.0) * 8.0
				local mt = self.targetMarker.UITransformComponent
				if isvalid(mt) then mt.anchoredPosition = Vector2(ui.x, ui.y + 110 + bob) end
				if isvalid(self.markerLabel) and isvalid(self.markerLabel.TextComponent) and self.markerLabel.TextComponent.Text ~= self.guideLabel then
					self.markerLabel.TextComponent.Text = self.guideLabel
				end
			end
		end
		self:SetGuideVisible(hasText and _UtilLogic.ElapsedSeconds < self.guideTipUntil, markerVis)
	end

	@ExecSpace("ClientOnly")
	method void UpdateNavigation()
		-- 0. 환경설정 [퀘스트 길 안내] 끔이면 화살표·뱃지를 숨긴다.
		if _GameSettingsLogic ~= nil and _GameSettingsLogic.QuestGuide == false then
			self:SetNavVisible(false)
			self:SetGuideVisible(false, false)
			return
		end
		-- 1. HUD 활성화 여부 확인
		local hud = _EntityService:GetEntityByPath("/ui/HUDGroup")
		if isvalid(hud) then
			local hudCtrl = hud:GetComponent("script.UIHUDController")
			if isvalid(hudCtrl) and hudCtrl.playHudReady == false then
				self:SetNavVisible(false)
				self:SetGuideVisible(false, false)
				return
			end
		end
		self:UpdateGuideOverlay()

		-- 2. 타겟 존재 여부 확인
		if not self.hasTarget or not isvalid(self.targetNpc) then
			self:SetNavVisible(false)
			return
		end

		local player = _UserService.LocalPlayer
		if not isvalid(player) or not isvalid(player.TransformComponent) then
			self:SetNavVisible(false)
			return
		end

		local pPos = player.TransformComponent.WorldPosition
		local tPos = self.targetNpcPos
		local dist = Vector2.Distance(Vector2(pPos.x, pPos.y), tPos)

		-- 3. 상호작용 가능 거리 이내 도달 시 자동 숨김 (연구소 대형 구조물은 3.5m, 일반 주민은 2.5m)
		local hideDist = 2.5
		if self.targetNpcName == "연구소" then
			hideDist = 3.5
		end
		-- 튜토리얼 목표물은 바로 앞까지 데려간다 (조준 2×2 블록 안에 들어오는 거리).
		if self._T.TargetIsGuide == true then hideDist = 1.6 end
		if dist <= hideDist then
			self:SetNavVisible(false)
			return
		end

		-- 4. 플레이어 및 목표의 스크린/UI 좌표 계산
		local pScreen = _UILogic:WorldToScreenPosition(Vector2(pPos.x, pPos.y))
		local pUi = _UILogic:ScreenToUIPosition(pScreen)

		local tScreen = _UILogic:WorldToScreenPosition(Vector2(tPos.x, tPos.y))
		local tUi = _UILogic:ScreenToUIPosition(tScreen)

		-- 방향 벡터 계산
		local diff = Vector2(tPos.x - pPos.x, tPos.y - pPos.y)
		local dir = diff:Normalize()
		local angleDeg = Vector2.SignedAngle(Vector2.right, dir)

		-- (A) 플레이어 주변 궤도 방향 나침반 (PlayerCompass)
		if isvalid(self.playerCompass) then
			self.playerCompass.Enable = true
			local orbitRadius = 75.0
			local cx = pUi.x + dir.x * orbitRadius
			local cy = pUi.y + dir.y * orbitRadius
			local ct = self.playerCompass.UITransformComponent
			if isvalid(ct) then
				ct.anchoredPosition = Vector2(cx, cy)
				-- '▲' 기본 방향이 위(90도)이므로 -90 오프셋 회전
				ct.ZRotation = angleDeg - 90.0
			end
		end

		-- (B) 화면 가장자리 뱃지 (EdgeBadge) — 화면 밖일 때만 표시
		-- FHD 1920x1080 UI 좌표 기준 (중심 0,0, 가로 ±960, 세로 ±540)
		-- 안전 마진을 둔 뷰포트 경계 (X: ±840, Y: ±440)
		local viewBoundX = 840.0
		local viewBoundY = 440.0
		local isOffScreen = (tUi.x < -viewBoundX or tUi.x > viewBoundX or tUi.y < -viewBoundY or tUi.y > viewBoundY)

		if isvalid(self.edgeBadge) then
			if isOffScreen then
				self.edgeBadge.Enable = true
				-- 텍스트 갱신
				if isvalid(self.badgeName) and isvalid(self.badgeName.TextComponent) then
					if self.badgeName.TextComponent.Text ~= self.targetNpcName then
						self.badgeName.TextComponent.Text = self.targetNpcName
					end
				end
				if isvalid(self.badgeDist) and isvalid(self.badgeDist.TextComponent) then
					local distStr = string.format("%dm", math.floor(dist))
					if self.badgeDist.TextComponent.Text ~= distStr then
						self.badgeDist.TextComponent.Text = distStr
					end
				end

				-- 화면 테두리 클램핑 좌표 계산 (중심 기준 타원/박스 교점)
				local edgeMarginX = 820.0
				local edgeMarginY = 420.0
				local absX = math.abs(dir.x)
				local absY = math.abs(dir.y)
				local scale = math.min(edgeMarginX / math.max(0.001, absX), edgeMarginY / math.max(0.001, absY))
				local ex = dir.x * scale
				local ey = dir.y * scale

				local et = self.edgeBadge.UITransformComponent
				if isvalid(et) then
					et.anchoredPosition = Vector2(ex, ey)
				end

				-- 화살표 회전
				if isvalid(self.badgeArrow) and isvalid(self.badgeArrow.UITransformComponent) then
					self.badgeArrow.UITransformComponent.ZRotation = angleDeg - 90.0
				end
			else
				-- 화면 안에 있을 때는 머리 위 !가 보이므로 뱃지 숨김 (플레이어 궤도 화살표는 유지)
				self.edgeBadge.Enable = false
			end
		end
	end

end

@Component
script UIRequestController extends Component

	-- Daily request board UI (3 rows + deliver). Identity: forest dark + gold #F0A830.

	property Entity btnClose = "d8f156e7-8934-4d15-9761-5f97584ad83b"
	property Entity requestList = "ebf383d2-b845-4575-9e76-ef0d156bff4e"
	property Entity requestTemplate = "8c757950-0ad9-4d8b-8b7f-6e3697962b36"
	property Entity dayText = "f0508707-94d1-4fc1-8943-c7174f814c8f"
	property Entity hintText = "8a25c360-a28d-4295-9e89-c4766aa0534c"
	-- 안내 줄 원래 글자색(올클리어 금빛에서 되돌릴 때). ResolveRefs 에서 한 번 기록.
	property Color hintBaseColor = Color(1, 1, 1, 1)
	-- 도장 줄(원안 4.3): 오늘 3칸(Today_1~3) + 주간 5칸(Week_1~5). 그림 = UI/Sprites/Stamp (2026-10-23 제작자 등록).
	property Entity stampRow = "9366af9b-5947-4d42-bb17-19bfd943732a"
	property string StampEmptyRUID = "cbb1ba981a584758b95d4420724caadb"
	property string StampDoneRUID = "384b714c5e594216aea380d560e4902a"
	property string StampFlashRUID = "59a1108cf5574f37afe359b5737a8915"
	property string StampSoundRUID = "f1d35a2c536945b9adb7f9c5069796ad"
	property string AllClearSoundRUID = "70563cbc2642429690d64dbabc2eb84c"
	property boolean hintBaseSaved = false

	property table rowButtons = {}
	property table rowEntities = {}
	property table rowHandlers = {}
	property any closeHandler = nil

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		self.Entity.Enable = false
		self:ResolveRefs()
		if isvalid(self.btnClose) then
			self.closeHandler = self.btnClose:ConnectEvent(ButtonClickEvent, function() self:Close() end)
		end
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		if self.closeHandler and isvalid(self.btnClose) then
			self.btnClose:DisconnectEvent(ButtonClickEvent, self.closeHandler)
		end
		self:ClearRows()
	end

	@ExecSpace("ClientOnly")
	method void ResolveRefs()
		local bg = self.Entity:GetChildByName("Bg")
		if not isvalid(bg) then return end
		if not isvalid(self.btnClose) then self.btnClose = bg:GetChildByName("BtnClose") end
		if not isvalid(self.requestList) then self.requestList = bg:GetChildByName("List") end
		if isvalid(self.requestList) and not isvalid(self.requestTemplate) then
			self.requestTemplate = self.requestList:GetChildByName("RequestTemplate")
		end
		if not isvalid(self.dayText) then self.dayText = bg:GetChildByName("DayText") end
		if not isvalid(self.hintText) then self.hintText = bg:GetChildByName("HintText") end
		if not isvalid(self.stampRow) then self.stampRow = bg:GetChildByName("StampRow") end
		if not self.hintBaseSaved and isvalid(self.hintText) and isvalid(self.hintText.TextComponent) then
			self.hintBaseColor = self.hintText.TextComponent.FontColor
			self.hintBaseSaved = true
		end
	end

	@ExecSpace("ClientOnly")
	method void Open()
		self:ResolveRefs()
		self.Entity.Enable = true
		self:Refresh()
	end

	@ExecSpace("ClientOnly")
	method void Close()
		self.Entity.Enable = false
	end

	@ExecSpace("ClientOnly")
	method integer GetServerDayIndex()
		return math.floor(os.time() / 86400)
	end

	@ExecSpace("ClientOnly")
	method table GetTodaysRequestIds()
		-- Same deterministic pick as PlayerInventory (server-shared day seed).
		local inv = self:GetLocalInventory()
		if isvalid(inv) then
			return inv:GetTodaysRequestIds()
		end
		return {}
	end

	@ExecSpace("ClientOnly")
	method any GetLocalInventory()
		local lp = _UserService.LocalPlayer
		if not isvalid(lp) then return nil end
		return lp:GetComponent("script.PlayerInventory")
	end

	@ExecSpace("ClientOnly")
	method void Refresh()
		self:ClearRows()
		local day = self:GetServerDayIndex()
		if isvalid(self.dayText) then
			local tc = self.dayText.TextComponent
			if isvalid(tc) then tc.Text = "오늘의 의뢰" end
		end
		local inv = self:GetLocalInventory()
		if not isvalid(inv) then return end
		inv:EnsureDailyRequestState()

		local ids = inv:GetTodaysRequestIds()
		self:RefreshStamps(inv, #ids)
		if isvalid(self.hintText) then
			local tc = self.hintText.TextComponent
			if isvalid(tc) then
				tc.Text = self:BuildBonusHint(inv, #ids)
				-- 오늘 의뢰를 모두 마치면 안내 줄(도장 ★★★)을 진한 호박색으로 — 밝은 금색(1,0.84,0.35)은 종이 바탕에서 안 읽혔다(2026-10-23 제작자).
				local doneAll = #ids > 0 and inv:CountCompletedTodaysRequests() >= #ids
				if doneAll then tc.FontColor = Color(0.66, 0.38, 0.02, 1) else tc.FontColor = self.hintBaseColor end
			end
		end
		if not isvalid(self.requestList) or not isvalid(self.requestTemplate) then return end
		self.requestTemplate.Enable = false

		local ds = _DataService:GetTable("RequestPoolDataSet")
		if ds == nil then
			log_error("UIRequestController: RequestPoolDataSet missing")
			return
		end

		-- 의뢰 줄 3개(88px, 간격 100)를 목록 칸(300) 가운데에 — 구 140 은 첫 줄이 목록 위로 삐져나와 안내 둘째 줄을 덮었다(2026-10-23 캡처).
		local y0 = 100
		local gap = 100
		for i, reqId in ipairs(ids) do
			local row = ds:FindRow("RequestId", reqId)
			if row ~= nil then
				local function cell(col, def)
					local ok, v = pcall(function() return row:GetItem(col) end)
					if ok and v ~= nil and v ~= "" then return v end
					return def
				end
				local reqItem = tostring(cell("RequiredItem", ""))
				local reqCnt = math.floor(tonumber(cell("RequiredCount", "1")) or 1)
				local rewItem = tostring(cell("RewardItem", "Coin"))
				local rewCnt = math.floor(tonumber(cell("RewardCount", "1")) or 1)
				local owned = inv:GetItemCount(reqItem)
				local done = inv:IsDailyRequestCompleted(reqId)
				local reqDisp = inv:GetItemDisplayName(reqItem)
				local requester = tostring(cell("RequesterName", ""))
				local requesterSuffix = ""
				if requester ~= "" then requesterSuffix = "  · " .. requester end

				-- Clone(name) 문자열 인자 — Entity parent 전달 시 LEA-1103 (Research BuildList 선례)
				local clone = self.requestTemplate:Clone("ReqRow_" .. tostring(i))
				if isvalid(clone) then
					clone.Enable = true
					local tr = clone.UITransformComponent
					if isvalid(tr) then
						tr.anchoredPosition = Vector2(0, y0 - (i - 1) * gap)
						tr.RectSize = Vector2(580, 88)
					end

					local nameEnt = clone:GetChildByName("Name")
					if isvalid(nameEnt) and isvalid(nameEnt.TextComponent) then
						if done then
							nameEnt.TextComponent.Text = "[완료] " .. reqDisp .. " x" .. tostring(reqCnt) .. requesterSuffix
							nameEnt.TextComponent.FontColor = Color(0.52, 0.49, 0.43, 1)
						else
							nameEnt.TextComponent.Text = reqDisp .. " x" .. tostring(reqCnt) .. requesterSuffix
							nameEnt.TextComponent.FontColor = Color(0.96, 0.94, 0.90, 1)
						end
					end
					local progEnt = clone:GetChildByName("Progress")
					if isvalid(progEnt) and isvalid(progEnt.TextComponent) then
						if done then
							progEnt.TextComponent.Text = "납품 완료"
							progEnt.TextComponent.FontColor = Color(0.49, 0.72, 0.36, 1)
						else
							progEnt.TextComponent.Text = "보유 " .. tostring(owned) .. " / " .. tostring(reqCnt)
								.. "  →  보상 " .. inv:GetItemDisplayName(rewItem) .. " x" .. tostring(rewCnt)
							if owned >= reqCnt then
								progEnt.TextComponent.FontColor = Color(0.94, 0.66, 0.19, 1)
							else
								progEnt.TextComponent.FontColor = Color(0.94, 0.27, 0.27, 1)
							end
						end
					end
					local iconEnt = clone:GetChildByName("Icon")
					if isvalid(iconEnt) then
						local itemDs = _DataService:GetTable("item_dataset")
						if itemDs ~= nil then
							local ir = itemDs:FindRow("Name", reqItem)
							if ir ~= nil then
								local okI, icon = pcall(function() return ir:GetItem("IconRUID") end)
								if okI and icon ~= nil and icon ~= "" and isvalid(iconEnt.SpriteGUIRendererComponent) then
									iconEnt.SpriteGUIRendererComponent.ImageRUID = icon
								end
							end
						end
					end

					local btn = clone:GetChildByName("BtnDeliver")
					if isvalid(btn) then
						local btc = btn.TextComponent
						if isvalid(btc) then
							if done then btc.Text = "완료"
							elseif owned >= reqCnt then btc.Text = "납품"
							else btc.Text = "부족" end
						end
						-- 납품 불가(재료 부족·완료)는 회색 비활성, 납품 가능만 활성색(템플릿 원본)으로 구분한다.
						if _UIButtonStyle ~= nil then _UIButtonStyle:SetActive(btn, (not done) and owned >= reqCnt) end
						local rid = reqId
						local h = btn:ConnectEvent(ButtonClickEvent, function()
							self:OnDeliverClick(rid)
						end)
						self.rowHandlers[rid] = h
						self.rowButtons[rid] = btn
					end
					self.rowEntities[reqId] = clone
				end
			end
		end
	end

	@ExecSpace("ClientOnly")
	method string BuildBonusHint(any inv, integer total)
		-- 도장 줄 아래 한 줄: 올클리어 보답(Difficulty=bonus 행) 또는 상태. 진행도는 도장 그림(RefreshStamps)이 보여 준다.
		local bonusId = inv:GetDailyBonusRequestId()
		if bonusId == "" then
			return "의뢰마다 하루 한 번씩 납품할 수 있어요"
		end
		if inv:IsDailyRequestCompleted(bonusId) then
			return "오늘의 보답을 받았습니다. 내일 또 만나요!"
		end
		local parts = {}
		local rewItem = inv:GetRequestCell(bonusId, "RewardItem")
		local rewCnt = math.floor(tonumber(inv:GetRequestCell(bonusId, "RewardCount")) or 0)
		if rewItem ~= "" and rewCnt > 0 then
			table.insert(parts, inv:GetItemDisplayName(rewItem) .. " x" .. tostring(rewCnt))
		end
		for rawName, rawCnt in string.gmatch(inv:GetRequestCell(bonusId, "ExtraRewards"), "([^|:]+):(%d+)") do
			local name = string.match(rawName, "^%s*(.-)%s*$") or ""
			local cnt = math.floor(tonumber(rawCnt) or 0)
			if name ~= "" and cnt > 0 then
				table.insert(parts, inv:GetItemDisplayName(name) .. " x" .. tostring(cnt))
			end
		end
		for rawName, rawCnt, rawP in string.gmatch(inv:GetRequestCell(bonusId, "ChanceRewards"), "([^|:]+):(%d+):([%d%.]+)") do
			local cName = string.match(rawName, "^%s*(.-)%s*$") or ""
			local pct = math.floor((tonumber(rawP) or 0) * 100 + 0.5)
			if cName ~= "" and pct > 0 then
				table.insert(parts, tostring(pct) .. "% " .. inv:GetItemDisplayName(cName))
			end
		end
		return "모두 마치면 " .. table.concat(parts, " · ")
	end

	@ExecSpace("ClientOnly")
	method void RefreshStamps(any inv, integer total)
		-- 오늘 도장 3칸 = 납품 수, 주간 5칸 = 이번 주 올클리어 일수. 직전 표시보다 늘어난 칸은 "쾅" 연출 + 효과음.
		if not isvalid(self.stampRow) then return end
		local done = math.min(inv:CountCompletedTodaysRequests(), total)
		local goal = inv:GetWeeklyStampGoal()
		local week = math.min(inv:GetDisplayedWeeklyStampCount(), goal)
		local prevDone = self._T.shownDone
		local prevWeek = self._T.shownWeek
		for i = 1, 3 do
			local e = self.stampRow:GetChildByName("Today_" .. i)
			if isvalid(e) then
				e.Enable = i <= total
				self:SetStamp(e, i <= done, prevDone ~= nil and i > prevDone and i <= done)
			end
		end
		for i = 1, 5 do
			local e = self.stampRow:GetChildByName("Week_" .. i)
			if isvalid(e) then
				e.Enable = i <= goal
				self:SetStamp(e, i <= week, prevWeek ~= nil and i > prevWeek and i <= week)
			end
		end
		local label = self.stampRow:GetChildByName("WeekLabel")
		if isvalid(label) then label.Enable = goal > 0 end
		if prevDone ~= nil and done > prevDone and _BGMManager ~= nil then
			if done >= total and total > 0 then
				_BGMManager:PlayInGameSound(self.AllClearSoundRUID, 1.0)
			else
				_BGMManager:PlayInGameSound(self.StampSoundRUID, 1.0)
			end
		end
		self._T.shownDone = done
		self._T.shownWeek = week
	end

	@ExecSpace("ClientOnly")
	method void SetStamp(Entity e, boolean stamped, boolean animate)
		-- 칸 그림 바꾸기. animate = 방금 찍힘 → 반짝이 그림으로 1.6배에서 1.0배로 0.25초 동안 눌러 찍고, 끝나면 보통 도장 그림.
		local sp = e.SpriteGUIRendererComponent
		local t = e.UITransformComponent
		if not isvalid(sp) or not isvalid(t) then return end
		if not stamped then
			sp.ImageRUID = self.StampEmptyRUID
			t.Scale = Vector3(1, 1, 1)
			return
		end
		if not animate then
			sp.ImageRUID = self.StampDoneRUID
			t.Scale = Vector3(1, 1, 1)
			return
		end
		sp.ImageRUID = self.StampFlashRUID
		local steps = 8
		local n = 0
		t.Scale = Vector3(1.6, 1.6, 1)
		local timer = nil
		timer = _TimerService:SetTimerRepeat(function()
			n = n + 1
			if not isvalid(e) or not isvalid(t) then
				_TimerService:ClearTimer(timer)
				return
			end
			local k = 1.6 - 0.6 * math.min(1, n / steps)
			t.Scale = Vector3(k, k, 1)
			if n >= steps + 4 then
				sp.ImageRUID = self.StampDoneRUID
				t.Scale = Vector3(1, 1, 1)
				_TimerService:ClearTimer(timer)
			end
		end, 1 / 30)
	end

	@ExecSpace("ClientOnly")
	method void ClearRows()
		for id, btn in pairs(self.rowButtons) do
			if isvalid(btn) and self.rowHandlers[id] then
				btn:DisconnectEvent(ButtonClickEvent, self.rowHandlers[id])
			end
		end
		for id, ent in pairs(self.rowEntities) do
			if isvalid(ent) then ent:Destroy() end
		end
		self.rowButtons = {}
		self.rowHandlers = {}
		self.rowEntities = {}
	end

	@ExecSpace("ClientOnly")
	method void OnDeliverClick(string requestId)
		local inv = self:GetLocalInventory()
		if not isvalid(inv) then return end
		if inv:IsDailyRequestCompleted(requestId) then
			local lp = _UserService.LocalPlayer
			if isvalid(lp) then
				local pc = lp:GetComponent("script.PlayerController")
				if isvalid(pc) then pc:ShowMineFeedback("이미 납품한 의뢰입니다.") end
			end
			return
		end
		inv:ServerRequestDeliver(requestId)
		-- Refresh shortly after server responds (synced props)
		_TimerService:SetTimerOnce(function()
			if isvalid(self) and self.Entity.Enable then self:Refresh() end
		end, 0.25)
	end

end

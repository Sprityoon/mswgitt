@Component
script UICharacterController extends Component
	-- 캐릭터 정보창 (2026-09-23 메이플식 재구성).
	--   좌: 프로필 카드(아바타·레벨·직업·이름·SP) + 장비 6칸(주무기·투구·갑옷·장갑·신발·방패)
	--   우: 전투력 → 핵심 능력치 2×2 → HP/MP/기력/EXP 게이지 → 세부 능력치 → 영지 권한 버튼
	-- 장비 칸 클릭 = 해제. 장착은 인벤토리에서 장비 더블클릭(무기는 이 창이 열려 있을 때).
	-- 모든 수치는 서버와 같은 계산식(PlayerController / PlayerInventory 공용 메서드)에서 읽는다.

	property Entity characterPopup = "d069e6fa-bcb5-4bd0-b1a9-accf919aafb3"
	property ButtonComponent btnClose = "1fbacf8c-7528-4613-9ec6-a00269c0fdbe"
	property Entity btnPermission = "ad431a65-e9d4-4d55-9f66-d15c63103c59"

	-- 프로필 카드
	property TextGUIRendererComponent levelText = "5eba9ecc-9a4f-4f37-84ad-9cd35e7955f8"
	property TextGUIRendererComponent jobText = "1c79842d-92ad-4fa3-8c0c-4371619932ff"
	property TextGUIRendererComponent nameText = "7a882dc5-ea84-4019-b14d-ea6e2d2226dd"
	property TextGUIRendererComponent spText = "e2b03a91-8b79-43e5-8243-35525b61d375"

	-- 전투력 · 핵심 능력치
	property TextGUIRendererComponent powerVal = "6d0668e6-2658-4a64-94d8-b39d173f5b8a"
	property TextGUIRendererComponent atkVal = "156eeb18-e3b4-412d-8b4b-4c8bac9fc414"
	property TextGUIRendererComponent magVal = "f1cadcaa-ba28-4aa9-bee4-22d2083f94e5"
	property TextGUIRendererComponent skillAtkVal = "a9fa9a3d-c924-419a-b76d-f0faed5bb31a"
	property TextGUIRendererComponent defVal = "e3b1a7fe-ba4e-4f03-bc80-94a73109f19b"

	-- 게이지 (색은 프로필 위젯과 같은 의미 고정: HP 빨강 · MP 파랑 · 기력 노랑 · EXP 초록)
	property SpriteGUIRendererComponent hpFill = "4c582344-9836-43aa-85f6-669dd3c2afee"
	property TextGUIRendererComponent hpVal = "092f75ca-38bc-478c-97c1-c786497c2ded"
	property SpriteGUIRendererComponent mpFill = "012dce81-caac-497e-9c20-6b113a00a2da"
	property TextGUIRendererComponent mpVal = "1ef0444b-501e-48dc-bff6-510ee7096f49"
	property SpriteGUIRendererComponent staFill = "0322cf8b-5251-4010-b823-c19dc3a15fe3"
	property TextGUIRendererComponent staVal = "5508a248-6c21-4fe2-947a-974aa2b97f02"
	property SpriteGUIRendererComponent xpFill = "5077a1e1-1383-4aea-b735-f76e0849f628"
	property TextGUIRendererComponent xpVal = "0c217a36-90fa-4839-92bf-43d41f0c15de"

	-- 세부 능력치
	property TextGUIRendererComponent dmgRedVal = "3288883f-58fc-4ea0-9473-e8cdd7f93069"
	property TextGUIRendererComponent moveVal = "505f5a4b-67b5-4d1a-9bcc-00e0ebb5e269"
	property TextGUIRendererComponent gatherVal = "25695922-0bfb-4f35-a681-7d0c15fa1d62"
	property TextGUIRendererComponent fishVal = "820730e2-978d-4162-8c16-c8f8abe3eac5"
	property TextGUIRendererComponent weaponVal = "e8e3d955-34ff-4d9d-b9ff-08625a07c04f"

	-- 장비 칸 엔티티 경로 접두어 (칸 이름 = Slot_<EquipSlot>)
	property string GearSlotPathPrefix = "/ui/PopupGroup/CharacterPopup/Gear/Slot_"
	-- 창이 열려 있는 동안 수치를 다시 그리는 주기(초)
	property number LiveRefreshInterval = 0.5

	property number CurrentScale = 1.0
	property number TargetScale = 1.0
	property any ScaleTimer = nil
	property any closeHandler = nil
	property any liveTimer = nil
	property table slotHandlers = {}
	property number LastToggleTime = 0

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 닫힌 상태로 시작, 닫기·권한·장비 칸 클릭을 배선한다.
		self.characterPopup.Enable = false
		self.closeHandler = self.btnClose.Entity:ConnectEvent(ButtonClickEvent, function() self:Close() end)

		if isvalid(self.btnPermission) then
			self.btnPermission:ConnectEvent(ButtonClickEvent, function()
				self:Close()
				local permPopup = _EntityService:GetEntityByPath("/ui/PopupGroup/PermissionPopup")
				if isvalid(permPopup) then
					local ctrl = permPopup:GetComponent("script.UIPermissionController")
					if isvalid(ctrl) then
						ctrl:Open()
					end
				end
			end)
		end

		for _, slot in ipairs(self:GearSlots()) do
			local ent = _EntityService:GetEntityByPath(self.GearSlotPathPrefix .. slot)
			if isvalid(ent) then
				local s = slot
				local h = ent:ConnectEvent(ButtonClickEvent, function() self:OnGearSlotClicked(s) end)
				self.slotHandlers[slot] = { entity = ent, eventHandler = h }
			end
		end

		self:UpdateDimmer()
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- 연결한 이벤트·타이머 해제.
		if isvalid(self.btnClose) then
			self.btnClose.Entity:DisconnectEvent(ButtonClickEvent, self.closeHandler)
		end
		for _, rec in pairs(self.slotHandlers) do
			if rec ~= nil and isvalid(rec.entity) then
				rec.entity:DisconnectEvent(ButtonClickEvent, rec.eventHandler)
			end
		end
		self:StopLiveRefresh()
	end

	@ExecSpace("ClientOnly")
	method table GearSlots()
		-- 장비 슬롯 id 순서 — PlayerInventory:GetGearSlotOrder 와 같다(서버 단일 정의를 그대로 쓴다).
		local inv = self:GetInventory()
		if inv ~= nil then return inv:GetGearSlotOrder() end
		return { "weapon", "helmet", "armor", "gloves", "shoes", "shield" }
	end

	@ExecSpace("ClientOnly")
	method void Toggle()
		-- description: Toggles the character information popup with time-based debounce check.
		local now = _UtilLogic.ElapsedSeconds
		if now - self.LastToggleTime < 0.15 then return end
		self.LastToggleTime = now

		if self.TargetScale > 0.9 and self.characterPopup.Enable then
			self:Close()
		else
			self:Open()
		end
	end

	@ExecSpace("ClientOnly")
	method void Open()
		-- 팝 인 + 즉시 갱신 + 열려 있는 동안 주기 갱신(HP·기력 변화 반영).
		self.characterPopup.Enable = true
		local transform = self.characterPopup.UITransformComponent
		if isvalid(transform) then
			self.CurrentScale = 0.8
			transform.Scale = Vector3(0.8, 0.8, 1.0)
		end
		self:ApplyScaleTween(1.0)

		self:RefreshStats()
		self:UpdateDimmer()
		self:StopLiveRefresh()
		local iv = self.LiveRefreshInterval
		if iv < 0.1 then iv = 0.5 end
		self.liveTimer = _TimerService:SetTimerRepeat(function()
			if self.characterPopup.Enable then self:RefreshStats() end
		end, iv)
	end

	@ExecSpace("ClientOnly")
	method void Close()
		self:StopLiveRefresh()
		self:ApplyScaleTween(0.8)
	end

	@ExecSpace("ClientOnly")
	method void StopLiveRefresh()
		if self.liveTimer ~= nil then
			_TimerService:ClearTimer(self.liveTimer)
			self.liveTimer = nil
		end
	end

	@ExecSpace("ClientOnly")
	method void ApplyScaleTween(number targetScale)
		self.TargetScale = targetScale

		if self.ScaleTimer then
			_TimerService:ClearTimer(self.ScaleTimer)
			self.ScaleTimer = nil
		end

		local transform = self.characterPopup.UITransformComponent
		if not isvalid(transform) then return end

		self.ScaleTimer = _TimerService:SetTimerRepeat(function()
			if not isvalid(transform) then
				if self.ScaleTimer then
					_TimerService:ClearTimer(self.ScaleTimer)
					self.ScaleTimer = nil
				end
				return
			end

			local diff = self.TargetScale - self.CurrentScale
			if math.abs(diff) < 0.01 then
				self.CurrentScale = self.TargetScale
				transform.Scale = Vector3(self.CurrentScale, self.CurrentScale, 1.0)

				_TimerService:ClearTimer(self.ScaleTimer)
				self.ScaleTimer = nil

				if self.TargetScale < 0.9 then
					self.characterPopup.Enable = false
					self:UpdateDimmer()
				end
			else
				self.CurrentScale = self.CurrentScale + diff * 0.3
				transform.Scale = Vector3(self.CurrentScale, self.CurrentScale, 1.0)
			end
		end, 1/60)
	end

	---------------------------------------------------------------------------
	-- 갱신
	---------------------------------------------------------------------------

	@ExecSpace("ClientOnly")
	method void RefreshStats()
		-- 창 전체를 현재 값으로 다시 그린다.
		local player = _UserService.LocalPlayer
		if not isvalid(player) then return end
		local playerComp = player.PlayerComponent
		local controller = player:GetComponent("script.PlayerController")
		local inv = self:GetInventory()

		-- 영지 주인에게만 권한 버튼
		if isvalid(self.btnPermission) then
			local currentMap = player.CurrentMap
			local isOwnerOfHome = false
			if isvalid(currentMap) and string.sub(currentMap.Name, 1, 5) == "Home_" then
				local ownerId = string.sub(currentMap.Name, 6)
				if playerComp and playerComp.UserId == ownerId then
					isOwnerOfHome = true
				end
			end
			self.btnPermission.Enable = isOwnerOfHome
		end

		local maxHp = 1
		if isvalid(playerComp) then
			maxHp = math.max(1, playerComp.MaxHp)
			self:SetGauge(self.hpFill, self.hpVal, playerComp.Hp, maxHp, "")
		end

		if not isvalid(controller) then return end

		-- 프로필
		local lvl = controller.Level or 1
		self:SetText(self.levelText, "Lv. " .. tostring(lvl))
		local jobTitle = "모험가"
		local okJ, jName = pcall(function() return controller:GetJobName(controller.JobId or "") end)
		if okJ and jName ~= nil and jName ~= "" then jobTitle = jName end
		self:SetText(self.jobText, jobTitle)
		self:SetText(self.nameText, controller.PlayerName or player.Name)
		self:SetText(self.spText, "보유 SP  " .. tostring(controller.SP or 0))

		-- 핵심 능력치 (서버 스킬 피해식과 같은 출처: 캐릭터 공격력 + 장비)
		local charAtk = self:SafeNumber(function() return controller:GetCharacterAttack() end, 8)
		local magBase = self:SafeNumber(function() return controller:GetMagicAttack() end, 0)
		local gearAtk = 0
		local gearMag = 0
		local gearSkill = 0
		if inv ~= nil then
			gearAtk = math.floor(inv:GetGearStat("Attack"))
			gearMag = math.floor(inv:GetGearStat("MagicAttack"))
			gearSkill = math.floor(inv:GetGearStat("SkillAttack"))
		end
		local physical = charAtk + gearAtk
		local magical = magBase + gearMag
		local totalDef = self:SafeNumber(function() return controller:GetTotalDefense() end, controller.Defense or 0)
		self:SetText(self.atkVal, tostring(physical))
		self:SetText(self.magVal, tostring(magical))
		self:SetText(self.skillAtkVal, "+" .. tostring(gearSkill))
		self:SetText(self.defVal, tostring(math.floor(totalDef)))

		-- 전투력 = (물리 + 마법 + 스킬 공격력) × 10 + 방어력 × 4 + 최대 HP × 0.5  (표시용 합산 지표)
		local power = math.floor((physical + magical + gearSkill) * 10 + totalDef * 4 + maxHp * 0.5)
		self:SetText(self.powerVal, self:FormatThousands(power))

		-- 게이지
		local maxMana = self:SafeNumber(function() return controller:GetMaxMana() end, 60)
		self:SetGauge(self.mpFill, self.mpVal, math.floor(controller.Mana or 0), maxMana, "")
		self:SetGauge(self.staFill, self.staVal, controller.Stamina or 0, controller.MaxStamina or 100, "")
		local xp = controller.XP or 0
		local maxXP = math.max(1, controller.MaxXP or 100)
		local pct = math.floor((xp / maxXP) * 1000) / 10
		self:SetGauge(self.xpFill, self.xpVal, xp, maxXP, " (" .. tostring(pct) .. "%)")

		-- 세부 능력치
		local reduction = 0
		if totalDef > 0 then reduction = (1 - 100 / (100 + totalDef)) * 100 end
		self:SetText(self.dmgRedVal, string.format("%.1f%%", reduction))
		local move = self:SafeNumber(function() return controller:GetBuffedMoveSpeed() end, 7.2)
		self:SetText(self.moveVal, tostring(math.floor(move / 7.2 * 100 + 0.5)) .. "%")
		self:SetText(self.gatherVal, tostring(math.floor((controller.GatheringSpeed or 1) * 100 + 0.5)) .. "%")
		self:SetText(self.fishVal, "Lv. " .. tostring(controller.FishingLevel or 1))

		-- 장비 칸 + 주무기 줄
		self:RefreshGear(inv)
	end

	@ExecSpace("ClientOnly")
	method void RefreshGear(any inv)
		-- 장비 칸 아이콘·라벨. 비었으면 칸 이름, 차 있으면 아이템 표시명(자동 주무기는 "(자동)").
		local weaponLine = "없음"
		for _, slot in ipairs(self:GearSlots()) do
			local ent = _EntityService:GetEntityByPath(self.GearSlotPathPrefix .. slot)
			if isvalid(ent) then
				local key = ""
				local label = slot
				if inv ~= nil then
					key = inv:GetGearKey(slot)
					label = inv:GetGearSlotLabel(slot)
				end
				local icon = ent:GetChildByName("Icon")
				local text = ent.TextGUIRendererComponent
				if key ~= "" then
					local baseName = inv:GetBaseItemName(key)
					local disp = inv:GetItemDisplayName(baseName)
					local auto = slot == "weapon" and inv:IsWeaponAutoSelected()
					if isvalid(icon) and isvalid(icon.SpriteGUIRendererComponent) then
						icon.SpriteGUIRendererComponent.ImageRUID = self:GetItemIcon(baseName)
						icon.SpriteGUIRendererComponent.Color = Color(1, 1, 1, 1)
						icon.Enable = true
					end
					if isvalid(text) then
						text.Text = disp
						text.FontColor = Color(1.0, 0.9, 0.7, 1)
					end
					if slot == "weapon" then
						weaponLine = disp
						if auto then weaponLine = weaponLine .. "  (자동)" end
					end
				else
					if isvalid(icon) then icon.Enable = false end
					if isvalid(text) then
						text.Text = label
						text.FontColor = Color(0.72, 0.64, 0.52, 1)
					end
				end
			end
		end
		self:SetText(self.weaponVal, weaponLine)
	end

	@ExecSpace("ClientOnly")
	method void OnGearSlotClicked(string slot)
		-- 칸 클릭 = 등록 해제 (자동 주무기는 등록된 게 아니라 해제할 것이 없다).
		local inv = self:GetInventory()
		if inv == nil then return end
		local registered = inv:GetGearSlots()[slot]
		if registered == nil or registered == "" then return end
		inv:ServerRequestUnequipGear(slot)
	end

	---------------------------------------------------------------------------
	-- 헬퍼
	---------------------------------------------------------------------------

	@ExecSpace("ClientOnly")
	method any GetInventory()
		local player = _UserService.LocalPlayer
		if not isvalid(player) then return nil end
		local inv = player:GetComponent("script.PlayerInventory")
		if not isvalid(inv) then return nil end
		return inv
	end

	@ExecSpace("ClientOnly")
	method void SetText(any comp, string value)
		if isvalid(comp) then comp.Text = value end
	end

	@ExecSpace("ClientOnly")
	method void SetGauge(any fill, any valText, number cur, number maxVal, string suffix)
		-- Filled 스프라이트 게이지 + "현재 / 최대" 문구.
		local m = maxVal
		if m == nil or m <= 0 then m = 1 end
		if isvalid(fill) then
			fill.FillAmount = math.max(0, math.min(1, cur / m))
		end
		if isvalid(valText) then
			valText.Text = tostring(math.floor(cur)) .. " / " .. tostring(math.floor(m)) .. suffix
		end
	end

	@ExecSpace("ClientOnly")
	method number SafeNumber(any fn, number fallback)
		-- 서버 전용 컴포넌트가 아직 동기화 전이어도 창이 깨지지 않게 한다.
		local ok, v = pcall(fn)
		if ok and v ~= nil then return tonumber(v) or fallback end
		return fallback
	end

	@ExecSpace("ClientOnly")
	method string FormatThousands(integer n)
		-- 1234567 → "1,234,567"
		local s = tostring(math.floor(n))
		local out = ""
		local len = string.len(s)
		for i = 1, len do
			out = out .. string.sub(s, i, i)
			local remain = len - i
			if remain > 0 and remain % 3 == 0 then out = out .. "," end
		end
		return out
	end

	@ExecSpace("ClientOnly")
	method string GetItemIcon(string itemName)
		-- item_dataset.IconRUID
		local ds = _DataService:GetTable("item_dataset")
		if ds == nil then return "" end
		local row = ds:FindRow("Name", itemName)
		if row == nil then return "" end
		local ok, v = pcall(function() return row:GetItem("IconRUID") end)
		if ok and v ~= nil then return tostring(v) end
		return ""
	end

	@ExecSpace("ClientOnly")
	method void UpdateDimmer()
		local dimmer = _EntityService:GetEntityByPath("/ui/PopupGroup/Dimmer")
		if not isvalid(dimmer) then return end

		local inv = _EntityService:GetEntityByPath("/ui/PopupGroup/InventoryPopup")
		local craft = _EntityService:GetEntityByPath("/ui/PopupGroup/CraftingPopup")
		local char = _EntityService:GetEntityByPath("/ui/PopupGroup/CharacterPopup")

		local anyOpen = (isvalid(inv) and inv.Enable) or (isvalid(craft) and craft.Enable) or (isvalid(char) and char.Enable)
		dimmer.Enable = anyOpen
	end

end

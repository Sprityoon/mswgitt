	property ButtonComponent btnNameCancel = "8eb5834c-f2f8-48be-869e-e84154ab0431"

	property table slotMeta = {}
	property integer pendingSlot = 0
	property string pendingAction = ""
	property string menuMode = "title"
	property boolean isOpen = false
	property boolean useAccountLook = true

	property integer hairIdx = 1
	property integer faceIdx = 1
	property integer bodyIdx = 1
	property integer coatIdx = 1
	property string defaultPantsRuid = "e6ff0ea602e043f48a7e231ed4f95daf"

	-- 닉네임 길이 규약. 서버(PersistenceManager.SelectSaveSlot)와 .ui의 CharacterLimit도 같은 값이어야 한다.
	property integer nickMinLen = 2
	property integer nickMaxLen = 15
	property string uiHoverSfx = "159bf70a74634bfc8e91a29e527a4be5"
	property string uiClickSfx = "972843e759204d3e9ad84e7d3fa94f83"
	property number uiSfxVolume = 0.8

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		self:SetRootEnable(false)
		self:ShowPanel("title")
		if isvalid(self.namePrompt) then self.namePrompt.Enable = false end

		self:BindBtn(self.btnNew, function() self:OnTitleNew() end)
		self:BindBtn(self.btnContinue, function() self:OnTitleContinue() end)
		self:BindBtn(self.btnQuit, function() self:OnTitleQuit() end)
		self:BindBtn(self.btnSlotBack, function() self:ShowPanel("title") end)
		self:BindBtn(self.btnCustomBack, function() self:ShowPanel("slot") end)
		self:BindBtn(self.btnCustomStart, function() self:OnCustomStart() end)
		self:BindBtn(self.btnLookAccount, function() self:SetLookMode(true) end)
		self:BindBtn(self.btnLookCustom, function() self:SetLookMode(false) end)
		self:BindBtn(self.btnHairPrev, function() self:CyclePart("hair", -1) end)
		self:BindBtn(self.btnHairNext, function() self:CyclePart("hair", 1) end)
		self:BindBtn(self.btnFacePrev, function() self:CyclePart("face", -1) end)
		self:BindBtn(self.btnFaceNext, function() self:CyclePart("face", 1) end)
		self:BindBtn(self.btnBodyPrev, function() self:CyclePart("body", -1) end)
		self:BindBtn(self.btnBodyNext, function() self:CyclePart("body", 1) end)
		self:BindBtn(self.btnCoatPrev, function() self:CyclePart("coat", -1) end)
		self:BindBtn(self.btnCoatNext, function() self:CyclePart("coat", 1) end)

		for i = 1, 5 do
			local slotIndex = i
			self:BindBtn(self["slot" .. i .. "BtnSelect"], function()
				self:OnSlotSelect(slotIndex)
			end)
			self:BindBtn(self["slot" .. i .. "BtnDelete"], function()
				self:OnDelete(slotIndex)
			end)
		end

		self:BindBtn(self.btnNameOk, function() self:OnNameOk() end)
		self:BindBtn(self.btnNameCancel, function() self:CloseNamePrompt() end)
		self:SetTitleHint("")
		self:SetCustomError("")
		-- 입력 컴포넌트 바인딩은 조용히 실패하면 "글자수가 안 맞는다"로만 보인다 → 시작 시 명시 검증.
		log("[MAINMENU] controller ready — customNameInput="
			.. tostring(isvalid(self.customNameInput))
			.. " nameInput=" .. tostring(isvalid(self.nameInput))
			.. " sfx=on")
	end

	@ExecSpace("ClientOnly")
	method void PlayUiClick()
		if self.uiClickSfx ~= nil and self.uiClickSfx ~= "" then
			_SoundService:PlaySound(self.uiClickSfx, self.uiSfxVolume)
		end
	end

	@ExecSpace("ClientOnly")
	method void PlayUiHover()
		if self.uiHoverSfx ~= nil and self.uiHoverSfx ~= "" then
			_SoundService:PlaySound(self.uiHoverSfx, self.uiSfxVolume)
		end
	end

	@ExecSpace("ClientOnly")
	method void BindBtn(ButtonComponent btn, any fn)
		if isvalid(btn) == false or isvalid(btn.Entity) == false then
			return
		end
		local ent = btn.Entity
		ent:ConnectEvent(ButtonClickEvent, function()
			self:PlayUiClick()
			fn()
		end)
		ent:ConnectEvent(ButtonStateChangeEvent, function(ev)
			if ev ~= nil and ev.state == ButtonState.Hover then
				self:PlayUiHover()
			end
		end)
	end


	@ExecSpace("ClientOnly")
	method void OpenWithMetaJson(string metaJson)
		self.slotMeta = {}
		if metaJson ~= nil and metaJson ~= "" and metaJson ~= "{}" then
			local ok, decoded = pcall(function() return _HttpService:JSONDecode(metaJson) end)
			if ok and type(decoded) == "table" then
				self.slotMeta = decoded
			end
		end
		self.isOpen = true
		self:SetRootEnable(true)
		self:CloseNamePrompt()
		self:ShowPanel("title")
		self:SetTitleHint("")
		log("[MAINMENU] open title")
	end

	@ExecSpace("ClientOnly")
	method void SetTitleHint(string msg)
		-- 힌트 문구가 있을 때만 아래 플레이트·텍스트를 켠다.
		local has = msg ~= nil and msg ~= ""
		if isvalid(self.titleHint) then
			self.titleHint.Text = has and msg or ""
			if isvalid(self.titleHint.Entity) then
				self.titleHint.Entity.Enable = has
			end
		end
		if isvalid(self.titleHintPlate) then
			self.titleHintPlate.Enable = has
		end
	end

	@ExecSpace("ClientOnly")
	method void SetCustomError(string msg)
		-- 에러 문구가 있을 때만 커스텀 화면의 플레이트·텍스트를 켠다.
		local has = msg ~= nil and msg ~= ""
		if isvalid(self.customError) then
			self.customError.Text = has and msg or ""
			if isvalid(self.customError.Entity) then
				self.customError.Entity.Enable = has
			end
		end
		if isvalid(self.customErrorPlate) then
			self.customErrorPlate.Enable = has
		end
	end

	@ExecSpace("ClientOnly")
	method void Close()
		self.isOpen = false
		self:CloseNamePrompt()
		self:SetRootEnable(false)
	end

	@ExecSpace("ClientOnly")
	method void SetRootEnable(boolean on)
		local root = _EntityService:GetEntityByPath("/ui/MainMenuGroup")
		if isvalid(root) then root.Enable = on end
		if isvalid(self.bg) then self.bg.Enable = on end
	end

	@ExecSpace("ClientOnly")
	method void ShowPanel(string which)
		self.menuMode = which
		if isvalid(self.titlePanel) then self.titlePanel.Enable = (which == "title") end
		if isvalid(self.slotPanel) then self.slotPanel.Enable = (which == "slot") end
		if isvalid(self.customizePanel) then self.customizePanel.Enable = (which == "customize") end
		if which == "title" then
			self:SetTitleHint("")
		end
		if which == "slot" then
			self:RefreshSlots()
		elseif which == "customize" then
			self.hairIdx = 1
			self.faceIdx = 1
			self.bodyIdx = 1
			self.coatIdx = 1
			self.useAccountLook = true
			if isvalid(self.customNameInput) then self.customNameInput.Text = "" end
			self:SetCustomError("")
			self:SetLookMode(true)
		end
	end

	@ExecSpace("ClientOnly")
	method void OnTitleNew()
		if not self.isOpen then return end
		self.pendingAction = "new"
		if isvalid(self.slotSubtitle) then self.slotSubtitle.Text = "빈 슬롯을 선택하세요" end
		self:ShowPanel("slot")
	end

	@ExecSpace("ClientOnly")
	method void OnTitleContinue()
		if not self.isOpen then return end
		local any = false
		for i = 1, 5 do
			if self:IsOccupied(i) then any = true break end
		end
		if not any then
			self:SetTitleHint("저장된 캐릭터가 없습니다. 새로하기를 선택하세요.")
			return
		end
		self.pendingAction = "continue"
		if isvalid(self.slotSubtitle) then self.slotSubtitle.Text = "이어할 캐릭터를 선택하세요" end
		self:ShowPanel("slot")
	end

	@ExecSpace("ClientOnly")
	method void OnTitleQuit()
		if not self.isOpen then return end
		local lp = _UserService.LocalPlayer
		if not isvalid(lp) then return end
		local pc = lp:GetComponent("script.PlayerController")
		if isvalid(pc) then
			pc:ServerQuitWorld()
		end
		self:SetTitleHint("월드를 나가는 중…")
	end

	@ExecSpace("ClientOnly")
	method boolean IsOccupied(integer slot)
		local meta = self.slotMeta[tostring(slot)]
		return meta ~= nil and type(meta) == "table" and meta.name ~= nil and tostring(meta.name) ~= ""
	end

	@ExecSpace("ClientOnly")
	method void RefreshSlots()
		local isNew = (self.pendingAction == "new")
		for i = 1, 5 do
			local occupied = self:IsOccupied(i)
			local meta = self.slotMeta[tostring(i)]
			local title = self["slot" .. i .. "Title"]
			local info = self["slot" .. i .. "Info"]
			local btnS = self["slot" .. i .. "BtnSelect"]
			local btnD = self["slot" .. i .. "BtnDelete"]
			local avatarEnt = self["slot" .. i .. "Avatar"]

			if isvalid(title) then
				title.Text = occupied and tostring(meta.name) or ("슬롯 " .. tostring(i))
			end
			if isvalid(info) then
				if occupied then
					-- 슬롯 카드가 가로 1행이라 한 줄로 표기 (2줄이면 행 높이를 넘친다).
					local lv = tonumber(meta.level) or 1
					local fish = tonumber(meta.fishLv) or 1
					info.Text = "Lv." .. tostring(lv) .. "  ·  낚시 Lv." .. tostring(fish)
				else
					info.Text = "비어 있음"
				end
			end

			local selectable = (isNew and not occupied) or ((not isNew) and occupied)
			self:SetBtn(btnS, selectable)
			if isvalid(btnS) then
				local label = btnS.Entity and btnS.Entity.TextGUIRendererComponent
				if isvalid(label) then
					if isNew then
						label.Text = "선택"
					else
						label.Text = "이어하기"
					end
				end
			end
			self:SetBtn(btnD, (not isNew) and occupied)

			if occupied then
				if isvalid(avatarEnt) then avatarEnt.Enable = true end
				if type(meta.costume) == "table" then
					self:ApplyCostumeToEntity(avatarEnt, meta.costume)
				else
					self:ApplyCostumeToEntity(avatarEnt, { useAccount = true })
				end
			else
				if isvalid(avatarEnt) then avatarEnt.Enable = false end
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void SetBtn(ButtonComponent btn, boolean on)
		if not isvalid(btn) then return end
		btn.Enable = on
		if isvalid(btn.Entity) then btn.Entity.Enable = on end
	end

	@ExecSpace("ClientOnly")
	method void OnSlotSelect(integer slot)
		if not self.isOpen then return end
		if self.pendingAction == "continue" then
			if not self:IsOccupied(slot) then return end
			self:RequestSelect(slot, false, "", "")
			return
		end
		if self.pendingAction == "new" then
			if self:IsOccupied(slot) then return end
			self.pendingSlot = slot
			self:ShowPanel("customize")
		end
	end

	@ExecSpace("ClientOnly")
	method table DefaultCostume()
		local h = self:HairOptions()[1]
		local f = self:FaceOptions()[1]
		local b = self:BodyOptions()[1]
		local c = self:CoatOptions()[1]
		return {
			hair = h.ruid,
			face = f.ruid,
			body = b.ruid,
			coat = c.ruid,
			pants = self.defaultPantsRuid
		}
	end

	@ExecSpace("ClientOnly")
	method table CurrentCostume()
		local h = self:HairOptions()[self.hairIdx] or self:HairOptions()[1]
		local f = self:FaceOptions()[self.faceIdx] or self:FaceOptions()[1]
		local b = self:BodyOptions()[self.bodyIdx] or self:BodyOptions()[1]
		local c = self:CoatOptions()[self.coatIdx] or self:CoatOptions()[1]
		return {
			useAccount = false,
			hair = h.ruid,
			face = f.ruid,
			body = b.ruid,
			coat = c.ruid,
			pants = self.defaultPantsRuid
		}
	end

	@ExecSpace("ClientOnly")
	method void SetLookMode(boolean useAccount)
		self.useAccountLook = useAccount
		self:SetPartsInteractable(not useAccount)
		-- 선택 강조: 계정=초록 톤, 커스텀=나무 톤
		if isvalid(self.btnLookAccount) then
			local spr = self.btnLookAccount.Entity and self.btnLookAccount.Entity.SpriteGUIRendererComponent
			if isvalid(spr) then
				if useAccount then
					spr.Color = Color(0.35, 0.55, 0.32, 0.92)
				else
					spr.Color = Color(0.42, 0.3, 0.2, 0.75)
				end
			end
		end
		if isvalid(self.btnLookCustom) then
			local spr = self.btnLookCustom.Entity and self.btnLookCustom.Entity.SpriteGUIRendererComponent
			if isvalid(spr) then
				if useAccount then
					spr.Color = Color(0.42, 0.3, 0.2, 0.75)
				else
					spr.Color = Color(0.35, 0.55, 0.32, 0.92)
				end
			end
		end
		self:RefreshCustomizePreview()
		log("[MAINMENU] lookMode account=" .. tostring(useAccount))
	end

	@ExecSpace("ClientOnly")
	method void SetPartsInteractable(boolean on)
		-- 엔티티를 끄면 버튼이 통째로 사라져 레이아웃이 비어 보인다 → 클릭만 막고 흐리게 표시.
		local btns = {
			self.btnHairPrev, self.btnHairNext,
			self.btnFacePrev, self.btnFaceNext,
			self.btnBodyPrev, self.btnBodyNext,
			self.btnCoatPrev, self.btnCoatNext
		}
		for _, btn in ipairs(btns) do
			if isvalid(btn) then
				btn.Enable = on
				local spr = btn.Entity and btn.Entity.SpriteGUIRendererComponent
				if isvalid(spr) then
					if on then
						spr.Color = Color(0.55, 0.4, 0.26, 1)
					else
						spr.Color = Color(0.55, 0.4, 0.26, 0.35)
					end
				end
			end
		end
		if isvalid(self.customParts) then
			self.customParts.Enable = on
		end
	end

	@ExecSpace("ClientOnly")
	method void CyclePart(string part, integer delta)
		if self.useAccountLook then return end
		local list = nil
		local idx = 1
		if part == "hair" then
			list = self:HairOptions()
			idx = self.hairIdx
		elseif part == "face" then
			list = self:FaceOptions()
			idx = self.faceIdx
		elseif part == "body" then
			list = self:BodyOptions()
			idx = self.bodyIdx
		else
			list = self:CoatOptions()
			idx = self.coatIdx
		end
		local n = #list
		if n < 1 then return end
		idx = idx + delta
		if idx < 1 then idx = n end
		if idx > n then idx = 1 end
		if part == "hair" then self.hairIdx = idx
		elseif part == "face" then self.faceIdx = idx
		elseif part == "body" then self.bodyIdx = idx
		else self.coatIdx = idx end
		self:RefreshCustomizePreview()
	end

	@ExecSpace("ClientOnly")
	method void RefreshCustomizePreview()
		if self.useAccountLook then
			if isvalid(self.hairName) then self.hairName.Text = "(계정 외형)" end
			if isvalid(self.faceName) then self.faceName.Text = "-" end
			if isvalid(self.bodyName) then self.bodyName.Text = "-" end
			if isvalid(self.coatName) then self.coatName.Text = "-" end
			self:ApplyCostumeToEntity(self.customPreview, { useAccount = true })
			return
		end
		local h = self:HairOptions()[self.hairIdx]
		local f = self:FaceOptions()[self.faceIdx]
		local b = self:BodyOptions()[self.bodyIdx]
		local c = self:CoatOptions()[self.coatIdx]
		if isvalid(self.hairName) and h then self.hairName.Text = h.name end
		if isvalid(self.faceName) and f then self.faceName.Text = f.name end
		if isvalid(self.bodyName) and b then self.bodyName.Text = b.name end
		if isvalid(self.coatName) and c then self.coatName.Text = c.name end
		self:ApplyCostumeToEntity(self.customPreview, self:CurrentCostume())
	end

	@ExecSpace("ClientOnly")
	method boolean IsAccountCostumeTable(table costume)
		if type(costume) ~= "table" then return true end
		if costume.useAccount == true then return true end
		if costume.useAccount == false then return false end
		if costume.hair ~= nil and tostring(costume.hair) ~= "" then return false end
		return true
	end

	@ExecSpace("ClientOnly")
	method void ApplyCostumeToEntity(Entity avatarEnt, table costume)
		if not isvalid(avatarEnt) or type(costume) ~= "table" then return end
		local cm = avatarEnt.CostumeManagerComponent
		if not isvalid(cm) then return end
		if self:IsAccountCostumeTable(costume) then
			cm.UseCustomEquipOnly = false
			local lp = _UserService.LocalPlayer
			if isvalid(lp) and isvalid(lp.PlayerComponent) then
				cm.DefaultEquipUserId = tostring(lp.PlayerComponent.UserId or "")
			else
				cm.DefaultEquipUserId = ""
			end
			return
		end
		cm.UseCustomEquipOnly = true
		cm.DefaultEquipUserId = ""
		local hair = tostring(costume.hair or "")
		local face = tostring(costume.face or "")
		local body = tostring(costume.body or "")
		local coat = tostring(costume.coat or "")
		local pants = tostring(costume.pants or self.defaultPantsRuid)
		if hair ~= "" then cm:SetEquip(MapleAvatarItemCategory.Hair, hair) end
		if face ~= "" then cm:SetEquip(MapleAvatarItemCategory.Face, face) end
		if body ~= "" then cm:SetEquip(MapleAvatarItemCategory.Body, body) end
		cm:SetEquip(MapleAvatarItemCategory.Longcoat, "")
		if coat ~= "" then cm:SetEquip(MapleAvatarItemCategory.Coat, coat) end
		if pants ~= "" then cm:SetEquip(MapleAvatarItemCategory.Pants, pants) end
	end

	@ExecSpace("ClientOnly")
	method integer Utf8Len(string s)
		-- 닉네임 글자 수: Lua `#`는 UTF-8 바이트라 한글 1자=3으로 세어 오판정됨.
		if s == nil or s == "" then return 0 end
		local n = 0
		local i = 1
		local len = #s
		while i <= len do
			local c = string.byte(s, i)
			if c < 128 then
				i = i + 1
			elseif c < 224 then
				i = i + 2
			elseif c < 240 then
				i = i + 3
			else
				i = i + 4
			end
			n = n + 1
		end
		return n
	end

	@ExecSpace("ClientOnly")
	method void OnCustomStart()
		if not self.isOpen then return end
		local raw = ""
		if isvalid(self.customNameInput) then
			raw = tostring(self.customNameInput.Text or "")
		else
			self:SetCustomError("닉네임 입력창을 찾을 수 없습니다 (UI 바인딩 오류)")
			log_error("[MAINMENU] customNameInput binding is nil — check .ui entity component type")
			return
		end
		raw = string.match(raw, "^%s*(.-)%s*$") or ""
		local nlen = self:Utf8Len(raw)
		if nlen < self.nickMinLen or nlen > self.nickMaxLen then
			self:SetCustomError("닉네임은 " .. tostring(self.nickMinLen) .. "~" .. tostring(self.nickMaxLen) .. "글자로 입력하세요")
			log("[MAINMENU] nickname reject len=" .. tostring(nlen) .. " bytes=" .. tostring(#raw))
			return
		end
		if self.pendingSlot < 1 or self.pendingSlot > 5 then
			self:SetCustomError("슬롯을 다시 선택해 주세요")
			return
		end
		local costume = nil
		if self.useAccountLook then
			costume = { useAccount = true }
		else
			costume = self:CurrentCostume()
			costume.useAccount = false
		end
		local ok, json = pcall(function() return _HttpService:JSONEncode(costume) end)
		if not ok or json == nil or json == "" then
			self:SetCustomError("외형 저장에 실패했습니다")
			return
		end
		self:SetCustomError("")
		log("[MAINMENU] start new slot=" .. tostring(self.pendingSlot) .. " nickLen=" .. tostring(nlen))
		self:RequestSelect(self.pendingSlot, true, raw, json)
	end

	@ExecSpace("ClientOnly")
	method void OnDelete(integer slot)
		if not self.isOpen then return end
		if not self:IsOccupied(slot) then return end
		local meta = self.slotMeta[tostring(slot)]
		self.pendingSlot = slot
		self.pendingAction = "delete"
		if isvalid(self.namePrompt) then self.namePrompt.Enable = true end
		if isvalid(self.nameInput) then self.nameInput.Text = "" end
		if isvalid(self.nameError) then
			self.nameError.Text = "삭제하려면 닉네임 '" .. tostring(meta.name) .. "' 을 입력"
		end
	end

	@ExecSpace("ClientOnly")
	method void OnNameOk()
		local raw = ""
		if isvalid(self.nameInput) then
			raw = tostring(self.nameInput.Text or "")
		else
			if isvalid(self.nameError) then self.nameError.Text = "입력창을 찾을 수 없습니다 (UI 바인딩 오류)" end
			log_error("[MAINMENU] nameInput binding is nil — check .ui entity component type")
			return
		end
		raw = string.match(raw, "^%s*(.-)%s*$") or ""
		if self.pendingAction ~= "delete" then return end
		local meta = self.slotMeta[tostring(self.pendingSlot)]
		local expect = meta and tostring(meta.name) or ""
		if raw ~= expect then
			if isvalid(self.nameError) then self.nameError.Text = "닉네임이 일치하지 않습니다" end
			return
		end
		self:CloseNamePrompt()
		self:RequestDelete(self.pendingSlot)
		self.pendingAction = "continue"
	end

	@ExecSpace("ClientOnly")
	method void CloseNamePrompt()
		if isvalid(self.namePrompt) then self.namePrompt.Enable = false end
		if isvalid(self.nameError) then self.nameError.Text = "" end
	end

	@ExecSpace("ClientOnly")
	method void RequestSelect(integer slot, boolean isNew, string nickname, string costumeJson)
		local lp = _UserService.LocalPlayer
		if not isvalid(lp) then return end
		local pc = lp:GetComponent("script.PlayerController")
		if not isvalid(pc) then return end
		pc:ServerSelectSaveSlot(slot, isNew, nickname or "", costumeJson or "")
	end

	@ExecSpace("ClientOnly")
	method void RequestDelete(integer slot)
		local lp = _UserService.LocalPlayer
		if not isvalid(lp) then return end
		local pc = lp:GetComponent("script.PlayerController")
		if not isvalid(pc) then return end
		pc:ServerDeleteSaveSlot(slot)
	end

	@ExecSpace("ClientOnly")
	method void ApplyMetaJson(string metaJson)
		self.slotMeta = {}
		if metaJson ~= nil and metaJson ~= "" then
			local ok, decoded = pcall(function() return _HttpService:JSONDecode(metaJson) end)
			if ok and type(decoded) == "table" then
				self.slotMeta = decoded
			end
		end
		if self.menuMode == "slot" then
			self:RefreshSlots()
		elseif self.menuMode == "title" then
			-- stay on title after delete
		end
	end

	@ExecSpace("ClientOnly")
	method void ShowNameError(string msg)
		local m = msg or "사용할 수 없는 닉네임입니다"
		if self.menuMode == "customize" then
			self:SetCustomError(m)
			return
		end
		if isvalid(self.namePrompt) then self.namePrompt.Enable = true end
		if isvalid(self.nameError) then self.nameError.Text = m end
		if self.menuMode == "title" then
			self:SetTitleHint(m)
		end
	end

end

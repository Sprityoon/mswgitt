@Component
script UIQuestController extends Component

	-- 온보딩 퀘스트 트래커 + 완료 토스트 (HUDGroup 상시 노출).
	-- 로컬 플레이어의 PlayerQuest.UserDataTable을 폴링해 진행 중 퀘스트(우선순위 최소)를 렌더하고,
	-- 새로 완료된 퀘스트에 토스트를 띄운다. 표시 내용은 전적으로 QuestDataSet/QuestConditionDataSet(CSV)이
	-- 결정한다 — UI에 퀘스트/보상 하드코딩 없음(하드코딩 금지 룰).

	property number RefreshAccum = 0.0

	property table KnownCompleteCount = {}

	property boolean Primed = false

	property boolean ToastVisible = false

	property number ToastAccum = 0.0

	property any trackerClickHandler = nil

	-- 유저가 퀘스트 로그에서 직접 고른 추적 대상. 0이면 우선순위 최소 퀘스트를 자동 추적한다.
	property integer TrackedQuestId = 0

	property string uiClickSfx = "972843e759204d3e9ad84e7d3fa94f83"

	property number uiSfxVolume = 1.0

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		self:HideToast()
		self:ShowIdleTracker()
		self:WireTrackerClick()
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		local btn = self.Entity:GetChildByName("BtnOpen", true)
		if isvalid(btn) and self.trackerClickHandler then
			btn:DisconnectEvent(ButtonClickEvent, self.trackerClickHandler)
		end
		self.trackerClickHandler = nil
	end

	@ExecSpace("ClientOnly")
	method void WireTrackerClick()
		local btn = self.Entity:GetChildByName("BtnOpen", true)
		if not isvalid(btn) then
			log_warning("[QUEST] QuestTracker BtnOpen missing")
			return
		end
		if isvalid(btn.SpriteGUIRendererComponent) then
			btn.SpriteGUIRendererComponent.RaycastTarget = true
		end
		self.trackerClickHandler = btn:ConnectEvent(ButtonClickEvent, function()
			_SoundService:PlaySound(self.uiClickSfx, self.uiSfxVolume)
			self:ToggleQuestLog()
		end)
		log("[QUEST] tracker click wired")
	end

	@ExecSpace("ClientOnly")
	method void ToggleQuestLog()
		local popup = _EntityService:GetEntityByPath("/ui/PopupGroup/QuestPopup")
		if not isvalid(popup) then
			log_warning("[QUEST] QuestPopup missing")
			return
		end
		local controller = popup:GetComponent("script.UIQuestLogController")
		if isvalid(controller) then
			controller:Toggle()
		else
			log_warning("[QUEST] UIQuestLogController missing on QuestPopup")
		end
	end

	@ExecSpace("ClientOnly")
	method void SetTrackedQuest(integer questId)
		-- 퀘스트 로그가 고른 추적 대상을 기록한다. 0 = 자동(우선순위 최소) 선택으로 복귀.
		self.TrackedQuestId = questId
		self.RefreshAccum = 0.0
		self:Refresh()
		log("[QUEST] tracked quest set to " .. tostring(questId))
	end

	@ExecSpace("ClientOnly")
	method integer GetTrackedQuestId()
		-- 현재 수동 추적 중인 퀘스트 id. 0이면 자동 선택 상태.
		return self.TrackedQuestId
	end

	@ExecSpace("ClientOnly")
	method void ShowIdleTracker()
		self:SetChromeVisible(true)
		self:SetText("QuestName", "진행 중인 퀘스트 없음")
		self:SetText("Guide", "클릭하면 목록을 엽니다")
		self:SetGuideColor(nil)
		self:SetText("Progress", "")
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		if self.ToastVisible then
			self.ToastAccum = self.ToastAccum + delta
			if self.ToastAccum >= 3.5 then
				self:HideToast()
			end
		end

		self.RefreshAccum = self.RefreshAccum + delta
		if self.RefreshAccum < 0.4 then return end
		self.RefreshAccum = 0.0
		self:Refresh()
	end

	method any GetLocalQuest()
		local lp = _UserService.LocalPlayer
		if not isvalid(lp) then return nil end
		local pq = lp.PlayerQuest
		if pq == nil then return nil end
		return pq
	end

	@ExecSpace("ClientOnly")
	method void Refresh()
		local pq = self:GetLocalQuest()
		if pq == nil then return end

		local userDataTable = pq.UserDataTable
		if userDataTable == nil then return end

		-- 1) 새로 완료된 퀘스트 감지 → 토스트 (최초 폴링은 프라이밍만, 기존 완료분은 토스트 금지)
		for id, userData in pairs(userDataTable) do
			local cc = userData.CompleteCount or 0
			local known = self.KnownCompleteCount[id]
			if self.Primed and known ~= nil and cc > known then
				self:ShowCompletionToast(id)
			end
			self.KnownCompleteCount[id] = cc
		end
		self.Primed = true

		-- 2) 유저가 고른 추적 퀘스트를 우선 렌더한다. 지정이 없거나 더 이상 진행 중이 아니면
		--    (완료·포기 등) 추적을 풀고 우선순위 최소 퀘스트를 자동 선택한다.
		local activeId = nil
		local activePriority = nil
		local activeData = nil

		if self.TrackedQuestId ~= 0 then
			local trackedUserData = userDataTable[self.TrackedQuestId]
			if trackedUserData ~= nil and trackedUserData.State == _QuestStateEnum.InProgress then
				local trackedData = _QuestDataSetLogic:GetData(self.TrackedQuestId)
				if trackedData ~= nil then
					activeId = self.TrackedQuestId
					activeData = trackedData
				end
			end
			if activeId == nil then
				self.TrackedQuestId = 0
			end
		end

		local lp = _UserService.LocalPlayer
		if activeId == nil then
			-- 자동 선택: 보고 가능한 퀘스트를 먼저, 같은 부류 안에서는 우선순위 최소.
			local activeReady = false
			for id, userData in pairs(userDataTable) do
				if userData.State == _QuestStateEnum.InProgress then
					local data = _QuestDataSetLogic:GetData(id)
					if data ~= nil then
						local ready = userData:IsReadyToTurnIn(data, lp)
						local better = activePriority == nil
							or (ready and not activeReady)
							or (ready == activeReady and data.Priority < activePriority)
						if better then
							activePriority = data.Priority
							activeReady = ready
							activeId = id
							activeData = data
						end
					end
				end
			end
		end

		if activeId == nil then
			self:ShowIdleTracker()
			return
		end

		self:SetChromeVisible(true)
		local userData = userDataTable[activeId]
		self:SetText("QuestName", activeData.Name or "")
		self:SetText("Progress", self:BuildProgressText(activeData, userData))

		-- 안내 줄: 보고 가능(초록) / 자격 미달(주황, 사유) / 평소 진행 안내(원래 색).
		local guide = activeData.ProgressingDesc or ""
		local guideColor = nil
		if userData:IsReadyToTurnIn(activeData, lp) then
			guide = "[보고 가능] " .. self:GetTurnInNpcName(activeData) .. "에게 돌아가 보고하세요."
			guideColor = Color(0.42, 1.0, 0.36, 1.0)
		else
			local block = activeData:GetEligibilityBlockText(lp, true)
			if block ~= "" then
				guide = "[보고 불가] " .. block
				guideColor = Color(1.0, 0.62, 0.30, 1.0)
			end
		end
		self:SetText("Guide", guide)
		self:SetGuideColor(guideColor)

		local state = "normal"
		if guideColor ~= nil then state = guide end
		if state ~= self._T.LastGuideState then
			self._T.LastGuideState = state
			log("[QUEST] tracker id=" .. tostring(activeId) .. " guide=" .. state)
		end
	end

	@ExecSpace("ClientOnly")
	method string GetTurnInNpcName(any data)
		-- 보고처 NPC 표시명. 현재 맵에서 찾지 못하면(사냥터 등) 일반 문구로 대신한다.
		local npcId = data.TurnInNpcId or ""
		if npcId == "" then npcId = data.GiverNpcId or "" end
		local lp = _UserService.LocalPlayer
		if npcId ~= "" and isvalid(lp) and isvalid(lp.CurrentMap) then
			local dialogs = lp.CurrentMap:GetChildComponentsByTypeName("script.VillagerDialog", true)
			for _, dialog in ipairs(dialogs or {}) do
				if isvalid(dialog) and dialog.NpcId == npcId then
					return dialog:GetSpeakerName()
				end
			end
		end
		return "퀘스트를 준 주민"
	end

	@ExecSpace("ClientOnly")
	method void SetGuideColor(any col)
		-- nil이면 .ui 원래 글자색으로 되돌린다 (첫 호출 때 원래 색을 기억).
		local ent = self.Entity:GetChildByName("Guide", true)
		if not isvalid(ent) or not isvalid(ent.TextComponent) then return end
		if self._T.GuideBaseColor == nil then
			self._T.GuideBaseColor = ent.TextComponent.FontColor
		end
		if col == nil then col = self._T.GuideBaseColor end
		ent.TextComponent.FontColor = col
	end

	method string BuildProgressText(any data, any userData)
		local conds = data.ConditionDatas
		if conds == nil or #conds == 0 then return "" end

		local values = userData.Values
		local parts = {}
		for i = 1, #conds do
			local cond = conds[i]
			local uv = 0
			if values ~= nil and values[i] ~= nil then
				uv = values[i]
			end
			parts[#parts + 1] = string.format("%s %d/%d", cond.Description or "", uv, cond.Value)
		end
		return table.concat(parts, "\n")
	end

	method string BuildRewardStr(any data)
		local rewardItems = data.RewardItems
		if rewardItems == nil then return "" end
		local parts = {}
		for i = 1, #rewardItems do
			local it = rewardItems[i]
			parts[#parts + 1] = tostring(it[1]) .. " x" .. tostring(it[2])
		end
		return table.concat(parts, ", ")
	end

	@ExecSpace("ClientOnly")
	method void ShowCompletionToast(integer id)
		local data = _QuestDataSetLogic:GetData(id)
		if data == nil then return end

		local msg = "✔ 퀘스트 완료: " .. (data.Name or "")
		local rewardStr = self:BuildRewardStr(data)
		if rewardStr ~= "" then
			msg = msg .. "\n보상  " .. rewardStr
		end

		local toast = _EntityService:GetEntityByPath("/ui/HUDGroup/QuestToast")
		if isvalid(toast) then
			toast.Enable = true
			local textEnt = toast:GetChildByName("Text", true)
			if isvalid(textEnt) and isvalid(textEnt.TextComponent) then
				textEnt.TextComponent.Text = msg
			end
		end
		self.ToastVisible = true
		self.ToastAccum = 0.0
	end

	@ExecSpace("ClientOnly")
	method void HideToast()
		local toast = _EntityService:GetEntityByPath("/ui/HUDGroup/QuestToast")
		if isvalid(toast) then
			toast.Enable = false
		end
		self.ToastVisible = false
		self.ToastAccum = 0.0
	end

	@ExecSpace("ClientOnly")
	method void SetChromeVisible(boolean vis)
		-- Bg·헤더·클릭 오버레이는 목록을 열 수 있게 항상 켠다.
		local names = { "Bg", "Header", "BtnOpen", "QuestName", "Guide", "Progress" }
		for i = 1, #names do
			local ent = self.Entity:GetChildByName(names[i], true)
			if isvalid(ent) then
				ent.Enable = vis
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void SetText(string childName, string text)
		local ent = self.Entity:GetChildByName(childName, true)
		if isvalid(ent) and isvalid(ent.TextComponent) then
			ent.TextComponent.Text = text
		end
	end

end

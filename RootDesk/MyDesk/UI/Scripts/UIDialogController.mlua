@Component
script UIDialogController extends Component
	-- 메이플스토리식 하단 대화창. HUD/퀵슬롯/모바일 버튼을 덮음 (DialogGroup displayOrder=40).
	-- F「대화하기」전용. 자동 혼잣말은 VillagerDialog 말풍선 유지.

	property Entity dimmer = "0f75f1d6-ebc0-4b53-b30b-cb1e42f6b023"
	property Entity window = "f5f2be20-5c5a-4f00-84e3-cb1156743524"
	property TextGUIRendererComponent nameText = "16953a42-aee0-49de-a29e-9f65de1d91f6"
	property TextGUIRendererComponent bodyText = "f4d3b391-dfdb-48cc-901e-e0e286c47264"
	property ButtonComponent btnNext = "5b4b285d-8a5f-496e-a1ae-7d4e5cbf3b86"
	property ButtonComponent btnAccept = "a10ffb60-d47e-47a1-b9cb-93ab2689e867"
	property ButtonComponent btnDecline = "35bd3f33-29be-44c4-862a-bd4cb9a0ebbd"
	property ButtonComponent btnClose = "0102ea59-e89a-4b11-977c-082ff73b1258"

	property any nextHandler = nil
	property any acceptHandler = nil
	property any declineHandler = nil
	property any closeHandler = nil

	property table pages = {}
	property integer pageIndex = 1
	property string speakerName = ""
	property integer questId = 0
	property string mode = "talk"
	property boolean isOpen = false
	-- 초상화 대상 NPC(열기 직전에 호출부가 넣고, 열 때 비운다) / 초상화가 있을 때 이름표·본문을 미는 폭
	property Entity portraitSource = nil
	property Entity lastPortraitSource = nil
	property number PortraitShift = 230 -- 액자 폭(210) + 여백 20

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 버튼 핸들러 연결 + 초기 숨김.
		self:HideAll()
		if isvalid(self.btnNext) and isvalid(self.btnNext.Entity) then
			self.nextHandler = self.btnNext.Entity:ConnectEvent(ButtonClickEvent, function()
				self:OnNext()
			end)
		end
		if isvalid(self.btnAccept) and isvalid(self.btnAccept.Entity) then
			self.acceptHandler = self.btnAccept.Entity:ConnectEvent(ButtonClickEvent, function()
				self:OnAccept()
			end)
		end
		if isvalid(self.btnDecline) and isvalid(self.btnDecline.Entity) then
			self.declineHandler = self.btnDecline.Entity:ConnectEvent(ButtonClickEvent, function()
				self:OnDecline()
			end)
		end
		if isvalid(self.btnClose) and isvalid(self.btnClose.Entity) then
			self.closeHandler = self.btnClose.Entity:ConnectEvent(ButtonClickEvent, function()
				self:Close()
			end)
		end
		log("[DIALOG] UIDialogController ready")
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- 핸들러 해제.
		if self.nextHandler ~= nil and isvalid(self.btnNext) and isvalid(self.btnNext.Entity) then
			self.btnNext.Entity:DisconnectEvent(ButtonClickEvent, self.nextHandler)
		end
		if self.acceptHandler ~= nil and isvalid(self.btnAccept) and isvalid(self.btnAccept.Entity) then
			self.btnAccept.Entity:DisconnectEvent(ButtonClickEvent, self.acceptHandler)
		end
		if self.declineHandler ~= nil and isvalid(self.btnDecline) and isvalid(self.btnDecline.Entity) then
			self.btnDecline.Entity:DisconnectEvent(ButtonClickEvent, self.declineHandler)
		end
		if self.closeHandler ~= nil and isvalid(self.btnClose) and isvalid(self.btnClose.Entity) then
			self.btnClose.Entity:DisconnectEvent(ButtonClickEvent, self.closeHandler)
		end
	end

	@ExecSpace("ClientOnly")
	method void OpenTalk(string speaker, table pageList)
		-- 일반 대화(페이지 넘기기 → 닫기).
		self.mode = "talk"
		self.questId = 0
		self:OpenInternal(speaker, pageList)
	end

	@ExecSpace("ClientOnly")
	method void OpenQuestOffer(string speaker, table pageList, integer questId)
		-- 퀘스트 수주 대화(마지막에 수락/거절).
		self.mode = "offer"
		self.questId = math.floor(tonumber(questId) or 0)
		self:OpenInternal(speaker, pageList)
	end

	@ExecSpace("ClientOnly")
	method void OpenInternal(string speaker, table pageList)
		-- 공통 오픈.
		if pageList == nil or #pageList == 0 then
			log_warning("[DIALOG] empty pages")
			return
		end
		self.speakerName = speaker or ""
		self.pages = pageList
		self.pageIndex = 1
		self.isOpen = true
		if isvalid(self.dimmer) then self.dimmer.Enable = true end
		if isvalid(self.window) then self.window.Enable = true end
		if isvalid(self.nameText) then self.nameText.Text = self.speakerName end
		self:ApplyPortrait()
		self:RefreshPage()
		log("[DIALOG] open mode=" .. self.mode
			.. " pages=" .. tostring(#self.pages)
			.. " quest=" .. tostring(self.questId))
	end

	@ExecSpace("ClientOnly")
	method void ApplyPortrait()
		-- NPC 초상화: 호출부(VillagerDialog)가 portraitSource 에 NPC 엔티티를 넣으면 그 외형(CostumeManager)을
		-- 대화창 왼쪽 액자 속 UI 아바타에 그대로 옮긴다. 없으면 액자를 숨기고 이름표·본문을 원래 자리로.
		local portrait = isvalid(self.window) and self.window:GetChildByName("Portrait") or nil
		local art = isvalid(portrait) and portrait:GetChildByName("Art") or nil
		local src = self.portraitSource
		self.portraitSource = nil
		self.lastPortraitSource = src
		-- 마을 NPC 는 스프라이트(애니메이션 클립)로 그려진다 → 그 SpriteRUID 를 액자 속 UI 스프라이트에 그대로(클립이면 재생)
		local ruid = ""
		if isvalid(src) and isvalid(src.SpriteRendererComponent) then ruid = src.SpriteRendererComponent.SpriteRUID or "" end
		local show = isvalid(art) and isvalid(art.SpriteGUIRendererComponent) and ruid ~= ""
		if show then
			art.SpriteGUIRendererComponent.ImageRUID = ruid
		end
		if isvalid(portrait) then portrait.Enable = show end
		-- 액자가 있으면 이름표·본문을 오른쪽으로(액자 폭만큼), 없으면 원래 자리
		local shift = 0
		if show then shift = self.PortraitShift end
		local plate = self.window:GetChildByName("NamePlate")
		if isvalid(plate) then plate.UITransformComponent.anchoredPosition = Vector2(24 + shift, plate.UITransformComponent.anchoredPosition.y) end
		if isvalid(self.bodyText) then
			local tr = self.bodyText.Entity.UITransformComponent
			tr.anchoredPosition = Vector2(40 + shift, tr.anchoredPosition.y)
			tr.RectSize = Vector2(1200 - shift, tr.RectSize.y)
		end
	end

	@ExecSpace("ClientOnly")
	method void RefreshPage()
		-- 현재 페이지 텍스트·버튼 상태.
		local text = ""
		if self.pages ~= nil and self.pages[self.pageIndex] ~= nil then
			text = tostring(self.pages[self.pageIndex])
		end
		if isvalid(self.bodyText) then self.bodyText.Text = text end

		local last = self.pages ~= nil and self.pageIndex >= #self.pages
		if self.mode == "offer" and last then
			self:SetBtn(self.btnNext, false)
			self:SetBtn(self.btnClose, false)
			self:SetBtn(self.btnAccept, true)
			self:SetBtn(self.btnDecline, true)
		elseif last then
			self:SetBtn(self.btnNext, false)
			self:SetBtn(self.btnAccept, false)
			self:SetBtn(self.btnDecline, false)
			self:SetBtn(self.btnClose, true)
		else
			self:SetBtn(self.btnNext, true)
			self:SetBtn(self.btnAccept, false)
			self:SetBtn(self.btnDecline, false)
			self:SetBtn(self.btnClose, false)
		end
	end

	@ExecSpace("ClientOnly")
	method void SetBtn(ButtonComponent btn, boolean on)
		-- Enable 토글.
		if not isvalid(btn) then return end
		btn.Enable = on
		if isvalid(btn.Entity) then
			btn.Entity.Enable = on
		end
	end

	@ExecSpace("ClientOnly")
	method void OnNext()
		-- 다음 문장.
		if not self.isOpen then return end
		if self.pages == nil then return end
		if self.pageIndex < #self.pages then
			self.pageIndex = self.pageIndex + 1
			self:RefreshPage()
		end
	end

	@ExecSpace("ClientOnly")
	method void OnAccept()
		-- 퀘스트 수락 RPC.
		if not self.isOpen then return end
		local qid = self.questId
		local speaker = self.speakerName
		self:Close()
		if qid <= 0 then return end
		local lp = _UserService.LocalPlayer
		if not isvalid(lp) or lp.PlayerQuest == nil then
			log_warning("[DIALOG] PlayerQuest missing")
			return
		end
		lp.PlayerQuest:RequestAcceptQuests({ qid })
		log("[DIALOG] accept quest=" .. tostring(qid))
		self:OpenPhaseReply(speaker, qid, "accept")
	end

	@ExecSpace("ClientOnly")
	method void OnDecline()
		-- 거절 — 창을 닫고, StoryDialogDataSet 에 decline 대사가 있으면 한마디 보여 준다.
		local qid = self.questId
		local speaker = self.speakerName
		log("[DIALOG] decline quest=" .. tostring(qid))
		self:Close()
		self:OpenPhaseReply(speaker, qid, "decline")
	end

	@ExecSpace("ClientOnly")
	method void OpenPhaseReply(string speaker, integer questId, string phase)
		-- 수락/거절 직후 NPC 의 짧은 반응(StoryDialogDataSet Phase=accept|decline). 없으면 아무것도 안 한다.
		if questId <= 0 then return end
		local ds = _DataService:GetTable("StoryDialogDataSet")
		if ds == nil then return end
		local rows = ds:GetAllRow()
		if rows == nil then return end
		local list = {}
		for _, row in ipairs(rows) do
			local qid = math.floor(tonumber(row:GetItem("QuestId")) or 0)
			if qid == questId and tostring(row:GetItem("Phase") or "") == phase then
				local text = tostring(row:GetItem("Text") or "")
				if text ~= "" then
					table.insert(list, { seq = math.floor(tonumber(row:GetItem("Seq")) or 0), text = text })
				end
			end
		end
		if #list == 0 then return end
		table.sort(list, function(a, b) return a.seq < b.seq end)
		local pages = {}
		for _, e in ipairs(list) do table.insert(pages, e.text) end
		-- 수락/거절 답변은 방금 대화한 NPC 초상화를 그대로 쓴다
		self.portraitSource = self.lastPortraitSource
		self:OpenTalk(speaker, pages)
		log("[DIALOG] phase reply quest=" .. tostring(questId) .. " phase=" .. phase .. " pages=" .. tostring(#pages))
	end

	@ExecSpace("ClientOnly")
	method void Close()
		-- 대화창 닫기.
		self.isOpen = false
		self.pages = {}
		self.pageIndex = 1
		self.questId = 0
		self.mode = "talk"
		self:HideAll()
	end

	@ExecSpace("ClientOnly")
	method void HideAll()
		-- 딤머·창 비활성.
		if isvalid(self.dimmer) then self.dimmer.Enable = false end
		if isvalid(self.window) then self.window.Enable = false end
		self:SetBtn(self.btnNext, false)
		self:SetBtn(self.btnAccept, false)
		self:SetBtn(self.btnDecline, false)
		self:SetBtn(self.btnClose, false)
	end

	@ExecSpace("ClientOnly")
	method boolean IsOpen()
		return self.isOpen == true
	end

end

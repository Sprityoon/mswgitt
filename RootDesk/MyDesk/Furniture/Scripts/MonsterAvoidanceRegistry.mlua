@Logic
script MonsterAvoidanceRegistry extends Logic
	-- T93: 맵별 활성 몬스터 접근 차단 장치 캐시.
	-- 몬스터 AI는 매 프레임 전 장치 스캔 대신 이 목록만 조회한다.

	-- ByMap[mapName] = { { entity=Entity, x=number, y=number, enterR=number, exitR=number }, ... }
	property table ByMap = {}

	@ExecSpace("ServerOnly")
	method void Register(string mapName, Entity entity, number x, number y, number enterR, number exitR)
		-- 활성 장치를 맵 목록에 등록한다.
		if mapName == nil or mapName == "" then return end
		if not isvalid(entity) then return end
		if self.ByMap == nil then self.ByMap = {} end
		local list = self.ByMap[mapName]
		if list == nil then
			list = {}
			self.ByMap[mapName] = list
		end
		-- 동일 엔티티 중복 등록 방지
		for i, e in ipairs(list) do
			if isvalid(e.entity) and e.entity == entity then
				e.x = x
				e.y = y
				e.enterR = enterR
				e.exitR = exitR
				log("[T93][AVOID] registry update map=" .. mapName .. " enter=" .. tostring(enterR) .. " exit=" .. tostring(exitR))
				return
			end
		end
		table.insert(list, { entity = entity, x = x, y = y, enterR = enterR, exitR = exitR })
		log("[T93][AVOID] registry register map=" .. mapName .. " n=" .. tostring(#list) .. " enter=" .. tostring(enterR) .. " exit=" .. tostring(exitR))
	end

	@ExecSpace("ServerOnly")
	method void Unregister(string mapName, Entity entity)
		-- 장치 제거·만료 시 목록에서 뺀다.
		if mapName == nil or mapName == "" then return end
		if self.ByMap == nil then return end
		local list = self.ByMap[mapName]
		if list == nil then return end
		for i = #list, 1, -1 do
			local e = list[i]
			if (not isvalid(e.entity)) or e.entity == entity then
				table.remove(list, i)
			end
		end
		log("[T93][AVOID] registry unregister map=" .. mapName .. " n=" .. tostring(#list))
	end

	@ExecSpace("ServerOnly")
	method table GetActiveForMap(string mapName)
		-- 맵의 활성 장치 목록(없으면 빈 테이블)을 반환한다. 죽은 엔티티는 정리한다.
		if mapName == nil or mapName == "" then return {} end
		if self.ByMap == nil then return {} end
		local list = self.ByMap[mapName]
		if list == nil then return {} end
		for i = #list, 1, -1 do
			if not isvalid(list[i].entity) then
				table.remove(list, i)
			end
		end
		return list
	end

end

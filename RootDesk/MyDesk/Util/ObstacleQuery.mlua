@Logic
script ObstacleQuery extends Logic
	-- T99: T36 엔티티 장애물 판정 공용 모듈.
	-- 플레이어(PlayerController)와 몬스터(MonsterAI)가 동일 기하/필터를 공유한다.
	-- 후보 수집 = CollisionSimulator:OverlapAll(원형 queryR) — N×M 전수 비교 금지.

	-- 맵별 Layer-4(RectTileMap4) 캐시. 값 = RectTileMapComponent 또는 nil.
	property table WallLayerByMap = {}

	method boolean IsWallAt(Entity mover, Vector2 checkPos)
		-- Layer-4 벽 타일 위면 true. mover의 CurrentMap 기준.
		if not isvalid(mover) then return false end
		local map = mover.CurrentMap
		if not isvalid(map) then return false end
		local mapName = map.Name
		if self.WallLayerByMap == nil then self.WallLayerByMap = {} end
		local wallLayer = self.WallLayerByMap[mapName]
		if not isvalid(wallLayer) then
			local l4 = map:GetChildByName("RectTileMap4")
			if isvalid(l4) and isvalid(l4.RectTileMapComponent) then
				wallLayer = l4.RectTileMapComponent
				self.WallLayerByMap[mapName] = wallLayer
			else
				self.WallLayerByMap[mapName] = nil
				return false
			end
		end
		local cell = wallLayer:ToCellPosition(Vector3(checkPos.x, checkPos.y, 0))
		if cell ~= nil and wallLayer:GetTile(cell) ~= nil then
			return true
		end
		return false
	end

	method boolean IsBlockingOverlapEntity(Entity mover, Entity entity)
		-- 데이터 주도 필터: 이름 분기 금지.
		-- 차단 = ResourceOccupiedArea 또는 PlaceableFurniture (각 BlocksMovement).
		if not isvalid(entity) then return false end
		if isvalid(mover) and entity == mover then return false end
		if isvalid(entity:GetComponent("script.itemreact")) then return false end
		local occ = entity:GetComponent("script.ResourceOccupiedArea")
		if isvalid(occ) then
			return occ.BlocksMovement ~= false
		end
		local furn = entity:GetComponent("script.PlaceableFurniture")
		if isvalid(furn) then
			return furn.BlocksMovement ~= false
		end
		return false
	end

	method boolean GetColliderAABB(Entity entity, table outBox)
		-- TriggerComponent(없으면 PhysicsCollider) 박스 → 월드 AABB.
		-- 🔴 엔진 콜라이더는 BoxSize·ColliderOffset에 Transform.Scale이 곱해진 것이 실물이다
		--    (ResourceSpawner 2047행 "PhysicsCollider BoxSize * Scale" 주석과 동일 근거).
		--    스케일을 빼먹으면 Scale≠1 모델에서 판정 박스가 실물보다 작고 오프셋도 덜 밀려
		--    보이는 것보다 훨씬 안쪽까지 파고들 수 있다 = "조정했는데도 통과" 증상.
		--    실측: Big Stone1 Scale=(2,2,2) → 판정 박스가 실물의 1/2 크기였다.
		local transform = entity.TransformComponent
		if not isvalid(transform) then return false end
		local boxSize = nil
		local offX, offY = 0, 0
		local trigger = entity.TriggerComponent
		if isvalid(trigger) then
			boxSize = trigger.BoxSize
			offX = trigger.ColliderOffset.x
			offY = trigger.ColliderOffset.y
		else
			local collider = entity.PhysicsColliderComponent
			if isvalid(collider) then
				boxSize = collider.BoxSize
				offX = collider.ColliderOffset.x
				offY = collider.ColliderOffset.y
			end
		end
		if boxSize == nil then return false end
		-- 자원·오브젝트는 맵 직속(부모 스케일 1)이라 로컬 Scale = 월드 스케일.
		-- TransformComponent에 WorldScale은 없다(.d.mlua 확인) — Scale이 유일한 소스.
		local sx, sy = 1.0, 1.0
		local scale = transform.Scale
		if scale ~= nil then
			sx = math.abs(tonumber(scale.x) or 1.0)
			sy = math.abs(tonumber(scale.y) or 1.0)
			if sx <= 0.0001 then sx = 1.0 end
			if sy <= 0.0001 then sy = 1.0 end
		end
		local cx = transform.WorldPosition.x + offX * sx
		local cy = transform.WorldPosition.y + offY * sy
		local hx = boxSize.x * 0.5 * sx
		local hy = boxSize.y * 0.5 * sy
		outBox.minX = cx - hx
		outBox.maxX = cx + hx
		outBox.minY = cy - hy
		outBox.maxY = cy + hy
		return true
	end

	method number CirclePenetration(Vector2 p, number radius, table box)
		-- 원-AABB 침투 깊이. <=0 이면 비겹침.
		local minX, maxX, minY, maxY = box.minX, box.maxX, box.minY, box.maxY
		local closestX = p.x
		if closestX < minX then closestX = minX elseif closestX > maxX then closestX = maxX end
		local closestY = p.y
		if closestY < minY then closestY = minY elseif closestY > maxY then closestY = maxY end
		local dx = p.x - closestX
		local dy = p.y - closestY
		local distSq = dx * dx + dy * dy
		if distSq < 0.0000001 then
			local nearest = math.min(p.x - minX, maxX - p.x, p.y - minY, maxY - p.y)
			return radius + nearest
		end
		return radius - math.sqrt(distSq)
	end

	method Vector2 ResolveCircleAABB(number cx, number cy, number radius, table box, number startX, number startY)
		-- 원-대-AABB MTV. 내부 침투 시 start 쪽 면을 우선해 방향 뒤집힘 방지.
		local minX, maxX, minY, maxY = box.minX, box.maxX, box.minY, box.maxY
		local closestX = cx
		if closestX < minX then closestX = minX elseif closestX > maxX then closestX = maxX end
		local closestY = cy
		if closestY < minY then closestY = minY elseif closestY > maxY then closestY = maxY end

		local dx = cx - closestX
		local dy = cy - closestY
		local distSq = dx * dx + dy * dy
		local r2 = radius * radius

		if distSq < 0.0000001 then
			local midX = (minX + maxX) * 0.5
			local midY = (minY + maxY) * 0.5
			local preferLeft = startX < midX
			local preferDown = startY < midY
			local pushLeft = (minX - radius) - cx
			local pushRight = (maxX + radius) - cx
			local pushDown = (minY - radius) - cy
			local pushUp = (maxY + radius) - cy
			local candX = preferLeft and pushLeft or pushRight
			local candY = preferDown and pushDown or pushUp
			if math.abs(candX) <= math.abs(candY) then
				return Vector2(candX, 0)
			end
			return Vector2(0, candY)
		end

		if distSq >= r2 then
			return Vector2.zero
		end

		local dist = math.sqrt(distSq)
		local pen = radius - dist
		local nx = dx / dist
		local ny = dy / dist
		return Vector2(nx * pen, ny * pen)
	end

	method boolean IsObstacle(Entity mover, Vector2 checkPos, number radius, any currentPos, number queryRadius)
		-- 벽 타일 또는 차단 엔티티 AABB에 더 깊이 파고들면 true.
		-- queryRadius: OverlapAll 후보 반경(기본 2.5). 엔진 공간 질의 — 전수 스캔 아님.
		if not isvalid(mover) then return false end
		if self:IsWallAt(mover, checkPos) then
			return true
		end
		local simulator = _CollisionService:GetSimulator(mover)
		if not simulator then return false end
		local queryR = queryRadius
		if queryR == nil or queryR < radius then queryR = 2.5 end
		local overlaps = simulator:OverlapAll(CollisionGroups.TriggerBox, CircleShape(checkPos, queryR))
		local box = { minX = 0, maxX = 0, minY = 0, maxY = 0 }
		for _, comp in ipairs(overlaps) do
			if isvalid(comp) and isvalid(comp.Entity) then
				local entity = comp.Entity
				if self:IsBlockingOverlapEntity(mover, entity) and self:GetColliderAABB(entity, box) then
					local penNew = self:CirclePenetration(checkPos, radius, box)
					if penNew > 0 then
						local penCur = 0
						if currentPos ~= nil then
							penCur = self:CirclePenetration(currentPos, radius, box)
						end
						if penNew > penCur + 0.0001 then
							return true
						end
					end
				end
			end
		end
		return false
	end

	method Vector2 ComputeOverlapPush(Entity mover, Vector2 currentPos, number radius, number queryRadius, number startX, number startY)
		-- ResolveOverlaps용 MTV 합. hit 없으면 Vector2.zero.
		if not isvalid(mover) or currentPos == nil then return Vector2.zero end
		local simulator = _CollisionService:GetSimulator(mover)
		if not simulator then return Vector2.zero end
		local queryR = queryRadius
		if queryR == nil or queryR < radius then queryR = 2.5 end
		local overlaps = simulator:OverlapAll(CollisionGroups.TriggerBox, CircleShape(currentPos, queryR))
		local pushX, pushY = 0.0, 0.0
		local hit = false
		local box = { minX = 0, maxX = 0, minY = 0, maxY = 0 }
		for _, comp in ipairs(overlaps) do
			if isvalid(comp) and isvalid(comp.Entity) then
				local entity = comp.Entity
				if self:IsBlockingOverlapEntity(mover, entity) and self:GetColliderAABB(entity, box) then
					local mtv = self:ResolveCircleAABB(currentPos.x, currentPos.y, radius, box, startX, startY)
					if mtv.x ~= 0 or mtv.y ~= 0 then
						pushX = pushX + mtv.x
						pushY = pushY + mtv.y
						hit = true
					end
				end
			end
		end
		if not hit then return Vector2.zero end
		local mag = math.sqrt(pushX * pushX + pushY * pushY)
		local maxPush = 0.5
		if mag > maxPush and mag > 0.0001 then
			local s = maxPush / mag
			pushX = pushX * s
			pushY = pushY * s
		end
		return Vector2(pushX, pushY)
	end

end

@Logic
script RenderLayers extends Logic

	-- 렌더 레이어 공용 상수 (docs/design/skill-tree-plan.md §5 맵 레이어 재구성)
	-- 렌더 우선순위: ① SortingLayer → ② OrderInLayer → ③ Z
	--
	-- EntityLayer: 코드로 스폰되는 모든 엔티티 스프라이트(자원·설치 가구·스포너 몬스터·배치 프리뷰)의
	-- SortingLayer. 개별 스크립트에 문자열을 하드코딩하지 말고 반드시 이 상수를 참조할 것.
	--
	-- 2026-07-05 맵 레이어 재구성 배치 적용됨: "MapLayer5" = 지형 타일 레이어(0~4) 위 엔티티 전용 레이어.
	-- 월드 스프라이트 모델들의 SortingLayer도 scripts/apply_entity_layer.cjs 로 함께 MapLayer5로 일괄 전환.
	property string EntityLayer = "MapLayer5"

	-- 같은 레이어 안에서 타일(OrderInLayer 1)보다 위에 오도록 코드 스폰 스프라이트가 지켜야 할 최소값
	property integer MinEntityOrder = 2

	-- 전 맵 공통 톱다운 렌더 정렬 기준 반지름 (OrderInLayer = (SortRadius - worldY) * 100)
	property number SortRadius = 100

	-- 유닛 계열(플레이어·NPC·몬스터·동물) 동률 시 오브젝트 가림 방지 바이어스 (+1 = y 0.01유닛 체감 영향 무)
	property integer UnitTieBias = 1

	method integer ComputeYOrder(number worldY)
		-- worldY 위치에 따른 톱다운 OrderInLayer 계산.
		local radius = self.SortRadius or 100
		local y = worldY or 0
		local minOrder = self.MinEntityOrder or 2
		return math.max(minOrder, math.floor((radius - y) * 100))
	end

	method integer ComputeYOrderForEntity(Entity entity, number extraOffset)
		-- T95: 전 대상 접지선(충돌/트리거 박스 하단 = y + ColliderOffset.y - BoxSize.y/2) 기반 Y정렬
		if not isvalid(entity) then return self.MinEntityOrder end
		local transform = entity.TransformComponent
		if not isvalid(transform) then return self.MinEntityOrder end
		
		local worldY = transform.WorldPosition.y
		local groundY = worldY
		
		local trigger = entity.TriggerComponent
		if isvalid(trigger) and trigger.BoxSize ~= nil then
			groundY = worldY + trigger.ColliderOffset.y - (trigger.BoxSize.y * 0.5)
		else
			local collider = entity.PhysicsColliderComponent
			if isvalid(collider) and collider.BoxSize ~= nil then
				groundY = worldY + collider.ColliderOffset.y - (collider.BoxSize.y * 0.5)
			else
				local ysort = entity:GetComponent("script.YSortSprite")
				if isvalid(ysort) and ysort.SortYOffset ~= nil then
					groundY = worldY + ysort.SortYOffset
				end
			end
		end
		
		if extraOffset ~= nil then
			groundY = groundY + extraOffset
		end

		local order = self:ComputeYOrder(groundY)
		
		-- 유닛 계열(플레이어, NPC, 몬스터, 동물) 여부 확인하여 UnitTieBias(+1) 가산
		local isUnit = false
		if isvalid(entity:GetComponent("script.PlayerController")) or
		   isvalid(entity.PlayerComponent) or
		   isvalid(entity:GetComponent("script.MonsterAI")) then
			isUnit = true
		else
			local ysort = entity:GetComponent("script.YSortSprite")
			if isvalid(ysort) and ysort.IsUnit then
				isUnit = true
			end
		end

		if isUnit then
			order = order + (self.UnitTieBias or 1)
		end

		return order
	end

end


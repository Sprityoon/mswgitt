@Component
script YSortSprite extends Component

	property boolean Dynamic = false
	property boolean IsUnit = false
	property number SortYOffset = 0.0
	property number _LastY = -999999

	method void OnBeginPlay()
		-- Initializes rendering order for non-fading sprites.
		if not self:IsClient() then return end
		self:ApplyYSort()
	end

	method void ApplyYSort()
		-- Calculates and applies OrderInLayer based on world position and offset.
		local sprite = self.Entity.SpriteRendererComponent
		local transform = self.Entity.TransformComponent
		if not isvalid(sprite) or not isvalid(transform) then return end

		if _RenderLayers then
			sprite.SortingLayer = _RenderLayers.EntityLayer
			self._LastY = transform.WorldPosition.y
			sprite.OrderInLayer = _RenderLayers:ComputeYOrderForEntity(self.Entity, self.SortYOffset)
		end
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- Periodically updates rendering order for dynamic moving entities.
		-- 렌더 정렬은 클라 전용 — ClientOnly 로 두어 서버가 엔티티마다 매 프레임 호출하지 않게 한다.
		if not self.Dynamic then return end
		local transform = self.Entity.TransformComponent
		if not isvalid(transform) then return end

		local y = transform.WorldPosition.y
		if math.abs(y - self._LastY) >= 0.05 then
			self:ApplyYSort()
		end
	end

end

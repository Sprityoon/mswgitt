@Component
script PlayerDBManager extends Component

	-- [적응] 업스트림 Sample/PlayerDBManager에서 PlayerAccount 오케스트레이션을 제거한 버전.
	-- 스탯/인벤토리 저장은 기존 PersistenceManager("SaveData" 키)가 담당하고,
	-- 이 매니저는 업적("Achievement")/퀘스트("Quest") 키만 소유한다 — 저장 소유권 분리.

	property integer TimerId = 0

	property boolean IsLoadAttempted = false

	@TargetUserSync
	property boolean IsLoadSuccess = false

	@ExecSpace("ServerOnly")
	method boolean OnLoadedDataFromDB(table datas)
		local playerEntity = self.Entity

		if not playerEntity.PlayerAchievement:OnLoadedDataFromDB(datas) then
			return false
		end

		if not playerEntity.PlayerQuest:OnLoadedDataFromDB(datas) then
			return false
		end

		return true
	end

	@ExecSpace("ServerOnly")
	method boolean PostOnLoadedDataFromDB()
		local playerEntity = self.Entity

		if not playerEntity.PlayerAchievement:PostOnLoadedDataFromDB() then
			return false
		end

		if not playerEntity.PlayerQuest:PostOnLoadedDataFromDB() then
			return false
		end

		-- 퀘스트 상태가 메모리에 올라온 뒤에만 판정 가능한 보정 — 이미 완료한 퀘스트의 영지 포탈 개통.
		if _PersistenceManager ~= nil then
			_PersistenceManager:BackfillEarnedPortals(playerEntity)
		end

		return true
	end

	@ExecSpace("Server")
	method void NotifyWorldDataLoadCompleted()
		-- 클라이언트의 DataLoadLogic이 월드 데이터셋 로드 완료를 알린다.
		-- 슬롯 선택 전에는 퀘스트 DB를 읽지 않는다 (LoadForActiveSlot에서 로드).
		if self.IsLoadAttempted then
			return
		end
		-- World dataset ready flag만 — 실제 유저 퀘스트 로드는 슬롯 확정 후.
		if not _DataLoadLogic:IsLoadSuccessAndWait(self) then
			return
		end
		log("[SLOT] PlayerDBManager world data ready — waiting slot select")
	end

	@ExecSpace("ServerOnly")
	method void LoadForActiveSlot()
		-- PersistenceManager 슬롯 확정 후 호출. Quest/Achievement를 슬롯 키로 로드.
		if self.IsLoadSuccess then
			return
		end
		if not _DataLoadLogic:IsLoadSuccessAndWait(self) then
			log_warning("[SLOT] world dataset not ready yet")
			return
		end
		self.IsLoadAttempted = true
		if not self:LoadFromDB() then
			log_warning("[SLOT] PlayerDBManager LoadFromDB failed")
			return
		end
		self.IsLoadSuccess = true
		local period = 300
		local dbfunction = function()
			self:SaveToDB(false)
		end
		self.TimerId = _TimerService:SetTimerRepeat(dbfunction, period, period)
		log("[SLOT] PlayerDBManager loaded for active slot")
	end

	@ExecSpace("ServerOnly")
	method void SaveToDB(boolean isLeaving)
		-- 업적/퀘스트 유저 데이터를 배치로 저장한다 (300초 주기 + 퇴장 시 동기 저장).
		if not self.IsLoadSuccess then
			return
		end

		local saveData = {}
		local savedGenerations = {}
		-------------------------------------------------------------------
		local playerEntity = self.Entity
		playerEntity.PlayerAchievement:SaveToDB(saveData, savedGenerations)
		playerEntity.PlayerQuest:SaveToDB(saveData, savedGenerations)
		-------------------------------------------------------------------
		if _Util:TableLen(saveData) == 0 then
			return
		end

		local userID = self.Entity.PlayerComponent.UserId
		local slot = 1
		if _PersistenceManager ~= nil then
			slot = _PersistenceManager:GetActiveSlot(userID)
			if slot < 1 then slot = 1 end
		end
		-- 패키지 키(Quest/Achievement) → 슬롯 접미사 키로 재매핑
		local remapped = {}
		for k, v in pairs(saveData) do
			remapped[tostring(k) .. "_s" .. tostring(slot)] = v
		end

		local ds = _DataStorageService:GetUserDataStorage(userID)
		if ds == nil then
			log_error("PlayerDBManager: UserDataStorage unavailable for " .. tostring(userID))
			return
		end

		local onSaved = function(errorCode, successKeys)
			if not isvalid(playerEntity) then
				return
			end
			local logicalSuccess = {}
			local suffix = "_s" .. tostring(slot)
			local keysTable = successKeys
			if keysTable ~= nil and type(keysTable.ToTable) == "function" then
				keysTable = keysTable:ToTable()
			end
			if type(keysTable) == "table" then
				for _, storedKey in pairs(keysTable) do
					local key = tostring(storedKey)
					if string.sub(key, -string.len(suffix)) == suffix then
						key = string.sub(key, 1, string.len(key) - string.len(suffix))
					end
					logicalSuccess[key] = true
				end
			end
			if isvalid(playerEntity) and isvalid(playerEntity.PlayerAchievement) then
				playerEntity.PlayerAchievement:OnSavedToDB(logicalSuccess, savedGenerations)
			end
			if isvalid(playerEntity) and isvalid(playerEntity.PlayerQuest) then
				playerEntity.PlayerQuest:OnSavedToDB(logicalSuccess, savedGenerations)
			end
			if errorCode ~= 0 then
				log_error("PlayerDBManager: batch save failed. errorCode=" .. tostring(errorCode))
			else
				log("[SLOT] PlayerDBManager batch save success slot=" .. tostring(slot))
			end
		end

		if isLeaving == true then
			local errorCode, successKeys = ds:BatchSetAndWait(remapped)
			onSaved(errorCode, successKeys)
		else
			ds:BatchSetAsync(remapped, onSaved)
		end
	end

	@ExecSpace("ServerOnly")
	method boolean LoadFromDB()
		-- 업적/퀘스트 유저 데이터를 배치로 로드하고 각 컴포넌트에 전달한다.
		local playerEntity = self.Entity
		local userID = playerEntity.PlayerComponent.UserId
		local ds = _DataStorageService:GetUserDataStorage(userID)
		local loadKey = {}
		local loadedData = {}

		-------------------------------------------------------------------
		playerEntity.PlayerAchievement:LoadFromDB(loadKey)
		playerEntity.PlayerQuest:LoadFromDB(loadKey)
		-------------------------------------------------------------------

		local slot = 1
		if _PersistenceManager ~= nil then
			slot = _PersistenceManager:GetActiveSlot(userID)
			if slot < 1 then slot = 1 end
		end
		local slotKeys = {}
		for i = 1, #loadKey do
			slotKeys[#slotKeys + 1] = tostring(loadKey[i]) .. "_s" .. tostring(slot)
		end
		-- 슬롯1: 레거시 키도 후보로
		if slot == 1 then
			for i = 1, #loadKey do
				slotKeys[#slotKeys + 1] = tostring(loadKey[i])
			end
		end

		local returnCode, itemPages = ds:BatchGetAndWait(slotKeys)
		if returnCode ~= 0 then
			return false
		end

		while true do
			local datas = itemPages:GetCurrentPageDatas()
			if datas == nil then
				break
			end

			for i=1, #datas do
				loadedData[datas[i].KeyInfo.Key] = datas[i]
			end

			if itemPages.IsLastPage == true then
				break
			end
			itemPages:MoveToNextPageAndWait()
		end

		-- 패키지가 StorageName("Quest")으로 조회하도록 슬롯 키 → 논리 키 매핑 (슬롯별 키 최우선)
		for i = 1, #loadKey do
			local logical = tostring(loadKey[i])
			local slotted = logical .. "_s" .. tostring(slot)
			if loadedData[slotted] ~= nil and loadedData[slotted].Value ~= nil and loadedData[slotted].Value ~= "" then
				-- 1순위: 슬롯 전용 데이터
				loadedData[logical] = loadedData[slotted]
			elseif slot == 1 and loadedData[logical] ~= nil and loadedData[logical].Value ~= nil and loadedData[logical].Value ~= "" then
				-- 2순위 (슬롯1 한정): 레거시 비슬롯 데이터
				-- loadedData[logical] 그대로 유지
			else
				-- 3순위 (신규 슬롯 또는 빈 데이터): 빈 스텁 (PlayerQuest가 nil.Value로 죽지 않게)
				loadedData[logical] = { Value = "" }
			end
		end

		if not self:OnLoadedDataFromDB(loadedData) then
			return false
		end

		if not self:PostOnLoadedDataFromDB() then
			return false
		end

		return true
	end

	@ExecSpace("ServerOnly")
	@EventSender("Service", "UserService")
	handler HandleUserLeaveEvent(UserLeaveEvent event)
		local UserId = event.UserId

		if UserId == self.Entity.PlayerComponent.UserId then
			if self.TimerId ~= 0 then
				_TimerService:ClearTimer(self.TimerId)
				self.TimerId = 0
			end
			self:SaveToDB(true)
		end
	end

end

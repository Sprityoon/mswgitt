@Struct
script ActionConditionData

	method any Clone()
		return nil
	end

	method boolean LoadArg(string str)
		return true
	end

	method boolean LoadExtra(string str)
		return true
	end

	method table GetActionEnumList()
		return nil
	end

	method boolean Check(Entity userEntity, ActionEvent evt, integer userValue, integer condValue)
		return true
	end

	method integer GetNextUserValue(Entity userEntity, ActionEvent evt, integer userValue, integer condValue)
		return userValue + 1
	end

	method boolean IsUpdateNeeded()
		return false
	end

	method integer GetUpdatedValue(Entity userEntity, integer userValue, integer condValue)
		return nil
	end

	method integer SnapshotDexItemCount(Entity userEntity, string itemName)
		-- 도감 누적 획득 수. CountMode=State 인 Craft/Gather/Smelt 스냅샷용.
		if not isvalid(userEntity) or _Util:IsNilorEmptyString(itemName) then
			return nil
		end
		local inv = userEntity:GetComponent("script.PlayerInventory")
		if not isvalid(inv) then
			return nil
		end
		---@type PlayerInventory
		local p = inv
		local items = p:DecodeFlatJson(p.DexItemsJson)
		return math.floor(tonumber(items[itemName]) or 0)
	end

	method integer SnapshotDexMonsterCount(Entity userEntity, string monsterId)
		-- 도감 처치 수. CountMode=State 인 Kill 스냅샷용.
		if not isvalid(userEntity) or _Util:IsNilorEmptyString(monsterId) then
			return nil
		end
		local inv = userEntity:GetComponent("script.PlayerInventory")
		if not isvalid(inv) then
			return nil
		end
		---@type PlayerInventory
		local p = inv
		local monsters = p:DecodeFlatJson(p.DexMonstersJson)
		return math.floor(tonumber(monsters[monsterId]) or 0)
	end

	method integer SnapshotSkillMet(Entity userEntity, string skillId, integer condValue)
		-- 스킬 보유(레벨≥1)면 condValue, 아니면 0. 빈 skillId = 아무 스킬이나 보유.
		if not isvalid(userEntity) then
			return nil
		end
		local pcComp = userEntity:GetComponent("script.PlayerController")
		if not isvalid(pcComp) then
			return nil
		end
		---@type PlayerController
		local pc = pcComp
		if _Util:IsNilorEmptyString(skillId) then
			local ok, levels = pcall(function() return _HttpService:JSONDecode(pc.SkillLevelsJson) end)
			if not ok or levels == nil then
				return 0
			end
			for _, lv in pairs(levels) do
				if (tonumber(lv) or 0) >= 1 then
					return condValue
				end
			end
			return 0
		end
		if pc:GetSkillLevel(skillId) >= 1 then
			return condValue
		end
		return 0
	end

	method integer SnapshotFurnitureCount(Entity userEntity, string itemName)
		-- 영지(Home_<UserId>)에 설치된 가구 수. CountMode=State 인 Place 스냅샷용.
		if not isvalid(userEntity) or _ResourceSpawner == nil then
			return nil
		end
		if not isvalid(userEntity.PlayerComponent) then
			return nil
		end
		local userId = userEntity.PlayerComponent.UserId
		local homeName = "Home_" .. tostring(userId)
		local count = self:CountFurnitureOnMap(homeName, itemName)
		if isvalid(userEntity.CurrentMap) then
			local curName = userEntity.CurrentMap.Name
			if curName ~= nil and curName ~= homeName then
				count = count + self:CountFurnitureOnMap(curName, itemName)
			end
		end
		return count
	end

	method integer CountFurnitureOnMap(string mapName, string itemName)
		-- ResourceSpawner 가구 JSON에서 itemName 일치 건수. 빈 itemName = 전체.
		if mapName == nil or mapName == "" then
			return 0
		end
		local json = _ResourceSpawner:GetPlacedFurnitureJson(mapName)
		if json == nil or json == "" or json == "[]" then
			return 0
		end
		local ok, list = pcall(function() return _HttpService:JSONDecode(json) end)
		if not ok or type(list) ~= "table" then
			return 0
		end
		local n = 0
		for i = 1, #list do
			local rec = list[i]
			if type(rec) == "table" then
				local recName = rec.itemName or ""
				if _Util:IsNilorEmptyString(itemName) or recName == itemName then
					n = n + 1
				end
			end
		end
		return n
	end

	method integer SnapshotOffHome(Entity userEntity, integer condValue)
		-- 현재 맵이 영지가 아니면 condValue. Warp CountMode=State 용(귀가하면 0).
		if not isvalid(userEntity) or not isvalid(userEntity.CurrentMap) then
			return 0
		end
		local mapName = userEntity.CurrentMap.Name
		if _PersistenceManager ~= nil then
			if _PersistenceManager:ClassifyMapKind(mapName) ~= "home" then
				return condValue
			end
			return 0
		end
		if mapName ~= nil and string.sub(mapName, 1, 5) ~= "Home_" then
			return condValue
		end
		return 0
	end

end
@Struct
script ActionConditionData_Smelt extends ActionConditionData

	-- CondArg = 제련 결과물 Name (빈 값 = 아무 제련). ActionEvent.Args = { itemName, count }
	property string Target = ""

	method any Clone()
		return ActionConditionData_Smelt()
	end

	method boolean LoadArg(string str)
		self.Target = str or ""
		return true
	end

	method table GetActionEnumList()
		return { _ActionEnum.Smelt }
	end

	method boolean Check(Entity userEntity, ActionEvent evt, integer userValue, integer condValue)
		if _Util:IsNilorEmptyString(self.Target) then
			return true
		end
		return evt.Args[1] == self.Target
	end

	method integer GetNextUserValue(Entity userEntity, ActionEvent evt, integer userValue, integer condValue)
		return userValue + (evt.Args[2] or 1)
	end

	method integer GetUpdatedValue(Entity userEntity, integer userValue, integer condValue)
		-- CountMode=State: 도감 누적 획득으로 이미 제련한 결과를 인정.
		return self:SnapshotDexItemCount(userEntity, self.Target)
	end

end

@Struct
script ActionConditionData_Deliver extends ActionConditionData

	-- CondArg = RequestPoolDataSet.RequestId 또는 납품 아이템 Name (빈 값 = 아무 의뢰 납품). ActionEvent.Args = { requestId, 1 }
	property string Target = ""

	method any Clone()
		return ActionConditionData_Deliver()
	end

	method boolean LoadArg(string str)
		self.Target = str or ""
		return true
	end

	method table GetActionEnumList()
		return { _ActionEnum.Deliver }
	end

	method boolean Check(Entity userEntity, ActionEvent evt, integer userValue, integer condValue)
		if _Util:IsNilorEmptyString(self.Target) then
			return true
		end
		if evt.Args[1] == self.Target then
			return true
		end
		-- 아이템 Name 지정: 납품한 의뢰 행의 RequiredItem과 대조한다.
		local ds = _DataService:GetTable("RequestPoolDataSet")
		if ds == nil then return false end
		local row = ds:FindRow("RequestId", tostring(evt.Args[1] or ""))
		if row == nil then return false end
		return tostring(row:GetItem("RequiredItem") or "") == self.Target
	end

	method integer GetNextUserValue(Entity userEntity, ActionEvent evt, integer userValue, integer condValue)
		return userValue + (evt.Args[2] or 1)
	end

end

@Struct
script QuestData

	property integer Id = 0

	property string Name = ""

	property string Desc = ""

	property string ProgressingDesc = ""

	property integer CategoryEnum = 0

	property integer CycleEnum = 0

	property boolean IsRepeatable = false

	property integer LinkedPrevId = 0

	property integer RequiredId = 0

	property boolean AutoAccept = false

	property boolean CannotAbandon = false

	property table ConsumeItems = nil

	property table RewardItems = nil

	property integer Priority = 0

	-- T27: 레시피 해금 키 (공란=없음). GrantRecipeUnlock 연동.
	property string RewardUnlockId = ""

	-- 2026-08-10: 완료 시 영지에 개통할 포탈 목적지 (PortalDestinationDataSet.DestinationId, 공란=없음).
	property string RewardPortalId = ""

	-- 스토리 수주/보고 NPC (공란=AutoAccept·자동완료 경로).
	property string GiverNpcId = ""
	property string TurnInNpcId = ""

	property table ConditionDatas = nil

	property integer ConditionCount = 0

	method boolean Load(any dataRow)
		---@type UserDataRow
		local row = dataRow
		
		local id = math.tointeger(tonumber(row:GetItem("Id")))
		if id == nil or id == 0 then
			log_error("Id is nil.")
			return false
		end
		self.Id = id
		
		self.Name = row:GetItem("Name")
		self.Desc = row:GetItem("Desc")
		self.ProgressingDesc = row:GetItem("ProgressingDesc")
		
		self.CategoryEnum = _QuestCategoryEnum:ToEnum(row:GetItem("CategoryEnum"))
		
		self.CycleEnum = _CycleEnum:ToEnum(row:GetItem("CycleEnum"))
		
		if not _Util:IsNilorEmptyString(row:GetItem("IsRepeatable")) then
			if self.CycleEnum ~= _CycleEnum.None then
				log_warning("Quests with a set CycleEnum cannot be repeated.")
			else
				self.IsRepeatable = true
			end
		end
		
		local linkedPrevId = math.tointeger(tonumber(row:GetItem("LinkedPrevId")))
		self.LinkedPrevId = linkedPrevId or 0
		
		local requiredId = math.tointeger(tonumber(row:GetItem("RequiredId")))
		self.RequiredId = requiredId or 0
		
		if not _Util:IsNilorEmptyString(row:GetItem("AutoAccept")) then
			self.AutoAccept = true
		end
		
		if not _Util:IsNilorEmptyString(row:GetItem("CannotAbandon")) then
			self.CannotAbandon = true
		end

		-- 보고 시 넘길 아이템 (공란=보여 주기만 / 튜토리얼 자동완료). RewardItems와 같은 Name:count| 문법.
		self.ConsumeItems = nil
		local consumeItems = {}
		local okCi, ci = pcall(function() return row:GetItem("ConsumeItems") end)
		if okCi and ci ~= nil then
			if not self:ParseItems(ci, consumeItems) then
				log_error(string.format("ConsumeItem name or count is nil. Id : %d", id))
				return false
			end
			if not _Util:IsNilorEmptyTable(consumeItems) then
				self.ConsumeItems = consumeItems
			end
		end
		
		local rewardItems = {}
		if not self:ParseItems(row:GetItem("RewardItems"), rewardItems) then
			log_error(string.format("RewardItem id or count is nil. Id : %d", id))
			return false
		end
		
		if not _Util:IsNilorEmptyTable(rewardItems) then
			self.RewardItems = rewardItems
		end
		
		local priority = math.tointeger(tonumber(row:GetItem("Priority")))
		self.Priority = priority or math.maxinteger

		-- T27: RewardUnlockId (없는 컬럼 GetItem은 LEA-3011 — pcall)
		self.RewardUnlockId = ""
		local okRu, ru = pcall(function() return row:GetItem("RewardUnlockId") end)
		if okRu and ru ~= nil and not _Util:IsNilorEmptyString(ru) then
			self.RewardUnlockId = ru
		end

		-- 영지 포탈 개통 보상 (없는 컬럼 GetItem은 LEA-3011 — pcall)
		self.RewardPortalId = ""
		local okRp, rp = pcall(function() return row:GetItem("RewardPortalId") end)
		if okRp and rp ~= nil and not _Util:IsNilorEmptyString(rp) then
			self.RewardPortalId = tostring(rp)
		end

		self.GiverNpcId = ""
		local okG, g = pcall(function() return row:GetItem("GiverNpcId") end)
		if okG and g ~= nil and not _Util:IsNilorEmptyString(g) then
			self.GiverNpcId = tostring(g)
		end
		self.TurnInNpcId = ""
		local okT, t = pcall(function() return row:GetItem("TurnInNpcId") end)
		if okT and t ~= nil and not _Util:IsNilorEmptyString(t) then
			self.TurnInNpcId = tostring(t)
		end
		
		return true
	end

	method boolean RequiresNpcTurnIn()
		-- TurnInNpcId가 있으면 조건 충족만으로 완료하지 않고 NPC 보고가 필요하다.
		return self.TurnInNpcId ~= nil and self.TurnInNpcId ~= ""
	end

	method boolean ParseItems(string itemsStr, table outItems)
		if _Util:IsNilorEmptyString(itemsStr) then
			return true
		end
		
		local itemStrs = _UtilLogic:Split(itemsStr, "|")
		if itemStrs == nil then
			return self:ParseItem(itemsStr, outItems)
		end
		
		for i = 1, #itemStrs do
			local itemStr = itemStrs[i]
			if not self:ParseItem(itemStr, outItems) then
				return false
			end
		end
		
		return true
	end

	method boolean ParseItem(string itemStr, table outItems)
		-- [적응] 아이템 항목은 "Name:count" (콤마 대신 콜론 — CSV 콤마 파싱 이슈 회피)
		local argStrs = _UtilLogic:Split(itemStr, ":")
		
		-- [적응] 이 게임의 보상 아이템은 정수 itemId가 아닌 item_dataset의 문자열 Name을 쓴다.
		local itemName = argStrs[1]
		local itemCount = math.tointeger(tonumber(argStrs[2]))
		if _Util:IsNilorEmptyString(itemName) or itemCount == nil then
			return false
		end
		
		outItems[#outItems + 1] = { itemName, itemCount }
		
		return true
	end

end
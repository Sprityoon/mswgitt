@Logic
script GameSettingsLogic extends Logic
	-- 계정 단위 게임 설정(사운드·화면, 2026-10-15). 슬롯과 무관하게 계정 하나에 한 벌.
	-- 클라: 값을 들고 즉시 적용(BGMManager 볼륨 · 화면 흔들림 · 퀘스트 길 안내). [설정 저장]·음악 버튼 때만 서버로 보낸다.
	-- 서버: UserDataStorage(userId) 의 "GameSettings" 키 1개(작은 JSON). 접속 때 1회 읽고, 값이 바뀌었을 때만 쓴다.

	property string StorageKey = "GameSettings"
	property integer MaxJsonBytes = 1000
	property number SaveCooldownSec = 2.0

	-- 현재 적용 값(클라 로컬, 동기화 없음 — 플레이어마다 다르다).
	property number BgmVolume = 1.0
	property number SfxVolume = 1.0
	property boolean BgmMuted = false
	property boolean SfxMuted = false
	property boolean ScreenShake = true
	property boolean QuestGuide = true
	-- 마지막으로 서버와 일치한 값(불러옴/저장 성공). 창을 저장 없이 닫으면 이 값으로 되돌린다.
	property string SavedJson = ""
	property boolean Loaded = false
	property boolean LoadFailed = false
	property boolean SavePending = false

	method void OnBeginPlay()
		-- 클라: 로컬 플레이어가 생긴 뒤 서버에 1회 불러오기를 요청한다(OnUpdate 에서 대기).
		if not self:IsClient() then return end
		self.SavedJson = self:ToJson()
		self:Apply()
		log("[SETTINGS] client ready")
	end

	method void OnUpdate(number delta)
		-- 불러오기 요청 1회. 요청 뒤에는 아무것도 하지 않는다.
		if not self:IsClient() then return end
		if self._T.loadRequested == true then return end
		if not isvalid(_UserService.LocalPlayer) then return end
		self._T.loadRequested = true
		self:ServerLoad()
	end

	method table Defaults()
		-- 기본값(첫 접속 · 초기화).
		return { v = 1, bgm = 1.0, sfx = 1.0, bgmMute = false, sfxMute = false, shake = true, guide = true }
	end

	method table Normalize(any raw)
		-- 저장 JSON → 검증된 표. 빠진 필드는 기본값, 볼륨은 0~1, 불린이 아니면 기본값(서버·클라 공용).
		local d = self:Defaults()
		if type(raw) ~= "table" then return d end
		local function vol(x, def)
			local n = tonumber(x)
			if n == nil or n ~= n or n == math.huge or n == -math.huge then return def end
			if n < 0 then n = 0 end
			if n > 1 then n = 1 end
			return math.floor(n * 100 + 0.5) / 100
		end
		local function flag(x, def)
			if type(x) == "boolean" then return x end
			return def
		end
		return {
			v = 1,
			bgm = vol(raw.bgm, d.bgm),
			sfx = vol(raw.sfx, d.sfx),
			bgmMute = flag(raw.bgmMute, d.bgmMute),
			sfxMute = flag(raw.sfxMute, d.sfxMute),
			shake = flag(raw.shake, d.shake),
			guide = flag(raw.guide, d.guide),
		}
	end

	method boolean SameJson(string first, string second)
		-- JSON 객체 키 순서는 보장되지 않는다. 정규화한 값으로 비교한다.
		local okA, a = pcall(function() return _HttpService:JSONDecode(first) end)
		local okB, b = pcall(function() return _HttpService:JSONDecode(second) end)
		if not okA or not okB then return false end
		a = self:Normalize(a)
		b = self:Normalize(b)
		for key, value in pairs(a) do
			if b[key] ~= value then return false end
		end
		return true
	end

	@ExecSpace("ClientOnly")
	method string ToJson()
		-- 현재 값 → JSON(키 순서가 고정이라 같은 값이면 같은 문자열).
		local t = { v = 1, bgm = self.BgmVolume, sfx = self.SfxVolume, bgmMute = self.BgmMuted,
			sfxMute = self.SfxMuted, shake = self.ScreenShake, guide = self.QuestGuide }
		local ok, json = pcall(function() return _HttpService:JSONEncode(self:Normalize(t)) end)
		if ok and json ~= nil then return json end
		return ""
	end

	@ExecSpace("ClientOnly")
	method void ApplyTable(table t)
		-- 검증된 표를 현재 값으로 넣고 즉시 적용한다.
		local n = self:Normalize(t)
		self.BgmVolume = n.bgm
		self.SfxVolume = n.sfx
		self.BgmMuted = n.bgmMute
		self.SfxMuted = n.sfxMute
		self.ScreenShake = n.shake
		self.QuestGuide = n.guide
		self:Apply()
	end

	@ExecSpace("ClientOnly")
	method void ApplyJson(string json)
		-- 저장 JSON 을 적용한다. 비었거나 깨졌으면 기본값.
		local raw = nil
		if json ~= nil and json ~= "" then
			local ok, decoded = pcall(function() return _HttpService:JSONDecode(json) end)
			if ok then raw = decoded end
		end
		self:ApplyTable(raw)
	end

	@ExecSpace("ClientOnly")
	method void Apply()
		-- 사운드는 BGMManager 배율로, 흔들림·길 안내는 각 스크립트가 이 값을 직접 읽는다.
		if _BGMManager == nil then return end
		local bgm = self.BgmVolume
		if self.BgmMuted then bgm = 0 end
		local sfx = self.SfxVolume
		if self.SfxMuted then sfx = 0 end
		_BGMManager:ApplySettingVolumes(bgm, sfx)
	end

	@ExecSpace("ClientOnly")
	method void ResetDefaults()
		-- 기본값으로 되돌려 즉시 적용(저장은 [설정 저장] 때).
		self:ApplyTable(self:Defaults())
	end

	@ExecSpace("ClientOnly")
	method void RevertToSaved()
		-- 저장하지 않은 변경을 버린다.
		self:ApplyJson(self.SavedJson)
	end

	@ExecSpace("ClientOnly")
	method boolean IsDirty()
		-- 마지막 저장값과 다른가.
		return not self:SameJson(self:ToJson(), self.SavedJson)
	end

	@ExecSpace("ClientOnly")
	method boolean RequestSave()
		-- 바뀐 것이 있을 때만 서버로 보낸다. 보냈으면 true(결과는 ClientSaveResult 로 온다).
		if not self.Loaded or self.SavePending then return false end
		if not self:IsDirty() then return false end
		self.SavePending = true
		self:ServerSave(self:ToJson())
		return true
	end

	@ExecSpace("ClientOnly")
	method void SetBgmMutedAndSave(boolean muted)
		-- 타이틀 음악 버튼: 음소거만 바꾸고 바로 저장한다.
		if not self.Loaded or self.SavePending then return end
		self.BgmMuted = muted
		self:Apply()
		self:RequestSave()
	end

	@ExecSpace("Server")
	method void ServerLoad()
		-- 접속 1회: 계정 저장소에서 읽어 요청한 클라에게만 돌려준다. 처음이면(NotFound) 빈 문자열 = 기본값.
		local userId = senderUserId
		if userId == nil or userId == "" then return end
		if self._T.cache == nil then self._T.cache = {} end
		if self._T.cache[userId] ~= nil then
			self:ClientReceiveSettings(self._T.cache[userId], userId)
			return
		end
		if self._T.loading == nil then self._T.loading = {} end
		if self._T.loading[userId] then return end
		self._T.loading[userId] = true
		local storage = _DataStorageService:GetUserDataStorage(userId)
		local code, raw = storage:GetAndWait(self.StorageKey)
		self._T.loading[userId] = nil
		if code ~= 0 and code ~= 1000002 then
			log_warning("[SETTINGS] load failed code=" .. tostring(code) .. " user=" .. tostring(userId))
			self:ClientLoadFailed(userId)
			return
		end
		if raw == nil then raw = "" end
		self._T.cache[userId] = raw
		self:ClientReceiveSettings(raw, userId)
	end

	@ExecSpace("Server")
	method void ServerSave(string json)
		-- [설정 저장]: 크기·형식을 검증해 다시 직렬화한 값만, 바뀌었을 때만, 쿨다운을 지켜 쓴다(비동기).
		local userId = senderUserId
		if userId == nil or userId == "" then return end
		-- 불러오기 실패를 빈 설정으로 오인해 기존 값을 덮지 않는다. 진행 중 쓰기도 직렬화한다.
		if self._T.cache == nil or self._T.cache[userId] == nil then
			self:ClientSaveResult(false, "notloaded", userId)
			return
		end
		if self._T.saving == nil then self._T.saving = {} end
		if self._T.saving[userId] then
			self:ClientSaveResult(false, "cooldown", userId)
			return
		end
		if json == nil or #json > self.MaxJsonBytes then
			self:ClientSaveResult(false, "", userId)
			return
		end
		local ok, decoded = pcall(function() return _HttpService:JSONDecode(json) end)
		if not ok or type(decoded) ~= "table" then
			self:ClientSaveResult(false, "", userId)
			return
		end
		local clean = _HttpService:JSONEncode(self:Normalize(decoded))
		if self._T.cache == nil then self._T.cache = {} end
		if self._T.lastSave == nil then self._T.lastSave = {} end
		if self:SameJson(self._T.cache[userId], clean) then
			self:ClientSaveResult(true, clean, userId)
			return
		end
		local now = _UtilLogic.ElapsedSeconds
		local last = self._T.lastSave[userId]
		if last ~= nil and now - last < self.SaveCooldownSec then
			self:ClientSaveResult(false, "cooldown", userId)
			return
		end
		self._T.lastSave[userId] = now
		self._T.saving[userId] = true
		local storage = _DataStorageService:GetUserDataStorage(userId)
		storage:SetAsync(self.StorageKey, clean, function(code, key)
			self._T.saving[userId] = nil
			if code == 0 then
				self._T.cache[userId] = clean
				log("[SETTINGS] saved user=" .. tostring(userId) .. " " .. clean)
				self:ClientSaveResult(true, clean, userId)
			else
				log_warning("[SETTINGS] save failed code=" .. tostring(code) .. " user=" .. tostring(userId))
				self:ClientSaveResult(false, "", userId)
			end
		end)
	end

	@ExecSpace("Client")
	method void ClientLoadFailed()
		-- 재시도는 창을 다시 열 때만 한다. 프레임별 저장소 재호출 금지.
		self.Loaded = false
		self.LoadFailed = true
		if _UISettingsLogic ~= nil then _UISettingsLogic:OnSettingsChanged() end
	end

	@ExecSpace("Client")
	method void ClientReceiveSettings(string json)
		-- 서버가 읽어 온 값 적용. 이 값이 "마지막 저장값"이 된다.
		self:ApplyJson(json)
		self.SavedJson = self:ToJson()
		self.Loaded = true
		self.LoadFailed = false
		log("[SETTINGS] loaded " .. self.SavedJson)
		if _UISettingsLogic ~= nil then _UISettingsLogic:OnSettingsChanged() end
		self:NotifyMainMenuMusic()
	end

	@ExecSpace("Client")
	method void ClientSaveResult(boolean ok, string savedJson)
		-- 저장 결과. 성공이면 저장값 갱신, 결과는 설정창 상태 줄에 보인다.
		self.SavePending = false
		if ok and savedJson ~= nil and savedJson ~= "" then
			self.SavedJson = savedJson
		end
		local msg = "설정을 저장했습니다."
		if not ok then
			if savedJson == "cooldown" then msg = "잠시 후 다시 저장해 주세요." else msg = "저장에 실패했습니다. 다시 시도해 주세요." end
		end
		if _UISettingsLogic ~= nil then
			_UISettingsLogic:OnSettingsChanged()
			_UISettingsLogic:ShowStatus(msg, not ok)
		end
	end

	@ExecSpace("ClientOnly")
	method void NotifyMainMenuMusic()
		-- 타이틀 화면 음악 버튼 아이콘을 현재 음소거 상태에 맞춘다.
		local mm = _EntityService:GetEntityByPath("/ui/MainMenuGroup/Controller")
		if not isvalid(mm) then return end
		local c = mm:GetComponent("script.UIMainMenuController")
		if isvalid(c) then c:RefreshMusicButton() end
	end
end
